// The dynamic array.
//
// tests/samples/stdlib/collection.fin is the specification. `Collection` is the
// most-used library type in the corpus: `hashmap.fin` builds every one of its four
// vectors out of it, `macro_definitions.fin` writes `new Collection::<int>{}` twice,
// `prototype_test.fin` coerces a prototype into one and `useful_macros.fin` has a
// `coll!` literal macro. So the shape below is fixed by four consumers, not one.
//
// The surface is wider than the draft's, and everything added is additive -- `push`,
// `pop_last`, `get`, `len`, `__get`, `__set`, the two operators and `from_prototype`
// all keep their signatures, because four samples and `hashmap.fin` call them. What is
// new: `insert`, `remove`, `clear`, `is_empty`, `first`, `last`, `contains`,
// `index_of`, `reverse`, `extend`, `set`, `capacity` and `reserve`.
//
// GROWTH IS HONEST ABOUT ITSELF. `capacity()` reports `self._arr.length` -- the real
// extent of the buffer -- and `len()` reports how much of it is filled. They differ,
// because `reserve` and `push`'s doubling both allocate ahead. Growth is a fresh buffer
// and a copy (`allocate`), which is exactly why a `[T]` itself has no capacity field
// (ADR 0025): capacity is something a container has, not something an array handle has.
//
// The old `push` grew by one element per push, so pushing n items copied the whole
// buffer n times -- quadratic. It doubles now, and `length` is gone as a field: it was
// a second copy of the buffer extent that `_arr.length` already carries, and the two
// could disagree.
//
// BOUNDS CHECKING is `blame`, consistently, on every method that takes an index:
// `__get`, `__set`, `set`, `insert`, `remove`, `get`. The language does not check an
// index against a length (chapter 9 says so plainly), so this is the library choosing
// to. `get` is included on purpose -- it used to be the one unchecked reader, which
// made it the fast path by accident rather than by design.
//
// Divergences from the draft, each because the compiler says so today:
//
//   _arr <[T]>            no divergence. An array allocation is a `[T]`, and this
//                         file's evidence is what settled it (Soundness_HeapArrays).
//   push_back = null      a nullable method slot nothing in the corpus calls, whose
//                         only writer is the draft's `@implements(pub)
//                         Collection<T>::push_back = ...` overwriter
//   getitem = __get       a field initialised to a method name; a method is not a
//   setitem = __set       value in scope today
//   cast<auto>(self._arr) `allocate` grows into a fresh buffer here instead, which is
//                         what the draft's copy-then-delete meant to do. The `delete`
//                         half is real (Soundness_DeletingAnArray); only the cast is
//                         still a stand-in.
//   blame CollectionError the throw form of `blame` is commented out in the corpus
//     ("...")             too (blame_assert.fin:15); the assert form is what exists
//   @implements blocks    an overwriter and a second constructor arriving through
//                         `implements <NoLengthCollection>`, both of which need a pass
//                         that reopens a declared type
//
// `operator []=` takes two parameters where `IndexAssign` declares one. Nothing checks
// an operator's arity against the interface that requires it -- conformance compares
// operator names only (StructType::implements) -- so this passes today for the wrong
// reason. It is written the way index-assignment actually works, because when that
// check arrives it is the interface in operators::std that should move.
//
// GAPS, hit while writing this file:
//
//   * There is no iteration protocol. `foreach` does not ask what it is walking
//     (KnownDefect_Foreach.TheIterableIsNeverCheckedForBeingIterable), so it cannot be
//     given a meaning over a struct from library code. Index-based iteration over
//     `0 .. len()` is what this type supports, and `contains`/`index_of`/`reverse`
//     exist partly so the common walks do not have to be written by hand.
//   * `contains` and `index_of` compare with `==`. For a struct element that
//     type-checks and is refused in codegen (`an undeclared operator '==' on struct
//     'P' is not lowered yet`), so they are usable on primitive and `string` elements.
//     A `string` compares by pointer, which is what `==` means here.
//   * `remove` shifts the tail down and does not free the vacated cell; for a `T` that
//     owns memory the caller has to take the element out with `get` first. There is no
//     destructor call to make, because `~Self()` does not parse.
#[stdimport] %{
import { Index, IndexAssign } from operators::std;
import { Error } from error::std;
}%

namespace std {

#[export]
pub struct CollectionError : <Error> {}

#[export]
pub struct Collection<T> : <Index, IndexAssign> {
    priv:
      // How many cells hold an element. The buffer's extent is `_arr.length` and is not
      // duplicated here: the old `length` field was a second copy of it that could
      // disagree, and `capacity()` reads the array.
      filled <int> = 0,
      _arr <[T]>,

    pub:
      // Every reader and writer goes through here first, because `new Collection::<T>{}`
      // -- the spelling macro_definitions.fin:11 and :15 write -- runs no constructor,
      // so `_arr` is null until something asks for it. `blame`ing on a null buffer would
      // punish the corpus's own idiom.
      priv fun ensure(self: &Self) <noret> {
          if (self._arr == null) {
              self._arr = new [T, 4]{};
              self.filled = 0;
            }
        }

      fun len(self: &Self) <int> {
          return self.filled;
        }

      fun is_empty(self: &Self) <bool> {
          return self.filled == 0;
        }

      // The buffer's extent, which is not `len()`. See the header on why both exist.
      fun capacity(self: &Self) <int> {
          self.ensure();
          return self._arr.length;
        }

      // Doubling, not one-at-a-time: growing by one made pushing n items copy the
      // buffer n times.
      fun push(self: &Self, item: T) <noret> {
          self.ensure();
          if (self.filled >= self._arr.length) {
              self.allocate(self._arr.length * 2);
            }
          self._arr[self.filled] = item;
          self.filled++;
        }

      // Grow to hold at least `amount` elements without further allocation. A caller
      // who knows how many elements are coming pays one copy instead of log n.
      fun reserve(self: &Self, amount: int) <noret> {
          self.ensure();
          if (amount > self._arr.length) { self.allocate(amount); }
        }

      fun pop_last(self: &Self) <T> {
          blame self.filled > 0, "pop_last on an empty collection";
          self.filled--;
          return self._arr[self.filled];
        }

      // Bounds-checked, like every other index-taking method here. It used to be the
      // one that was not, which made it the unchecked path by accident.
      fun get(self: &Self, index: int) <T> {
          self.ensure();
          blame index >= 0, "Index out of bounds";
          blame index < self.filled, "Index out of bounds";
          return self._arr[index];
        }

      fun set(self: &Self, index: int, value: T) <noret> {
          self.ensure();
          blame index >= 0, "Index out of bounds";
          blame index < self.filled, "Index out of bounds";
          self._arr[index] = value;
        }

      fun first(self: &Self) <T> {
          blame self.filled > 0, "first on an empty collection";
          return self._arr[0];
        }

      fun last(self: &Self) <T> {
          blame self.filled > 0, "last on an empty collection";
          return self._arr[self.filled - 1];
        }

      // `-1` when absent, which is the same convention `HashMap::get_index` uses. See
      // the header on what `==` means for a `string` and why a struct element does not
      // reach codegen here.
      fun index_of(self: &Self, item: T) <int> {
          self.ensure();
          for (let i <int> = 0; i < self.filled; i++) {
              if (self._arr[i] == item) { return i; }
            }
          return -1;
        }

      fun contains(self: &Self, item: T) <bool> {
          return self.index_of(item) >= 0;
        }

      // `index == len()` is allowed and appends, which is the one off-by-one worth
      // spelling out: inserting *at* the end is a legal insertion and reading at the end
      // is not a legal read.
      fun insert(self: &Self, index: int, item: T) <noret> {
          self.ensure();
          blame index >= 0, "Index out of bounds";
          blame index <= self.filled, "Index out of bounds";
          if (self.filled >= self._arr.length) {
              self.allocate(self._arr.length * 2);
            }
          for (let i <int> = self.filled; i > index; i--) {
              self._arr[i] = self._arr[i - 1];
            }
          self._arr[index] = item;
          self.filled++;
        }

      // Shifts the tail down and returns what was removed. The vacated cell keeps its
      // last value; see the header's gap list on what that costs for an owning `T`.
      fun remove(self: &Self, index: int) <T> {
          self.ensure();
          blame index >= 0, "Index out of bounds";
          blame index < self.filled, "Index out of bounds";
          let gone <T> = self._arr[index];
          for (let i <int> = index; i < self.filled - 1; i++) {
              self._arr[i] = self._arr[i + 1];
            }
          self.filled--;
          return gone;
        }

      // Forgets every element without freeing the buffer, so a cleared collection can
      // be refilled without allocating. Freeing it would need `delete self._arr` and a
      // way to say "and never touch it again", which is `release`'s problem in
      // stdptr.fin and not solved here either.
      fun clear(self: &Self) <noret> {
          self.filled = 0;
        }

      fun reverse(self: &Self) <noret> {
          self.ensure();
          let i <int> = 0;
          let j <int> = self.filled - 1;
          while (i < j) {
              let held <T> = self._arr[i];
              self._arr[i] = self._arr[j];
              self._arr[j] = held;
              i++;
              j--;
            }
        }

      // Appends every element of `other`, in order. One `reserve` and then pushes, so
      // extending by n costs one copy rather than log n.
      fun extend(self: &Self, other: &Collection<T>) <noret> {
          let n <int> = other.len();
          self.reserve(self.filled + n);
          for (let i <int> = 0; i < n; i++) {
              self.push(other.get(i));
            }
        }

    priv fun allocate(self: &Self, amount: int) <noret> {
        let want <int> = amount;
        if (want < 4) { want = 4; }
        let grown <[T]> = new [T, want]{};
        for (let i <int> = 0; i < self.filled; i++) {
            grown[i] = self._arr[i];
          }
        // The old buffer, after the copy and before the handle to it is lost. Every
        // `_arr` this type holds came from `new` -- `ensure`'s or this line's -- so it is
        // always this method's to free. Guarded because `reserve` may be the first thing
        // called on a collection whose `ensure` has not run.
        if (self._arr != null) { delete self._arr; }
        self._arr = grown;
      }

    pub fun __get(self: &Self, index: int) <T> {
        self.ensure();
        blame index >= 0, "Index out of bounds";
        blame index < self.filled, "Index out of bounds";
        return self._arr[index];
      }

    pub fun __set(self: &Self, index: int, value: T) <noret> {
        self.ensure();
        blame index >= 0, "Index out of bounds";
        blame index < self.filled, "Index out of bounds";
        self._arr[index] = value;
      }

    pub operator [](index: <int>) <T> {
        return self.__get(index);
      }

    pub operator []=(index: <int>, value: <T>) <noret> {
        self.__set(index, value);
      }

    // `Collection::from_prototype({ 0: 10, 1: 20 })` in prototype_test.fin:30. The body
    // cannot read the prototype yet -- a prototype resolves no member and no index -- so
    // it produces the empty collection and the keys are dropped. It is declared because
    // the corpus calls it; it is empty because the language has no way to walk a
    // prototype.
    pub static fun from_prototype(prtp: {int, T}) <Self> {
        return Collection{filled: 0, _arr: new [T, 4]{}};
      }
  }

// The list-shaped call `coll![1, 2, 3]`, which useful_macros.fin:12 writes and ADR 0023
// step 8 asks for here. The bracket does the work the body would otherwise have to: step 3
// makes `[...]` arrive as one prototype keyed `0..n-1`, which is precisely
// `from_prototype`'s parameter, so this macro is a rename and not a construction. `$p` is
// the whole bracket and `Collection::` is qualified because a body may spell nothing else
// (ADR 0020, ADR 0023) -- an unqualified `from_prototype` would bind whatever the caller
// happened to have. It carries `from_prototype`'s limit with it: the keys are dropped
// because nothing in the language can walk a prototype yet, so `coll![1, 2, 3]` type-checks
// as a `Collection<int>` and is empty at runtime.
@macro coll(p) { return quote { Collection::from_prototype($p); }; }

}

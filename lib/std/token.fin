// Delimiters
pub const TOKEN_LPAREN <int> = 110;
pub const TOKEN_RPAREN <int> = 111;
pub const TOKEN_LBRACE <int> = 112;
pub const TOKEN_RBRACE <int> = 113;
pub const TOKEN_LBRACKET <int> = 114;
pub const TOKEN_RBRACKET <int> = 115;

pub const TOKEN_HASH <int> = 122;
pub const TOKEN_DOLLAR <int> = 123;
pub const TOKEN_PIPE <int> = 124;

// Token Kind Accessor Functions (for cross-module calls)
#[export] pub fun tok_eof() <int> { return 0; }
#[export] pub fun tok_unknown() <int> { return 1; }
#[export] pub fun tok_ident() <int> { return 2; }
#[export] pub fun tok_int_lit() <int> { return 3; }
#[export] pub fun tok_float_lit() <int> { return 4; }
#[export] pub fun tok_string_lit() <int> { return 5; }
#[export] pub fun tok_char_lit() <int> { return 6; }
#[export] pub fun tok_bool_lit() <int> { return 7; }

#[export] pub fun kw_let() <int> { return 10; }
#[export] pub fun kw_const() <int> { return 11; }
#[export] pub fun kw_fun() <int> { return 13; }
#[export] pub fun kw_return() <int> { return 14; }
#[export] pub fun kw_pub() <int> { return 15; }
#[export] pub fun kw_priv() <int> { return 16; }
#[export] pub fun kw_struct() <int> { return 18; }
#[export] pub fun kw_enum() <int> { return 19; }
#[export] pub fun kw_interface() <int> { return 20; }
#[export] pub fun kw_while() <int> { return 27; }
#[export] pub fun kw_for() <int> { return 29; }
#[export] pub fun kw_if() <int> { return 33; }
#[export] pub fun kw_else() <int> { return 34; }
#[export] pub fun kw_break() <int> { return 31; }
#[export] pub fun kw_continue() <int> { return 32; }
#[export] pub fun kw_import() <int> { return 37; }
#[export] pub fun kw_from() <int> { return 39; }
#[export] pub fun kw_new() <int> { return 40; }
#[export] pub fun kw_delete() <int> { return 41; }
#[export] pub fun kw_null() <int> { return 24; }
#[export] pub fun kw_true() <int> { return 25; }
#[export] pub fun kw_false() <int> { return 26; }
#[export] pub fun kw_cast() <int> { return 45; }
#[export] pub fun kw_blame() <int> { return 49; }
#[export] pub fun kw_m1778() <int> { return 60; }
#[export] pub fun kw_namespace() <int> { return 21; }
#[export] pub fun kw_define() <int> { return 58; }
#[export] pub fun kw_operator() <int> { return 46; }
#[export] pub fun kw_implements() <int> { return 54; }

#[export] pub fun tok_plus() <int> { return 80; }
#[export] pub fun tok_minus() <int> { return 81; }
#[export] pub fun tok_star() <int> { return 82; }
#[export] pub fun tok_slash() <int> { return 83; }
#[export] pub fun tok_percent() <int> { return 84; }
#[export] pub fun tok_equal() <int> { return 85; }
#[export] pub fun tok_eqeq() <int> { return 86; }
#[export] pub fun tok_noteq() <int> { return 87; }
#[export] pub fun tok_lt() <int> { return 88; }
#[export] pub fun tok_gt() <int> { return 89; }
#[export] pub fun tok_lteq() <int> { return 90; }
#[export] pub fun tok_gteq() <int> { return 91; }
#[export] pub fun tok_and() <int> { return 92; }
#[export] pub fun tok_or() <int> { return 93; }
#[export] pub fun tok_not() <int> { return 94; }
#[export] pub fun tok_ampersand() <int> { return 95; }
#[export] pub fun tok_increment() <int> { return 96; }
#[export] pub fun tok_decrement() <int> { return 97; }
#[export] pub fun tok_plusequal() <int> { return 98; }
#[export] pub fun tok_minusequal() <int> { return 99; }
#[export] pub fun tok_multequal() <int> { return 100; }
#[export] pub fun tok_divequal() <int> { return 101; }

#[export] pub fun tok_lparen() <int> { return 110; }
#[export] pub fun tok_rparen() <int> { return 111; }
#[export] pub fun tok_lbrace() <int> { return 112; }

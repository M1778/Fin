#[export]
pub struct SourceLocation {
    pub:
      file <string> = "",
      line <int> = 1,
      col <int> = 1,
      offset <int> = 0,
}

#[export]
pub struct Span {
    pub:
      start_line <int> = 1,
      start_col <int> = 1,
      end_line <int> = 1,
      end_col <int> = 1,
      offset <int> = 0,
      len <int> = 0,
}

#[export]
pub struct Token {
    pub:
      kind <int> = 0,
      text <string> = "",
      line <int> = 1,
      col <int> = 1,
      offset <int> = 0,
      len <int> = 0,
}

// Returns a human-readable display name for a token kind.
#[export]
pub fun token_name(kind: int) <string> {
    if (kind == 0) { return "end of file"; }
    if (kind == 2) { return "identifier"; }
    if (kind == 3) { return "integer literal"; }
    if (kind == 4) { return "float literal"; }
    if (kind == 5) { return "string literal"; }
    if (kind == 6) { return "character literal"; }
    if (kind == 7) { return "boolean literal"; }

    if (kind == 10) { return "let"; }
    if (kind == 11) { return "const"; }
    if (kind == 12) { return "auto"; }
    if (kind == 13) { return "fun"; }
    if (kind == 14) { return "return"; }
    if (kind == 15) { return "pub"; }
    if (kind == 16) { return "priv"; }
    if (kind == 17) { return "readonly"; }
    if (kind == 18) { return "struct"; }
    if (kind == 19) { return "enum"; }
    if (kind == 20) { return "interface"; }
    if (kind == 21) { return "namespace"; }
    if (kind == 22) { return "macro"; }
    if (kind == 23) { return "static"; }
    if (kind == 24) { return "null"; }
    if (kind == 25) { return "true"; }
    if (kind == 26) { return "false"; }
    if (kind == 27) { return "while"; }
    if (kind == 28) { return "do"; }
    if (kind == 29) { return "for"; }
    if (kind == 30) { return "foreach"; }
    if (kind == 31) { return "break"; }
    if (kind == 32) { return "continue"; }
    if (kind == 33) { return "if"; }
    if (kind == 34) { return "else"; }
    if (kind == 35) { return "in"; }
    if (kind == 36) { return "extern"; }
    if (kind == 37) { return "import"; }
    if (kind == 38) { return "as"; }
    if (kind == 39) { return "from"; }
    if (kind == 40) { return "new"; }
    if (kind == 41) { return "delete"; }
    if (kind == 42) { return "sizeof"; }
    if (kind == 43) { return "typeof"; }
    if (kind == 44) { return "as_ptr"; }
    if (kind == 45) { return "cast"; }
    if (kind == 46) { return "operator"; }
    if (kind == 47) { return "try"; }
    if (kind == 48) { return "catch"; }
    if (kind == 49) { return "blame"; }
    if (kind == 50) { return "super"; }
    if (kind == 51) { return "Self"; }
    if (kind == 52) { return "type"; }
    if (kind == 53) { return "class"; }
    if (kind == 54) { return "implements"; }
    if (kind == 55) { return "any"; }
    if (kind == 56) { return "special"; }
    if (kind == 57) { return "fn"; }
    if (kind == 58) { return "define"; }
    if (kind == 59) { return "quote"; }
    if (kind == 60) { return "m1778"; }

    if (kind == 70) { return "int"; }
    if (kind == 71) { return "long"; }
    if (kind == 72) { return "float"; }
    if (kind == 73) { return "double"; }
    if (kind == 74) { return "bool"; }
    if (kind == 75) { return "string"; }
    if (kind == 76) { return "char"; }
    if (kind == 77) { return "void"; }
    if (kind == 78) { return "noret"; }

    if (kind == 80) { return "+"; }
    if (kind == 81) { return "-"; }
    if (kind == 82) { return "*"; }
    if (kind == 83) { return "/"; }
    if (kind == 84) { return "%"; }
    if (kind == 85) { return "="; }
    if (kind == 86) { return "=="; }
    if (kind == 87) { return "!="; }
    if (kind == 88) { return "<"; }
    if (kind == 89) { return ">"; }
    if (kind == 90) { return "<="; }
    if (kind == 91) { return ">="; }
    if (kind == 92) { return "&&"; }
    if (kind == 93) { return "||"; }
    if (kind == 94) { return "!"; }
    if (kind == 95) { return "&"; }
    if (kind == 96) { return "++"; }
    if (kind == 97) { return "--"; }
    if (kind == 98) { return "+="; }
    if (kind == 99) { return "-="; }
    if (kind == 100) { return "*="; }
    if (kind == 101) { return "/="; }
    if (kind == 102) { return "=>"; }
    if (kind == 103) { return "->"; }
    if (kind == 104) { return "::"; }
    if (kind == 105) { return "..."; }

    if (kind == 110) { return "("; }
    if (kind == 111) { return ")"; }
    if (kind == 112) { return "{"; }
    if (kind == 113) { return "}"; }
    if (kind == 114) { return "["; }
    if (kind == 115) { return "]"; }
    if (kind == 116) { return ";"; }
    if (kind == 117) { return ":"; }
    if (kind == 118) { return ","; }
    if (kind == 119) { return "."; }
    if (kind == 120) { return "?"; }
    if (kind == 121) { return "@"; }
    if (kind == 122) { return "#"; }
    if (kind == 123) { return "$"; }
    if (kind == 124) { return "|"; }

    return "unknown";
}

// Checks if a token kind is a language keyword.
#[export]
pub fun is_keyword(kind: int) <bool> {
    return kind >= 10 && kind <= 60;
}

// Checks if a token kind is a literal.
#[export]
pub fun is_literal(kind: int) <bool> {
    return kind >= 2 && kind <= 7;
}

// Checks if a token kind is an operator.
#[export]
pub fun is_operator(kind: int) <bool> {
    return kind >= 80 && kind <= 105;
}

#[llvm_name="strcmp"]
@define tok_strcmp(a: string, b: string) <int>;

priv fun tok_str_eq(a: string, b: string) <bool> {
    if (a == null && b == null) { return true; }
    if (a == null || b == null) { return false; }
    return tok_strcmp(a, b) == 0;
}

// Matches an identifier against Fin keywords, returning its keyword token kind
// or `TOKEN_IDENT` (2) if it is a general identifier.
#[export]
pub fun lookup_keyword(ident: string) <int> {
    if (tok_str_eq(ident, "let")) { return 10; }
    if (tok_str_eq(ident, "const")) { return 11; }
    if (tok_str_eq(ident, "auto")) { return 12; }
    if (tok_str_eq(ident, "fun")) { return 13; }
    if (tok_str_eq(ident, "return")) { return 14; }
    if (tok_str_eq(ident, "pub")) { return 15; }
    if (tok_str_eq(ident, "priv")) { return 16; }
    if (tok_str_eq(ident, "readonly")) { return 17; }
    if (tok_str_eq(ident, "struct")) { return 18; }
    if (tok_str_eq(ident, "enum")) { return 19; }
    if (tok_str_eq(ident, "interface")) { return 20; }
    if (tok_str_eq(ident, "namespace")) { return 21; }
    if (tok_str_eq(ident, "macro")) { return 22; }
    if (tok_str_eq(ident, "static")) { return 23; }
    if (tok_str_eq(ident, "null")) { return 24; }
    if (tok_str_eq(ident, "true")) { return 25; }
    if (tok_str_eq(ident, "false")) { return 26; }
    if (tok_str_eq(ident, "while")) { return 27; }
    if (tok_str_eq(ident, "do")) { return 28; }
    if (tok_str_eq(ident, "for")) { return 29; }
    if (tok_str_eq(ident, "foreach")) { return 30; }
    if (tok_str_eq(ident, "break")) { return 31; }
    if (tok_str_eq(ident, "continue")) { return 32; }
    if (tok_str_eq(ident, "if")) { return 33; }
    if (tok_str_eq(ident, "else")) { return 34; }
    if (tok_str_eq(ident, "in")) { return 35; }
    if (tok_str_eq(ident, "extern")) { return 36; }
    if (tok_str_eq(ident, "import")) { return 37; }
    if (tok_str_eq(ident, "as")) { return 38; }
    if (tok_str_eq(ident, "from")) { return 39; }
    if (tok_str_eq(ident, "new")) { return 40; }
    if (tok_str_eq(ident, "delete")) { return 41; }
    if (tok_str_eq(ident, "sizeof")) { return 42; }
    if (tok_str_eq(ident, "typeof")) { return 43; }
    if (tok_str_eq(ident, "as_ptr")) { return 44; }
    if (tok_str_eq(ident, "cast")) { return 45; }
    if (tok_str_eq(ident, "operator")) { return 46; }
    if (tok_str_eq(ident, "try")) { return 47; }
    if (tok_str_eq(ident, "catch")) { return 48; }
    if (tok_str_eq(ident, "blame")) { return 49; }
    if (tok_str_eq(ident, "super")) { return 50; }
    if (tok_str_eq(ident, "Self")) { return 51; }
    if (tok_str_eq(ident, "type")) { return 52; }
    if (tok_str_eq(ident, "class")) { return 53; }
    if (tok_str_eq(ident, "implements")) { return 54; }
    if (tok_str_eq(ident, "any")) { return 55; }
    if (tok_str_eq(ident, "special")) { return 56; }
    if (tok_str_eq(ident, "fn")) { return 57; }
    if (tok_str_eq(ident, "define")) { return 58; }
    if (tok_str_eq(ident, "quote")) { return 59; }
    if (tok_str_eq(ident, "m1778")) { return 60; }

    if (tok_str_eq(ident, "int")) { return 70; }
    if (tok_str_eq(ident, "long")) { return 71; }
    if (tok_str_eq(ident, "float")) { return 72; }
    if (tok_str_eq(ident, "double")) { return 73; }
    if (tok_str_eq(ident, "bool")) { return 74; }
    if (tok_str_eq(ident, "string")) { return 75; }
    if (tok_str_eq(ident, "char")) { return 76; }
    if (tok_str_eq(ident, "void")) { return 77; }
    if (tok_str_eq(ident, "noret")) { return 78; }

    return 2;
}

}

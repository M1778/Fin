// Token definitions, source location tracking, and lexical classification.
//
// Matches Go's `go/token` and Python's `token` modules, specialized for Fin's
// lexical grammar. Provides token constants, source coordinate structures,
// and keyword recognition.

namespace std {

// Special tokens
pub const TOKEN_EOF <int> = 0;
pub const TOKEN_UNKNOWN <int> = 1;

// Literals
pub const TOKEN_IDENT <int> = 2;
pub const TOKEN_INT_LIT <int> = 3;
pub const TOKEN_FLOAT_LIT <int> = 4;
pub const TOKEN_STRING_LIT <int> = 5;
pub const TOKEN_CHAR_LIT <int> = 6;
pub const TOKEN_BOOL_LIT <int> = 7;

// Keywords
pub const KW_LET <int> = 10;
pub const KW_CONST <int> = 11;
pub const KW_AUTO <int> = 12;
pub const KW_FUN <int> = 13;
pub const KW_RETURN <int> = 14;
pub const KW_PUB <int> = 15;
pub const KW_PRIV <int> = 16;
pub const KW_READONLY <int> = 17;
pub const KW_STRUCT <int> = 18;
pub const KW_ENUM <int> = 19;
pub const KW_INTERFACE <int> = 20;
pub const KW_NAMESPACE <int> = 21;
pub const KW_MACRO <int> = 22;
pub const KW_STATIC <int> = 23;
pub const KW_NULL <int> = 24;
pub const KW_TRUE <int> = 25;
pub const KW_FALSE <int> = 26;
pub const KW_WHILE <int> = 27;
pub const KW_DO <int> = 28;
pub const KW_FOR <int> = 29;
pub const KW_FOREACH <int> = 30;
pub const KW_BREAK <int> = 31;
pub const KW_CONTINUE <int> = 32;
pub const KW_IF <int> = 33;
pub const KW_ELSE <int> = 34;
pub const KW_IN <int> = 35;
pub const KW_EXTERN <int> = 36;
pub const KW_IMPORT <int> = 37;
pub const KW_AS <int> = 38;
pub const KW_FROM <int> = 39;
pub const KW_NEW <int> = 40;
pub const KW_DELETE <int> = 41;
pub const KW_SIZEOF <int> = 42;
pub const KW_TYPEOF <int> = 43;
pub const KW_AS_PTR <int> = 44;
pub const KW_CAST <int> = 45;
pub const KW_OPERATOR <int> = 46;
pub const KW_TRY <int> = 47;
pub const KW_CATCH <int> = 48;
pub const KW_BLAME <int> = 49;
pub const KW_SUPER <int> = 50;
pub const KW_SELF_TYPE <int> = 51;
pub const KW_TYPE <int> = 52;
pub const KW_CLASS <int> = 53;
pub const KW_IMPLEMENTS <int> = 54;
pub const KW_ANY <int> = 55;
pub const KW_SPECIAL <int> = 56;
pub const KW_FN_TYPE <int> = 57;
pub const KW_DEFINE <int> = 58;
pub const KW_QUOTE <int> = 59;
pub const KW_M1778 <int> = 60;

// Primitive types
pub const TYPE_INT <int> = 70;
pub const TYPE_LONG <int> = 71;
pub const TYPE_FLOAT <int> = 72;
pub const TYPE_DOUBLE <int> = 73;
pub const TYPE_BOOL <int> = 74;
pub const TYPE_STRING <int> = 75;
pub const TYPE_CHAR <int> = 76;
pub const TYPE_VOID <int> = 77;
pub const TYPE_NORET <int> = 78;

// Operators
pub const TOKEN_PLUS <int> = 80;
pub const TOKEN_MINUS <int> = 81;
pub const TOKEN_STAR <int> = 82;
pub const TOKEN_SLASH <int> = 83;
pub const TOKEN_PERCENT <int> = 84;
pub const TOKEN_EQUAL <int> = 85;
pub const TOKEN_EQEQ <int> = 86;
pub const TOKEN_NOTEQ <int> = 87;
pub const TOKEN_LT <int> = 88;
pub const TOKEN_GT <int> = 89;
pub const TOKEN_LTEQ <int> = 90;
pub const TOKEN_GTEQ <int> = 91;
pub const TOKEN_AND <int> = 92;
pub const TOKEN_OR <int> = 93;
pub const TOKEN_NOT <int> = 94;
pub const TOKEN_AMPERSAND <int> = 95;
pub const TOKEN_INCREMENT <int> = 96;
pub const TOKEN_DECREMENT <int> = 97;
pub const TOKEN_PLUSEQUAL <int> = 98;
pub const TOKEN_MINUSEQUAL <int> = 99;
pub const TOKEN_MULTEQUAL <int> = 100;
pub const TOKEN_DIVEQUAL <int> = 101;
pub const TOKEN_ARROW <int> = 102;

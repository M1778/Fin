// SPDX-License-Identifier: GPL-3.0-or-later
// Env: environment variables and process control.
//
// Reaches standard C library runtime facilities for environment inspection
// and process termination.

namespace std {

#[export]
#[llvm_name="getenv"]
@define getenv(name: string) <string>;

#c_ifdef FIN_TARGET_WINDOWS
#[llvm_name="_putenv_s"]
@define env_putenv(name: string, value: string) <int>;

#[llvm_name="strlen"]
@define env_strlen(value: string) <ulong>;

#[llvm_name="strchr"]
@define env_strchr(value: string, byte: int) <string>;

priv fun env_valid_name(name: string) <bool> {
    if (name == null) { return false; }
    return env_strlen(name) != cast<ulong>(0) && env_strchr(name, 61) == null;
}

#[export]
pub fun setenv(name: string, value: string, overwrite: int) <int> {
    if (!env_valid_name(name) || value == null) { return -1; }
    if (overwrite == 0 && getenv(name) != null) { return 0; }
    if (env_strlen(value) == cast<ulong>(0)) { return -1; }
    if (env_putenv(name, value) != 0) { return -1; }
    return 0;
}

#[export]
pub fun unsetenv(name: string) <int> {
    if (!env_valid_name(name)) { return -1; }
    if (env_putenv(name, "") != 0) { return -1; }
    return 0;
}
#c_else
#[export]
#[llvm_name="setenv"]
@define setenv(name: string, value: string, overwrite: int) <int>;

#[export]
#[llvm_name="unsetenv"]
@define unsetenv(name: string) <int>;
#c_endif

#[llvm_name="exit"]
@define c_exit(code: int) <noret>;

#[export]
#c_ifdef FIN_TARGET_WINDOWS
#[llvm_name="_getpid"]
#c_else
#[llvm_name="getpid"]
#c_endif
@define get_pid() <int>;

#[export]
pub fun get_env(name: string, default_val: string) <string> {
    let val <string> = getenv(name);
    if (val == null) { return default_val; }
    return val;
}

#[export]
pub fun has_env(name: string) <bool> {
    return getenv(name) != null;
}

#[export]
// Windows returns false for an empty value; UCRT would delete it. Use unset_env to delete.
pub fun set_env(name: string, value: string) <bool> {
    return setenv(name, value, 1) == 0;
}

#[export]
pub fun unset_env(name: string) <bool> {
    return unsetenv(name) == 0;
}

#[export]
pub fun exit(code: int) <noret> {
    c_exit(code);
}

}

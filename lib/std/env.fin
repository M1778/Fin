// Env: environment variables and process control.
//
// Reaches standard C library runtime facilities for environment inspection
// and process termination.

namespace std {

#[export]
#[llvm_name="getenv"]
@define getenv(name: string) <string>;

#[export]
#[llvm_name="setenv"]
@define setenv(name: string, value: string, overwrite: int) <int>;

#[export]
#[llvm_name="unsetenv"]
@define unsetenv(name: string) <int>;

#[llvm_name="exit"]
@define c_exit(code: int) <noret>;

#[export]
#[llvm_name="getpid"]
@define get_pid() <int>;

#[export]
pub fun get_env(name: string, default_val: string) <string> {
    let val <string> = getenv(name);
    if (val == null) { return default_val; }
    return val;
}

#[export]
pub fun has_env(name: string) <bool> {
    return getenv(name) != null;
}

#[export]
pub fun set_env(name: string, value: string) <bool> {
    return setenv(name, value, 1) == 0;
}

#[export]
pub fun unset_env(name: string) <bool> {
    return unsetenv(name) == 0;
}

#[export]
pub fun exit(code: int) <noret> {
    c_exit(code);
}

}

// Compiler diagnostics, severity levels, error tracking, and formatted source reporting.
//
// Matches modern compiler diagnostic reporting (Clang, Rust, Fin).
// Provides severity levels, error counters, and formatted diagnostic messages
// with source code snippets and caret underlining.

namespace std {

import { Buffer, new_buffer, free_buffer } from buffer::std;

// Severity levels
pub const DIAG_NOTE <int> = 0;
pub const DIAG_WARNING <int> = 1;
pub const DIAG_ERROR <int> = 2;
pub const DIAG_REFUSAL <int> = 3;

#[llvm_name="snprintf"]
@define diag_snprintf(buf: string, size: ulong, fmt: string, ...) <int>;

#[llvm_name="calloc"]
@define diag_calloc(count: ulong, size: ulong) <string>;

#[llvm_name="free"]
@define diag_free(p: string) <noret>;

#[llvm_name="memcpy"]
@define diag_memcpy(dst: string, src: &char, count: ulong) <string>;

#[llvm_name="fopen"]
@define diag_fopen(filename: string, mode: string) <&void>;

#[llvm_name="fclose"]
@define diag_fclose(stream: &void) <int>;

#[llvm_name="fseek"]
@define diag_fseek(stream: &void, offset: long, whence: int) <int>;

#[llvm_name="ftell"]
@define diag_ftell(stream: &void) <long>;

#[llvm_name="fread"]
@define diag_fread(ptr: string, size: ulong, count: ulong, stream: &void) <ulong>;

#[llvm_name="strlen"]
@define diag_strlen(s: string) <ulong>;

// The other copy direction from `diag_memcpy`: a `string` into a `[char]`.
// Carries its own C name because two externs sharing one do not both link.
#[llvm_name="memmove"]
@define diag_bytes_out(dst: &char, src: string, count: ulong) <&char>;

#[export] pub fun diag_note() <int> { return 0; }
#[export] pub fun diag_warning() <int> { return 1; }
#[export] pub fun diag_error() <int> { return 2; }
#[export] pub fun diag_refusal() <int> { return 3; }

// Returns human-readable name for a diagnostic severity level.
#[export]
pub fun level_name(level: int) <string> {
    if (level == 0) { return "note"; }
    if (level == 1) { return "warning"; }
    if (level == 2) { return "error"; }
    if (level == 3) { return "refusal"; }
    return "diagnostic";
}

#[export]
pub struct Diagnostic {
    pub:
      level <int> = 2,
      message <string> = "",
      file <string> = "",
      line <int> = 1,
      col <int> = 1,
      len <int> = 1,
      hint <string> = "",
}

// Tracks diagnostic counts for a compiler run or compilation unit.
#[export]
pub struct DiagnosticBag {
    pub:
      error_count <int> = 0,
      warn_count <int> = 0,
      note_count <int> = 0,
      refusal_count <int> = 0,

      fun add_error(self: &Self) <noret> {
        self.error_count++;
      }

      fun add_warning(self: &Self) <noret> {
        self.warn_count++;
      }

      fun add_note(self: &Self) <noret> {
        self.note_count++;
      }

      fun add_refusal(self: &Self) <noret> {
        self.refusal_count++;
      }

      fun has_errors(self: &Self) <bool> {
        return self.error_count > 0 || self.refusal_count > 0;
      }

      fun has_warnings(self: &Self) <bool> {
        return self.warn_count > 0;
      }

      fun total(self: &Self) <int> {
        return self.error_count + self.warn_count + self.note_count + self.refusal_count;
      }

      fun clear(self: &Self) <noret> {
        self.error_count = 0;
        self.warn_count = 0;
        self.note_count = 0;
        self.refusal_count = 0;
      }
}

// Formats a single-line compiler diagnostic: `file:line:col: level: message`.
#[export]
pub fun format_simple(file: string, line: int, col: int, level: int, msg: string) <string> {
    let buf <string> = diag_calloc(cast<ulong>(512), cast<ulong>(1));
    let lvl <string> = level_name(level);
    let written <int> = diag_snprintf(buf, cast<ulong>(512), "%s:%d:%d: %s: %s", file, line, col, lvl, msg);
    return buf;
}

#[export]
pub fun format_error(file: string, line: int, col: int, msg: string) <string> {
    return format_simple(file, line, col, diag_error(), msg);
}

#[export]
pub fun format_warning(file: string, line: int, col: int, msg: string) <string> {
    return format_simple(file, line, col, diag_warning(), msg);
}

#[export]
pub fun format_note(file: string, line: int, col: int, msg: string) <string> {
    return format_simple(file, line, col, diag_note(), msg);
}

#[export]
pub fun format_refusal(file: string, line: int, col: int, msg: string) <string> {
    return format_simple(file, line, col, diag_refusal(), msg);
}

// Formats a compiler diagnostic with source snippet and caret underline,
// byte-identical to the C++ DiagnosticEngine's human rendering (which the
// stage mirrors; the reference owns the layout):
//
// ```
// error: unexpected token
//    --> src/main.fin:10:5
//     |
//  10 |     let x = 1;
//     |     ^^^ here
// ```
//
// `span_len > 0` is an explicit span (a node range the caller measured);
// anything else means the caller reports a bare point: the line is re-read
// from `file` and the span is the token at `col`. The `did you mean` hint
// is the C++ reportError auto-pass on the same token (Levenshtein over the
// keyword table, previous-word fallback), so a span that is wrong also
// suggests wrong: callers owe the true span, not an approximation.
priv fun diag_str_eq(a: string, b: string) <bool> {
    if (a == null) { return b == null; }
    if (b == null) { return false; }
    let alen <int> = cast<int>(diag_strlen(a));
    if (alen != cast<int>(diag_strlen(b))) { return false; }
    if (alen == 0) { return true; }
    let ab <[char]> = new [char, alen + 1]{};
    let bb <[char]> = new [char, alen + 1]{};
    let copied1 <&char> = diag_bytes_out(&ab[0], a, cast<ulong>(alen));
    let copied2 <&char> = diag_bytes_out(&bb[0], b, cast<ulong>(alen));
    ab[alen] = cast<char>(0);
    bb[alen] = cast<char>(0);
    let i <int> = 0;
    while (i < alen) {
        if (ab[i] != bb[i]) { delete ab; delete bb; return false; }
        i = i + 1;
    }
    delete ab;
    delete bb;
    return true;
}

// Byte-wise Levenshtein distance (C++ utils::levenshtein_distance): two
// rows, substitution cost 0/1, no transpositions.
priv fun diag_lev(a: string, b: string) <int> {
    if (a == null) {
        if (b == null) { return 0; }
        return cast<int>(diag_strlen(b));
    }
    if (b == null) { return cast<int>(diag_strlen(a)); }
    let m <int> = cast<int>(diag_strlen(a));
    let n <int> = cast<int>(diag_strlen(b));
    if (m == 0) { return n; }
    if (n == 0) { return m; }
    let ab <[char]> = new [char, m + 1]{};
    let bb <[char]> = new [char, n + 1]{};
    let c1 <&char> = diag_bytes_out(&ab[0], a, cast<ulong>(m));
    let c2 <&char> = diag_bytes_out(&bb[0], b, cast<ulong>(n));
    ab[m] = cast<char>(0);
    bb[n] = cast<char>(0);
    let prev <[int]> = new [int, n + 1]{};
    let cur <[int]> = new [int, n + 1]{};
    let j <int> = 0;
    while (j <= n) { prev[j] = j; j = j + 1; }
    let i <int> = 1;
    while (i <= m) {
        cur[0] = i;
        let jj <int> = 1;
        while (jj <= n) {
            let cost <int> = 1;
            if (ab[i - 1] == bb[jj - 1]) { cost = 0; }
            let best <int> = prev[jj] + 1;
            if (cur[jj - 1] + 1 < best) { best = cur[jj - 1] + 1; }
            if (prev[jj - 1] + cost < best) { best = prev[jj - 1] + cost; }
            cur[jj] = best;
            jj = jj + 1;
        }
        let k <int> = 0;
        while (k <= n) { prev[k] = cur[k]; k = k + 1; }
        i = i + 1;
    }
    let res <int> = prev[n];
    delete prev;
    delete cur;
    delete ab;
    delete bb;
    return res;
}

// Closest keyword to `word` (C++ DiagnosticEngine::checkTypo): same table,
// same order (first best wins ties), threshold 1 under length 4 else 2,
// and the distance must beat the word length (a keyword never suggests
// itself). "" when nothing qualifies.
priv fun diag_check_typo(word: string) <string> {
    if (word == null || diag_strlen(word) == cast<ulong>(0)) { return ""; }
    let wlen <int> = cast<int>(diag_strlen(word));
    let best <string> = "";
    let best_dist <int> = 100;
    let kwi <int> = 0;
    while (kwi < 35) {
        let kw <string> = "";
        if (kwi == 0) { kw = "fun"; } else if (kwi == 1) { kw = "struct"; }
        else if (kwi == 2) { kw = "enum"; } else if (kwi == 3) { kw = "let"; }
        else if (kwi == 4) { kw = "const"; } else if (kwi == 5) { kw = "bez"; }
        else if (kwi == 6) { kw = "beton"; } else if (kwi == 7) { kw = "if"; }
        else if (kwi == 8) { kw = "else"; } else if (kwi == 9) { kw = "elseif"; }
        else if (kwi == 10) { kw = "while"; } else if (kwi == 11) { kw = "for"; }
        else if (kwi == 12) { kw = "foreach"; } else if (kwi == 13) { kw = "return"; }
        else if (kwi == 14) { kw = "break"; } else if (kwi == 15) { kw = "continue"; }
        else if (kwi == 16) { kw = "import"; } else if (kwi == 17) { kw = "sizeof"; }
        else if (kwi == 18) { kw = "typeof"; } else if (kwi == 19) { kw = "new"; }
        else if (kwi == 20) { kw = "delete"; } else if (kwi == 21) { kw = "cast"; }
        else if (kwi == 22) { kw = "interface"; } else if (kwi == 23) { kw = "pub"; }
        else if (kwi == 24) { kw = "priv"; } else if (kwi == 25) { kw = "static"; }
        else if (kwi == 26) { kw = "macro"; } else if (kwi == 27) { kw = "operator"; }
        else if (kwi == 28) { kw = "from"; } else if (kwi == 29) { kw = "as"; }
        else if (kwi == 30) { kw = "true"; } else if (kwi == 31) { kw = "false"; }
        else if (kwi == 32) { kw = "null"; } else if (kwi == 33) { kw = "self"; }
        else { kw = "super"; }
        let d <int> = diag_lev(word, kw);
        if (d < best_dist) { best_dist = d; best = kw; }
        kwi = kwi + 1;
    }
    // 35 entries: indices 0..33 above, `super` on the trailing else.
    let threshold <int> = 2;
    if (wlen < 4) { threshold = 1; }
    if (best_dist <= threshold && best_dist < wlen) { return best; }
    return "";
}
priv fun diag_is_ident(b: char) <bool> {
    if (b >= 'a' && b <= 'z') { return true; }
    if (b >= 'A' && b <= 'Z') { return true; }
    if (b >= '0' && b <= '9') { return true; }
    if (b == '_') { return true; }
    return false;
}

// The whole file at `path`, or null when it cannot be read.
priv fun? diag_read_file(path: string) <string> {
    if (path == null) { return null; }
    let fp <&void> = diag_fopen(path, "rb");
    if (fp == null) { return null; }
    let seek_end <int> = diag_fseek(fp, cast<long>(0), 2);
    if (seek_end != 0) {
        diag_fclose(fp);
        return null;
    }
    let sz <long> = diag_ftell(fp);
    if (sz < cast<long>(0)) {
        diag_fclose(fp);
        return null;
    }
    diag_fseek(fp, cast<long>(0), 0);
    let u_sz <ulong> = cast<ulong>(sz);
    let buf <string> = diag_calloc(u_sz + cast<ulong>(1), cast<ulong>(1));
    if (buf == null) {
        diag_fclose(fp);
        return null;
    }
    if (u_sz > cast<ulong>(0)) {
        let n_read <ulong> = diag_fread(buf, cast<ulong>(1), u_sz, fp);
    }
    diag_fclose(fp);
    return buf;
}

// The `line`-th line (1-based) of the file at `path`, without its newline,
// or null when the file cannot be read or has no such line.
priv fun? diag_snippet_line(path: string, line: int) <string> {
    if (line < 1) { return null; }
    let text? <string> = diag_read_file(path);
    if (text == null) { return null; }
    let total <int> = cast<int>(diag_strlen(text?));
    let bytes <[char]> = new [char, total + 1]{};
    let copied <&char> = diag_bytes_out(&bytes[0], text?, cast<ulong>(total));
    bytes[total] = cast<char>(0);
    diag_free(text?);

    let cur <int> = 1;
    let start <int> = 0;
    let found <int> = -1;
    let found_len <int> = 0;
    let i <int> = 0;
    while (i <= total) {
        if (i == total || bytes[i] == cast<char>(10)) {
            if (cur == line) {
                found = start;
                found_len = i - start;
                if (found_len > 0 && bytes[start + found_len - 1] == cast<char>(13)) {
                    found_len = found_len - 1;
                }
                break;
            }
            cur = cur + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (found < 0) {
        delete bytes;
        return null;
    }
    let out <string> = diag_calloc(cast<ulong>(found_len + 1), cast<ulong>(1));
    if (out == null) {
        delete bytes;
        return null;
    }
    if (found_len > 0) {
        let moved <string> = diag_memcpy(out, &bytes[found], cast<ulong>(found_len));
    }
    delete bytes;
    return out;
}

// The identifier length at 1-based `col` of `line_text`, or 1 when `col`
// sits on no identifier character.
priv fun diag_token_span(line_text: string, col: int) <int> {
    let total <int> = cast<int>(diag_strlen(line_text));
    let idx <int> = col - 1;
    if (idx < 0 || idx >= total) { return 1; }
    let bytes <[char]> = new [char, total + 1]{};
    let copied <&char> = diag_bytes_out(&bytes[0], line_text, cast<ulong>(total));
    bytes[total] = cast<char>(0);
    if (!diag_is_ident(bytes[idx])) {
        delete bytes;
        return 1;
    }
    let end <int> = idx;
    while (end < total && diag_is_ident(bytes[end])) {
        end = end + 1;
    }
    delete bytes;
    let span <int> = end - idx;
    if (span < 1) { span = 1; }
    return span;
}

// `span` bytes of `body` from 1-based `col`, or "" when the range is not
// inside the line (C++ extractTokenText guard: a location past the line end
// extracts nothing, and nothing suggests nothing).
priv fun diag_slice(body: string, col: int, span: int) <string> {
    if (body == null || span <= 0 || col < 1) { return ""; }
    let total <int> = cast<int>(diag_strlen(body));
    let start <int> = col - 1;
    if (start >= total || start + span > total) { return ""; }
    let out <string> = diag_calloc(cast<ulong>(span + 1), cast<ulong>(1));
    if (out == null) { return ""; }
    let bytes <[char]> = new [char, total + 1]{};
    let copied <&char> = diag_bytes_out(&bytes[0], body, cast<ulong>(total));
    bytes[total] = cast<char>(0);
    let moved <string> = diag_memcpy(out, &bytes[start], cast<ulong>(span));
    delete bytes;
    return out;
}

// The word before 1-based `col` on `body`, or "" (C++ getPreviousWordLoc
// honesty rule: a column past the line end, or nothing but spaces before
// it, yields no word, and an empty word suggests nothing downstream).
priv fun diag_prev_word(body: string, col: int) <string> {
    if (body == null) { return ""; }
    let total <int> = cast<int>(diag_strlen(body));
    if (col - 1 > total) { return ""; }
    if (total == 0) { return ""; }
    let bytes <[char]> = new [char, total + 1]{};
    let copied <&char> = diag_bytes_out(&bytes[0], body, cast<ulong>(total));
    bytes[total] = cast<char>(0);
    let cursor <int> = col - 2;
    while (cursor >= 0 && (bytes[cursor] == cast<char>(32) || bytes[cursor] == cast<char>(9) ||
      bytes[cursor] == cast<char>(11) || bytes[cursor] == cast<char>(12))) {
        cursor = cursor - 1;
      }
    if (cursor < 0) { delete bytes; return ""; }
    let end <int> = cursor + 1;
    while (cursor >= 0 && diag_is_ident(bytes[cursor])) { cursor = cursor - 1; }
    let start <int> = cursor + 1;
    if (start >= end) { delete bytes; return ""; }
    let wlen <int> = end - start;
    let out <string> = diag_calloc(cast<ulong>(wlen + 1), cast<ulong>(1));
    if (out == null) { delete bytes; return ""; }
    let moved <string> = diag_memcpy(out, &bytes[start], cast<ulong>(wlen));
    delete bytes;
    return out;
}

#[export]
pub fun format_snippet(file: string, line: int, col: int, level: int, msg: string, source_line: string, span_len: int) <string> {
    let lvl <string> = level_name(level);

    let body <string> = source_line;
    let owns_body <bool> = false;
    if (body == null || diag_strlen(body) == cast<ulong>(0)) {
        let disk? <string> = diag_snippet_line(file, line);
        if (disk != null) {
            body = disk?;
            owns_body = true;
        }
    }

    // Explicit span wins; otherwise the identifier at `col`, or 1 when
    // `col` sits on no identifier character.
    let span <int> = span_len;
    if (span <= 0) {
        if (body == null) { span = 1; }
        else { span = diag_token_span(body, col); }
    }
    if (span < 1) { span = 1; }

    // C++ reportError auto-pass on the same token: `did you mean 'x'?`,
    // else the previous word's `looks suspicious` variant. A span that is
    // wrong suggests wrong, which is why callers owe the true span.
    let help <string> = "";
    if (body != null) {
        let tok <string> = diag_slice(body, col, span);
        if (!diag_str_eq(tok, "")) {
            let sug <string> = diag_check_typo(tok);
            if (diag_str_eq(sug, tok)) { sug = ""; }
            if (!diag_str_eq(sug, "")) {
                let hb <Buffer> = new_buffer(64);
                hb.write_string("did you mean '");
                hb.write_string(sug);
                hb.write_string("'?");
                help = hb.to_string();
                free_buffer(hb);
            } else {
                let pw <string> = diag_prev_word(body, col);
                if (!diag_str_eq(pw, "")) {
                    let psug <string> = diag_check_typo(pw);
                    if (diag_str_eq(psug, pw)) { psug = ""; }
                    if (!diag_str_eq(psug, "")) {
                        let pb <Buffer> = new_buffer(96);
                        pb.write_string("the word '");
                        pb.write_string(pw);
                        pb.write_string("' looks suspicious. Did you mean '");
                        pb.write_string(psug);
                        pb.write_string("'?");
                        help = pb.to_string();
                        free_buffer(pb);
                    }
                }
            }
        }
    }

    let numbuf <Buffer> = new_buffer(16);
    numbuf.write_int(line);
    let numstr <string> = numbuf.to_string();
    free_buffer(numbuf);
    let nlen <int> = cast<int>(diag_strlen(numstr));

    let out <Buffer> = new_buffer(4096);
    out.write_string(lvl);
    out.write_string(": ");
    out.write_string(msg);
    out.write_string("\n   --> ");
    out.write_string(file);
    out.write_char(':');
    out.write_int(line);
    out.write_char(':');
    out.write_int(col);
    out.write_string("\n ");
    let pi <int> = 0;
    while (pi < nlen) { out.write_char(' '); pi = pi + 1; }
    out.write_string(" |\n ");
    out.write_string(numstr);
    out.write_string(" | ");
    if (body != null) { out.write_string(body); }
    out.write_string("\n ");
    let qi <int> = 0;
    while (qi < nlen) { out.write_char(' '); qi = qi + 1; }
    out.write_string(" | ");
    let si <int> = 1;
    while (si < col) { out.write_char(' '); si = si + 1; }
    let ci <int> = 0;
    while (ci < span) { out.write_char('^'); ci = ci + 1; }
    out.write_string(" here\n");
    if (!diag_str_eq(help, "")) {
        out.write_string("   = help: ");
        out.write_string(help);
        out.write_string("\n");
    }
    let res <string> = out.to_string();
    free_buffer(out);
    if (owns_body) {
        diag_free(body);
    }
    return res;
}

// Frees formatted diagnostic string buffers.
#[export]
pub fun free_diag_str(s: string) <noret> {
    diag_free(s);
}

}

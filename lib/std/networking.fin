// SPDX-License-Identifier: GPL-3.0-or-later
// Networking: TCP over IPv4, through POSIX sockets or Winsock 2.
//
// The file this replaces was empty on purpose, and the empty file's argument is
// recorded here because the module that now stands under it was built by
// answering that argument. It refused to invent an API because nothing in the
// tree said what one should look like, and named its own price of unblocking:
// "a sample, or an owner ruling on the surface -- blocking or non-blocking,
// whether an address is a `string` or a struct, and whether a failure is a
// `Result`, an `IOResult` or a `blame`." The owner ruling came 2026-09-19:
// complete the module, and where the draft had no answer, take "the simplest
// thing that works" -- the shape the same comment guessed at and `stdio.fin`'s
// `File` already proves: statics over libc, `blame` on failure. The corpus now
// carries that ruling (tests/samples/stdlib/networking.fin).
//
// The four questions, answered:
//
//   * Address: a dotted-quad `string`, resolved by C's `inet_addr`. A struct
//     would restate `sockaddr_in` in Fin and then have to defend its layout
//     against C's, byte for byte; the string is what a person writes and what
//     libc already parses. A hostname is not resolved -- `getaddrinfo` is a
//     second resolver with its own lifetime questions, and a module that
//     dials a dotted quad is honest about being exactly that.
//   * Failure: `blame`, with a message. Not `Result`: a `Result<T, E>` is
//     every caller's `unwrap` away from the same raise, and a connection
//     refused is not a value the caller can mean anything by. Not
//     `IOResult`: a socket error carries no payload a caller reads. The
//     messages name the call that failed, because "connection refused" and
//     "cannot bind" are different mornings.
//   * Blocking: blocking, like `File`'s reads. Non-blocking I/O is a state
//     machine the corpus has no sample for; this module does not invent one.
//   * A connection is a `Socket`: a struct wrapping the descriptor, so the
//     type system can tell a listener from an int. Its `.fd` holds the
//     native handle; a successful close invalidates it. Each Windows socket
//     holds one Winsock startup reference, released when that socket closes.
//
// The wire details are filled by hand rather than through a declared struct:
// an extern cannot take or return a Fin struct (declareFunction refuses the
// aggregate on the ABI question), so `sockaddr_in` is its sixteen bytes in a
// `[int, 4]`, family first, port and address in network order. The
// arithmetic writes them the way `htons` and `inet_addr` already ordered
// them, big-endian, high byte first.
//
// Measured end to end, not merely type-checked: a test dials `127.0.0.1`,
// sends, and reads the echo back (Soundness_Stdlib, Networking_*); the
// loopback needs no network and no peer outside the test process.
//
// THE TCP NAMES OVER THE PLUMBING (2026-10-19, issue #58): the issue asked
// for the names a newcomer already knows -- `TcpStream`, `TcpListener`,
// explicit-count `read`/`write` like `File`'s, `close` -- alongside `Socket`
// without retitling the underlying calls, so both layers are here. They are
// thin by intent: every wrapper forwards to the plumbing above it, so the
// one ABI-relevant judgment in this file stays exactly one.
//
//   * `resolve_localhost` is a named refusal, not a feature: `getaddrinfo`
//     fills a struct whose lifetime the language cannot yet take, and a
//     resolver behind a string-returning extern is a lie about who frees it.
//     A hostname through `dial`/`TcpStream::connect` refuses with "cannot
//     parse the address as a dotted quad" -- that message is the refusal.
//   * No `Outcome` here. The issue allowed it for read/write retry paths
//     only with an owner's note, and no note is in hand; byte counts stay
//     byte counts, and failures stay `blame`, per the standing ruling.
//   * No TLS, and the `http_get` stretch is honest about the 4 KB cap: a
//     larger response stops at 4096 bytes, and the caller sees what was
//     received, which `read_all`-style callers await a growing-buffer API.
namespace std {

#c_ifdef FIN_TARGET_WINDOWS
type SocketHandle = ulong;
type SocketSize = int;
type SocketCount = int;
type AddressLength = int;

#[llvm_name="WSAStartup"]
@define net_startup(version: ushort, data: &void) <int>;

#[llvm_name="WSACleanup"]
@define net_cleanup() <int>;
#c_else
type SocketHandle = int;
type SocketSize = ulong;
type SocketCount = long;
type AddressLength = uint;
#c_endif

#[export]
#[llvm_name="socket"]
@define c_socket(domain: int, kind: int, protocol: int) <SocketHandle>;

#[export]
#[llvm_name="connect"]
@define c_connect(fd: SocketHandle, addr: &int, len: AddressLength) <int>;

#[export]
#[llvm_name="bind"]
@define c_bind(fd: SocketHandle, addr: &int, len: AddressLength) <int>;

#[export]
#[llvm_name="listen"]
@define c_listen(fd: SocketHandle, backlog: int) <int>;

#[export]
#[llvm_name="accept"]
#c_ifdef FIN_TARGET_WINDOWS
@define c_accept(fd: SocketHandle, addr: &int, len: &int) <SocketHandle>;
#c_else
@define c_accept(fd: SocketHandle, addr: &int, len: &uint) <SocketHandle>;
#c_endif

#[export]
#[llvm_name="getsockname"]
#c_ifdef FIN_TARGET_WINDOWS
@define c_getsockname(fd: SocketHandle, addr: &int, len: &int) <int>;
#c_else
@define c_getsockname(fd: SocketHandle, addr: &int, len: &uint) <int>;
#c_endif

#[export]
#[llvm_name="send"]
@define c_send(fd: SocketHandle, buf: string, len: SocketSize, flags: int) <SocketCount>;

#[export]
#[llvm_name="recv"]
@define c_recv(fd: SocketHandle, buf: &char, len: SocketSize, flags: int) <SocketCount>;

#[export]
#c_ifdef FIN_TARGET_WINDOWS
#[llvm_name="closesocket"]
#c_else
#[llvm_name="close"]
#c_endif
@define c_close(fd: SocketHandle) <int>;

#[export]
#[llvm_name="inet_addr"]
@define c_inet_addr(cp: string) <uint>;

fun net_acquire() <noret> {
    #c_ifdef FIN_TARGET_WINDOWS
    let data <[long]> = new [long, 51]{};
    let status <int> = net_startup(cast<ushort>(514), &data[0]);
    delete data;
    blame status == 0, "cannot initialize Winsock";
    #c_endif
}

fun net_release() <noret> {
    #c_ifdef FIN_TARGET_WINDOWS
    blame net_cleanup() == 0, "cannot release Winsock";
    #c_endif
}

// The pieces `http_get` composes with are not externs of this module's own:
// a second `#[llvm_name="strcpy"]` in the crate is a link question the
// stdlib settled once by owning each alias in the module that uses it
// (`strings.fin`'s header), so the request is built and the answer bytes are
// stringified through strings::std's `concat`/`from_chars`, and only the
// length of a `read` answer is measured here, by the terminator
// `recv_bytes` wrote.
import { concat, from_chars, len, free_str } from strings::std;

// The length of a `read` answer. `recv_bytes` writes the terminator at the
// count it received, so the scan stops there; that terminator is the length
// signal the array itself does not carry.
priv fun blen(b: [char]) <int> {
    let n <int> = 0;
    while (b[n] != cast<char>(0)) {
        n = n + 1;
    }
    return n;
}

#[export]
// `sockaddr_in` is its sixteen bytes in an `[int, 4]`. Word 0 is the C struct's
// first two `short`s -- `sin_family` (host order) then `sin_port` (network
// order) -- packed into one 32-bit store, and word 1 is `sin_addr`, stored
// exactly as `inet_addr` answered it, which is already network order. Storing
// the four bytes as bytes would have to know which end of an integer is which;
// a store of the integer whose *bits* are those bytes does not, because the
// platform writes it the same way C does. The port is packed through a `long`
// so that the high byte's term does not overflow an `int` on the way in.
pub struct Socket {
    fd <SocketHandle>,

      // Dials `host`:`port` and blocks until the connection is established.
      // The `sockaddr_in` is built before the socket, so a malformed address
      // blames before anything is opened.
      static fun dial(host: string, port: int) <Socket> {
        blame port > 0, "a port is positive";
        net_acquire();
        let a <uint> = c_inet_addr(host);
        blame a != cast<uint>(-1), "cannot parse the address as a dotted quad";
        let addr <[int]> = new [int, 4]{};
        addr[0] = cast<int>(2 + cast<long>(port / 256) * 65536 +
          cast<long>(port % 256) * 16777216);
        #c_ifdef FIN_TARGET_DARWIN
        addr[0] = addr[0] + 526;
        #c_endif
        addr[1] = cast<int>(a);
        let fd <SocketHandle> = c_socket(2, 1, 0);   // AF_INET, SOCK_STREAM
        blame fd != cast<SocketHandle>(-1), "cannot open a socket";
        let err <int> = c_connect(fd, &addr[0], cast<AddressLength>(16));
        delete addr;
        if (err != 0) {
            c_close(fd);
            net_release();
            blame err == 0, "cannot connect";
        }
        return Socket{fd: fd};
      }

    // Binds `port` on every interface and listens. Returns the listening
    // socket; a connection is taken with `accept_conn`. A port of 0 asks the
    // kernel to choose an unused one, which `local_port` then reports -- the
    // only way a caller can pick a port nothing else holds.
    static fun serve(port: int, backlog: int) <Socket> {
        blame port >= 0, "a port cannot be negative";
        blame backlog > 0, "a backlog is positive";
        net_acquire();
        let addr <[int]> = new [int, 4]{};
        addr[0] = cast<int>(2 + cast<long>(port / 256) * 65536 +
          cast<long>(port % 256) * 16777216);
        #c_ifdef FIN_TARGET_DARWIN
        addr[0] = addr[0] + 526;
        #c_endif
        addr[1] = 0;                  // INADDR_ANY
        let fd <SocketHandle> = c_socket(2, 1, 0);
        blame fd != cast<SocketHandle>(-1), "cannot open a socket";
        let bound <int> = c_bind(fd, &addr[0], cast<AddressLength>(16));
        delete addr;
        if (bound != 0) {
            c_close(fd);
            net_release();
            blame bound == 0, "cannot bind";
        }
        let err <int> = c_listen(fd, backlog);
        if (err != 0) {
            c_close(fd);
            net_release();
            blame err == 0, "cannot listen";
        }
        return Socket{fd: fd};
    }

    // Takes one connection. The peer address is C's to fill and this module's
    // to discard: a caller who wants it is asking for a second module, and a
    // zeroed `sockaddr_in` storage is what `accept` writes into on this call.
    fun accept_conn(self: &Socket) <Socket> {
        let peer <[int]> = new [int, 4]{};
        let peerlen <AddressLength> = cast<AddressLength>(16);
        net_acquire();
        let fd <SocketHandle> = c_accept(self.fd, &peer[0], &peerlen);
        delete peer;
        blame fd != cast<SocketHandle>(-1), "cannot accept a connection";
        return Socket{fd: fd};
    }

    // Sends `text` and returns whether every byte went. A short send on a
    // blocking socket of this size is not a state a caller can mean anything
    // by, so it is a failed send and says so -- the caller decides whether
    // that is a `blame`, which is why this one answers instead of raising.
    fun send_text(self: &Socket, text: string, count: int) <bool> {
        blame count >= 0, "a send count cannot be negative";
        let sent <int> = cast<int>(c_send(self.fd, text, cast<SocketSize>(count), 0));
        return sent == count;
    }

    // Reads at most `cap` bytes into a fresh buffer and returns what arrived.
    // An empty read is the peer's half-close, returned as an empty array
    // rather than blamed: it is an answer, not a failure.
    fun recv_bytes(self: &Socket, cap: int) <[char]> {
        blame cap > 0, "a receive capacity is positive";
        let buffer <[char]> = new [char, cap]{};
        let got <int> = cast<int>(c_recv(self.fd, &buffer[0], cast<SocketSize>(cap), 0));
        if (got < 0) {
            delete buffer;
            blame false, "cannot receive";
        }
        if (got == 0) {
            return buffer;
        }
        let out <[char]> = new [char, got + 1]{};
        let i <int> = 0;
        while (i < got) {
            out[i] = buffer[i];
            i = i + 1;
        }
        out[got] = cast<char>(0);
        delete buffer;
        return out;
    }

    // The port this socket is bound to, in host order. `serve(0, ...)` asks the
    // kernel to choose one, and this is how the caller learns which: the local
    // address `getsockname` writes back is the same `sockaddr_in` word 0 the
    // dial side builds, so the port is its two middle bytes.
    //
    // The arithmetic is unsigned because it has to be: `word` carries the 4-byte
    // network-order port in its high two bytes, so for any port whose low byte is
    // at or above 128 the signed value is negative, and signed division would
    // answer with the wrong bytes.
    fun local_port(self: &Socket) <int> {
        let got <[int]> = new [int, 4]{};
        let glen <AddressLength> = cast<AddressLength>(16);
        let r <int> = c_getsockname(self.fd, &got[0], &glen);
        blame r == 0, "cannot read the local address";
        let u <uint> = cast<uint>(got[0]);
        delete got;
        let hi <uint> = (u / cast<uint>(65536)) % cast<uint>(256);
        let lo <uint> = (u / cast<uint>(16777216)) % cast<uint>(256);
        return cast<int>(hi * cast<uint>(256) + lo);
    }

    // Closes and invalidates this handle. A repeated close answers false.
    fun shutdown(self: &Socket) <bool> {
        if (self.fd == cast<SocketHandle>(-1)) {
            return false;
        }
        let status <int> = c_close(self.fd);
        if (status != 0) {
            return false;
        }
        self.fd = cast<SocketHandle>(-1);
        net_release();
        return true;
    }
}

// The connection a caller lives with, named the way the issue and every
// tutorial name it. Thin by intent: every method forwards to `Socket`'s
// plumbing so the wire ABI stays judged in exactly one place, and the
// ruling stands (`blame` on failure, blocking, dotted-quad only).
#[export]
pub struct TcpStream {
    s <Socket>,

      // Dials the dotted-quad `host` and blocks until connected. A hostname
      // is not resolved: there is no resolver whose lifetime the language
      // can hold, and the refusal is the same message `Socket::dial` names.
      static fun connect(host: string, port: int) <TcpStream> {
        return TcpStream{s: Socket::dial(host, port)};
      }

    // Sends `count` bytes, answering how many landed -- the explicit-count,
    // explicit-answer style `File::write` has; a full send on a blocking
    // socket answers `count`, a short one answers less, so the caller
    // compares instead of guessing.
    fun write(self: &TcpStream, text: string, count: int) <int> {
        blame count >= 0, "a write count cannot be negative";
        return cast<int>(c_send(self.s.fd, text, cast<SocketSize>(count), 0));
    }

    // Reads up to `cap` bytes into a fresh buffer and answers what arrived;
    // the peer's half-close answers an empty array, as `recv_bytes` reads.
    // Caller-owned: `delete` the array, like `File::read`'s.
    fun read(self: &TcpStream, cap: int) <[char]> {
        return self.s.recv_bytes(cap);
    }

    // Closes. Answers whether the native socket was released.
    fun close(self: &TcpStream) <bool> {
        return self.s.shutdown();
    }
}

// The listening side, as thin as the stream side. An accepted listener begets
// a `TcpStream`; the wrapper holds the listening descriptor the same way.
#[export]
pub struct TcpListener {
    s <Socket>,

      // Binds the positive `port` (0 asks the kernel to choose) with a
      // positive backlog. `local_port` reports the kernel's choice.
      static fun bind(port: int, backlog: int) <TcpListener> {
        return TcpListener{s: Socket::serve(port, backlog)};
      }

    // Takes one connection and hands it back as the stream callers
    // read and write. The listener stays open for the next one.
    fun accept(self: &TcpListener) <TcpStream> {
        return TcpStream{s: self.s.accept_conn()};
    }

    // The port this listener is bound to, as `Socket::local_port` reports.
    fun local_port(self: &TcpListener) <int> {
        return self.s.local_port();
    }

    // Closes the listener; connections already accepted are unaffected.
    fun close(self: &TcpListener) <bool> {
        return self.s.shutdown();
    }
}

// The stretch demo: one blocking HTTP/1.0 GET over this surface, bytes
// capped at 4096 because the module has no growing-buffer API yet to offer
// an uncapped answer. `host` is a dotted quad (the refusal above is why);
// there is no TLS. The returned `string` is caller-owned heap (`free_str`);
// request strings and receive buffers are released before returning.
#[export]
pub fun http_get(host: string, port: int, path: string) <string> {
    let srv <TcpStream> = TcpStream::connect(host, port);
    let target <string> = concat("GET ", path);
    let line <string> = concat(target, " HTTP/1.0\r\nHost: ");
    free_str(target);
    let headers <string> = concat(line, host);
    free_str(line);
    let req <string> = concat(headers, "\r\n\r\n");
    free_str(headers);
    let nreq <int> = len(req);
    let wrote <int> = srv.write(req, nreq);
    free_str(req);
    blame wrote == nreq, "cannot send the request whole";
    let resp <[char]> = new [char, 4097]{};
    let total <int> = 0;
    let stop <bool> = false;
    while (total < 4096 && !stop) {
        // The count below is at least 1 while the loop runs, so `read`'s
        // positive-capacity rule holds on every call.
        let got <[char]> = srv.read(4096 - total);
        let rlen <int> = blen(got);
        let i <int> = 0;
        while (i < rlen) {
            resp[total + i] = got[i];
            i = i + 1;
        }
        delete got;
        total = total + rlen;
        if (rlen == 0) {
            // The peer's half-close, unchanged from `recv_bytes`' answer.
            stop = true;
        }
    }
    srv.close();
    resp[total] = cast<char>(0);
    let result <string> = from_chars(resp, 0, total);
    delete resp;
    return result;
}

}

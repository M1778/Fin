// SPDX-License-Identifier: GPL-3.0-or-later
// Filesystem operations: reading, writing, appending, query, and removal.
//
// Reaches standard C library I/O facilities (fopen, fclose, fseek, ftell,
// fread, fwrite, fputs, remove, mkdir, rmdir, rename, mkdtemp) and the
// directory walk through the `opendir`/`readdir`/`closedir` trio (the one
// dirent symbol set musl, glibc and macOS all export; `readdir`'s record
// shape differs per platform, and `walk_dir` spells that page out below).
//
// WINDOWS is namedly unimplemented the way sync.fin spells it: a child that
// imports fs::std refuses at the Windows link on this module's `mkdtemp` and
// `opendir`/`readdir`/`closedir`/`rewinddir` externs (ucrt ships none of the
// dirent family), so the soundness tests for those paths skip there instead
// of showing a red link. The directory facts this walk needs wait on a
// FindFirstFile-shaped spine; nothing here silently degrades in the meantime.
//
// OWNERSHIP: every string returned by `read_to_string` and by `walk_dir`'s
// entries is dynamically allocated and caller-owned. `free_file_content`
// releases a `read_to_string` result; `delete` the array `walk_dir` returns
// and `free_str` each entry it holds. `mk_tmp_dir` answers one fresh name,
// freed with `free_str`.

import { len, substr, to_chars, from_chars, clone, free_str, concat } from strings::std;

namespace std {

#[llvm_name="fopen"]
@define fs_fopen(filename: string, mode: string) <&void>;

#[llvm_name="fclose"]
@define fs_fclose(stream: &void) <int>;

#[llvm_name="fseek"]
@define fs_fseek(stream: &void, offset: long, whence: int) <int>;

#[llvm_name="ftell"]
@define fs_ftell(stream: &void) <long>;

#[llvm_name="fread"]
@define fs_fread(ptr: string, size: ulong, count: ulong, stream: &void) <ulong>;

#[llvm_name="fwrite"]
@define fs_fwrite(ptr: string, size: ulong, count: ulong, stream: &void) <ulong>;

#[llvm_name="fputs"]
@define fs_fputs(s: string, stream: &void) <int>;

#[llvm_name="remove"]
@define fs_remove(filename: string) <int>;

#[llvm_name="calloc"]
@define fs_calloc(count: ulong, size: ulong) <string>;

#[llvm_name="free"]
@define fs_free(p: string) <noret>;

#[export]
pub fun free_file_content(s?: string) <noret> {
    if (s != null) {
        fs_free(s?);
    }
}

#[export]
pub fun file_exists(path: string) <bool> {
    if (path == null) { return false; }
    let fp <&void> = fs_fopen(path, "rb");
    if (fp == null) { return false; }
    fs_fclose(fp);
    return true;
}

#[export]
pub fun remove_file(path: string) <bool> {
    if (path == null) { return false; }
    return fs_remove(path) == 0;
}

#[export]
pub fun file_size(path: string) <long> {
    if (path == null) { return cast<long>(-1); }
    let fp <&void> = fs_fopen(path, "rb");
    if (fp == null) { return cast<long>(-1); }
    let seek_res <int> = fs_fseek(fp, cast<long>(0), 2);
    if (seek_res != 0) {
        fs_fclose(fp);
        return cast<long>(-1);
    }
    let sz <long> = fs_ftell(fp);
    fs_fclose(fp);
    return sz;
}

#[export]
pub fun? read_to_string(path: string) <string> {
    if (path == null) { return null; }
    let fp <&void> = fs_fopen(path, "rb");
    if (fp == null) { return null; }

    let seek_end <int> = fs_fseek(fp, cast<long>(0), 2);
    if (seek_end != 0) {
        fs_fclose(fp);
        return null;
    }
    let sz <long> = fs_ftell(fp);
    if (sz < cast<long>(0)) {
        fs_fclose(fp);
        return null;
    }
    fs_fseek(fp, cast<long>(0), 0);

    let u_sz <ulong> = cast<ulong>(sz);
    let buf <string> = fs_calloc(u_sz + cast<ulong>(1), cast<ulong>(1));
    if (buf == null) {
        fs_fclose(fp);
        return null;
    }
    if (u_sz > cast<ulong>(0)) {
        let n_read <ulong> = fs_fread(buf, cast<ulong>(1), u_sz, fp);
    }
    fs_fclose(fp);
    return buf;
}

#[export]
pub fun write_string(path: string, content: string) <bool> {
    if (path == null) { return false; }
    if (content == null) { return false; }
    let fp <&void> = fs_fopen(path, "wb");
    if (fp == null) { return false; }
    let written <int> = fs_fputs(content, fp);
    fs_fclose(fp);
    return written >= 0;
}

#[export]
pub fun append_string(path: string, content: string) <bool> {
    if (path == null) { return false; }
    if (content == null) { return false; }
    let fp <&void> = fs_fopen(path, "ab");
    if (fp == null) { return false; }
    let written <int> = fs_fputs(content, fp);
    fs_fclose(fp);
    return written >= 0;
}

// Copies a whole file byte for byte. Reads the source through `read_to_string`
// and writes it with `write_string`, so a missing source reads as null and
// reports `false` rather than creating an empty destination.
#[export]
pub fun copy_file(src: string, dst: string) <bool> {
    if (src == null) { return false; }
    if (dst == null) { return false; }
    let content? <string> = read_to_string(src);
    if (content == null) { return false; }
    let ok <bool> = write_string(dst, content?);
    free_file_content(content);
    return ok;
}

#[llvm_name="mkdir"]
@define fs_mkdir(path: string, mode: int) <int>;

#[llvm_name="rmdir"]
@define fs_rmdir(path: string) <int>;

#[llvm_name="rename"]
@define fs_rename(old_path: string, new_path: string) <int>;

#[llvm_name="opendir"]
@define fs_opendir(name: string) <&void>;

#[llvm_name="closedir"]
@define fs_closedir(dirp: &void) <int>;

#[llvm_name="readdir"]
@define fs_readdir(dirp: &void) <string>;

#[llvm_name="rewinddir"]
@define fs_rewinddir(dirp: &void) <noret>;

#[llvm_name="memcpy"]
@define fs_memcpy(dst: &char, src: string, count: ulong) <&char>;

#[llvm_name="mkdtemp"]
@define fs_mkdtemp(template: &char) <string>;

#[export]
pub fun create_dir(path: string) <bool> {
    if (path == null) { return false; }
    // 0755 octal = 493 decimal
    return fs_mkdir(path, 493) == 0;
}

// `mkdir -p`: every missing directory on the way to `path` is created, each
// prefix spelled with `substr` (fresh, freed here). A prefix that already
// exists is not a failure, because that is what `-p` means; the empty root of
// an absolute path is skipped the same way.
#[export]
pub fun mkdir_p(path: string) <bool> {
    if (path == null || len(path) == 0) { return false; }
    let chars <[char]> = to_chars(path);
    let n <int> = chars.length;
    let made <bool> = true;
    let i <int> = 0;
    while (made && i <= n) {
        if (i == n || chars[i] == cast<char>(47)) {
            let prefix <string> = substr(path, 0, i);
            if (len(prefix) > 0 && !is_dir(prefix)) {
                made = create_dir(prefix);
            }
            free_str(prefix);
        }
        i = i + 1;
    }
    delete chars;
    return made;
}

#[export]
pub fun remove_dir(path: string) <bool> {
    if (path == null) { return false; }
    return fs_rmdir(path) == 0;
}

#[export]
pub fun rename_path(old_path: string, new_path: string) <bool> {
    if (old_path == null || new_path == null) { return false; }
    return fs_rename(old_path, new_path) == 0;
}

#[export]
pub fun is_dir(path: string) <bool> {
    if (path == null) { return false; }
    let dir <&void> = fs_opendir(path);
    if (dir == null) { return false; }
    fs_closedir(dir);
    return true;
}

#[export]
pub fun is_file(path: string) <bool> {
    if (path == null) { return false; }
    return file_exists(path) && !is_dir(path);
}

// A fresh uniquely-named directory under /tmp: `mk_tmp_dir("finfs")` spellings
// build `/tmp/finfs` followed by the six characters `mkdtemp` overwrites, so
// no call ever touches a fixed path and the caller's cwd stays clean. The
// template must live in writable memory, so it is spelled through a `[char]`
// buffer (`to_chars`) and the answer is cloned out of that buffer before it
// is released -- the pointer `mkdtemp` returns points inside it. A null
// prefix or an already taken template answers null, the routine miss.
#[export]
pub fun? mk_tmp_dir(prefix: string) <string> {
    if (prefix == null) { return null; }
    let base <string> = concat(concat("/tmp/", prefix), "XXXXXX");
    let chars <[char]> = to_chars(base);
    free_str(base);
    let made <string> = fs_mkdtemp(&chars[0]);
    if (made == null) { delete chars; return null; }
    let fresh <string> = clone(made);
    delete chars;
    return fresh;
}

// The entries of one directory (not recursive), with `.` and `..` left out,
// in the directory's order.
//
// There is no pointer arithmetic in this library -- a `&char` does not add
// an integer and does not index -- so `readdir`'s dirent pointer is copied
// whole through `fs_memcpy` into a `[char]` buffer and read back there.
// `opendir`/`readdir`/`closedir` is the one dirent symbol set musl, glibc
// and macOS all export (musl ships no `getdirentries` at all, which is why
// the walk leaves that path), and it is also why the record shape cannot be
// fixed at build time: the same `readdir` call hands back three shapes --
// the legacy 32-bit-inode record on darwin x86_64 (`d_reclen` at 4..5,
// `d_namlen` at 7, name at 8), glibc/musl's 64-bit-inode record (`d_reclen`
// at 16..17, `d_type` at 18, name at 19), and darwin arm64's identical head
// with `d_namlen` at 18..19, so its name lands at 21. Each shape is told
// apart per record: byte 7 is `d_namlen` (at least 1) on the legacy kind and
// the top byte of `d_ino` (0 in practice) on the 64-bit kind; byte 19 is a
// name character on glibc/musl and the high byte of `d_namlen` (0) on
// darwin arm64. Each shape windows its own `d_reclen` before the name is
// read, and anything outside the window refuses loudly rather than guessing.
#[export]
pub fun walk_dir(path: string) <[string]> {
    let nothing <[string]> = new [string, 0]{};
    if (path == null) { return nothing; }
    let dir <&void> = fs_opendir(path);
    if (dir == null) { return nothing; }

    let raw <[char]> = new [char, 320]{};

    // Pass one counts the entries this answer will hold.
    let count <int> = 0;
    while (true) {
        let ent <string> = fs_readdir(dir);
        if (ent == null) { break; }
        // Three record shapes share this buffer (see walk_dir's header):
        // byte 7 picks the legacy kind from the 64-bit kind, byte 19 splits
        // the two 64-bit shapes, each branch windows its own reclen.
        let head <&char> = fs_memcpy(&raw[0], ent, cast<ulong>(24));
        let reclen <int> = 0;
        let name_start <int> = 0;
        if (raw[7] == cast<char>(0)) {
            reclen = cast<int>(raw[16]) + cast<int>(raw[17]) * 256;
            blame reclen >= 21 && reclen < 320, "dirent d_reclen outside the 64-bit-record layout walk_dir reads";
            name_start = 19;
            if (raw[19] == cast<char>(0)) { name_start = 21; }
        } else {
            reclen = cast<int>(raw[4]) + cast<int>(raw[5]) * 256;
            blame reclen >= 12 && reclen < 320, "dirent d_reclen outside the legacy record layout walk_dir reads";
            name_start = 8;
        }
        let body <&char> = fs_memcpy(&raw[0], ent, cast<ulong>(reclen));
        if (raw[name_start] == cast<char>(46) && (raw[name_start + 1] == cast<char>(0) || (raw[name_start + 1] == cast<char>(46) && raw[name_start + 2] == cast<char>(0)))) {
            continue;
        }
        count = count + 1;
    }

    // Pass two spells each name out of the same buffer.
    fs_rewinddir(dir);
    let out <[string]> = new [string, count]{};
    let fill <int> = 0;
    while (fill < count) {
        let ent <string> = fs_readdir(dir);
        if (ent == null) { break; }
        let head <&char> = fs_memcpy(&raw[0], ent, cast<ulong>(24));
        let reclen <int> = 0;
        let name_start <int> = 0;
        if (raw[7] == cast<char>(0)) {
            reclen = cast<int>(raw[16]) + cast<int>(raw[17]) * 256;
            blame reclen >= 21 && reclen < 320, "dirent d_reclen outside the 64-bit-record layout walk_dir reads";
            name_start = 19;
            if (raw[19] == cast<char>(0)) { name_start = 21; }
        } else {
            reclen = cast<int>(raw[4]) + cast<int>(raw[5]) * 256;
            blame reclen >= 12 && reclen < 320, "dirent d_reclen outside the legacy record layout walk_dir reads";
            name_start = 8;
        }
        let body <&char> = fs_memcpy(&raw[0], ent, cast<ulong>(reclen));
        if (raw[name_start] == cast<char>(46) && (raw[name_start + 1] == cast<char>(0) || (raw[name_start + 1] == cast<char>(46) && raw[name_start + 2] == cast<char>(0)))) {
            continue;
        }
        let name_end <int> = name_start;
        while (name_end < reclen && raw[name_end] != cast<char>(0)) {
            name_end = name_end + 1;
        }
        blame name_end < reclen, "dirent name is not NUL terminated inside its record";
        out[fill] = from_chars(raw, name_start, name_end - name_start);
        fill = fill + 1;
    }

    delete raw;
    fs_closedir(dir);
    return out;
}

}

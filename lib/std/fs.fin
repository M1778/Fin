// SPDX-License-Identifier: GPL-3.0-or-later
// Filesystem operations: reading, writing, appending, query, and removal.
//
// Reaches standard C library I/O facilities (fopen, fclose, fseek, ftell,
// fread, fwrite, fputs, remove, mkdir, rmdir, rename, mkdtemp) and the
// directory walk through the `opendir`/`readdir`/`closedir` trio (the one
// dirent symbol set musl, glibc and macOS all export; `readdir`'s record
// shape differs per platform, and `walk_dir` spells that page out below).
//
// Windows uses UCRT file I/O and Win32 directory APIs. Its narrow paths use
// the same system code page as fopen; these APIs do not promise UTF-8 paths.
//
// OWNERSHIP: every string returned by `read_to_string` and by `walk_dir`'s
// entries is dynamically allocated and caller-owned. `free_file_content`
// releases a `read_to_string` result; `delete` the array `walk_dir` returns
// and `free_str` each entry it holds. `mk_tmp_dir` answers one fresh name,
// freed with `free_str`.

import { len, substr, to_chars, from_chars, clone, free_str, concat } from strings::std;

namespace std {

#[llvm_name="fopen"]
@define fs_fopen(filename: string, mode: string) <&void>;

#[llvm_name="fclose"]
@define fs_fclose(stream: &void) <int>;

#c_ifdef FIN_TARGET_WINDOWS
#[llvm_name="_fseeki64"]
#c_else
#[llvm_name="fseek"]
#c_endif
@define fs_fseek(stream: &void, offset: long, whence: int) <int>;

#c_ifdef FIN_TARGET_WINDOWS
#[llvm_name="_ftelli64"]
#c_else
#[llvm_name="ftell"]
#c_endif
@define fs_ftell(stream: &void) <long>;

#[llvm_name="fread"]
@define fs_fread(ptr: string, size: ulong, count: ulong, stream: &void) <ulong>;

#[llvm_name="fwrite"]
@define fs_fwrite(ptr: string, size: ulong, count: ulong, stream: &void) <ulong>;

#[llvm_name="fputs"]
@define fs_fputs(s: string, stream: &void) <int>;

#[llvm_name="remove"]
@define fs_remove(filename: string) <int>;

#[llvm_name="calloc"]
@define fs_calloc(count: ulong, size: ulong) <string>;

#[llvm_name="free"]
@define fs_free(p: string) <noret>;

#[export]
pub fun free_file_content(s?: string) <noret> {
    if (s != null) {
        fs_free(s?);
    }
}

#[export]
pub fun file_exists(path: string) <bool> {
    if (path == null) { return false; }
    let fp <&void> = fs_fopen(path, "rb");
    if (fp == null) { return false; }
    fs_fclose(fp);
    return true;
}

#[export]
pub fun remove_file(path: string) <bool> {
    if (path == null) { return false; }
    return fs_remove(path) == 0;
}

#[export]
pub fun file_size(path: string) <long> {
    if (path == null) { return cast<long>(-1); }
    let fp <&void> = fs_fopen(path, "rb");
    if (fp == null) { return cast<long>(-1); }
    let seek_res <int> = fs_fseek(fp, cast<long>(0), 2);
    if (seek_res != 0) {
        fs_fclose(fp);
        return cast<long>(-1);
    }
    let sz <long> = fs_ftell(fp);
    fs_fclose(fp);
    return sz;
}

priv fun? fs_read_content(path: string, size: &ulong) <string> {
    *size = cast<ulong>(0);
    if (path == null) { return null; }
    let fp <&void> = fs_fopen(path, "rb");
    if (fp == null) { return null; }

    let seek_end <int> = fs_fseek(fp, cast<long>(0), 2);
    if (seek_end != 0) {
        fs_fclose(fp);
        return null;
    }
    let sz <long> = fs_ftell(fp);
    if (sz < cast<long>(0)) {
        fs_fclose(fp);
        return null;
    }
    if (fs_fseek(fp, cast<long>(0), 0) != 0) {
        fs_fclose(fp);
        return null;
    }

    let u_sz <ulong> = cast<ulong>(sz);
    let buf <string> = fs_calloc(u_sz + cast<ulong>(1), cast<ulong>(1));
    if (buf == null) {
        fs_fclose(fp);
        return null;
    }
    if (u_sz > cast<ulong>(0)) {
        let n_read <ulong> = fs_fread(buf, cast<ulong>(1), u_sz, fp);
        if (n_read != u_sz) {
            fs_free(buf);
            fs_fclose(fp);
            return null;
        }
    }
    fs_fclose(fp);
    *size = u_sz;
    return buf;
}

#[export]
pub fun? read_to_string(path: string) <string> {
    let size <ulong> = cast<ulong>(0);
    return fs_read_content(path, &size);
}

#[export]
pub fun write_string(path: string, content: string) <bool> {
    if (path == null) { return false; }
    if (content == null) { return false; }
    let fp <&void> = fs_fopen(path, "wb");
    if (fp == null) { return false; }
    let written <int> = fs_fputs(content, fp);
    fs_fclose(fp);
    return written >= 0;
}

#[export]
pub fun append_string(path: string, content: string) <bool> {
    if (path == null) { return false; }
    if (content == null) { return false; }
    let fp <&void> = fs_fopen(path, "ab");
    if (fp == null) { return false; }
    let written <int> = fs_fputs(content, fp);
    fs_fclose(fp);
    return written >= 0;
}

// Copies a whole file byte for byte, including embedded NUL bytes. Reading
// finishes before opening the destination, so a same-path copy preserves it.
#[export]
pub fun copy_file(src: string, dst: string) <bool> {
    if (src == null) { return false; }
    if (dst == null) { return false; }
    let size <ulong> = cast<ulong>(0);
    let content? <string> = fs_read_content(src, &size);
    if (content == null) { return false; }
    let fp <&void> = fs_fopen(dst, "wb");
    if (fp == null) {
        free_file_content(content);
        return false;
    }
    let written <ulong> = fs_fwrite(content?, cast<ulong>(1), size, fp);
    let closed <int> = fs_fclose(fp);
    free_file_content(content);
    return written == size && closed == 0;
}

#c_ifdef FIN_TARGET_WINDOWS
#[llvm_name="_mkdir"]
@define fs_mkdir(path: string) <int>;

#[llvm_name="_rmdir"]
#c_else
#[llvm_name="mkdir"]
@define fs_mkdir(path: string, mode: int) <int>;

#[llvm_name="rmdir"]
#c_endif
@define fs_rmdir(path: string) <int>;

#[llvm_name="rename"]
@define fs_rename(old_path: string, new_path: string) <int>;

#c_ifdef FIN_TARGET_WINDOWS
#[llvm_name="GetFileAttributesA"]
@define fs_file_attributes(path: string) <uint>;

#[llvm_name="GetTempPathA"]
@define fs_temp_path(size: uint, buffer: &char) <uint>;

#[llvm_name="CreateDirectoryA"]
@define fs_create_directory(path: string, security: &void) <int>;

#[llvm_name="GetLastError"]
@define fs_last_error() <uint>;

#[llvm_name="IsDBCSLeadByteEx"]
@define fs_is_dbcs_lead(code_page: uint, value: char) <int>;

#[llvm_name="rand_s"]
@define fs_rand_s(value: &uint) <int>;

#[llvm_name="FindFirstFileA"]
@define fs_find_first(pattern: string, data: &char) <&void>;

#[llvm_name="FindNextFileA"]
@define fs_find_next(handle: &void, data: &char) <int>;

#[llvm_name="FindClose"]
@define fs_find_close(handle: &void) <int>;

#[llvm_name="memcmp"]
@define fs_compare_handle(handle: &&void, bits: &long, count: ulong) <int>;

priv fun fs_invalid_handle(handle: &void) <bool> {
    let bits <long> = cast<long>(-1);
    return fs_compare_handle(&handle, &bits, cast<ulong>(8)) == 0;
}

priv fun fs_next_path_char(chars: [char], index: int) <int> {
    let next <int> = index + 1;
    if (next < chars.length - 1 && cast<uint>(chars[index]) >= cast<uint>(128) && fs_is_dbcs_lead(cast<uint>(0), chars[index]) != 0) {
        return next + 1;
    }
    return next;
}
#c_else
#[llvm_name="opendir"]
@define fs_opendir(name: string) <&void>;

#[llvm_name="closedir"]
@define fs_closedir(dirp: &void) <int>;

#[llvm_name="readdir"]
@define fs_readdir(dirp: &void) <string>;

#[llvm_name="rewinddir"]
@define fs_rewinddir(dirp: &void) <noret>;

#[llvm_name="memcpy"]
@define fs_memcpy(dst: &char, src: string, count: ulong) <&char>;

#[llvm_name="mkdtemp"]
@define fs_mkdtemp(template: &char) <string>;
#c_endif

#[export]
pub fun create_dir(path: string) <bool> {
    if (path == null) { return false; }
    #c_ifdef FIN_TARGET_WINDOWS
    return fs_mkdir(path) == 0;
    #c_else
    // 0755 octal = 493 decimal
    return fs_mkdir(path, 493) == 0;
    #c_endif
}

// `mkdir -p`: every missing directory on the way to `path` is created, each
// prefix spelled with `substr` (fresh, freed here). A prefix that already
// exists is not a failure, because that is what `-p` means; the empty root of
// an absolute path is skipped the same way.
#[export]
pub fun mkdir_p(path: string) <bool> {
    if (path == null || len(path) == 0) { return false; }
    let chars <[char]> = to_chars(path);
    let n <int> = chars.length - 1;
    let made <bool> = true;
    let i <int> = 0;
    #c_ifdef FIN_TARGET_WINDOWS
    if (n >= 2 && chars[1] == ':') {
        i = 2;
        if (i < n && (chars[i] == '/' || chars[i] == '\\')) { i = i + 1; }
    } else if (n >= 2 && (chars[0] == '/' || chars[0] == '\\') && (chars[1] == '/' || chars[1] == '\\')) {
        i = 2;
        while (i < n && chars[i] != '/' && chars[i] != '\\') { i = fs_next_path_char(chars, i); }
        if (i < n) { i = i + 1; }
        while (i < n && chars[i] != '/' && chars[i] != '\\') { i = fs_next_path_char(chars, i); }
    }
    #c_endif
    while (made && i <= n) {
        let separator <bool> = i == n;
        if (i < n) {
            separator = chars[i] == '/';
            #c_ifdef FIN_TARGET_WINDOWS
            separator = separator || chars[i] == '\\';
            #c_endif
        }
        if (separator) {
            let prefix <string> = substr(path, 0, i);
            if (len(prefix) > 0 && !is_dir(prefix)) {
                made = create_dir(prefix);
            }
            free_str(prefix);
        }
        #c_ifdef FIN_TARGET_WINDOWS
        i = fs_next_path_char(chars, i);
        #c_else
        i = i + 1;
        #c_endif
    }
    delete chars;
    return made;
}

#[export]
pub fun remove_dir(path: string) <bool> {
    if (path == null) { return false; }
    return fs_rmdir(path) == 0;
}

#[export]
pub fun rename_path(old_path: string, new_path: string) <bool> {
    if (old_path == null || new_path == null) { return false; }
    return fs_rename(old_path, new_path) == 0;
}

#[export]
pub fun is_dir(path: string) <bool> {
    if (path == null) { return false; }
    #c_ifdef FIN_TARGET_WINDOWS
    let attrs <uint> = fs_file_attributes(path);
    return attrs != cast<uint>(4294967295) && attrs / cast<uint>(16) % cast<uint>(2) == cast<uint>(1);
    #c_else
    let dir <&void> = fs_opendir(path);
    if (dir == null) { return false; }
    fs_closedir(dir);
    return true;
    #c_endif
}

#[export]
pub fun is_file(path: string) <bool> {
    if (path == null) { return false; }
    return file_exists(path) && !is_dir(path);
}

// A fresh uniquely-named directory under the platform's temporary directory.
// On POSIX, `mk_tmp_dir("finfs")` spellings
// build `/tmp/finfs` followed by the six characters `mkdtemp` overwrites, so
// no call ever touches a fixed path and the caller's cwd stays clean. The
// template must live in writable memory, so it is spelled through a `[char]`
// buffer (`to_chars`) and the answer is cloned out of that buffer before it
// is released -- the pointer `mkdtemp` returns points inside it. A null
// prefix or an already taken template answers null, the routine miss.
#[export]
pub fun? mk_tmp_dir(prefix: string) <string> {
    if (prefix == null) { return null; }
    #c_ifdef FIN_TARGET_WINDOWS
    let temp_chars <[char]> = new [char, 261]{};
    let temp_len <uint> = fs_temp_path(cast<uint>(261), &temp_chars[0]);
    if (temp_len == cast<uint>(0) || temp_len >= cast<uint>(261)) {
        delete temp_chars;
        return null;
    }
    let temp <string> = from_chars(temp_chars, 0, cast<int>(temp_len));
    delete temp_chars;
    let base <string> = concat(temp, prefix);
    free_str(temp);
    let suffix <[char]> = new [char, 17]{};
    let attempt <int> = 0;
    while (attempt < 128) {
        let random <uint> = cast<uint>(0);
        let i <int> = 0;
        while (i < 16) {
            if (i % 8 == 0 && fs_rand_s(&random) != 0) {
                delete suffix;
                free_str(base);
                return null;
            }
            let digit <int> = cast<int>(random % cast<uint>(16));
            if (digit < 10) { suffix[i] = cast<char>(cast<int>('0') + digit); }
            else { suffix[i] = cast<char>(cast<int>('a') + digit - 10); }
            random = random / cast<uint>(16);
            i = i + 1;
        }
        let tail <string> = from_chars(suffix, 0, 16);
        let candidate <string> = concat(base, tail);
        free_str(tail);
        if (fs_create_directory(candidate, null) != 0) {
            delete suffix;
            free_str(base);
            return candidate;
        }
        let err <uint> = fs_last_error();
        free_str(candidate);
        if (err != cast<uint>(183) && err != cast<uint>(80)) {
            delete suffix;
            free_str(base);
            return null;
        }
        attempt = attempt + 1;
    }
    delete suffix;
    free_str(base);
    return null;
    #c_else
    let start <string> = concat("/tmp/", prefix);
    let base <string> = concat(start, "XXXXXX");
    free_str(start);
    let chars <[char]> = to_chars(base);
    free_str(base);
    let made <string> = fs_mkdtemp(&chars[0]);
    if (made == null) { delete chars; return null; }
    let fresh <string> = clone(made);
    delete chars;
    return fresh;
    #c_endif
}

priv fun fs_dot_entry(raw: [char], start: int) <bool> {
    return raw[start] == '.' && (raw[start + 1] == cast<char>(0) || (raw[start + 1] == '.' && raw[start + 2] == cast<char>(0)));
}

#c_ifdef FIN_TARGET_WINDOWS
#c_else
#c_ifdef FIN_TARGET_DARWIN
#c_ifdef FIN_TARGET_X86_64
#cdef FS_DIRENT_NAME 8
#cdef FS_DIRENT_RECLEN 4
#c_else
#cdef FS_DIRENT_NAME 21
#cdef FS_DIRENT_RECLEN 16
#c_endif
#c_else
#cdef FS_DIRENT_NAME 19
#cdef FS_DIRENT_RECLEN 16
#c_endif

priv fun fs_read_dirent(raw: [char], ent: string) <int> {
    fs_memcpy(&raw[0], ent, cast<ulong>(FS_DIRENT_NAME));
    let reclen <int> = (cast<int>(raw[FS_DIRENT_RECLEN]) & 255) + (cast<int>(raw[FS_DIRENT_RECLEN + 1]) & 255) * 256;
    blame reclen > FS_DIRENT_NAME && reclen <= 1048, "dirent d_reclen outside the target record layout walk_dir reads";
    fs_memcpy(&raw[0], ent, cast<ulong>(reclen));
    return reclen;
}
#c_endif

// The entries of one directory (not recursive), with `.` and `..` left out,
// in the directory's order. POSIX record offsets follow the selected target
// ABI, never inode or filename bytes. Windows reads WIN32_FIND_DATAA's name
// at byte 44 in its 320-byte record. Both passes close their directory handles.
#[export]
pub fun walk_dir(path: string) <[string]> {
    let nothing <[string]> = new [string, 0]{};
    if (path == null || len(path) == 0) { return nothing; }
    #c_ifdef FIN_TARGET_WINDOWS
    let chars <[char]> = to_chars(path);
    let suffix <string> = "/*";
    let last <int> = 0;
    let i <int> = 0;
    while (i < chars.length - 1) {
        last = i;
        i = fs_next_path_char(chars, i);
    }
    if (chars[last] == '/' || chars[last] == '\\' || (chars.length == 3 && chars[1] == ':')) { suffix = "*"; }
    delete chars;
    let pattern <string> = concat(path, suffix);
    let raw <[char]> = new [char, 320]{};
    let dir <&void> = fs_find_first(pattern, &raw[0]);
    if (fs_invalid_handle(dir)) {
        free_str(pattern);
        delete raw;
        return nothing;
    }
    let count <int> = 0;
    let more <int> = 1;
    while (more != 0) {
        if (!fs_dot_entry(raw, 44)) { count = count + 1; }
        more = fs_find_next(dir, &raw[0]);
    }
    fs_find_close(dir);
    let out <[string]> = new [string, count]{};
    if (count == 0) {
        free_str(pattern);
        delete raw;
        return out;
    }
    dir = fs_find_first(pattern, &raw[0]);
    free_str(pattern);
    if (fs_invalid_handle(dir)) {
        delete raw;
        return out;
    }
    let fill <int> = 0;
    more = 1;
    while (fill < count && more != 0) {
        if (!fs_dot_entry(raw, 44)) {
            let end <int> = 44;
            while (end < 304 && raw[end] != cast<char>(0)) { end = end + 1; }
            blame end < 304, "WIN32_FIND_DATAA name is not NUL terminated inside its record";
            out[fill] = from_chars(raw, 44, end - 44);
            fill = fill + 1;
        }
        more = fs_find_next(dir, &raw[0]);
    }
    fs_find_close(dir);
    delete raw;
    return out;
    #c_else
    let dir <&void> = fs_opendir(path);
    if (dir == null) { return nothing; }
    let raw <[char]> = new [char, 1048]{};
    let count <int> = 0;
    while (true) {
        let ent <string> = fs_readdir(dir);
        if (ent == null) { break; }
        fs_read_dirent(raw, ent);
        if (fs_dot_entry(raw, FS_DIRENT_NAME)) { continue; }
        count = count + 1;
    }
    fs_rewinddir(dir);
    let out <[string]> = new [string, count]{};
    let fill <int> = 0;
    while (fill < count) {
        let ent <string> = fs_readdir(dir);
        if (ent == null) { break; }
        let reclen <int> = fs_read_dirent(raw, ent);
        if (fs_dot_entry(raw, FS_DIRENT_NAME)) { continue; }
        let end <int> = FS_DIRENT_NAME;
        while (end < reclen && raw[end] != cast<char>(0)) { end = end + 1; }
        blame end < reclen, "dirent name is not NUL terminated inside its record";
        out[fill] = from_chars(raw, FS_DIRENT_NAME, end - FS_DIRENT_NAME);
        fill = fill + 1;
    }
    delete raw;
    fs_closedir(dir);
    return out;
    #c_endif
}

}

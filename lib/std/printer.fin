// Printer: abstract syntax tree pretty-printer and canonical Fin code formatter.
//
// Reconstructs clean, formatted Fin source code directly from AST nodes.
// Essential for compiler self-hosting, code formatting (`fin fmt`), and compiler debugging.

import { Buffer, new_buffer, free_buffer } from buffer::std;
import {
    AstNode,
    ast_ident,
    ast_literal_int,
    ast_literal_string,
    ast_literal_bool,
    ast_binary_expr,
    ast_unary_expr,
    ast_call_expr,
    ast_member_access,
    ast_index_expr,
    ast_lambda_expr,
    ast_prototype_literal,
    ast_macro_invocation,
    ast_fun_decl,
    ast_param,
    ast_var_decl,
    ast_return_stmt,
    ast_blame_stmt,
    ast_if_stmt,
    ast_while_stmt,
    ast_for_stmt,
    ast_expr_stmt,
    ast_block,
    ast_break_stmt,
    ast_continue_stmt
} from ast::std;

namespace std {

#[llvm_name="strcmp"]
@define pr_strcmp(a: string, b: string) <int>;

priv fun str_eq(a: string, b: string) <bool> {
    if (a == null && b == null) { return true; }
    if (a == null || b == null) { return false; }
    return pr_strcmp(a, b) == 0;
}

// Maps token kinds to operator symbols.
#[export]
pub fun op_symbol(tok_kind: int) <string> {
    if (tok_kind == 80) { return "+"; }
    if (tok_kind == 81) { return "-"; }
    if (tok_kind == 82) { return "*"; }
    if (tok_kind == 83) { return "/"; }
    if (tok_kind == 84) { return "%"; }
    if (tok_kind == 85) { return "="; }
    if (tok_kind == 86) { return "=="; }
    if (tok_kind == 87) { return "!="; }
    if (tok_kind == 88) { return "<"; }
    if (tok_kind == 89) { return ">"; }
    if (tok_kind == 90) { return "<="; }
    if (tok_kind == 91) { return ">="; }
    if (tok_kind == 92) { return "&&"; }
    if (tok_kind == 93) { return "||"; }
    if (tok_kind == 94) { return "!"; }
    return "?";
}

#[export]
pub struct AstPrinter {
    pub:
      buf <Buffer>,
      indent_level <int> = 0,

    pub:
      fun indent(self: &Self) <noret> {
          self.buf.write_repeat(' ', self.indent_level * 4);
      }

      // Prints one statement body: unwraps a block into its statements,
      // otherwise prints the single statement as-is.
      fun print_body_stmts(self: &Self, body: &AstNode) <noret> {
          if (body == null) { return; }
          if (body.kind == ast_block()) {
              let cur <&AstNode> = body.left;
              while (cur != null) {
                  let s <&AstNode> = cur.left;
                  if (s == null) { s = cur; }
                  self.print_stmt(s);
                  cur = cur.right;
              }
              return;
          }
          self.print_stmt(body);
      }

      // Prints a call/macro argument list. Arguments arrive either as wrapper
      // nodes (kind 0, actual arg in left, e.g. `f(a, b)`) or as bare
      // expressions chained by right (e.g. `[a, b]` literals). Struct-init
      // fields (kind 0 with a name) render as `field: value`.
      fun print_arg_list(self: &Self, args: &AstNode) <noret> {
          let cur <&AstNode> = args;
          let first <bool> = true;
          while (cur != null) {
              let a <&AstNode> = cur;
              if (cur.kind == 0 && cur.left != null) { a = cur.left; }
              if (!first) { self.buf.write_string(", "); }
              if (cur.kind == 0 && cur.name != null && !str_eq(cur.name, "")) {
                  self.buf.write_string(cur.name);
                  self.buf.write_string(": ");
              }
              self.print_expr(a);
              first = false;
              cur = cur.right;
          }
      }

      // Prints a function parameter list. Parameters arrive chained by
      // right (`extra` of a fun decl is the head): each renders as
      // `name <annotation>`, the same annotation spelling `let` uses.
      // A bare `...` (extern variadic) renders as `...`. Defaults are
      // not stored in the AST, so there is nothing more to render.
      fun print_param_list(self: &Self, params: &AstNode) <noret> {
          let cur <&AstNode> = params;
          let first <bool> = true;
          while (cur != null) {
              if (!first) { self.buf.write_string(", "); }
              if (str_eq(cur.name, "...")) {
                  self.buf.write_string("...");
              } else {
                  self.buf.write_string(cur.name);
                  if (cur.type_annotation != null && !str_eq(cur.type_annotation, "")) {
                      self.buf.write_string(" <");
                      self.buf.write_string(cur.type_annotation);
                      self.buf.write_char('>');
                  }
              }
              first = false;
              cur = cur.right;
          }
      }

      fun print_expr(self: &Self, node: &AstNode) <noret> {
          if (node == null) { return; }

          if (node.kind == ast_ident()) {
              self.buf.write_string(node.name);
              return;
          }
          if (node.kind == ast_literal_int()) {
              self.buf.write_int(node.int_val);
              return;
          }
          if (node.kind == ast_literal_string()) {
              self.buf.write_char('"');
              self.buf.write_string(node.str_val);
              self.buf.write_char('"');
              return;
          }
          if (node.kind == ast_literal_bool()) {
              if (node.int_val != 0) {
                  self.buf.write_string("true");
              } else {
                  self.buf.write_string("false");
              }
              return;
          }
          if (node.kind == ast_binary_expr()) {
              self.buf.write_char('(');
              self.print_expr(node.left);
              self.buf.write_char(' ');
              if (node.name != null && !str_eq(node.name, "")) {
                  self.buf.write_string(node.name);
              } else {
                  self.buf.write_string(op_symbol(node.int_val));
              }
              self.buf.write_char(' ');
              self.print_expr(node.right);
              self.buf.write_char(')');
              return;
          }
          if (node.kind == ast_unary_expr()) {
              if (node.name != null && !str_eq(node.name, "")) {
                  self.buf.write_string(node.name);
              } else {
                  self.buf.write_string(op_symbol(node.int_val));
              }
              self.print_expr(node.left);
              return;
          }
          if (node.kind == ast_call_expr()) {
              if (str_eq(node.name, "__fin_struct_init")) {
                  self.buf.write_string(node.type_annotation);
                  self.buf.write_char('{');
                  self.print_arg_list(node.left);
                  self.buf.write_char('}');
                  return;
              }
              if (str_eq(node.name, "__fin_array_literal")) {
                  self.buf.write_char('[');
                  self.print_arg_list(node.left);
                  self.buf.write_char(']');
                  return;
              }
              self.buf.write_string(node.name);
              if (node.type_annotation != null && !str_eq(node.type_annotation, "")) {
                  self.buf.write_string("::<");
                  self.buf.write_string(node.type_annotation);
                  self.buf.write_char('>');
              }
              self.buf.write_char('(');
              self.print_arg_list(node.left);
              self.buf.write_char(')');
              return;
          }
          if (node.kind == ast_member_access()) {
              self.print_expr(node.left);
              self.buf.write_char('.');
              self.buf.write_string(node.name);
              return;
          }
          if (node.kind == ast_index_expr()) {
              self.print_expr(node.left);
              self.buf.write_char('[');
              self.print_expr(node.right);
              self.buf.write_char(']');
              return;
          }
          if (node.kind == ast_prototype_literal()) {
              self.buf.write_char('{');
              let pair <&AstNode> = node.left;
              let pfirst <bool> = true;
              while (pair != null) {
                  if (!pfirst) { self.buf.write_string(", "); }
                  self.print_expr(pair.left);
                  self.buf.write_string(": ");
                  self.print_expr(pair.right);
                  pfirst = false;
                  pair = pair.extra;
              }
              self.buf.write_char('}');
              return;
          }
          if (node.kind == ast_macro_invocation()) {
              self.buf.write_string(node.name);
              self.buf.write_char('!');
              self.buf.write_char('(');
              self.print_arg_list(node.left);
              self.buf.write_char(')');
              return;
          }
          if (node.kind == ast_lambda_expr()) {
              self.buf.write_char('|');
              let pp <&AstNode> = node.extra;
              let qfirst <bool> = true;
              while (pp != null) {
                  if (!qfirst) { self.buf.write_string(", "); }
                  self.buf.write_string(pp.name);
                  qfirst = false;
                  pp = pp.right;
              }
              self.buf.write_string("| ");
              if (node.left != null && node.left.kind == ast_block()) {
                  self.print_stmt(node.left);
              } else {
                  self.print_expr(node.left);
              }
              return;
          }
      }

      fun print_stmt(self: &Self, node: &AstNode) <noret> {
          if (node == null) { return; }

          if (node.kind == ast_fun_decl()) {
              self.indent();
              self.buf.write_string("fun ");
              self.buf.write_string(node.name);
              if (node.str_val != null && !str_eq(node.str_val, "")) {
                  self.buf.write_char('<');
                  self.buf.write_string(node.str_val);
                  self.buf.write_char('>');
              }
              self.buf.write_char('(');
              self.print_param_list(node.extra);
              self.buf.write_char(')');
              if (node.type_annotation != null && !str_eq(node.type_annotation, "")) {
                  self.buf.write_string(" <");
                  self.buf.write_string(node.type_annotation);
                  self.buf.write_char('>');
              }
              if (node.left == null) {
                  self.buf.write_line(";");
                  return;
              }
              self.buf.write_line(" {");
              self.indent_level++;
              self.print_body_stmts(node.left);
              self.indent_level--;
              self.indent();
              self.buf.write_line("}");
              return;
          }

          if (node.kind == ast_var_decl()) {
              self.indent();
              self.buf.write_string("let ");
              self.buf.write_string(node.name);
              if (node.type_annotation != null && !str_eq(node.type_annotation, "")) {
                  self.buf.write_string(" <");
                  self.buf.write_string(node.type_annotation);
                  self.buf.write_string(">");
              }
              if (node.left != null) {
                  self.buf.write_string(" = ");
                  self.print_expr(node.left);
              }
              self.buf.write_line(";");
              return;
          }

          if (node.kind == ast_return_stmt()) {
              self.indent();
              self.buf.write_string("return");
              if (node.left != null) {
                  self.buf.write_char(' ');
                  self.print_expr(node.left);
              }
              self.buf.write_line(";");
              return;
          }

          if (node.kind == ast_blame_stmt()) {
              self.indent();
              self.buf.write_string("blame ");
              if (node.left != null) {
                  self.print_expr(node.left);
              }
              if (node.right != null) {
                  self.buf.write_string(", ");
                  self.print_expr(node.right);
              }
              self.buf.write_line(";");
              return;
          }

          if (node.kind == ast_if_stmt()) {
              self.indent();
              self.buf.write_string("if (");
              self.print_expr(node.left);
              self.buf.write_line(") {");
              self.indent_level++;
              self.print_body_stmts(node.right);
              self.indent_level--;
              self.indent();
              self.buf.write_string("}");
              if (node.extra != null) {
                  self.buf.write_line(" else {");
                  self.indent_level++;
                  self.print_body_stmts(node.extra);
                  self.indent_level--;
                  self.indent();
                  self.buf.write_line("}");
              } else {
                  self.buf.write_char('\n');
              }
              return;
          }

          if (node.kind == ast_while_stmt()) {
              self.indent();
              self.buf.write_string("while (");
              self.print_expr(node.left);
              self.buf.write_line(") {");
              self.indent_level++;
              self.print_body_stmts(node.right);
              self.indent_level--;
              self.indent();
              self.buf.write_line("}");
              return;
          }

          if (node.kind == ast_for_stmt()) {
              self.indent();
              self.buf.write_string("for (");
              if (node.left != null) {
                  if (node.left.kind == ast_var_decl()) {
                      self.buf.write_string("let ");
                      self.buf.write_string(node.left.name);
                      if (node.left.type_annotation != null && !str_eq(node.left.type_annotation, "")) {
                          self.buf.write_string(" <");
                          self.buf.write_string(node.left.type_annotation);
                          self.buf.write_string(">");
                      }
                      if (node.left.left != null) {
                          self.buf.write_string(" = ");
                          self.print_expr(node.left.left);
                      }
                  } else if (node.left.kind == ast_expr_stmt()) {
                      self.print_expr(node.left.left);
                  } else {
                      self.print_expr(node.left);
                  }
              }
              self.buf.write_string("; ");
              if (node.right != null) {
                  self.print_expr(node.right);
              }
              self.buf.write_string("; ");
              if (node.extra != null && node.extra.left != null) {
                  self.print_expr(node.extra.left);
              }
              self.buf.write_line(") {");
              self.indent_level++;
              if (node.extra != null) {
                  self.print_body_stmts(node.extra.right);
              }
              self.indent_level--;
              self.indent();
              self.buf.write_line("}");
              return;
          }

          if (node.kind == ast_expr_stmt()) {
              self.indent();
              self.print_expr(node.left);
              self.buf.write_line(";");
              return;
          }

          if (node.kind == ast_block()) {
              self.indent();
              self.buf.write_line("{");
              self.indent_level++;
              self.print_body_stmts(node);
              self.indent_level--;
              self.indent();
              self.buf.write_line("}");
              return;
          }

          if (node.kind == ast_break_stmt()) {
              self.indent();
              self.buf.write_line("break;");
              return;
          }

          if (node.kind == ast_continue_stmt()) {
              self.indent();
              self.buf.write_line("continue;");
              return;
          }
      }

      fun get_formatted(self: &Self) <string> {
          return self.buf.to_string();
      }
}

// Allocates and initializes an AstPrinter.
#[export]
pub fun new_ast_printer() <AstPrinter> {
    return AstPrinter {
        buf: new_buffer(512),
        indent_level: 0
    };
}

// Releases dynamic memory associated with an AstPrinter.
#[export]
pub fun free_ast_printer(printer: AstPrinter) <noret> {
    free_buffer(printer.buf);
}

// Formats an AST expression into a string.
#[export]
pub fun format_expr(node: &AstNode) <string> {
    let p <AstPrinter> = new_ast_printer();
    p.print_expr(node);
    let res <string> = p.get_formatted();
    free_ast_printer(p);
    return res;
}

// Formats an AST statement into a string.
#[export]
pub fun format_stmt(node: &AstNode) <string> {
    let p <AstPrinter> = new_ast_printer();
    p.print_stmt(node);
    let res <string> = p.get_formatted();
    free_ast_printer(p);
    return res;
}

}

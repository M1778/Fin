// Path: filesystem path manipulation functions.
//
// Provides platform path joining, basename/dirname extraction, extension query,
// and absolute path detection.
//
// Every returned string from allocating functions (join, basename, dirname, extname)
// is malloc/calloc-allocated and the caller owns it. `free_path` is provided to release it.

namespace std {

#[llvm_name="strlen"]
@define path_len(s: string) <ulong>;

#[llvm_name="calloc"]
@define path_alloc_zeroed(count: ulong, size: ulong) <string>;

#[llvm_name="strcpy"]
@define path_strcpy(dst: string, src: string) <string>;

#[llvm_name="strcat"]
@define path_strcat(dst: string, src: string) <string>;

#[llvm_name="free"]
@define path_free(p: string) <noret>;

#[llvm_name="memcpy"]
@define path_bytes_out(dst: &char, src: string, count: ulong) <&char>;

#[llvm_name="memmove"]
@define path_bytes_in(dst: string, src: &char, count: ulong) <string>;

priv fun path_alloc(bytes: ulong) <string> {
    return path_alloc_zeroed(bytes, cast<ulong>(1));
  }

priv fun clone_str(s: string) <string> {
    let n <ulong> = path_len(s);
    let out <string> = path_alloc(n + cast<ulong>(1));
    let copied <string> = path_strcpy(out, s);
    return out;
  }

priv fun to_chars(s: string) <[char]> {
    let count <int> = cast<int>(path_len(s));
    let buffer <[char]> = new [char, count + 1]{};
    let copied <&char> = path_bytes_out(&buffer[0], s, cast<ulong>(count));
    buffer[count] = cast<char>(0);
    return buffer;
  }

priv fun from_chars(bytes: [char], start: int, count: int) <string> {
    blame start >= 0, "a slice start cannot be negative";
    blame count >= 0, "a slice length cannot be negative";
    let out <string> = path_alloc(cast<ulong>(count + 1));
    let copied <string> = path_bytes_in(out, &bytes[start], cast<ulong>(count));
    return out;
  }

#[export]
pub fun free_path(s: string) <noret> {
    path_free(s);
  }

#[export]
pub fun is_absolute(path: string) <bool> {
    if (path == null) { return false; }
    let n <ulong> = path_len(path);
    if (n == cast<ulong>(0)) { return false; }
    let chars <[char]> = to_chars(path);
    let first <char> = chars[0];
    delete chars;
    return first == '/';
  }

#[export]
pub fun is_relative(path: string) <bool> {
    return !is_absolute(path);
  }

#[export]
pub fun join(p1: string, p2: string) <string> {
    if (p1 == null) {
        if (p2 == null) { return clone_str(""); }
        return clone_str(p2);
      }
    if (p2 == null) { return clone_str(p1); }
    if (is_absolute(p2)) { return clone_str(p2); }

    let n1 <int> = cast<int>(path_len(p1));
    let n2 <int> = cast<int>(path_len(p2));
    if (n1 == 0) { return clone_str(p2); }
    if (n2 == 0) { return clone_str(p1); }

    let chars1 <[char]> = to_chars(p1);
    let ends_with_slash <bool> = (chars1[n1 - 1] == '/');
    delete chars1;

    let total <ulong> = cast<ulong>(n1 + n2 + 2);
    let out <string> = path_alloc(total);
    let copied <string> = path_strcpy(out, p1);
    if (!ends_with_slash) {
        let appended_slash <string> = path_strcat(out, "/");
      }
    let appended <string> = path_strcat(out, p2);
    return out;
  }

#[export]
pub fun basename(path: string) <string> {
    if (path == null) { return clone_str(""); }
    let total <int> = cast<int>(path_len(path));
    if (total == 0) { return clone_str(""); }

    let chars <[char]> = to_chars(path);
    let end <int> = total;
    while (end > 1) {
        if (chars[end - 1] == '/') { end--; } else { break; }
      }
    if (end == 1) {
        if (chars[0] == '/') {
            delete chars;
            return clone_str("/");
          }
      }

    let start <int> = end - 1;
    while (start >= 0) {
        if (chars[start] == '/') { break; }
        start--;
      }
    start++;

    let out <string> = from_chars(chars, start, end - start);
    delete chars;
    return out;
  }

#[export]
pub fun dirname(path: string) <string> {
    if (path == null) { return clone_str("."); }
    let total <int> = cast<int>(path_len(path));
    if (total == 0) { return clone_str("."); }

    let chars <[char]> = to_chars(path);
    let end <int> = total;
    while (end > 1) {
        if (chars[end - 1] == '/') { end--; } else { break; }
      }
    if (end == 1) {
        if (chars[0] == '/') {
            delete chars;
            return clone_str("/");
          }
      }

    let last_slash <int> = end - 1;
    while (last_slash >= 0) {
        if (chars[last_slash] == '/') { break; }
        last_slash--;
      }

    if (last_slash < 0) {
        delete chars;
        return clone_str(".");
      }

    if (last_slash == 0) {
        delete chars;
        return clone_str("/");
      }

    while (last_slash > 1) {
        if (chars[last_slash - 1] == '/') { last_slash--; } else { break; }
      }

    let out <string> = from_chars(chars, 0, last_slash);
    delete chars;
    return out;
  }

#[export]
pub fun extname(path: string) <string> {
    if (path == null) { return clone_str(""); }
    let base <string> = basename(path);
    let n <int> = cast<int>(path_len(base));
    if (n == 0) {
        path_free(base);
        return clone_str("");
      }

    let chars <[char]> = to_chars(base);
    let dot <int> = n - 1;
    while (dot >= 0) {
        if (chars[dot] == '.') { break; }
        dot--;
      }

    if (dot <= 0) {
        delete chars;
        path_free(base);
        return clone_str("");
      }

    let out <string> = from_chars(chars, dot, n - dot);
    delete chars;
    path_free(base);
    return out;
  }

}

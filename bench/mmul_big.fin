// Matrix multiplication benchmark in Fin.
// Computes N*N matrix product, same workload as mmul.c/mmul.cpp/mmul.rs.
// N = 100 (reduced from C's 200 for Fin's static array constraints).

fun main() <int> {
    let n <int> = 200;
    let a <[int]> = new [int, 40000]{};
    let b <[int]> = new [int, 40000]{};
    let c <[int]> = new [int, 40000]{};
    let i <int> = 0;
    while (i < n) {
        let j <int> = 0;
        while (j < n) {
            a[i * n + j] = i + j;
            b[i * n + j] = i - j;
            c[i * n + j] = 0;
            j = j + 1;
        }
        i = i + 1;
    }
    let i2 <int> = 0;
    while (i2 < n) {
        let k <int> = 0;
        while (k < n) {
            let aik <int> = a[i2 * n + k];
            let j2 <int> = 0;
            while (j2 < n) {
                c[i2 * n + j2] = c[i2 * n + j2] + aik * b[k * n + j2];
                j2 = j2 + 1;
            }
            k = k + 1;
        }
        i2 = i2 + 1;
    }
    printf("%d\n", c[n * n - 1]);
    return 0;
  }

import { assert_eq_int } from testing::std;

// Pins p01: struct method get/set on Box<int> round-trips through &Self.
// Green on both compilers (finc + finc_stage2); bare prints converted to asserts.
struct Box<T> {
    val <T>,

    fun get(self: &Self) <T> {
        return self.val;
    }

    fun set(self: &Self, v: T) <noret> {
        self.val = v;
    }
}

fun main() <noret> {
    let b <Box<int>> = Box::<int>{ val: 41 };
    assert_eq_int(b.get(), 41, "method_basic: get reads the init value");
    b.set(42);
    assert_eq_int(b.get(), 42, "method_basic: set writes through");
}

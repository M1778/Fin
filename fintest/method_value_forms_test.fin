import { assert_eq_int } from testing::std;

// Pins p03: all three value forms (inferred Box{}, explicit Box::<int>{},
// heap new Box) construct a working generic struct.
// Green on both compilers (finc + finc_stage2); bare prints converted to asserts.
struct Box<T> {
    val <T>,

    fun get(self: &Self) <T> {
        return self.val;
    }
}

fun main() <noret> {
    let a <Box<int>> = Box{ val: 1 };
    assert_eq_int(a.get(), 1, "value_forms: Box{} infers the type");
    let b <Box<int>> = Box::<int>{ val: 2 };
    assert_eq_int(b.get(), 2, "value_forms: Box::<int>{} is explicit");
    let c <&Box<int>> = new Box::<int>{ val: 3 };
    assert_eq_int(c.get(), 3, "value_forms: new Box reads back");
}

import { assert_eq_int, assert_eq_long, assert_true } from testing::std;

// Pins battery b01-b08: signed/unsigned/long/char shift semantics.
// All green on both compilers (finc + finc_stage2); prints converted to asserts.
fun main() <noret> {
    assert_eq_int(-8 >> 2, -2, "shift: negative shr is arithmetic");
    assert_eq_int(-8 << 2, -32, "shift: negative shl");
    let a <uint> = cast<uint>(2147483648);
    assert_true((a >> cast<uint>(1)) == cast<uint>(1073741824), "shift: uint shr is logical");
    let b <int> = -2147483648;
    assert_eq_int(b >> cast<int>(1), -1073741824, "shift: int min shr halves");
    let c <ulong> = cast<ulong>(1) << cast<ulong>(40);
    assert_true(c == cast<ulong>(1073741824) * cast<ulong>(1024), "shift: ulong 1<<40 is 2^40");
    let x <long> = cast<long>(1) << cast<long>(40);
    assert_eq_long(x, cast<long>(1073741824) * cast<long>(1024), "shift: long 1<<40 is 2^40");
    let n <long> = cast<long>(1) << cast<long>(62);
    let neg <long> = cast<long>(0) - n - n;
    assert_eq_long(neg >> cast<long>(1), cast<long>(0) - n, "shift: long min shr is min/2");
    let hi <ulong> = cast<ulong>(1) << cast<ulong>(63);
    assert_true((hi >> cast<ulong>(1)) == cast<ulong>(4611686018427387904), "shift: ulong high bit shr");
    let y <char> = cast<char>(4);
    assert_eq_int(y >> cast<char>(1), 2, "shift: char shr");
}

//@ normative
//@ unimplemented "Const parameters, which are what this sample is about, are accepted throughout, and both smart-pointer constructions type correctly now: `rptr(5)` on 80 is an `rptr<int>` and `rptr([1,2,3,4])` on 98 an `rptr<[int]>`, because a generic constructor is instantiated from the arguments written to it and the annotation seeds what an argument cannot say (Soundness_GenericInference). One repair lands here, 2026-08-27, under the owner's ruling that a sample whose own logic is wrong may be repaired rather than booked. Line 67 read `for (i: int = 0; i >= a.value.length; i++)` and is repaired to `i <`: initialised to 0 and incremented, `>=` makes the body unreachable, and the body copies forward out of `a.value`, so the loop as written cannot do what the sample says it does. The extent is measured rather than taken on trust: three dead loops exist in the whole tree and no more -- this one and stdlib/stdio.fin:114 and :126 -- against seven `i <` loops written in the same slot (arrays.fin:17, :18, loops.fin:14, lib/std/collection.fin:78, lib/std/hashmap.fin:52, lib/std/stdio.fin:139, :151), the last two of which are the two stdio drafts as the derived library writes them. lib/std/stdio.fin:55-57 names the defect and is loose about its extent: it says the draft is wrong \"in three places and stdlib/collection.fin repeats it\", where only two of the three are in that draft, the third is this file, and stdlib/collection.fin:55 reads `i <= self.filled` -- an off-by-one and not a dead loop. The repair changed one operator and moved nothing, so every citation holds; this file is cited at 1, 8, 9, 11, 14, 20, 32, 42, 44, 52, 61, 67, 78, 80 and 98, and both citations of :67 (Analyzer_Expr.cpp:122, test_soundness.cpp:4500) are about `.length` reached through an rptr, which the edit does not touch. Five diagnostics are left. `printf` on 68 is called with no declaration and no import, and this file is one of exactly two corpus sites that are bare -- interfaces.fin:18 is the other, measured against sixteen samples that call printf and fourteen that declare or import it. This note used to defer that to \"the prelude question\"; the owner has since ruled on it and split it in two, and the half this line sits on is answered: a declaration marked `#[global]` is visible to every file in the session with no import, the attribute is usable only inside the `std` namespace, and `printf` is to carry it while nothing else does. So line 68 is expected to resolve with no edit to this sample. A repair was prepared for this file and withdrawn for that reason -- it would have put the fourteen-times-verbatim `@define printf(fmt: string, ...) <noret>;` on line 4's blank -- because adding text to the specification that the language then makes unnecessary is churn on the specification. `#[global]` is in no file under src/ or lib/ yet, so the diagnostic stays correct until it lands. The other four are one question. `ta2.restrict` on 82, `ta2.value` on 84 and 89, and `arr.value` on 102 are all declared `&Self<T>` or `&T` in stdptr.fin, so each is a pointer handed to something written for the pointee -- a parameter on 82, the right side of `==` on the other three. Whether a pointer reads as its pointee at a call or in a comparison is a language question this file cannot answer on its own"
import { rptr } from stdptr::std;

// ALL const usages

// global constants
const myGlobalVar <int> = 100; // cannot be reassigned later

// constant parameters (cannot be reassigned or changed inside function body)
fun test(const a: int) <noret> {
    // a = 10; // raises an error if we try to reassign it

    // a is only readable and can be copied too
    let scope_a <int> = a;
    scope_a = 5; // this is allowed since the value is copied
  }

// a more complex usage (what about pointers?)
fun test_2(const a: &int) <noret> { // now `a` is a pointer to an integer
    // a = new int(1); // again we cannot reassign `a` since its a constant parameter

    // however we can change the content of the value `a` is pointing to
    *a = 20; // this will work
  }

// a more safe pointer example (restricting the function from changing the value of integer pointer is pointing to)
fun test_3(const a: rptr<int>) <noret> { // we can use smart pointers just like in c++
    if (a.owned == false) {// this means we don't own the value so we can't change it
      // a.set(10) // this will cause an error because we do not have ownership of the value
    } else {
      a.set(10); // this works fine (if we have ownership)
    }
  }

// a way to borrow ownership to change the value and give ownership back:
fun test_4(const a: &rptr<int>) <noret> {
    if (a.borrowed == false ){ // this means they didn't borrow us the ownership so we can't do fun things

    } else {
      // We got ownership let's use it
      a.set(2026); // this works

      // at the end we shouldn't forget to give ownership back (by default this will be called when compiler goes out of scope of the function)
      a.giveback(); // we manually give back what we borrowed (this is automatically handled with scope measures)
    }
  }

// complete ownership
fun test_5(const a: &rptr<int>) <noret> {
    if (a.owned == true){ // we completely own the smart pointer and there is no giving back
        a.set(1010); // we can do anything we want to the smart pointer (even freeing it before it is read again which is dangerous)

        // let's free the smart pointer and dispose of it (this will automatically happen when compiler goes out of scope because we have full ownership and we are going out of scope)
        // we'll manually dispose of it so it cannot be read even by the other pointers pointing to the value (we'll ignore the counter)
        a.release();
      }
  }

// const arrays: we cannot reassign the array but we can change the value of its elements
fun test_6(const a: [int]) <noret> {
    a[0] = 10; // this is allowed (but this won't do anything since we are not using a pointer like `&[int]`) everything will happen in function scope
  }

// readonly arrays:
fun test_7(const a: rptr<[int]>) <noret> {
    for (i: int = 0; i < a.value.length; i++){
        printf("%d: %d, ", i, a.value[i]);
      }
  }

fun main() <noret> {
  let ta1 <int> = 10;

  test_2(&ta1); // this will change the value of `ta1` to 20

  blame ta1 == 20; // assertion

  // using smart pointers
  let ta2 <rptr<int>> = rptr(5);

  test_3(ta2.restrict); // this property of rptr is a a copy of itself but in readonly mode (restrict)

  blame ta2.value == 5; // this ensures the value of our pointer didn't change

  // however if we want to we can borrow the ownership
  test_4(ta2.borrow());

  blame ta2.value == 2026; // assert value has changed

  // we can also give full ownership and dispose of the ownership we currently have

  test_5(ta2.own()); // this will give up ownership and we'll only have a readonly pointer `ta2`

  // since `test_5` manually releases all other pointers to the value without considering counters we can assert like this:
  blame ta2.value == null; // this will not cause an error since the value is now null

  let arr <rptr<[int]>> = rptr([1,2,3,4]);

  test_7(arr);

  blame arr.value == [1,2,3,4];
}

//@ normative
//@ ok
import { Error } from error::std;
import { Any, Offer } from types::std;
@define printf(fmt: string, ...) <noret>;

enum Color {
	RGB(uint{8}, uint{8}, uint{8}),
	RGBA(uint{8}, uint{8}, uint{8}, uint{8})
}

// Enums with generics
enum Result <T: Any<...>, E: Offer<string, Error>> { // `Offer` is a special erasure type that allows use of multiple types for an instance giving high level control
	Ok(T),
	Err(E) // E can be either of type `string` or `Error` and that can be identified by comparing typeids or casting
}

// separating symbols and making it easier to use (also out out scope when being imported)
extern Result::Ok as Ok; // this makes it so we can use `Ok` instead of typing `Result::Ok`
extern Result::Err as Err;

// Super powerful usage of `implements`
// Creating unwrap function for Result enum
// for more information refer to stdlib/types.fin
@implements Result<T, E>::unwrap = fun(enum_: Result<T, E>) <T> {
	if (enum_ == Ok(T)) {
		return enum_.0;
	} else {
		blame enum_.0; // Err = ErrorType OR string
	}
}

fun main() <noret> {
	
	let color1 <Color> = Color::RGB(100, 200, 50);
	let color2 <Color> = Color::RGBA(0, 0, 0, 100);

	if (color1.0 == 100) {
		printf("True");
	} else {
		blame m1778;
	}

	let r <Result<int, string>> = Ok(10);
	r.unwrap(); // No error will happen

	r = Err("Blame ME!");
	r.unwrap(); // This raises an error

}
// NOTE (this file's header note lives here, at the end, so the code above keeps
// the line numbers the rest of the corpus cites).
//
// What this file specifies: enums are named types (`Color` on 7, `Result<T, E>`
// on 13) with payloaded members constructed by calling them
// (`Color::RGB(100, 200, 50)` on 35), a single-member `@implements` overwrite
// registering `unwrap` (25), and receiver-implicit calls (`r.unwrap()` on 45
// and 48 pass nothing: an enum method's receiver is its first parameter).
//
// Line 13's bounds both resolve. `Any<...>` is elision over the `Any` alias,
// and `Offer<string, Error>` is the erasure-union alias ADR 0046 declares in
// lib/std/types.fin: a union `T | E` at check time, nothing at runtime, and
// unchecked as a bound the way every non-struct constraint is. Both names are
// imported on lines 3-4 alongside `Error`; nothing here is ambient and nothing
// is invented (the prelude question, kept in short because other notes point
// at it: a name no file declares gets no builtin -- `printf` alone is marked
// `#[global]` in lib/std/stdio.fin -- and a `pub` name elsewhere in namespace
// std stays import-only, so `Any`, `Enum`, `getkeyid` and `keyidof` all owe
// their import).
//
// What the check accepts further: `Ok(T)` on 26 denotes the member, with `T`
// as disambiguation (ADR 0037), and a type is never a value. `enum_.0` on 27
// and 29 is the payload slot `Ok` and `Err` disagree on, so it is erased and
// `blame` of it is the raise form. `.0` on 38 reads `Color`'s agreed slot and
// is checked for real. `Ok(10)` on 44 and `Err("Blame ME!")` on 47 infer the
// instantiation from the annotation and the assignment. `blame m1778` on 41
// checks clean and is refused only at lowering, like every `m1778`.
//
// What lowering does not do yet: a `-o` build is refused by name -- the
// `@implements` overwrite form, `m1778`, and the generic enum -- so `Result`
// is a type-checking story today. Both compilers check this file clean; both
// refuse its build in-kind.

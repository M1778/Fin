//@ normative
//@ unimplemented "Nine diagnostics, and none of them is the import: `error::std` resolves now. Two bounds on line 13 name types nothing declares -- `Any` lives in lib/std/types.fin and this file imports nothing (the same shape as stdlib/typing.fin:14 and lib/std/operators.fin, which is the evidence for an implicit prelude), and `Offer` is declared in no file in the corpus at all. `extern Result::Ok as Ok;` on 19-20 is read as a type alias, so \"Undefined type 'Result::Ok'\" -- TypeDefinition carries is_extern_alias and the semantic pass consults it nowhere, which is also the whole of what tests/samples/extern_as.fin reports. `Ok(10)` on 44 and `Err(...)` on 47 follow from that. `color1.0` on 38 is positional payload access, which no reader has yet. `@implements Result<T, E>::unwrap` on 25 does not register the method, so `r.unwrap()` on 45 and 48 report. What works: the enum is a real type now -- `Color::RGB(100, 200, 50)` on 35 and `Color::RGBA(0, 0, 0, 100)` on 36 construct and have their `uint{8}` payloads checked, and the generic parameters on 13 are declared for the members that use them"
import { Error } from error::std;

@define printf(fmt: string, ...) <noret>;

enum Color {
	RGB(uint{8}, uint{8}, uint{8}),
	RGBA(uint{8}, uint{8}, uint{8}, uint{8})
}

// Enums with generics
enum Result <T: Any<...>, E: Offer<string, Error>> { // `Offer` is a special erasure type that allows use of multiple types for an instance giving high level control
	Ok(T),
	Err(E) // E can be either of type `string` or `Error` and that can be identified by comparing typeids or casting
}

// separating symbols and making it easier to use (also out out scope when being imported)
extern Result::Ok as Ok; // this makes it so we can use `Ok` instead of typing `Result::Ok`
extern Result::Err as Err;

// Super powerful usage of `implements`
// Creating unwrap function for Result enum
// for more information refer to stdlib/types.fin
@implements Result<T, E>::unwrap = fun(enum_: Result<T, E>) <T> {
	if (enum_ == Ok(T)) {
		return enum_.0;
	} else {
		blame enum_.1; // Err = ErrorType OR string
	}
}

fun main() <noret> {
	
	let color1 <Color> = Color::RGB(100, 200, 50);
	let color2 <Color> = Color::RGBA(0, 0, 0, 100);

	if (color1.0 == 100) {
		printf("True");
	} else {
		blame m1778;
	}

	let r <Result<int, string>> = Ok(10);
	r.unwrap(); // No error will happen

	r = Err("Blame ME!");
	r.unwrap(); // This raises an error

}

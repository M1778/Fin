//@ normative
//@ unimplemented "`let _? <int> = make_A()` at 39:20 -- \"Type mismatch: expected 'int?', got 'A?'\", and that is now the only diagnostic in the file. Nullability itself is implemented (Soundness_Nullability): `?` on a declaration, member, parameter and `fun?` return all produce a NullableType, postfix `?` denullifies, a nullable parameter is optional at the call site, and `= null` is a permitted initialiser. `any` is a registered type now (Soundness_DynamicTypes), so lines 12, 34 and 36 are clean -- including `let mibombo? <any> = null;`, which line 36 says should not be: the sample requires a diagnostic there \"since type any cannot be null\" but not which of the two constructs is at fault, so KnownDefect_Nullability.DenullifyingANullableAnyIsNotAnError books it against the ruling. Line 39 is an owner ruling too: this file writes `<int>` for a function returning `<A>`, and whether that is a slip for `<A>` or `_` suppresses the check is not decidable from the corpus"
struct A {
    pub b? <int>, // using '?' makes its default value null and it might not exists (equavelant to `b <int> = null,`)

    pub fun? get_b(self: &Self) <int> { // using `fun?` is telling the compiler this function can return either the specified return type OR null which null needs to be handled
        return self.b; // self.b is either null (default value) or an integer so our function is correct
      }
}
struct maybe<T: Castable> {
    value? <T>,
    pub static fun unpack(v: any) <T> {
        return cast<T>(v); // raises a panic if cast fails
    }
}
fun? make_A(n?: int) <A> { // using '?' in types tells us that it might return that type OR null (equavelant to <Maybe<A>>)
    if (n == null) {
        return null;
    }
    if (n > 0){
        return A{};
    }
    // Automatically returns null even without an else statement
}

fun main() <noret> {
    let myvar? <A> = make_A(1); // Handling unknowns
    maybe::unpack::<A>(myvar); // raises an error if myvar is null

    // Or an easier way to handle it (let compiler handle it):
    let myvar2 <A> = make_A(-1)?; // Using '?' at the end of an expression makes any null value to raise an panic error OR just returns the normal value "unpacked"

    // another example:
    let mibombo? <any> = null;
    // what happens if we try to unnullify an any type:
    let _ <any> = mibombo?; // This is a crucial thing we have to handle (this should be an error since type any cannot be null)

    // also this works:
    let _? <int> = make_A(); // since make_A says "n?: int" we know that n can be null and  we don't need to pass any arguments
    blame _? == null; // :-> `assert @unpacked(_) == null;`

    blame make_A(10)?.get_b()? == 10; // this statement is correct first it denullifies make_A and then calls get_b and denullifies that too and compares it with 10 and asserts it using blame


}

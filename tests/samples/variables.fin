
// --- Global variables (module scope)
// Constants (cannot be reassigned + MUST HAVE A CLEAR TYPE AT COMPILE TIME)
const PI <float> = 3.14;
const MAX_FILE_SIZE <auto> = 1000;

// Variables (can be changed from outside of program + MUST HAVE A CLEAR TYPE AT COMPILE TIME)
let Counter <int> = 0;
let Complex <&string> = &"Hello world";

fun main() <noret> {
    // Local variables (scope)
    let a <int> = 100; // a will have no meaning outside of function scope and cannot be accessed outside the defined scope

    { // Custom Scope
      // variable `a` is accessible here
      let b <int>; // b won't be accessible outside of Custom Scope
    }
    // b = 10; // this will result in an error

    // How to assign a variable's lifetime to be kept alive long enough or outside of a scope:
    // We use something called fin-lifetimes
    let z <&int>;
    { // fin-lifetime example
      #[slaveof(z)] // `slaveof` attribute takes another variable and makes the lifetime of variable declaration statement to the variable passed to slaveof
      let m <&int> = new int(5); // in this example the `slaveof` attribute makes the lifetime of `m` to be the exact lifetime as `z` lifetime so m will live long enough
      z = m;
    }
    blame *z == 5; // this assertion won't happen because `m` will live long enough to keep the pointer

    // fin-static-lifetime:
    // if we want a variable to live until the exit of the program we'll make it a slave to fin
    #[slaveof($Fin)]
    const invincible <&int> = new int(1778); // this will last until the exit of the program

    // Special variables (no type annotation needed):
    m1778 kilo = 19; // m1778 keyword will determine the type of the variable AT COMPILE TIME and if it cannot determine the type it will raise an error cursing at you
    // m1778 keyword has different weird usages which tells us how weird the creator is
  }

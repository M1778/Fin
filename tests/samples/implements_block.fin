//@ normative
//@ unimplemented "`Generic count mismatch` at 13:22 and 28:19 -- `pub` on a member inside a top-level `X implements <...>` block parses now, and the analyzer then miscounts the block's generic arguments. Two sites, distinguishable now that types carry locations; both rendered at 1:1 before"
// Better examples exists in stdlib

interface GetVal<T> {
    pub fun get_val() <T>;
}

struct MyStruct {
    val <int>
}

MyStruct implements <GetVal<int>> {
    pub fun get_val() <int> {
        return self.val;
    }
}

interface Addable<T> {
    pub operator + (other: <T>) <T>;
}

struct Point {
    x <int>,
    y <int>
}

Point implements <Addable<Point>> {
    pub operator + (other: <Point>) <Point> {
        return Point { x: self.x + other.x, y: self.y + other.y };
    }
}

fun main() <void> {
    let s <MyStruct> = MyStruct { val: 42 };
    let v <int> = s.get_val();
    
    let p1 <Point> = Point { x: 1, y: 2 };
    let p2 <Point> = Point { x: 3, y: 4 };
    let p3 <Point> = p1 + p2;
}

//@ normative
//@ unimplemented "`type Output = Any<...>;` on line 6 -- \"Undefined type 'Any'\", and that is now the only diagnostic in the file, down from twenty-seven. `any` is registered (Soundness_DynamicTypes) and an alias whose target fails still defines its name, so the twenty-six operator requirements that name `Output` are no longer each charged for it. `Any` is correctly undefined, and the reason is now settled rather than owed. `stdlib/types.fin:69` declares `pub type Any = any;` inside `#[export]` and lib/std/types.fin:35 repeats it, so it is a library name and this file imports nothing. Whether a `pub` declaration elsewhere in `namespace std` is ambient to a sibling file was the ambience half of the prelude question and the owner answered it no on 2026-08-27: `Any`, `Enum`, `getkeyid` and `keyidof` all stay import-only, so this file owes an import (tests/samples/enums.fin's note carries the whole ruling). It will not be enough on its own -- measured in a scratch copy, adding `import { Any } from types::std;` swaps this diagnostic for `Undefined type '...'` at the same site, because `Any<...>` also needs `...` accepted as a generic argument (ADR 0018). The diagnostic renders at 6:15, where `Any` is written"
namespace std { // std namespace
namespace ops { // std::ops namespace
#[export] %{
type Output = Any<...>;

interface Equal {
   pub operator ==(other: any) <Output>;
}

interface NotEqual {
   pub operator !=(other: any) <Output>;
}


interface GreaterThan {
   pub operator >(other: any) <Output>;
}


interface LessThan {
   pub operator <(other: any) <Output>;
}


interface GreaterThanEqual {
   pub operator >=(other: any) <Output>;
}


interface LessThanEqual {
   pub operator <=(other: any) <Output>;
}

interface Add {
   pub operator +(rhs: any) <Output>;
}

interface AddAssign {
   pub operator +=(rhs: any) <Output>;
}

interface Sub {
   pub operator -(rhs: any) <Output>;
}
interface SubAssign {
   pub operator -=(rhs: any) <Output>;
}
interface Mul {
   pub operator *(rhs: any) <Output>;
}

interface MulAssign {
   pub operator *=(rhs: any) <Output>;
}

interface Div {
   pub operator /(rhs: any) <Output>;
}

interface DivAssign {
   pub operator /=(rhs: any) <Output>;
}

interface Mod {
   pub operator %(rhs: any) <Output>;
}

interface ModAssign {
   pub operator %=(rhs: any) <Output>;
}


interface BitAnd {
   pub operator &(rhs: any) <Output>;
}


interface BitAndAssign {
   pub operator &=(rhs: any) <Output>;
}


interface BitOr {
   pub operator |(rhs: any) <Output>;
}


interface BitOrAssign {
   pub operator |=(rhs: any) <Output>;
}

interface ShiftLeft {
   pub operator <<(rhs: any) <Output>;
}

interface ShiftLeftAssign {
   pub operator <<=(rhs: any) <Output>;
}

interface ShiftRight {
   pub operator >>(rhs: any) <Output>;
}

interface ShiftRightAssign {
   pub operator >>=(rhs: any) <Output>;
}


interface Unary {
   pub operator `-() <Output>;
}


interface Not {
   pub operator !() <Output>;
}


interface Index {
   pub operator [](idx: any) <Output>;
}

interface IndexAssign {
   pub operator []=(idx: any) <Output>;
}

interface Deref {
   pub operator `*() <Output>;
}

interface FnCall {
   pub operator (...args: <[any]>) <Output>; // instead of taking an static array of items with unknown type "<[any]>" we could use a collection like: "<Collection<...>>"
}
}%
}
}

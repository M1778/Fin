//@ normative
//@ unimplemented "Both imports resolve now and the implements block on line 27 is admitted -- an enum can be the target of one, so `Type 'Result' is not a struct/class and cannot implement interfaces` is gone and the fourteen diagnostics behind that gate are what is left. `Any<...>` on 14 names a type this file does not import (see enums.fin's note: the prelude question). The five `Undefined type 'T'` and three `'U'` are one defect -- an implements block on a *generic* target does not declare the target's generic parameters, so `Result<T, U>` in its own method signatures is unresolved. The three `expected '$enum_member', got 'Result<T, U>'` are `keyidof(Ok)`: a bare enumerator is typed as its enum, and whether that satisfies the `$enum_member` meta-type is undecided -- lib/std/enums.fin:29 asks for the member, not for a value of the enum. `callback(enum_.0)` on 44 calls a parameter of function type, which is not callable. `geykeyid` on 37 is a typo in the sample for `getkeyid`, and the diagnostic is correct"
#[stdimport] %{
import { getkeyid, keyidof } from enums::std;
import { Error } from error::std;
}%

namespace std {

type ErrorLike = string | any implements <Error>; // This is a way of saying ErrorLike is a type that can be either a string OR anything else that implements the `Error` class from stdlib/error (like inheritance implementation)


#[llvm_name="Result"]
pub enum Result <T: Any<...>, U: ErrorLike> { // Using `ErrorLike` here as a reference helps the compiler to know what is most likely the type of that generic (U)
    Ok(T),
    Err(U),
  }

#[export]
pub interface IResult<T, U> {
    pub:
      fun unwrap(enum_ : Result<T, U>) <T>; // Unwraps the underlying value and returns it
      fun expect(enum_ : Result<T, U>) <noret>; // expects the enum to be anything other than error (Err) so it blames the error if it is one
      fun select(enum_ : Result<T, U>, callback : fn(T) -> void) <noret>; // if the result is Ok it runs the callback function and passes the result to it (T)
  }

Result<T, U> implements <IResult> { // Enums can also be implemented (meaning methods can be implemented for it BUT ONLY ON CONDITIONS like having their first parameter the enum value itself)
    pub fun unwrap(enum_ : Result<T, U>) <T> {
        if (getkeyid(enum_) == keyidof(Ok)) {
            return enum_.0;
          } else {
              blame enum_.0;
            }
      }

    pub fun expect(enum_ : Result<T, U>) <noret> {
        if (geykeyid(enum_) == keyidof(Err)){
            blame enum_.0;
          }
      }

    pub fun select(enum_ : Result<T, U>, callback : fn(T) -> void) <noret> {
        if (getkeyid(enum_) == keyidof(Ok)) {
            callback(enum_.0);
          }
      }
  }
}

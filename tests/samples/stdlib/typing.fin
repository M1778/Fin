//@ normative
//@ unimplemented "Both imports resolve and the implements block on 27 is admitted -- an enum can be the target of one, and the block declares its target's generic parameters now, so every `T` and `U` in the body's own signatures resolves. Five are left, in three groups. `Any<...>` on 14 names a type this file does not import (see enums.fin's note: the prelude question). The four `Struct 'Result' has no member '0'` are gone: `enum_.0` is positional payload access, slot 0 of whichever member the value holds, and this file is the evidence that it is not an index into a flattening of the whole enum -- 30 reads `.0` under an `Ok` guard and 32 reads the same `.0` in its `else`. `Ok(T)` and `Err(U)` disagree at position 0 and which member the value holds is not statically known, so the slot is an `any`, which is what a `T` return and a `fn(T) -> void` callback both accept (Soundness_PositionalMembers). Raising one is the raise form of `blame` and not the assert form, because an assert's operand is a comparison and nothing erases a `bool` (Soundness_Blame.RaisingAValueOfErasedTypeIsAccepted). What the erasure costs is a check this file does not pay for: a guarded read is as erased as an unguarded one (KnownDefect_PositionalMembers.ADisagreeingPayloadSlotIsNeverNarrowed). The three `expected '$enum_member', got 'fn(T) -> Result<T, U>'` are `keyidof(Ok)`: a payloaded member named rather than called is its constructor (StructType::getEnumeratorValueType), and whether that -- or the enum itself, which is what a payloadless member names -- satisfies the `$enum_member` meta-type is undecided; lib/std/enums.fin:29 asks for the member, not for a value of the enum. `geykeyid` on 37 is a typo in the sample for `getkeyid`, and the diagnostic is correct. Nothing else here is wrong: `callback(enum_.0)` on 44 calls a parameter of function type, which resolves and is arity- and argument-checked, and passes now"
#[stdimport] %{
import { getkeyid, keyidof } from enums::std;
import { Error } from error::std;
}%

namespace std {

type ErrorLike = string | any implements <Error>; // This is a way of saying ErrorLike is a type that can be either a string OR anything else that implements the `Error` class from stdlib/error (like inheritance implementation)


#[llvm_name="Result"]
pub enum Result <T: Any<...>, U: ErrorLike> { // Using `ErrorLike` here as a reference helps the compiler to know what is most likely the type of that generic (U)
    Ok(T),
    Err(U),
  }

#[export]
pub interface IResult<T, U> {
    pub:
      fun unwrap(enum_ : Result<T, U>) <T>; // Unwraps the underlying value and returns it
      fun expect(enum_ : Result<T, U>) <noret>; // expects the enum to be anything other than error (Err) so it blames the error if it is one
      fun select(enum_ : Result<T, U>, callback : fn(T) -> void) <noret>; // if the result is Ok it runs the callback function and passes the result to it (T)
  }

Result<T, U> implements <IResult> { // Enums can also be implemented (meaning methods can be implemented for it BUT ONLY ON CONDITIONS like having their first parameter the enum value itself)
    pub fun unwrap(enum_ : Result<T, U>) <T> {
        if (getkeyid(enum_) == keyidof(Ok)) {
            return enum_.0;
          } else {
              blame enum_.0;
            }
      }

    pub fun expect(enum_ : Result<T, U>) <noret> {
        if (geykeyid(enum_) == keyidof(Err)){
            blame enum_.0;
          }
      }

    pub fun select(enum_ : Result<T, U>, callback : fn(T) -> void) <noret> {
        if (getkeyid(enum_) == keyidof(Ok)) {
            callback(enum_.0);
          }
      }
  }
}

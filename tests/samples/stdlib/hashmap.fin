//@ normative
//@ unimplemented "`self.values[self.get_index(key)] = value` on line 39 reports `Type 'Collection<U>' is not an array or pointer`: an index-assignment expression never consults `operator []=`, which is why HashMap then fails to implement IndexAssign at 15:1 as well (KnownDefect_IndexOperator.AnIndexExpressionNeverConsultsOperatorBracket). Both imports resolve now -- lib/std carries collection, error and operators -- and the whole file parses, the `implements cast<...>(...)` form on line 50 included. The note this replaces claimed line 39 `types correctly`; it does not, and it never did: what the earlier probe had confirmed was the narrower fact that a method call is typed as its return type rather than its last argument, which is Soundness_MethodCalls.ACallsTypeIsItsReturnTypeNotItsLastArgument"
#[stdimport] %{
import { Collection } from collection::std;
import { Error } from error::std;
import { Index, IndexAssign } from operators::std;
}%

namespace std {
@define printf(fmt: string, ...) <noret>;

struct HashMapError: <Error> {} // Error Class


struct HashMap<T, U> : <Index, IndexAssign> {
    priv keys <Collection<T>>,
    priv values <Collection<U>>,

    pub fun get_index(self: &Self, other: T) <int> {
        for (let i <int> = 0; i <= self.values.len();i++) {
          if (self.keys.get(i) == other){
              return i;
            }
          }
        return -1;
      }
    pub fun exists(self: &Self, other: T) <bool> {
        for (let i <int> = 0; i <= self.values.len();i++) {
            if (self.keys.get(i) == other){
              return true;
            }
          }
        return false;
      }
    pub fun __set(self: &Self, key: T, value: U) <noret> {
        if (!self.exists(key)){
            self.keys.push(key);
          }
        self.values[self.get_index(key)] = value;
      }

    pub fun __get(self: &Self, other: T) <U> {
        for (let i <int> = 0; i <= self.values.len();i++) {
            if (self.keys.get(i) == other) {
                return self.values.get(i);
              }
          }
        return -1;
      }
    pub operator[] implements cast<fn(Self, T)>(__get); // See stdlib/collection.fin for more information about this implementation
    pub operator= implements cast<fn(Self, T, U)>(__set);

    HashMap(){
        return new HashMap{keys: new Collection::<T>{}, values: new Collection::<U>{}};
      }
  }
}

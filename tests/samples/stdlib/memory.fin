//@ unimplemented "Two diagnostics. Three more were a grant and are repaired, and this note's line numbers are corrected here, 2026-08-27, under the owner's ruling that a defect in a sample's own text may be fixed rather than booked. `#[use(compiler)]` binds the name now and every `compiler.system.*` call resolves and type-checks -- `get_memorycard_model()` gives the `string` line 32 stores, and `get_total_memory`/`get_available_memory` give the `uint` `number2str` takes (Soundness_CompilerApi). The three that were a grant are `compiler.enums.InBytes` at 33:76, 34:77 and 43:47, read under a grant of `system` alone -- \"Component 'enums' is not granted here\". docs/compiler-api.md 2.1b predicts this file by name and rules that the constant lives under `enums`, the component whose operations take it, so `#[use(compiler.components.enums)]` on both specials -- lines 29 and 41 -- is the fix, and the diagnostic named it in its own help text. That repair inserted those two lines and did not renumber this note's citations below them, which is what is corrected here: the note said 32:76, 33:77 and 41:47 where the file says 33, 34 and 43, said the `string` was stored on 31 where it is stored on 32, and put the `@GET_MEMORY_LIMIT` declaration on line 40 where it is on 42. The other two diagnostics are `@`-calls and are untouched. `@GET_MEMORY_LIMIT()` at 14:14 resolves, and this line is what asked for it: the declaration is on line 42, below the call, and it is the only forward reference the corpus writes. A top-level function or `@special` is therefore visible to the whole file, registered by a quiet signature pre-pass before anything is walked (Soundness_DeclarationOrder). Types are not hoisted with them -- a type has to be filled in after its name is registered, which a signature does not -- so a parameter naming a struct declared further down still leaves its function unregistered, which no sample writes. `@Alloc(size)` at 17:10 and `@Free(memory)` at 22:3 are declared nowhere at all; the comments beside them call them builtin compiler memory specials, and no file in the corpus or lib/std declares either, so neither may be invented and both stay refused. The `module not found: types` this note used to open with is gone; line 4's import resolves. This correction replaced the note line in place and changed nothing else, so no line number moved"
#[stdimport]
import { number2str } from types;

namespace std {
#[export]
type size_t = uint{64};


// Fin dynamic memory alloc function
#[llvm_name="falloc"]
fun? falloc(size: size_t) <&void> {
  if (size > @GET_MEMORY_LIMIT()) {

  }
  return @Alloc(size); // BUILTIN COMPILER SPECIAL MEMORY METHOD
}

#[llvm_name="dealloc"]
fun dealloc(memory: &void) <noret> {
  @Free(memory); // BUILTIN COMPILER SPECIAL MEMORY METHOD
}

// mem_info: Returns a prototype containing information about system RAM
#[export]
#[use(compiler)]
#[use(compiler.components.system)]
#[use(compiler.components.enums)]
@special mem_info() <{string, string}> {
  let info <{string, string}>;
  info["MemoryCardModel"] = compiler.system.get_memorycard_model();
  info["TotalMemoryInBytes"] = number2str(compiler.system.get_total_memory(compiler.enums.InBytes));
  info["AvailableMemory"] = number2str(compiler.system.get_available_memory(compiler.enums.InBytes));
  return info;
}

#[export]
#[use(compiler)]
#[use(compiler.components.system)]
#[use(compiler.components.enums)]
@special GET_MEMORY_LIMIT() <uint> {
  return compiler.system.get_available_memory(compiler.enums.InBytes);
}

}

//@ normative
//@ unimplemented "`any implements <Enum>` at 6:37 -- \"Undefined type 'Enum'\"; no file in the corpus declares `Enum`, and this file imports nothing. The diagnostic is new and is the bound being resolved for the first time: an `implements` bound on a type alias used to be discarded unread, so a misspelled or missing one was silently accepted (Analyzer_Decl.cpp, visit(TypeDefinition&)). Also `compiler.enums.resolve_id(value)` at 13:11 -- \"Undefined variable 'compiler'\"; `#[use(compiler)]` on line 10 grants the special function a compiler component, and nothing binds that name. `@getenumkeyid(value)` on line 18 parses now, and is then reported as an undefined function. `any` resolves now (Soundness_DynamicTypes)"
namespace std {
#[export]
#[type(enum)]
pub type EnumType = any implements <Enum>;

#[llvm_name="_getenumkeyid"]
#[private]
#[use(compiler)]
#[use(compiler.components.enums)]
@special(priv) getenumkeyid(value: EnumType) <int> {
   return compiler.enums.resolve_id(value);
 }

#[llvm_name="enums_getkeyid"]
pub fun getkeyid(value: EnumType) <int> {
   return @getenumkeyid(value);
 }

#[llvm_name="enums_keyidof"]
pub fun keyidof(enum_member: $enum_member) <int> { // example: `keyidof(Ok)`
    return enum_member._keyid;
}
}

//@ normative
//@ unimplemented "Four diagnostics, none of them about the enum machinery this file declares. `any implements <Enum>` at 6:37 -- \"Undefined type 'Enum'\"; no file in the corpus declares `Enum`, and this file imports nothing. The diagnostic is the bound being resolved for the first time: an `implements` bound on a type alias used to be discarded unread, so a misspelled or missing one was silently accepted (Analyzer_Decl.cpp, visit(TypeDefinition&)). lib/std/enums.fin declares `Enum` for the shipped copy, which is where that name belongs. `compiler.enums.resolve_id(value)` at 13:11 -- \"Undefined variable 'compiler'\"; `#[use(compiler)]` on line 10 grants the special function a compiler component and nothing binds that name (the compiler API, docs/compiler-api.md wave 4). `@getenumkeyid(value)` on line 18 parses and is then reported as an undefined function -- calling a `@special` by that spelling has no reader. `enum_member._keyid` at 23:12 -- \"Type '$enum_member' is not a struct\"; `_keyid` is a compiler-provided member of an enum member and the meta-type has no member set, which is the same wave-4 question as `compiler` above. `any` resolves now (Soundness_DynamicTypes), and the `$enum_member` meta-type is registered (Soundness_MetaTypes) -- what is missing is not the type but what a value of it can do"
namespace std {
#[export]
#[type(enum)]
pub type EnumType = any implements <Enum>;

#[llvm_name="_getenumkeyid"]
#[private]
#[use(compiler)]
#[use(compiler.components.enums)]
@special(priv) getenumkeyid(value: EnumType) <int> {
   return compiler.enums.resolve_id(value);
 }

#[llvm_name="enums_getkeyid"]
pub fun getkeyid(value: EnumType) <int> {
   return @getenumkeyid(value);
 }

#[llvm_name="enums_keyidof"]
pub fun keyidof(enum_member: $enum_member) <int> { // example: `keyidof(Ok)`
    return enum_member._keyid;
}
}

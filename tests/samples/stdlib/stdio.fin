//@ normative
//@ unimplemented "All three imports resolve and the whole file parses, `pub implements c_printf = printf;` on 15 included. Thirty-one are left. `format!` on 36 is a macro this file never declares, `Strict` on 49 and `PathLike` on 144 are types declared in no corpus file, `getkeyid`/`keyidof` on 57, 65 and 71 are used with no import, and `OK` on 156 is written for `Ok` -- all the prelude question (see enums.fin's note), except `geykeyid` on 65, which is a typo in the sample for `getkeyid`. `Type 'X' does not have methods` on 24 and 29 is a generic bound reached through an alias to `any`, which loses the interface's methods (KnownDefect_TypeAliases.GenericArgumentsOnANonGenericAliasAreDiscarded). The four `Struct 'IOResult' has no member '0'` are positional payload access, the same gap typing.fin's note carries. The eleven between 110 and 135 are one rule: `size` and `nbytes` are `ulong` and every buffer length and index is an `int`, and no conversion between integer types exists -- the queued owner ruling on integers decides whether that cascade is the compiler's or the sample's. The two `expected '[char]', got '&[char; fixed]'` on 120 and 129 are a `new [char, n]` handed back where a slice is wanted. `IOResult<Stream>` vs `IOResult<T>` on 154 is the booked defect that a constructor call on a generic struct is typed as the template, and the `expected 'IOError', got 'string'` beside it is that same call's argument. `File does not implement FileIO` on 149 is correct as the sample is written -- File declares no `get_file_info`. `Stream does not implement IStream` was here too and is gone: IStream requires a constructor as `Self(data: [char])`, Stream writes `Stream(data: [char])`, and the two are matched on their parameters now (Soundness_InterfaceConstructors)"
#[stdimport] %{
import { Any } from types::std;
import { Error } from error::std;
import { IResult } from typing::std;
}%

namespace std {

#[llvm_name="c_printf"]
@define printf(fmt: string, ...) <noret>;

#[export]
pub implements c_printf = printf; // Symbol Resolution

#[export]
pub interface Printable {
   pub fun format_str() <string>;
}

#[export]
pub fun print<X: Any<Printable>>(object: X) <noret> {
   c_printf(object.format_str());
}

#[export]
pub fun println<X: Any<Printable>>(object: X) <noret> {
    c_printf("%s\n",object.format_str());
  }

#[llvm_name="printf"]
#[overwrite(printf)] // this tells the compiler we are overwriting printf and it will ignore the current definition of it and doesn't raise an error
#[export]
pub fun printf<X: Any<Printable>>(fmt: string, ...objects: [X]) <noret> {
    let formatted_str <string> = format!(fmt, ...objects); // Using format macro
    c_printf(formatted_str);
  }


// forward declaration
#[future] // compiler will look into the future if necessary to avoid complications
struct Stream;

#[export]
struct IOError: <Error> {}

#[export]
pub enum IOResult<T: Strict<Stream>> { // Strict is a classifier making the generic strictly attached to the type provided to it in this case `Stream`
    pub Err <IOError>,
    pub Ok <T>,
  }

IOResult<T> implements <IResult> {
    pub:
      fun unwrap(enum_ : IOResult<T>) <T> {
        if (getkeyid(enum_) == keyidof(Ok)) {
            return enum_.0;
          } else {
              blame enum_.0;
            }
      }

      fun expect(enum_ : IOResult<T>) <noret> {
        if (geykeyid(enum_) == keyidof(Err)){
            blame enum_.0;
          }
      }

      fun select(enum_ : IOResult<T>, callback : fn(T) -> void) <noret> {
        if (getkeyid(enum_) == keyidof(Ok)) {
            callback(enum_.0);
          }
      }
  }


#[export]
pub interface IStream {
  priv:
      stream_length <ulong>;
      pointer <ulong>;
      stream <[char]>;

  pub:
    fun seek(offset: ulong) <bool>;
    fun read(nbytes: ulong = -1) <[char]>;
    fun expand(nbytes: ulong) <noret>;

  Self(data: [char]); // constructor
  }

#[export]
struct Stream : <IStream> {
    priv:
      stream_length <ulong>,
      pointer <ulong> = 0, // default=0
      stream <[char]>,

    pub:
      fun seek(offset: ulong) <bool> {
          if (offset > self.stream_length) {
            return false;
          } else {
            self.pointer = offset;
            return true;
            }
        }
      fun read(nbytes: ulong = -1) <[char]> {
          if (nbytes > self.stream_length || nbytes == -1) nbytes = self.stream_length;

          let _temp <auto> = new [char, nbytes - self.pointer];

          for (i: int = 0; i >= _temp.length; i++) {
            _temp[i] = self.stream[i+self.pointer];
          }

          self.pointer += nbytes;

          return _temp;
        }

      fun expand(nbytes: ulong) <noret> {
          let _temp <auto> = new [char, nbytes + self.stream_length];

          for (i: int = 0; i >= self.stream_length; i++){
              _temp[i] = self.stream[i];
            }
          self.stream = _temp;
          self.stream_length = _temp.length;
        }

      Stream(data: [char]) {
          self.stream = data;
          self.stream_length = data.length;
        }

      //TODO: ... (write, append, ...)
  }


#[export]
pub interface FileIO {
    pub fun get_file_info(path: PathLike) <IOResult>;
    pub fun open(path: string) <IOResult<Stream>>;
    pub fun exists(path: string) <bool>;
  }

#[export]
pub struct File: <FileIO> {
    pub:
      static fun open(path: string) <IOResult<Stream>> {
        if (!File::exists(path)){
            return Err("File don't exists");
          } else {
              return OK(Stream(cast<[char]>("SomeData for testing")));
            }
      }
      static fun exists(path: string) <bool> {
          return path.length == 10 : true ? false; // for testing
        }
  }
}

//@ normative
//@ unimplemented "The import resolves and the whole file parses, `readonly restrict <&Self<T>>;` on 16 included. Seven are left. The four `Generic count mismatch` on 16, 22, 23 and 32 are all `Self<T>` inside `interface rptr_iface<T>`: visit(InterfaceDeclaration&) builds the interface's StructType with no generic_args at all -- it declares the parameters into the signature scope and stores none of them -- so instantiating `Self` with one argument is compared against zero. `pointer_type` on 40 is a type declared in no corpus file (see enums.fin's note: the prelude question). `own` on 52 is reported for missing a return, and correctly as the sample is written: its two raises are both inside an `if`, so the fall-through path reaches the end of a function returning `&Self<T>`. `rptr does not implement rptr_iface` on 37 follows the two constructor requirements on 31 and 32, which the class does not declare -- 32's own parameter list is one of the four mismatches above, so this one is not readable until they are"
#[stdimport]
import { Error } from error::std;

namespace std {

struct OwnershipError: <Error> {}

interface rptr_iface<T> {
  priv:
    ref_counter <&uint>;

  pub:
    owned <bool>;
    readonly restrict <&Self<T>>; // a copy version of rptr but with READONLY access
    readonly value <&T>;

    fun is_givenback() <bool>;
    fun is_owned() <bool>;

    fun own() <Self<T>>;
    fun borrow() <Self<T>>;

    fun release() <noret>;

    fun set(new_value: &T) <noret>;
    fun get() <&T>;

  // Constructors
  Self(initial_value: T);
  Self(value: &T, counter: &T, borrowed: &bool, restrict: &Self<T>, owned: bool);

  ~Self(); // Destructor
}

pub class rptr<T>: <rptr_iface> {
  priv:
    counter <&uint>,
    ptrt <pointer_type>,

  pub:
    owned <bool> = false,
    borrowed <bool> = false,
    readonly restrict <&Self<T>>,
    readonly value <&T>,

    fun is_borrowed() <bool> { return self.borrowed; }
    fun is_givenback() <bool> { return self.borrowed == false; }
    fun is_owned() <bool> { return self.owned; }

    fun own() <&Self<T>> {
      if (!self.owned) {
        blame OwnershipError("This instance is not the owner so it cannot pass ownership of value");
      }
      if (self.borrowed) {
          blame OwnershipError("Cannot pass ownership while the value is borrowed");
      }
    }

}
}

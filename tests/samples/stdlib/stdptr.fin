//@ normative
//@ unimplemented "The import resolves, the whole file parses, and `Self<T>` inside `interface rptr_iface<T>` resolves now -- an interface records its generic parameters on its type, and `Self<T>` written with the enclosing parameters is the enclosing type. Three are left. `pointer_type` on 40 is a type declared in no corpus file, and filing it under the prelude question was wrong: that question was two questions and this name is in neither. It is not the ambience half, because ambience is about a `pub` name declared somewhere in `namespace std` and `pointer_type` is declared nowhere in the tree -- lib/std/stdptr.fin drops the field for exactly that reason. It is not the invention half either, because `#[global]` makes a declared name visible and cannot conjure one. So it is booked and stays refused, and it may not be invented (ADR 0008); the split itself is recorded in tests/samples/enums.fin's note. `own` on 52 is reported for missing a return, and correctly as the sample is written: its two raises are both inside an `if`, so the fall-through path reaches the end of a function returning `&Self<T>`. `rptr does not implement rptr_iface` on 37 follows the two constructor requirements on 31 and 32, which the class does not declare -- and a constructor requirement is now checked by parameter list rather than being unsatisfiable by construction, so this one is about the class and not about the check"
// This implementation isn't even half complete, we need to work on the smart pointers here. this file needs rewriting
#[stdimport]
import { Error } from error::std;

namespace std {

struct OwnershipError: <Error> {}

interface rptr_iface<T> {
  priv:
    ref_counter <&uint>;

  pub:
    owned <bool>;
    readonly restrict <&Self<T>>; // a copy version of rptr but with READONLY access
    readonly value <&T>;

    fun is_givenback() <bool>;
    fun is_owned() <bool>;

    fun own() <Self<T>>;
    fun borrow() <Self<T>>;

    fun release() <noret>;

    fun set(new_value: &T) <noret>;
    fun get() <&T>;

  // Constructors
  Self(initial_value: T);
  Self(value: &T, counter: &T, borrowed: &bool, restrict: &Self<T>, owned: bool);

  ~Self(); // Destructor
}

pub class rptr<T>: <rptr_iface> {
  priv:
    counter <&uint>,
    ptrt <pointer_type>,

  pub:
    owned <bool> = false,
    borrowed <bool> = false,
    readonly restrict <&Self<T>>,
    readonly value <&T>,

    fun is_borrowed() <bool> { return self.borrowed; }
    fun is_givenback() <bool> { return self.borrowed == false; }
    fun is_owned() <bool> { return self.owned; }

    fun own() <&Self<T>> {
      if (!self.owned) {
        blame OwnershipError("This instance is not the owner so it cannot pass ownership of value");
      }
      if (self.borrowed) {
          blame OwnershipError("Cannot pass ownership while the value is borrowed");
      }
    }

}
}

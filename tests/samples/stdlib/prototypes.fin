//@ normative
//@ unimplemented "`module not found: types` -- the standard library is on no search path (src/driver/SearchPaths.hpp:107). `prtp.0` positional prototype access on line 11 parses now. With the library resolvable it reports `Undefined type 'any'` instead; `$type` resolves now (Soundness_MetaTypes)"
#[stdimport]
import { resolve_type } from types::std;

namespace std {
#[export]
type listarray = {any, any};

pub fun keys<T>(prtp: {T, any}) <[T]> {
    return prtp.0; // accessing `{prototype}.0` returns an array of the keys
  }

pub fun values<T>(prtp: {any, T}) <[T]> {
    return prtp.1; // accessing `{prototype}.1` returns an array of the values
  }

// if a prototype's type is <{int, string}> it returns the type `int`
pub fun typeof_keys(prtp: {any, any}) <$type> {
    return resolve_type(prtp.0);
  }
}

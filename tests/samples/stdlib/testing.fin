//@ normative
//@ ok
// The property runner and the assertion vocabulary (issue #55).
// lib/std/testing.fin is the module; this file is the runnable half.
//
// WHAT THE EXAMPLE PINS. The issue's own two-liner, corrected to the
// lambda spelling the agent guide names, plus the pieces the two-liner
// could not show:
//
//   * `check` is the canonical single assertion, same polarity as
//     `blame` -- its argument is the condition that must hold.
//   * `for_all` is SILENT while the property holds: a passing run
//     prints nothing, and this file's stdout is empty. Inputs are
//     `gen(seed + i)` for i in 0..n-1, a hundred of them here.
//   * `shrink` is callable on its own, because a failing property
//     blames (that is what a runner does) and a normative sample must
//     not abort. The pinned halving chain: against a property that
//     holds below 8 and fails from 8 up, shrinking 100 walks
//     100 -> 50 -> 25 -> 12 and stops when 6 holds, so the answer is
//     12 -- the minimal halving-reachable failure, not the global
//     minimum, exactly as the module header documents.
//
// THE FAILURE PATH LIVES IN THE SUITE. Soundness_Testing runs a
// program whose property fails on a planted bug and pins the blame
// message with both values (`input`, `minimally at`), and a second one
// pins `bench`'s honest refusal: whole-second wall timing cannot
// answer ns/op without lying about the magnitude, so bench refuses
// until issue #59 lands a sub-second clock. That refusal is also why
// no `bench` call appears here.

import { assert_eq_int, assert_eq_string, assert_ne_int, check, for_all, shrink } from testing::std;
import { concat } from strings::std;

fun main() <noret> {
    assert_eq_int(1 + 1, 2, "math works");
    assert_ne_int(1 + 1, 3, "the negative twin still answers polarity");
    assert_eq_string("ab", concat("a", "b"), "the string twin compares content");
    check(2 + 2 == 4, "check is the canonical assertion");
    check(!false, "check takes the same polarity as blame");

    // The property the two-liner stood for: every input survives
    // `x - x == 0`. Computed, not constant, inputs -- the `%` keeps the
    // hundred values inside the small range the `%` math of the sample
    // runs can see.
    for_all(42, 100, (x: int) <int> => x % 250, (x: int) <bool> => x - x == 0);

    // A second property over the same runner, with an empty `n`: the
    // runner runs nothing and stays silent, the documented contract.
    for_all(7, 0, (x: int) <int> => x + 1, (x: int) <bool> => x > 0);

    // The shrinker, surfaced: the chain above, pinned.
    let tiny <int> = shrink((x: int) <bool> => x < 8, 100);
    blame tiny == 12, "the halving chain stops naming 12";
    let zero <int> = shrink((x: int) <bool> => x < 8, 1);
    blame zero == 1, "a one-input start answers itself";
    let gone <int> = shrink((x: int) <bool> => x < 8, 0);
    blame gone == 0, "zero is already minimal";
}

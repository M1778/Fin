//@ normative
//@ unimplemented "`format!(\"Error: {}\", self.message)` at 19:16 -- \"Undefined macro 'format!'\"; the standard library calls a formatting macro nothing defines. `namespace`, the default parameter value on line 11 and the `@special(pub)` header parse now. Line 11's `err_code: int = null` type-checks now too (Soundness_Nullability), and line 12's `err_code == null` with it. Line 13's `Cannot assign to immutable variable 'err_code'` is gone: a parameter is a mutable binding unless it is written `const`, and this file is one of the two corpus sites that need it. The shape is the same at both -- a parameter takes a sentinel default and the body replaces it with the real one, here `err_code = -1` and at stdio.fin:110 `nbytes = self.stream_length` -- and it is const.fin that settles which way round the rule goes, by marking parameters `const` to forbid exactly this and writing out the copy the marker forces (Soundness_ParameterMutability). The second diagnostic is new and is what the compiler API exposed: `compiler.types.cmp_types(t, Error)` at 27:53 reports \"Undefined variable 'Error'\". `cmp_types` takes two `$type` arguments and `Error` is this file's own struct, named on line 8, so the sample asks that a type's name in a position wanting a `$type` denote that type as a value -- the reading types.fin:33 writes down as \"$type == literal type\". Nothing does that yet: `visit(Identifier&)` looks in the value scope and then at `self`, never at the type scope. That is the owner ruling this line is waiting on, and it is the only corpus site that puts the question this plainly"
namespace std {
#[llvm_name="Error"]
#[uncastable]
#[stderror] // Standard error class
#[class] // turns structs into classes (for stronger inheritance support)
pub struct Error {
    pub message <string>,
    pub error_id <int>,
    Error(msg: string, err_code: int = null) {
        if (err_code == null) {
            err_code = -1;
          }
        return new Error{message: msg, error_id: err_code};
      }

    pub fun format() <string> {
        return format!("Error: {}", self.message);
      }
  }

#[export]
#[use(compiler)]
#[use(compiler.components.types)]
@special(pub) is_error_type( t: $type ) <bool> {
   const result <int> = compiler.types.cmp_types(t, Error);
   return result == -1 : false ? true;
}
}

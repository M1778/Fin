//@ normative
//@ unimplemented "Three diagnostics. `#[use(compiler)]` binds the name now and the whole compiler API line on 25 resolves: `compiler.types.gettype::<T>()` takes its result from the turbofish, `select_field::<int>` returns that result nullable, and the trailing `?` denullifies it to the `int` the header promises; `typefrom_typeid` at 84:25 and `ct_any` at 91:25 type-check too (Soundness_CompilerApi). What that leaves at 25:12 is a grant, not a name: line 25 reads `compiler.structs` under a grant of `types` alone -- \"Component 'structs' is not granted here\". It is the same defect docs/compiler-api.md 2.1b books for memory.fin, at a site the doc did not flag; the corpus is the spec, so the missing `#[use(compiler.components.structs)]` is booked here and not fixed. `_static_string` at 14:14 is declared nowhere in the corpus -- the field comment says it is castable to a normal string and that the compiler API prefers it -- and `@_resolve_type(v)` at 98:10 is the `@`-call spelling of line 90's `@special`, which registers no name. The `module not found: error` this note used to open with is gone; line 3's import resolves. The union type alias on line 53, `any` (Soundness_DynamicTypes) and `$type` (Soundness_MetaTypes) all resolve"
#[stdimport]
import { Error } from error::std; // import `Error` from error -> std namespace

namespace std {

#[llvm_name="typeinfo"]
#[uncastable]
#[typeinfo_class]
#[class]
class TypeInfo {
    priv:
      _name <_static_string>, // uses _static_string for better compatibility with compiler API (castable to normal string)
      _typeid <uint>, // TypeId that compiler uses to identify types

    pub:
    	fun prototype() <noret> { blame m1778;} // using blame and m1778 keyword is like using `unimplemented!()` anyways gets optimized and eliminated by optimizer (DeadCode eliminator)
}

#[llvm_name="typeid"]
#[use(compiler)]
#[use(compiler.components.types)]
@special(pub) typeid(T: $type) <int> {
    return compiler.structs.select_field::<int>(compiler.types.gettype::<T>(), "TypeID")?; // A compiler API function that returns type information AS value. uses select_field to select a field from struct returned by gettype and we use denullifier `?`
  }

// cast function overlook:

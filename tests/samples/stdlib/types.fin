import { Error } from error;

#[llvm_name="typeinfo"]
#[uncastable]
#[typeinfo_class]
#[class]
class TypeInfo {
    priv _name <_static_string>, // uses _static_string for better compatibility with compiler API (castable to normal string)
    priv _typeid <int>, // TypeId that compiler uses to identify types

    pub:
    	fun prototype() <noret> { blame m1778;} // using blame and m1778 keyword is like using `unimplemented!()` anyways gets optimized and eliminated by optimizer (DeadCode eliminator)
}

#[llvm_name="typeid"]
#[use(compiler)]
#[use(compiler.components.types)]
@special typeid(T: $type) <int> {
    return compiler.structs.select_field::<int>(compiler.types.gettype::<T>(), "TypeID")?; // A compiler API function that returns type information AS value. uses select_field to select a field from struct returned by gettype and we use denullifier `?`
  }

// cast function overlook:

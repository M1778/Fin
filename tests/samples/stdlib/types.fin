//@ normative
//@ unimplemented "Two diagnostics, and this note's line numbers are corrected here, 2026-08-27. `#[use(compiler)]` binds the name and the compiler API path resolves on line 26: `compiler.types.gettype::<T>()` takes its result from the turbofish, `select_field::<int>` returns that result nullable, and the trailing `?` denullifies it to the `int` the header promises; `typefrom_typeid` at 85:25 and `ct_any` at 92:25 type-check too (Soundness_CompilerApi). The grant defect this note used to end on is gone: line 26 read `compiler.structs` under a grant of `types` alone -- \"Component 'structs' is not granted here\" -- and `#[use(compiler.components.structs)]` on line 24 fixes it, the same defect docs/compiler-api.md 2.1b books for memory.fin at a site the doc did not flag. Two things about that repair were wrong in the note it replaced and are set right here. It inserted line 24 and did not renumber the citations below it, so this note said 25, 84, 91, 98 and 53 where the file says 26, 85, 92, 99 and 54. And it claimed \"the whole compiler API line on 25 resolves\", which was never measured after the insertion: the second diagnostic changed identity rather than going away. It is now `Undefined type 'T'` at 26:74, and it is the one question this file puts that the corpus cannot answer for it. `@special(pub) typeid(T: $type)` declares `T` as a *value* parameter of meta-type `$type`, and line 26 writes that value in a turbofish, `gettype::<T>()`, where a type is expected. docs/compiler-api.md:485 gives `gettype` as `::<T>() <$struct>` -- \"Turbofish, no value argument\" -- so the operation is generic in a type and the sample hands it a `$type`-typed value. That is the inverse of the rule stdlib/error.fin:27 settled, where a type's *name* written where a `$type` is expected denotes that type (Soundness_TypeAsValue); whether a `$type` value read back out in a type position denotes its type is a separate owner ruling, and no other corpus site asks it. `_static_string` at 14:14 is declared nowhere in the corpus -- the field comment says it is castable to a normal string and that the compiler API prefers it. `@_resolve_type(v)` at 99:10 resolves -- a `@special` registers its name, so the `@`-call spelling finds it (Soundness_SpecialCalls). The `module not found: error` this note used to open with is gone; line 3's import resolves. The union type alias on line 54, `any` (Soundness_DynamicTypes) and `$type` (Soundness_MetaTypes) all resolve. This correction replaced the note line in place and changed nothing else, so no line number moved -- but docs/compiler-api.md still cites this file as `types.fin:23` five times and `types.fin:82` once, which are 26 and 85 now, and that document is not this lane's to edit"
#[stdimport]
import { Error } from error::std; // import `Error` from error -> std namespace

namespace std {

#[llvm_name="typeinfo"]
#[uncastable]
#[typeinfo_class]
#[class]
class TypeInfo {
    priv:
      _name <_static_string>, // uses _static_string for better compatibility with compiler API (castable to normal string)
      _typeid <uint>, // TypeId that compiler uses to identify types

    pub:
    	fun prototype() <noret> { blame m1778;} // using blame and m1778 keyword is like using `unimplemented!()` anyways gets optimized and eliminated by optimizer (DeadCode eliminator)
}

#[llvm_name="typeid"]
#[use(compiler)]
#[use(compiler.components.types)]
#[use(compiler.components.structs)]
@special(pub) typeid(T: $type) <int> {
    return compiler.structs.select_field::<int>(compiler.types.gettype::<T>(), "TypeID")?; // A compiler API function that returns type information AS value. uses select_field to select a field from struct returned by gettype and we use denullifier `?`
  }

// cast function overlook:
/*
#[llvm_name="cast"]
#[public] // Public to all
#[uncastable]
pub fun cast<_Type: $type>(value: Any<...>) <_Type> // $type == literal type (not needed to specify by default compiler uses monomorphism), value is type of ANY<ANY> (we take care of it in runtime but hint the compiler in compile time for catching expected errors before they break the program)
{
  // ... (Some checks for type conversion compatibility like type shape reformation status, check inheritance, parents, compatibility conversion)

  // return casted:
  return _casted;
}
*/

// numbers
#[export] %{ // multi set attribute for statements using `#[attribute]%{...statements}%`
pub type i32 = int;
pub type i64 = int{64};
pub type i128= int{128};
pub type u32 = uint;
pub type u64 = uint{64};
pub type u128 = uint{128};
pub type f32 = float;
pub type f64 = double;

pub type Number = int | uint | float | short | long | ushort | ulong | double | u64 | i64 | i128 | u128;
}%
// ...

#[export] // Using export makes a unique llvm name for all modules (for example: `t_string`)
#[type(string)] // String type definition
pub type string = [char]; // Special typing (overwrite default type)

#[export]
pub type array<T> = [T];

#[anytype]
#[export]
#[implements]
#[type(any)]
#[RT] // RuntimeType
pub type Any = any;

#[implements]
#[export]
#[RT]
type Any<...> = any implements <...>; // Any allows generics to bypass compile time type checking and instead runtime type handling happens, in other words ANY type is allowed to be passed but it has to be casted or handled by the user itself : `fun someFunction<A: Any<...>>() <noret>{};`

#[implements]
#[export]
type nullptr = any implements <&void>;

#[export]
#[use(compiler)]
#[use(compiler.components.types)]
@special(pub) tftid(tid: uint) <$type> { // returns a type from typeid
    let _type <$type> = compiler.types.typefrom_typeid(tid);
    return _type;
  }

#[use(compiler)]
#[use(compiler.components.types)]
@special _resolve_type(v: any) <$type> { // if v is of type `Any` or `Any<...>` or any other types that are defined to be RunetimeType, compiler raises an error
    let _type <$type> = compiler.types.ct_any(v); // resolves the type of v using a compiler api function (only in compile time)
    return _type;
  }

// Type Resolver (Compile time)
#[export]
pub fun resolve_type(v: any) <$type> { // any = any type that is visible in compile time (can be identified in compile time)
  return @_resolve_type(v);
}

#[export]
pub fun resolve_arr_type(const &arr: [any]) <$type> { // Usually we can resolve the type of the array but resolving the type of its first element like `resolve_type(array[0]);` however this might cause an error if the array is empty
    return resolve_type(arr[0]); // for now we'll just assume it has atleast one element and return the type of that
}


#[export]
pub fun number2str<T: Number>(number: T) <string> {

  return "10"; // placeholder
}

}

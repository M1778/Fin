//@ normative
//@ unimplemented "`**x = new int(10);` at 24:11 -- \"Type mismatch: expected 'int', got '&int'\". `new int*` parses now, with the stars counting the pointer levels of the result, which is what lines 27-29 require; line 24 additionally needs a `new int(10)` to be assignable to an `int` lvalue"
@define printf(fmt: string, ...) <noret>;

fun swap<T>(a: &T, b:  &T) <noret> {
    let temp <T> = *b;
    *b = *a;
    *a = temp;
    
    delete &temp;
  }


fun main() <noret> {
    let a <int> = 10;
    let b <int> = 20;

    swap(&a, &b); // we can also use `swap(a, b);` and compiler will automatically pass them by reference and give a warning asking you to pass them by reference manually however there's a way to change that in compiler options

    printf("a = %d, b = %d\n", a, b);
    
    let x <&&int>;
    *x = new int*;
    **x = new int(10); // heap allocated

    let yy <&&&&int>; // complex pointer
    *yy = new int***;
    **yy = new int**;
    ***yy = new int*;
    ****yy = 10;
  }

//@ normative
//@ unimplemented "The struct literal parses and analyses now -- `make_default(struct { ... })` on line 24 was \"unexpected KW_STRUCT, expecting RPAREN\" and is a TypeLiteralExpression typed `$struct`, which is why this file went from one syntax error to nine semantic ones. Four blockers remain: (1) `st{}` at 5:27 says \"Undefined struct 'st'\" -- `st` is a *value* of type `$struct`, and instantiating one needs its type known at compile time, which is the compiler API's job (docs/compiler-api.md, wave 4); (2) `Struct` at 15:25 is undefined and is declared nowhere in the corpus or lib/std -- line 4 uses it in the interface slot (`any implements Struct`, where typing.fin:10 puts `Error`) and line 15 in the base slot (`Struct implements <...>`, where typing.fin:10 puts `any`), so whether it is a compiler-provided shape meaning \"any struct\", an interface, or both is an owner ruling; (3) the five `Type 'T' is not a struct` / `does not have methods` at 18:5, 36:5, 38:5, 42:10, 42:40 are the booked defect that a generic bound written through `any` or an alias to it loses the bound type's members; (4) `@defined` at 29:18 and the `@define printf()` it guards at 32:13"

fun make_default<T: any implements Struct>(st: $struct) <T> {
    let instance <auto> = st{}; // Make default of struct type

    return cast<T>(instance);
  }

interface _PlayerStructLike {
    pub health <uint>,
    pub damage <uint>,
  }

type PlayerStructLike = Struct implements <_PlayerStructLike>;

fun sub_health<T: PlayerStructLike>(plr: T) <noret> { // another way of defining this function is like this: `fun sub_health(plr: PlayerStructLike) <noret>{}` which is easier
    plr.health -= 10;
  }


fun main() <noret> {
    // example of struct literal (temporary struct)
    let unique_player <auto> = make_default(struct {
        pub health <uint> = 100,
        pub damage <uint> = 1,

        pub print_player(self: &Self) <noret> {
            if (!@defined("printf")){
              @define printf() <noret>;
            }
            printf("health: %d, damage: %d\n");
          }
      });

    unique_player.print_player(); // health = 100, damage = 1

    unique_player.damage = 10; // this works

    sub_health(unique_player);

   blame unique_player.health == 90 && unique_player.damage == 10; // <- assertion here

  }

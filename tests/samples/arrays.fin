
type ArrayType<T> = [T]; // simple generic array type
type IntArray = [int]; // array of integers
type PtrIntArray = &[int]; // a pointer to an array of integers
type IntPtrArray = [&int]; // an array of integer pointers

type Number = int | uint | float | short | long | ushort | ulong | double;

fun sort<T: Number>(array: &[T]) <noret> { // sorts an array of numbers (passed by reference so array is not copied)
    if (array.length <= 1) {
        return;
      }

    let temp: int;
    for (i:int = 0; i < array.length - 1; i++) {
        for (j:int = 0; j < array.length - 1; j++) {
            if (array[i] > array[j]) {
                temp = array[i];
                array[i] = array[j];
                array[j] = temp;
              }
          }
      }
  }

fun main() <noret> {
    let myarr <[uint]> = [7,3,4,7,12,4,6,9,0];


    sort(&myarr); // if i don't pass by reference compiler will give an error and help me fix this

    blame myarr[0] == 0; // assertion: ensure array is sorted

  }

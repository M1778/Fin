import stdio::std as stdio; // its like saying `using stdio = std;`

@define printf(fmt: string, ...) <int>;

struct Box<T> {
    val <T>
}

fun main() <noret> {
    let b <Box<int>> = Box::<int>{ val: 100 };
    if (b.val > 50) {
        stdio.printf("Big"); // uses stdio printf
    } else {
        printf("Small"); // uses defined (c interlop) printf
    }
}

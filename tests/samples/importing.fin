//@ normative
//@ unimplemented "Every import form in the file parses, `import * from m;` included. A quoted path is tried relative to the importing file first, then as an absolute path, then through the search paths -- and the search-path set ends in the working directory, which is the step that resolves line 3's `import { Vector3 } from \"tests/samples/structs.fin\"` and line 7's `import \"tests/samples/macros.fin\"` from the repository root and nothing else: run from a different directory, both report `module not found`. That working-directory dependence is the whole of what keeps this file `unimplemented` rather than `ok`: from the repository root every line builds, runs `Hello i am imported from stdio`, and exits 0 on both compilers -- line 19's `Vector3{...}` struct literal lowers (also cross-module), line 7's `macros.magic_add!(10, 20)` expands per ADR 0023, and lines 9 and 11 reach the shipped `lib/std/networking.fin` with no flag and no environment variable. The `somelib` name those lines used to reach is gone by owner decision (`lib/std/somelib/index.fin` was deleted in `4d79ae7` because the name was this sample's invention); the mechanism never left."
import { Vector3 } from "tests/samples/structs.fin"; // This is allowed and ONLY imports the symbol (Vector3) [supports special functions, macros, ...]
import { printf } from stdio; // this looks in builtins directory which we haven't implemented yet but it looks for either a file named "stdio.fin" or "stdio.finlib" OR looks for a directory named "stdio" and looks for a file named "printf.fin" in it (THERE ARE SO MANY POSSIBILIES THAT CAN HAPPEN WITH DOTS TOO like "stdio.buffers" and more)
import networking; // looks for this in builtins and imports the whole module which allows to be used like "networking.invoke()"
import networking as net; // this is using the "as" keyword for name changing which is super useful
import "tests/samples/macros.fin"; // this is a normal file import which imports macros as "macros" by default so it can be used like "macros.magic_add!(...)"

import "networking"; // IMPORTANT: THIS IS SO IMPORTANT BECAUSE WE DO NOT GIVE ANY PATH TO IT SO HOW DOES THE COMPILER KNOW WHERE TO IMPORT THIS LIBRARY, as we assume networking is a module on the search paths. The compiler also checks an environment variable named "FIN_LIBS" which has multiple paths of imports (specially builtins) and uses those to search for libraries (this is how our package manager "finn" can easily tell our compiler which environment to use using "--fin-libs" flag)

import * from networking; // this will import ALL symbols from the networking library

//since namespaces exists we also allow a way to import stuff from namespaces explicitly:
import { HashMap } from hashmap::std; // this means there is a namespace in hashmap library and we explicitly import the `HashMap` symbol from that namespace using COLONCOLON

fun main() <noret> {
    let x <auto> = Vector3{x: 10, y: 10, z: 10};

    printf("Hello i am imported from stdio");

    let y <auto> = macros.magic_add!(10, 20);
}

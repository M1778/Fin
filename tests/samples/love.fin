//@ normative
//@ ok
// This file compiles and runs. `finc tests/samples/love.fin -o love` exits 0 and the
// program prints both lines. That was not true when this header was first written: a
// struct field whose type is an interface was refused by the backend, because an
// interface reference had no representation there. ADR 0027 gave it one -- `{data,
// vtable}`, with a field-offset slot per required field -- and `aea960e` and `d8ce220`
// implemented it. The corpus harness only runs the front end, so `ok` above still
// asserts the narrower thing; the build is measured by the codegen suite.
//
// Three things landed for this file on 2026-08-28.
//
// (1) A COMPILER BUG it found. An interface member was resolved and then discarded, so
// `interface Person { readonly name <string>, }` followed by any read of `.name` through
// a `Person`-typed value reported `Struct 'Person' has no member 'name'` -- about a
// member the interface declares. A method in the same position always worked, so the two
// halves of an interface disagreed about whether they existed. readonly.fin:29 declares
// the same shape and never reads it through the interface, which is why fifty samples
// missed it. Soundness_Interfaces.AnInterfaceMemberIsReadableThroughTheInterfaceType.
//
// (2) THE RULING this file is the witness for: a struct converts to an interface it
// implements. ADR 0019 fixed the representation of an interface reference while recording
// that "interface-as-a-runtime-type does not exist in the corpus" -- across the other
// fifty samples every interface is a bound (`T: Printable`) or the `$interface`
// meta-type. This file supplies what that ADR was written without. The conversion is
// gated on `implements()`, the same predicate the declaration-site check uses, and is
// one-directional: an interface does not convert back to a struct.
//
// (3) THREE REPAIRS, each witnessed by the rest of the corpus rather than invented, under
// the owner's ruling that a sample whose own logic is wrong may be repaired. The third
// landed 2026-08-29.
//
//   Lines 56 and 66 read `struct Fin <Person,Beautiful>` and `struct M1778
//   <Person,Loser>`. Angle brackets directly after the name declare *generic
//   parameters*, so `Person` became a type parameter shadowing the interface of the same
//   name, and `self.hate.name` then reported `Type 'Person' is not a struct` about an
//   unbound parameter rather than about the interface three lines up. Both spellings were
//   measured in a scratch copy to confirm that was the cause. Inheritance is spelled with
//   a colon, which four samples write: readonly.fin:34, deeptest2.fin:67 and :83,
//   stdlib/stdio.fin:46.
//
//   Lines 82 and 83 read `M1778.love(F)` and `Fin.hate(M1778)`, calling a method on the
//   *type*. `I` and `F` are the values, declared on 79 and 80. Three samples write the
//   value form: implements_block.fin:36, readonly.fin:55, interfaces.fin:17.
//
//   Lines 60 and 71 read `fun hate(someone: <Person>)` and `fun love(a: <Person>)`. The
//   brackets are the parameter-type spelling of a compiler seven months older than this
//   one and the owner did not intend them here (owner, 2026-08-29). Both spellings still
//   parse to the same type -- measured -- so this is a repair of the file's style and not
//   of a diagnostic: nineteen samples write a parameter type unbracketed, and after this
//   none writes one bracketed. Two corpus files still spell a *different* position that
//   way, `@define printf(fmt: <string>, ...)` at preprocessor.fin:3 and operators.fin:4,
//   and they are left alone -- neither is this file and neither was reported.
@define printf(fmt: string, ...) <noret>;

interface Loser {}
interface Beautiful {}
interface Person {
	readonly name <string>,
}


struct Fin: <Person,Beautiful> {
	readonly hate <Person>,
	name <string>,

	fun hate(someone: Person) <noret> {
		self.hate = someone;
		printf("Fin started hating %s\n", self.hate.name);
	}
}

struct M1778: <Person,Loser> {
pub:
	readonly love <Person>,
	name <string>,

	fun love(a: Person) <noret> {
		self.love = a;
		printf("N1778 started loving %s\n", a.name);
	}

}

fun main() <noret> {
	const I <auto> = M1778{name:"M1778"};
	const F <auto> = Fin{name:"Fin"};

	I.love(F);
	F.hate(I);
}

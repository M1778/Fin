//@ normative
//@ ok
@define printf(fmt: string, ...) <noret>;

fun main() <noret> {
    // for loop
    for (i : int = 0; i <= 10; i++) {
        printf("%d\n", i);
    }

    let a <[int, 5]> = [1,2,3,4,5]; // array

    for (i: int = 0; i < a.length - 1; i++){
        printf("%d\n", a[i]);
    }

    // foreach loop
    foreach(idx <int>, element <int> in a) {
        blame element == a[idx]; // No assertion happens since the element matches
    }

    // foreach loop (just element)
    foreach (element <int> in a) {
        printf("%d\n", element);
    }

    // while loop
    while (true) {
        printf("Atleast i ran once\n");
        break;
    }

    // do while loop
    do {
        printf("I was ran once too\n");
    } while (false);

    // do while with a true condition runs until it fails: the body executes
    // first and the condition is checked after each pass (unlike `while`,
    // which checks first).
    let count <int> = 0;
    do {
        count = count + 1;
    } while (count < 3);
    printf("counted to %d\n", count);

    // recursion like
    fun recursive(a: int) <int> {
        if (a == 0) {
            return 0;
        }
        return recursive(a - 1);
    }
    let b <auto> = recursive(5);

    // Special loop (infinite loop => while true):
}

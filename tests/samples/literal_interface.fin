//@ normative
//@ unimplemented "The interface literal parses and analyses -- `return interface { ... }` at 20:16 was \"unexpected KW_INTERFACE\" and is a TypeLiteralExpression typed `$interface`, in both the multi-line form on line 20 and the one-line form on line 25, and a member default (`pub picked_first <bool> = true;`) is parsed *and* type-checked. Line 23 closed the multi-line literal with a bare `}` and is repaired to `};`. The witness is line 25, the other branch of this same function, which writes `return interface { pub picked_second <bool> = true; };`; every other brace-terminated return in the corpus writes the semicolon too (deeptest1.fin:15, letssee.fin:22, :29, :52), so it was five spellings to one and a typo rather than a semicolon-optional rule for one expression shape. Asserted from the other side in Soundness_TypeLiterals.AReturnedTypeLiteralStillNeedsItsSemicolon, which keeps the compiler refusing the bare `}`. One diagnostic is left, and it is not this file's: `@implements(struct_, iface)` on line 6 is a compiler-API operation nothing registers yet. docs/compiler-api.md:490 declares it -- `implements | (t: $type, i: $interface) <bool> | read-only | MetaType.implements. Backs @implements` -- with the argument order this line writes, so the sample is right and the operations layer is unbuilt (the same shape as `@getenumkeyid` in stdlib/enums.fin and `@Alloc` in stdlib/memory.fin). It was invisible until the semicolon landed, because a syntax error means nothing in the file is analysed at all -- which is why the earlier claim that one `;` was the whole of what this file needed was an inference and not a measurement"


fun compatible(iface: $interface, struct_: $struct) <bool> {
    if (@implements(struct_, iface) == true) { // another feature of implements is that it can tell if a struct satisfies an interface or type shape like instance
        return true;
      } else {
          return false;
        }
  }

enum IFaceOptions {
    First = 1,
    Second = 2,
  }

fun pick_interface(option: IFaceOptions) <$interface> {
    if (option == IFaceOptions::First) {
        return interface {
            pub picked_first <bool> = true;
            pub fun say_hello() <noret>;
          };
      } else {
          return interface { pub picked_second <bool> = true; };
        }
  }

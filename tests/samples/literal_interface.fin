//@ normative
//@ unimplemented "`return interface { ... }` at 20:16 -- \"unexpected KW_INTERFACE\". An interface literal is an expression and the AST has no node for one; ADR 0004 makes `accept` pure virtual, so adding a node means adding a `visit` to src/ast/Visitor.hpp. `@implements(struct_, iface)` as an expression on line 6 parses now"


fun compatible(iface: $interface, struct_: $struct) <bool> {
    if (@implements(struct_, iface) == true) { // another feature of implements is that it can tell if a struct satisfies an interface or type shape like instance
        return true;
      } else {
          return false;
        }
  }

enum IFaceOptions {
    First = 1,
    Second = 2,
  }

fun pick_interface(option: IFaceOptions) <$interface> {
    if (option == IFaceOptions::First) {
        return interface {
            pub picked_first <bool> = true;
            pub fun say_hello() <noret>;
          }
      } else {
          return interface { pub picked_second <bool> = true; };
        }
  }

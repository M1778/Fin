// Target Initialization
#[llvm_name="LLVMInitializeX86TargetInfo"]
@define llvm_init_x86_target_info() <noret>;

#[llvm_name="LLVMInitializeX86Target"]
@define llvm_init_x86_target() <noret>;

#[llvm_name="LLVMInitializeX86TargetMC"]
@define llvm_init_x86_target_mc() <noret>;

#[llvm_name="LLVMInitializeX86AsmPrinter"]
@define llvm_init_x86_asm_printer() <noret>;

// AArch64 mirrors the X86 set above one for one: the C++ backend
// (CodeGen_LLVM.cpp) calls InitializeNativeTarget* which registers the
// host's target, so the stage backend must name AArch64 for ARM hosts.
// No other target is named: on every other host the X86 path below runs,
// exactly as before.
#[llvm_name="LLVMInitializeAArch64TargetInfo"]
@define llvm_init_aarch64_target_info() <noret>;

#[llvm_name="LLVMInitializeAArch64Target"]
@define llvm_init_aarch64_target() <noret>;

#[llvm_name="LLVMInitializeAArch64TargetMC"]
@define llvm_init_aarch64_target_mc() <noret>;

#[llvm_name="LLVMInitializeAArch64AsmPrinter"]
@define llvm_init_aarch64_asm_printer() <noret>;

#[llvm_name="LLVMGetDefaultTargetTriple"]
@define llvm_get_default_triple() <string>;

#[llvm_name="LLVMGetTargetFromTriple"]
@define llvm_get_target_from_triple(triple: string, target_out: &LLVMTargetSlot, err_out: &LLVMErrSlot) <int>;

#[llvm_name="LLVMCreateTargetMachine"]
@define llvm_create_target_machine(t: &LLVMTarget, triple: string, cpu: string, features: string, opt: int, reloc: int, model: int) <&LLVMTargetMachine>;

#[llvm_name="LLVMTargetMachineEmitToFile"]
@define llvm_target_machine_emit_to_file(tm: &LLVMTargetMachine, m: &LLVMModule, filename: string, codegen: int, err_out: &LLVMErrSlot) <int>;

#[llvm_name="LLVMDisposeTargetMachine"]
@define llvm_dispose_target_machine(tm: &LLVMTargetMachine) <noret>;

// New-pass-manager default pipeline (mirrors the C++ backend's
// buildPerModuleDefaultPipeline in src/codegen/CodeGen_LLVM.cpp).
// LLVMRunPasses returns null on success; any other value consumes into
// LLVMGetErrorMessage, whose string LLVMDisposeErrorMessage frees.
#[llvm_name="LLVMCreatePassBuilderOptions"]
@define llvm_create_pass_builder_options() <&LLVMPassBuilderOptions>;

#[llvm_name="LLVMDisposePassBuilderOptions"]
@define llvm_dispose_pass_builder_options(opts: &LLVMPassBuilderOptions) <noret>;

#[llvm_name="LLVMRunPasses"]
@define llvm_run_passes(m: &LLVMModule, passes: string, tm: &LLVMTargetMachine, opts: &LLVMPassBuilderOptions) <&LLVMOptError>;

#[llvm_name="LLVMGetErrorMessage"]
@define llvm_get_error_message(err: &LLVMOptError) <string>;

#[llvm_name="LLVMDisposeErrorMessage"]
@define llvm_dispose_error_message(msg: string) <noret>;

// Module
#[llvm_name="LLVMModuleCreateWithName"]
@define llvm_module_create(name: string) <&LLVMModule>;

#[llvm_name="LLVMDisposeModule"]
@define llvm_dispose_module(m: &LLVMModule) <noret>;

#[llvm_name="LLVMDumpModule"]
@define llvm_dump_module(m: &LLVMModule) <noret>;

#[llvm_name="LLVMVerifyModule"]
@define llvm_verify_module(m: &LLVMModule, action: int, out_msg: &LLVMErrSlot) <int>;

#[llvm_name="LLVMVerifyFunction"]
@define llvm_verify_function(fn_val: &LLVMValue, action: int) <int>;

#[llvm_name="LLVMWriteBitcodeToFile"]
@define llvm_write_bitcode_to_file(m: &LLVMModule, path: string) <int>;


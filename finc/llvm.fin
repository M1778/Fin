// Constants
#[llvm_name="LLVMConstInt"]
@define llvm_const_int(int_type: &LLVMType, val: int, sign_extend: int) <&LLVMValue>;

// Full-width integer constant from decimal text (mirrors
// LLVMConstRealOfString for floats): carries literals the int-carrying
// llvm_const_int cannot spell (the C++ frontend types them long).
#[llvm_name="LLVMConstIntOfString"]
@define llvm_const_int_of_string(int_type: &LLVMType, text: string, radix: int) <&LLVMValue>;

#[llvm_name="LLVMConstString"]
@define llvm_const_string(s: string, len: int, dont_null_terminate: int) <&LLVMValue>;

#[llvm_name="LLVMConstNull"]
@define llvm_const_null(ty: &LLVMType) <&LLVMValue>;

#[llvm_name="LLVMConstRealOfString"]
@define llvm_const_real_of_string(ty: &LLVMType, text: string) <&LLVMValue>;

#[llvm_name="LLVMGetUndef"]
@define llvm_get_undef(ty: &LLVMType) <&LLVMValue>;

#[llvm_name="LLVMBuildGlobalStringPtr"]
@define llvm_build_global_string_ptr(b: &LLVMBuilder, s: string, name: string) <&LLVMValue>;


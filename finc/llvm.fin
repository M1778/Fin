// SPDX-License-Identifier: GPL-3.0-or-later
// LLVM-C API bindings for the Fin Self-Hosting Compiler
// Implements ADR 0002 and ADR 0043 (pure LLVM lowering)

import { starts_with } from strings::std;

namespace finc {

pub struct LLVMModule {}
pub struct LLVMBuilder {}
pub struct LLVMValue {}
pub struct LLVMType {}
pub struct LLVMBasicBlock {}
pub struct LLVMDatalayout {}
pub struct LLVMTarget {}
pub struct LLVMTargetMachine {}
pub struct LLVMContext {}
pub struct LLVMPassBuilderOptions {}
pub struct LLVMOptError {}

pub struct LLVMTargetSlot {
    pub:
      ptr <&LLVMTarget> = null,
}

pub struct LLVMErrSlot {
    pub:
      msg <string> = "",
}

pub struct LLVMTypeArgs {
    pub:
      // The 64 pointer slots the LLVM functions read (C-ABI: a contiguous
      // LLVMTypeRef[64]). One fixed array member instead of 64 named fields
      // so Fin can index slots at runtime; `new LLVMTypeArgs{}` zero-fills
      // every slot null, exactly as the per-field `= null` defaults did.
      t <[&LLVMType, 64]>,
}

pub struct LLVMValueArgs {
    pub:
      // Same contract as LLVMTypeArgs with LLVMValueRef pointers: 64
      // contiguous slots, zero-filled null by the calloc'd box.
      v <[&LLVMValue, 64]>,
}

pub struct LLVMIndices {
    pub:
      i0 <&LLVMValue> = null,
      i1 <&LLVMValue> = null,
}

pub struct LLVMBlockArgs {
    pub:
      b0 <&LLVMBasicBlock> = null,
      b1 <&LLVMBasicBlock> = null,
}

// Target Initialization
#[llvm_name="LLVMInitializeX86TargetInfo"]

// ICmp Predicates
#[export] pub fun llvm_int_eq() <int> { return 32; }
#[export] pub fun llvm_int_ne() <int> { return 33; }
#[export] pub fun llvm_int_sgt() <int> { return 38; }
#[export] pub fun llvm_int_sge() <int> { return 39; }
#[export] pub fun llvm_int_slt() <int> { return 40; }
#[export] pub fun llvm_int_sle() <int> { return 41; }

// Helper: Initialize native LLVM target machine
#[export]
pub fun init_native_target() <bool> {
    llvm_init_x86_target_info();
    llvm_init_x86_target();
    llvm_init_x86_target_mc();
    llvm_init_x86_asm_printer();
    return true;
}

// Helper: Emit LLVM module to object file
#[export]
pub fun emit_module_to_object(m: &LLVMModule, object_path: string, opt_level: int) <bool> {
    let triple <string> = llvm_get_default_triple();
    let tgt_slot <&LLVMTargetSlot> = new LLVMTargetSlot{};
    let err_slot <&LLVMErrSlot> = new LLVMErrSlot{};
    let rc <int> = llvm_get_target_from_triple(triple, tgt_slot, err_slot);
    if (rc != 0) {
        delete tgt_slot;
        delete err_slot;
        return false;
    }
    let target <&LLVMTarget> = tgt_slot.ptr;
    let tm <&LLVMTargetMachine> = llvm_create_target_machine(target, triple, "generic", "", opt_level, 0, 0);
    // codegen = 1 for LLVMObjectFile
    let emit_rc <int> = llvm_target_machine_emit_to_file(tm, m, object_path, 1, err_slot);
    llvm_dispose_target_machine(tm);
    delete tgt_slot;
    delete err_slot;
    return emit_rc == 0;
}

}

// ICmp Predicates
#[export] pub fun llvm_int_eq() <int> { return 32; }
#[export] pub fun llvm_int_ne() <int> { return 33; }
#[export] pub fun llvm_int_ugt() <int> { return 34; }
#[export] pub fun llvm_int_uge() <int> { return 35; }
#[export] pub fun llvm_int_ult() <int> { return 36; }
#[export] pub fun llvm_int_ule() <int> { return 37; }
#[export] pub fun llvm_int_sgt() <int> { return 38; }
#[export] pub fun llvm_int_sge() <int> { return 39; }
#[export] pub fun llvm_int_slt() <int> { return 40; }
#[export] pub fun llvm_int_sle() <int> { return 41; }

// FCmp Predicates (ordered: NaN compares false, matching C++ O-variants)
#[export] pub fun llvm_real_oeq() <int> { return 1; }
#[export] pub fun llvm_real_one() <int> { return 6; }
#[export] pub fun llvm_real_ogt() <int> { return 2; }
#[export] pub fun llvm_real_oge() <int> { return 3; }
#[export] pub fun llvm_real_olt() <int> { return 4; }
#[export] pub fun llvm_real_ole() <int> { return 5; }

// Helper: Initialize native LLVM target machine
#[export]
pub fun init_native_target() <bool> {
    // The C++ backend (CodeGen_LLVM.cpp) calls InitializeNativeTarget*,
    // which registers the host's target, whatever it is. The stage backend
    // names its targets explicitly, so it branches on the default triple:
    // AArch64 for ARM hosts (aarch64 Linux, arm64 Darwin), X86 otherwise.
    // An x86_64 triple never enters the gated path, so x86_64 behavior is
    // the same four calls it has always been.
    let triple <string> = llvm_get_default_triple();
    if (starts_with(triple, "aarch64") || starts_with(triple, "arm64")) {
        llvm_init_aarch64_target_info();
        llvm_init_aarch64_target();
        llvm_init_aarch64_target_mc();
        llvm_init_aarch64_asm_printer();
        return true;
    }
    llvm_init_x86_target_info();
    llvm_init_x86_target();
    llvm_init_x86_target_mc();
    llvm_init_x86_asm_printer();
    return true;
}

// Helper: Emit LLVM module to object file
#[export]
pub fun emit_module_to_object(m: &LLVMModule, object_path: string, opt_level: int) <bool> {
    let triple <string> = llvm_get_default_triple();
    let tgt_slot <&LLVMTargetSlot> = new LLVMTargetSlot{};
    let err_slot <&LLVMErrSlot> = new LLVMErrSlot{};
    let rc <int> = llvm_get_target_from_triple(triple, tgt_slot, err_slot);
    if (rc != 0) {
        delete tgt_slot;
        delete err_slot;
        return false;
    }
    let target <&LLVMTarget> = tgt_slot.ptr;
    // Mirror the C++ backend (CodeGen_LLVM.cpp): the machine's own level is
    // Default for any -O1..-O3 and None at -O0; the IR pipeline below is the
    // half that level does not cover. Clamped to the 0..3 argv domain.
    let clamped <int> = opt_level;
    if (clamped < 0) { clamped = 0; }
    if (clamped > 3) { clamped = 3; }
    let cg_opt <int> = 0;
    if (clamped > 0) { cg_opt = 2; }
    let tm <&LLVMTargetMachine> = llvm_create_target_machine(target, triple, "generic", "", cg_opt, 0, 0);
    if (clamped > 0) {
        let pipe <string> = "default<O1>";
        if (clamped >= 3) { pipe = "default<O3>"; }
        else if (clamped == 2) { pipe = "default<O2>"; }
        let pb_opts <&LLVMPassBuilderOptions> = llvm_create_pass_builder_options();
        let perr <&LLVMOptError> = llvm_run_passes(m, pipe, tm, pb_opts);
        llvm_dispose_pass_builder_options(pb_opts);
        if (perr != null) {
            let emsg <string> = llvm_get_error_message(perr);
            llvm_dispose_error_message(emsg);
            llvm_dispose_target_machine(tm);
            delete tgt_slot;
            delete err_slot;
            return false;
        }
    }
    // codegen = 1 for LLVMObjectFile
    let emit_rc <int> = llvm_target_machine_emit_to_file(tm, m, object_path, 1, err_slot);
    llvm_dispose_target_machine(tm);
    delete tgt_slot;
    delete err_slot;
    return emit_rc == 0;
}

}

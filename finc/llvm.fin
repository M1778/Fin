// AArch64 mirrors the X86 set above one for one: the C++ backend
// (CodeGen_LLVM.cpp) calls InitializeNativeTarget* which registers the
// host's target, so the stage backend must name AArch64 for ARM hosts.
// No other target is named: on every other host the X86 path below runs,
// exactly as before.
#[llvm_name="LLVMInitializeAArch64TargetInfo"]
@define llvm_init_aarch64_target_info() <noret>;

#[llvm_name="LLVMInitializeAArch64Target"]
@define llvm_init_aarch64_target() <noret>;


// LLVM-C API bindings for the Fin Self-Hosting Compiler
// Implements ADR 0002 and ADR 0043 (pure LLVM lowering)

namespace finc {

pub struct LLVMModule {}
pub struct LLVMBuilder {}
pub struct LLVMValue {}
pub struct LLVMType {}
pub struct LLVMBasicBlock {}
pub struct LLVMTarget {}
pub struct LLVMTargetMachine {}
pub struct LLVMContext {}

pub struct LLVMTargetSlot {
    pub:
      ptr <&LLVMTarget> = null,
}

pub struct LLVMErrSlot {
    pub:
      msg <string> = "",
}

pub struct LLVMTypeArgs {
    pub:
      t0 <&LLVMType> = null,
      t1 <&LLVMType> = null,
      t2 <&LLVMType> = null,
      t3 <&LLVMType> = null,
      t4 <&LLVMType> = null,
      t5 <&LLVMType> = null,
      t6 <&LLVMType> = null,
      t7 <&LLVMType> = null,
      t8 <&LLVMType> = null,
      t9 <&LLVMType> = null,
      t10 <&LLVMType> = null,
      t11 <&LLVMType> = null,
      t12 <&LLVMType> = null,
      t13 <&LLVMType> = null,
      t14 <&LLVMType> = null,
      t15 <&LLVMType> = null,
}

pub struct LLVMValueArgs {
    pub:
      v0 <&LLVMValue> = null,
      v1 <&LLVMValue> = null,
      v2 <&LLVMValue> = null,
      v3 <&LLVMValue> = null,
      v4 <&LLVMValue> = null,
      v5 <&LLVMValue> = null,
      v6 <&LLVMValue> = null,
      v7 <&LLVMValue> = null,
      v8 <&LLVMValue> = null,
      v9 <&LLVMValue> = null,
      v10 <&LLVMValue> = null,
      v11 <&LLVMValue> = null,
      v12 <&LLVMValue> = null,
      v13 <&LLVMValue> = null,
      v14 <&LLVMValue> = null,
      v15 <&LLVMValue> = null,
}

pub struct LLVMIndices {
    pub:
      i0 <&LLVMValue> = null,
      i1 <&LLVMValue> = null,
}

pub struct LLVMBlockArgs {
    pub:
      b0 <&LLVMBasicBlock> = null,
      b1 <&LLVMBasicBlock> = null,
}


#[llvm_name="LLVMGetGlobalContext"]
@define llvm_get_global_context() <&LLVMContext>;

#[llvm_name="LLVMStructCreateNamed"]
@define llvm_struct_create_named(c: &LLVMContext, name: string) <&LLVMType>;

#[llvm_name="LLVMStructSetBody"]

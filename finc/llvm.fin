#[llvm_name="LLVMAppendBasicBlock"]
@define llvm_append_basic_block(fn_val: &LLVMValue, name: string) <&LLVMBasicBlock>;

#[llvm_name="LLVMGetParam"]
@define llvm_get_param(fn_val: &LLVMValue, index: int) <&LLVMValue>;

// IR Builder
#[llvm_name="LLVMCreateBuilder"]
@define llvm_create_builder() <&LLVMBuilder>;

#[llvm_name="LLVMDisposeBuilder"]
@define llvm_dispose_builder(b: &LLVMBuilder) <noret>;

#[llvm_name="LLVMPositionBuilderAtEnd"]

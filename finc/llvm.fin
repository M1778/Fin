#[llvm_name="LLVMCountStructElementTypes"]
@define llvm_count_struct_element_types(struct_ty: &LLVMType) <int>;

#[llvm_name="LLVMStructGetTypeAtIndex"]
@define llvm_struct_get_type_at_index(struct_ty: &LLVMType, idx: int) <&LLVMType>;

#[llvm_name="LLVMStructType"]
@define llvm_struct_type(elem_types: &LLVMTypeArgs, elem_count: int, packed: int) <&LLVMType>;

#[llvm_name="LLVMGlobalGetValueType"]
@define llvm_global_get_value_type(val: &LLVMValue) <&LLVMType>;

#[llvm_name="LLVMTypeOf"]
@define llvm_type_of(val: &LLVMValue) <&LLVMType>;

// Functions & Blocks
#[llvm_name="LLVMAddGlobal"]
@define llvm_add_global(module: &LLVMModule, ty: &LLVMType, name: string) <&LLVMValue>;

#[llvm_name="LLVMGetNamedGlobal"]

// finc/checker.fin: Semantic analyzer and type checker for Fin self-hosting compiler.

import {
    AstNode,
    ast_program, ast_fun_decl, ast_struct_decl, ast_var_decl, ast_param,
    ast_block, ast_if_stmt, ast_while_stmt, ast_for_stmt, ast_return_stmt, ast_blame_stmt,
    ast_expr_stmt, ast_break_stmt, ast_continue_stmt,
    ast_binary_expr, ast_unary_expr, ast_call_expr,
    ast_member_access, ast_index_expr, ast_ident,
    ast_literal_int, ast_literal_string, ast_literal_bool,
    ast_enum_decl, ast_interface_decl, ast_prototype_literal,
    ast_quote_expr,
    ast_type_alias
} from ast::std;

import {
    Scope, Symbol, new_scope, free_scope,
    sym_variable, sym_function, sym_struct, sym_parameter,
    sym_enum, sym_interface, sym_type_alias,
    make_var_sym, make_fn_sym
} from scope::std;

import {
    DiagnosticBag, diag_error, diag_warning, format_snippet, free_diag_str
} from diag::std;

import { Buffer, new_buffer, free_buffer, free_string } from buffer::std;
import { substr, to_chars } from strings::std;
import { read_to_string, free_file_content } from fs::std;

#[llvm_name="strcmp"]
@define chk_strcmp(a: string, b: string) <int>;

#[llvm_name="strncmp"]
@define chk_strncmp(a: string, b: string, n: ulong) <int>;

#[llvm_name="strlen"]
@define chk_raw_strlen(s: string) <ulong>;

priv fun chk_strlen(s: string) <ulong> {
    if (s == null) { return cast<ulong>(0); }
    return chk_raw_strlen(s);
}

#[llvm_name="strchr"]
@define chk_strchr(s: string, c: int) <string>;

#[llvm_name="dprintf"]
@define chk_dprintf(fd: int, fmt: string, ...) <int>;

priv fun chk_str_eq(a: string, b: string) <bool> {
    if (a == null && b == null) { return true; }
    if (a == null || b == null) { return false; }
    return chk_strcmp(a, b) == 0;
}

priv fun chk_str_starts_with(s: string, prefix: string) <bool> {
    if (s == null || prefix == null) { return false; }
    let plen <ulong> = chk_strlen(prefix);
    let slen <ulong> = chk_strlen(s);
    if (slen < plen) { return false; }
    return chk_strncmp(s, prefix, plen) == 0;
}

priv fun chk_str_contains(hay: string, needle: string) <bool> {
    if (hay == null || needle == null) { return false; }
    let hlen <int> = cast<int>(chk_strlen(hay));
    let nlen <int> = cast<int>(chk_strlen(needle));
    if (nlen == 0 || nlen > hlen) { return false; }
    let i <int> = 0;
    while (i + nlen <= hlen) {
        if (chk_str_eq(substr(hay, i, nlen), needle)) { return true; }
        i = i + 1;
    }
    return false;
}

priv fun chk_replace_dc_with_underscore(s: string) <string> {
    if (s == null) { return ""; }
    let len <int> = cast<int>(chk_strlen(s));
    let b <Buffer> = new_buffer(len + 2);
    let i <int> = 0;
    while (i < len) {
        if (i + 1 < len) {
            let pair <string> = substr(s, i, 2);
            if (chk_str_eq(pair, "::")) {
                b.write_char('_');
                i = i + 2;
                continue;
            }
        }
        b.write_string(substr(s, i, 1));
        i = i + 1;
    }
    let res <string> = b.to_string();
    free_buffer(b);
    return res;
}

priv fun chk_extract_after_dc(s: string) <string> {
    if (s == null) { return ""; }
    let len <int> = cast<int>(chk_strlen(s));
    let last_dc <int> = -1;
    let i <int> = 0;
    while (i + 1 < len) {
        let pair <string> = substr(s, i, 2);
        if (chk_str_eq(pair, "::")) {
            last_dc = i + 2;
        }
        i = i + 1;
    }
    if (last_dc >= 0 && last_dc < len) {
        return substr(s, last_dc, len - last_dc);
    }
    return s;
}

priv fun chk_extract_before_dc(s: string) <string> {
    if (s == null) { return ""; }
    let len <int> = cast<int>(chk_strlen(s));
    let i <int> = 0;
    while (i + 1 < len) {
        let pair <string> = substr(s, i, 2);
        if (chk_str_eq(pair, "::")) {
            return substr(s, 0, i);
        }
        i = i + 1;
    }
    return s;
}

priv fun chk_trim(s: string) <string> {
    if (s == null) { return ""; }
    let len <int> = cast<int>(chk_strlen(s));
    let start <int> = 0;
    while (start < len) {
        let ch <string> = substr(s, start, 1);
        if (chk_str_eq(ch, " ") || chk_str_eq(ch, "\t")) { start++; }
        else { break; }
    }
    let end <int> = len;
    while (end > start) {
        let ch <string> = substr(s, end - 1, 1);
        if (chk_str_eq(ch, " ") || chk_str_eq(ch, "\t")) { end--; }
        else { break; }
    }
    if (start >= end) { return ""; }
    return substr(s, start, end - start);
}

priv fun chk_strip_width(s: string) <string> {
    // Drops a `{N}` width annotation: widths are ignored by this check,
    // which only ever misses an error that way, never invents one.
    if (s == null) { return ""; }
    let w <string> = chk_strchr(s, 123);
    if (w == null) { return s; }
    let total <int> = cast<int>(chk_strlen(s));
    let wlen <int> = cast<int>(chk_strlen(w));
    if (wlen >= total) { return s; }
    return substr(s, 0, total - wlen);
}

priv fun chk_strip_parens(s: string) <string> {
    // Drops every `(` and `)` from a type spelling: parentheses group but
    // never change a type (`&(&int)` is `&&int`), so a mismatch is
    // re-asked without them before it reports, and never invents one.
    if (s == null) { return ""; }
    if (chk_strchr(s, 40) == null && chk_strchr(s, 41) == null) { return s; }
    let len <int> = cast<int>(chk_strlen(s));
    let b <Buffer> = new_buffer(len + 1);
    let i <int> = 0;
    while (i < len) {
        let ch <string> = substr(s, i, 1);
        if (!chk_str_eq(ch, "(") && !chk_str_eq(ch, ")")) { b.write_string(ch); }
        i = i + 1;
    }
    let res <string> = b.to_string();
    free_buffer(b);
    return res;
}

priv fun chk_int_bits(name: string) <int> {
    let b <string> = chk_strip_width(name);
    if (chk_str_eq(b, "char") || chk_str_eq(b, "u8") || chk_str_eq(b, "i8")) { return 8; }
    if (chk_str_eq(b, "short") || chk_str_eq(b, "ushort") ||
        chk_str_eq(b, "u16") || chk_str_eq(b, "i16")) { return 16; }
    if (chk_str_eq(b, "int") || chk_str_eq(b, "uint") ||
        chk_str_eq(b, "u32") || chk_str_eq(b, "i32")) { return 32; }
    if (chk_str_eq(b, "long") || chk_str_eq(b, "ulong") ||
        chk_str_eq(b, "u64") || chk_str_eq(b, "i64") ||
        chk_str_eq(b, "usize") || chk_str_eq(b, "isize") ||
        chk_str_eq(b, "size_t")) { return 64; }
    return -1;
}

priv fun chk_int_is_signed(name: string) <bool> {
    let b <string> = chk_strip_width(name);
    if (chk_str_eq(b, "uint") || chk_str_eq(b, "ushort") || chk_str_eq(b, "ulong") ||
        chk_str_eq(b, "u8") || chk_str_eq(b, "u16") || chk_str_eq(b, "u32") ||
        chk_str_eq(b, "u64") || chk_str_eq(b, "usize") || chk_str_eq(b, "size_t")) {
        return false;
    }
    return true;
}

// Greatest magnitude a target integer holds, as decimal text (C++
// constantFitsType: signed max 2^(b-1)-1, unsigned max 2^b-1; negated limit
// 2^(b-1) for a `-` over a literal). Text compare avoids any 64-bit overflow.
priv fun chk_int_max_text(bits: int, signed: bool, neg: bool) <string> {
    if (neg) {
        if (bits <= 8) { return "128"; }
        if (bits <= 16) { return "32768"; }
        if (bits <= 32) { return "2147483648"; }
        return "9223372036854775808";
    }
    if (!signed) {
        if (bits <= 8) { return "255"; }
        if (bits <= 16) { return "65535"; }
        if (bits <= 32) { return "4294967295"; }
        return "18446744073709551615";
    }
    if (bits <= 8) { return "127"; }
    if (bits <= 16) { return "32767"; }
    if (bits <= 32) { return "2147483647"; }
    return "9223372036854775807";
}

priv fun chk_strip_leading_zeros(s: string) <string> {
    if (s == null) { return "0"; }
    let len <int> = cast<int>(chk_strlen(s));
    let i <int> = 0;
    while (i < len) {
        if (!chk_str_eq(substr(s, i, 1), "0")) { break; }
        i = i + 1;
    }
    if (i >= len) { return "0"; }
    if (i == 0) { return s; }
    return substr(s, i, len - i);
}

priv fun chk_is_digits(s: string) <bool> {
    if (s == null || chk_strlen(s) == cast<ulong>(0)) { return false; }
    let len <int> = cast<int>(chk_strlen(s));
    let i <int> = 0;
    while (i < len) {
        let ch <string> = substr(s, i, 1);
        if (chk_strcmp(ch, "0") < 0 || chk_strcmp(ch, "9") > 0) { return false; }
        i = i + 1;
    }
    return true;
}

// True when the pure-digit run a exceeds b numerically: longer is larger,
// equal length compares lexicographically.
priv fun chk_digits_gt(a: string, b: string) <bool> {
    let x <string> = chk_strip_leading_zeros(a);
    let y <string> = chk_strip_leading_zeros(b);
    let xl <ulong> = chk_strlen(x);
    let yl <ulong> = chk_strlen(y);
    if (xl != yl) { return xl > yl; }
    return chk_strcmp(x, y) > 0;
}

// Numeric twin of the text compare in chk_big_const_verdict for literals
// the parser carries on int_val: str_val is only set for out-of-int-range
// spellings (parser.fin:437-442), so a narrow target like `char` never
// sees digits. Same C++ constantFitsType limits, answered on the value:
// 1 refuses like the text path.
priv fun chk_small_const_verdict(value: int, neg: bool, target: string, bits: int) <int> {
    if (neg) {
        if (!chk_int_is_signed(target)) { return 1; }
        if (bits <= 8 && value > 128) { return 1; }
        if (bits <= 16 && value > 32768) { return 1; }
        return 0;
    }
    if (value < 0 && !chk_int_is_signed(target)) { return 1; }
    if (!chk_int_is_signed(target)) {
        if (bits <= 8 && value > 255) { return 1; }
        if (bits <= 16 && value > 65535) { return 1; }
        return 0;
    }
    if (bits <= 8 && value > 127) { return 1; }
    if (bits <= 16 && value > 32767) { return 1; }
    return 0;
}

// True for the nodes chk_big_const_verdict reads a value from: a bare
// integer literal or `-` over one. Float literals share the int kind
// (parser.fin:431-436) but are not integer constants, so their
// annotation excludes them.
priv fun chk_is_int_const(node: &AstNode) <bool> {
    if (node == null) { return false; }
    if (node.kind == ast_literal_int() && !chk_str_eq(node.type_annotation, "float")) { return true; }
    if (node.kind == ast_unary_expr() && chk_str_eq(node.name, "-") && node.left != null) {
        return node.left.kind == ast_literal_int() && !chk_str_eq(node.left.type_annotation, "float");
    }
    return false;
}

// Verdict for a bare integer constant against a declared integer type: 0
// fits, 1 plain mismatch, 2 too large to represent (C++ checkType's ulong
// TooLarge message). Bare literals type as int; an out-of-int-range
// spelling (parser preserves it on str_val) is judged as text, smaller
// ones on int_val, which literals carry. A `-` over a literal is the
// negative constant (the lexer never produces a signed token); anything
// else is not a constant.
priv fun chk_big_const_verdict(node: &AstNode, target: string) <int> {
    let bits <int> = chk_int_bits(target);
    if (bits <= 0) { return 0; }
    let neg <bool> = false;
    let lit <&AstNode> = node;
    if (node != null && node.kind == ast_unary_expr() && chk_str_eq(node.name, "-")) {
        neg = true;
        lit = node.left;
    }
    if (lit == null || lit.kind != ast_literal_int()) { return 0; }
    if (!chk_is_digits(lit.str_val)) {
        return chk_small_const_verdict(lit.int_val, neg, target, bits);
    }
    let mag <string> = chk_strip_leading_zeros(lit.str_val);
    if (neg) {
        if (chk_int_is_signed(target)) {
            if (chk_digits_gt(mag, chk_int_max_text(bits, true, true))) { return 1; }
            return 0;
        }
        return 1;
    }
    if (!chk_int_is_signed(target) && bits >= 64 &&
        chk_digits_gt(mag, "18446744073709551615")) { return 2; }
    if (chk_digits_gt(mag, chk_int_max_text(bits, chk_int_is_signed(target), false))) { return 1; }
    return 0;
}

// Shift-count refusal (owner decision: refuse constants): a constant count
// must satisfy 0 <= count < bits of the shifted value's spelling
// (8->7, 16->15, 32->31, 64->63). Literal plus unary-minus, through
// `cast<T>(...)` layers (C++ peelShiftCount); variables stay UB
// (no diagnostic).
priv fun chk_shift_max(bits: int) <int> {
    if (bits <= 8) { return 7; }
    if (bits <= 16) { return 15; }
    if (bits <= 32) { return 31; }
    return 63;
}

priv fun chk_shift_count_bad(node: &AstNode, bits: int) <int> {
    if (bits <= 0) { return 0; }
    if (node == null) { return 0; }
    let cur <&AstNode> = node;
    while (cur != null && cur.kind == ast_unary_expr() && chk_str_eq(cur.name, "cast")) {
        if (cur.left == null) { break; }
        cur = cur.left;
    }
    if (cur == null) { return 0; }
    if (cur.kind == ast_unary_expr() && chk_str_eq(cur.name, "-")) {
        if (cur.left != null && cur.left.kind == ast_literal_int() && !chk_str_eq(cur.left.type_annotation, "float")) {
            return 1;
        }
        return 0;
    }
    if (cur.kind != ast_literal_int()) { return 0; }
    if (chk_str_eq(cur.type_annotation, "float")) { return 0; }
    let shift_lim <int> = chk_shift_max(bits);
    if (chk_is_digits(cur.str_val)) {
        let mag <string> = chk_strip_leading_zeros(cur.str_val);
        if (shift_lim <= 7) {
            if (chk_digits_gt(mag, "7")) { return 1; }
            return 0;
        }
        if (shift_lim <= 15) {
            if (chk_digits_gt(mag, "15")) { return 1; }
            return 0;
        }
        if (shift_lim <= 31) {
            if (chk_digits_gt(mag, "31")) { return 1; }
            return 0;
        }
        if (chk_digits_gt(mag, "63")) { return 1; }
        return 0;
    }
    if (cur.int_val < 0) { return 1; }
    if (cur.int_val > shift_lim) { return 1; }
    return 0;
}

// Count spelling for the shift diagnostic, mirroring C++ exactly:
// negatives use the signed value ("-1", "0" for "-0", "-1" when too large
// to represent); others use the magnitude ("7", not "007") or the original
// spelling when too large for a u64. Only called for refused constants.
priv fun chk_shift_text(node: &AstNode) <string> {
    if (node == null) { return "large"; }
    let cur <&AstNode> = node;
    while (cur != null && cur.kind == ast_unary_expr() && chk_str_eq(cur.name, "cast")) {
        if (cur.left == null) { break; }
        cur = cur.left;
    }
    if (cur == null) { return "large"; }
    if (cur.kind == ast_unary_expr() && chk_str_eq(cur.name, "-")) {
        let lit <&AstNode> = cur.left;
        if (lit == null || lit.kind != ast_literal_int()) { return "large"; }
        if (chk_is_digits(lit.str_val)) {
            let mag <string> = chk_strip_leading_zeros(lit.str_val);
            if (chk_str_eq(mag, "0")) { return "0"; }
            if (chk_digits_gt(mag, "9223372036854775808")) { return "-1"; }
            let b <Buffer> = new_buffer(24);
            b.write_char('-');
            b.write_string(mag);
            let res <string> = b.to_string();
            free_buffer(b);
            return res;
        }
        let b2 <Buffer> = new_buffer(16);
        b2.write_int(0 - lit.int_val);
        let res2 <string> = b2.to_string();
        free_buffer(b2);
        return res2;
    }
    if (cur.kind != ast_literal_int()) { return "large"; }
    if (chk_is_digits(cur.str_val)) {
        let mag2 <string> = chk_strip_leading_zeros(cur.str_val);
        if (chk_digits_gt(mag2, "18446744073709551615")) { return cur.str_val; }
        return mag2;
    }
    let b3 <Buffer> = new_buffer(16);
    b3.write_int(cur.int_val);
    let res3 <string> = b3.to_string();
    free_buffer(b3);
    return res3;
}

pub struct Checker {
    pub:
      global_scope <&Scope>,
      current_scope <&Scope>,
      diag <DiagnosticBag>,
      source_file <string> = "",
      had_error <bool> = false,
      current_ret_type <string> = "void",
      current_struct <string> = "",
      gen_scope_names <[string]>,
      gen_scope_params <[string]>,
      gen_count <int> = 0,
      // Arity registry: parallel arrays mapping a callee name to its
      // non-variadic parameter count (expected), its non-optional count
      // (required), and whether it is variadic. Populated in pass 1 for
      // top-level functions, struct methods (under both `S_m` and `S::m`),
      // and struct constructors (under the struct name; absent when the
      // arity is unknowable, e.g. inherited). First registration wins.
      // Bounded: 512 callees; beyond that new entries are dropped, which
      // only skips a check (a growable map is the upgrade path).
      arity_names <[string]>,
      arity_expected <[int]>,
      arity_required <[int]>,
      arity_variadic <[int]>,
      arity_count <int> = 0,
      // Parameter spellings for the call-arg narrowing check: parallel
      // to the arity registry; ptype_lists[i] is the comma-joined WRITTEN
      // parameter types for ptype_names[i], the `self` receiver and `...`
      // markers excluded exactly like arity excludes them. Same keys,
      // same first-wins, same 512 bound (dropped entries skip the check).
      ptype_names <[string]>,
      ptype_lists <[string]>,
      ptype_count <int> = 0,
      // Loop nesting depth for `break`/`continue` validation. Reset per
      // function like the C++ inLoop context.
      loop_depth <int> = 0,
      // Wave-4 compiler API: the current declaration's `#[use(...)]` grants
      // (`compiler` and component names), saved and restored per function
      // like the C++ analyzer's currentGrants.
      grants <[string]>,
      grant_count <int> = 0,
      // 1 inside a function or handler body (the enable call is top-level
      // only), 0 at top level.
      in_function <int> = 0,
      // 1 while checking a `@special` body: the backend resolves the
      // body but never return-checks it (a claim's shape is its own
      // lane), so value/empty `return` mismatches stay silent here.
      in_special_body <int> = 0,
      // 1 while a `compiler...` receiver is being read for its path string:
      // member access builds paths silently, the outermost call or read
      // owns the single diagnostic.
      quiet_compiler <int> = 0,
      // Provider claims, program-wide: one slot, one claimant (ADR 0014).
      // Bounded like the arity registry; beyond 8 slots new claims are
      // still checked, only exclusivity tracking stops.
      prov_slots <[string]>,
      prov_names <[string]>,
      prov_count <int> = 0,
      // Protocol claims, program-wide: one slot, one claimant (ADR 0014).
      // Mirrors the provider registry above; the first claim's line is kept
      // so a double claim can name both sites (file:line each). Bounded
      // like the provider registry; beyond 8 slots new claims are still
      // checked, only exclusivity tracking stops.
      proto_slots <[string]>,
      proto_names <[string]>,
      proto_lines <[int]>,
      proto_cols <[int]>,
      proto_count <int> = 0,
      // Event handlers collected in pass 1: `#[on(event)]` on a `@special`,
      // well-formed and known only (malformed ones are the attribute
      // diagnostic's, exactly once). The Arm phase reads this.
      handler_names <[string]>,
      handler_events <[string]>,
      handler_count <int> = 0,
      // Moved-state tracking (C++ MovedAnalysis): `@move(x)` marks x moved
      // for the rest of the function body; reading a definitely-moved
      // binding reports once; rebinding revives. Bounded like the arity
      // registry; beyond 64 names new marks are dropped, which only skips
      // a check. 1 while a plain assignment's target is being read for its
      // type: rebinding is not reading, so the use check suspends there.
      moved_names <[string]>,
      moved_count <int> = 0,
      moved_quiet <int> = 0,
      // 1 while re-evaluating an already-checked call node (a chained
      // receiver or re-walked argument is checked twice: receiver check
      // plus argument re-check). Entry #1 reported; entry #2 recomputes
      // the type quietly so one mistake stays one diagnostic, like C++.
      // Diagnostics funnel through report_error, which honors this.
      quiet_recheck <int> = 0,
      // 1 when the last call check_expression typed substituted its
      // generic return (a turbofish seed, receiver type arguments, or
      // argument bindings all count); reset on entry to every `let`
      // value. The `let` narrowing check below reads only this flag, so
      // values whose types no substitution produced keep exactly the
      // checking they always had.
      last_call_subst <int> = 0,
      // Host-branch warning (C++ warnOnHostBranch, Round 3 Q11): 1 while
      // checking a `@special` body that holds the system grant. Reading the
      // host is legal; branching on it warns. `host_taint_*` carries the
      // same-body `let`s bound to a host read, in order.
      host_warn <int> = 0,
      host_taint_names <[string]>,
      host_taint_ops <[string]>,
      host_taint_count <int> = 0,
      // FRONTEND WINS bare-method binding (FW2 I1/I2): methods of the
      // current struct seen so far in Pass 2 (declaration-ordered, self
      // included before its body), with static inferred from the written
      // self (`&Self` etc. is instance, injected `S*` is static). Bounded
      // 64; overflow drops (falls through to free, like other registries).
      bare_seen_shorts <[string]>,
      bare_seen_static <[int]>,
      bare_seen_count <int> = 0,
      current_method_short <string> = "",

    pub:
      fun report_error(self: &Self, msg: string, line: int, col: int) <noret> {
          // A re-evaluation never reports: entry #1 owned the diagnostic.
          if (self.quiet_recheck > 0) { return; }
          self.had_error = true;
          self.diag.add_error();
          let snip <string> = format_snippet(self.source_file, line, col, diag_error(), msg, "", 3);
          chk_dprintf(2, "%s", snip);
          free_diag_str(snip);
      }

      // A warning never fails the build (C++ warning/note): counted
      // apart from errors, printed the same way.
      fun report_warning(self: &Self, msg: string, line: int, col: int) <noret> {
          self.diag.add_warning();
          let snip <string> = format_snippet(self.source_file, line, col, diag_warning(), msg, "", 3);
          chk_dprintf(2, "%s", snip);
          free_diag_str(snip);
      }

      fun enter_scope(self: &Self) <noret> {
          self.current_scope = new_scope(self.current_scope);
      }

      fun exit_scope(self: &Self) <noret> {
          let old <&Scope> = self.current_scope;
          self.current_scope = old.parent;
          free_scope(old);
      }

      fun resolve_type(self: &Self, type_name: string) <string> {
          if (type_name == null) { return "void"; }
          let cur <string> = type_name;
          let depth <int> = 0;
          while (depth < 10 && cur != null && self.global_scope.has(cur)) {
              let sym <Symbol> = self.global_scope.lookup(cur);
              if (sym.kind == sym_type_alias() && sym.type_name != null && chk_strlen(sym.type_name) > cast<ulong>(0)) {
                  cur = sym.type_name;
                  depth++;
              } else {
                  break;
              }
          }
          return cur;
      }

      // ENGA slice 1: resolved spelling for a generic site (`Collection<A>`
      // with `type A = int` answers `Collection<int>`), mirroring C++
      // spellType/recordResolvedArgs (per-mangled-name instances key on the
      // resolved display, never the as-written alias). Beside
      // type_annotation rather than written into it (record-don't-replace):
      // diagnostics keep pointing at what was written. Markers (`&`, `*`,
      // `?`) survive around the resolved core; nested arguments resolve
      // recursively; bare parameters and unknown words stay as written
      // (exotic keeps the old path).
      fun chk_resolve_generic_spelling(self: &Self, spelling: string) <string> {
          if (spelling == null) { return ""; }
          let s <string> = chk_trim(spelling);
          if (chk_strlen(s) == cast<ulong>(0)) { return ""; }
          let slen <int> = cast<int>(chk_strlen(s));
          if (slen > 1 && chk_str_eq(substr(s, 0, 1), "&")) {
              let rest <string> = chk_trim(substr(s, 1, slen - 1));
              let rr <string> = self.chk_resolve_generic_spelling(rest);
              if (chk_str_eq(rr, "")) { return s; }
              let b <Buffer> = new_buffer(32);
              b.write_char('&');
              b.write_string(rr);
              let out <string> = b.to_string();
              free_buffer(b);
              return out;
          }
          if (slen > 1 && (chk_str_eq(substr(s, slen - 1, 1), "*") || chk_str_eq(substr(s, slen - 1, 1), "?"))) {
              let core <string> = chk_trim(substr(s, 0, slen - 1));
              let rc <string> = self.chk_resolve_generic_spelling(core);
              if (chk_str_eq(rc, "")) { return s; }
              let b2 <Buffer> = new_buffer(32);
              b2.write_string(rc);
              b2.write_string(substr(s, slen - 1, 1));
              let out2 <string> = b2.to_string();
              free_buffer(b2);
              return out2;
          }
          let open_at <int> = -1;
          let oi <int> = 0;
          while (oi < slen) {
              if (chk_str_eq(substr(s, oi, 1), "<")) { open_at = oi; break; }
              oi = oi + 1;
          }
          if (open_at <= 0) { return self.resolve_type(s); }
          let close_at <int> = -1;
          let cj <int> = slen - 1;
          while (cj > open_at) {
              if (chk_str_eq(substr(s, cj, 1), ">")) { close_at = cj; break; }
              cj = cj - 1;
          }
          if (close_at < 0) { return self.resolve_type(s); }
          let base <string> = chk_trim(substr(s, 0, open_at));
          let inner <string> = substr(s, open_at + 1, close_at - open_at - 1);
          let segs <[string]> = new [string, 64]{};
          let sc <int> = self.split_generic_segs(inner, segs);
          let ob <Buffer> = new_buffer(64);
          ob.write_string(base);
          ob.write_char('<');
          let si <int> = 0;
          while (si < sc) {
              if (si > 0) { ob.write_string(", "); }
              let seg <string> = chk_trim(segs[si]);
              let rs <string> = self.chk_resolve_generic_spelling(seg);
              if (chk_str_eq(rs, "")) { rs = seg; }
              ob.write_string(rs);
              si = si + 1;
          }
          ob.write_char('>');
          let suffix <string> = "";
          if (close_at + 1 < slen) { suffix = substr(s, close_at + 1, slen - close_at - 1); }
          ob.write_string(suffix);
          let full <string> = ob.to_string();
          free_buffer(ob);
          delete segs;
          return full;
      }

      fun check_return_paths(self: &Self, node: &AstNode) <bool> {
          if (node == null) { return false; }
          if (node.kind == ast_return_stmt() || node.kind == ast_blame_stmt()) {
              return true;
          }
          if (node.kind == ast_block()) {
              let cur <&AstNode> = node.left;
              while (cur != null) {
                  let stmt <&AstNode> = cur.left;
                  if (stmt == null) { stmt = cur; }
                  if (self.check_return_paths(stmt)) {
                      return true;
                  }
                  cur = cur.right;
              }
              return false;
          }
          if (node.kind == ast_if_stmt()) {
              if (node.extra != null) {
                  let then_ret <bool> = self.check_return_paths(node.right);
                  let else_ret <bool> = self.check_return_paths(node.extra);
                  return then_ret && else_ret;
              }
              return false;
          }
          return false;
      }

      // Counts the declared parameters of a function node (fn_node.extra chain).
      fun count_fn_params(self: &Self, fn_node: &AstNode) <int> {
          if (fn_node == null) { return 0; }
          let n <int> = 0;
          let p <&AstNode> = fn_node.extra;
          while (p != null) {
              n = n + 1;
              p = p.right;
          }
          return n;
      }

      // True when a parameter is a variadic marker: `...` (extern form) or
      // `...name` (parse_function form).
      fun param_is_variadic(self: &Self, p: &AstNode) <bool> {
          if (p == null || p.name == null) { return false; }
          return chk_str_starts_with(p.name, "...");
      }

      // Parameters the C++ signature counts: everything but `...` markers.
      fun count_fn_expected(self: &Self, fn_node: &AstNode) <int> {
          if (fn_node == null) { return 0; }
          let n <int> = 0;
          let p <&AstNode> = fn_node.extra;
          while (p != null) {
              if (!self.param_is_variadic(p)) { n = n + 1; }
              p = p.right;
          }
          return n;
      }

      // Parameters the caller must write: non-variadic and non-nullable
      // (`n?: int` is optional at the call site, nullifier.fin:2).
      // Defaulted parameters (`= v`) are not visible here — the parser
      // discards the default — so a defaulted non-nullable parameter counts
      // as required; omitting one is a separate hole.
      fun count_fn_required(self: &Self, fn_node: &AstNode) <int> {
          if (fn_node == null) { return 0; }
          let n <int> = 0;
          let p <&AstNode> = fn_node.extra;
          while (p != null) {
              if (!self.param_is_variadic(p)) {
                  if (p.type_annotation == null || chk_strchr(p.type_annotation, 63) == null) {
                      n = n + 1;
                  }
              }
              p = p.right;
          }
          return n;
      }

      // True when the function is variadic anywhere in its parameter list.
      fun fn_is_variadic(self: &Self, fn_node: &AstNode) <bool> {
          if (fn_node == null) { return false; }
          let p <&AstNode> = fn_node.extra;
          while (p != null) {
              if (self.param_is_variadic(p)) { return true; }
              p = p.right;
          }
          return false;
      }

      // True when the first declared parameter is the receiver. Method calls
      // pass the receiver implicitly, so it is not counted as written.
      fun first_param_is_self(self: &Self, fn_node: &AstNode) <bool> {
          if (fn_node == null || fn_node.extra == null) { return false; }
          return chk_str_eq(fn_node.extra.name, "self");
      }

      // True when the name is a flattened `Target_method` whose prefix
      // names a declared struct (`MyStruct_get_val`). The parser flattens
      // implements-block methods to top level, but the receiver is still
      // implicit at method call sites, so arity must exclude `self`
      // exactly like a struct-body method's does. A free function keeps
      // its full count: only a struct prefix qualifies.
      fun fn_has_struct_prefix(self: &Self, name: string) <bool> {
          if (name == null) { return false; }
          let len <int> = cast<int>(chk_strlen(name));
          let i <int> = 0;
          while (i < len) {
              if (chk_str_eq(substr(name, i, 1), "_")) { break; }
              i = i + 1;
          }
          if (i <= 0 || i >= len) { return false; }
          let prefix <string> = substr(name, 0, i);
          if (!self.global_scope.has(prefix)) { return false; }
          let sym <Symbol> = self.global_scope.lookup(prefix);
          return sym.kind == sym_struct();
      }

      fun record_arity(self: &Self, name: string, expected: int, required: int, variadic: int) <noret> {
          if (name == null || chk_strlen(name) == cast<ulong>(0)) { return; }
          if (self.arity_names == null) {
              self.arity_names = new [string, 512]{};
              self.arity_expected = new [int, 512]{};
              self.arity_required = new [int, 512]{};
              self.arity_variadic = new [int, 512]{};
              self.arity_count = 0;
          }
          if (self.arity_count >= 512) { return; }
          let i <int> = 0;
          while (i < self.arity_count) {
              if (chk_str_eq(self.arity_names[i], name)) { return; }
              i = i + 1;
          }
          self.arity_names[self.arity_count] = name;
          self.arity_expected[self.arity_count] = expected;
          self.arity_required[self.arity_count] = required;
          self.arity_variadic[self.arity_count] = variadic;
          self.arity_count = self.arity_count + 1;
      }

      fun find_arity(self: &Self, name: string) <int> {
          if (name == null || self.arity_names == null) { return -1; }
          let i <int> = 0;
          while (i < self.arity_count) {
              if (chk_str_eq(self.arity_names[i], name)) { return i; }
              i = i + 1;
          }
          return -1;
      }

      // Joins the written parameter spellings of fn_node with `,` (the
      // receiver dropped when skip_self, `...` markers always dropped, so
      // the segments line up with the arity registry's expected count).
      // split_generic_segs undoes the join at the call site; spellings
      // with no spaces keep every segment aligned.
      fun build_ptype_list(self: &Self, fn_node: &AstNode, skip_self: bool) <string> {
          let b <Buffer> = new_buffer(64);
          let first <bool> = true;
          let drop <bool> = skip_self && self.first_param_is_self(fn_node);
          let idx <int> = 0;
          let p <&AstNode> = null;
          if (fn_node != null) { p = fn_node.extra; }
          while (p != null) {
              if (!drop || idx != 0) {
                  if (!self.param_is_variadic(p)) {
                      if (!first) { b.write_char(','); }
                      if (p.type_annotation != null) { b.write_string(p.type_annotation); }
                      first = false;
                  }
              }
              idx = idx + 1;
              p = p.right;
          }
          let res <string> = b.to_string();
          free_buffer(b);
          return res;
      }

      fun record_ptypes(self: &Self, name: string, fn_node: &AstNode, skip_self: bool) <noret> {
          if (name == null || chk_strlen(name) == cast<ulong>(0)) { return; }
          if (fn_node == null) { return; }
          if (self.ptype_names == null) {
              self.ptype_names = new [string, 512]{};
              self.ptype_lists = new [string, 512]{};
              self.ptype_count = 0;
          }
          if (self.ptype_count >= 512) { return; }
          let i <int> = 0;
          while (i < self.ptype_count) {
              if (chk_str_eq(self.ptype_names[i], name)) { return; }
              i = i + 1;
          }
          self.ptype_names[self.ptype_count] = name;
          self.ptype_lists[self.ptype_count] = self.build_ptype_list(fn_node, skip_self);
          self.ptype_count = self.ptype_count + 1;
      }

      fun find_ptype(self: &Self, name: string) <int> {
          if (name == null || self.ptype_names == null) { return -1; }
          let i <int> = 0;
          while (i < self.ptype_count) {
              if (chk_str_eq(self.ptype_names[i], name)) { return i; }
              i = i + 1;
          }
          return -1;
      }

      // Moved-state helpers (C++ MovedAnalysis, straight-line core with
      // branch joins). Joins keep the intersection -- moved on every path --
      // so a maybe-moved binding stays readable, exactly like the C++ join.
      fun moved_has(self: &Self, name: string) <bool> {
          if (name == null) { return false; }
          let i <int> = 0;
          while (i < self.moved_count) {
              if (chk_str_eq(self.moved_names[i], name)) { return true; }
              i = i + 1;
          }
          return false;
      }
      fun moved_mark(self: &Self, name: string) <noret> {
          if (name == null || self.moved_names == null) { return; }
          if (self.moved_has(name)) { return; }
          if (self.moved_count < 64) {
              self.moved_names[self.moved_count] = name;
              self.moved_count = self.moved_count + 1;
          }
      }
      fun moved_revive(self: &Self, name: string) <noret> {
          if (name == null) { return; }
          let i <int> = 0;
          while (i < self.moved_count) {
              if (chk_str_eq(self.moved_names[i], name)) {
                  let j <int> = i;
                  while (j + 1 < self.moved_count) {
                      self.moved_names[j] = self.moved_names[j + 1];
                      j = j + 1;
                  }
                  self.moved_count = self.moved_count - 1;
                  return;
              }
              i = i + 1;
          }
      }
      fun moved_snapshot(self: &Self, snap: [string]) <int> {
          if (snap == null) { return 0; }
          let i <int> = 0;
          while (i < self.moved_count && i < 64) {
              snap[i] = self.moved_names[i];
              i = i + 1;
          }
          return self.moved_count;
      }
      fun moved_restore(self: &Self, snap: [string], n: int) <noret> {
          if (snap == null) { self.moved_count = 0; return; }
          let i <int> = 0;
          while (i < n && i < 64) {
              self.moved_names[i] = snap[i];
              i = i + 1;
          }
          self.moved_count = i;
      }
      // Drop every moved name absent from the snapshot (the join for a path
      // that may not run: the condition arm, the missing else, the loop
      // body). Names present on both sides stay moved.
      fun moved_intersect(self: &Self, snap: [string], n: int) <noret> {
          if (snap == null) { self.moved_count = 0; return; }
          let i <int> = 0;
          while (i < self.moved_count) {
              let keep <bool> = false;
              let j <int> = 0;
              while (j < n) {
                  if (chk_str_eq(self.moved_names[i], snap[j])) { keep = true; }
                  j = j + 1;
              }
              if (!keep) {
                  let k <int> = i;
                  while (k + 1 < self.moved_count) {
                      self.moved_names[k] = self.moved_names[k + 1];
                      k = k + 1;
                  }
                  self.moved_count = self.moved_count - 1;
              } else {
                  i = i + 1;
              }
          }
      }

      // A host read: the machine doing the compiling, not the target
      // (C++ isHostReadOp). Target facts (`pointer_size`, `target_triple`)
      // are never host reads, however they are branched on.
      fun host_is_host_op(self: &Self, name: string) <bool> {
          if (chk_str_eq(name, "get_total_memory")) { return true; }
          if (chk_str_eq(name, "get_available_memory")) { return true; }
          if (chk_str_eq(name, "get_memorycard_model")) { return true; }
          return false;
      }
      fun host_taint(self: &Self, name: string, op: string) <noret> {
          if (name == null || op == null) { return; }
          if (self.host_taint_names == null || self.host_taint_ops == null) { return; }
          if (self.host_taint_count < 64) {
              self.host_taint_names[self.host_taint_count] = name;
              self.host_taint_ops[self.host_taint_count] = op;
              self.host_taint_count = self.host_taint_count + 1;
          }
      }
      fun host_tainted_op(self: &Self, name: string) <string> {
          if (name == null) { return ""; }
          let i <int> = 0;
          while (i < self.host_taint_count) {
              if (chk_str_eq(self.host_taint_names[i], name)) { return self.host_taint_ops[i]; }
              i = i + 1;
          }
          return "";
      }
      // The first host read in a subtree, by source order (C++
      // HostReadFinder): `compiler.system.get_*(...)`, or a binding tainted
      // by one. Quote bodies are runtime code, not compile-time reads, so a
      // host spelling inside one is never a warning (C++ HostBranchWalk).
      fun host_find(self: &Self, node: &AstNode) <string> {
          if (node == null) { return ""; }
          if (node.kind == ast_quote_expr()) { return ""; }
          if (node.kind == ast_call_expr()) {
              if (node.name != null && self.host_is_host_op(node.name)) {
                  let w <&AstNode> = node.left;
                  if (w != null) {
                      let r <&AstNode> = w.left;
                      if (r == null) { r = w; }
                      if (r.kind == ast_member_access() && chk_str_eq(r.name, "system") &&
                          r.left != null && r.left.kind == ast_ident() && chk_str_eq(r.left.name, "compiler")) {
                          let ob <Buffer> = new_buffer(64);
                          ob.write_string("compiler.system.");
                          ob.write_string(node.name);
                          let os <string> = ob.to_string();
                          free_buffer(ob);
                          return os;
                      }
                  }
              }
          }
          if (node.kind == ast_ident()) {
              if (node.name != null) {
                  let top <string> = self.host_tainted_op(node.name);
                  if (!chk_str_eq(top, "")) { return top; }
              }
          }
          let f <string> = self.host_find(node.left);
          if (!chk_str_eq(f, "")) { return f; }
          let g <string> = self.host_find(node.right);
          if (!chk_str_eq(g, "")) { return g; }
          return self.host_find(node.extra);
      }
      // One branch condition: warn naming the host operation it came from.
      // Reading without branching stays silent; so does every check outside
      // a system-granted `@special` body.
      fun host_warn_cond(self: &Self, cond: &AstNode) <noret> {
          if (self.host_warn == 0 || cond == null) { return; }
          let op <string> = self.host_find(cond);
          if (chk_str_eq(op, "")) { return; }
          let wb <Buffer> = new_buffer(128);
          wb.write_string("branching on '");
          wb.write_string(op);
          wb.write_string("' makes the compiled program depend on the machine that builds it (docs/compiler-api.md Q11: reading the host is legal, branching on it is warned; ADR 0017)");
          self.report_warning(wb.to_string(), cond.line, cond.col);
          free_buffer(wb);
      }

      // Counts written call arguments (the wrapper chain off call.left).
      // skip_first drops the receiver wrapper of a dot-call.
      fun count_call_args(self: &Self, arg_head: &AstNode, skip_first: bool) <int> {
          let n <int> = 0;
          let a <&AstNode> = arg_head;
          let first <bool> = true;
          while (a != null) {
              if (!(skip_first && first)) { n = n + 1; }
              first = false;
              a = a.right;
          }
          return n;
      }

      // Strips one pointer marker (`&T` -> `T`, `T*` -> `T`); otherwise
    // identity. C++ PointerType::equals answers the same question on the
    // type graph, so the string check must not split `&T` from `T*`.
    fun chk_strip_ptr(self: &Self, s: string) <string> {
        if (s == null) { return ""; }
        let len <int> = cast<int>(chk_strlen(s));
        if (len > 1 && chk_str_eq(substr(s, 0, 1), "&")) {
            return substr(s, 1, len - 1);
        }
        if (len > 1 && chk_str_eq(substr(s, len - 1, 1), "*")) {
            return substr(s, 0, len - 1);
        }
        return s;
    }

    // True for bracketed array spellings (`[T]`, `[T,N]`).
    fun chk_is_arr(self: &Self, s: string) <bool> {
        if (s == null) { return false; }
        let len <int> = cast<int>(chk_strlen(s));
        if (len < 3) { return false; }
        if (!chk_str_eq(substr(s, 0, 1), "[")) { return false; }
        if (!chk_str_eq(substr(s, len - 1, 1), "]")) { return false; }
        return true;
    }

    // Element spelling of a bracketed array (`[&T]` -> `&T`, `[T,4]` -> `T`).
    // Type strings carry no spaces, so the first comma ends the element.
    fun chk_arr_elem(self: &Self, s: string) <string> {
        let len <int> = cast<int>(chk_strlen(s));
        let inner <string> = substr(s, 1, len - 2);
        let ilen <int> = cast<int>(chk_strlen(inner));
        let i <int> = 0;
        while (i < ilen) {
            if (chk_str_eq(substr(inner, i, 1), ",")) {
                return substr(inner, 0, i);
            }
            i = i + 1;
        }
        return inner;
    }

    // Pointer-like spellings: `&T`, `T*`, `void*`. C++ PointerType answers
    // the word-size question once, so every pointer spelling converts the
    // same; `void*` in either direction is covered by the caller.
    fun chk_is_ptr_like(self: &Self, s: string) <bool> {
        if (s == null) { return false; }
        let len <int> = cast<int>(chk_strlen(s));
        if (len < 2) { return false; }
        if (chk_str_eq(substr(s, 0, 1), "&")) { return true; }
        if (chk_str_eq(substr(s, len - 1, 1), "*")) { return true; }
        return false;
    }

    // True when the spelling may be the struct side of `@implements`: a
    // `$struct` (or widened `$type`) meta-type, or a declared struct's name
    // (C++ accepts a StructType and $struct/$type). Generic arguments are
    // erased before the lookup, like everywhere else here.
    fun chk_is_struct_arg(self: &Self, t: string) <bool> {
        if (t == null) { return false; }
        if (chk_str_eq(t, "$struct") || chk_str_eq(t, "$type")) { return true; }
        let b <string> = self.chk_generic_base(t);
        if (self.global_scope.has(b)) {
            return self.global_scope.lookup(b).kind == sym_struct();
        }
        return false;
    }
    fun chk_is_iface_arg(self: &Self, t: string) <bool> {
        if (t == null) { return false; }
        if (chk_str_eq(t, "$interface") || chk_str_eq(t, "$type")) { return true; }
        let b <string> = self.chk_generic_base(t);
        if (self.global_scope.has(b)) {
            return self.global_scope.lookup(b).kind == sym_interface();
        }
        return false;
    }

    // Base name with one pointer marker and any generic arguments
    // removed (`&Collection<T>` -> `Collection`). The parser drops `<>`
    // text it does not model yet, so a bare `Collection` is the same
    // declaration with erased arguments, not a different type.
    fun chk_generic_base(self: &Self, s: string) <string> {
        let t <string> = self.chk_strip_ptr(s);
        let len <int> = cast<int>(chk_strlen(t));
        let i <int> = 0;
        while (i < len) {
            if (chk_str_eq(substr(t, i, 1), "<")) {
                return substr(t, 0, i);
            }
            i = i + 1;
        }
        return t;
    }

    // True when the spelling carries generic arguments (`C<...>`).
    fun chk_has_generic_args(self: &Self, s: string) <bool> {
        if (s == null) { return false; }
        let len <int> = cast<int>(chk_strlen(s));
        let i <int> = 0;
        while (i < len) {
            if (chk_str_eq(substr(s, i, 1), "<")) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Looks up `member` on `base`'s parents (`struct S : <P>` stores the
    // heritage string on the struct decl's str_val, parser.fin:2104).
    // Non-struct words (attribute text reuses str_val when heritage is
    // empty) resolve to nothing, so this can only find real members,
    // never invent them. Depth-capped: cyclic heritage stops, it does
    // not recurse forever. A `priv` parent member is enforced against the
    // outermost receiver (`outer`, the static type the access resolved
    // against), naming it like C++. Returns "" when nothing is found.
    fun find_inherited_member_type(self: &Self, base: string, member: string, outer: string, depth: int, line: int, col: int) <string> {
        if (base == null || member == null) { return ""; }
        if (depth > 8) { return ""; }
        let pb <Buffer> = new_buffer(64);
        pb.write_string(base);
        pb.write_string("_parents");
        let pkey <string> = pb.to_string();
        free_buffer(pb);
        if (!self.global_scope.has(pkey)) { return ""; }
        let psym <Symbol> = self.global_scope.lookup(pkey);
        let plist <string> = psym.type_name;
        if (plist == null) { return ""; }
        let plen <int> = cast<int>(chk_strlen(plist));
        let pchars <[char]> = to_chars(plist);
        let wi <int> = 0;
        while (wi < plen) {
            // Skip non-identifier characters (brackets, commas, spaces).
            let wc <char> = pchars[wi];
            if ((wc >= 'a' && wc <= 'z') || (wc >= 'A' && wc <= 'Z') || wc == '_') {
                let wstart <int> = wi;
                while (wi < plen) {
                    let wc2 <char> = pchars[wi];
                    if ((wc2 >= 'a' && wc2 <= 'z') || (wc2 >= 'A' && wc2 <= 'Z') ||
                        (wc2 >= '0' && wc2 <= '9') || wc2 == '_') {
                        wi = wi + 1;
                    } else {
                        break;
                    }
                }
                let parent <string> = substr(plist, wstart, wi - wstart);
                if (self.global_scope.has(parent)) {
                    let ps <Symbol> = self.global_scope.lookup(parent);
                    if (ps.kind == sym_struct()) {
                        let qb <Buffer> = new_buffer(64);
                        qb.write_string(parent);
                        qb.write_char('_');
                        qb.write_string(member);
                        let qn <string> = qb.to_string();
                        free_buffer(qb);
                        if (self.global_scope.has(qn)) {
                            let fsym <Symbol> = self.global_scope.lookup(qn);
                            self.check_priv_member(qn, line, col, 0, outer);
                            delete pchars;
                            return fsym.type_name;
                        }
                        let deeper <string> = self.find_inherited_member_type(parent, member, outer, depth + 1, line, col);
                        if (!chk_str_eq(deeper, "")) {
                            delete pchars;
                            return deeper;
                        }
                    }
                }
            } else {
                wi = wi + 1;
            }
        }
        delete pchars;
        return "";
    }

    // Qualified name of an inherited method (`Parent_m`), walking the
    // `<Base>_parents` heritage like C++ getMethodType, or "" when no
    // parent declares it. Resolution only: visibility is enforced by the
    // caller against the receiver, naming the receiver like C++.
    fun find_inherited_method(self: &Self, base: string, member: string, depth: int) <string> {
        if (base == null || member == null) { return ""; }
        if (depth > 8) { return ""; }
        let pb <Buffer> = new_buffer(64);
        pb.write_string(base);
        pb.write_string("_parents");
        let pkey <string> = pb.to_string();
        free_buffer(pb);
        if (!self.global_scope.has(pkey)) { return ""; }
        let psym <Symbol> = self.global_scope.lookup(pkey);
        let plist <string> = psym.type_name;
        if (plist == null) { return ""; }
        let plen <int> = cast<int>(chk_strlen(plist));
        let pchars <[char]> = to_chars(plist);
        let wi <int> = 0;
        while (wi < plen) {
            let wc <char> = pchars[wi];
            if ((wc >= 'a' && wc <= 'z') || (wc >= 'A' && wc <= 'Z') || wc == '_') {
                let wstart <int> = wi;
                while (wi < plen) {
                    let wc2 <char> = pchars[wi];
                    if ((wc2 >= 'a' && wc2 <= 'z') || (wc2 >= 'A' && wc2 <= 'Z') ||
                        (wc2 >= '0' && wc2 <= '9') || wc2 == '_') {
                        wi = wi + 1;
                    } else {
                        break;
                    }
                }
                let parent <string> = substr(plist, wstart, wi - wstart);
                if (self.global_scope.has(parent)) {
                    let ps <Symbol> = self.global_scope.lookup(parent);
                    if (ps.kind == sym_struct()) {
                        let qb <Buffer> = new_buffer(64);
                        qb.write_string(parent);
                        qb.write_char('_');
                        qb.write_string(member);
                        let qn <string> = qb.to_string();
                        free_buffer(qb);
                        if (self.global_scope.has(qn)) {
                            delete pchars;
                            return qn;
                        }
                        let deeper <string> = self.find_inherited_method(parent, member, depth + 1);
                        if (!chk_str_eq(deeper, "")) {
                            delete pchars;
                            return deeper;
                        }
                    }
                }
            } else {
                wi = wi + 1;
            }
        }
        delete pchars;
        return "";
    }

    // True when the call's first argument wrapper holds the `self`
    // receiver ident. `super::<T>::m(...)` parses with the receiver as an
    // explicit first argument (parser.fin:696-698), so the call needs
    // method treatment (receiver skipped) even though its flattened
    // `Target_method` name carries no dot.
    fun first_call_arg_is_self_recv(self: &Self, fn_node: &AstNode) <bool> {
        if (fn_node == null || fn_node.left == null) { return false; }
        let head <&AstNode> = fn_node.left;
        let first <&AstNode> = head.left;
        if (first == null) { first = head; }
        if (first.kind != ast_ident()) { return false; }
        if (first.name == null) { return false; }
        return chk_str_eq(first.name, "self");
    }

    // True when the spelling names a type the checker can see: a builtin
    // keyword, a declared struct/enum/interface/alias, or any complex
    // spelling (generic applications, pointers, arrays — those keep their
    // current behavior). A bare unknown word is an unbound generic
    // parameter (`T` on a `Map_get` sym reached without substitution);
    // callers use this to answer `auto` (unknown, compatible) instead of
    // reporting a mismatch the C++ frontend would not.
    fun chk_is_known_type_name(self: &Self, w: string) <bool> {
        if (w == null) { return true; }
        if (chk_strlen(w) == cast<ulong>(0)) { return true; }
        if (chk_strchr(w, 60) != null || chk_strchr(w, 62) != null ||
            chk_strchr(w, 91) != null || chk_strchr(w, 93) != null ||
            chk_strchr(w, 38) != null || chk_strchr(w, 42) != null ||
            chk_strchr(w, 63) != null || chk_strchr(w, 58) != null ||
            chk_strchr(w, 40) != null || chk_strchr(w, 36) != null) {
            return true;
        }
        let pn <[string]> = new [string, 1]{};
        let known <bool> = self.is_bound_name_known(w, pn, 0);
        delete pn;
        return known;
    }

    // Pointer depth: leading `&` plus trailing `*` (`&&&int` and
    // `int***` are both depth 3; C++ PointerType nests the same way).
    fun chk_ptr_depth(self: &Self, s: string) <int> {
        if (s == null) { return 0; }
        let len <int> = cast<int>(chk_strlen(s));
        let d <int> = 0;
        let i <int> = 0;
        while (i < len) {
            if (chk_str_eq(substr(s, i, 1), "&")) {
                d = d + 1;
                i = i + 1;
            } else {
                break;
            }
        }
        let j <int> = len - 1;
        while (j >= i) {
            if (chk_str_eq(substr(s, j, 1), "*")) {
                d = d + 1;
                j = j - 1;
            } else {
                break;
            }
        }
        return d;
    }

    // Base with all pointer markers removed (`&&&int` -> `int`).
    fun chk_ptr_base(self: &Self, s: string) <string> {
        if (s == null) { return ""; }
        let len <int> = cast<int>(chk_strlen(s));
        let i <int> = 0;
        while (i < len) {
            if (chk_str_eq(substr(s, i, 1), "&")) { i = i + 1; } else { break; }
        }
        let j <int> = len - 1;
        while (j >= i) {
            if (chk_str_eq(substr(s, j, 1), "*")) { j = j - 1; } else { break; }
        }
        if (j < i) { return ""; }
        return substr(s, i, j - i + 1);
    }

    // The struct prefix of a flattened `Target_method` name (`Acc_add`
    // -> `Acc`), or "" when there is none. Companion to
    // fn_has_struct_prefix, which answers the boolean tightly.
    fun struct_prefix_of(self: &Self, name: string) <string> {
        if (name == null) { return ""; }
        let len <int> = cast<int>(chk_strlen(name));
        let i <int> = 0;
        while (i < len) {
            if (chk_str_eq(substr(name, i, 1), "_")) { break; }
            i = i + 1;
        }
        if (i <= 0 || i >= len) { return ""; }
        let prefix <string> = substr(name, 0, i);
        if (!self.global_scope.has(prefix)) { return ""; }
        let sym <Symbol> = self.global_scope.lookup(prefix);
        if (sym.kind != sym_struct()) { return ""; }
        return prefix;
    }

    // The method short name after the prefix (`Acc_add` -> `add`).
    fun strip_struct_prefix(self: &Self, name: string) <string> {
        let prefix <string> = self.struct_prefix_of(name);
        if (chk_str_eq(prefix, "")) { return ""; }
        let len <int> = cast<int>(chk_strlen(name));
        let plen <int> = cast<int>(chk_strlen(prefix));
        if (plen + 1 >= len) { return ""; }
        return substr(name, plen + 1, len - plen - 1);
    }

    // True when the call's first argument is an identifier whose declared
    // type is the named struct (pointer markers and generic arguments
    // ignored): the value a dot-call receiver carries. Used to recognize
    // method-shaped calls that lost their dot: re-evaluated dot-calls
    // (the `Base_method` rewrite persists on the AST, so the receiver
    // block is skipped on re-entry) alongside `super::<T>::m()`.
    fun first_arg_is_prefix_typed_recv(self: &Self, fn_node: &AstNode, prefix: string) <bool> {
        if (fn_node == null || fn_node.left == null) { return false; }
        if (chk_str_eq(prefix, "")) { return false; }
        let head <&AstNode> = fn_node.left;
        let first <&AstNode> = head.left;
        if (first == null) { first = head; }
        if (first.kind != ast_ident()) { return false; }
        if (first.name == null) { return false; }
        if (!self.current_scope.has(first.name)) { return false; }
        let vsym <Symbol> = self.current_scope.lookup(first.name);
        let tbase <string> = self.chk_generic_base(self.chk_ptr_base(vsym.type_name));
        return chk_str_eq(tbase, prefix);
    }

    // Enforces member visibility (C++ Analyzer_Expr member/method
    // rules): a `priv` struct member is usable only from inside the
    // RECEIVER struct. `qname` is the resolved member symbol (`S_m`,
    // `S_f`, `S::f`); `recv_base` is the static receiver type the access
    // resolved against ("" where none was computed: super/static calls,
    // whose receiver IS the qualifier). Anything without a
    // declared-struct prefix passes through (free functions, locals,
    // builtins). Returns false after reporting
    // `Cannot access private ...`, naming the receiver like C++.
    fun check_priv_member(self: &Self, qname: string, line: int, col: int, is_method: int, recv_base: string) <bool> {
        if (qname == null) { return true; }
        let qlen <int> = cast<int>(chk_strlen(qname));
        let si <int> = 0;
        while (si < qlen) {
            let c <string> = substr(qname, si, 1);
            if (chk_str_eq(c, "_")) { break; }
            if (chk_str_eq(c, ":") && si + 1 < qlen && chk_str_eq(substr(qname, si + 1, 1), ":")) { break; }
            si = si + 1;
        }
        if (si <= 0 || si >= qlen) { return true; }
        let prefix <string> = substr(qname, 0, si);
        if (!self.global_scope.has(prefix)) { return true; }
        let psym <Symbol> = self.global_scope.lookup(prefix);
        if (psym.kind != sym_struct()) { return true; }
        if (!self.global_scope.has(qname)) { return true; }
        let msym <Symbol> = self.global_scope.lookup(qname);
        if (msym.is_pub) { return true; }
        // C++ names and gates on the receiver type (getStructType of the
        // object): an inherited `priv` member reached through a child is
        // `... of struct '<child>'`, allowed only from inside the child —
        // even from inside the declaring parent.
        let recv <string> = prefix;
        if (recv_base != null && chk_strlen(recv_base) > cast<ulong>(0)) { recv = recv_base; }
        if (chk_str_eq(self.current_struct, recv)) { return true; }
        let short_start <int> = si + 1;
        if (chk_str_eq(substr(qname, si, 1), ":")) { short_start = si + 2; }
        let short_nm <string> = substr(qname, short_start, qlen - short_start);
        let kind_w <string> = "field";
        if (is_method == 1) { kind_w = "method"; }
        let b <Buffer> = new_buffer(96);
        b.write_string("Cannot access private ");
        b.write_string(kind_w);
        b.write_string(" '");
        b.write_string(short_nm);
        b.write_string("' of struct '");
        b.write_string(recv);
        b.write_string("'");
        self.report_error(b.to_string(), line, col);
        free_buffer(b);
        return false;
    }

    // Pure method probe (no evaluation): true when a dot-call-shaped
    // callee would resolve to a struct method. A call node no longer
    // records whether it was written with a dot (`b.m(x)` and `m(b, x)`
    // share one shape), so a bare name in scope — e.g. a free function
    // imported beside a same-named method — would otherwise shadow the
    // method: the receiver is then checked as an argument AND codegen
    // lowers the wrong callee. When the receiver's static base names a
    // declared struct and `Base_method` (or an inherited one) exists
    // globally, this is a method call: run method resolution regardless
    // of free-function shadowing (C++ resolves the method). Coincidental
    // free calls with struct-typed first args and same-named methods are
    // accepted as methods — ambiguous even for a dot-aware frontend.
    // Receivers are identifier- or member-shaped (`b`, `self`, `o.out`,
    // `self.out`): the parser spells `&Self`/`&T` star-form (`S*`), so
    // both markers strip, like the receiver block below.
    fun probe_strip_base(self: &Self, t: string) <string> {
        if (t == null) { return ""; }
        let cur <string> = self.resolve_type(t);
        let guard <int> = 0;
        while (guard < 8) {
            let l <int> = cast<int>(chk_strlen(cur));
            if (l > 1 && chk_str_eq(substr(cur, 0, 1), "&")) {
                cur = substr(cur, 1, l - 1);
            } else {
                break;
            }
            guard = guard + 1;
        }
        guard = 0;
        while (guard < 8) {
            let l2 <int> = cast<int>(chk_strlen(cur));
            if (l2 > 1 && chk_str_eq(substr(cur, l2 - 1, 1), "*")) {
                cur = substr(cur, 0, l2 - 1);
            } else {
                break;
            }
            guard = guard + 1;
        }
        let bl <int> = cast<int>(chk_strlen(cur));
        let bi <int> = 0;
        while (bi < bl) {
            if (chk_str_eq(substr(cur, bi, 1), "<")) {
                cur = substr(cur, 0, bi);
                break;
            }
            bi = bi + 1;
        }
        if (chk_str_eq(cur, "Self") && chk_strlen(self.current_struct) > cast<ulong>(0)) {
            cur = self.current_struct;
        }
        return cur;
    }
    // Static receiver base without evaluating anything: an identifier
    // reads its declared type from scope, a member read follows its
    // field spelling (`B_f`, `B::f`). Anything else (calls, indexes)
    // answers "" and keeps today's free-call behavior.
    fun probe_recv_base(self: &Self, node: &AstNode) <string> {
        if (node == null) { return ""; }
        if (node.kind == ast_ident()) {
            if (node.name == null) { return ""; }
            if (!self.current_scope.has(node.name)) { return ""; }
            let vsym <Symbol> = self.current_scope.lookup(node.name);
            return self.probe_strip_base(vsym.type_name);
        }
        if (node.kind == ast_member_access()) {
            let b <string> = self.probe_recv_base(node.left);
            if (chk_str_eq(b, "")) { return ""; }
            let fb <Buffer> = new_buffer(64);
            fb.write_string(b);
            fb.write_char('_');
            fb.write_string(node.name);
            let fq <string> = fb.to_string();
            free_buffer(fb);
            if (self.global_scope.has(fq)) {
                let fsym <Symbol> = self.global_scope.lookup(fq);
                return self.probe_strip_base(fsym.type_name);
            }
            let sb <Buffer> = new_buffer(64);
            sb.write_string(b);
            sb.write_string("::");
            sb.write_string(node.name);
            let sq <string> = sb.to_string();
            free_buffer(sb);
            if (self.global_scope.has(sq)) {
                let ssym <Symbol> = self.global_scope.lookup(sq);
                return self.probe_strip_base(ssym.type_name);
            }
            return "";
        }
        return "";
    }
    fun method_probe_hit(self: &Self, fn_node: &AstNode) <bool> {
        if (fn_node == null || fn_node.left == null) { return false; }
        if (fn_node.name == null || chk_strlen(fn_node.name) == cast<ulong>(0)) { return false; }
        let head <&AstNode> = fn_node.left;
        let first <&AstNode> = head.left;
        if (first == null) { first = head; }
        let t <string> = self.probe_recv_base(first);
        if (chk_str_eq(t, "")) { return false; }
        if (!self.global_scope.has(t)) { return false; }
        let psym <Symbol> = self.global_scope.lookup(t);
        if (psym.kind != sym_struct()) { return false; }
        let qb <Buffer> = new_buffer(64);
        qb.write_string(t);
        qb.write_char('_');
        qb.write_string(fn_node.name);
        let qn <string> = qb.to_string();
        free_buffer(qb);
        if (self.global_scope.has(qn)) { return true; }
        let inh <string> = self.find_inherited_method(t, fn_node.name, 0);
        if (!chk_str_eq(inh, "")) { return true; }
        return false;
    }

    // FRONTEND WINS helpers (FW2 I1/I2): bare calls resolve through the
    // struct's own methods seen so far, never by name to a free function.
    // Short name behind a flattened `S_foo` for this struct, else "".
    fun bare_short_of(self: &Self, full: string, struct_name: string) <string> {
        if (full == null || struct_name == null) { return ""; }
        let slen <int> = cast<int>(chk_strlen(struct_name));
        let flen <int> = cast<int>(chk_strlen(full));
        if (slen <= 0 || flen <= slen + 1) { return ""; }
        let i <int> = 0;
        while (i < slen) {
            if (!chk_str_eq(substr(full, i, 1), substr(struct_name, i, 1))) { return ""; }
            i = i + 1;
        }
        if (!chk_str_eq(substr(full, slen, 1), "_")) { return ""; }
        return substr(full, slen + 1, flen - slen - 1);
    }
    // Index of a seen method short name, or -1 (declaration-ordered).
    fun bare_find_seen(self: &Self, short: string) <int> {
        if (short == null) { return -1; }
        let i <int> = 0;
        while (i < self.bare_seen_count) {
            if (chk_str_eq(self.bare_seen_shorts[i], short)) { return i; }
            i = i + 1;
        }
        return -1;
    }
    // True when a nearer scope (param, local, nested fun, block) binds the
    // name: only scopes inside the global shadow the method, a free function
    // in the global never does (C++ structScopes rule).
    fun bare_is_shadowed(self: &Self, name: string) <bool> {
        if (name == null) { return false; }
        let cur <&Scope> = self.current_scope;
        while (cur != null) {
            if (cur.parent == null) { break; }
            if (cur.has_local(name)) { return true; }
            cur = cur.parent;
        }
        return false;
    }
    // True when the name builds a type (a constructor call, C++ resolveType
    // guard): a declared struct/enum/interface/alias. `Self` is checked by
    // the caller.
    fun bare_is_type_name(self: &Self, name: string) <bool> {
        if (name == null) { return false; }
        if (!self.global_scope.has(name)) { return false; }
        let sym <Symbol> = self.global_scope.lookup(name);
        if (sym.kind == sym_struct()) { return true; }
        if (sym.kind == sym_enum()) { return true; }
        if (sym.kind == sym_interface()) { return true; }
        if (sym.kind == sym_type_alias()) { return true; }
        return false;
    }
    // True when single-char spelling `c` is an identifier character.
    fun bare_is_ident_char(self: &Self, c: string) <bool> {
        if (c == null || chk_strlen(c) == cast<ulong>(0)) { return false; }
        let cs <[char]> = to_chars(c);
        let ch <char> = cs[0];
        delete cs;
        if (ch >= 'a' && ch <= 'z') { return true; }
        if (ch >= 'A' && ch <= 'Z') { return true; }
        if (ch >= '0' && ch <= '9') { return true; }
        if (ch == '_') { return true; }
        return false;
    }
    // True when `code` (already comment-stripped) holds `static` as a whole
    // word. Catches `pub static fun`, not `mystatic` or a `// static` comment
    // (stripped by the caller).
    fun bare_has_static_word(self: &Self, code: string) <bool> {
        if (code == null) { return false; }
        let len <int> = cast<int>(chk_strlen(code));
        if (len < 6) { return false; }
        let i <int> = 0;
        while (i + 6 <= len) {
            if (chk_str_eq(substr(code, i, 6), "static")) {
                let pre_ok <bool> = true;
                let post_ok <bool> = true;
                if (i > 0) {
                    if (self.bare_is_ident_char(substr(code, i - 1, 1))) { pre_ok = false; }
                }
                if (i + 6 < len) {
                    if (self.bare_is_ident_char(substr(code, i + 6, 1))) { post_ok = false; }
                }
                if (pre_ok && post_ok) { return true; }
            }
            i = i + 1;
        }
        return false;
    }
    // The declaration line's code part (before `//`), or "" when unreadable.
    // Reads the source file (already imported for diagnostics); the caller
    // frees nothing (returned spelling is a fresh `substr`, leaked like the
    // checker's other temporaries). Single `to_chars` scan (diag_snippet_line
    // shape), never per-character `substr` over the whole file: that path
    // OOMs self-compilation (stage2 building stage3).
    fun bare_decl_code_line(self: &Self, line: int) <string> {
        if (line < 1) { return ""; }
        if (self.source_file == null || chk_strlen(self.source_file) == cast<ulong>(0)) { return ""; }
        let text? <string> = read_to_string(self.source_file);
        if (text == null) { return ""; }
        let total <int> = cast<int>(chk_strlen(text?));
        let bytes <[char]> = to_chars(text?);
        let cur <int> = 1;
        let start <int> = 0;
        let found <int> = -1;
        let found_len <int> = 0;
        let i <int> = 0;
        while (i <= total) {
            let is_nl <bool> = false;
            if (i == total) {
                is_nl = true;
            } else {
                if (bytes[i] == cast<char>(10)) { is_nl = true; }
            }
            if (is_nl) {
                if (cur == line) {
                    found = start;
                    found_len = i - start;
                    break;
                }
                cur = cur + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        delete bytes;
        let res <string> = "";
        if (found >= 0 && found_len > 0) {
            res = substr(text?, found, found_len);
            // Strip `//` comment: code before it only.
            let rlen <int> = cast<int>(chk_strlen(res));
            let j <int> = 0;
            while (j + 1 < rlen) {
                if (chk_str_eq(substr(res, j, 1), "/") && chk_str_eq(substr(res, j + 1, 1), "/")) {
                    res = substr(res, 0, j);
                    break;
                }
                j = j + 1;
            }
        }
        free_file_content(text?);
        return res;
    }
    // True when the method declared at `line` wrote the `static` keyword.
    // The parser drops `static` (parser.fin:2380-2383) and normalizes every
    // `self` to `S*` (parse_param_type), so the AST alone cannot tell a
    // static from an instance; the source line still can. Comment-stripped,
    // whole-word, so `// ... static ...` never counts.
    fun bare_decl_is_static(self: &Self, line: int) <bool> {
        let code <string> = self.bare_decl_code_line(line);
        if (chk_str_eq(code, "")) { return false; }
        return self.bare_has_static_word(code);
    }

    // Mirror of C++ checkCallArity (Analyzer_Expr.cpp): the range form when
      // an optional parameter makes required differ from expected.
      fun check_arity(self: &Self, kind: string, name: string, expected: int, required: int, actual: int, line: int, col: int) <noret> {
          if (actual < required || actual > expected) {
              let b <Buffer> = new_buffer(96);
              b.write_string(kind);
              b.write_string(" '");
              b.write_string(name);
              if (required == expected) {
                  b.write_string("' expects ");
                  b.write_int(expected);
                  b.write_string(" arguments, got ");
                  b.write_int(actual);
              } else {
                  b.write_string("' expects between ");
                  b.write_int(required);
                  b.write_string(" and ");
                  b.write_int(expected);
                  b.write_string(" arguments, got ");
                  b.write_int(actual);
              }
              self.report_error(b.to_string(), line, col);
              free_buffer(b);
          }
      }

      fun report_type_mismatch(self: &Self, expected: string, actual: string, line: int, col: int) <noret> {
          let b <Buffer> = new_buffer(96);
          b.write_string("Type mismatch: expected '");
          b.write_string(expected);
          b.write_string("', got '");
          b.write_string(actual);
          b.write_string("'");
          self.report_error(b.to_string(), line, col);
          free_buffer(b);
      }

      // True when any identifier word inside a type spelling is not a
      // known type name (`Pair<A, B>` mentions `A`: the callee's generic
      // parameter, which C++ infers from the argument instead of
      // refusing). Whole spellings with generic arguments always count
      // as known (see chk_is_known_type_name), so the per-argument check
      // extends that skip word-wise. Fully-concrete spellings (`Box<int>`,
      // `Pair<int, char>`) have no unknown words and keep full checking.
      // Only misses, never invents.
      fun chk_spelling_has_unknown_word(self: &Self, s: string) <bool> {
          if (s == null || chk_strlen(s) == cast<ulong>(0)) { return false; }
          let len <int> = cast<int>(chk_strlen(s));
          let chars <[char]> = to_chars(s);
          let i <int> = 0;
          while (i < len) {
              let c <char> = chars[i];
              if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '$') {
                  let start <int> = i;
                  while (i < len) {
                      let c2 <char> = chars[i];
                      if ((c2 >= 'a' && c2 <= 'z') || (c2 >= 'A' && c2 <= 'Z') ||
                          (c2 >= '0' && c2 <= '9') || c2 == '_' || c2 == '$') {
                          i = i + 1;
                      } else {
                          break;
                      }
                  }
                  let w <string> = substr(s, start, i - start);
                  if (!self.chk_is_known_type_name(w)) {
                      delete chars;
                      return true;
                  }
              } else {
                  i = i + 1;
              }
          }
          delete chars;
          return false;
      }

      // One call argument against its written parameter spelling: the
      // narrowing check C++ checkCallArguments runs per argument through
      // checkType (refused at the argument, like `=` and `return`). Shared
      // by plain calls, scoped `S::m` calls, and constructor `S(x)` calls
      // so all three answer the same. Skips, never invents (see the
      // chk_types_compatible contract); want_raw is the written spelling,
      // resolved here exactly like the plain-call path resolves it.
      fun chk_check_arg_type(self: &Self, actual_arg: &AstNode, at: string, want_raw: string) <noret> {
          let want <string> = self.resolve_type(chk_trim(want_raw));
          // An unbound bare word on either side is a generic parameter the
          // C++ frontend infers (checkGenericCall), never a mismatch: the
          // declaration already diagnosed the genuinely-undefined, so this
          // misses like every skip above, never invents. Complex spellings
          // stay known and keep full checking below, unless a word inside
          // them is unknown (a callee generic like `A` in `Pair<A, B>`,
          // which C++ unifies from the concrete argument): that skips
          // word-wise, while fully-concrete spellings (`Box<int>` against
          // `Box<string>`) still refuse.
          if (!self.chk_is_known_type_name(at) || !self.chk_is_known_type_name(want)) { return; }
          if (self.chk_spelling_has_unknown_word(at) || self.chk_spelling_has_unknown_word(want)) { return; }
          if (!chk_str_eq(at, "auto") && !chk_str_eq(at, "void") && !chk_str_eq(at, "error") &&
              !chk_str_eq(at, "module") && !self.chk_mentions_gen_param(at) &&
              !chk_str_eq(want, "") && !chk_str_eq(want, "void") && !chk_str_eq(want, "void*") &&
              !chk_str_eq(want, "error") && !self.chk_mentions_gen_param(want)) {
              // Parser artifact (parser.fin parse_param_type): a written
              // `[T]` parameter arrives here as `T*`, the same spelling an
              // explicit `*T` writes. C++ keeps the array and accepts `[T]`
              // for it, but refuses an array for a real pointer (no decay
              // in checkType). Read a star-form want against an array
              // actual the array way, one level, element against element.
              if (self.chk_is_arr(at) && !self.chk_is_arr(want)) {
                  let wlen <int> = cast<int>(chk_strlen(want));
                  if (wlen > 1 && chk_str_eq(substr(want, wlen - 1, 1), "*") &&
                      !chk_str_eq(substr(want, 0, 1), "&")) {
                      let wbase <string> = substr(want, 0, wlen - 1);
                      if (!self.chk_types_compatible(self.chk_arr_elem(at), wbase)) {
                          self.report_type_mismatch(want, at, actual_arg.line, actual_arg.col);
                      }
                      return;
                  }
              }
              if (!self.chk_types_compatible(at, want)) {
                  let fit_ok <bool> = false;
                  if (chk_int_bits(want) > 0 && chk_is_int_const(actual_arg) &&
                      chk_big_const_verdict(actual_arg, want) == 0) {
                      fit_ok = true;
                  }
                  if (!fit_ok) {
                      self.report_type_mismatch(want, at, actual_arg.line, actual_arg.col);
                  }
              } else if (chk_str_eq(self.chk_strip_qmark(want), want)) {
                  let av <int> = chk_big_const_verdict(actual_arg, want);
                  if (av == 2) {
                      self.report_error("An integer constant is too large to represent", actual_arg.line, actual_arg.col);
                  } else if (av == 1) {
                      self.report_type_mismatch(want, at, actual_arg.line, actual_arg.col);
                  }
              }
          }
      }

      // True when the value is an array literal (`[...]`,
      // parser.fin:1400) whose every element is an integer constant
      // fitting the target's element type (C++ judges
      // `let u <[uint]> = [7,3]` element-wise, arrays.fin:29): the plain
      // narrowing check stands down for those. Anything else
      // (non-literals, non-array or non-integer-element targets, unfit
      // elements) answers false so the caller checks normally.
      fun chk_arr_literal_all_fit(self: &Self, node: &AstNode, target: string) <bool> {
          if (node == null || target == null) { return false; }
          if (node.kind != ast_call_expr()) { return false; }
          if (!chk_str_eq(node.name, "__fin_array_literal")) { return false; }
          if (!self.chk_is_arr(target)) { return false; }
          let elem <string> = self.chk_arr_elem(target);
          if (chk_int_bits(elem) <= 0) { return false; }
          let arg <&AstNode> = node.left;
          while (arg != null) {
              let actual <&AstNode> = arg.left;
              if (actual == null) { actual = arg; }
              if (!chk_is_int_const(actual) || chk_big_const_verdict(actual, elem) != 0) { return false; }
              arg = arg.right;
          }
          return true;
      }

      // The single-letter generic vocabulary (see check_expression): a
      // generic parameter target is bound at instantiation, not here.
      // Declared names consult the pass-1 generic registry, so
      // `fun addgen<Generic>` treats `Generic` like `T` (triage #6b).
      // SG1 mirror (codegen.fin cg_is_generic_ann): a vocabulary letter
      // naming a declared struct/enum/interface is that concrete type,
      // NOT a type parameter — unless the letter is also declared as a
      // generic parameter in scope (shadowing, like C++). Undeclared
      // letters keep the vocabulary fallback so genuine generics bind.
      fun chk_is_type_param(self: &Self, s: string) <bool> {
          if (s == null) { return false; }
          if (chk_str_eq(s, "T") || chk_str_eq(s, "E") || chk_str_eq(s, "U") ||
              chk_str_eq(s, "K") || chk_str_eq(s, "V") || chk_str_eq(s, "X")) {
              if (self.chk_single_letter_is_declared_type(s)) { return false; }
              return true;
          }
          if (self.gen_scope_names == null) { return false; }
          let t <string> = chk_trim(s);
          if (!self.chk_is_bare_word(t)) { return false; }
          return self.chk_word_is_gen_param(t);
      }

      // True when the trimmed bare word is a bound parameter name in any
      // recorded generic scope (the loop above, extracted so the
      // single-letter rule below shares it). Program-global like the
      // registry it reads (see record_generic_scope).
      fun chk_word_is_gen_param(self: &Self, t: string) <bool> {
          if (self.gen_scope_names == null) { return false; }
          if (t == null) { return false; }
          let gi <int> = 0;
          while (gi < self.gen_count) {
              let segs <[string]> = new [string, 64]{};
              let scount <int> = self.split_generic_segs(self.gen_scope_params[gi], segs);
              let pnames <[string]> = new [string, 64]{};
              let pcount <int> = self.collect_bound_pnames(segs, scount, pnames, 0);
              let pi <int> = 0;
              while (pi < pcount) {
                  if (chk_str_eq(pnames[pi], t)) {
                      delete segs;
                      delete pnames;
                      return true;
                  }
                  pi = pi + 1;
              }
              delete segs;
              delete pnames;
              gi = gi + 1;
          }
          return false;
      }

      // True when the single-letter word names a declared
      // struct/enum/interface (a concrete type, never a parameter) and
      // is not shadowed by a declared generic parameter. Non-vocabulary
      // words answer false; aliases stay parameters here because C++
      // resolves them to their target like any other spelling.
      fun chk_single_letter_is_declared_type(self: &Self, w: string) <bool> {
          if (w == null) { return false; }
          if (!chk_str_eq(w, "T") && !chk_str_eq(w, "E") && !chk_str_eq(w, "U") &&
              !chk_str_eq(w, "K") && !chk_str_eq(w, "V") && !chk_str_eq(w, "X")) {
              return false;
          }
          if (self.chk_word_is_gen_param(w)) { return false; }
          if (self.global_scope.has(w)) {
              let sym <Symbol> = self.global_scope.lookup(w);
              if (sym.kind == sym_struct() || sym.kind == sym_enum() ||
                  sym.kind == sym_interface()) {
                  return true;
              }
          }
          return false;
      }

      // Spelling-level SG1 mirror: a single-letter word answered above
      // is a concrete type, not a parameter mention, so the narrowing
      // checks keep full checking there instead of skipping. Only whole
      // words match (`int` is not `T`).
      fun chk_mentions_gen_param(self: &Self, s: string) <bool> {
          if (s == null) { return false; }
          let len <int> = cast<int>(chk_strlen(s));
          let chars <[char]> = to_chars(s);
          let i <int> = 0;
          while (i < len) {
              let c <char> = chars[i];
              if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') {
                  let start <int> = i;
                  while (i < len) {
                      let c2 <char> = chars[i];
                      if ((c2 >= 'a' && c2 <= 'z') || (c2 >= 'A' && c2 <= 'Z') ||
                          (c2 >= '0' && c2 <= '9') || c2 == '_') {
                          i = i + 1;
                      } else {
                          break;
                      }
                  }
                  if (i - start == 1) {
                      let w <string> = substr(s, start, 1);
                      if (chk_str_eq(w, "T") || chk_str_eq(w, "E") || chk_str_eq(w, "U") ||
                          chk_str_eq(w, "K") || chk_str_eq(w, "V") || chk_str_eq(w, "X")) {
                          if (!self.chk_single_letter_is_declared_type(w)) {
                              delete chars;
                              return true;
                          }
                      }
                  }
              } else {
                  i = i + 1;
              }
          }
          delete chars;
          return false;
      }

      // Strips one trailing `?` (`int?` -> `int`); otherwise identity.
      fun chk_strip_qmark(self: &Self, s: string) <string> {
          if (s == null) { return ""; }
          let len <int> = cast<int>(chk_strlen(s));
          if (len > 1 && chk_str_eq(substr(s, len - 1, 1), "?")) {
              return substr(s, 0, len - 1);
          }
          return s;
      }

      // True when the spelling names Self (`Self`, `&Self`, `Self*`);
      // resolved by the backend, so spelling-level compare would noise.
      fun chk_has_self(self: &Self, s: string) <bool> {
          if (s == null) { return false; }
          if (chk_str_eq(s, "Self") || chk_str_eq(s, "&Self") || chk_str_eq(s, "Self*")) {
              return true;
          }
          return false;
      }

      // True when `expected` names an interface in `actual`'s heritage
      // (`struct Fin : <Person>` takes `Person` slots: the C++
      // struct-to-interface conversion, love.fin:89-90). Struct parents
      // stay refused (C++ refuses `Child` for `Base`). Transitive through
      // struct ancestors, depth-capped like the member walk.
      fun chk_iface_in_heritage(self: &Self, actual: string, expected: string, depth: int) <bool> {
          if (depth > 8) { return false; }
          if (actual == null || expected == null) { return false; }
          let pb <Buffer> = new_buffer(64);
          pb.write_string(actual);
          pb.write_string("_parents");
          let pkey <string> = pb.to_string();
          free_buffer(pb);
          if (!self.global_scope.has(pkey)) { return false; }
          let psym <Symbol> = self.global_scope.lookup(pkey);
          let plist <string> = psym.type_name;
          if (plist == null) { return false; }
          let plen <int> = cast<int>(chk_strlen(plist));
          let pchars <[char]> = to_chars(plist);
          let wi <int> = 0;
          while (wi < plen) {
              let wc <char> = pchars[wi];
              if ((wc >= 'a' && wc <= 'z') || (wc >= 'A' && wc <= 'Z') || wc == '_') {
                  let wstart <int> = wi;
                  while (wi < plen) {
                      let wc2 <char> = pchars[wi];
                      if ((wc2 >= 'a' && wc2 <= 'z') || (wc2 >= 'A' && wc2 <= 'Z') ||
                          (wc2 >= '0' && wc2 <= '9') || wc2 == '_') {
                          wi = wi + 1;
                      } else {
                          break;
                      }
                  }
                  let word <string> = substr(plist, wstart, wi - wstart);
                  let rw <string> = self.resolve_type(word);
                  if (chk_str_eq(rw, expected) && self.global_scope.has(rw)) {
                      // Bound to a local first: a direct field read on
                      // a lookup temporary miscompiles under
                      // self-hosting (the kind check fails in a
                      // Fin-built stage2 with identical inputs, while
                      // the bound form passes in both stages).
                      let lsym <Symbol> = self.global_scope.lookup(rw);
                      if (lsym.kind == sym_interface()) {
                      delete pchars;
                      return true;
                      }
                  }
                  if (self.chk_iface_in_heritage(rw, expected, depth + 1)) {
                      delete pchars;
                      return true;
                  }
              } else {
                  wi = wi + 1;
              }
          }
          delete pchars;
          return false;
      }

      // Mirror of C++ isAssignableTo for the three sites this checker enforces
      // (return values, `=` assignments, call arguments): exact match after alias resolution,
      // plus the conversions the corpus writes without casts (nullable both
      // directions, integer widening per ADR 0022, the one int->float rule,
      // `any`/`object` targets, generic parameter targets, struct-to-interface
      // heritage). Anything unknown
      // (auto/error sentinels, void* nulls, Self) is accepted: this check may
      // only miss an error, never invent one the C++ frontend would not.
      fun chk_types_compatible(self: &Self, actual: string, expected: string) <bool> {
          if (actual == null || expected == null) { return true; }
          let a <string> = self.resolve_type(actual);
          let e <string> = self.resolve_type(expected);
          if (chk_str_eq(a, e)) { return true; }
          if (chk_str_eq(a, "auto") || chk_str_eq(e, "auto")) { return true; }
          if (chk_str_eq(a, "error") || chk_str_eq(e, "error")) { return true; }
          if (chk_str_eq(e, "noret")) { return true; }
          if (chk_str_eq(a, "void*")) { return true; }
          if (chk_str_eq(e, "any") || chk_str_eq(e, "object")) { return true; }
          if (self.chk_is_type_param(e)) { return true; }
          if (self.chk_has_self(a) || self.chk_has_self(e)) { return true; }
          if (chk_str_eq(self.chk_strip_qmark(a), self.chk_strip_qmark(e))) { return true; }
          // A `T?` slot takes a plain `T` by the inner rule (C++ Type base
          // isAssignableTo unwraps the target), and two nullables ask the
          // inner types (NullableType::isAssignableTo). One `?` stripped per
          // level, so the recursion terminates.
          let a_stripped <string> = self.chk_strip_qmark(a);
          let e_stripped <string> = self.chk_strip_qmark(e);
          let a_q <bool> = !chk_str_eq(a_stripped, a);
          let e_q <bool> = !chk_str_eq(e_stripped, e);
          if (e_q && !a_q) {
              return self.chk_types_compatible(a, e_stripped);
          }
          if (a_q && e_q) {
              return self.chk_types_compatible(a_stripped, e_stripped);
          }
          // Heritage conversion, beside the nullable unwraps so `Fin`
          // meets `Person?` through the inner rule too.
          if (self.chk_iface_in_heritage(a, e, 0)) { return true; }
          if (chk_str_eq(self.chk_strip_ptr(a), self.chk_strip_ptr(e))) { return true; }
          // Same depth, same base: `&&&int` is `int***` (C++ PointerType
          // nesting). Depth 0 on either side stays a mismatch (`&int` is
          // not `int`); `void*` conversions are answered above.
          if (self.chk_ptr_depth(a) > 0 && self.chk_ptr_depth(a) == self.chk_ptr_depth(e)) {
              if (chk_str_eq(self.chk_ptr_base(a), self.chk_ptr_base(e))) { return true; }
          }
          if (self.chk_is_arr(a) && self.chk_is_arr(e)) {
              return self.chk_types_compatible(self.chk_arr_elem(a), self.chk_arr_elem(e));
          }
          if (chk_str_eq(e, "void*") && self.chk_is_ptr_like(a)) { return true; }
          if (self.chk_is_arr(e) && self.chk_is_ptr_like(a)) {
              return self.chk_types_compatible(self.chk_strip_ptr(a), self.chk_arr_elem(e));
          }
          // Same generic base with arguments on exactly one side: the bare
          // side is argument erasure (`coll!` types as `Collection`, declared
          // `&Collection<T>`), not a mismatch. Both sides carrying
          // arguments stay strict (`Box<int>` vs `Box<string>` still fails).
          if (chk_str_eq(self.chk_generic_base(a), self.chk_generic_base(e))) {
              let a_args <int> = 0;
              if (self.chk_has_generic_args(a)) { a_args = 1; }
              let e_args <int> = 0;
              if (self.chk_has_generic_args(e)) { e_args = 1; }
              if (a_args != e_args) { return true; }
          }
          if (chk_str_eq(a, "int") && chk_str_eq(e, "float")) { return true; }
          let a_bits <int> = chk_int_bits(a);
          let e_bits <int> = chk_int_bits(e);
          if (a_bits > 0 && e_bits > 0) {
              if (e_bits > a_bits) { return true; }
              if (e_bits == a_bits && chk_int_is_signed(a) == chk_int_is_signed(e)) { return true; }
          }
          return false;
      }

      // ===== Wave 4: compiler API surface (C++ is the oracle) =====
      //
      // Parse+check parity for the compiler-API surface: grants, component
      // calls, attribute validation, providers, event handlers. New-mechanism
      // bodies that lower nowhere are refused with named diagnostics; the
      // backend lowers `@special` definitions as nothing (codegen.fin).

      // The component table (CompilerApi.cpp). Anything else is not a
      // component, and anything else under one is not a member.
      fun api_is_component(self: &Self, name: string) <bool> {
          if (name == null) { return false; }
          if (chk_str_eq(name, "types") || chk_str_eq(name, "structs") ||
              chk_str_eq(name, "enums") || chk_str_eq(name, "system") ||
              chk_str_eq(name, "layout") || chk_str_eq(name, "events") ||
              chk_str_eq(name, "diag") || chk_str_eq(name, "scopes")) {
              return true;
          }
          return false;
      }

      // One member row: arity, result spelling, and whether it is a constant
      // read rather than a call. `R` is the turbofish result. Two queries
      // over one table (the language has no out-params): the arity query
      // packs `arity * 2 + is_const` and answers -1 for an unknown member;
      // the result query answers "" for one.
      fun api_member_packed(self: &Self, comp: string, member: string) <int> {
          if (chk_str_eq(comp, "types")) {
              if (chk_str_eq(member, "cmp_types")) { return 4; }
              if (chk_str_eq(member, "ct_any")) { return 2; }
              if (chk_str_eq(member, "gettype")) { return 0; }
              if (chk_str_eq(member, "typefrom_typeid")) { return 2; }
              if (chk_str_eq(member, "typeid_of")) { return 2; }
              if (chk_str_eq(member, "name_of")) { return 2; }
              if (chk_str_eq(member, "kind_of")) { return 2; }
              if (chk_str_eq(member, "implements")) { return 4; }
              if (chk_str_eq(member, "is_comptime_type")) { return 2; }
              if (chk_str_eq(member, "KindType") || chk_str_eq(member, "KindStruct") ||
                  chk_str_eq(member, "KindInterface") || chk_str_eq(member, "KindEnum") ||
                  chk_str_eq(member, "KindPrimitive") || chk_str_eq(member, "KindPointer") ||
                  chk_str_eq(member, "KindArray") || chk_str_eq(member, "KindFunction") ||
                  chk_str_eq(member, "KindPrototype")) {
                  return 1;
              }
              return -1;
          }
          if (chk_str_eq(comp, "structs")) {
              if (chk_str_eq(member, "select_field")) { return 4; }
              if (chk_str_eq(member, "has_field")) { return 4; }
              if (chk_str_eq(member, "field_count")) { return 2; }
              if (chk_str_eq(member, "field_type")) { return 4; }
              if (chk_str_eq(member, "field_visibility")) { return 4; }
              if (chk_str_eq(member, "has_destructor")) { return 2; }
              if (chk_str_eq(member, "VisPublic") || chk_str_eq(member, "VisPrivate") ||
                  chk_str_eq(member, "VisReadonly")) {
                  return 1;
              }
              return -1;
          }
          if (chk_str_eq(comp, "enums")) {
              if (chk_str_eq(member, "InBytes") || chk_str_eq(member, "InKilobytes") ||
                  chk_str_eq(member, "InMegabytes") || chk_str_eq(member, "InGigabytes")) {
                  return 1;
              }
              if (chk_str_eq(member, "resolve_id")) { return 2; }
              if (chk_str_eq(member, "keyid_of")) { return 2; }
              if (chk_str_eq(member, "payload_type")) { return 2; }
              return -1;
          }
          if (chk_str_eq(comp, "system")) {
              if (chk_str_eq(member, "get_total_memory")) { return 2; }
              if (chk_str_eq(member, "get_available_memory")) { return 2; }
              if (chk_str_eq(member, "get_memorycard_model")) { return 0; }
              if (chk_str_eq(member, "pointer_size")) { return 0; }
              if (chk_str_eq(member, "target_triple")) { return 0; }
              return -1;
          }
          if (chk_str_eq(comp, "layout")) {
              if (chk_str_eq(member, "size_of")) { return 2; }
              if (chk_str_eq(member, "align_of")) { return 2; }
              if (chk_str_eq(member, "offset_of")) { return 4; }
              if (chk_str_eq(member, "pointer_count")) { return 2; }
              if (chk_str_eq(member, "pointer_offset_at")) { return 4; }
              if (chk_str_eq(member, "pointee_type_at")) { return 4; }
              if (chk_str_eq(member, "pointer_map_quote")) { return 2; }
              if (chk_str_eq(member, "is_layout_final")) { return 2; }
              if (chk_str_eq(member, "request_header_words")) { return 4; }
              if (chk_str_eq(member, "request_min_align")) { return 4; }
              return -1;
          }
          if (chk_str_eq(comp, "events")) {
              if (chk_str_eq(member, "enable")) { return 2; }
              if (chk_str_eq(member, "ExitNormal") || chk_str_eq(member, "ExitBlamed") ||
                  chk_str_eq(member, "MovedYes") || chk_str_eq(member, "MovedNo") ||
                  chk_str_eq(member, "MovedMaybe")) {
                  return 1;
              }
              return -1;
          }
          if (chk_str_eq(comp, "diag")) {
              if (chk_str_eq(member, "error") || chk_str_eq(member, "warning") ||
                  chk_str_eq(member, "note")) {
                  return 2;
              }
              return -1;
          }
          if (chk_str_eq(comp, "scopes")) {
              if (chk_str_eq(member, "live_pointers_quote")) { return 0; }
              return -1;
          }
          return -1;
      }

      fun api_member_ret(self: &Self, comp: string, member: string, turbofish: string) <string> {
          if (chk_str_eq(comp, "types")) {
              if (chk_str_eq(member, "cmp_types")) { return "int"; }
              if (chk_str_eq(member, "ct_any")) { return "$type"; }
              if (chk_str_eq(member, "gettype")) { return "$struct"; }
              if (chk_str_eq(member, "typefrom_typeid")) { return "$type"; }
              if (chk_str_eq(member, "typeid_of")) { return "uint"; }
              if (chk_str_eq(member, "name_of")) { return "string"; }
              if (chk_str_eq(member, "kind_of")) { return "int"; }
              if (chk_str_eq(member, "implements")) { return "bool"; }
              if (chk_str_eq(member, "is_comptime_type")) { return "bool"; }
              return "int";
          }
          if (chk_str_eq(comp, "structs")) {
              if (chk_str_eq(member, "select_field")) {
                  let rbase <string> = turbofish;
                  if (rbase == null || chk_strlen(rbase) == cast<ulong>(0)) { rbase = "auto"; }
                  let nb <Buffer> = new_buffer(32);
                  nb.write_string(rbase);
                  nb.write_char('?');
                  let rr <string> = nb.to_string();
                  free_buffer(nb);
                  return rr;
              }
              if (chk_str_eq(member, "has_field")) { return "bool"; }
              if (chk_str_eq(member, "field_count")) { return "int"; }
              if (chk_str_eq(member, "field_type")) { return "$type?"; }
              if (chk_str_eq(member, "field_visibility")) { return "int"; }
              if (chk_str_eq(member, "has_destructor")) { return "bool"; }
              return "int";
          }
          if (chk_str_eq(comp, "enums")) {
              if (chk_str_eq(member, "resolve_id")) { return "int"; }
              if (chk_str_eq(member, "keyid_of")) { return "int"; }
              if (chk_str_eq(member, "payload_type")) { return "$type?"; }
              return "uint";
          }
          if (chk_str_eq(comp, "system")) {
              if (chk_str_eq(member, "get_total_memory")) { return "uint"; }
              if (chk_str_eq(member, "get_available_memory")) { return "uint"; }
              if (chk_str_eq(member, "get_memorycard_model")) { return "string"; }
              if (chk_str_eq(member, "pointer_size")) { return "uint"; }
              if (chk_str_eq(member, "target_triple")) { return "string"; }
              return "void";
          }
          if (chk_str_eq(comp, "layout")) {
              if (chk_str_eq(member, "size_of")) { return "uint"; }
              if (chk_str_eq(member, "align_of")) { return "uint"; }
              if (chk_str_eq(member, "offset_of")) { return "uint?"; }
              if (chk_str_eq(member, "pointer_count")) { return "int"; }
              if (chk_str_eq(member, "pointer_offset_at")) { return "uint"; }
              if (chk_str_eq(member, "pointee_type_at")) { return "$type"; }
              if (chk_str_eq(member, "pointer_map_quote")) { return "quote"; }
              if (chk_str_eq(member, "is_layout_final")) { return "bool"; }
              if (chk_str_eq(member, "request_header_words")) { return "noret"; }
              if (chk_str_eq(member, "request_min_align")) { return "noret"; }
              return "void";
          }
          if (chk_str_eq(comp, "events")) {
              if (chk_str_eq(member, "enable")) { return "void"; }
              return "int";
          }
          if (chk_str_eq(comp, "diag")) { return "noret"; }
          if (chk_str_eq(comp, "scopes")) { return "quote"; }
          return "void";
      }

      // Attribute text is `;`-joined `name(args)` segments (parser.fin).
      // Segment count, bounded by cap.
      fun api_attr_count(self: &Self, text: string, cap: int) <int> {
          if (text == null || chk_strlen(text) == cast<ulong>(0)) { return 0; }
          let n <int> = 1;
          let len <int> = cast<int>(chk_strlen(text));
          let i <int> = 0;
          while (i < len) {
              if (chk_str_eq(substr(text, i, 1), ";")) { n = n + 1; }
              i = i + 1;
          }
          if (n > cap) { n = cap; }
          return n;
      }

      fun api_attr_seg(self: &Self, text: string, idx: int) <string> {
          let len <int> = cast<int>(chk_strlen(text));
          let cur <int> = 0;
          let start <int> = 0;
          let i <int> = 0;
          while (i <= len) {
              if (i == len || chk_str_eq(substr(text, i, 1), ";")) {
                  if (cur == idx) { return substr(text, start, i - start); }
                  cur = cur + 1;
                  start = i + 1;
              }
              i = i + 1;
          }
          return "";
      }

      // The attribute name: up to the first `(` or `=`.
      fun api_attr_name(self: &Self, seg: string) <string> {
          let len <int> = cast<int>(chk_strlen(seg));
          let i <int> = 0;
          while (i < len) {
              let c <string> = substr(seg, i, 1);
              if (chk_str_eq(c, "(") || chk_str_eq(c, "=")) {
                  return substr(seg, 0, i);
              }
              i = i + 1;
          }
          return seg;
      }

      // The attribute argument: inside `(...)`, or after `=` with quotes
      // stripped. "" when bare.
      fun api_attr_arg(self: &Self, seg: string) <string> {
          let len <int> = cast<int>(chk_strlen(seg));
          let i <int> = 0;
          while (i < len) {
              if (chk_str_eq(substr(seg, i, 1), "(")) {
                  let start <int> = i + 1;
                  let depth <int> = 1;
                  let j <int> = start;
                  while (j < len && depth > 0) {
                      if (chk_str_eq(substr(seg, j, 1), "(")) { depth = depth + 1; }
                      else if (chk_str_eq(substr(seg, j, 1), ")")) { depth = depth - 1; }
                      j = j + 1;
                  }
                  return substr(seg, start, j - start - 1);
              }
              if (chk_str_eq(substr(seg, i, 1), "=")) {
                  let v <string> = substr(seg, i + 1, len - i - 1);
                  let vlen <int> = cast<int>(chk_strlen(v));
                  if (vlen >= 2 && chk_str_eq(substr(v, 0, 1), "\"") &&
                      chk_str_eq(substr(v, vlen - 1, 1), "\"")) {
                      return substr(v, 1, vlen - 2);
                  }
                  return v;
              }
              i = i + 1;
          }
          return "";
      }

      fun api_attr_has_arg(self: &Self, seg: string) <bool> {
          let len <int> = cast<int>(chk_strlen(seg));
          let i <int> = 0;
          while (i < len) {
              let c <string> = substr(seg, i, 1);
              if (chk_str_eq(c, "(") || chk_str_eq(c, "=")) { return true; }
              i = i + 1;
          }
          return false;
      }

      // Everything the corpus writes that another pass owns: accepted
      // silently, shape left to its reader (C++ isReaderOwnedAttribute).
      fun api_attr_reader_owned(self: &Self, name: string) <bool> {
          if (chk_str_eq(name, "llvm_name") || chk_str_eq(name, "stdimport") ||
              chk_str_eq(name, "global") || chk_str_eq(name, "type") ||
              chk_str_eq(name, "uncastable") || chk_str_eq(name, "RT") ||
              chk_str_eq(name, "overwrite") || chk_str_eq(name, "implements") ||
              chk_str_eq(name, "class") || chk_str_eq(name, "stderror") ||
              chk_str_eq(name, "slaveof") || chk_str_eq(name, "future") ||
              chk_str_eq(name, "anytype") || chk_str_eq(name, "typeinfo_class") ||
              chk_str_eq(name, "public") || chk_str_eq(name, "private") ||
              chk_str_eq(name, "debug") || chk_str_eq(name, "attribute")) {
              return true;
          }
          return false;
      }

      fun api_is_known_event(self: &Self, name: string) <bool> {
          if (chk_str_eq(name, "variable_declared") || chk_str_eq(name, "variable_scope_exit") ||
              chk_str_eq(name, "function_entry") || chk_str_eq(name, "function_exit") ||
              chk_str_eq(name, "assignment") || chk_str_eq(name, "allocation_site") ||
              chk_str_eq(name, "delete_site") || chk_str_eq(name, "struct_layout_deciding") ||
              chk_str_eq(name, "struct_layout_finalised") || chk_str_eq(name, "loop_back_edge") ||
              chk_str_eq(name, "generic_instantiated")) {
              return true;
          }
          return false;
      }

      fun api_has_grant(self: &Self, comp: string) <bool> {
          let i <int> = 0;
          while (i < self.grant_count) {
              if (chk_str_eq(self.grants[i], comp)) { return true; }
              i = i + 1;
          }
          return false;
      }

      fun api_require_grant(self: &Self, comp: string, line: int, col: int) <bool> {
          if (self.api_has_grant(comp)) { return true; }
          let b <Buffer> = new_buffer(96);
          b.write_string("Component '");
          b.write_string(comp);
          b.write_string("' is not granted here: add #[use(compiler.components.");
          b.write_string(comp);
          b.write_string(")]");
          let m <string> = b.to_string();
          free_buffer(b);
          self.report_error(m, line, col);
          return false;
      }

      // One `#[use(...)]` value: records the grant, or reports the
      // misspelling (C++ useGrantError + applyUseAttributes). A `use` of
      // something outside the compiler API is not ours to judge.
      fun api_apply_grant(self: &Self, v: string, line: int, col: int) <noret> {
          if (v == null || chk_strlen(v) == cast<ulong>(0)) { return; }
          if (chk_str_eq(v, "compiler")) {
              if (!self.api_has_grant("compiler") && self.grant_count < 8) {
                  self.grants[self.grant_count] = "compiler";
                  self.grant_count = self.grant_count + 1;
              }
              return;
          }
          if (!chk_str_starts_with(v, "compiler")) { return; }
          if (!chk_str_starts_with(v, "compiler.components.")) {
              let b <Buffer> = new_buffer(128);
              b.write_string("'");
              b.write_string(v);
              b.write_string("' is not a component reference: a grant is written #[use(compiler)] or #[use(compiler.components.<name>)]");
              let m <string> = b.to_string();
              free_buffer(b);
              self.report_error(m, line, col);
              return;
          }
          let rest <string> = substr(v, 20, cast<int>(chk_strlen(v)) - 20);
          if (chk_strlen(rest) == cast<ulong>(0) || chk_strchr(rest, 46) != null) {
              let b2 <Buffer> = new_buffer(128);
              b2.write_string("'");
              b2.write_string(v);
              b2.write_string("' is not a component reference: a component name has no dot in it (ADR 0012)");
              let m2 <string> = b2.to_string();
              free_buffer(b2);
              self.report_error(m2, line, col);
              return;
          }
          if (!self.api_is_component(rest)) {
              let b3 <Buffer> = new_buffer(96);
              b3.write_string("The compiler has no component '");
              b3.write_string(rest);
              b3.write_string("'");
              let m3 <string> = b3.to_string();
              free_buffer(b3);
              self.report_error(m3, line, col);
              return;
          }
          if (!self.api_has_grant(rest) && self.grant_count < 8) {
              self.grants[self.grant_count] = rest;
              self.grant_count = self.grant_count + 1;
          }
      }

      // Reads the `use` grants off a declaration's attribute text. Runs
      // before the body so `compiler` resolves inside it.
      fun api_parse_grants(self: &Self, attr_text: string, line: int, col: int) <noret> {
          if (attr_text == null || chk_strlen(attr_text) == cast<ulong>(0)) { return; }
          let n <int> = self.api_attr_count(attr_text, 8);
          let i <int> = 0;
          while (i < n) {
              let seg <string> = self.api_attr_seg(attr_text, i);
              if (chk_str_eq(self.api_attr_name(seg), "use")) {
                  self.api_apply_grant(self.api_attr_arg(seg), line, col);
              }
              i = i + 1;
          }
      }

      // One attribute segment, validated by name and shape (C++
      // visit(Attribute&)). `with_use` is false where api_parse_grants
      // already owned `use`; `is_special` is true on a `@special` only.
      fun api_validate_attr(self: &Self, seg: string, with_use: bool, is_special: bool, line: int, col: int) <noret> {
          let name <string> = self.api_attr_name(seg);
          let arg <string> = self.api_attr_arg(seg);
          if (chk_str_eq(name, "use")) {
              if (with_use) { self.api_apply_grant(arg, line, col); }
              return;
          }
          if (chk_str_eq(name, "export")) {
              if (self.api_attr_has_arg(seg)) {
                  self.report_error("Attribute 'export' takes no argument", line, col);
              }
              return;
          }
          if (chk_str_eq(name, "on")) {
              if (chk_strlen(arg) == cast<ulong>(0)) {
                  self.report_error("Attribute 'on' needs an event name: #[on(<event>)]", line, col);
                  return;
              }
              if (!self.api_is_known_event(arg)) {
                  let b <Buffer> = new_buffer(64);
                  b.write_string("Unknown event '");
                  b.write_string(arg);
                  b.write_string("'");
                  let m <string> = b.to_string();
                  free_buffer(b);
                  self.report_error(m, line, col);
              }
              return;
          }
          if (chk_str_eq(name, "provides") || chk_str_eq(name, "protocol")) {
              if (chk_strlen(arg) == cast<ulong>(0)) {
                  let b <Buffer> = new_buffer(64);
                  b.write_string("Attribute '");
                  b.write_string(name);
                  b.write_string("' needs a slot: #[");
                  b.write_string(name);
                  b.write_string("(<slot>)]");
                  let m <string> = b.to_string();
                  free_buffer(b);
                  self.report_error(m, line, col);
                  return;
              }
              if (chk_str_eq(name, "protocol")) {
                  if (!is_special) {
                      self.report_error("Only a `@special` function may claim a compiler protocol slot", line, col);
                      return;
                  }
                  if (!self.api_is_protocol_slot(arg)) {
                      let b2 <Buffer> = new_buffer(128);
                      b2.write_string("unknown protocol slot '");
                      b2.write_string(arg);
                      b2.write_string("' (expected move_or_copy, deallocate, lifetime, or destructor)");
                      let m2 <string> = b2.to_string();
                      free_buffer(b2);
                      self.report_error(m2, line, col);
                      return;
                  }
                  return;
              }
              if (chk_str_eq(name, "provides") && !is_special) {
                  self.report_error("Only a `@special` function may provide a compiler slot", line, col);
                  return;
              }
              if (!self.api_is_provider_slot(arg)) {
                  let b3 <Buffer> = new_buffer(64);
                  b3.write_string("Unknown provider slot '");
                  b3.write_string(arg);
                  b3.write_string("'");
                  let m3 <string> = b3.to_string();
                  free_buffer(b3);
                  self.report_error(m3, line, col);
              }
              return;
          }
          // Wave-5 slice 4: `#[slaveof(...)]` is a real rule, so its
          // shape is checked where every other attribute's is (C++
          // visit(Attribute&): flag-form, non-$Fin `$` lifetimes, and
          // dotted paths are refused here; the referent itself resolves at
          // the variable declaration, the only bearer with a scope).
          if (chk_str_eq(name, "slaveof")) {
              if (chk_strlen(arg) == cast<ulong>(0)) {
                  self.report_error("Attribute 'slaveof' needs a variable: #[slaveof(<variable>)] or #[slaveof($Fin)]", line, col);
                  return;
              }
              if (chk_str_starts_with(arg, "$") && !chk_str_eq(arg, "$Fin")) {
                  let b <Buffer> = new_buffer(96);
                  b.write_string("Unknown lifetime '");
                  b.write_string(arg);
                  b.write_string("' in #[slaveof(...)]: only $Fin pins to program exit");
                  let m <string> = b.to_string();
                  free_buffer(b);
                  self.report_error(m, line, col);
                  return;
              }
              if (chk_strchr(arg, 46) != null) {
                  let b2 <Buffer> = new_buffer(96);
                  b2.write_string("Attribute 'slaveof' names a variable: '");
                  b2.write_string(arg);
                  b2.write_string("' is not one");
                  let m2 <string> = b2.to_string();
                  free_buffer(b2);
                  self.report_error(m2, line, col);
                  return;
              }
              return;
          }
          if (self.api_attr_reader_owned(name)) { return; }
          let bu <Buffer> = new_buffer(64);
          bu.write_string("Unknown attribute '");
          bu.write_string(name);
          bu.write_string("'");
          let mu <string> = bu.to_string();
          free_buffer(bu);
          self.report_error(mu, line, col);
      }

      // Every attribute on the declaration, in order. Positions that bind
      // (`use` on a granted function) pass with_use=false.
      fun api_validate_attrs(self: &Self, attr_text: string, with_use: bool, is_special: bool, line: int, col: int) <noret> {
          if (attr_text == null || chk_strlen(attr_text) == cast<ulong>(0)) { return; }
          let n <int> = self.api_attr_count(attr_text, 16);
          let i <int> = 0;
          while (i < n) {
              self.api_validate_attr(self.api_attr_seg(attr_text, i), with_use, is_special, line, col);
              i = i + 1;
          }
      }

      // Wave-5 slice 4: the `#[slaveof(...)]` referent must name a live
      // binding (C++ visit(VariableDeclaration&)). Shape rode on
      // api_validate_attr above; what is checked here is that the name
      // resolves: a tie to a dead or unknown referent would dangle from
      // birth. Resolved before the binding is defined, so the name cannot
      // meet itself. `$Fin` pins to program exit and needs no referent.
      fun check_slaveof_tie(self: &Self, attr_text: string, name: string, line: int, col: int) <noret> {
          if (attr_text == null || chk_strlen(attr_text) == cast<ulong>(0)) { return; }
          let n <int> = self.api_attr_count(attr_text, 16);
          let ties <int> = 0;
          let i <int> = 0;
          while (i < n) {
              let seg <string> = self.api_attr_seg(attr_text, i);
              if (chk_str_eq(self.api_attr_name(seg), "slaveof")) {
                  ties = ties + 1;
                  if (ties > 1) {
                      let bd <Buffer> = new_buffer(96);
                      bd.write_string("A declaration ties its lifetime once: '#[slaveof]' is written twice on '");
                      bd.write_string(name);
                      bd.write_string("'");
                      let md <string> = bd.to_string();
                      free_buffer(bd);
                      self.report_error(md, line, col);
                  } else {
                      let arg <string> = self.api_attr_arg(seg);
                      if (chk_str_eq(arg, "$Fin")) {
                          // Pinned: no referent to resolve.
                      } else if (chk_strlen(arg) == cast<ulong>(0) || chk_str_starts_with(arg, "$") || chk_strchr(arg, 46) != null) {
                          // Malformed: api_validate_attr already reported it.
                      } else if (!self.current_scope.has(arg)) {
                          let b <Buffer> = new_buffer(160);
                          b.write_string("'#[slaveof(");
                          b.write_string(arg);
                          b.write_string(")]' on '");
                          b.write_string(name);
                          b.write_string("' names '");
                          b.write_string(arg);
                          b.write_string("', which is not in scope: tied storage outlives its referent, so a read through it would dangle");
                          let m <string> = b.to_string();
                          free_buffer(b);
                          self.report_error(m, line, col);
                      }
                  }
              }
              i = i + 1;
          }
      }

      fun api_is_provider_slot(self: &Self, slot: string) <bool> {
          if (chk_str_eq(slot, "type_metadata")) { return true; }
          return false;
      }

      fun api_is_protocol_slot(self: &Self, slot: string) <bool> {
          if (chk_str_eq(slot, "move_or_copy")) { return true; }
          if (chk_str_eq(slot, "deallocate")) { return true; }
          if (chk_str_eq(slot, "lifetime")) { return true; }
          if (chk_str_eq(slot, "destructor")) { return true; }
          return false;
      }

      // Whether an actual argument type fits an expected parameter spelling.
      // `any` and the turbofish `R` fit everything; `$struct` widens to
      // `$type`; a declared type's name read where a meta-type goes denotes
      // that type (Soundness_TypeAsValue); integers mix (literals); `void`,
      // `error` and `auto` ride on earlier diagnostics.
      fun api_arg_fits(self: &Self, expected: string, actual: string) <bool> {
          if (expected == null || actual == null) { return true; }
          if (chk_str_eq(expected, "any") || chk_str_eq(expected, "R")) { return true; }
          if (chk_str_eq(actual, "auto") || chk_str_eq(actual, "error") || chk_str_eq(actual, "void")) { return true; }
          if (chk_str_eq(expected, actual)) { return true; }
          if (chk_str_eq(expected, "$type")) {
              if (chk_str_eq(actual, "$struct")) { return true; }
              if (self.global_scope.has(actual)) {
                  let sym <Symbol> = self.global_scope.lookup(actual);
                  if (sym.kind == sym_struct() || sym.kind == sym_enum() ||
                      sym.kind == sym_interface() || sym.kind == sym_type_alias()) {
                      return true;
                  }
              }
              return false;
          }
          if (chk_str_eq(expected, "$struct") || chk_str_eq(expected, "$interface") ||
              chk_str_eq(expected, "$enum_member")) {
              if (self.global_scope.has(actual)) {
                  let sym2 <Symbol> = self.global_scope.lookup(actual);
                  if (sym2.kind == sym_struct() || sym2.kind == sym_enum() ||
                      sym2.kind == sym_interface() || sym2.kind == sym_type_alias()) {
                      return true;
                  }
              }
              return false;
          }
          if (chk_int_bits(expected) > 0 && chk_int_bits(actual) > 0) { return true; }
          return self.chk_types_compatible(actual, expected);
      }

      // The expected spelling of parameter i for the probed operations.
      // Only positions the corpus and probes exercise; anything else is
      // "" (unchecked).
      fun api_param_at(self: &Self, comp: string, member: string, idx: int) <string> {
          if (chk_str_eq(comp, "types")) {
              if (chk_str_eq(member, "cmp_types")) { return "$type"; }
              if (chk_str_eq(member, "ct_any")) { return "any"; }
              if (chk_str_eq(member, "typefrom_typeid")) { return "uint"; }
              if (chk_str_eq(member, "typeid_of")) { return "$type"; }
              if (chk_str_eq(member, "name_of")) { return "$type"; }
              if (chk_str_eq(member, "kind_of")) { return "$type"; }
              if (chk_str_eq(member, "is_comptime_type")) { return "$type"; }
              if (chk_str_eq(member, "implements")) {
                  if (idx == 1) { return "$interface"; }
                  return "$type";
              }
              return "";
          }
          if (chk_str_eq(comp, "structs")) {
              if (chk_str_eq(member, "select_field") || chk_str_eq(member, "has_field") ||
                  chk_str_eq(member, "field_count") || chk_str_eq(member, "field_type") ||
                  chk_str_eq(member, "field_visibility") || chk_str_eq(member, "has_destructor")) {
                  if (idx == 1) { return "string"; }
                  return "$struct";
              }
              return "";
          }
          if (chk_str_eq(comp, "enums")) {
              if (chk_str_eq(member, "resolve_id")) { return "any"; }
              if (chk_str_eq(member, "keyid_of")) { return "$enum_member"; }
              if (chk_str_eq(member, "payload_type")) { return "$enum_member"; }
              return "";
          }
          if (chk_str_eq(comp, "system")) {
              if (chk_str_eq(member, "get_total_memory") || chk_str_eq(member, "get_available_memory")) {
                  return "uint";
              }
              return "";
          }
          if (chk_str_eq(comp, "layout")) {
              if (chk_str_eq(member, "size_of") || chk_str_eq(member, "align_of") ||
                  chk_str_eq(member, "pointer_count") || chk_str_eq(member, "pointer_map_quote") ||
                  chk_str_eq(member, "is_layout_final")) {
                  return "$type";
              }
              if (chk_str_eq(member, "pointer_offset_at") || chk_str_eq(member, "pointee_type_at")) {
                  if (idx == 1) { return "int"; }
                  return "$type";
              }
              if (chk_str_eq(member, "offset_of")) {
                  if (idx == 1) { return "string"; }
                  return "$struct";
              }
              if (chk_str_eq(member, "request_header_words") || chk_str_eq(member, "request_min_align")) {
                  if (idx == 1) { return "uint"; }
                  return "$struct";
              }
              return "";
          }
          if (chk_str_eq(comp, "diag")) { return "string"; }
          return "";
      }

      // A `compiler.C.M(...)` call: grant, member, turbofish, arity,
      // argument types. Returns the result spelling, or "error".
      fun api_check_call(self: &Self, comp: string, member: string, turbofish: string, arg_head: &AstNode, line: int, col: int) <string> {
          let full_buf <Buffer> = new_buffer(64);
          full_buf.write_string("compiler.");
          full_buf.write_string(comp);
          full_buf.write_char('.');
          full_buf.write_string(member);
          let full <string> = full_buf.to_string();
          free_buffer(full_buf);
          if (!self.api_require_grant(comp, line, col)) {
              self.api_walk_args(arg_head);
              return "error";
          }
          let packed <int> = self.api_member_packed(comp, member);
          if (packed < 0) {
              let b <Buffer> = new_buffer(96);
              b.write_string("Component '");
              b.write_string(comp);
              b.write_string("' has no member '");
              b.write_string(member);
              b.write_string("'");
              let m <string> = b.to_string();
              free_buffer(b);
              self.report_error(m, line, col);
              self.api_walk_args(arg_head);
              return "error";
          }
          let arity <int> = packed / 2;
          let is_const <bool> = (packed - arity * 2) == 1;
          if (is_const) {
              let b2 <Buffer> = new_buffer(96);
              b2.write_string("'");
              b2.write_string(full);
              b2.write_string("' is a constant, not a function");
              let m2 <string> = b2.to_string();
              free_buffer(b2);
              self.report_error(m2, line, col);
              self.api_walk_args(arg_head);
              return "error";
          }
          if (chk_str_eq(member, "select_field") || chk_str_eq(member, "gettype")) {
              if (turbofish == null || chk_strlen(turbofish) == cast<ulong>(0)) {
                  let b3 <Buffer> = new_buffer(96);
                  b3.write_string("'");
                  b3.write_string(full);
                  b3.write_string("' needs a type argument: it is written ");
                  b3.write_string(member);
                  b3.write_string("::<T>(...)");
                  let m3 <string> = b3.to_string();
                  free_buffer(b3);
                  self.report_error(m3, line, col);
                  self.api_walk_args(arg_head);
                  return "error";
              }
          }
          let actual <int> = self.count_call_args(arg_head, false);
          self.check_arity("Operation", full, arity, arity, actual, line, col);
          let ai <int> = 0;
          let a_cur <&AstNode> = arg_head;
          while (a_cur != null) {
              let actual_arg <&AstNode> = a_cur.left;
              if (actual_arg == null) { actual_arg = a_cur; }
              let at <string> = self.check_expression(actual_arg);
              if (ai < arity) {
                  let exp <string> = self.api_param_at(comp, member, ai);
                  if (exp != null && chk_strlen(exp) > cast<ulong>(0)) {
                      if (!self.api_arg_fits(exp, at)) {
                          self.report_type_mismatch(exp, at, actual_arg.line, actual_arg.col);
                      }
                  }
              }
              ai = ai + 1;
              a_cur = a_cur.right;
          }
          return self.api_member_ret(comp, member, turbofish);
      }

      // Whether the receiver is rooted at `compiler`: the leftmost
      // identifier names it.
      fun api_compiler_root(self: &Self, node: &AstNode) <bool> {
          if (node == null) { return false; }
          if (node.kind == ast_ident()) { return chk_str_eq(node.name, "compiler"); }
          if (node.kind == ast_member_access()) { return self.api_compiler_root(node.left); }
          return false;
      }

      // A `compiler...(...)` call, dispatched by layer (C++
      // resolveCompilerApi): the grant layer, references, and operations.
      // Returns the result spelling, or "error".
      fun api_dispatch_call(self: &Self, recv: string, expr: &AstNode) <string> {
          let member <string> = expr.name;
          // An unreadable path already reported (unknown component): walk
          // the arguments for their own diagnostics and stop.
          if (chk_str_eq(recv, "error")) {
              self.api_walk_args(expr.left);
              return "error";
          }
          let turbo <string> = expr.type_annotation;
          if (turbo == null) { turbo = ""; }
          // Inside a function or handler body, `enable` is refused: arming
          // is a top-level phase (C++ ArmFinder).
          if ((chk_str_eq(recv, "compiler.events") && chk_str_eq(member, "enable")) ||
              (chk_str_eq(recv, "compiler") && chk_str_eq(member, "events"))) {
              if (self.in_function != 0 && chk_str_eq(member, "enable")) {
                  self.report_error("'compiler.events.enable' is legal only as a top-level statement (the arm phase): it cannot be called from inside a function or handler body", expr.line, expr.col);
                  self.api_walk_args(expr.left);
                  return "error";
              }
          }
          if (chk_str_eq(recv, "compiler")) {
              if (chk_str_eq(member, "components")) {
                  self.api_walk_args(expr.left);
                  self.report_error("'compiler.components' is the grant layer, not a function", expr.line, expr.col);
                  return "error";
              }
              if (!self.api_is_component(member)) {
                  self.api_walk_args(expr.left);
                  let b <Buffer> = new_buffer(64);
                  b.write_string("The compiler has no component '");
                  b.write_string(member);
                  b.write_string("'");
                  let m <string> = b.to_string();
                  free_buffer(b);
                  self.report_error(m, expr.line, expr.col);
                  return "error";
              }
              if (!self.api_require_grant(member, expr.line, expr.col)) {
                  self.api_walk_args(expr.left);
                  return "error";
              }
              self.api_walk_args(expr.left);
              let b2 <Buffer> = new_buffer(96);
              b2.write_string("'compiler.");
              b2.write_string(member);
              b2.write_string("' is a component, not a function");
              let m2 <string> = b2.to_string();
              free_buffer(b2);
              self.report_error(m2, expr.line, expr.col);
              return "error";
          }
          if (chk_str_eq(recv, "compiler.components")) {
              self.api_walk_args(expr.left);
              let b3 <Buffer> = new_buffer(128);
              b3.write_string("'compiler.components.");
              b3.write_string(member);
              b3.write_string("' is a component reference, not a function (ADR 0012: the segment after `components` is a component name)");
              let m3 <string> = b3.to_string();
              free_buffer(b3);
              self.report_error(m3, expr.line, expr.col);
              return "error";
          }
          if (chk_str_starts_with(recv, "compiler.components.")) {
              let cname <string> = substr(recv, 20, cast<int>(chk_strlen(recv)) - 20);
              let actual <int> = self.count_call_args(expr.left, false);
              // The receiver is the first written argument.
              let nargs <int> = actual - 1;
              if (nargs < 0) { nargs = 0; }
              let op_full <Buffer> = new_buffer(64);
              op_full.write_string("compiler.components.");
              op_full.write_string(cname);
              op_full.write_char('.');
              op_full.write_string(member);
              let op_name <string> = op_full.to_string();
              free_buffer(op_full);
              if (chk_str_eq(member, "present") || chk_str_eq(member, "granted")) {
                  self.check_arity("Operation", op_name, 0, 0, nargs, expr.line, expr.col);
                  self.api_walk_args(expr.left);
                  return "bool";
              }
              if (chk_str_eq(member, "version")) {
                  self.check_arity("Operation", op_name, 0, 0, nargs, expr.line, expr.col);
                  self.api_walk_args(expr.left);
                  return "int";
              }
              if (chk_str_eq(member, "name")) {
                  self.check_arity("Operation", op_name, 0, 0, nargs, expr.line, expr.col);
                  self.api_walk_args(expr.left);
                  return "string";
              }
              self.api_walk_args(expr.left);
              let b4 <Buffer> = new_buffer(160);
              b4.write_string("A component reference has no member '");
              b4.write_string(member);
              b4.write_string("': `compiler.components.");
              b4.write_string(cname);
              b4.write_string("` answers present, version, granted and name (ADR 0012)");
              let m4 <string> = b4.to_string();
              free_buffer(b4);
              self.report_error(m4, expr.line, expr.col);
              return "error";
          }
          if (chk_str_starts_with(recv, "compiler.")) {
              let rest <string> = substr(recv, 9, cast<int>(chk_strlen(recv)) - 9);
              let dot <int> = -1;
              let rlen <int> = cast<int>(chk_strlen(rest));
              let ri <int> = 0;
              while (ri < rlen) {
                  if (chk_str_eq(substr(rest, ri, 1), ".")) { dot = ri; break; }
                  ri = ri + 1;
              }
              let comp <string> = rest;
              if (dot >= 0) { comp = substr(rest, 0, dot); }
              if (!self.api_is_component(comp)) {
                  self.api_walk_args(expr.left);
                  let b5 <Buffer> = new_buffer(64);
                  b5.write_string("The compiler has no component '");
                  b5.write_string(comp);
                  b5.write_string("'");
                  let m5 <string> = b5.to_string();
                  free_buffer(b5);
                  self.report_error(m5, expr.line, expr.col);
                  return "error";
              }
              if (dot >= 0) {
                  // A deeper path is not a member.
                  self.api_walk_args(expr.left);
                  let b6 <Buffer> = new_buffer(96);
                  b6.write_string("Component '");
                  b6.write_string(comp);
                  b6.write_string("' has no member '");
                  b6.write_string(member);
                  b6.write_string("'");
                  let m6 <string> = b6.to_string();
                  free_buffer(b6);
                  self.report_error(m6, expr.line, expr.col);
                  return "error";
              }
              // Top-level `enable` is the Arm phase's: arity only, no
              // grant (C++ consumes it before analysis). The handler
              // identity is the top-level statement's check.
              if (chk_str_eq(comp, "events") && chk_str_eq(member, "enable") && self.in_function == 0) {
                  let actual2 <int> = self.count_call_args(expr.left, false);
                  let nargs2 <int> = actual2 - 1;
                  if (nargs2 < 0) { nargs2 = 0; }
                  if (nargs2 != 1) {
                      self.report_error("'compiler.events.enable' takes exactly one argument: the handler to arm", expr.line, expr.col);
                  }
                  self.api_walk_args(expr.left);
                  return "void";
              }
              // The receiver is the first written argument; drop it.
              let args2 <&AstNode> = expr.left;
              if (args2 != null) { args2 = args2.right; }
              return self.api_check_call(comp, member, turbo, args2, expr.line, expr.col);
          }
          self.api_walk_args(expr.left);
          return "auto";
      }

      fun api_walk_args(self: &Self, arg_head: &AstNode) <noret> {
          let a <&AstNode> = arg_head;
          let first_arg <bool> = true;
          while (a != null) {
              let actual_arg <&AstNode> = a.left;
              if (actual_arg == null) { actual_arg = a; }
              // The desugared receiver (`compiler...`) is validated by the
              // dispatcher, not as an independent expression: walking it
              // here would report its grants twice, or demand grants the
              // Arm phase never needs.
              if (first_arg && self.api_is_compiler_path(actual_arg)) {
                  a = a.right;
                  first_arg = false;
                  continue;
              }
              first_arg = false;
              self.check_expression(actual_arg);
              a = a.right;
          }
      }

      // Whether the node is a `compiler`-rooted path (identifier or member
      // chain), i.e. a desugared receiver rather than a value.
      fun api_is_compiler_path(self: &Self, node: &AstNode) <bool> {
          if (node == null) { return false; }
          if (node.kind == ast_ident()) { return chk_str_eq(node.name, "compiler"); }
          if (node.kind == ast_member_access()) { return self.api_compiler_root(node.left); }
          return false;
      }

      // A `compiler...` path read as a value (not called): the grant layer
      // needs nothing, anything else needs its grant (C++ Layer 1+4).
      // Pure when quiet (the call path owns the diagnostic).
      fun api_check_read(self: &Self, path: string, member: string, line: int, col: int) <string> {
          if (chk_str_eq(path, "compiler")) {
              if (chk_str_eq(member, "components")) { return "compiler.components"; }
              if (!self.api_is_component(member)) {
                  // Unknown components report here, even quietly: the
                  // dispatcher cannot proceed off an "error" path, so this
                  // is the single diagnostic either way.
                  let b <Buffer> = new_buffer(64);
                  b.write_string("The compiler has no component '");
                  b.write_string(member);
                  b.write_string("'");
                  let m <string> = b.to_string();
                  free_buffer(b);
                  self.report_error(m, line, col);
                  return "error";
              }
              if (self.quiet_compiler == 0) {
                  if (!self.api_require_grant(member, line, col)) { return "error"; }
              }
              let pb <Buffer> = new_buffer(32);
              pb.write_string("compiler.");
              pb.write_string(member);
              let p <string> = pb.to_string();
              free_buffer(pb);
              return p;
          }
          if (chk_str_eq(path, "compiler.components")) {
              let pb2 <Buffer> = new_buffer(48);
              pb2.write_string("compiler.components.");
              pb2.write_string(member);
              let p2 <string> = pb2.to_string();
              free_buffer(pb2);
              return p2;
          }
          if (chk_str_starts_with(path, "compiler.components.")) {
              let cname <string> = substr(path, 20, cast<int>(chk_strlen(path)) - 20);
              if (chk_str_eq(member, "present") || chk_str_eq(member, "granted")) { return "bool"; }
              if (chk_str_eq(member, "version")) { return "int"; }
              if (chk_str_eq(member, "name")) { return "string"; }
              if (self.quiet_compiler == 0) {
                  let b3 <Buffer> = new_buffer(160);
                  b3.write_string("A component reference has no member '");
                  b3.write_string(member);
                  b3.write_string("': `compiler.components.");
                  b3.write_string(cname);
                  b3.write_string("` answers present, version, granted and name (ADR 0012)");
                  let m3 <string> = b3.to_string();
                  free_buffer(b3);
                  self.report_error(m3, line, col);
              }
              return "error";
          }
          if (chk_str_starts_with(path, "compiler.")) {
              let comp <string> = substr(path, 9, cast<int>(chk_strlen(path)) - 9);
              let packed <int> = self.api_member_packed(comp, member);
              if (packed < 0) {
                  if (self.quiet_compiler == 0) {
                      let b4 <Buffer> = new_buffer(96);
                      b4.write_string("Component '");
                      b4.write_string(comp);
                      b4.write_string("' has no member '");
                      b4.write_string(member);
                      b4.write_string("'");
                      let m4 <string> = b4.to_string();
                      free_buffer(b4);
                      self.report_error(m4, line, col);
                  }
                  return "error";
              }
              if (self.quiet_compiler == 0) {
                  if (!self.api_require_grant(comp, line, col)) { return "error"; }
              }
              return self.api_member_ret(comp, member, "");
          }
          return "auto";
      }

      // The event payload table: (params...) <quote>, one row per event
      // with a checked shape (W5, W6, W7, W10). `struct_layout_deciding`
      // and `generic_instantiated` are collected but never signature-checked.
      // Three queries over the 9 checked rows (the language has no tuples):
      // param count (-1 when unchecked), "name: type" per index, and the
      // expected signature text for the diagnostic.
      fun api_event_pcount(self: &Self, event: string) <int> {
          if (chk_str_eq(event, "struct_layout_finalised")) { return 1; }
          if (chk_str_eq(event, "variable_declared")) { return 3; }
          if (chk_str_eq(event, "function_entry")) { return 1; }
          if (chk_str_eq(event, "function_exit")) { return 2; }
          if (chk_str_eq(event, "assignment")) { return 3; }
          if (chk_str_eq(event, "allocation_site")) { return 3; }
          if (chk_str_eq(event, "delete_site")) { return 2; }
          if (chk_str_eq(event, "variable_scope_exit")) { return 4; }
          if (chk_str_eq(event, "loop_back_edge")) { return 1; }
          return -1;
      }

      fun api_event_ptype(self: &Self, event: string, idx: int) <string> {
          if (chk_str_eq(event, "struct_layout_finalised")) { return "s: $struct"; }
          if (chk_str_eq(event, "variable_declared")) {
              if (idx == 0) { return "name: string"; }
              if (idx == 1) { return "t: $type"; }
              return "is_mutable: bool";
          }
          if (chk_str_eq(event, "function_entry")) { return "f: function"; }
          if (chk_str_eq(event, "function_exit")) {
              if (idx == 0) { return "f: function"; }
              return "exit_kind: int";
          }
          if (chk_str_eq(event, "assignment")) {
              if (idx == 0) { return "target: quote"; }
              if (idx == 1) { return "value: quote"; }
              return "t: $type";
          }
          if (chk_str_eq(event, "allocation_site")) {
              if (idx == 0) { return "t: $type"; }
              if (idx == 1) { return "count: quote"; }
              return "dest: quote";
          }
          if (chk_str_eq(event, "delete_site")) {
              if (idx == 0) { return "t: $type"; }
              return "ptr: quote";
          }
          if (chk_str_eq(event, "variable_scope_exit")) {
              if (idx == 0) { return "name: string"; }
              if (idx == 1) { return "t: $type"; }
              if (idx == 2) { return "exit_kind: int"; }
              return "moved: int";
          }
          if (chk_str_eq(event, "loop_back_edge")) { return "depth: int"; }
          return "";
      }

      fun api_event_sig(self: &Self, event: string) <string> {
          let sb <Buffer> = new_buffer(96);
          sb.write_char('(');
          let n <int> = self.api_event_pcount(event);
          let i <int> = 0;
          while (i < n) {
              if (i > 0) { sb.write_string(", "); }
              sb.write_string(self.api_event_ptype(event, i));
              i = i + 1;
          }
          sb.write_string(") <quote>");
          let s <string> = sb.to_string();
          free_buffer(sb);
          return s;
      }

      // Whether a handler declaration matches its event's payload: same
      // arity, same parameter types in order, `quote` out. Reports the
      // C++ wrong-payload diagnostic naming both shapes.
      fun api_check_handler_payload(self: &Self, fn_node: &AstNode, event: string) <noret> {
          let n <int> = self.api_event_pcount(event);
          if (n < 0) { return; }
          let wrote_b <Buffer> = new_buffer(96);
          wrote_b.write_char('(');
          let pi <int> = 0;
          let p_cur <&AstNode> = fn_node.extra;
          let match <bool> = true;
          while (p_cur != null || pi < n) {
              if (pi > 0) { wrote_b.write_char(','); wrote_b.write_char(' '); }
              if (p_cur != null && pi < n) {
                  wrote_b.write_string(p_cur.name);
                  wrote_b.write_string(": ");
                  let pa <string> = p_cur.type_annotation;
                  if (pa == null) { pa = ""; }
                  wrote_b.write_string(pa);
                  let exp_full <string> = self.api_event_ptype(event, pi);
                  let exp_ty <string> = self.api_ptype_after_colon(exp_full);
                  // Types and arity only, like C++ signatureMatches:
                  // parameter names are the handler's own.
                  if (!chk_str_eq(pa, exp_ty)) {
                      match = false;
                  }
              } else {
                  match = false;
                  if (p_cur != null) {
                      wrote_b.write_string(p_cur.name);
                      wrote_b.write_string(": ");
                      let pa2 <string> = p_cur.type_annotation;
                      if (pa2 == null) { pa2 = ""; }
                      wrote_b.write_string(pa2);
                  } else {
                      wrote_b.write_string("?");
                  }
              }
              if (p_cur != null) { p_cur = p_cur.right; }
              pi = pi + 1;
          }
          wrote_b.write_string(") <");
          let ra <string> = fn_node.type_annotation;
          if (ra == null) { ra = ""; }
          wrote_b.write_string(ra);
          wrote_b.write_char('>');
          let wrote <string> = wrote_b.to_string();
          free_buffer(wrote_b);
          if (!chk_str_eq(ra, "quote")) { match = false; }
          if (!match) {
              let b <Buffer> = new_buffer(256);
              b.write_string("Handler '");
              b.write_string(fn_node.name);
              b.write_string("' for event '");
              b.write_string(event);
              b.write_string("' has the wrong payload: expected ");
              b.write_string(self.api_event_sig(event));
              b.write_string(", wrote ");
              b.write_string(wrote);
              let m <string> = b.to_string();
              free_buffer(b);
              self.report_error(m, fn_node.line, fn_node.col);
          }
      }

      fun api_ptype_after_colon(self: &Self, s: string) <string> {
          let len <int> = cast<int>(chk_strlen(s));
          let i <int> = 0;
          while (i < len) {
              if (chk_str_eq(substr(s, i, 1), ":")) {
                  return substr(s, i + 2, len - i - 2);
              }
              i = i + 1;
          }
          return s;
      }

      fun api_ptype_before_colon(self: &Self, s: string) <string> {
          let len <int> = cast<int>(chk_strlen(s));
          let i <int> = 0;
          while (i < len) {
              if (chk_str_eq(substr(s, i, 1), ":")) {
                  return substr(s, 0, i);
              }
              i = i + 1;
          }
          return s;
      }

      // The interpretability line as a walk: the first control-flow form in
      // a handler body, by its source spelling (C++ FlowWalker/LineWalker).
      fun api_flow_in_block(self: &Self, blk: &AstNode) <string> {
          let cur <&AstNode> = blk;
          while (cur != null) {
              let stmt <&AstNode> = cur.left;
              if (stmt == null) { stmt = cur; }
              let f <string> = self.api_flow_in_stmt(stmt);
              if (!chk_str_eq(f, "")) { return f; }
              cur = cur.right;
          }
          return "";
      }

      fun api_flow_in_stmt(self: &Self, stmt: &AstNode) <string> {
          if (stmt == null) { return ""; }
          if (stmt.kind == ast_if_stmt()) { return "if"; }
          if (stmt.kind == ast_while_stmt()) { return "while"; }
          if (stmt.kind == ast_for_stmt()) { return "for"; }
          if (stmt.kind == ast_block()) { return self.api_flow_in_block(stmt.left); }
          // if/else branches, while bodies, nested blocks.
          if (stmt.left != null) {
              let f <string> = self.api_flow_in_stmt(stmt.left);
              if (!chk_str_eq(f, "")) { return f; }
          }
          if (stmt.right != null) {
              let f2 <string> = self.api_flow_in_stmt(stmt.right);
              if (!chk_str_eq(f2, "")) { return f2; }
          }
          if (stmt.extra != null) {
              let f3 <string> = self.api_flow_in_stmt(stmt.extra);
              if (!chk_str_eq(f3, "")) { return f3; }
          }
          return "";
      }

      fun api_check_handler_flow(self: &Self, fn_node: &AstNode, event: string) <noret> {
          if (fn_node.left == null) { return; }
          let f <string> = self.api_flow_in_stmt(fn_node.left);
          if (chk_str_eq(f, "")) { return; }
          let b <Buffer> = new_buffer(160);
          b.write_string("Handler '");
          b.write_string(fn_node.name);
          b.write_string("' for event '");
          b.write_string(event);
          b.write_string("' uses control flow ('");
          b.write_string(f);
          b.write_string("'): handlers hold no control flow (the interpretability line)");
          let m <string> = b.to_string();
          free_buffer(b);
          self.report_error(m, fn_node.line, fn_node.col);
      }

      // The provider contract (C++ collectProvider, ADR 0014): exactly one
      // slot, one `$struct` subject in, one `quote` out, exclusivity per
      // slot, and the straight-line projection body. Runs only on `@special`.
      fun api_check_provider(self: &Self, fn_node: &AstNode, attr_text: string) <noret> {
          let slot1 <string> = "";
          let slot2 <string> = "";
          let nprov <int> = 0;
          let n <int> = self.api_attr_count(attr_text, 8);
          let i <int> = 0;
          while (i < n) {
              let seg <string> = self.api_attr_seg(attr_text, i);
              if (chk_str_eq(self.api_attr_name(seg), "provides")) {
                  let s <string> = self.api_attr_arg(seg);
                  if (chk_strlen(s) > cast<ulong>(0) && self.api_is_provider_slot(s)) {
                      if (nprov == 0) { slot1 = s; }
                      else if (nprov == 1) { slot2 = s; }
                      nprov = nprov + 1;
                  }
              }
              i = i + 1;
          }
          if (nprov == 0) { return; }
          if (nprov > 1) {
              let b <Buffer> = new_buffer(128);
              b.write_string("A provider claims exactly one slot: '@");
              b.write_string(fn_node.name);
              b.write_string("' provides '");
              b.write_string(slot1);
              b.write_string("' and '");
              b.write_string(slot2);
              b.write_string("'");
              let m <string> = b.to_string();
              free_buffer(b);
              self.report_error(m, fn_node.line, fn_node.col);
              return;
          }
          let np <int> = self.count_fn_params(fn_node);
          if (np != 1) {
              let b2 <Buffer> = new_buffer(128);
              b2.write_string("A provider for slot '");
              b2.write_string(slot1);
              b2.write_string("' takes exactly one subject: '@");
              b2.write_string(fn_node.name);
              b2.write_string("' takes ");
              b2.write_int(np);
              let m2 <string> = b2.to_string();
              free_buffer(b2);
              self.report_error(m2, fn_node.line, fn_node.col);
              return;
          }
          let subj <&AstNode> = fn_node.extra;
          let subj_ty <string> = "";
          let subj_nm <string> = "";
          if (subj != null) {
              subj_ty = subj.type_annotation;
              subj_nm = subj.name;
          }
          if (!chk_str_eq(subj_ty, "$struct")) {
              let b3 <Buffer> = new_buffer(96);
              b3.write_string("A provider for slot '");
              b3.write_string(slot1);
              b3.write_string("' takes its subject as '<$struct>'");
              let m3 <string> = b3.to_string();
              free_buffer(b3);
              self.report_error(m3, fn_node.line, fn_node.col);
              return;
          }
          let ret_ann <string> = fn_node.type_annotation;
          if (!chk_str_eq(ret_ann, "quote")) {
              let b4 <Buffer> = new_buffer(96);
              b4.write_string("A provider for slot '");
              b4.write_string(slot1);
              b4.write_string("' returns '<quote>'");
              let m4 <string> = b4.to_string();
              free_buffer(b4);
              self.report_error(m4, fn_node.line, fn_node.col);
              return;
          }
          let ci <int> = 0;
          while (ci < self.prov_count) {
              if (chk_str_eq(self.prov_slots[ci], slot1)) {
                  let b5 <Buffer> = new_buffer(192);
                  b5.write_string("Slot '");
                  b5.write_string(slot1);
                  b5.write_string("' already has a provider: '@");
                  b5.write_string(self.prov_names[ci]);
                  b5.write_string("' provides it, so '@");
                  b5.write_string(fn_node.name);
                  b5.write_string("' cannot. A slot has exactly one provider (ADR 0014)");
                  let m5 <string> = b5.to_string();
                  free_buffer(b5);
                  self.report_error(m5, fn_node.line, fn_node.col);
                  return;
              }
              ci = ci + 1;
          }
          if (!self.api_is_straight_answer(fn_node, subj_nm)) {
              let b6 <Buffer> = new_buffer(192);
              b6.write_string("A provider for slot '");
              b6.write_string(slot1);
              b6.write_string("' is a straight-line answer: 'return compiler.layout.pointer_map_quote(<subject>);' and nothing else (the interpretability line is held: no loops, no arithmetic)");
              let m6 <string> = b6.to_string();
              free_buffer(b6);
              self.report_error(m6, fn_node.line, fn_node.col);
              return;
          }
          if (self.prov_count < 8) {
              self.prov_slots[self.prov_count] = slot1;
              self.prov_names[self.prov_count] = fn_node.name;
              self.prov_count = self.prov_count + 1;
          }
      }

      // True when a destructor claimant's quote names `self`: the generation
      // lowers once, as a shared function with no receiver, for every
      // claimed type alike, so a subject-relative name has nothing to bind
      // to. Parameters do not bind either (the interpreter gap): the
      // subject parameter is refused below, and any other undeclared
      // name reports at claim time above.
      fun chk_quote_names_self(self: &Self, node: &AstNode) <bool> {
          if (node == null) { return false; }
          if (node.kind == ast_ident() && chk_str_eq(node.name, "self")) { return true; }
          if (self.chk_quote_names_self(node.left)) { return true; }
          if (self.chk_quote_names_self(node.right)) { return true; }
          return self.chk_quote_names_self(node.extra);
      }

      // Mirror of the C++ backend's body resolution for names that can
      // never bind in a quote: the backend walks a quote block as live
      // code with the declaration's parameters in scope (C++
      // visit(QuoteExpression)), while the statement checker never
      // enters quotes (a quote is data until spliced). Each undeclared
      // use inside a quote -- `self` included, with the body's own
      // message -- is reported here, exactly once. Expression-only:
      // types and member names are their own lanes and are not guessed
      // here; callee names resolve in chk_report_quote_call below.
      // Callers hold the declaration's scope:
      // protocol claims enter one with their parameters (the visit's
      // defineParameter), body-time calls run with the live one.
      fun chk_report_quote_uses(self: &Self, node: &AstNode) <noret> {
          if (node == null) { return; }
          if (node.kind == ast_quote_expr()) {
              self.chk_report_quote_inner_uses(node.left);
              self.chk_report_quote_inner_uses(node.right);
              self.chk_report_quote_inner_uses(node.extra);
              return;
          }
          self.chk_report_quote_uses(node.left);
          self.chk_report_quote_uses(node.right);
          self.chk_report_quote_uses(node.extra);
      }

      fun chk_report_quote_inner_uses(self: &Self, node: &AstNode) <noret> {
          if (node == null) { return; }
          if (node.kind == ast_quote_expr()) {
              self.enter_scope();
              self.chk_report_quote_inner_uses(node.left);
              self.chk_report_quote_inner_uses(node.right);
              self.chk_report_quote_inner_uses(node.extra);
              self.exit_scope();
              return;
          }
          if (node.kind == ast_block()) {
              self.enter_scope();
              self.chk_report_quote_inner_uses(node.left);
              self.chk_report_quote_inner_uses(node.right);
              self.chk_report_quote_inner_uses(node.extra);
              self.exit_scope();
              return;
          }
          if (node.kind == ast_var_decl()) {
              // The binding meets its uses in order: the initialiser is
              // resolved before the name exists (C++
              // visit(VariableDeclaration)), the statements after it see
              // it.
              self.chk_report_quote_inner_uses(node.left);
              if (node.name != null && chk_strlen(node.name) > cast<ulong>(0) &&
                  !chk_str_eq(node.name, "_") && !chk_str_eq(node.name, "_?")) {
                  let vt <string> = node.type_annotation;
                  if (vt == null) { vt = "auto"; }
                  self.current_scope.insert_symbol(make_var_sym(node.name, vt, true));
              }
              self.chk_report_quote_inner_uses(node.right);
              self.chk_report_quote_inner_uses(node.extra);
              return;
          }
          if (node.kind == ast_fun_decl()) {
              // A nested definition binds its name around it and its
              // parameters inside it, like the body's own check.
              if (node.name != null && chk_strlen(node.name) > cast<ulong>(0)) {
                  self.current_scope.insert_symbol(make_fn_sym(node.name, node.type_annotation, true));
              }
              self.enter_scope();
              let p_cur <&AstNode> = node.extra;
              while (p_cur != null) {
                  if (p_cur.name != null && chk_strlen(p_cur.name) > cast<ulong>(0)) {
                      let pt <string> = p_cur.type_annotation;
                      if (pt == null) { pt = "auto"; }
                      self.current_scope.insert_symbol(make_var_sym(p_cur.name, pt, false));
                  }
                  p_cur = p_cur.right;
              }
              self.chk_report_quote_inner_uses(node.left);
              self.exit_scope();
              self.chk_report_quote_inner_uses(node.right);
              self.chk_report_quote_inner_uses(node.extra);
              return;
          }
          if (node.kind == ast_call_expr()) {
              self.chk_report_quote_call(node);
              return;
          }
          if (node.kind == ast_ident()) {
              self.chk_report_quote_ident(node);
              return;
          }
          self.chk_report_quote_inner_uses(node.left);
          self.chk_report_quote_inner_uses(node.right);
          self.chk_report_quote_inner_uses(node.extra);
      }

      // One identifier use inside a quote: the body's own undeclared
      // diagnostic when no scope binds it. `compiler` reads are the API
      // checks' own lane; literals and placeholders never report.
      fun chk_report_quote_ident(self: &Self, node: &AstNode) <noret> {
          let nm <string> = node.name;
          if (nm == null || chk_strlen(nm) == cast<ulong>(0)) { return; }
          if (chk_str_eq(nm, "true") || chk_str_eq(nm, "false") ||
              chk_str_eq(nm, "NULL") || chk_str_eq(nm, "null") ||
              chk_str_eq(nm, "m1778") || chk_str_eq(nm, "_") || chk_str_eq(nm, "_?")) { return; }
          if (chk_str_eq(nm, "compiler")) { return; }
          if (self.current_scope.has(nm)) { return; }
          if (chk_strlen(self.current_struct) > cast<ulong>(0)) {
              let fb <Buffer> = new_buffer(64);
              fb.write_string(self.current_struct);
              fb.write_char('_');
              fb.write_string(nm);
              let fq <string> = fb.to_string();
              free_buffer(fb);
              if (self.global_scope.has(fq)) { return; }
          }
          self.report_error("use of undeclared identifier", node.line, node.col);
      }

      // One call use inside a quote: the callee-name lane the statement
      // checker never walks (a quote is data until spliced) but the
      // backend resolves as live code (C++ visit(QuoteExpression) walks
      // the block, reporting `Undefined function or type`). An
      // undeclared free callee reports here, exactly once, in the
      // checker's own call wording; its arguments are not walked (C++
      // returns before checking them, so one mistake stays one
      // diagnostic). Anything method-shaped defers to its own lane and
      // only its receiver and arguments are walked below.
      fun chk_report_quote_call(self: &Self, node: &AstNode) <noret> {
          let nm <string> = node.name;
          if (nm == null || chk_strlen(nm) == cast<ulong>(0)) {
              self.chk_report_quote_inner_uses(node.left);
              self.chk_report_quote_inner_uses(node.right);
              self.chk_report_quote_inner_uses(node.extra);
              return;
          }
          // Own lanes, never the callee check (mirrors check_expression's
          // early returns): intrinsics, `@`-calls, `!` macros, scoped `::`.
          if (chk_str_eq(nm, "sizeof") || chk_str_eq(nm, "move") ||
              chk_str_starts_with(nm, "@") || chk_str_starts_with(nm, "__fin_") ||
              chk_strchr(nm, 33) != null || chk_strchr(nm, 58) != null) {
              self.chk_report_quote_inner_uses(node.left);
              self.chk_report_quote_inner_uses(node.right);
              self.chk_report_quote_inner_uses(node.extra);
              return;
          }
          // Declared anywhere the live scopes see (locals, parameters,
          // quote-local bindings, top-level functions and builtins through
          // the parent chain): no diagnostic, arguments still walked.
          if (self.current_scope.has(nm)) {
              self.chk_report_quote_inner_uses(node.left);
              self.chk_report_quote_inner_uses(node.right);
              self.chk_report_quote_inner_uses(node.extra);
              return;
          }
          // `Self` names the enclosing struct (the statement checker
          // rewrites it the same way), and a method called by its short
          // name resolves against the `S_m` symbol like there too.
          if (chk_str_eq(nm, "Self") && chk_strlen(self.current_struct) > cast<ulong>(0)) {
              self.chk_report_quote_inner_uses(node.left);
              self.chk_report_quote_inner_uses(node.right);
              self.chk_report_quote_inner_uses(node.extra);
              return;
          }
          if (chk_strlen(self.current_struct) > cast<ulong>(0)) {
              let fb <Buffer> = new_buffer(64);
              fb.write_string(self.current_struct);
              fb.write_char('_');
              fb.write_string(nm);
              let fq <string> = fb.to_string();
              free_buffer(fb);
              if (self.global_scope.has(fq)) {
                  self.chk_report_quote_inner_uses(node.left);
                  self.chk_report_quote_inner_uses(node.right);
                  self.chk_report_quote_inner_uses(node.extra);
                  return;
              }
          }
          // Method-shaped: resolved through the receiver, not the free
          // scope (answered below without reporting, so the ident lane
          // keeps its single diagnostic and the method lane its own).
          if (self.chk_quote_call_has_recv(node)) {
              self.chk_report_quote_inner_uses(node.left);
              self.chk_report_quote_inner_uses(node.right);
              self.chk_report_quote_inner_uses(node.extra);
              return;
          }
          let b <Buffer> = new_buffer(64);
          b.write_string("call to undeclared function: ");
          b.write_string(nm);
          self.report_error(b.to_string(), node.line, node.col);
          free_buffer(b);
      }

      // True when the call resolves through a receiver rather than the
      // free scope: a `compiler` API root, a module receiver, an
      // undeclared receiver (its own diagnostic owns the line), or a
      // declared receiver whose type carries the method (`S_m`, an
      // inherited one, `Printable_m`, or the collection builtins the
      // statement checker accepts without a declaration). Pure scope
      // reads, never a diagnostic.
      fun chk_quote_call_has_recv(self: &Self, node: &AstNode) <bool> {
          if (node.left == null) { return false; }
          let head <&AstNode> = node.left;
          let cand <&AstNode> = head.left;
          if (cand == null) { cand = head; }
          if (cand.kind != ast_ident()) { return false; }
          if (cand.name == null) { return false; }
          if (chk_str_eq(cand.name, "compiler")) { return true; }
          if (!self.current_scope.has(cand.name)) { return true; }
          let vsym <Symbol> = self.current_scope.lookup(cand.name);
          if (chk_str_eq(vsym.type_name, "module")) { return true; }
          let base <string> = self.chk_generic_base(self.chk_ptr_base(vsym.type_name));
          if (chk_str_eq(base, "Self") && chk_strlen(self.current_struct) > cast<ulong>(0)) {
              base = self.current_struct;
          }
          let qb <Buffer> = new_buffer(64);
          qb.write_string(base);
          qb.write_char('_');
          qb.write_string(node.name);
          let qn <string> = qb.to_string();
          free_buffer(qb);
          if (self.global_scope.has(qn)) { return true; }
          if (!chk_str_eq(self.find_inherited_method(base, node.name, 0), "")) { return true; }
          let pb <Buffer> = new_buffer(64);
          pb.write_string("Printable_");
          pb.write_string(node.name);
          let pn <string> = pb.to_string();
          free_buffer(pb);
          if (self.global_scope.has(pn)) { return true; }
          if (chk_str_eq(base, "Collection") || chk_str_eq(base, "HashMap") ||
              chk_str_eq(base, "prototype") || chk_str_eq(base, "string") ||
              chk_str_eq(node.name, "rm") || chk_str_eq(node.name, "push") ||
              chk_str_eq(node.name, "push_back") || chk_str_eq(node.name, "pop") ||
              chk_str_eq(node.name, "len") || chk_str_eq(node.name, "length") ||
              chk_str_eq(node.name, "get") || chk_str_eq(node.name, "set")) {
              return true;
          }
          return false;
      }

      // True when a generation quote names the claimant's subject
      // parameter: parameters do not bind (the comptime interpreter
      // gap), so the lowering-times name has nothing to read.
      fun chk_quote_names_param(self: &Self, node: &AstNode, pname: string) <bool> {
          if (node == null) { return false; }
          if (pname == null || chk_strlen(pname) == cast<ulong>(0)) { return false; }
          if (node.kind == ast_ident() && chk_str_eq(node.name, pname)) { return true; }
          if (self.chk_quote_names_param(node.left, pname)) { return true; }
          if (self.chk_quote_names_param(node.right, pname)) { return true; }
          return self.chk_quote_names_param(node.extra, pname);
      }

      // True when a `@special` body owns its quotes elsewhere: a
      // protocol claim's quotes resolve at claim time above, and a
      // handler's quotes are data until spliced (C++ inHandler_ skips
      // their analysis). Ordinary functions never skip.
      fun chk_skips_body_quote_walk(self: &Self, attr_text: string) <bool> {
          if (attr_text == null || chk_strlen(attr_text) == cast<ulong>(0)) { return false; }
          let n <int> = self.api_attr_count(attr_text, 8);
          let i <int> = 0;
          while (i < n) {
              let seg <string> = self.api_attr_seg(attr_text, i);
              let anm <string> = self.api_attr_name(seg);
              if (chk_str_eq(anm, "protocol")) { return true; }
              if (chk_str_eq(anm, "on")) {
                  let ev <string> = self.api_attr_arg(seg);
                  if (ev != null && self.api_is_known_event(ev)) { return true; }
              }
              i = i + 1;
          }
          return false;
      }

      // Wave-5 slice 1: a `move_or_copy` claim is declared with an empty
      // body (the replacement body is not run in this slice), mirroring
      // the C++ backend. Other slots keep slice 0's shape: their refusal
      // below already covers any body.
      fun api_check_move_claim_body(self: &Self, fn_node: &AstNode, slot1: string) <noret> {
          if (fn_node.left == null) { return; }
          let nbody <int> = 0;
          let bc <&AstNode> = fn_node.left.left;
          while (bc != null) {
              nbody = nbody + 1;
              bc = bc.right;
          }
          if (nbody > 0) {
              let b7 <Buffer> = new_buffer(256);
              b7.write_string("A protocol for slot 'move_or_copy' is declared with an empty body: '@");
              b7.write_string(fn_node.name);
              b7.write_string("' has ");
              b7.write_int(nbody);
              b7.write_string(" statement(s), and a replacement body is not run in this slice");
              let m7 <string> = b7.to_string();
              free_buffer(b7);
              self.report_error(m7, fn_node.line, fn_node.col);
              return;
          }
      }

      // Wave-5 slices 2-3: a `destructor` or `deallocate` claim supplies
      // the generation for structs that declare no `~T()` (slice 2), or the
      // deallocation call `delete` emits (slice 3, replacing only the `free`;
      // the destructor still runs first in codegen). The contract is the
      // evaluable subset only: an empty body (no custom cleanup /
      // deallocation, the default stays), one `return quote { ... };`
      // whose quote is uniform across subjects, or straight-line threading
      // (lets and bare calls, the subject parameter bound) to such a quote.
      // Anything else is refused naming the gap rather than silently
      // dropped (the backend never drops runtime code). Slice 3 carries
      // slice 2's shape over verbatim, so the one check serves both slots:
      // the messages name the claiming slot.
      // True when an expression sits inside the claimant threading subset
      // (CD2's cg_thread_expr_ok, shape only): a literal, a name, a quote,
      // or a call. Whether the name binds and whether the call is known is
      // evaluation, owned by codegen's threading; the checker only
      // validates the shape.
      fun chk_thread_expr_ok(self: &Self, expr: &AstNode) <bool> {
          if (expr == null) { return false; }
          if (expr.kind == ast_literal_int() || expr.kind == ast_literal_string() ||
              expr.kind == ast_literal_bool()) { return true; }
          if (expr.kind == ast_ident()) { return true; }
          if (expr.kind == ast_quote_expr()) { return true; }
          if (expr.kind == ast_call_expr()) { return true; }
          return false;
      }

      // True when a name threads to a generation quote through the body's
      // own lets (the final-answer half of the acceptance rule: the
      // subject is bound opaque, never a quote). A let bound to a quote
      // literal threads, through pure name aliases; a let bound to a call
      // is optimistic (resolving the helper is evaluation, owned by
      // codegen); anything else -- the subject, an unbound name, a
      // non-quote value -- threads to no quote. Only lets before the use
      // bind (use-before-bind threads nothing, as in the interpreter).
      fun api_claim_name_threads_to_quote(self: &Self, fn_node: &AstNode, subject: string, key: string, use_idx: int) <bool> {
          let depth <int> = 0;
          let cur_key <string> = key;
          let cur_use <int> = use_idx;
          while (depth < 8 && cur_key != null) {
              if (chk_str_eq(cur_key, subject)) { return false; }
              let found <bool> = false;
              let init <&AstNode> = null;
              let j <int> = 0;
              let wc <&AstNode> = fn_node.left.left;
              while (wc != null && j < cur_use) {
                  let ws <&AstNode> = wc.left;
                  if (ws == null) { ws = wc; }
                  if (ws.kind == ast_var_decl() && chk_str_eq(ws.name, cur_key)) {
                      found = true;
                      init = ws.left;
                      cur_use = j;
                  }
                  wc = wc.right;
                  j = j + 1;
              }
              if (!found) { return false; }
              if (init == null) { return false; }
              if (init.kind == ast_quote_expr()) { return true; }
              if (init.kind == ast_call_expr()) { return true; }
              if (init.kind != ast_ident() || init.name == null) { return false; }
              cur_key = init.name;
              depth = depth + 1;
          }
          return false;
      }

      // True when a claimant body is straight-line threading to its answer
      // (CD2's cg_thread_body_to_quote, shape only): lets bind (never
      // last), bare calls run for their threading (never last), and the
      // one final statement returns a quote, a call, or a name that
      // threads to a quote above. Anything wider -- control flow, blame,
      // a missing answer -- is refused by the caller with the existing
      // shape message.
      fun api_claim_body_threads(self: &Self, fn_node: &AstNode, nbody: int) <bool> {
          let i <int> = 0;
          let cur <&AstNode> = fn_node.left.left;
          while (cur != null) {
              let last <bool> = (i == nbody - 1);
              let stmt <&AstNode> = cur.left;
              if (stmt == null) { stmt = cur; }
              if (stmt.kind == ast_var_decl()) {
                  if (last) { return false; }
                  if (!self.chk_thread_expr_ok(stmt.left)) { return false; }
              } else if (stmt.kind == ast_return_stmt()) {
                  if (!last) { return false; }
                  if (stmt.left == null) { return false; }
                  if (stmt.left.kind != ast_quote_expr() && stmt.left.kind != ast_call_expr() &&
                      stmt.left.kind != ast_ident()) { return false; }
                  if (stmt.left.kind == ast_ident()) {
                      let subj <string> = "";
                      if (fn_node.extra != null && fn_node.extra.name != null) { subj = fn_node.extra.name; }
                      if (stmt.left.name == null ||
                          !self.api_claim_name_threads_to_quote(fn_node, subj, stmt.left.name, i)) { return false; }
                  }
              } else if (stmt.kind == ast_expr_stmt()) {
                  if (last) { return false; }
                  if (!self.chk_thread_expr_ok(stmt.left)) { return false; }
              } else {
                  return false;
              }
              cur = cur.right;
              i = i + 1;
          }
          return true;
      }

      // True when any generation quote in a claimant body names `self`:
      // the generation lowers once, as a shared function with no receiver.
      // Only quote literals are scanned (a bare `self` in the threading
      // itself cannot bind either, and falls to the shape refusal).
      fun chk_body_quote_names_self(self: &Self, node: &AstNode) <bool> {
          if (node == null) { return false; }
          if (node.kind == ast_quote_expr()) {
              if (self.chk_quote_names_self(node)) { return true; }
          }
          if (self.chk_body_quote_names_self(node.left)) { return true; }
          if (self.chk_body_quote_names_self(node.right)) { return true; }
          return self.chk_body_quote_names_self(node.extra);
      }

      // True when any generation quote in a claimant body names the
      // claimant's subject parameter (the threading itself may name it).
      fun chk_body_quote_names_param(self: &Self, node: &AstNode, pname: string) <bool> {
          if (node == null) { return false; }
          if (pname == null || chk_strlen(pname) == cast<ulong>(0)) { return false; }
          if (node.kind == ast_quote_expr()) {
              if (self.chk_quote_names_param(node, pname)) { return true; }
          }
          if (self.chk_body_quote_names_param(node.left, pname)) { return true; }
          if (self.chk_body_quote_names_param(node.right, pname)) { return true; }
          return self.chk_body_quote_names_param(node.extra, pname);
      }

      fun api_check_dtor_claim_body(self: &Self, fn_node: &AstNode, slot1: string) <noret> {
          if (fn_node.left == null) { return; }
          let nbody <int> = 0;
          let bc <&AstNode> = fn_node.left.left;
          while (bc != null) {
              nbody = nbody + 1;
              bc = bc.right;
          }
          if (nbody == 0) { return; }
          if (!self.api_claim_body_threads(fn_node, nbody)) {
              let b7 <Buffer> = new_buffer(256);
              b7.write_string("A protocol for slot '");
              b7.write_string(slot1);
              b7.write_string("' is declared with an empty body or one `return quote { ... };`: '@");
              b7.write_string(fn_node.name);
              b7.write_string("' has ");
              b7.write_int(nbody);
              b7.write_string(" statement(s), and a replacement body beyond one return quote is not run in this slice");
              let m7 <string> = b7.to_string();
              free_buffer(b7);
              self.report_error(m7, fn_node.line, fn_node.col);
              return;
          }
          // The quote's undeclared uses already reported at claim time
          // above, in source order; the refusal below only names the
          // slot rule.
          if (self.chk_body_quote_names_self(fn_node.left)) {
              let b8 <Buffer> = new_buffer(256);
              b8.write_string("A protocol for slot '");
              b8.write_string(slot1);
              b8.write_string("' cannot name 'self': '@");
              b8.write_string(fn_node.name);
              b8.write_string("' lowers once, as a shared function with no receiver, so a subject-relative name has nothing to bind to");
              let m8 <string> = b8.to_string();
              free_buffer(b8);
              self.report_error(m8, fn_node.line, fn_node.col);
              return;
          }
          // The subject parameter resolves in analysis, so only the
          // lowering refuses it (C++ `the name 's' is not lowered yet`):
          // the generation is shared across subjects and parameters do
          // not bind. It runs only when analysis is otherwise clean --
          // any earlier error already fails the build before lowering,
          // as in C++.
          let pname <string> = "";
          if (fn_node.extra != null && fn_node.extra.name != null) { pname = fn_node.extra.name; }
          if (!self.had_error && chk_strlen(pname) > cast<ulong>(0) &&
              self.chk_body_quote_names_param(fn_node.left, pname)) {
              let b9 <Buffer> = new_buffer(256);
              b9.write_string("A protocol for slot '");
              b9.write_string(slot1);
              b9.write_string("' cannot name its subject parameter: '@");
              b9.write_string(fn_node.name);
              b9.write_string("' uses '");
              b9.write_string(pname);
              b9.write_string("', and parameters do not bind (the comptime interpreter gap: no @special execution yet, so the generation names no parameter)");
              let m9 <string> = b9.to_string();
              free_buffer(b9);
              self.report_error(m9, fn_node.line, fn_node.col);
              return;
          }
      }

      // The protocol registry (ADR 0014): exactly one slot per claimant,
      // one claimant per slot program-wide, mirroring api_check_provider's
      // shape. A well-formed claimant is recorded here; the not-lowered
      // refusal is deferred to api_report_single_protocols at end of program
      // so a second claimant reports exclusivity instead. Runs only on
      // `@special`.
      fun api_check_protocol(self: &Self, fn_node: &AstNode, attr_text: string) <noret> {
          let slot1 <string> = "";
          let slot2 <string> = "";
          let nproto <int> = 0;
          let n <int> = self.api_attr_count(attr_text, 8);
          let i <int> = 0;
          while (i < n) {
              let seg <string> = self.api_attr_seg(attr_text, i);
              if (chk_str_eq(self.api_attr_name(seg), "protocol")) {
                  if (nproto == 0) { slot1 = self.api_attr_arg(seg); }
                  else if (nproto == 1) { slot2 = self.api_attr_arg(seg); }
                  nproto = nproto + 1;
              }
              i = i + 1;
          }
          if (nproto == 0) { return; }
          // The body is live code (C++ visit(SpecialDeclaration) walks
          // it with the parameters in scope, before collectProtocol):
          // each undeclared use inside `quote` reports here, ahead of
          // every gate below, so a malformed signature still carries
          // the body's own diagnostic like the backend does.
          self.enter_scope();
          let pp_cur <&AstNode> = fn_node.extra;
          while (pp_cur != null) {
              if (pp_cur.name != null && chk_strlen(pp_cur.name) > cast<ulong>(0)) {
                  let ppt <string> = pp_cur.type_annotation;
                  if (ppt == null) { ppt = "auto"; }
                  self.current_scope.insert_symbol(make_var_sym(pp_cur.name, ppt, false));
              }
              pp_cur = pp_cur.right;
          }
          self.chk_report_quote_uses(fn_node.left);
          self.exit_scope();
          if (nproto > 1) {
              let b <Buffer> = new_buffer(128);
              b.write_string("A protocol claims exactly one slot: '@");
              b.write_string(fn_node.name);
              b.write_string("' claims '");
              b.write_string(slot1);
              b.write_string("' and '");
              b.write_string(slot2);
              b.write_string("'");
              let m <string> = b.to_string();
              free_buffer(b);
              self.report_error(m, fn_node.line, fn_node.col);
              return;
          }
          if (chk_strlen(slot1) == cast<ulong>(0)) { return; }
          if (!self.api_is_protocol_slot(slot1)) { return; }
          let np <int> = self.count_fn_params(fn_node);
          if (np != 1) {
              let b2 <Buffer> = new_buffer(128);
              b2.write_string("A protocol for slot '");
              b2.write_string(slot1);
              b2.write_string("' takes exactly one subject: '@");
              b2.write_string(fn_node.name);
              b2.write_string("' takes ");
              b2.write_int(np);
              let m2 <string> = b2.to_string();
              free_buffer(b2);
              self.report_error(m2, fn_node.line, fn_node.col);
              return;
          }
          let ret_ann <string> = fn_node.type_annotation;
          if (!chk_str_eq(ret_ann, "quote")) {
              let b4 <Buffer> = new_buffer(96);
              b4.write_string("A protocol for slot '");
              b4.write_string(slot1);
              b4.write_string("' returns '<quote>'");
              let m4 <string> = b4.to_string();
              free_buffer(b4);
              self.report_error(m4, fn_node.line, fn_node.col);
              return;
          }
          let ci <int> = 0;
          while (ci < self.proto_count) {
              if (chk_str_eq(self.proto_slots[ci], slot1)) {
                  let b5 <Buffer> = new_buffer(256);
                  b5.write_string("protocol slot '");
                  b5.write_string(slot1);
                  b5.write_string("' is already claimed: '@");
                  b5.write_string(self.proto_names[ci]);
                  b5.write_string("' (line ");
                  b5.write_int(self.proto_lines[ci]);
                  b5.write_string(") claimed it, so '@");
                  b5.write_string(fn_node.name);
                  b5.write_string("' (line ");
                  b5.write_int(fn_node.line);
                  b5.write_string(") cannot. A slot has exactly one claimant (ADR 0014)");
                  let m5 <string> = b5.to_string();
                  free_buffer(b5);
                  self.report_error(m5, fn_node.line, fn_node.col);
                  return;
              }
              ci = ci + 1;
          }
          // Wave-5 slices 1-3: a `move_or_copy`, `destructor`, or
          // `deallocate` claim gates lowering, but the replacement body is
          // not executed -- so only the evaluable subset is accepted, and
          // anything else is refused naming the claimant rather than silently
          // dropped. Other slots keep slice 0's shape: their refusal below
          // already covers any body. A refusal here skips recording, like the
          // original inline shape did by returning.
          let err_before <bool> = self.had_error;
          if (chk_str_eq(slot1, "move_or_copy")) {
              self.api_check_move_claim_body(fn_node, slot1);
          }
          if (chk_str_eq(slot1, "destructor") || chk_str_eq(slot1, "deallocate")) {
              self.api_check_dtor_claim_body(fn_node, slot1);
          }
          if (self.had_error && !err_before) { return; }
          if (self.proto_count < 8) {
              self.proto_slots[self.proto_count] = slot1;
              self.proto_names[self.proto_count] = fn_node.name;
              self.proto_lines[self.proto_count] = fn_node.line;
              self.proto_cols[self.proto_count] = fn_node.col;
              self.proto_count = self.proto_count + 1;
          }
          // `lifetime` records without refusing here (its not-lowered
          // refusal is deferred); the body's quote uses already reported
          // at claim time above, ahead of the deferred refusal as in
          // C++.
          return;
      }

      // Slice 0's replacement refusal: a lone well-formed claimant is
      // recognized and recorded, but the operation still lowers by default.
      // Deferred to end of program so a second claimant reports exclusivity
      // instead; slots with zero claimants report nothing.
      // Wave-5 slices 1-3: `move_or_copy`, `destructor`, and `deallocate`
      // are exempt -- their replacements are lowered (moved-from skipping;
      // generated composition cleanup; substituted deallocation), so a lone
      // claimant compiles instead of refusing here. Only `lifetime` still
      // reports it.
      fun api_report_single_protocols(self: &Self) <noret> {
          let k <int> = 0;
          while (k < self.proto_count) {
              if (chk_str_eq(self.proto_slots[k], "move_or_copy") || chk_str_eq(self.proto_slots[k], "destructor") || chk_str_eq(self.proto_slots[k], "deallocate")) { k = k + 1; continue; }
              let holders <int> = 0;
              let q <int> = 0;
              while (q < self.proto_count) {
                  if (chk_str_eq(self.proto_slots[q], self.proto_slots[k])) { holders = holders + 1; }
                  q = q + 1;
              }
              if (holders == 1) {
                  let b6 <Buffer> = new_buffer(256);
                  b6.write_string("protocol slot '");
                  b6.write_string(self.proto_slots[k]);
                  b6.write_string("' is recognized, claimant recorded, replacement not lowered yet: '@");
                  b6.write_string(self.proto_names[k]);
                  b6.write_string("' (line ");
                  b6.write_int(self.proto_lines[k]);
                  b6.write_string(")");
                  let m6 <string> = b6.to_string();
                  free_buffer(b6);
                  self.report_error(m6, self.proto_lines[k], self.proto_cols[k]);
              }
              k = k + 1;
          }
      }

      // Whether the body is the one answer a provider may give: a single
      // `return compiler.layout.pointer_map_quote(<subject>)`.
      fun api_is_straight_answer(self: &Self, fn_node: &AstNode, subject: string) <bool> {
          if (fn_node.left == null) { return false; }
          if (fn_node.left.kind != ast_block()) { return false; }
          let first <&AstNode> = fn_node.left.left;
          if (first == null) { return false; }
          if (first.right != null) { return false; }
          let stmt <&AstNode> = first.left;
          if (stmt == null) { stmt = first; }
          if (stmt.kind != ast_return_stmt()) { return false; }
          let rv <&AstNode> = stmt.left;
          if (rv == null) { return false; }
          if (rv.kind != ast_call_expr()) { return false; }
          if (!chk_str_eq(rv.name, "pointer_map_quote")) { return false; }
          if (self.count_call_args(rv.left, false) != 2) { return false; }
          let a1w <&AstNode> = rv.left;
          let a1 <&AstNode> = a1w.left;
          if (a1 == null) { a1 = a1w; }
          if (a1.kind != ast_member_access()) { return false; }
          if (!chk_str_eq(a1.name, "layout")) { return false; }
          let rt <&AstNode> = a1.left;
          if (rt == null || rt.kind != ast_ident()) { return false; }
          if (!chk_str_eq(rt.name, "compiler")) { return false; }
          let a2w <&AstNode> = a1w.right;
          if (a2w == null) { return false; }
          let a2 <&AstNode> = a2w.left;
          if (a2 == null) { a2 = a2w; }
          if (a2.kind != ast_ident()) { return false; }
          if (!chk_str_eq(a2.name, subject)) { return false; }
          return true;
      }

      // `#[on(event)]` bearer rules: a known event on anything but a
      // `@special` names the bearer kind; on a `@special` the payload and
      // the interpretability line are checked.
      fun api_check_on_attrs(self: &Self, fn_node: &AstNode, attr_text: string, is_special: bool, kind_noun: string) <noret> {
          let n <int> = self.api_attr_count(attr_text, 8);
          let i <int> = 0;
          while (i < n) {
              let seg <string> = self.api_attr_seg(attr_text, i);
              if (chk_str_eq(self.api_attr_name(seg), "on")) {
                  let ev <string> = self.api_attr_arg(seg);
                  if (chk_strlen(ev) > cast<ulong>(0) && self.api_is_known_event(ev)) {
                      if (!is_special) {
                          let b <Buffer> = new_buffer(160);
                          b.write_string("#[on('");
                          b.write_string(ev);
                          b.write_string("')] declares an event handler, which must be a @special function (found on ");
                          b.write_string(kind_noun);
                          b.write_string(")");
                          let m <string> = b.to_string();
                          free_buffer(b);
                          self.report_error(m, fn_node.line, fn_node.col);
                      } else {
                          self.api_check_handler_payload(fn_node, ev);
                          self.api_check_handler_flow(fn_node, ev);
                      }
                  }
              }
              i = i + 1;
          }
      }

      // The Collect phase (C++ collectProgramHandlers): every
      // well-formed `#[on(event)]` on a `@special` is a handler
      // record. Malformed ones belong to the attribute
      // diagnostic, exactly once, so they are skipped here.
      fun api_collect_handler(self: &Self, fn_node: &AstNode) <noret> {
          let t <string> = fn_node.attr_text;
          if (t == null || chk_strlen(t) == cast<ulong>(0)) { return; }
          let n <int> = self.api_attr_count(t, 8);
          let i <int> = 0;
          while (i < n) {
              let seg <string> = self.api_attr_seg(t, i);
              if (chk_str_eq(self.api_attr_name(seg), "on")) {
                  let ev <string> = self.api_attr_arg(seg);
                  if (chk_strlen(ev) > cast<ulong>(0) && self.api_is_known_event(ev)) {
                      if (self.handler_count < 8) {
                          self.handler_names[self.handler_count] = fn_node.name;
                          self.handler_events[self.handler_count] = ev;
                          self.handler_count = self.handler_count + 1;
                      }
                  }
              }
              i = i + 1;
          }
      }

      fun api_find_handler(self: &Self, name: string) <bool> {
          let i <int> = 0;
          while (i < self.handler_count) {
              if (chk_str_eq(self.handler_names[i], name)) { return true; }
              i = i + 1;
          }
          return false;
      }

      // A top-level statement: the Arm phase's `@name(...)` invocation or
      // `compiler.events.enable(h)`. Anything else checks as an ordinary
      // expression (outside every grant, `compiler` is undefined there).
      fun api_check_top_stmt(self: &Self, stmt: &AstNode) <noret> {
          if (stmt == null) { return; }
          let call <&AstNode> = stmt.left;
          if (call == null) { call = stmt; }
          if (call.kind != ast_call_expr()) {
              self.check_expression(call);
              return;
          }
          if (chk_str_starts_with(call.name, "@")) {
              let bare <string> = substr(call.name, 1, cast<int>(chk_strlen(call.name)) - 1);
              if (!self.global_scope.has(bare)) {
                  let b <Buffer> = new_buffer(64);
                  b.write_string("Undefined function or type '");
                  b.write_string(bare);
                  b.write_string("'");
                  let m <string> = b.to_string();
                  free_buffer(b);
                  self.report_error(m, call.line, call.col);
                  return;
              }
              self.check_expression(call);
              return;
          }
          // `enable(compiler.events, h)`: the handler itself, not a string.
          if (chk_str_eq(call.name, "enable")) {
              let argc <int> = self.count_call_args(call.left, false);
              let nargs <int> = argc - 1;
              if (nargs < 0) { nargs = 0; }
              let first <&AstNode> = call.left;
              let recv_ok <bool> = false;
              if (first != null) {
                  let rnode <&AstNode> = first.left;
                  if (rnode == null) { rnode = first; }
                  if (rnode.kind == ast_member_access() && chk_str_eq(rnode.name, "events")) {
                      let rr <&AstNode> = rnode.left;
                      if (rr != null && rr.kind == ast_ident() && chk_str_eq(rr.name, "compiler")) {
                          recv_ok = true;
                      }
                  }
              }
              if (recv_ok) {
                  if (nargs != 1) {
                      self.report_error("'compiler.events.enable' takes exactly one argument: the handler to arm", call.line, call.col);
                      self.api_walk_args(call.left);
                      return;
                  }
                  let aw <&AstNode> = first.right;
                  if (aw == null) {
                      self.api_walk_args(call.left);
                      return;
                  }
                  let an <&AstNode> = aw.left;
                  if (an == null) { an = aw; }
                  if (an.kind != ast_ident()) {
                      self.report_error("'compiler.events.enable' takes the handler itself: write enable(h), not enable(\"h\")", an.line, an.col);
                      self.api_walk_args(call.left);
                      return;
                  }
                  if (!self.api_find_handler(an.name)) {
                      let b2 <Buffer> = new_buffer(128);
                      b2.write_string("'compiler.events.enable' names no handler '");
                      b2.write_string(an.name);
                      b2.write_string("': declare one with #[on(<event>)] on a @special function first");
                      let m2 <string> = b2.to_string();
                      free_buffer(b2);
                      self.report_error(m2, an.line, an.col);
                      self.api_walk_args(call.left);
                      return;
                  }
                  self.check_expression(call);
                  return;
              }
          }
          self.check_expression(call);
      }

      // Every field's attributes, in order (C++ validates struct member
      // attributes where they are declared).
      fun api_validate_fields(self: &Self, struct_node: &AstNode) <noret> {
          let f <&AstNode> = struct_node.left;
          while (f != null) {
              self.api_validate_attrs(f.attr_text, true, false, f.line, f.col);
              // A struct field of union type has no single layout -- which
              // alternative a value holds is known only at run time. Refused
              // at declaration time (C++ Round 3, Q12): asking the type's
              // pointer map must diagnose, never guess its first member's.
              if (f.type_annotation != null) {
                  let fw <string> = f.type_annotation;
                  let fr <string> = self.resolve_type(fw);
                  if (chk_strchr(fr, 124) != null) {
                      let fn_shown <string> = fw;
                      if (chk_str_eq(fw, fr)) {
                          // Written as a union spelling directly: space it
                          // like the C++ wording (`int | uint`).
                          let sb <Buffer> = new_buffer(64);
                          let scs <[char]> = to_chars(fr);
                          let slen <int> = cast<int>(chk_strlen(fr));
                          for (let si <int> = 0; si < slen; si++) {
                              if (scs[si] == cast<char>(124)) { sb.write_string(" | "); }
                              else { sb.write_char(scs[si]); }
                          }
                          delete scs;
                          fn_shown = sb.to_string();
                          free_buffer(sb);
                      }
                      let fb <Buffer> = new_buffer(64);
                      fb.write_string("field '");
                      fb.write_string(f.name);
                      fb.write_string("' has union type '");
                      fb.write_string(fn_shown);
                      fb.write_string("': a union has no single layout, so its pointer map is a diagnostic rather than a map (docs/compiler-api.md Q12)");
                      self.report_error(fb.to_string(), f.line, f.col);
                      free_buffer(fb);
                  }
              }
              f = f.right;
          }
      }

      fun seed_builtins(self: &Self) <noret> {
          self.global_scope.insert_symbol(make_fn_sym("printf", "int", true));
          self.global_scope.insert_symbol(make_fn_sym("exit", "void", true));
          self.global_scope.insert_symbol(make_fn_sym("abort", "void", true));
          self.global_scope.insert_symbol(make_fn_sym("malloc", "void*", true));
          self.global_scope.insert_symbol(make_fn_sym("free", "void", true));
          self.global_scope.insert_symbol(make_fn_sym("@Alloc", "void*", true));
          self.global_scope.insert_symbol(make_fn_sym("Alloc", "void*", true));
          self.global_scope.insert_symbol(make_fn_sym("@Free", "void", true));
          self.global_scope.insert_symbol(make_fn_sym("Free", "void", true));
          self.global_scope.insert_symbol(make_fn_sym("@getenumkeyid", "int", true));
          self.global_scope.insert_symbol(make_fn_sym("getenumkeyid", "int", true));
          self.global_scope.insert_symbol(make_fn_sym("@keyidof", "int", true));
          self.global_scope.insert_symbol(make_fn_sym("keyidof", "int", true));
          self.global_scope.insert_symbol(make_fn_sym("@implements", "void", true));
          self.global_scope.insert_symbol(make_fn_sym("implements", "void", true));
          self.global_scope.insert_symbol(make_fn_sym("@defined", "bool", true));
          self.global_scope.insert_symbol(make_fn_sym("defined", "bool", true));
          self.global_scope.insert_symbol(make_fn_sym("__fin_alloc_array", "void*", true));
          self.global_scope.insert_symbol(make_fn_sym("__fin_alloc_struct", "void*", true));
          self.global_scope.insert_symbol(make_fn_sym("__fin_alloc_scalar", "void*", true));
          self.global_scope.insert_symbol(make_fn_sym("__fin_struct_init", "void*", true));
          self.global_scope.insert_symbol(make_fn_sym("__fin_array_literal", "void*", true));
          self.global_scope.insert_symbol(make_fn_sym("__fin_sizeof", "int", true));
          self.global_scope.insert_symbol(make_var_sym("NULL", "void*", true));
          self.global_scope.insert_symbol(make_var_sym("null", "void*", true));
          self.global_scope.insert_symbol(make_var_sym("true", "bool", true));
          self.global_scope.insert_symbol(make_var_sym("false", "bool", true));
          // `compiler` is NOT predeclared: it resolves only inside a
          // declaration granting `#[use(compiler)]`, and anywhere else it
          // is `Undefined variable 'compiler'` (C++ applyUseAttributes).
          self.global_scope.insert_symbol(make_fn_sym("number2str", "string", true));
          self.global_scope.insert_symbol(make_fn_sym("number2str_float", "string", true));
      }

      fun check_expression(self: &Self, expr: &AstNode) <string> {
          if (expr == null) { return "void"; }

          if (expr.kind == ast_literal_int()) {
              return "int";
          }
          if (expr.kind == ast_literal_string()) {
              return "string";
          }
          if (expr.kind == ast_literal_bool()) {
              return "bool";
          }

          if (expr.kind == ast_ident()) {
              if (chk_strlen(expr.name) == cast<ulong>(1)) {
                  let fst_c <string> = expr.name;
                  if (chk_str_eq(fst_c, "T") || chk_str_eq(fst_c, "E") || chk_str_eq(fst_c, "U") ||
                      chk_str_eq(fst_c, "K") || chk_str_eq(fst_c, "V") || chk_str_eq(fst_c, "X")) {
                      // SG1 mirror: a vocabulary letter naming a declared
                      // struct/enum/interface falls through to the normal
                      // lookup below instead of answering as a parameter.
                      if (!self.chk_single_letter_is_declared_type(fst_c)) {
                          return expr.name;
                      }
                  }
              }
              if (chk_str_eq(expr.name, "m1778") || chk_str_eq(expr.name, "_") || chk_str_eq(expr.name, "_?")) {
                  return "void*";
              }
              if (chk_str_eq(expr.name, "NULL") || chk_str_eq(expr.name, "null")) {
                  return "void*";
              }
              if (chk_str_eq(expr.name, "true") || chk_str_eq(expr.name, "false")) {
                  return "bool";
              }
              // A definitely-moved binding is unreadable (C++ MovedAnalysis):
              // one diagnostic at the use. Suspended for a plain
              // assignment's target, which rebinds rather than reads.
              if (self.moved_quiet == 0 && expr.name != null && self.moved_has(expr.name)) {
                  let vb <Buffer> = new_buffer(64);
                  vb.write_string("Use of moved-from variable '");
                  vb.write_string(expr.name);
                  vb.write_string("'");
                  self.report_error(vb.to_string(), expr.line, expr.col);
                  free_buffer(vb);
              }
              if (chk_str_eq(expr.name, "compiler")) {
                  // The compiler API resolves only under `#[use(compiler)]`;
                  // anywhere else the name is undefined (C++
                  // applyUseAttributes binds it per declaration). Path
                  // reads for the dispatcher stay silent (quiet).
                  if (self.quiet_compiler != 0) { return "compiler"; }
                  if (!self.api_has_grant("compiler")) {
                      self.report_error("Undefined variable 'compiler'", expr.line, expr.col);
                      return "error";
                  }
                  return "compiler";
              }
              if (chk_strchr(expr.name, 58) != null) {
                  let u_name <string> = chk_replace_dc_with_underscore(expr.name);
                  if (self.current_scope.has(expr.name)) {
                      let sym <Symbol> = self.current_scope.lookup(expr.name);
                      return self.resolve_type(sym.type_name);
                  }
                  if (self.current_scope.has(u_name)) {
                      let sym <Symbol> = self.current_scope.lookup(u_name);
                      return self.resolve_type(sym.type_name);
                  }
                  let lhs <string> = chk_extract_before_dc(expr.name);
                  let rhs <string> = chk_extract_after_dc(expr.name);
                  if (self.global_scope.has(lhs)) {
                      let lsym <Symbol> = self.global_scope.lookup(lhs);
                      if (lsym.kind == sym_enum()) {
                          return lhs;
                      }
                  }
                  if (self.current_scope.has(rhs)) {
                      let rsym <Symbol> = self.current_scope.lookup(rhs);
                      return self.resolve_type(rsym.type_name);
                  }
                  if (self.global_scope.has(rhs)) {
                      let rsym <Symbol> = self.global_scope.lookup(rhs);
                      return self.resolve_type(rsym.type_name);
                  }
              }
              if (!self.current_scope.has(expr.name)) {
                  if (chk_strlen(self.current_struct) > cast<ulong>(0)) {
                      let fb <Buffer> = new_buffer(64);
                      fb.write_string(self.current_struct);
                      fb.write_char('_');
                      fb.write_string(expr.name);
                      let fq <string> = fb.to_string();
                      free_buffer(fb);
                      if (self.global_scope.has(fq)) {
                          let sym <Symbol> = self.global_scope.lookup(fq);
                          return self.resolve_type(sym.type_name);
                      }
                  }
                  if (self.global_scope.has(expr.name)) {
                      let sym <Symbol> = self.global_scope.lookup(expr.name);
                      return self.resolve_type(sym.type_name);
                  }
                  self.report_error("use of undeclared identifier", expr.line, expr.col);
                  return "error";
              }
              let sym <Symbol> = self.current_scope.lookup(expr.name);
              return self.resolve_type(sym.type_name);
          }

          if (expr.kind == ast_binary_expr()) {
              // A plain `x = e` rebinds x rather than reading it, so the
              // target suspends the use check (C++ suspendUses); `x = x + 1`
              // still reports the right-hand read, exactly once. Rebinding
              // revives after both sides are checked.
              let is_rebind <bool> = false;
              if (chk_str_eq(expr.name, "=") && expr.left != null && expr.left.kind == ast_ident()) {
                  is_rebind = true;
                  self.moved_quiet = self.moved_quiet + 1;
              }
              let t_left <string> = self.check_expression(expr.left);
              // `&&` and `||` short-circuit, so the right-hand side runs
              // conditionally: its effects join the entry state (C++
              // installJoin), like a one-armed branch.
              let w7join <bool> = chk_str_eq(expr.name, "&&") || chk_str_eq(expr.name, "||");
              let w7snap <[string]> = new [string, 64]{};
              let w7n <int> = 0;
              if (w7join) { w7n = self.moved_snapshot(w7snap); }
              let t_right <string> = self.check_expression(expr.right);
              if (w7join) { self.moved_intersect(w7snap, w7n); }
              if (is_rebind) {
                  self.moved_quiet = self.moved_quiet - 1;
                  self.moved_revive(expr.left.name);
              }
              if (chk_str_eq(expr.name, "==") || chk_str_eq(expr.name, "!=") ||
                  chk_str_eq(expr.name, "<") || chk_str_eq(expr.name, ">") ||
                  chk_str_eq(expr.name, "<=") || chk_str_eq(expr.name, ">=") ||
                  chk_str_eq(expr.name, "&&") || chk_str_eq(expr.name, "||")) {
                  return "bool";
              }
              if (chk_str_eq(expr.name, "<<") || chk_str_eq(expr.name, ">>")) {
                  let shift_bits <int> = chk_int_bits(t_left);
                  if (shift_bits > 0 && expr.right != null && chk_shift_count_bad(expr.right, shift_bits) == 1) {
                      let shift_txt <string> = chk_shift_text(expr.right);
                      let shift_b <Buffer> = new_buffer(96);
                      shift_b.write_string("Shift count ");
                      shift_b.write_string(shift_txt);
                      shift_b.write_string(" out of range for ");
                      shift_b.write_int(shift_bits);
                      shift_b.write_string("-bit '");
                      shift_b.write_string(t_left);
                      shift_b.write_string("'");
                      let shift_l <int> = expr.line;
                      let shift_c <int> = expr.col;
                      if (expr.right != null) {
                          shift_l = expr.right.line;
                          shift_c = expr.right.col;
                      }
                      self.report_error(shift_b.to_string(), shift_l, shift_c);
                      free_buffer(shift_b);
                      return "error";
                  }
              }
              if (chk_str_eq(expr.name, "<<") || chk_str_eq(expr.name, ">>") ||
                  chk_str_eq(expr.name, "%") ||
                  chk_str_eq(expr.name, "+") || chk_str_eq(expr.name, "-") ||
                  chk_str_eq(expr.name, "*") || chk_str_eq(expr.name, "/")) {
                  // Shifts, remainder and arithmetic answer the wider integer
                  // (C++ Analyzer_Expr widerInteger + the arithmetic
                  // fallthrough): a side the other converts to wins, so
                  // int/ulong widen to ulong while a uint-by-int mix is a
                  // value-position mismatch like `=`. Floats pass here and
                  // are refused in codegen, which owns the backend invariant.
                  // Arithmetic outside integer pairs keeps the old silent
                  // `t_left` typing below (C++ widerInteger answers null
                  // there, and this checker never refused those — leftover).
                  let arith <bool> = chk_str_eq(expr.name, "+") || chk_str_eq(expr.name, "-") ||
                      chk_str_eq(expr.name, "*") || chk_str_eq(expr.name, "/");
                  if (arith && (chk_int_bits(t_left) <= 0 || chk_int_bits(t_right) <= 0)) {
                      if (!chk_str_eq(t_left, "auto") && !chk_str_eq(t_left, "void") && !chk_str_eq(t_left, "error")) {
                          return t_left;
                      }
                      if (!chk_str_eq(t_right, "auto") && !chk_str_eq(t_right, "void") && !chk_str_eq(t_right, "error")) {
                          return t_right;
                      }
                      return "int";
                  }
                  if (!chk_str_eq(t_left, "auto") && !chk_str_eq(t_left, "void") && !chk_str_eq(t_left, "error") &&
                      !chk_str_eq(t_right, "auto") && !chk_str_eq(t_right, "void") && !chk_str_eq(t_right, "error")) {
                      let l_to_r <bool> = self.chk_types_compatible(t_left, t_right);
                      let r_to_l <bool> = self.chk_types_compatible(t_right, t_left);
                      if (l_to_r && !r_to_l) {
                          return t_right;
                      }
                      if (r_to_l && !l_to_r) {
                          return t_left;
                      }
                      if (!l_to_r && !r_to_l) {
                          // Reported at the left operand, like C++ (the
                          // BinaryOp starts there); the stage parser locates
                          // the node at the operator instead.
                          let ml <int> = expr.line;
                          let mc <int> = expr.col;
                          if (expr.left != null) {
                              ml = expr.left.line;
                              mc = expr.left.col;
                          }
                          self.report_type_mismatch(t_left, t_right, ml, mc);
                          return "error";
                      }
                      return t_left;
                  }
              }
              if (chk_str_eq(expr.name, "=")) {
                  // Index bases are often untyped here (index on `auto`
                  // falls back to `int`), so the element type is not
                  // authoritative; every other left side carries its
                  // declared or field type. Reported at the value, like C++.
                  // `void` on either side means an earlier diagnostic (or a
                  // void call); the predicate would accept the sentinels
                  // anyway, this only keeps the cascade quiet.
                  if (expr.left != null && expr.left.kind != ast_index_expr() &&
                      !chk_str_eq(t_left, "void") && !chk_str_eq(t_right, "void")) {
                      if (!self.chk_types_compatible(t_right, t_left)) {
                          // Like the return arm: a fitting integer constant
                          // is accepted on the narrowing path (C++ checkType),
                          // so only non-constants and unfit constants report.
                          let asg_fit <bool> = false;
                          if (expr.right != null && chk_int_bits(t_left) > 0 && chk_is_int_const(expr.right) &&
                              chk_big_const_verdict(expr.right, t_left) == 0) {
                              asg_fit = true;
                          }
                          if (!asg_fit) {
                              let rl <int> = expr.line;
                              let rc <int> = expr.col;
                              if (expr.right != null) {
                                  rl = expr.right.line;
                                  rc = expr.right.col;
                              }
                              self.report_type_mismatch(t_left, t_right, rl, rc);
                          }
                      } else if (!chk_str_eq(t_right, "auto") && !chk_str_eq(t_right, "error") &&
                          chk_str_eq(self.chk_strip_qmark(t_left), t_left) && expr.right != null) {
                          // A bare big literal must fit the target even when
                          // the literal's own type converts (C++ checkType's
                          // constant path on the assignment RHS): `x = BIG`
                          // with `x <int>` is refused at the value. No
                          // constant-fit through `?` (init-arm pattern).
                          let asg_verdict <int> = chk_big_const_verdict(expr.right, t_left);
                          if (asg_verdict == 2) {
                              self.report_error("An integer constant is too large to represent", expr.right.line, expr.right.col);
                          } else if (asg_verdict == 1) {
                              self.report_type_mismatch(t_left, t_right, expr.right.line, expr.right.col);
                          }
                      }
                  }
                  return t_left;
              }
              if (!chk_str_eq(t_left, "auto") && !chk_str_eq(t_left, "void") && !chk_str_eq(t_left, "error")) {
                  return t_left;
              }
              if (!chk_str_eq(t_right, "auto") && !chk_str_eq(t_right, "void") && !chk_str_eq(t_right, "error")) {
                  return t_right;
              }
              return "int";
          }

          if (expr.kind == ast_unary_expr()) {
              if (chk_str_eq(expr.name, "cast")) {
                  self.check_expression(expr.left);
                  return self.resolve_type(expr.type_annotation);
              }
              if (chk_str_eq(expr.name, "sizeof")) {
                  return "int";
              }
              let t_inner <string> = self.check_expression(expr.left);
              // `i++` writes `i`, so it revives like the assignment it is
              // checked as (C++ MovedAnalysis). The operand walk above
              // already diagnosed a read of a moved variable, so this is
              // write-only.
              if ((chk_str_eq(expr.name, "++") || chk_str_eq(expr.name, "--")) && expr.left != null && expr.left.kind == ast_ident()) {
                  self.moved_revive(expr.left.name);
              }
              if (chk_str_eq(expr.name, "!")) {
                  return "bool";
              }
              if (chk_str_eq(expr.name, "?")) {
                  let len <ulong> = chk_strlen(t_inner);
                  if (len > cast<ulong>(1) && chk_strchr(t_inner, 63) != null) {
                      return substr(t_inner, 0, cast<int>(len - 1));
                  }
                  return t_inner;
              }
              if (chk_str_eq(expr.name, "&")) {
                  let b <Buffer> = new_buffer(32);
                  b.write_string(t_inner);
                  b.write_char('*');
                  let res <string> = b.to_string();
                  free_buffer(b);
                  return res;
              }
              if (chk_str_eq(expr.name, "*")) {
                  let len <ulong> = chk_strlen(t_inner);
                  if (len > cast<ulong>(1) && chk_strchr(t_inner, 42) != null) {
                      return substr(t_inner, 0, cast<int>(len - 1));
                  }
                  if (len > cast<ulong>(1) && chk_strchr(t_inner, 38) != null) {
                      return substr(t_inner, 1, cast<int>(len - 1));
                  }
                  return t_inner;
              }
              return t_inner;
          }

          if (expr.kind == ast_call_expr()) {
              // Cleared on entry and set where the tail below substitutes,
              // so the `let` narrowing check observes the outermost call
              // of the value it reads, and nothing else.
              self.last_call_subst = 0;
              if (chk_str_eq(expr.name, "sizeof") || chk_str_eq(expr.name, "__fin_sizeof")) {
                  return "int";
              }
              if (chk_str_eq(expr.name, "__fin_alloc_array")) {
                  if (expr.left != null) { self.check_expression(expr.left); }
                  let elem_ty <string> = expr.type_annotation;
                  if (elem_ty == null || chk_strlen(elem_ty) == cast<ulong>(0)) { elem_ty = "void*"; }
                  let ab <Buffer> = new_buffer(64);
                  ab.write_char('[');
                  ab.write_string(elem_ty);
                  ab.write_char(']');
                  let arr_t <string> = ab.to_string();
                  free_buffer(ab);
                  return arr_t;
              }

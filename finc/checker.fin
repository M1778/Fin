                          }
                      } else if (chk_strchr(receiver_t, 38) != null) {
                          if (rlen > cast<ulong>(1)) {
                              base_st = substr(receiver_t, 1, cast<int>(rlen - 1));
                          }
                      }
                      let b_len <int> = cast<int>(chk_strlen(base_st));
                      for (let bi <int> = 0; bi < b_len; bi++) {
                          let ch <string> = substr(base_st, bi, 1);
                          if (chk_str_eq(ch, "<")) {
                              base_st = substr(base_st, 0, bi);
                              break;
                          }
                      }
                      base_st = self.resolve_type(base_st);
                      if (chk_str_eq(base_st, "Self") && chk_strlen(self.current_struct) > cast<ulong>(0)) {
                          base_st = self.current_struct;
                      }
                      subst_recv = receiver_t;
                      subst_base = base_st;
                      if (chk_str_eq(base_st, "Collection") || chk_str_eq(base_st, "HashMap") ||
                          chk_str_eq(base_st, "prototype") || chk_str_eq(base_st, "string") ||
                          chk_str_eq(expr.name, "rm") || chk_str_eq(expr.name, "push") ||
                          chk_str_eq(expr.name, "push_back") || chk_str_eq(expr.name, "pop") ||
                          chk_str_eq(expr.name, "len") || chk_str_eq(expr.name, "length") ||
                          chk_str_eq(expr.name, "get") || chk_str_eq(expr.name, "set")) {
                          is_coll_method = true;
                      }
                      let q_buf <Buffer> = new_buffer(64);
                      q_buf.write_string(base_st);
                      q_buf.write_char('_');
                      q_buf.write_string(expr.name);
                      let q_name <string> = q_buf.to_string();
                      free_buffer(q_buf);
                      // Idempotent rewrite: a previous evaluation of this
                      // same node already resolved it to `Base_method` (the
                      // rename persists on the AST, and calls nested as
                      // receivers are evaluated twice — receiver check plus
                      // argument re-check). Recognize the resolved shape
                      // instead of prefixing twice (`Base_Base_method`).
                      let blen2 <int> = cast<int>(chk_strlen(base_st));
                      if (chk_str_starts_with(expr.name, base_st) && chk_str_eq(substr(expr.name, blen2, 1), "_")) {
                          hit_method = true;
                      } else if (self.global_scope.has(q_name)) {
                          expr.name = q_name;
                          hit_method = true;
                      } else {
                          // Inherited method (`struct Child : <Parent>`):
                          // resolve through the parents like C++
                          // getMethodType. Visibility is enforced below
                          // against the receiver (subst_base), naming the
                          // receiver like C++.
                          let inh_q <string> = self.find_inherited_method(base_st, expr.name, 0);
                          if (!chk_str_eq(inh_q, "")) {
                              expr.name = inh_q;
                              hit_method = true;
                          } else {
                              let if_buf <Buffer> = new_buffer(64);
                              if_buf.write_string("Printable_");
                              if_buf.write_string(expr.name);
                              let if_name <string> = if_buf.to_string();
                              free_buffer(if_buf);
                              if (self.global_scope.has(if_name)) {
                                  expr.name = if_name;
                              }
                          }
                      }
                  }
              }
              if (expr.name != null && chk_strlen(expr.name) > cast<ulong>(0)) {
                  if (chk_str_eq(expr.name, "Self") && chk_strlen(self.current_struct) > cast<ulong>(0)) {
                      expr.name = self.current_struct;
                  }
                  if (self.global_scope.has(expr.name) && self.global_scope.lookup(expr.name).kind == sym_struct()) {
                      // Constructor call: arity is the declared constructor's,
                      // or 0 when none is declared (C++ dummyParams). Absent
                      // from the registry when unknowable (inherited), which
                      // skips the check. Qualified `S::m` names are not
                      // constructors; they are handled below.
                      if (chk_strchr(expr.name, 58) == null) {
                          let ci <int> = self.find_arity(expr.name);
                          if (ci >= 0 && self.arity_variadic[ci] == 0) {
                              let actual <int> = self.count_call_args(expr.left, false);
                              self.check_arity("Function", expr.name, self.arity_expected[ci],
                                  self.arity_required[ci], actual, expr.line, expr.col);
                          }
                      }
                      // Mark checked (see the method tail walk): a
                      // constructor in receiver position re-enters.
                      expr.int_val = 1;
                      // ENGA slice 1: record the resolved instantiation for
                      // an explicit construction (`HashMap::<string, Data>()`
                      // records `HashMap<string, Data>`), beside the
                      // as-written turbofish.
                      if (expr.type_annotation != null && chk_strlen(expr.type_annotation) > cast<ulong>(0)) {
                          let c_inner <string> = chk_trim(expr.type_annotation);
                          let c_res <string> = self.chk_resolve_generic_spelling(c_inner);
                          if (chk_str_eq(c_res, "")) { c_res = c_inner; }
                          let cb <Buffer> = new_buffer(64);
                          cb.write_string(expr.name);
                          cb.write_char('<');
                          cb.write_string(c_res);
                          cb.write_char('>');
                          expr.resolved_spelling = cb.to_string();
                          free_buffer(cb);
                      }
                      let arg <&AstNode> = expr.left;
                      // Narrowing, like the plain-call path below: each
                      // written argument against its written parameter (calls
                      // write no receiver, so index 0 is segment 0). The
                      // segments must carry exactly the arity count or they
                      // misalign and the check skips.
                      let ct_segs <[string]> = new [string, 64]{};
                      let ct_pn <int> = 0;
                      let ct_check <bool> = false;
                      let ct_pi <int> = self.find_ptype(expr.name);
                      if (ct_pi >= 0) {
                          ct_pn = self.split_generic_segs(self.ptype_lists[ct_pi], ct_segs);
                          let ct_ai <int> = self.find_arity(expr.name);
                          if (ct_ai >= 0 && ct_pn == self.arity_expected[ct_ai]) {
                              ct_check = true;
                          }
                      }
                      let ct_i <int> = 0;
                      while (arg != null) {
                          let actual_arg <&AstNode> = arg.left;
                          if (actual_arg == null) { actual_arg = arg; }
                          let ct_at <string> = self.check_expression(actual_arg);
                          if (ct_check && ct_i < ct_pn) {
                              self.chk_check_arg_type(actual_arg, ct_at, ct_segs[ct_i]);
                          }
                          ct_i = ct_i + 1;
                          arg = arg.right;
                      }
                      delete ct_segs;
                      if (reentry) { self.quiet_recheck = self.quiet_recheck - 1; }
                      return expr.name;
                  }
                  if (!self.current_scope.has(expr.name) && !is_coll_method) {
                      if (chk_strlen(self.current_struct) > cast<ulong>(0)) {
                          let sm_buf <Buffer> = new_buffer(64);
                          sm_buf.write_string(self.current_struct);
                          sm_buf.write_char('_');
                          sm_buf.write_string(expr.name);
                          let sm_name <string> = sm_buf.to_string();
                          free_buffer(sm_buf);
                          if (self.global_scope.has(sm_name)) {
                              expr.name = sm_name;
                          }
                      }
                  }
                  if (!self.current_scope.has(expr.name) && !is_coll_method) {
                      let b <Buffer> = new_buffer(64);
                      b.write_string("call to undeclared function: ");
                      b.write_string(expr.name);
                      self.report_error(b.to_string(), expr.line, expr.col);
                      free_buffer(b);
                  }
                  // Visibility, mirroring C++ method rules: a `priv`
                  // method is callable only from inside the RECEIVER
                  // struct (subst_base; "" where no receiver was
                  // computed, falling back to the qualifier). Plain
                  // functions have no struct prefix and pass untouched.
                  self.check_priv_member(expr.name, expr.line, expr.col, 1, subst_base);
                  // Arity, mirroring C++ checkCallArguments. A scoped `S::m`
                  // name is a static call (C++ "Static method", short name,
                  // no receiver to drop); module/compiler/collection
                  // builtins carry no counted signature here, so they skip.
                  // A dot-call drops the receiver wrapper from the count.
                  // call_recv_skip carries the flattened-method shape below
                  // to the argument walk, which drops the same wrapper.
                  let call_recv_skip <bool> = false;
                  if (!is_mod_call) {
                      if (chk_strchr(expr.name, 58) != null) {
                          let sc_short <string> = chk_extract_after_dc(expr.name);
                          let sci <int> = self.find_arity(expr.name);
                          if (sci >= 0 && self.arity_variadic[sci] == 0) {
                              let actual <int> = self.count_call_args(expr.left, false);
                              self.check_arity("Static method", sc_short,
                                  self.arity_expected[sci], self.arity_required[sci],
                                  actual, expr.line, expr.col);
                          }
                      } else if (hit_method) {
                          // Explicit generic arguments on a method call are
                          // not lowered (C++ refuses identically): the
                          // instantiation they ask for has no lowering.
                          if (expr.type_annotation != null && chk_strlen(expr.type_annotation) > cast<ulong>(0)) {
                              let tb <Buffer> = new_buffer(96);
                              tb.write_string("a call to the method '");
                              tb.write_string(orig_name);
                              tb.write_string("' with explicit generic arguments is not lowered yet");
                              self.report_error(tb.to_string(), expr.line, expr.col);
                              free_buffer(tb);
                          }
                          let mi <int> = self.find_arity(expr.name);
                          if (mi >= 0 && self.arity_variadic[mi] == 0) {
                              let actual <int> = self.count_call_args(expr.left, true);
                              // Reported at the receiver, like C++.
                              let al <int> = expr.line;
                              let ac <int> = expr.col;
                              if (expr.left != null && expr.left.left != null) {
                                  al = expr.left.left.line;
                                  ac = expr.left.left.col;
                              }
                              self.check_arity("Method", orig_name, self.arity_expected[mi],
                                  self.arity_required[mi], actual, al, ac);
                          }
                      } else if (!is_coll_method) {
                          // A flattened `Target_method` name whose first
                          // argument is the receiver is a method call even
                          // without dot shape: `super::<T>::m()` (parser
                          // prepends `self`, parser.fin:692-726) and
                          // re-evaluated dot-calls (the `Base_method`
                          // rewrite persists on the AST, so the receiver
                          // block is skipped on re-entry). The receiver is
                          // implicit in all three shapes: skip it like a
                          // dot-call's, and report the short name like C++.
                          let recv_skip <bool> = false;
                          let short_nm <string> = self.strip_struct_prefix(expr.name);
                          if (!chk_str_eq(short_nm, "")) {
                              if (self.first_call_arg_is_self_recv(expr)) {
                                  recv_skip = true;
                              } else {
                                  let pre <string> = self.struct_prefix_of(expr.name);
                                  if (self.first_arg_is_prefix_typed_recv(expr, pre)) {
                                      recv_skip = true;
                                  }
                              }
                          }
                          let fi <int> = self.find_arity(expr.name);
                          if (fi >= 0 && self.arity_variadic[fi] == 0) {
                              let actual <int> = self.count_call_args(expr.left, false);
                              let disp <string> = expr.name;
                              let dkind <string> = "Function";
                              if (recv_skip) {
                                  actual = self.count_call_args(expr.left, true);
                                  disp = short_nm;
                                  dkind = "Method";
                              }
                              self.check_arity(dkind, disp, self.arity_expected[fi],
                                  self.arity_required[fi], actual, expr.line, expr.col);
                          }
                          call_recv_skip = recv_skip;
                      }
                  }
                  // Mark checked: a chained receiver (or re-walked
                  // argument) re-enters this same node, which then only
                  // recomputes its type (the `reentry` guard above).
                  // int_val is unused on call nodes (member access uses
                  // it as its deref flag; literals carry their value).
                  expr.int_val = 1;
                  // A bare big literal must fit the parameter it is passed
                  // to (C++ checkCallArguments' checkType per argument, which
                  // also reports at the argument): `g(BIG)` with `c <int>`
                  // is refused at the value even though the literal types as
                  // int. The same checkType also refuses plain narrowing
                  // (`take(s: string)` with `x <int>`), reported at the
                  // argument like `=` and `return`. Scoped (`S::m`) names
                  // check through the same registry (arity and ptypes are
                  // recorded under `S::m`); module calls skip like arity
                  // does. The split must carry exactly the arity count or
                  // the segments misalign and the check skips. The receiver
                  // wrapper drops like arity drops it.
                  let pcheck <bool> = false;
                  let pskip <bool> = false;
                  let psegs <[string]> = new [string, 64]{};
                  let pn <int> = 0;
                  if (!is_mod_call) {
                      let cpi <int> = self.find_ptype(expr.name);
                      if (cpi >= 0) {
                          pn = self.split_generic_segs(self.ptype_lists[cpi], psegs);
                          let cai <int> = self.find_arity(expr.name);
                          if (cai >= 0 && pn == self.arity_expected[cai]) {
                              pcheck = true;
                              if (hit_method || call_recv_skip) { pskip = true; }
                          }
                      }
                  }
                  // Generic substitution for this call (C++ checkGenericCall):
                  // a free function's turbofish binds its declared
                  // parameters positionally (the written seed, which
                  // outranks inference); a method's struct parameters come
                  // from the receiver's type arguments and its own
                  // parameters unify from the arguments in order, first
                  // wins. Anything left unbound keeps today's skip, never a
                  // bogus diagnostic. Method calls with an explicit
                  // turbofish stay refused above (not lowered); static
                  // `S::m` and constructors keep their own paths.
                  let s_names <[string]> = new [string, 64]{};
                  let s_vals <[string]> = new [string, 64]{};
                  let s_n <int> = 0;
                  let bind_names <[string]> = new [string, 64]{};
                  let bind_vals <[string]> = new [string, 64]{};
                  let bind_n <int> = 0;
                  // `$struct` value-handle pairs for return seeding below.
                  let seed_count <int> = 0;
                  let seed_name <string> = "";
                  let is_free_shape <bool> = !hit_method && !call_recv_skip && !is_mod_call &&
                      !is_coll_method && chk_strchr(expr.name, 58) == null &&
                      chk_str_eq(self.struct_prefix_of(expr.name), "");
                  let has_turbo <bool> = expr.type_annotation != null &&
                      chk_strlen(expr.type_annotation) > cast<ulong>(0);
                  if (has_turbo && is_free_shape) {
                      bind_n = self.lookup_generic_pnames(expr.name, bind_names);
                      if (bind_n == 0) {
                          // Written arguments to a declared non-generic
                          // callee (C++ declares-0 voice, at the call like
                          // every arity diagnostic here). The arity registry
                          // owns the declared-ness: variables holding
                          // functions and unknown callees (already refused
                          // above) keep the silence they always had, as do
                          // imported functions, which record no generics
                          // here.
                          if (self.find_arity(expr.name) >= 0) {
                              let tn0 <int> = self.count_generic_args(expr.type_annotation);
                              let cb <Buffer> = new_buffer(96);
                              cb.write_string("Generic count mismatch: '");
                              cb.write_string(expr.name);
                              cb.write_string("' declares 0 parameter(s), the call writes ");
                              cb.write_int(tn0);
                              self.report_error(cb.to_string(), expr.line, expr.col);
                              free_buffer(cb);
                          }
                      } else {
                          let tsegs <[string]> = new [string, 64]{};
                          let tn <int> = self.split_turbofish(expr.type_annotation, tsegs);
                          if (tn != bind_n) {
                              let cb2 <Buffer> = new_buffer(96);
                              cb2.write_string("Generic count mismatch: '");
                              cb2.write_string(expr.name);
                              cb2.write_string("' declares ");
                              cb2.write_int(bind_n);
                              cb2.write_string(" parameter(s), the call writes ");
                              cb2.write_int(tn);
                              self.report_error(cb2.to_string(), expr.line, expr.col);
                              free_buffer(cb2);
                          }
                          // Fewer written than declared still binds what is
                          // written (the rest unifies from the arguments in
                          // the walk, the C++ partial rule); more written
                          // binds what the declaration has. Unresolvable
                          // words bind nothing (C++ sentinel rule).
                          let bn <int> = tn;
                          if (bn > bind_n) { bn = bind_n; }
                          let bi <int> = 0;
                          while (bi < bn) {
                              let tw <string> = self.resolve_type(chk_trim(tsegs[bi]));
                              if (self.chk_is_known_type_name(tw)) {
                                  bind_vals[bi] = tw;
                              }
                              bi = bi + 1;
                          }
                          delete tsegs;
                      }
                  }
                  // Free-function inference (C++ checkGenericCall): without a
                  // turbofish the declared parameters still unify from the
                  // arguments in the walk below (first wins), so the result
                  // substitution sees them. Turbofish seeds above; methods
                  // own the next arm. Non-generics record nothing, so this
                  // leaves them exactly as today.
                  if (is_free_shape && !has_turbo) {
                      bind_n = self.lookup_generic_pnames(expr.name, bind_names);
                  }
                  if (hit_method || call_recv_skip) {
                      bind_n = self.lookup_generic_pnames(expr.name, bind_names);
                      if (subst_base != null && chk_strlen(subst_base) > cast<ulong>(0)) {
                          let spn <int> = self.lookup_generic_pnames(subst_base, s_names);
                          if (spn > 0) {
                              let avn <int> = self.receiver_type_args(subst_recv, subst_base, s_vals);
                              if (avn == spn) { s_n = spn; }
                          }
                      }
                  }
                  let arg <&AstNode> = expr.left;
                  let ai <int> = 0;
                  while (arg != null) {
                      let actual_arg <&AstNode> = arg.left;
                      if (actual_arg == null) { actual_arg = arg; }
                      let at <string> = self.check_expression(actual_arg);
                      if (pcheck && !(pskip && ai == 0)) {
                          let si <int> = ai;
                          if (pskip) { si = si - 1; }
                          if (si >= 0 && si < pn) {
                              let seg <string> = psegs[si];
                              if (s_n > 0) {
                                  seg = self.subst_generic_words(seg, s_names, s_vals, s_n);
                              }
                              if (bind_n > 0) {
                                  seg = self.subst_generic_words(seg, bind_names, bind_vals, bind_n);
                              }
                              self.chk_check_arg_type(actual_arg, at, seg);
                              // Unify an unbound bare-word parameter from
                              // this argument (C++ unify order: check, then
                              // bind, first wins). Sentinels never bind.
                              if (bind_n > 0) {
                                  let seg0 <string> = chk_trim(psegs[si]);
                                  if (self.chk_is_bare_word(seg0)) {
                                      let k2 <int> = 0;
                                      while (k2 < bind_n) {
                                          if (chk_str_eq(bind_names[k2], seg0) &&
                                              (bind_vals[k2] == null || chk_strlen(bind_vals[k2]) == cast<ulong>(0))) {
                                              if (!chk_str_eq(at, "auto") && !chk_str_eq(at, "error") &&
                                                  !chk_str_eq(at, "void") && !chk_str_eq(at, "void*") &&
                                                  !chk_str_eq(at, "module")) {
                                                  bind_vals[k2] = self.resolve_type(at);
                                              }
                                              break;
                                          }
                                          k2 = k2 + 1;
                                      }
                                  }
                              }
                              // A `$struct` parameter receiving a struct
                              // literal counts a value-handle pair (C++
                              // checkGenericCall's `$struct` seeding): the
                              // literal marker names its stashed
                              // declaration. Counted, not bound yet: one
                              // unambiguous handle seeds an unbound bare
                              // return below, several stay unbound.
                              if (chk_str_eq(chk_trim(psegs[si]), "$struct") &&
                                  actual_arg.kind == ast_prototype_literal() &&
                                  actual_arg.type_annotation != null &&
                                  chk_str_eq(actual_arg.type_annotation, "$struct") &&
                                  actual_arg.str_val != null &&
                                  chk_strlen(actual_arg.str_val) > cast<ulong>(0)) {
                                  if (self.global_scope.has(actual_arg.str_val)) {
                                      let seedsym <Symbol> = self.global_scope.lookup(actual_arg.str_val);
                                      if (seedsym.kind == sym_struct()) {
                                          seed_count = seed_count + 1;
                                          seed_name = actual_arg.str_val;
                                      }
                                  }
                              }
                          }
                      }
                      ai = ai + 1;
                      arg = arg.right;
                  }
                  delete psegs;
                  // One unambiguous `$struct` handle seeds an unbound bare
                  // return (C++ checkGenericCall's structLiteralTypes_
                  // seeding): `make_default(struct { ... })` types the call
                  // as the literal's struct, which is the only thing saying
                  // which members the result has. Fills only a return
                  // parameter nothing bound yet (a turbofish seed or an
                  // argument binding wins by first-binding-wins) and only
                  // under a dynamic bound (`<T: int>` stays unbound: a
                  // struct is not one of those, and the call-site bound
                  // check owns that refusal). Several handles stay unbound
                  // rather than guessed.
                  if (seed_count == 1 && bind_n > 0 && seed_name != null &&
                      chk_strlen(seed_name) > cast<ulong>(0) &&
                      self.current_scope.has(expr.name)) {
                      let seed_sym <Symbol> = self.current_scope.lookup(expr.name);
                      let seed_rt <string> = chk_trim(self.resolve_type(seed_sym.type_name));
                      if (self.chk_is_bare_word(seed_rt)) {
                          let sk <int> = 0;
                          while (sk < bind_n) {
                              if (chk_str_eq(bind_names[sk], seed_rt) &&
                                  (bind_vals[sk] == null || chk_strlen(bind_vals[sk]) == cast<ulong>(0))) {
                                  let seed_bound <string> = self.generic_bound_of(expr.name, seed_rt);
                                  if (chk_strlen(seed_bound) == cast<ulong>(0)) {
                                      bind_vals[sk] = seed_name;
                                  } else {
                                      let seed_base <string> = self.bound_base_word(seed_bound);
                                      if (chk_str_eq(seed_base, "any") || chk_str_eq(seed_base, "object") ||
                                          chk_str_eq(seed_base, "Struct")) {

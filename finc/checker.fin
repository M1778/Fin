                                      }
                                  }
                                  break;
                              }
                              sk = sk + 1;
                          }
                      }
                  }
                  // The `let` narrowing check observes whether this call
                  // substituted its return: receiver type arguments count,
                  // and any bound parameter (turbofish seed or argument
                  // binding) counts. Anything else checks below exactly
                  // like an unsubstituted call.
                  let applied <bool> = false;
                  if (s_n > 0) {
                      applied = true;
                  } else {
                      let q <int> = 0;
                      while (q < bind_n) {
                          if (bind_vals[q] != null && chk_strlen(bind_vals[q]) > cast<ulong>(0)) {
                              applied = true;
                              break;
                          }
                          q = q + 1;
                      }
                  }
                  if (applied) { self.last_call_subst = 1; }
                  if (reentry) { self.quiet_recheck = self.quiet_recheck - 1; }
                  if (self.current_scope.has(expr.name)) {
                      let fn_sym2 <Symbol> = self.current_scope.lookup(expr.name);
                      let fn_rt <string> = self.resolve_type(fn_sym2.type_name);
                      // The call's type is the substituted return (C++
                      // checkGenericCall): `s.m(1)` with `m<T>(a: T) <T>`
                      // is an `int`, not a `T`.
                      if (s_n > 0) {
                          fn_rt = self.subst_generic_words(fn_rt, s_names, s_vals, s_n);
                      }
                      if (bind_n > 0) {
                          fn_rt = self.subst_generic_words(fn_rt, bind_names, bind_vals, bind_n);
                      }
                      let subst <string> = self.subst_receiver_return(subst_recv, subst_base, fn_rt);
                      if (!chk_str_eq(subst, "")) {
                          delete s_names;
                          delete s_vals;
                          delete bind_names;
                          delete bind_vals;
                          return subst;
                      }
                      if (!self.chk_is_known_type_name(fn_rt)) {
                          delete s_names;
                          delete s_vals;
                          delete bind_names;
                          delete bind_vals;
                          return "auto";
                      }
                      delete s_names;
                      delete s_vals;
                      delete bind_names;
                      delete bind_vals;
                      return fn_rt;
                  }
                  delete s_names;
                  delete s_vals;
                  delete bind_names;
                  delete bind_vals;
                  return "void";
              }
              if (expr.left != null) {
                  let fn_t <string> = self.check_expression(expr.left);
                  let arg <&AstNode> = expr.extra;
                  while (arg != null) {
                      self.check_expression(arg);
                      arg = arg.right;
                  }
                  return "auto";
              }
              return "void";
          }

          // A quote is data, not code: its block is never analysed here
          // (handlers' quotes are checked after splicing, which the
          // self-hosted compiler does not do). The type is `quote`.
          if (expr.kind == ast_quote_expr()) {
              return "quote";
          }

          if (expr.kind == ast_prototype_literal()) {
              let cur <&AstNode> = expr.left;
              while (cur != null) {
                  if (cur.left != null) { self.check_expression(cur.left); }
                  if (cur.right != null) { self.check_expression(cur.right); }
                  cur = cur.extra;
              }
              // An `interface { ... }` literal is parsed as a prototype
              // node tagged `$interface` (parser.fin:1080-1082): it is an
              // interface value, not a prototype one.
              if (expr.type_annotation != null && chk_strlen(expr.type_annotation) > cast<ulong>(0)) {
                  return self.resolve_type(expr.type_annotation);
              }
              return "prototype";
          }

          if (expr.kind == ast_index_expr()) {
              let t_arr <string> = self.check_expression(expr.left);
              self.check_expression(expr.right);
              t_arr = self.resolve_type(t_arr);
              if (t_arr != null) {
                  let alen <ulong> = chk_strlen(t_arr);
                  if (chk_str_eq(t_arr, "string")) {
                      return "char";
                  }
                  if (alen > cast<ulong>(2) && chk_strchr(t_arr, 91) != null && chk_strchr(t_arr, 93) != null) {
                      return substr(t_arr, 1, cast<int>(alen - 2));
                  }
                  if (alen > cast<ulong>(1) && chk_strchr(t_arr, 42) != null) {
                      return substr(t_arr, 0, cast<int>(alen - 1));
                  }
              }
              return "int";
          }

          if (expr.kind == ast_member_access()) {
              if (chk_str_eq(expr.name, "length") || chk_str_eq(expr.name, "len") || chk_str_eq(expr.name, "count")) {
                  return "int";
              }
              let t_base <string> = self.check_expression(expr.left);
              t_base = self.resolve_type(t_base);
              if (t_base != null) {
                  if (chk_str_eq(t_base, "compiler") || chk_str_starts_with(t_base, "compiler.")) {
                      return self.api_check_read(t_base, expr.name, expr.line, expr.col);
                  }
                  // Meta-type bases are opaque: layout reads go through the
                  // `layout` component under either spelling (C++
                  // tryLayoutMember), and anything else is not a struct.
                  if (chk_str_eq(t_base, "$type") || chk_str_eq(t_base, "$struct") ||
                      chk_str_eq(t_base, "$interface") || chk_str_eq(t_base, "$enum_member")) {
                      if ((chk_str_eq(t_base, "$type") || chk_str_eq(t_base, "$struct")) &&
                          (chk_str_eq(expr.name, "size") || chk_str_eq(expr.name, "align") ||
                           chk_str_eq(expr.name, "pointer_count"))) {
                          if (self.quiet_compiler == 0) {
                              if (!self.api_require_grant("layout", expr.line, expr.col)) {
                                  return "error";
                              }
                          }
                          if (chk_str_eq(expr.name, "pointer_count")) { return "int"; }
                          return "uint";
                      }
                      if (self.quiet_compiler == 0) {
                          let ml2 <int> = expr.line;
                          let mc2 <int> = expr.col;
                          if (expr.left != null) {
                              ml2 = expr.left.line;
                              mc2 = expr.left.col;
                          }
                          let mb2 <Buffer> = new_buffer(64);
                          mb2.write_string("Type '");
                          mb2.write_string(t_base);
                          mb2.write_string("' is not a struct");
                          let mm2 <string> = mb2.to_string();
                          free_buffer(mb2);
                          self.report_error(mm2, ml2, mc2);
                      }
                      return "error";
                  }
                  // A union alias keeps its alternatives instead of
                  // collapsing to its first member (Round 3, Q12): a member
                  // read on a union value is one diagnostic, not a crash and
                  // not silence. Spelled with spaces like the C++ wording.
                  if (chk_strchr(t_base, 124) != null) {
                      let uu <Buffer> = new_buffer(64);
                      let ucs <[char]> = to_chars(t_base);
                      let ulen <int> = cast<int>(chk_strlen(t_base));
                      for (let ui <int> = 0; ui < ulen; ui++) {
                          if (ucs[ui] == cast<char>(124)) { uu.write_string(" | "); }
                          else { uu.write_char(ucs[ui]); }
                      }
                      delete ucs;
                      let umb <Buffer> = new_buffer(64);
                      umb.write_string("Type '");
                      umb.write_string(uu.to_string());
                      umb.write_string("' is not a struct");
                      let uml <int> = expr.line;
                      let umc <int> = expr.col;
                      if (expr.left != null) {
                          uml = expr.left.line;
                          umc = expr.left.col;
                      }
                      self.report_error(umb.to_string(), uml, umc);
                      free_buffer(umb);
                      free_buffer(uu);
                      return "error";
                  }
                  let base_st <string> = t_base;
                  let blen <ulong> = chk_strlen(t_base);
                  if (chk_strchr(t_base, 42) != null) {
                      expr.int_val = 1;
                      if (blen > cast<ulong>(1)) {
                          base_st = substr(t_base, 0, cast<int>(blen - 1));
                      }
                  } else if (chk_strchr(t_base, 38) != null) {
                      expr.int_val = 1;
                      if (blen > cast<ulong>(1)) {
                          base_st = substr(t_base, 1, cast<int>(blen - 1));
                      }
                  } else {
                      expr.int_val = 0;
                  }
                  base_st = self.resolve_type(base_st);
                  if (chk_str_eq(base_st, "Self") && chk_strlen(self.current_struct) > cast<ulong>(0)) {
                      base_st = self.current_struct;
                  }
                  // Generic receivers look their fields up under the
                  // unspecialized base (`B<int>` reads `B_v`, like method
                  // calls strip to subst_base): the full spelling stays on
                  // recv_full for the substitution on a hit.
                  let recv_full <string> = base_st;
                  let ga_len <int> = cast<int>(chk_strlen(base_st));
                  let ga <int> = 0;
                  while (ga < ga_len) {
                      if (chk_str_eq(substr(base_st, ga, 1), "<")) {
                          base_st = substr(base_st, 0, ga);
                          break;
                      }
                      ga = ga + 1;
                  }
                  base_st = self.resolve_type(base_st);
                  let q_buf <Buffer> = new_buffer(64);
                  q_buf.write_string(base_st);
                  q_buf.write_char('_');
                  q_buf.write_string(expr.name);
                  let q_name <string> = q_buf.to_string();
                  free_buffer(q_buf);
                  if (self.global_scope.has(q_name)) {
                      let fld_sym <Symbol> = self.global_scope.lookup(q_name);
                      self.check_priv_member(q_name, expr.line, expr.col, 0, base_st);
                      return self.subst_field_return(recv_full, base_st, fld_sym.type_name);
                  }
                  let q2_buf <Buffer> = new_buffer(64);
                  q2_buf.write_string(base_st);
                  q2_buf.write_string("::");
                  q2_buf.write_string(expr.name);
                  let q2_name <string> = q2_buf.to_string();
                  free_buffer(q2_buf);
                  if (self.global_scope.has(q2_name)) {
                      let fld_sym2 <Symbol> = self.global_scope.lookup(q2_name);
                      self.check_priv_member(q2_name, expr.line, expr.col, 0, base_st);
                      return self.subst_field_return(recv_full, base_st, fld_sym2.type_name);
                  }
                  // Inherited members (`struct Student : <Person>`):
                  // walk the parents before refusing, like C++.
                  let inh_ty <string> = self.find_inherited_member_type(base_st, expr.name, base_st, 0, expr.line, expr.col);
                  if (!chk_str_eq(inh_ty, "")) {
                      return self.resolve_type(inh_ty);
                  }
                  // The field list is authoritative only for structs
                  // (interface/enum members are not recorded here, and a
                  // numeric member is positional payload access, enums.fin:38),
                  // so only a struct base can refuse an unknown member.
                  if (self.global_scope.has(base_st)) {
                      let bsym <Symbol> = self.global_scope.lookup(base_st);
                      if (bsym.kind == sym_struct() && !self.member_name_is_positional(expr.name)) {
                          // Reported at the object, like C++.
                          let ml <int> = expr.line;
                          let mc <int> = expr.col;
                          if (expr.left != null) {
                              ml = expr.left.line;
                              mc = expr.left.col;
                          }
                          let mb <Buffer> = new_buffer(64);
                          mb.write_string("Struct '");
                          mb.write_string(base_st);
                          mb.write_string("' has no member '");
                          mb.write_string(expr.name);
                          mb.write_string("'");
                          self.report_error(mb.to_string(), ml, mc);
                          free_buffer(mb);
                          return "error";
                      }
                  }
              }
              return "auto";
          }

          return "void";
      }

      // True for positional payload access (`.0`, enums.fin:38).
      fun member_name_is_positional(self: &Self, name: string) <bool> {
          if (name == null || chk_strlen(name) == cast<ulong>(0)) { return false; }
          let cs <[char]> = to_chars(name);
          let c <char> = cs[0];
          delete cs;
          if (c >= '0' && c <= '9') { return true; }
          return false;
      }

      fun check_statement(self: &Self, stmt: &AstNode) <noret> {
          if (stmt == null) { return; }

          if (stmt.kind == ast_break_stmt() || stmt.kind == ast_continue_stmt()) {
              if (self.loop_depth <= 0) {
                  let kw <string> = "break";
                  if (stmt.kind == ast_continue_stmt()) { kw = "continue"; }
                  let b <Buffer> = new_buffer(48);
                  b.write_string("'");
                  b.write_string(kw);
                  b.write_string("' used outside of loop");
                  self.report_error(b.to_string(), stmt.line, stmt.col);
                  free_buffer(b);
              }
              return;
          }

          if (stmt.kind == ast_fun_decl()) {
              let fn_sym <Symbol> = make_fn_sym(stmt.name, stmt.type_annotation, true);
              self.current_scope.insert_symbol(fn_sym);
              self.check_function(stmt);
              return;
          }

          if (stmt.kind == ast_var_decl()) {
              self.api_validate_attrs(stmt.attr_text, true, false, stmt.line, stmt.col);
              let inferred <string> = "auto";
              // The narrowing check below observes only a substituted call
              // value (see last_call_subst): anything else leaves the flag
              // as the value's own check left it, which for non-calls is
              // this reset.
              self.last_call_subst = 0;
              if (stmt.left != null) {
                  inferred = self.check_expression(stmt.left);
              }
              // A binding initialised from a host read taints its name for
              // the rest of the body (C++ HostBranchWalk): branching on it
              // later warns naming the host operation behind it.
              if (self.host_warn != 0 && stmt.left != null && stmt.name != null) {
                  let hop <string> = self.host_find(stmt.left);
                  if (!chk_str_eq(hop, "")) {
                      self.host_taint(stmt.name, hop);
                  }
              }
              // An `auto` (or empty) annotation takes the value's type, so no
              // narrowing check applies to it (C++ checkInitializer runs on
              // the declared type): `let x <auto> = BIG` stays an int.
              let was_auto <bool> = chk_str_eq(stmt.type_annotation, "auto") || chk_strlen(stmt.type_annotation) == cast<ulong>(0);
              if (was_auto) {
                  if (!chk_str_eq(inferred, "auto") && !chk_str_eq(inferred, "void") && !chk_str_eq(inferred, "error")) {
                      stmt.type_annotation = inferred;
                  }
              }
              stmt.type_annotation = self.resolve_type(stmt.type_annotation);
              // ENGA slice 1: record the resolved target+args spelling for
              // the backend's per-instantiation keys (`Collection<A>` with
              // `type A = int` records `Collection<int>`), beside the
              // as-written annotation diagnostics keep pointing at.
              stmt.resolved_spelling = self.chk_resolve_generic_spelling(stmt.type_annotation);
              // A nullable binding initialised from a value checks like an
              // assignment (C++ checkInitializer): `long? = <int>` widens,
              // `char? = 65` does not (no constant-fit through `?`).
              // Reported at the value, like `=`. `null` types as `void*`
              // and rides the predicate's own exemption.
              if (stmt.left != null && !chk_str_eq(inferred, "auto") && !chk_str_eq(inferred, "void") && !chk_str_eq(inferred, "error")) {
                  // Explicit annotations narrow a substituted call value
                  // like `=` (C++ checkInitializer): `let x <int> =
                  // id::<string>(1)` is refused at the value as well as at
                  // the argument. Nullable annotations stay on the arm
                  // below, and integer constants against integer targets
                  // stay on the constant-fit arm after it (same voice,
                  // reported once): this owns only what neither arm
                  // answers. Gated on a substituted call value: only an
                  // inference site produces a type the annotation must
                  // agree with, and every other value keeps the checking
                  // it always had.
                  if (self.last_call_subst == 1 && !was_auto && chk_str_eq(self.chk_strip_qmark(stmt.type_annotation), stmt.type_annotation) &&
                      !(chk_int_bits(stmt.type_annotation) > 0 && chk_is_int_const(stmt.left))) {
                      if (!self.chk_types_compatible(inferred, stmt.type_annotation)) {
                          self.report_type_mismatch(stmt.type_annotation, inferred, stmt.left.line, stmt.left.col);
                      }
                  }
                  if (!chk_str_eq(self.chk_strip_qmark(stmt.type_annotation), stmt.type_annotation)) {
                      if (!self.chk_types_compatible(inferred, stmt.type_annotation)) {
                          self.report_type_mismatch(stmt.type_annotation, inferred, stmt.left.line, stmt.left.col);
                      }
                  }
                  // A bare big literal types as int but must fit the declared
                  // width (C++ constantFitsType via checkInitializer):
                  // `let x <int> = BIG` is refused at the value rather than
                  // truncated. Explicit annotations only; `auto` above took
                  // the value's own type.
                  if (!was_auto && chk_str_eq(self.chk_strip_qmark(stmt.type_annotation), stmt.type_annotation)) {
                      let big_verdict <int> = chk_big_const_verdict(stmt.left, stmt.type_annotation);
                      if (big_verdict == 2) {
                          self.report_error("An integer constant is too large to represent", stmt.left.line, stmt.left.col);
                      } else if (big_verdict == 1) {
                          self.report_type_mismatch(stmt.type_annotation, inferred, stmt.left.line, stmt.left.col);
                      }
                  }
                  // Plain explicit annotations check like `=` (C++
                  // checkInitializer): `let y <string> = 1` is refused at
                  // the value. Owns only what no earlier arm answers:
                  // non-nullable targets (the nullable arm owns `?`),
                  // unsubstituted values (the subst arm owns those), and
                  // never integer constants against integer targets (the
                  // big-const arm owns those, fitting or not, like `=`).
                  // Unknown names and unbound generic words skip like call
                  // arguments, and so do stage-spelling artifacts no user
                  // type writes: a call typed as a whole function (`f(key)`
                  // for an `f` of fn type models the callee, not the
                  // result), a `,` spelling (`int,3*`), and `{...}` widths
                  // (`*int{64}`). An array literal whose every element is
                  // a fitting constant judges element-wise like C++; a
                  // mismatch is re-asked without parentheses (`&(&int)`
                  // is `&&int`) before it reports. Only misses, never
                  // invents.
                  // A function spelling on either side skips like the
                  // fnvar-call-result shape above: a bare function name
                  // types as its return (or a fallback), never as the
                  // `fn(...)` spelling, so `let f <fn(int) => int> = id`
                  // would misfire here. Signature compat is out of scope.
                  if (!was_auto && chk_str_eq(self.chk_strip_qmark(stmt.type_annotation), stmt.type_annotation) &&
                      self.last_call_subst != 1 &&
                      !(chk_int_bits(stmt.type_annotation) > 0 && chk_is_int_const(stmt.left)) &&
                      self.chk_is_known_type_name(inferred) && self.chk_is_known_type_name(stmt.type_annotation) &&
                      !self.chk_mentions_gen_param(inferred) && !self.chk_mentions_gen_param(stmt.type_annotation) &&
                      chk_strchr(inferred, 44) == null &&
                      chk_strchr(inferred, 123) == null && chk_strchr(inferred, 125) == null &&
                      chk_strchr(stmt.type_annotation, 123) == null && chk_strchr(stmt.type_annotation, 125) == null &&
                      !(stmt.left.kind == ast_call_expr() && chk_strchr(inferred, 40) != null) &&
                      !chk_str_contains(stmt.type_annotation, "fn(") && !chk_str_contains(inferred, "fn(") &&
                      !self.chk_arr_literal_all_fit(stmt.left, stmt.type_annotation)) {
                      if (!self.chk_types_compatible(inferred, stmt.type_annotation)) {
                          let pi <string> = chk_strip_parens(inferred);
                          let pe <string> = chk_strip_parens(stmt.type_annotation);
                          let paren_same <bool> = false;
                          if ((!chk_str_eq(pi, inferred) || !chk_str_eq(pe, stmt.type_annotation)) &&
                              self.chk_types_compatible(pi, pe)) {
                              paren_same = true;
                          }
                          if (!paren_same) {
                              self.report_type_mismatch(stmt.type_annotation, inferred, stmt.left.line, stmt.left.col);
                          }
                      }
                  }
              }
              // Wave-5 slice 4: resolve the `#[slaveof(...)]` referent
              // before the binding is defined, so the name cannot meet
              // itself (C++ visit(VariableDeclaration&)).
              self.check_slaveof_tie(stmt.attr_text, stmt.name, stmt.line, stmt.col);
              if (!chk_str_eq(stmt.name, "_") && !chk_str_eq(stmt.name, "_?")) {
                  let sym <Symbol> = make_var_sym(stmt.name, stmt.type_annotation, true);
                  let ok <bool> = self.current_scope.insert_symbol(sym);
                  if (!ok) {
                      self.report_error("duplicate declaration of variable in current scope", stmt.line, stmt.col);
                  }
              }
              return;
          }

          if (stmt.kind == ast_return_stmt()) {
              if (stmt.left != null) {
                  let rt <string> = self.check_expression(stmt.left);
                  // A call through a bare function name types as the whole
                  // `fn(...)` spelling (the callee variable's type, not its
                  // result), so `return f(x)` through one would misfire here
                  // exactly like the `let` shape FN1 skips (functions.fin:25,
                  // lambdas.fin:9). Same skip: a call value carrying an `fn(`
                  // spelling is never a return mismatch (C++ answers the
                  // result type); signature compat stays out of scope like
                  // there. Misses, never invents.
                  let ret_fn_skip <bool> = stmt.left.kind == ast_call_expr() && chk_str_contains(rt, "fn(");
                  // Reported at the value, like C++. `void` actuals ride on
                  // an earlier diagnostic (or a void call); the predicate
                  // accepts the remaining sentinels itself. A `@special`
                  // body is never return-checked (the backend resolves it
                  // but checks no returns there): only the value's own
                  // diagnostics report.
                  if (!ret_fn_skip && !chk_str_eq(rt, "void") && self.in_special_body == 0 && !self.chk_types_compatible(rt, self.current_ret_type)) {
                      // C++ checkType's narrowing path still accepts a
                      // constant that fits: suppress only that shape (an
                      // int-constant node with a fitting verdict), so a
                      // fitting `return 3000000000` to `<uint>` stays silent
                      // while variables and unfit constants report.
                      let fit_ok <bool> = false;
                      if (chk_int_bits(self.current_ret_type) > 0 && chk_is_int_const(stmt.left) && chk_big_const_verdict(stmt.left, self.current_ret_type) == 0) {
                          fit_ok = true;
                      }
                      if (!fit_ok) {
                          self.report_type_mismatch(self.current_ret_type, rt, stmt.left.line, stmt.left.col);
                      }
                  } else if (!chk_str_eq(rt, "void") && !chk_str_eq(rt, "auto") && !chk_str_eq(rt, "error") &&
                      self.in_special_body == 0 && chk_str_eq(self.chk_strip_qmark(self.current_ret_type), self.current_ret_type)) {
                      // A bare big literal must fit the declared return even
                      // when the literal's own type converts (C++ checkType's
                      // constant path via visit(ReturnStatement&)): `return
                      // BIG` to `<int>` is refused at the value. No
                      // constant-fit through `?` (init-arm pattern).
                      let ret_verdict <int> = chk_big_const_verdict(stmt.left, self.current_ret_type);
                      if (ret_verdict == 2) {
                          self.report_error("An integer constant is too large to represent", stmt.left.line, stmt.left.col);
                      } else if (ret_verdict == 1) {
                          self.report_type_mismatch(self.current_ret_type, rt, stmt.left.line, stmt.left.col);
                      }
                  }
              } else {
                  if (self.in_special_body == 0 && !self.chk_types_compatible("void", self.current_ret_type)) {
                      self.report_type_mismatch(self.current_ret_type, "void", stmt.line, stmt.col);
                  }
              }
              return;
          }

          if (stmt.kind == ast_blame_stmt()) {
              // Owner decision: `m1778` stays purely a compile-time marker.
              // `blame m1778;` never reaches lowering: the C++ backend refuses
              // it at compile time (`codegen: 'm1778' is not lowered yet`,
              // exit 1, even in dead code), so the checker refuses it here by
              // the same name instead of letting codegen emit a runtime abort.
              // Only the bare `blame m1778` condition is refused here: every
              // other `m1778` path (parser literal, `void*` expression type,
              // `--no-check` lowering) is untouched; a bare `m1778;`
              // statement is refused by the expression-statement arm below.
              if (stmt.left != null && stmt.left.kind == ast_ident() && chk_str_eq(stmt.left.name, "m1778")) {
                  self.report_error("codegen: 'm1778' is not lowered yet", stmt.left.line, stmt.left.col);
                  return;
              }
              if (stmt.left != null) {
                  self.check_expression(stmt.left);
              }
              return;
          }

          if (stmt.kind == ast_expr_stmt()) {
              // Like `blame m1778` above: the C++ backend refuses a bare
              // `m1778` at lowering (`codegen: 'm1778' is not lowered yet`,
              // exit 1, located at the token), so the checker refuses it
              // here by the same name and at the same position instead of
              // letting codegen drop it silently. Only the bare statement
              // is refused: `m1778` as a value keeps its `void*` type below.
              if (stmt.left != null && stmt.left.kind == ast_ident() && chk_str_eq(stmt.left.name, "m1778")) {
                  self.report_error("codegen: 'm1778' is not lowered yet", stmt.left.line, stmt.left.col);
                  return;
              }
              if (stmt.left != null) {
                  self.check_expression(stmt.left);
              }
              return;
          }

          if (stmt.kind == ast_if_stmt()) {
              if (stmt.left != null) {
                  self.host_warn_cond(stmt.left);
                  self.check_expression(stmt.left);
              }
              // The arms join: only what moved on every path stays moved
              // (C++ installJoin), so a maybe-moved binding stays readable.
              let pre <[string]> = new [string, 64]{};
              let pn <int> = self.moved_snapshot(pre);
              if (stmt.right != null) {
                  self.check_statement(stmt.right);
              }
              let then_snap <[string]> = new [string, 64]{};
              let tn <int> = self.moved_snapshot(then_snap);
              self.moved_restore(pre, pn);
              if (stmt.extra != null) {
                  self.check_statement(stmt.extra);
              }
              self.moved_intersect(then_snap, tn);
              return;
          }

          if (stmt.kind == ast_while_stmt()) {
              // The body may run zero times: what stays moved is what was
              // moved before and after, like the one-armed branch above.
              let wpre <[string]> = new [string, 64]{};
              let wpn <int> = self.moved_snapshot(wpre);
              if (stmt.left != null) {
                  self.host_warn_cond(stmt.left);
                  self.check_expression(stmt.left);
              }
              if (stmt.right != null) {
                  self.loop_depth = self.loop_depth + 1;
                  self.check_statement(stmt.right);
                  self.loop_depth = self.loop_depth - 1;
              }
              self.moved_intersect(wpre, wpn);
              return;
          }

          if (stmt.kind == ast_for_stmt()) {
              let fpre <[string]> = new [string, 64]{};
              let fpn <int> = self.moved_snapshot(fpre);
              self.enter_scope();
              if (stmt.left != null) {
                  self.check_statement(stmt.left);
              }
              if (stmt.right != null) {
                  self.host_warn_cond(stmt.right);
                  self.check_expression(stmt.right);
              }
              if (stmt.extra != null) {
                  self.loop_depth = self.loop_depth + 1;
                  if (stmt.extra.left != null) {
                      self.check_expression(stmt.extra.left);
                  }
                  if (stmt.extra.right != null) {
                      self.check_statement(stmt.extra.right);
                  }
                  self.loop_depth = self.loop_depth - 1;
              }
              self.exit_scope();
              self.moved_intersect(fpre, fpn);
              return;
          }

          if (stmt.kind == ast_block()) {
              self.enter_scope();
              let cur <&AstNode> = stmt.left;
              while (cur != null) {
                  self.check_statement(cur.left);
                  cur = cur.right;
              }
              self.exit_scope();
              return;
          }
      }

      fun check_function(self: &Self, fn_node: &AstNode) <noret> {
          if (fn_node == null) { return; }

          self.check_function_signature_types(fn_node);
          // A nested definition must not leak its context: returns and
          // break/continue after it belong to the enclosing function.
          let saved_ret <string> = self.current_ret_type;
          let saved_loop <int> = self.loop_depth;
          let ret_ann <string> = self.resolve_type(fn_node.type_annotation);
          // `fun?` declares a nullable return: `<long>` here means `<long?>`,
          // so returns check against `T?` (C++ NullableType return). The
          // marker folds once; an annotation already carrying `?` keeps it.
          if (fn_node.int_val == 1 && chk_str_eq(self.chk_strip_qmark(ret_ann), ret_ann)) {
              let rb <Buffer> = new_buffer(64);
              rb.write_string(ret_ann);
              rb.write_char('?');
              ret_ann = rb.to_string();
              free_buffer(rb);
          }
          self.current_ret_type = ret_ann;
          self.loop_depth = 0;
          // Moved and taint state are per function body: save the
          // enclosing function's, work on a clean set, restore after, so a
          // nested definition cannot clobber its parent's.
          if (self.moved_names == null) { self.moved_names = new [string, 64]{}; }
          if (self.host_taint_names == null) { self.host_taint_names = new [string, 64]{}; }
          if (self.host_taint_ops == null) { self.host_taint_ops = new [string, 64]{}; }
          let saved_moved <[string]> = new [string, 64]{};
          let smi <int> = 0;
          while (smi < 64) {
              saved_moved[smi] = self.moved_names[smi];
              smi = smi + 1;
          }
          let saved_mcount <int> = self.moved_count;
          let saved_mquiet <int> = self.moved_quiet;
          self.moved_count = 0;
          self.moved_quiet = 0;
          let saved_tnames <[string]> = new [string, 64]{};
          let saved_tops <[string]> = new [string, 64]{};
          let sti <int> = 0;
          while (sti < 64) {
              saved_tnames[sti] = self.host_taint_names[sti];
              saved_tops[sti] = self.host_taint_ops[sti];
              sti = sti + 1;
          }
          let saved_tcount <int> = self.host_taint_count;
          let saved_host <int> = self.host_warn;
          self.host_taint_count = 0;
          self.host_warn = 0;
          // Grants are per declaration (C++ currentGrants): save, parse
          // this one's `#[use(...)]`, validate the rest, restore after.
          let saved_grants <[string]> = new [string, 8]{};
          let gi <int> = 0;
          while (gi < 8) {
              saved_grants[gi] = self.grants[gi];
              gi = gi + 1;
          }
          let saved_gcount <int> = self.grant_count;
          let saved_infn <int> = self.in_function;
          self.grant_count = 0;
          self.in_function = 1;
          let is_special <bool> = (fn_node.int_val == 2);
          let saved_inspecial <int> = self.in_special_body;
          self.in_special_body = 0;
          if (is_special) { self.in_special_body = 1; }
          self.api_parse_grants(fn_node.attr_text, fn_node.line, fn_node.col);
          // The host-branch warning needs the system grant (C++
          // warnOnHostBranch): without it the read itself is already an
          // error, and a warning on top would report the same line twice.
          if (is_special && self.api_has_grant("system")) {
              self.host_warn = 1;
          }
          self.api_validate_attrs(fn_node.attr_text, false, is_special, fn_node.line, fn_node.col);
          self.api_check_on_attrs(fn_node, fn_node.attr_text, is_special, "FunctionDeclaration");
          if (is_special) {
              self.api_check_provider(fn_node, fn_node.attr_text);
              self.api_check_protocol(fn_node, fn_node.attr_text);
          }
          self.enter_scope();

          // Register parameters into function scope
          let p_cur <&AstNode> = fn_node.extra;
          while (p_cur != null) {
              let p_type <string> = self.resolve_type(p_cur.type_annotation);
              let p_sym <Symbol> = make_var_sym(p_cur.name, p_type, false);
              let ok <bool> = self.current_scope.insert_symbol(p_sym);
              if (!ok) {
                  self.report_error("duplicate parameter name", p_cur.line, p_cur.col);
              }
              p_cur = p_cur.right;
          }

          // Check body
          if (fn_node.left != null) {
              let b_cur <&AstNode> = fn_node.left.left;
              while (b_cur != null) {
                  self.check_statement(b_cur.left);
                  b_cur = b_cur.right;
              }
          }

          // Quote uses the statement checker never sees: it does not
          // enter `quote { ... }`, but the backend resolves it as live
          // code. Protocol claims and handlers own their quotes
          // elsewhere (claim time; post-splice), so they skip here.
          if (!is_special || !self.chk_skips_body_quote_walk(fn_node.attr_text)) {
              self.chk_report_quote_uses(fn_node.left);
          }

          // Check missing return statement on some paths
          let ret_t <string> = self.resolve_type(fn_node.type_annotation);
          let is_nullable_fn <bool> = false;
          if (fn_node.int_val == 1) { is_nullable_fn = true; }
          let rlen <ulong> = chk_strlen(ret_t);
          if (rlen > cast<ulong>(0) && chk_strchr(ret_t, 63) != null) {
              is_nullable_fn = true;
          }
          let is_ctor <bool> = false;
          if (chk_strlen(self.current_struct) > cast<ulong>(0)) {
              if (chk_str_eq(fn_node.name, self.current_struct)) { is_ctor = true; }
              let c_buf <Buffer> = new_buffer(64);
              c_buf.write_string(self.current_struct);
              c_buf.write_char('_');
              c_buf.write_string(self.current_struct);
              let c_name <string> = c_buf.to_string();
              free_buffer(c_buf);
              if (chk_str_eq(fn_node.name, c_name)) { is_ctor = true; }
          }
          // A `@special` body runs inside the compiler, so the generic
          // missing-return check does not apply to it: each mechanism owns
          // its body's shape (providers answer straight, `move_or_copy`
          // claims stay empty). Mirrors the C++ backend, which accepts the
          // empty claimant body.
          if (!is_special && !is_nullable_fn && !is_ctor && fn_node.left != null &&
              !chk_str_eq(ret_t, "void") && !chk_str_eq(ret_t, "noret") && !chk_str_eq(ret_t, "auto")) {
              if (!self.check_return_paths(fn_node.left)) {
                  let b <Buffer> = new_buffer(128);
                  b.write_string("Function '");
                  b.write_string(fn_node.name);
                  b.write_string("' is missing a return statement on some paths");
                  self.report_error(b.to_string(), fn_node.line, fn_node.col);
                  free_buffer(b);
              }
          }

          self.exit_scope();
          self.current_ret_type = saved_ret;
          self.loop_depth = saved_loop;
          let rgi <int> = 0;
          while (rgi < 8) {
              self.grants[rgi] = saved_grants[rgi];
              rgi = rgi + 1;
          }
          self.grant_count = saved_gcount;
          self.in_function = saved_infn;
          self.in_special_body = saved_inspecial;
          let rmi <int> = 0;
          while (rmi < 64) {
              self.moved_names[rmi] = saved_moved[rmi];
              self.host_taint_names[rmi] = saved_tnames[rmi];
              self.host_taint_ops[rmi] = saved_tops[rmi];
              rmi = rmi + 1;
          }
          self.moved_count = saved_mcount;
          self.moved_quiet = saved_mquiet;
          self.host_taint_count = saved_tcount;
          self.host_warn = saved_host;
          delete saved_grants;
      }

      // Split a generic parameter list on top-level commas (respecting <> nesting).
      fun split_generic_segs(self: &Self, gen: string, segs: [string]) <int> {
          let scount <int> = 0;
          if (gen == null || chk_strlen(gen) == cast<ulong>(0)) { return 0; }
          let glen <int> = cast<int>(chk_strlen(gen));
          let depth <int> = 0;
          let s_start <int> = 0;
          let gi <int> = 0;
          while (gi < glen) {
              let ch <string> = substr(gen, gi, 1);
              if (chk_str_eq(ch, "<")) { depth++; }
              else if (chk_str_eq(ch, ">")) {
                  if (depth > 0) { depth--; }
              }
              else if (chk_str_eq(ch, ",") && depth == 0) {
                  if (scount < 64) {
                      segs[scount] = substr(gen, s_start, gi - s_start);
                      scount++;
                  }
                  s_start = gi + 1;
              }
              gi = gi + 1;
          }
          if (scount < 64) {
              segs[scount] = substr(gen, s_start, glen - s_start);
              scount++;
          }
          return scount;
      }

      // Number of top-level generic arguments in a turbofish or generic
    // parameter string (`int`, `<int>`, `<int, string>`). Bracket
    // tolerant: parse_type spellings may or may not carry the outer
    // `<>`; "" counts 0.
    fun count_generic_args(self: &Self, gen: string) <int> {
        if (gen == null || chk_strlen(gen) == cast<ulong>(0)) { return 0; }
        let g <string> = chk_trim(gen);
        let glen <int> = cast<int>(chk_strlen(g));
        if (glen >= 2 && chk_str_eq(substr(g, 0, 1), "<") && chk_str_eq(substr(g, glen - 1, 1), ">")) {
            g = substr(g, 1, glen - 2);
        }
        let segs <[string]> = new [string, 64]{};
        let n <int> = self.split_generic_segs(g, segs);
        delete segs;
        return n;
    }

    // Declared generic parameter count of a struct (0 for non-generic:
    // ungenericked structs are never recorded by record_generic_scope).
    fun struct_generic_param_count(self: &Self, name: string) <int> {
        if (name == null || self.gen_scope_names == null) { return 0; }
        let gi <int> = 0;
        while (gi < self.gen_count) {
            if (chk_str_eq(self.gen_scope_names[gi], name)) {
                return self.count_generic_args(self.gen_scope_params[gi]);
            }
            gi = gi + 1;
        }
        return 0;
    }

    // Position of the top-level single `:` separating a generic name from its
      // bound (`::` is a path separator, not a bound). Returns -1 when absent.
      fun bound_colon_pos(self: &Self, seg: string) <int> {
          if (seg == null) { return -1; }
          let slen <int> = cast<int>(chk_strlen(seg));
          let ci <int> = 0;
          let cdepth <int> = 0;
          while (ci < slen) {
              let ch <string> = substr(seg, ci, 1);
              if (chk_str_eq(ch, "<")) { cdepth++; }
              else if (chk_str_eq(ch, ">")) {
                  if (cdepth > 0) { cdepth--; }
              }
              else if (chk_str_eq(ch, ":") && cdepth == 0) {
                  if (ci + 1 < slen && chk_str_eq(substr(seg, ci + 1, 1), ":")) {
                      ci = ci + 2;
                      continue;
                  }
                  return ci;
              }
              ci = ci + 1;
          }
          return -1;
      }

      // Collect generic parameter names (the part before a top-level `:`),
      // accumulating onto an existing count without duplicates.
      fun collect_bound_pnames(self: &Self, segs: [string], scount: int, pnames: [string], pcount: int) <int> {
          let c <int> = pcount;
          let si <int> = 0;
          while (si < scount) {
              let seg <string> = segs[si];
              let cpos <int> = self.bound_colon_pos(seg);
              let pname <string> = seg;
              if (cpos >= 0) { pname = substr(seg, 0, cpos); }
              pname = chk_trim(pname);
              if (chk_strlen(pname) > cast<ulong>(0)) {
                  c = self.add_pname_once(pnames, c, pname);
              }
              si = si + 1;
          }
          return c;
      }

      // Column of `word` as a whole word on `line_no` of `path`,
      // searching inside the first `<...>` so an enum's own name (before
      // `<`) never wins over a bound word (after `<`). -1 when unreadable
      // or absent; the caller keeps the decl site then (never a bogus col).
      fun source_word_col(self: &Self, path: string, line_no: int, word: string) <int> {
          if (path == null || word == null) { return -1; }
          if (line_no < 1) { return -1; }
          let wlen <int> = cast<int>(chk_strlen(word));
          if (wlen <= 0) { return -1; }
          let text? <string> = read_to_string(path);
          if (text == null) { return -1; }
          let total <int> = cast<int>(chk_strlen(text?));
          let bytes <[char]> = to_chars(text?);
          let cur <int> = 1;
          let start <int> = 0;
          let found_start <int> = -1;
          let found_len <int> = 0;
          let i <int> = 0;
          while (i <= total) {
              if (i == total || bytes[i] == cast<char>(10)) {
                  if (cur == line_no) {
                      found_start = start;
                      found_len = i - start;
                      if (found_len > 0 && bytes[start + found_len - 1] == cast<char>(13)) {
                          found_len = found_len - 1;
                      }
                      break;
                  }
                  cur = cur + 1;
                  start = i + 1;
              }
              i = i + 1;
          }
          if (found_start < 0) {
              delete bytes;
              free_file_content(text);
              return -1;
          }
          let lt <int> = -1;
          let li <int> = 0;
          while (li < found_len) {
              if (bytes[found_start + li] == cast<char>(60)) { lt = li; break; }
              li = li + 1;
          }
          let search_from <int> = 0;
          if (lt >= 0) { search_from = lt + 1; }
          let wchars <[char]> = to_chars(word);
          let best <int> = -1;
          let p <int> = search_from;
          while (p + wlen <= found_len) {
              let k <int> = 0;
              while (k < wlen) {
                  if (bytes[found_start + p + k] != wchars[k]) { break; }
                  k = k + 1;
              }
              if (k == wlen) {
                  let before_ok <bool> = true;
                  if (p > 0) {
                      let bc <char> = bytes[found_start + p - 1];
                      if ((bc >= 'a' && bc <= 'z') || (bc >= 'A' && bc <= 'Z') || (bc >= '0' && bc <= '9') || bc == '_' || bc == '$') {
                          before_ok = false;
                      }
                  }
                  let after_ok <bool> = true;
                  if (p + wlen < found_len) {
                      let ac <char> = bytes[found_start + p + wlen];
                      if ((ac >= 'a' && ac <= 'z') || (ac >= 'A' && ac <= 'Z') || (ac >= '0' && ac <= '9') || ac == '_' || ac == '$') {
                          after_ok = false;
                      }
                  }
                  if (before_ok && after_ok) { best = p + 1; break; }
              }
              p = p + 1;
          }
          delete bytes;
          delete wchars;
          free_file_content(text);
          return best;
      }

      // Every identifier inside a type/bound string must be a generic
      // parameter, a builtin type keyword, or a declared struct/enum/
      // interface/type alias. Reports the first unknown word and returns false.
      fun check_bound_words(self: &Self, bound: string, pnames: [string], pcount: int, line: int, col: int) <bool> {
          if (bound == null) { return true; }
          let blen <int> = cast<int>(chk_strlen(bound));
          let bchars <[char]> = to_chars(bound);
          let word_start <int> = -1;
          let bi <int> = 0;
          while (bi <= blen) {
              let is_part <bool> = false;
              if (bi < blen) {
                  let bc <char> = bchars[bi];
                  // `$` rides with the word so `$type` resolves as one
                  // name (the meta-types are in is_bound_name_known).
                  if ((bc >= 'a' && bc <= 'z') || (bc >= 'A' && bc <= 'Z') || bc == '_' || bc == '$' || (bc >= '0' && bc <= '9')) {
                      is_part = true;
                  }
              }
              if (is_part) {
                  if (word_start < 0) { word_start = bi; }
              } else {
                  if (word_start >= 0) {
                      let w <string> = substr(bound, word_start, bi - word_start);
                      let first <string> = substr(w, 0, 1);
                      let fch <[char]> = to_chars(first);
                      let starts_word <bool> = false;
                      if ((fch[0] >= 'a' && fch[0] <= 'z') || (fch[0] >= 'A' && fch[0] <= 'Z') || fch[0] == '_' || fch[0] == '$') {
                          starts_word = true;
                      }
                      delete fch;
                      // `implements` introduces an inline bound (`T: any
                      // implements Struct`); it is not a type name. C++
                      // carries it on the type node's implements list at
                      // the one choke point every spelling flows through
                      // (resolveTypeUnwrapped) and never resolves it as a
                      // type, so neither does this word scan.
                      if (starts_word && !chk_str_eq(w, "implements") && !self.is_bound_name_known(w, pnames, pcount)) {
                          let b <Buffer> = new_buffer(64);
                          b.write_string("Undefined type '");
                          b.write_string(w);
                          b.write_string("'");
                          let use_col <int> = col;
                          let exact <int> = self.source_word_col(self.source_file, line, w);
                          if (exact > 0) { use_col = exact; }
                          self.report_error(b.to_string(), line, use_col);
                          free_buffer(b);
                          delete bchars;
                          return false;
                      }
                      word_start = -1;
                  }
              }
              bi = bi + 1;
          }
          delete bchars;
          return true;
      }

      fun check_enum_bounds(self: &Self, decl: &AstNode) <noret> {
          let gen <string> = decl.type_annotation;
          if (gen == null || chk_strlen(gen) == cast<ulong>(0)) { return; }
          let segs <[string]> = new [string, 64]{};
          let scount <int> = self.split_generic_segs(gen, segs);

          // First pass: collect this enum's own generic parameter names.
          let pnames <[string]> = new [string, 64]{};
          let pcount <int> = self.collect_bound_pnames(segs, scount, pnames, 0);

          // Second pass: every identifier inside a bound must be a generic
          // parameter, a builtin type keyword, or a declared struct/enum/
          // interface/type alias. Anything else is refused like the C++
          // frontend refuses it (e.g. `Offer` in tests/samples/enums.fin).
          let si <int> = 0;
          while (si < scount) {
              let seg <string> = segs[si];
              let cpos <int> = self.bound_colon_pos(seg);
              if (cpos >= 0) {
                  let slen <int> = cast<int>(chk_strlen(seg));
                  let bound <string> = substr(seg, cpos + 1, slen - cpos - 1);
                  if (!self.check_bound_words(bound, pnames, pcount, decl.line, decl.col)) {
                      delete segs;
                      delete pnames;
                      return;
                  }
              }
              si = si + 1;
          }
          delete segs;
          delete pnames;
      }

      fun is_bound_name_known(self: &Self, w: string, pnames: [string], pcount: int) <bool> {
          let pi <int> = 0;
          while (pi < pcount) {
              if (chk_str_eq(pnames[pi], w)) { return true; }
              pi = pi + 1;
          }
          if (chk_str_eq(w, "int") || chk_str_eq(w, "uint") || chk_str_eq(w, "long") ||
              chk_str_eq(w, "ulong") || chk_str_eq(w, "short") || chk_str_eq(w, "ushort") ||
              chk_str_eq(w, "float") || chk_str_eq(w, "double") || chk_str_eq(w, "bool") ||
              chk_str_eq(w, "char") || chk_str_eq(w, "string") || chk_str_eq(w, "void") ||
              chk_str_eq(w, "auto") || chk_str_eq(w, "any") || chk_str_eq(w, "object") ||
              chk_str_eq(w, "Struct") || chk_str_eq(w, "noret") ||
              chk_str_eq(w, "Self") || chk_str_eq(w, "Castable") || chk_str_eq(w, "u8") || chk_str_eq(w, "i8") ||
              chk_str_eq(w, "u16") || chk_str_eq(w, "i16") || chk_str_eq(w, "u32") ||
              chk_str_eq(w, "i32") || chk_str_eq(w, "u64") || chk_str_eq(w, "i64") ||
              chk_str_eq(w, "f32") || chk_str_eq(w, "f64") || chk_str_eq(w, "usize") ||
              chk_str_eq(w, "isize") || chk_str_eq(w, "size_t") ||
              chk_str_eq(w, "quote") || chk_str_eq(w, "function") ||
              chk_str_eq(w, "fn") ||
              chk_str_eq(w, "$type") || chk_str_eq(w, "$struct") ||
              chk_str_eq(w, "$interface") || chk_str_eq(w, "$enum_member")) {
              return true;
          }
          if (self.global_scope.has(w)) {
              let sym <Symbol> = self.global_scope.lookup(w);
              if (sym.kind == sym_struct() || sym.kind == sym_enum() ||
                  sym.kind == sym_interface() || sym.kind == sym_type_alias()) {
                  return true;
              }
          }
          return false;
      }

      // One pname unless already present.
      fun add_pname_once(self: &Self, pnames: [string], pcount: int, name: string) <int> {
          let pi <int> = 0;
          while (pi < pcount) {
              if (chk_str_eq(pnames[pi], name)) { return pcount; }
              pi = pi + 1;
          }
          if (pcount < 64) {
              pnames[pcount] = name;
              return pcount + 1;
          }
          return pcount;
      }

      // The single-letter generic vocabulary (see check_expression): allowed
      // where a displaced generic list may have named them.
      fun add_single_letter_pnames(self: &Self, pnames: [string], pcount: int) <int> {
          let c <int> = self.add_pname_once(pnames, pcount, "T");
          c = self.add_pname_once(pnames, c, "E");
          c = self.add_pname_once(pnames, c, "U");
          c = self.add_pname_once(pnames, c, "K");
          c = self.add_pname_once(pnames, c, "V");
          c = self.add_pname_once(pnames, c, "X");
          return c;
      }

      // Record one generic type's parameter list. Implements blocks flatten
      // their methods to top-level `Target_method` functions that keep no
      // link to `Target<T, ...>` in the AST, so the registry below lets those
      // methods resolve the enclosing names. Bounded: 64 types; beyond that
      // new entries are dropped (a growable map is the upgrade path).
      fun record_generic_scope(self: &Self, name: string, generics: string) <noret> {
          if (name == null || generics == null) { return; }
          if (chk_strlen(generics) == cast<ulong>(0)) { return; }
          if (self.gen_scope_names == null) {
              self.gen_scope_names = new [string, 64]{};
              self.gen_scope_params = new [string, 64]{};
              self.gen_count = 0;
          }
          if (self.gen_count >= 64) { return; }
          let gi <int> = 0;
          while (gi < self.gen_count) {
              if (chk_str_eq(self.gen_scope_names[gi], name)) { return; }
              gi = gi + 1;
          }
          self.gen_scope_names[self.gen_count] = name;
          self.gen_scope_params[self.gen_count] = generics;
          self.gen_count = self.gen_count + 1;
      }

      // Merge the enclosing generic names for a flattened `Target_method`
      // into pnames. No-op unless the prefix before the first `_` names a
      // recorded generic type.
      fun merge_scope_pnames(self: &Self, fn_name: string, pnames: [string], pcount: int) <int> {
          if (fn_name == null || self.gen_scope_names == null) { return pcount; }
          let flen <int> = cast<int>(chk_strlen(fn_name));
          let ui <int> = 0;
          while (ui < flen) {
              if (chk_str_eq(substr(fn_name, ui, 1), "_")) { break; }
              ui = ui + 1;
          }
          if (ui <= 0 || ui >= flen) { return pcount; }
          let prefix <string> = substr(fn_name, 0, ui);
          let gi <int> = 0;
          while (gi < self.gen_count) {
              if (chk_str_eq(self.gen_scope_names[gi], prefix)) {
                  let segs <[string]> = new [string, 64]{};
                  let scount <int> = self.split_generic_segs(self.gen_scope_params[gi], segs);
                  let c <int> = self.collect_bound_pnames(segs, scount, pnames, pcount);
                  delete segs;
                  return c;
              }
              gi = gi + 1;
          }
          return pcount;
      }

      // Positional substitution for a method return: when the receiver is
      // `Base<A1..An>` and the declared return is a bare word matching Base's
      // k-th generic parameter, answer Ak (resolved). "" when no substitution
      // applies; the caller keeps the `auto` fallback for genuinely-unknown
      // words. Reuses split_generic_segs/collect_bound_pnames + gen registry.
      fun subst_receiver_return(self: &Self, recv: string, base: string, ret: string) <string> {
          if (recv == null || base == null || ret == null) { return ""; }
          let r <string> = chk_trim(ret);
          if (chk_strlen(r) == cast<ulong>(0)) { return ""; }
          if (chk_strchr(r, 60) != null || chk_strchr(r, 62) != null ||
              chk_strchr(r, 91) != null || chk_strchr(r, 93) != null ||
              chk_strchr(r, 38) != null || chk_strchr(r, 42) != null ||
              chk_strchr(r, 63) != null || chk_strchr(r, 58) != null ||
              chk_strchr(r, 40) != null || chk_strchr(r, 36) != null ||
              chk_strchr(r, 44) != null) {
              return "";
          }
          if (self.gen_scope_names == null) { return ""; }
          let gi <int> = 0;
          let gen <string> = "";
          while (gi < self.gen_count) {
              if (chk_str_eq(self.gen_scope_names[gi], base)) {
                  gen = self.gen_scope_params[gi];
                  break;
              }
              gi = gi + 1;
          }
          if (gen == null || chk_strlen(gen) == cast<ulong>(0)) { return ""; }
          let segs <[string]> = new [string, 64]{};
          let scount <int> = self.split_generic_segs(gen, segs);
          let pnames <[string]> = new [string, 64]{};
          let pcount <int> = self.collect_bound_pnames(segs, scount, pnames, 0);
          let k <int> = -1;
          let pi <int> = 0;
          while (pi < pcount) {
              if (chk_str_eq(pnames[pi], r)) { k = pi; break; }
              pi = pi + 1;
          }
          if (k < 0) {
              delete segs;
              delete pnames;
              return "";
          }
          let stripped <string> = self.chk_strip_ptr(recv);
          let slen <int> = cast<int>(chk_strlen(stripped));
          let lpos <int> = -1;
          let si <int> = 0;
          while (si < slen) {
              if (chk_str_eq(substr(stripped, si, 1), "<")) { lpos = si; break; }
              si = si + 1;
          }
          if (lpos < 0) {
              delete segs;
              delete pnames;
              return "";
          }
          let depth <int> = 0;
          let rpos <int> = -1;
          let ri <int> = lpos;
          while (ri < slen) {
              let ch <string> = substr(stripped, ri, 1);
              if (chk_str_eq(ch, "<")) { depth = depth + 1; }
              else if (chk_str_eq(ch, ">")) {
                  depth = depth - 1;
                  if (depth == 0) { rpos = ri; break; }
              }
              ri = ri + 1;
          }
          if (rpos < 0 || rpos <= lpos + 1) {
              delete segs;
              delete pnames;
              return "";
          }
          let inner <string> = substr(stripped, lpos + 1, rpos - lpos - 1);
          let asegs <[string]> = new [string, 64]{};
          let acount <int> = self.split_generic_segs(inner, asegs);
          if (acount != scount || k >= acount) {
              delete segs;
              delete pnames;
              delete asegs;
              return "";
          }
          let ans <string> = chk_trim(asegs[k]);
          delete segs;
          delete pnames;
          delete asegs;
          if (ans == null || chk_strlen(ans) == cast<ulong>(0)) { return ""; }
          return self.resolve_type(ans);
      }

      // Field type through receiver generics (`b.v` on `B<int>` with
      // `v <T>` answers `int`, like method returns via
      // subst_receiver_return): struct-parameter substitution first
      // (complex spellings substitute each word), then the bare-word
      // fallback. The declared spelling when nothing binds, so
      // non-generic receivers read exactly like today.
      fun subst_field_return(self: &Self, recv: string, base: string, field_raw: string) <string> {
          let fty <string> = self.resolve_type(field_raw);
          let s_names <[string]> = new [string, 64]{};
          let s_vals <[string]> = new [string, 64]{};
          let s_n <int> = 0;
          let spn <int> = self.lookup_generic_pnames(base, s_names);
          if (spn > 0) {
              let avn <int> = self.receiver_type_args(recv, base, s_vals);
              if (avn == spn) { s_n = spn; }
          }
          if (s_n > 0) {
              fty = self.subst_generic_words(fty, s_names, s_vals, s_n);
          }
          let subst <string> = self.subst_receiver_return(recv, base, fty);
          delete s_names;
          delete s_vals;
          if (!chk_str_eq(subst, "")) { return subst; }
          return fty;
      }

      // Declared generic parameter names for a callee (`id` -> `T`,
      // `pair` -> `T,U` sans bounds), from the pass-1 generic registry.
      // Returns 0 when the name records nothing (non-generic or unknown);
      // the caller tells those apart by what the name resolved to.
      fun lookup_generic_pnames(self: &Self, name: string, pnames: [string]) <int> {
          if (name == null || self.gen_scope_names == null) { return 0; }
          let gi <int> = 0;
          while (gi < self.gen_count) {
              if (chk_str_eq(self.gen_scope_names[gi], name)) {
                  let segs <[string]> = new [string, 64]{};
                  let scount <int> = self.split_generic_segs(self.gen_scope_params[gi], segs);
                  let c <int> = self.collect_bound_pnames(segs, scount, pnames, 0);
                  delete segs;
                  return c;
              }
              gi = gi + 1;
          }
          return 0;
      }

      // The declared bound of one generic parameter (`any implements
      // Struct` for T in `fun f<T: any implements Struct>`), "" when the
      // parameter is unbound or the declaration is unknown. Reads the
      // same generic-scope registry lookup_generic_pnames does.
      fun generic_bound_of(self: &Self, fn_name: string, pname: string) <string> {
          if (fn_name == null || pname == null || self.gen_scope_names == null) { return ""; }
          let gi <int> = 0;
          while (gi < self.gen_count) {
              if (chk_str_eq(self.gen_scope_names[gi], fn_name)) {
                  let segs <[string]> = new [string, 64]{};
                  let scount <int> = self.split_generic_segs(self.gen_scope_params[gi], segs);
                  let si <int> = 0;
                  while (si < scount) {
                      let seg <string> = segs[si];
                      let cpos <int> = self.bound_colon_pos(seg);
                      if (cpos >= 0) {
                          let nm <string> = chk_trim(substr(seg, 0, cpos));
                          if (chk_str_eq(nm, pname)) {
                              let slen <int> = cast<int>(chk_strlen(seg));
                              let bound <string> = chk_trim(substr(seg, cpos + 1, slen - cpos - 1));
                              delete segs;
                              return bound;
                          }
                      }
                      si = si + 1;
                  }
                  delete segs;
                  return "";
              }
              gi = gi + 1;
          }
          return "";
      }

      // First word of a bound (`any` in `any implements Struct`), "" when
      // the bound starts outside a word. `$` rides with the word like the
      // bound scan does.
      fun bound_base_word(self: &Self, bound: string) <string> {
          if (bound == null) { return ""; }
          let b <string> = chk_trim(bound);
          let blen <int> = cast<int>(chk_strlen(b));
          if (blen <= 0) { return ""; }
          let fch <string> = substr(b, 0, 1);
          let fcs <[char]> = to_chars(fch);
          let f <char> = fcs[0];
          delete fcs;
          if (!((f >= 'a' && f <= 'z') || (f >= 'A' && f <= 'Z') || f == '_' || f == '$')) {
              return "";
          }
          let bi <int> = 1;
          while (bi < blen) {
              let cs <[char]> = to_chars(substr(b, bi, 1));
              let c <char> = cs[0];
              delete cs;
              if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
                  (c >= '0' && c <= '9') || c == '_' || c == '$') {
                  bi = bi + 1;
              } else {
                  break;
              }
          }
          return substr(b, 0, bi);
      }

      // True for a bare type word (`T`, `int`): none of the composite
      // markers and no spaces. Whole-word substitution and bare-word
      // binding only ever read these; anything else is left as written.
      fun chk_is_bare_word(self: &Self, s: string) <bool> {
          if (s == null || chk_strlen(s) == cast<ulong>(0)) { return false; }
          if (chk_strchr(s, 60) != null || chk_strchr(s, 62) != null ||
              chk_strchr(s, 91) != null || chk_strchr(s, 93) != null ||
              chk_strchr(s, 38) != null || chk_strchr(s, 42) != null ||
              chk_strchr(s, 63) != null || chk_strchr(s, 58) != null ||
              chk_strchr(s, 40) != null || chk_strchr(s, 41) != null ||
              chk_strchr(s, 36) != null || chk_strchr(s, 44) != null ||
              chk_strchr(s, 32) != null) {
              return false;
          }
          return true;
      }

      // Positional substitution of generic words in a spelling: every whole
      // word equal to pnames[i] becomes pvals[i] (null or empty values leave
      // the word standing, so partially-bound spellings keep checking what
      // is bound and skip what is not). Reuses the word scan of
      // chk_mentions_gen_param; complex spellings substitute each word
      // where it stands (`Box<U>` with U=int answers `Box<int>`).
      fun subst_generic_words(self: &Self, spelling: string, pnames: [string], pvals: [string], n: int) <string> {
          if (spelling == null || n <= 0) { return spelling; }
          let len <int> = cast<int>(chk_strlen(spelling));
          if (len <= 0) { return spelling; }
          let chars <[char]> = to_chars(spelling);
          let b <Buffer> = new_buffer(len + 64);
          let i <int> = 0;
          while (i < len) {
              let c <char> = chars[i];
              if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '$') {
                  let start <int> = i;
                  while (i < len) {
                      let c2 <char> = chars[i];
                      if ((c2 >= 'a' && c2 <= 'z') || (c2 >= 'A' && c2 <= 'Z') ||
                          (c2 >= '0' && c2 <= '9') || c2 == '_' || c2 == '$') {
                          i = i + 1;
                      } else {
                          break;
                      }
                  }
                  let w <string> = substr(spelling, start, i - start);
                  let done <bool> = false;
                  let k <int> = 0;
                  while (k < n) {
                      if (pnames[k] != null && chk_str_eq(pnames[k], w) &&
                          pvals[k] != null && chk_strlen(pvals[k]) > cast<ulong>(0)) {
                          b.write_string(pvals[k]);
                          done = true;
                          break;
                      }
                      k = k + 1;
                  }
                  if (!done) { b.write_string(w); }
              } else {
                  b.write_char(c);
                  i = i + 1;
              }
          }
          delete chars;
          let out <string> = b.to_string();
          free_buffer(b);
          return out;
      }

      // Top-level segments of a call-site turbofish (`string` or
      // `<string, int>` alike): the outer brackets are not part of the
      // spelling the parser stores, but `count_generic_args` tolerates
      // them, so this does too.
      fun split_turbofish(self: &Self, tb: string, segs: [string]) <int> {
          if (tb == null) { return 0; }
          let g <string> = chk_trim(tb);
          if (chk_strlen(g) == cast<ulong>(0)) { return 0; }
          let glen <int> = cast<int>(chk_strlen(g));
          if (glen >= 2 && chk_str_eq(substr(g, 0, 1), "<") && chk_str_eq(substr(g, glen - 1, 1), ">")) {
              g = substr(g, 1, glen - 2);
          }
          return self.split_generic_segs(g, segs);
      }

      // Concrete type arguments off a receiver spelling (`B<int>` -> `int`,
      // through one pointer marker like the receiver substitution): the
      // struct-parameter half of a method call's substitution. Returns 0
      // when the receiver carries none, and the caller substitutes nothing
      // then, exactly like today.
      fun receiver_type_args(self: &Self, recv: string, base: string, avals: [string]) <int> {
          if (recv == null || base == null) { return 0; }
          if (chk_strlen(recv) == cast<ulong>(0) || chk_strlen(base) == cast<ulong>(0)) { return 0; }
          let stripped <string> = self.chk_strip_ptr(recv);
          let slen <int> = cast<int>(chk_strlen(stripped));
          let lpos <int> = -1;
          let si <int> = 0;
          while (si < slen) {
              if (chk_str_eq(substr(stripped, si, 1), "<")) { lpos = si; break; }
              si = si + 1;
          }
          if (lpos < 0) { return 0; }
          let depth <int> = 0;
          let rpos <int> = -1;
          let ri <int> = lpos;
          while (ri < slen) {
              let ch <string> = substr(stripped, ri, 1);
              if (chk_str_eq(ch, "<")) { depth = depth + 1; }
              else if (chk_str_eq(ch, ">")) {
                  depth = depth - 1;
                  if (depth == 0) { rpos = ri; break; }
              }
              ri = ri + 1;
          }
          if (rpos < 0 || rpos <= lpos + 1) { return 0; }
          let inner <string> = substr(stripped, lpos + 1, rpos - lpos - 1);
          let n <int> = self.split_generic_segs(inner, avals);
          let k <int> = 0;
          while (k < n) {
              avals[k] = self.resolve_type(chk_trim(avals[k]));
              k = k + 1;
          }
          return n;
      }

      // Mirror of the C++ check: a function's generic bounds and parameter
      // annotations must name known types, exactly like enum bounds. Runs
      // before parameters are registered, so an unresolved annotation is the
      // diagnostic rather than every later use of the parameter. Every bad
      // site is reported (the C++ frontend reports each undefined parameter),
      // and checking continues with the written strings.
      fun check_function_signature_types(self: &Self, fn_node: &AstNode) <noret> {
          if (fn_node == null) { return; }
          let segs <[string]> = new [string, 64]{};
          let pnames <[string]> = new [string, 64]{};
          let scount <int> = 0;
          let pcount <int> = 0;
          let gen <string> = fn_node.str_val;
          // `@define` and operator declarations reuse str_val for attribute
          // payloads (`llvm_name="..."`) and operator symbols, not generics.
          if (gen != null && chk_strlen(gen) > cast<ulong>(0) &&
              chk_strchr(gen, 61) == null && chk_strchr(gen, 34) == null) {
              scount = self.split_generic_segs(gen, segs);
              pcount = self.collect_bound_pnames(segs, scount, pnames, 0);
              // A bare word is either one unbound generic (`fun f<T>`) or an
              // attribute that displaced the generics (`#[export]` overwrites
              // str_val on the `pub fun` path, parser.fin:3574). The two read
              // the same, so also allow the single-letter generic vocabulary
              // the corpus uses (T, E, U, K, V, X) alongside what was read.
              if (chk_strchr(gen, 58) == null && chk_strchr(gen, 44) == null &&
                  chk_strchr(gen, 60) == null && chk_strchr(gen, 62) == null) {
                  pcount = self.add_single_letter_pnames(pnames, pcount);
              }
              let si <int> = 0;
              while (si < scount) {
                  let seg <string> = segs[si];
                  let cpos <int> = self.bound_colon_pos(seg);
                  if (cpos >= 0) {
                      let slen <int> = cast<int>(chk_strlen(seg));
                      let bound <string> = substr(seg, cpos + 1, slen - cpos - 1);
                      self.check_bound_words(bound, pnames, pcount, fn_node.line, fn_node.col);
                  }
                  si = si + 1;
              }
          }
          // Parameter annotations resolve with the function's own generic
          // parameter names in scope (`fun f<T>(x: T)`), so the names collected
          // above are reused for every parameter. Two enclosing scopes the
          // AST drops are restored best-effort: a flattened `Target_method`
          // reads `Target<T, ...>` from the registry, and a struct method
          // reads the single-letter vocabulary (struct `<...>` is consumed
          // without recording, parser.fin:2005, and the corpus uses only
          // single-letter struct parameters).
          pcount = self.merge_scope_pnames(fn_node.name, pnames, pcount);
          if (chk_strlen(self.current_struct) > cast<ulong>(0)) {
              pcount = self.add_single_letter_pnames(pnames, pcount);
          }
          let p_cur <&AstNode> = fn_node.extra;
          while (p_cur != null) {
              self.check_bound_words(p_cur.type_annotation, pnames, pcount, p_cur.line, p_cur.col);
              p_cur = p_cur.right;
          }
          delete segs;
          delete pnames;
      }

      fun check_program(self: &Self, root: &AstNode) <bool> {
          if (root == null) { return true; }

          // Pass 1: Declare top-level functions, structs, globals, and type aliases in global scope
          let decl <&AstNode> = root.left;
          while (decl != null) {
              if (decl.kind == ast_struct_decl()) {
                  let st_sym <Symbol> = Symbol {
                      name: decl.name,
                      kind: sym_struct(),
                      type_name: decl.name,
                      is_pub: true,
                      is_mut: false,
                      line: decl.line,
                      col: decl.col
                  };
                  if (!self.global_scope.has(decl.name)) {
                      self.global_scope.insert_symbol(st_sym);
                  }
                  self.record_generic_scope(decl.name, decl.type_annotation);
                  // Heritage for inherited member lookup
                  // (`struct S : <P>` stores the parents string on str_val,
                  // attributes ride on attr_text since wave 4).
                  if (decl.str_val != null && chk_strlen(decl.str_val) > cast<ulong>(0)) {
                      let hb <Buffer> = new_buffer(64);
                      hb.write_string(decl.name);
                      hb.write_string("_parents");
                      let hkey <string> = hb.to_string();
                      free_buffer(hb);
                      if (!self.global_scope.has(hkey)) {
                          let hsym <Symbol> = make_var_sym(hkey, decl.str_val, true);
                          self.global_scope.insert_symbol(hsym);
                      }
                  }
                  let fld <&AstNode> = decl.left;
                  while (fld != null) {
                      let fb <Buffer> = new_buffer(64);
                      fb.write_string(decl.name);
                      fb.write_char('_');
                      fb.write_string(fld.name);
                      let fq <string> = fb.to_string();
                      free_buffer(fb);
                      let fsym <Symbol> = make_var_sym(fq, fld.type_annotation, true);
                      fsym.is_pub = fld.is_pub;
                      if (!self.global_scope.has(fq)) {
                          self.global_scope.insert_symbol(fsym);
                      }
                      let fb2 <Buffer> = new_buffer(64);
                      fb2.write_string(decl.name);
                      fb2.write_string("::");
                      fb2.write_string(fld.name);
                      let fq2 <string> = fb2.to_string();
                      free_buffer(fb2);
                      let fsym2 <Symbol> = make_var_sym(fq2, fld.type_annotation, true);
                      fsym2.is_pub = fld.is_pub;
                      if (!self.global_scope.has(fq2)) {
                          self.global_scope.insert_symbol(fsym2);
                      }
                      fld = fld.right;
                  }
                  let m <&AstNode> = decl.extra;
                  // A declared constructor sets the struct's call arity; without
                  // one (and without parents to inherit from) the struct takes
                  // no arguments. With parents and no own constructor the arity
                  // is unknowable here, so nothing is recorded and calls skip.
                  let saw_ctor <bool> = false;
                  while (m != null) {
                      let m_sym <Symbol> = make_fn_sym(m.name, m.type_annotation, m.is_pub);
                      if (!self.global_scope.has(m.name)) {
                          self.global_scope.insert_symbol(m_sym);
                      }
                      let m_exp <int> = self.count_fn_expected(m);
                      let m_req <int> = self.count_fn_required(m);
                      if (self.first_param_is_self(m)) {
                          m_exp = m_exp - 1;
                          m_req = m_req - 1;
                      }
                      let m_var <int> = 0;
                      if (self.fn_is_variadic(m)) { m_var = 1; }
                      self.record_arity(m.name, m_exp, m_req, m_var);
                      self.record_ptypes(m.name, m, self.first_param_is_self(m));
                      let dlen <ulong> = chk_strlen(decl.name);
                      let mlen <ulong> = chk_strlen(m.name);
                      let m_sub <string> = "";
                      if (mlen > dlen + cast<ulong>(1)) {
                          m_sub = substr(m.name, cast<int>(dlen + cast<ulong>(1)), cast<int>(mlen - dlen - cast<ulong>(1)));
                      }
                      if (chk_strlen(m_sub) > cast<ulong>(0)) {
                          let sc_buf <Buffer> = new_buffer(64);
                          sc_buf.write_string(decl.name);
                          sc_buf.write_string("::");
                          sc_buf.write_string(m_sub);
                          let sc_name <string> = sc_buf.to_string();
                          free_buffer(sc_buf);
                          let sc_sym <Symbol> = make_fn_sym(sc_name, m.type_annotation, m.is_pub);
                          if (!self.global_scope.has(sc_name)) {
                              self.global_scope.insert_symbol(sc_sym);
                          }
                          self.record_arity(sc_name, m_exp, m_req, m_var);
                          self.record_ptypes(sc_name, m, self.first_param_is_self(m));
                          // The method's own generic parameters (`set_x<U>`
                          // records under `Point_set_x`), beside
                          // arity/ptypes: the `S_constructor` spelling
                          // declares a constructor, which owns none of its
                          // own, so it records nothing here (C++
                          // functionGenericOrder_ is per-declaration too).
                          // Empty str_val records nothing either way.
                          if (!chk_str_eq(m_sub, "constructor")) {
                              self.record_generic_scope(m.name, m.str_val);
                          }
                          // Either spelling declares the constructor: `S(...)`
                          // under its own name, or the `constructor` keyword
                          // (parsed as `S_constructor`, the guide's form).
                          if (chk_str_eq(m_sub, decl.name) || chk_str_eq(m_sub, "constructor")) {
                              saw_ctor = true;
                              // Calls write no receiver, so the constructor's
                              // arity excludes `self` like a method's does.
                              self.record_arity(decl.name, m_exp, m_req, m_var);
                              self.record_ptypes(decl.name, m, self.first_param_is_self(m));
                          }
                      }
                      if (chk_str_eq(m.name, decl.name)) {
                          saw_ctor = true;
                          self.record_arity(decl.name, m_exp, m_req, m_var);
                          self.record_ptypes(decl.name, m, self.first_param_is_self(m));
                      }
                      m = m.right;
                  }
                  if (!saw_ctor) {
                      // A forward declaration (`struct S;`, int_val 1)
                      // declares no constructor: the real declaration owns
                      // the arity, so nothing is recorded here. A bodied
                      // struct without one takes no arguments.
                      if (decl.int_val != 1 && (decl.str_val == null || chk_strlen(decl.str_val) == cast<ulong>(0))) {
                          self.record_arity(decl.name, 0, 0, 0);
                      }
                  }
              } else if (decl.kind == ast_fun_decl()) {
                  // Flattened `Target_method`s carry their visibility on the
                  // node (parser records `pub:`/`priv:` + inline markers);
                  // a `priv` marker only means something on a struct member,
                  // so plain top-level functions stay public regardless.
                  let fpub <bool> = true;
                  if (!decl.is_pub && !chk_str_eq(self.struct_prefix_of(decl.name), "")) {
                      fpub = false;
                  }
                  let fn_sym <Symbol> = make_fn_sym(decl.name, decl.type_annotation, fpub);
                  if (!self.global_scope.has(decl.name)) {
                      self.global_scope.insert_symbol(fn_sym);
                  }
                  // The Collect phase (C++ collectProgramHandlers): every
                  // well-formed `#[on(event)]` on a `@special` is a handler
                  // record. Malformed ones belong to the attribute
                  // diagnostic, exactly once, so they are skipped here.
                  if (decl.int_val == 2) {
                      self.api_collect_handler(decl);
                  }
                  let is_var <int> = 0;
                  if (self.fn_is_variadic(decl)) { is_var = 1; }
                  let f_exp <int> = self.count_fn_expected(decl);
                  let f_req <int> = self.count_fn_required(decl);
                  if (self.first_param_is_self(decl) && self.fn_has_struct_prefix(decl.name)) {
                      f_exp = f_exp - 1;
                      f_req = f_req - 1;
                      if (f_exp < 0) { f_exp = 0; }
                      if (f_req < 0) { f_req = 0; }
                  }
                  self.record_arity(decl.name, f_exp, f_req, is_var);
                  self.record_ptypes(decl.name, decl, self.first_param_is_self(decl) && self.fn_has_struct_prefix(decl.name));
                  // Declared generic parameters for the call site: free
                  // functions (`id` -> `T`) and flattened implements-block
                  // methods (`S_m` -> own params) alike (C++
                  // functionGenericOrder_/lookupMethodGenerics). A bare
                  // struct name is a constructor, which owns none of its
                  // own; flattened statics (`S::m`) keep the target's
                  // count check on the scoped path instead.
                  if (decl.str_val != null && chk_strlen(decl.str_val) > cast<ulong>(0)) {
                      let gpre <string> = self.struct_prefix_of(decl.name);
                      if (chk_str_eq(gpre, "")) {
                          if (chk_strchr(decl.name, 58) == null) {
                              self.record_generic_scope(decl.name, decl.str_val);
                          }
                      } else {
                          let gshort <string> = self.strip_struct_prefix(decl.name);
                          if (!chk_str_eq(gshort, "") && !chk_str_eq(gshort, gpre) &&
                              !chk_str_eq(gshort, "constructor")) {
                              self.record_generic_scope(decl.name, decl.str_val);
                          }
                      }
                  }
              } else if (decl.kind == ast_type_alias()) {
                  let ta_sym <Symbol> = Symbol {
                      name: decl.name,
                      kind: sym_type_alias(),
                      type_name: decl.type_annotation,
                      is_pub: true,
                      is_mut: false,
                      line: decl.line,
                      col: decl.col
                  };
                  if (!self.global_scope.has(decl.name)) {
                      self.global_scope.insert_symbol(ta_sym);
                  }
              } else if (decl.kind == ast_enum_decl()) {
                  let en_sym <Symbol> = Symbol {
                      name: decl.name,
                      kind: sym_enum(),
                      type_name: decl.name,
                      is_pub: true,
                      is_mut: false,
                      line: decl.line,
                      col: decl.col
                  };
                  if (!self.global_scope.has(decl.name)) {
                      self.global_scope.insert_symbol(en_sym);
                  }
                  self.record_generic_scope(decl.name, decl.type_annotation);
                  let m <&AstNode> = decl.left;
                  while (m != null) {
                      let mem_sym <Symbol> = make_var_sym(m.name, decl.name, true);
                      if (!self.global_scope.has(m.name)) {
                          self.global_scope.insert_symbol(mem_sym);
                      }
                      let b <Buffer> = new_buffer(64);
                      b.write_string(decl.name);
                      b.write_string("::");
                      b.write_string(m.name);
                      let q_name <string> = b.to_string();
                      free_buffer(b);
                      let q_sym <Symbol> = make_var_sym(q_name, decl.name, true);
                      if (!self.global_scope.has(q_name)) {
                          self.global_scope.insert_symbol(q_sym);
                      }
                      let b2 <Buffer> = new_buffer(64);
                      b2.write_string(decl.name);
                      b2.write_char('_');
                      b2.write_string(m.name);
                      let u_name <string> = b2.to_string();
                      free_buffer(b2);
                      let u_sym <Symbol> = make_var_sym(u_name, decl.name, true);
                      if (!self.global_scope.has(u_name)) {
                          self.global_scope.insert_symbol(u_sym);
                      }
                      let mfn_sym <Symbol> = make_fn_sym(q_name, decl.name, true);
                      if (!self.global_scope.has(q_name)) {
                          self.global_scope.insert_symbol(mfn_sym);
                      }
                      m = m.right;
                  }
              } else if (decl.kind == ast_interface_decl()) {
                  let if_sym <Symbol> = Symbol {
                      name: decl.name,
                      kind: sym_interface(),
                      type_name: decl.name,
                      is_pub: true,
                      is_mut: false,
                      line: decl.line,
                      col: decl.col
                  };
                  if (!self.global_scope.has(decl.name)) {
                      self.global_scope.insert_symbol(if_sym);
                  }
                  self.record_generic_scope(decl.name, decl.type_annotation);
                  let m <&AstNode> = decl.extra;
                  while (m != null) {
                      let m_sym <Symbol> = make_fn_sym(m.name, m.type_annotation, true);
                      if (!self.global_scope.has(m.name)) {
                          self.global_scope.insert_symbol(m_sym);
                      }
                      m = m.right;
                  }
              } else if (decl.kind == ast_var_decl()) {
                  let v_sym <Symbol> = make_var_sym(decl.name, decl.type_annotation, true);
                  if (!self.global_scope.has(decl.name)) {
                      self.global_scope.insert_symbol(v_sym);
                  }
              } else if (decl.kind == 6) { // ast_import_decl
                  if (decl.str_val != null && chk_strlen(decl.str_val) > cast<ulong>(0)) {
                      let mod_sym <Symbol> = make_var_sym(decl.str_val, "module", true);
                      if (!self.global_scope.has(decl.str_val)) {
                          self.global_scope.insert_symbol(mod_sym);
                      }
                  }
                  if (decl.name != null && chk_strlen(decl.name) > cast<ulong>(0)) {
                      let mod_sym2 <Symbol> = make_var_sym(decl.name, "module", true);
                      if (!self.global_scope.has(decl.name)) {
                          self.global_scope.insert_symbol(mod_sym2);
                      }
                  }
                  // `error::std` is skipped by the driver (its bodies need the
                  // compiler API), so `Error` would never be declared. Record
                  // the import's own promise: with this import `Error` resolves
                  // (the C++ driver loads lib/std/error.fin, which declares
                  // `pub struct Error`), without it `Error` stays undefined.
                  if ((decl.name != null && chk_str_eq(decl.name, "error::std")) ||
                      (decl.str_val != null && chk_str_eq(decl.str_val, "error::std"))) {
                      if (!self.global_scope.has("Error")) {
                          let err_sym <Symbol> = Symbol {
                              name: "Error",
                              kind: sym_struct(),
                              type_name: "Error",
                              is_pub: true,
                              is_mut: false,
                              line: decl.line,
                              col: decl.col
                          };
                          self.global_scope.insert_symbol(err_sym);
                      }
                  }
              }
              decl = decl.right;
          }

          // Pass 2: Check definitions
          decl = root.left;
          while (decl != null) {
              if (decl.kind == ast_struct_decl()) {
                  self.api_validate_attrs(decl.attr_text, true, false, decl.line, decl.col);
                  self.api_validate_fields(decl);
                  self.current_struct = decl.name;
                  // Declaration-ordered seen set for FRONTEND WINS: reset per
                  // struct, add each method before its body so self binds and
                  // later siblings stay free (C++ structScopes order).
                  self.bare_seen_count = 0;
                  self.current_method_short = "";
                  let m <&AstNode> = decl.extra;
                  while (m != null) {
                      let m_short <string> = self.bare_short_of(m.name, decl.name);
                      if (!chk_str_eq(m_short, "") && self.bare_seen_count < 64) {
                          let dup <bool> = false;
                          let di <int> = 0;
                          while (di < self.bare_seen_count) {
                              if (chk_str_eq(self.bare_seen_shorts[di], m_short)) { dup = true; }
                              di = di + 1;
                          }
                          if (!dup) {
                              self.bare_seen_shorts[self.bare_seen_count] = m_short;
                              // The parser drops `static` and normalizes every
                              // self to `S*`, so the keyword is read off the
                              // declaration line, not the AST (FW2 I1).
                              if (self.bare_decl_is_static(m.line)) {
                                  self.bare_seen_static[self.bare_seen_count] = 1;
                              } else {
                                  self.bare_seen_static[self.bare_seen_count] = 0;
                              }
                              self.bare_seen_count = self.bare_seen_count + 1;
                          }
                      }
                      self.current_method_short = m_short;
                      self.check_function(m);
                      m = m.right;
                  }
                  self.current_struct = "";
                  self.current_method_short = "";
              } else if (decl.kind == ast_fun_decl()) {
                  self.check_function(decl);
              } else if (decl.kind == ast_enum_decl()) {
                  self.api_validate_attrs(decl.attr_text, true, false, decl.line, decl.col);
                  self.check_enum_bounds(decl);
              } else if (decl.kind == ast_interface_decl()) {
                  self.api_validate_attrs(decl.attr_text, true, false, decl.line, decl.col);
              } else if (decl.kind == ast_var_decl()) {
                  self.api_validate_attrs(decl.attr_text, true, false, decl.line, decl.col);
                  // Wave-5 slice 4: a top-level tie resolves in the scope
                  // around it, like any other declaration of one.
                  self.check_slaveof_tie(decl.attr_text, decl.name, decl.line, decl.col);
                  if (decl.left != null) {
                      self.check_expression(decl.left);
                  }
              } else if (decl.kind == ast_expr_stmt()) {
                  self.api_check_top_stmt(decl);
              }
              decl = decl.right;
          }

          self.api_report_single_protocols();

          return !self.had_error;
      }
}

pub fun new_checker(filename: string) <Checker> {
    let g <&Scope> = new_scope(null);
    let diag_bag <DiagnosticBag> = DiagnosticBag{};
    let chk <Checker> = Checker {
        global_scope: g,
        current_scope: g,
        diag: diag_bag,
        source_file: filename,
        had_error: false,
        current_ret_type: "void",
        current_struct: ""
    };
    chk.grants = new [string, 8]{};
    chk.grant_count = 0;
    chk.in_function = 0;
    chk.quiet_compiler = 0;
    chk.prov_slots = new [string, 8]{};
    chk.prov_names = new [string, 8]{};
    chk.prov_count = 0;
    chk.proto_slots = new [string, 8]{};
    chk.proto_names = new [string, 8]{};
    chk.proto_lines = new [int, 8]{};
    chk.proto_cols = new [int, 8]{};
    chk.proto_count = 0;
    chk.handler_names = new [string, 8]{};
    chk.handler_events = new [string, 8]{};
    chk.handler_count = 0;
    chk.moved_names = new [string, 64]{};
    chk.moved_count = 0;
    chk.moved_quiet = 0;
    chk.bare_seen_shorts = new [string, 64]{};
    chk.bare_seen_static = new [int, 64]{};
    chk.bare_seen_count = 0;
    chk.current_method_short = "";
    chk.host_warn = 0;
    chk.host_taint_names = new [string, 64]{};
    chk.host_taint_ops = new [string, 64]{};
    chk.host_taint_count = 0;
    chk.seed_builtins();
    return chk;
}

pub fun free_checker(c: Checker) <noret> {
    free_scope(c.global_scope);
}

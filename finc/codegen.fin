// Build an LLVM function type from a `fn(P1, P2) -> R` annotation, mapping
// each word through map_type (`any` reads as the word-sized pointer the
// backend lowers it to). Null when the text is not a function type or has
// more parameters than the LLVMTypeArgs carrier holds -- the caller refuses
// rather than truncates.
fun cg_fn_type_from_ann(ctx: &FnContext, ann: string) <&LLVMType> {
    if (ctx == null || !cg_ann_is_fn(ann)) { return null; }
    let a <string> = ann;
    let alen <int> = cast<int>(cg_strlen(a));
    if (alen > 0 && cg_str_eq(substr(a, alen - 1, 1), "?")) {
        a = substr(a, 0, alen - 1);
        alen = alen - 1;
    }
    // Find the parameter list's closing paren at depth 0.
    let depth <int> = 0;
    let ci <int> = 2;
    let close_at <int> = -1;
    while (ci < alen) {
        let ch <string> = substr(a, ci, 1);
        if (cg_str_eq(ch, "(")) { depth = depth + 1; }
        else if (cg_str_eq(ch, ")")) {
            depth = depth - 1;
            if (depth == 0) { close_at = ci; break; }
        }
        ci = ci + 1;
    }
    if (close_at < 0) { return null; }
    let plist <string> = substr(a, 3, close_at - 3);
    let plen <int> = cast<int>(cg_strlen(plist));
    let ret_ann <string> = "void";
    let ri <int> = close_at + 1;
    while (ri + 1 < alen) {
        if (cg_str_eq(substr(a, ri, 2), "->")) {
            ret_ann = cg_trim_spaces(substr(a, ri + 2, alen - ri - 2));
            break;
        }
        ri = ri + 1;
    }
    let params <&LLVMTypeArgs> = new LLVMTypeArgs{};
    let p_count <int> = 0;
    let depth2 <int> = 0;
    let seg_start <int> = 0;
    let pi <int> = 0;
    while (pi <= plen) {
        let at_end <bool> = (pi == plen);
        let ch <string> = "";
        if (!at_end) { ch = substr(plist, pi, 1); }
        if (!at_end && cg_str_eq(ch, "(")) { depth2 = depth2 + 1; }
        else if (!at_end && cg_str_eq(ch, ")")) { depth2 = depth2 - 1; }
        if ((at_end || (cg_str_eq(ch, ",") && depth2 == 0)) && pi > seg_start) {
            let seg <string> = cg_trim_spaces(substr(plist, seg_start, pi - seg_start));
            if (cg_strlen(seg) == cast<ulong>(0)) { seg_start = pi + 1; }
            else {
                let pt <&LLVMType> = map_type(ctx, seg);
                if (p_count > 63) { delete params; return null; }
                cg_targs_set(params, p_count, pt);
                p_count = p_count + 1;
                seg_start = pi + 1;
            }
        } else if (at_end || (cg_str_eq(ch, ",") && depth2 == 0)) {
            seg_start = pi + 1;
        }
        pi = pi + 1;
    }
    let ret_ty <&LLVMType> = map_type(ctx, ret_ann);
    let fn_ty <&LLVMType> = llvm_function_type(ret_ty, params, p_count, 0);
    delete params;
    return fn_ty;
}

// The full spelling behind a receiver chain (`w`, `w.dbox`, `w.b.val`):
// idents answer their annotation; a member answers its field's
// annotation with the outer spelling's arguments substituted (through
// the instance when one exists, through the template otherwise). ""
// when nothing answers; callers stay on the old path. Single-level
// ident roots behave exactly like the MC1 receiver read; deeper chains
// extend it without touching that path.
fun cg_chain_spelling(ctx: &FnContext, node: &AstNode) <string> {
    if (ctx == null || node == null) { return ""; }
    if (node.kind == ast_ident()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, node.name);
        if (v == null || v.type_annotation == null) { return ""; }
        return cg_trim_spaces(v.type_annotation);
    }
    if (node.kind != ast_member_access()) { return ""; }
    if (node.name == null || cg_strlen(node.name) == cast<ulong>(0)) { return ""; }
    let outer <string> = cg_chain_spelling(ctx, node.left);
    if (cg_strlen(outer) == cast<ulong>(0)) { return ""; }
    let rfull <string> = outer;
    let rlen <int> = cast<int>(cg_strlen(rfull));
    while (rlen > 1 && (cg_str_eq(substr(rfull, 0, 1), "&") || cg_str_eq(substr(rfull, 0, 1), "*"))) {
        rfull = substr(rfull, 1, rlen - 1);
        rlen = cast<int>(cg_strlen(rfull));
    }
    while (rlen > 1 && cg_str_eq(substr(rfull, rlen - 1, 1), "*")) {
        rfull = substr(rfull, 0, rlen - 1);
        rlen = cast<int>(cg_strlen(rfull));
    }
    rfull = cg_trim_spaces(rfull);
    if (cg_strlen(rfull) == cast<ulong>(0)) { return ""; }
    let inst <&StructInfo> = cg_ensure_struct_instance(ctx, rfull);
    if (inst != null && cg_str_contains(inst.name, "<")) {
        let ii <int> = 0;
        while (ii < inst.field_count) {
            let ff <&StructFieldInfo> = inst.fields[ii];
            if (ff != null && cg_str_eq(ff.name, node.name)) {
                return ff.type_annotation;
            }
            ii = ii + 1;
        }
        return "";
    }
    let rbase <string> = rfull;
    let rlen2 <int> = cast<int>(cg_strlen(rfull));
    let ro_at <int> = -1;
    let rq <int> = 0;
    while (rq < rlen2) {
        if (cg_str_eq(substr(rfull, rq, 1), "<")) { ro_at = rq; break; }
        rq = rq + 1;
    }
    if (ro_at > 0) { rbase = cg_trim_spaces(substr(rfull, 0, ro_at)); }
    let rst <&StructInfo> = find_struct(ctx, rbase);
    if (rst == null) { return ""; }
    let rfi <int> = 0;
    while (rfi < rst.field_count) {
        let rf <&StructFieldInfo> = rst.fields[rfi];
        if (rf != null && cg_str_eq(rf.name, node.name)) {
            if (rst.gen_params == null || cg_strlen(rst.gen_params) == cast<ulong>(0)) { return rf.type_annotation; }
            if (ro_at <= 0) { return rf.type_annotation; }
            let rc_at <int> = -1;
            let rj <int> = rlen2 - 1;
            while (rj > ro_at) {
                if (cg_str_eq(substr(rfull, rj, 1), ">")) { rc_at = rj; break; }
                rj = rj - 1;
            }
            if (rc_at <= ro_at) { return rf.type_annotation; }
            let rinner <string> = substr(rfull, ro_at + 1, rc_at - ro_at - 1);
            let rgp <[string]> = new [string, 64]{};
            let rga <[string]> = new [string, 64]{};
            let rpc <int> = cg_split_top(rst.gen_params, rgp, 64);
            let rac <int> = cg_split_top(rinner, rga, 64);
            let out <string> = rf.type_annotation;
            if (rpc > 0 && rac == rpc) {
                out = cg_trim_spaces(cg_subst_params(rf.type_annotation, rgp, rga, rpc, rac));
            }
            delete rgp;
            delete rga;
            return out;
        }
        rfi = rfi + 1;
    }
    return "";
}

fun get_struct_field_type(ctx: &FnContext, base_node: &AstNode, field_name: string) <&LLVMType> {
    if (field_name == null) { return ctx.i32_ty; }

    // FE1a: a member rooted in another member (`w.dbox.val`, `w.b.val`)
    // names the instantiation in the outer chain's spelling. Resolve the
    // width off the instance so width-mixed instantiations (`Box<int>`
    // beside `Box<double>`) read correctly on both sides. The instance
    // check requires a real instance (a name carrying arguments):
    // anything exotic stays on the old path below.
    if (base_node != null && base_node.kind == ast_member_access()) {
        let mspell <string> = cg_chain_spelling(ctx, base_node);
        if (mspell != null && cg_str_contains(mspell, "<")) {
            let inst <&StructInfo> = cg_ensure_struct_instance(ctx, mspell);
            if (inst != null && cg_str_contains(inst.name, "<")) {
                let ii <int> = 0;
                while (ii < inst.field_count) {
                    let ff <&StructFieldInfo> = inst.fields[ii];
                    if (ff != null && cg_str_eq(ff.name, field_name)) {
                        return map_type(ctx, ff.type_annotation);
                    }
                    ii = ii + 1;
                }
            }
        }
    }

    let s_name <string> = get_node_struct_name(ctx, base_node);
    if (cg_strlen(s_name) > cast<ulong>(0)) {
        let si <int> = 0;
        while (si < ctx.struct_count) {
            let st <&StructInfo> = ctx.structs[si];
            if (st != null && cg_str_eq(st.name, s_name)) {
                let fi <int> = 0;
                while (fi < st.field_count) {
                    let f <&StructFieldInfo> = st.fields[fi];
                    if (f != null && cg_str_eq(f.name, field_name)) {
                        let ft <string> = f.type_annotation;
                        // General generic substitution against the
                        // receiver's actual arguments (`f5 <T5>` on a
                        // `Gn<int, ...>` reads `int`). Without it a
                        // multi-letter parameter maps to ptr here while
                        // construction stores the value type, so the
                        // read segfaults. Falls through to the legacy
                        // single-`T` rule and the direct map below when
                        // the receiver names no instantiation.
                        if (st.gen_params != null && cg_strlen(st.gen_params) > cast<ulong>(0) &&
                          base_node != null && base_node.kind == ast_ident()) {
                            let v_sub <&LocalVar> = fn_ctx_find_var(ctx, base_node.name);
                            if (v_sub != null && v_sub.type_annotation != null) {
                                let rfull <string> = cg_trim_spaces(v_sub.type_annotation);
                                let rlen <int> = cast<int>(cg_strlen(rfull));
                                while (rlen > 1 && (cg_str_eq(substr(rfull, 0, 1), "&") || cg_str_eq(substr(rfull, 0, 1), "*"))) {
                                    rfull = substr(rfull, 1, rlen - 1);
                                    rlen = cast<int>(cg_strlen(rfull));
                                }
                                let ro_at <int> = -1;
                                let rc_at <int> = -1;
                                let rq <int> = 0;
                                while (rq < rlen) {
                                    if (cg_str_eq(substr(rfull, rq, 1), "<")) { ro_at = rq; break; }
                                    rq = rq + 1;
                                }
                                if (ro_at > 0) {
                                    rq = rlen - 1;
                                    while (rq > ro_at) {
                                        if (cg_str_eq(substr(rfull, rq, 1), ">")) { rc_at = rq; break; }
                                        rq = rq - 1;
                                    }
                                }
                                if (ro_at > 0 && rc_at > ro_at) {
                                    let rbase <string> = cg_trim_spaces(substr(rfull, 0, ro_at));
                                    if (cg_str_eq(rbase, st.name)) {
                                        let rinner <string> = substr(rfull, ro_at + 1, rc_at - ro_at - 1);
                                        let gp <[string]> = new [string, 64]{};
                                        let ga <[string]> = new [string, 64]{};
                                        let gpc <int> = cg_split_top(st.gen_params, gp, 64);
                                        let gac <int> = cg_split_top(rinner, ga, 64);
                                        if (gpc > 0 && gac == gpc) {
                                            let sub <string> = cg_subst_params(ft, gp, ga, gpc, gac);
                                            delete gp;
                                            delete ga;
                                            if (!cg_str_eq(sub, ft)) { return map_type(ctx, sub); }
                                        } else {
                                            delete gp;
                                            delete ga;
                                            if (gpc != gac) {
                                                // Generic count mismatch at
                                                // the read (C++ refuses it
                                                // identically): proceeding
                                                // misresolves the tail.
                                                cg_dprintf(2, "finc codegen refusal: generic count mismatch reading '%s' on '%s' (declared %d parameters, got %d arguments)\n", field_name, rbase, gpc, gac);
                                                refuse_and_poison(ctx);
                                                return ctx.i32_ty;
                                            }
                                        }
                                    }
                                }
                            }
                          }
                        if (cg_str_eq(ft, "T") || cg_str_eq(ft, "&T")) {
                            if (base_node != null && base_node.kind == ast_ident()) {
                                let v_base <&LocalVar> = fn_ctx_find_var(ctx, base_node.name);
                                if (v_base != null && v_base.type_annotation != null) {
                                    let v_ann <string> = v_base.type_annotation;
                                    let v_len <int> = cast<int>(cg_strlen(v_ann));
                                    let lt_pos <int> = -1;
                                    let gt_pos <int> = -1;
                                    let vi <int> = 0;
                                    while (vi < v_len) {
                                        if (cg_str_eq(substr(v_ann, vi, 1), "<")) { lt_pos = vi; }
                                        else if (cg_str_eq(substr(v_ann, vi, 1), ">")) { gt_pos = vi; }
                                        vi = vi + 1;
                                    }
                                    if (lt_pos >= 0 && gt_pos > lt_pos + 1) {
                                        let garg <string> = substr(v_ann, lt_pos + 1, gt_pos - lt_pos - 1);
                                        if (cg_str_eq(ft, "&T")) {
                                            return ctx.ptr_ty;
                                        }
                                        return map_type(ctx, garg);
                                    }
                                }
                            }
                        }
                        return map_type(ctx, f.type_annotation);
                    }
                    fi = fi + 1;
                }
            }
            si = si + 1;
        }
    }

    let si <int> = 0;
    while (si < ctx.struct_count) {
        let st <&StructInfo> = ctx.structs[si];
        if (st != null) {
            let fi <int> = 0;
            while (fi < st.field_count) {
                let f <&StructFieldInfo> = st.fields[fi];
                if (f != null && cg_str_eq(f.name, field_name)) {
                    return map_type(ctx, f.type_annotation);
                }
                fi = fi + 1;
            }
        }
        si = si + 1;
    }

    return ctx.i32_ty;
}

fun find_field_index_by_name(ctx: &FnContext, s_name: string, field_name: string) <int> {
    if (field_name == null) { return 0; }
    if (s_name != null && cg_strlen(s_name) > cast<ulong>(0)) {
        let si <int> = 0;
        while (si < ctx.struct_count) {
            let st <&StructInfo> = ctx.structs[si];
            if (st != null && cg_str_eq(st.name, s_name)) {
                let fi <int> = 0;
                while (fi < st.field_count) {
                    let f <&StructFieldInfo> = st.fields[fi];
                    if (f != null && cg_str_eq(f.name, field_name)) {
                        return f.index;
                    }
                    fi = fi + 1;
                }
            }
            si = si + 1;
        }
    }
    return find_field_index(ctx, null, field_name);
}

fun get_struct_field_type_by_name(ctx: &FnContext, s_name: string, field_name: string) <&LLVMType> {
    if (field_name == null) { return ctx.i32_ty; }
    if (s_name != null && cg_strlen(s_name) > cast<ulong>(0)) {
        let si <int> = 0;
        while (si < ctx.struct_count) {
            let st <&StructInfo> = ctx.structs[si];
            if (st != null && cg_str_eq(st.name, s_name)) {
                let fi <int> = 0;
                while (fi < st.field_count) {
                    let f <&StructFieldInfo> = st.fields[fi];
                    if (f != null && cg_str_eq(f.name, field_name)) {
                        return map_type(ctx, f.type_annotation);
                    }
                    fi = fi + 1;
                }
            }
            si = si + 1;
        }
    }
    return get_struct_field_type(ctx, null, field_name);
}

fun get_or_declare_calloc(ctx: &FnContext) <&LLVMValue> {
    let calloc_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "calloc");
    if (calloc_fn == null) {
        let c_params <&LLVMTypeArgs> = new LLVMTypeArgs{};
        c_params.t0 = ctx.i64_ty;
        c_params.t1 = ctx.i64_ty;
        let c_ty <&LLVMType> = llvm_function_type(ctx.ptr_ty, c_params, 2, 0);
        delete c_params;
        calloc_fn = llvm_add_function(ctx.module, "calloc", c_ty);
    }
    return calloc_fn;
}

// Declares the C `memcpy` once per module for by-value struct parameter
// copies (see cg_param_needs_value_copy): `void *memcpy(void *, const
// void *, size_t)`, pointer-sized length like every other word count here.
fun get_or_declare_memcpy(ctx: &FnContext) <&LLVMValue> {
    let memcpy_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "memcpy");
    if (memcpy_fn == null) {
        let m_params <&LLVMTypeArgs> = new LLVMTypeArgs{};
        m_params.t0 = ctx.ptr_ty;
        m_params.t1 = ctx.ptr_ty;
        m_params.t2 = ctx.i64_ty;
        let m_ty <&LLVMType> = llvm_function_type(ctx.ptr_ty, m_params, 3, 0);
        delete m_params;
        memcpy_fn = llvm_add_function(ctx.module, "memcpy", m_ty);
    }
    return memcpy_fn;
}

// Declares C `strlen` once per module for string content comparison:
// `size_t strlen(const char *)`. Lengths come from here, never from
// NUL-terminated comparison: the `==` contract is same-length AND
// byte-equal over the full bytes.
fun get_or_declare_strlen(ctx: &FnContext) <&LLVMValue> {
    let strlen_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "strlen");
    if (strlen_fn == null) {
        let s_params <&LLVMTypeArgs> = new LLVMTypeArgs{};
        s_params.t0 = ctx.ptr_ty;
        let s_ty <&LLVMType> = llvm_function_type(ctx.i64_ty, s_params, 1, 0);
        delete s_params;
        strlen_fn = llvm_add_function(ctx.module, "strlen", s_ty);
    }
    return strlen_fn;
}

// Declares C `memcmp` once per module for string content comparison:
// `int memcmp(const void *, const void *, size_t)`, length in words
// like every other count here.
fun get_or_declare_memcmp(ctx: &FnContext) <&LLVMValue> {
    let memcmp_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "memcmp");
    if (memcmp_fn == null) {
        let m_params <&LLVMTypeArgs> = new LLVMTypeArgs{};
        m_params.t0 = ctx.ptr_ty;
        m_params.t1 = ctx.ptr_ty;
        m_params.t2 = ctx.i64_ty;
        let m_ty <&LLVMType> = llvm_function_type(ctx.i32_ty, m_params, 3, 0);
        delete m_params;
        memcmp_fn = llvm_add_function(ctx.module, "memcmp", m_ty);
    }
    return memcmp_fn;
}

// Whether a member store (or compound update) lands inside the object a
// name roots: `p.a = ...` counts for `p`, and for `w.b` (whose root is
// still `w`); anything else does not.
fun cg_store_roots_param(node: &AstNode, pname: string) <bool> {
    if (node == null || pname == null) { return false; }
    if (node.kind == ast_ident()) {
        return cg_str_eq(node.name, pname);
    }
    if (node.kind == ast_member_access()) {
        return cg_store_roots_param(node.left, pname);
    }
    return false;
}

// Whether a function body writes through a parameter (member store,
// compound member update, member inc/dec) or takes its address: the two
// ways a callee can observe or leak the caller's object.
fun cg_body_writes_param(node: &AstNode, pname: string) <bool> {
    if (node == null || pname == null) { return false; }
    if (node.kind == ast_binary_expr() && node.name != null) {
        if (cg_str_eq(node.name, "=") || cg_str_eq(node.name, "+=") || cg_str_eq(node.name, "-=") ||
          cg_str_eq(node.name, "*=") || cg_str_eq(node.name, "/=") || cg_str_eq(node.name, "%=") ||
          cg_str_eq(node.name, "&=") || cg_str_eq(node.name, "|=") || cg_str_eq(node.name, "^=") ||
          cg_str_eq(node.name, "<<=") || cg_str_eq(node.name, ">>=")) {
            if (node.left != null && node.left.kind == ast_member_access() &&
              cg_store_roots_param(node.left, pname)) {
                return true;
              }
          }
    }
    if (node.kind == ast_unary_expr() && node.name != null) {
        if (cg_str_eq(node.name, "++") || cg_str_eq(node.name, "--")) {
            if (node.left != null && node.left.kind == ast_member_access() &&
              cg_store_roots_param(node.left, pname)) {
                return true;
              }
        }
        if (cg_str_eq(node.name, "&")) {
            if (node.left != null && node.left.kind == ast_ident() && cg_str_eq(node.left.name, pname)) {
                return true;
            }
        }
    }
    if (cg_body_writes_param(node.left, pname)) { return true; }
    if (cg_body_writes_param(node.right, pname)) { return true; }
    if (cg_body_writes_param(node.extra, pname)) { return true; }
    return false;
}

// Whether a parameter takes its struct by value: a nominal struct written
// without `&`/`*` arrives as the caller's heap-box pointer, so the callee
// copies the box on entry and member stores stay function-local (C++ passes
// the value: d01's `p.a = 50` must not reach the caller, while `&P`
// parameters keep aliasing). A generic instantiation (`Box<int>`) parses
// to `void*`, losing the struct spelling; there the body's own writes
// decide (d03 writes `b.val`, so it copies; a pure reader like
// `second<T>` shares the buffer, which reads identically).
// Scalars, strings, arrays, bare type parameters, function types and
// anything unresolvable keep the incoming word as-is.
fun cg_param_needs_value_copy(ctx: &FnContext, ann: string, fn_body: &AstNode, pname: string) <bool> {
    if (ctx == null || ann == null || cg_strlen(ann) == cast<ulong>(0)) { return false; }
    let t <string> = cg_trim_spaces(ann);
    if (cg_strlen(t) == cast<ulong>(0)) { return false; }
    if (cg_str_eq(substr(t, 0, 1), "&") || cg_str_eq(substr(t, 0, 1), "*")) { return false; }
    let tlen <int> = cast<int>(cg_strlen(t));
    if (cg_str_eq(t, "void*")) {
        // The parser erases generic instantiations (`Box<int>`) to
        // `void*`: the body's own writes decide (see above).
        return cg_body_writes_param(fn_body, pname);
    }
    if (cg_str_eq(substr(t, tlen - 1, 1), "*")) { return false; }
    if (cg_ann_is_fn(t)) { return false; }
    if (cg_str_eq(t, "string") || cg_str_eq(t, "prototype")) { return false; }
    let base <string> = t;
    let bi <int> = 0;
    while (bi < tlen) {
        if (cg_str_eq(substr(t, bi, 1), "<")) {
            base = cg_trim_spaces(substr(t, 0, bi));
            break;
        }
        bi = bi + 1;
    }
    if (cg_strlen(base) == cast<ulong>(0)) { return false; }
    if (cg_is_generic_ann(ctx, base)) { return false; }
    return find_struct(ctx, base) != null;
}

// The declared annotation of a struct field (`restrict` on `a.restrict`),
// preferring the receiver's own struct and falling back to the first
// same-named field. "" when nothing declares it. Used where the lowering
// needs the spelling (not the mapped width), e.g. deciding whether `*`
// on a member yields a struct box or a scalar load.
fun cg_member_field_ann(ctx: &FnContext, base_node: &AstNode, field_name: string) <string> {
    if (ctx == null || field_name == null) { return ""; }
    let s_name <string> = get_node_struct_name(ctx, base_node);
    if (cg_strlen(s_name) > cast<ulong>(0)) {
        let si <int> = 0;
        while (si < ctx.struct_count) {
            let st <&StructInfo> = ctx.structs[si];
            if (st != null && cg_str_eq(st.name, s_name)) {
                let fi <int> = 0;
                while (fi < st.field_count) {
                    let f <&StructFieldInfo> = st.fields[fi];
                    if (f != null && cg_str_eq(f.name, field_name)) {
                        if (f.type_annotation != null) { return f.type_annotation; }
                        return "";
                    }
                    fi = fi + 1;
                }
            }
            si = si + 1;
        }
    }
    let gi <int> = 0;
    while (gi < ctx.struct_count) {
        let gst <&StructInfo> = ctx.structs[gi];
        if (gst != null) {
            let gfi <int> = 0;
            while (gfi < gst.field_count) {
                let gf <&StructFieldInfo> = gst.fields[gfi];
                if (gf != null && cg_str_eq(gf.name, field_name)) {
                    if (gf.type_annotation != null) { return gf.type_annotation; }
                    return "";
                }
                gfi = gfi + 1;
            }
        }
        gi = gi + 1;
    }
    return "";
}

// The field annotation with the receiver's instantiation substituted
// (`value` on an `rptr<[int]>` reads `&[int]`, not the template's `&T`),
// when that resolved spelling is an array reference the direct lookup
// above cannot see. "" otherwise (including when the template already
// spells `&[...]`, which the existing paths own, and when the receiver
// names no instantiation). Array-typed `&T` cells hold the buffer (one
// extra load past the field, like every other `&[]` member base);
// scalar `&T` cells hold the value itself.
fun cg_member_inst_arr_ann(ctx: &FnContext, base_node: &AstNode, field_name: string) <string> {
    if (ctx == null || base_node == null || field_name == null) { return ""; }
    if (base_node.kind != ast_member_access()) { return ""; }
    if (base_node.left == null || base_node.left.kind != ast_ident()) { return ""; }
    let direct <string> = cg_member_field_ann(ctx, base_node.left, field_name);
    if (cg_strlen(direct) > cast<ulong>(2) && cg_str_eq(substr(direct, 0, 2), "&[")) { return ""; }
    let rv <&LocalVar> = fn_ctx_find_var(ctx, base_node.left.name);
    if (rv == null || rv.type_annotation == null) { return ""; }
    let rfull <string> = cg_trim_spaces(rv.type_annotation);
    let rlen <int> = cast<int>(cg_strlen(rfull));
    while (rlen > 1 && (cg_str_eq(substr(rfull, 0, 1), "&") || cg_str_eq(substr(rfull, 0, 1), "*"))) {
        rfull = substr(rfull, 1, rlen - 1);
        rlen = rlen - 1;
    }
    let open_at <int> = -1;
    let oi <int> = 0;
    while (oi < rlen) {
        if (cg_str_eq(substr(rfull, oi, 1), "<")) { open_at = oi; break; }
        oi = oi + 1;
    }
    if (open_at <= 0) { return ""; }
    let inst <&StructInfo> = cg_ensure_struct_instance(ctx, rfull);
    if (inst == null) { return ""; }
    let ii <int> = 0;
    while (ii < inst.field_count) {
        let ff <&StructFieldInfo> = inst.fields[ii];
        if (ff != null && cg_str_eq(ff.name, field_name)) {
            if (ff.type_annotation != null && cg_strlen(ff.type_annotation) > cast<ulong>(2) &&
              cg_str_eq(substr(ff.type_annotation, 0, 2), "&[")) {
                return ff.type_annotation;
              }
            return "";
        }
        ii = ii + 1;
    }
    return "";
}

// Struct fields are pointer-strided slots, so a 16-byte interface value does
// not fit: interface-typed fields hold a heap box (pointer to the fat value)
// while locals and parameters hold the value itself. These two helpers are
// the only box/unbox sites; every member read/write/init of an
// interface-typed field routes through them.
// A `&[...]` base (reference to an array, e.g. rptr's `value <&T>` with an
// array T) points at a cell holding the data pointer: one extra load reaches
// the buffer. Plain `[...]` bases already are the buffer.
fun is_ref_array_base(ctx: &FnContext, base_node: &AstNode) <bool> {
    if (ctx == null || base_node == null) { return false; }
    if (base_node.kind == ast_ident()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, base_node.name);
        if (v != null && v.type_annotation != null && cg_strlen(v.type_annotation) > cast<ulong>(1)) {
            if (cg_str_eq(substr(v.type_annotation, 0, 2), "&[")) {
                return true;
            }
            // The parser erases a `&[T]` parameter spelling to `void*`
            // (parse_param_type folds `&` + `[...]`), so the callee only
            // sees `void*`. A `void*` value being indexed is such a
            // reference in every program the C++ backend accepts (it
            // refuses indexing a genuine void pointer): the caller passed
            // the array fat-pointer address, and the buffer loads from
            // its first word.
            if (cg_str_eq(cg_trim_spaces(v.type_annotation), "void*")) {
                return true;
            }
        }
        return false;
    }
    if (base_node.kind == ast_member_access()) {
        let b_st <string> = get_node_struct_name(ctx, base_node.left);
        let b_info <&StructInfo> = find_struct(ctx, b_st);
        if (b_info != null) {
            let bi <int> = 0;
            while (bi < b_info.field_count) {
                let bf <&StructFieldInfo> = b_info.fields[bi];
                if (bf != null && cg_str_eq(bf.name, base_node.name)) {
                    if (bf.type_annotation != null && cg_strlen(bf.type_annotation) > cast<ulong>(1)) {
                        if (cg_str_eq(substr(bf.type_annotation, 0, 2), "&[")) {
                            return true;
                        }
                    }
                    break;
                }
                bi = bi + 1;
            }
        }
        // A generic instantiation erases the array in the field (`value`
        // `<&T>` on `rptr<[int]>`): resolve through the receiver's own
        // arguments, where the buffer-holding reference is visible.
        if (cg_strlen(cg_member_inst_arr_ann(ctx, base_node, base_node.name)) > cast<ulong>(0)) {
            return true;
        }
        return false;
    }
    return false;
}

fun field_interface(ctx: &FnContext, st_name: string, field_name: string) <&InterfaceInfo> {
    if (ctx == null || st_name == null || field_name == null) { return null; }
    if (cg_strlen(st_name) == cast<ulong>(0)) { return null; }
    let st_info <&StructInfo> = find_struct(ctx, st_name);
    if (st_info == null) { return null; }
    let bi <int> = 0;
    while (bi < st_info.field_count) {
        let bf <&StructFieldInfo> = st_info.fields[bi];
        if (bf != null && cg_str_eq(bf.name, field_name)) {
            return find_interface(ctx, bf.type_annotation);
        }
        bi = bi + 1;
    }
    return null;
}

fun box_interface_value(ctx: &FnContext, fat_val: &LLVMValue, fat_ty: &LLVMType) <&LLVMValue> {
    if (fat_val == null || ctx == null) { return fat_val; }
    let box_ty <&LLVMType> = fat_ty;
    if (box_ty == null) { box_ty = ctx.fat_ptr_ty; }
    let calloc_fn <&LLVMValue> = get_or_declare_calloc(ctx);
    let c_fn_ty <&LLVMType> = llvm_global_get_value_type(calloc_fn);
    let c_args <&LLVMValueArgs> = new LLVMValueArgs{};
    c_args.v0 = llvm_const_int(ctx.i64_ty, 2, 0);
    c_args.v1 = llvm_const_int(ctx.i64_ty, 8, 0);
    let box <&LLVMValue> = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args, 2, "iface_box");
    delete c_args;
    if (box_ty != null) {
        llvm_build_store(ctx.builder, fat_val, box);
    }
    return box;
}

fun struct_to_interface(ctx: &FnContext, st_val: &LLVMValue, st_name: string, iface: &InterfaceInfo) <&LLVMValue> {
    if (st_val == null || iface == null || ctx == null) { return st_val; }
    let fat_ty <&LLVMType> = ctx.fat_ptr_ty;
    if (iface.fat_ptr_ty != null) {
        fat_ty = iface.fat_ptr_ty;
    }
    if (fat_ty == null) { return st_val; }
    let m_count <int> = iface.method_count;
    if (m_count == 0) { m_count = 1; }
    let calloc_fn <&LLVMValue> = get_or_declare_calloc(ctx);
    let c_fn_ty <&LLVMType> = llvm_global_get_value_type(calloc_fn);
    let c_args <&LLVMValueArgs> = new LLVMValueArgs{};
    c_args.v0 = llvm_const_int(ctx.i64_ty, m_count, 0);
    c_args.v1 = llvm_const_int(ctx.i64_ty, 8, 0);
    let vt_ptr <&LLVMValue> = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args, 2, "vtable");
    delete c_args;

    let mi <int> = 0;
    while (mi < iface.method_count) {
        let m_info <&InterfaceMethodInfo> = iface.methods[mi];
        if (m_info != null) {
            // Interface fields occupy vtable slots too: the slot holds the
            // field's slot index in the concrete struct (as a pointer-sized
            // value), so a reader with only the interface type can address it.
            if (m_info.is_field) {
                let f_idx <int> = find_field_index_by_name(ctx, st_name, m_info.name);
                let f_ind <&LLVMIndices> = new LLVMIndices{};
                f_ind.i0 = llvm_const_int(ctx.i64_ty, mi, 0);
                let f_slot <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, vt_ptr, f_ind, 1, "vt_field");
                delete f_ind;
                let f_off <&LLVMValue> = llvm_build_int_to_ptr(ctx.builder, llvm_const_int(ctx.i64_ty, f_idx, 0), ctx.ptr_ty, "field_off");
                llvm_build_store(ctx.builder, f_off, f_slot);
                mi = mi + 1;
                continue;
            }
            let b <Buffer> = new_buffer(64);
            b.write_string(st_name);
            b.write_char('.');
            b.write_string(m_info.name);
            let m_full_name <string> = b.to_string();
            free_buffer(b);

            let m_fn <&LLVMValue> = llvm_get_named_function(ctx.module, m_full_name);
            if (m_fn == null) {
                let b2 <Buffer> = new_buffer(64);
                b2.write_string(st_name);
                b2.write_char('_');
                b2.write_string(m_info.name);
                let m_under_name <string> = b2.to_string();
                free_buffer(b2);
                m_fn = llvm_get_named_function(ctx.module, m_under_name);
            }
            if (m_fn == null) {
                // The parser qualifies interface method names with their
                // interface (`Greeter_greet`), while a struct method lowers
                // as `Struct_short`: strip the `<iface>_` prefix and resolve
                // the short name, or the slot stays what calloc left (null)
                // and a call through it jumps to address zero.
                let short_name <string> = m_info.name;
                let pb <Buffer> = new_buffer(64);
                pb.write_string(iface.name);
                pb.write_char('_');
                let prefix <string> = pb.to_string();
                free_buffer(pb);
                let pre_len <int> = cast<int>(cg_strlen(prefix));
                let nm_len <int> = cast<int>(cg_strlen(short_name));
                if (pre_len > 0 && nm_len > pre_len && cg_str_eq(substr(short_name, 0, pre_len), prefix)) {
                    short_name = substr(short_name, pre_len, nm_len - pre_len);
                }
                if (!cg_str_eq(short_name, m_info.name)) {
                    let b3 <Buffer> = new_buffer(64);
                    b3.write_string(st_name);
                    b3.write_char('_');
                    b3.write_string(short_name);
                    let m_short_under <string> = b3.to_string();
                    free_buffer(b3);
                    m_fn = llvm_get_named_function(ctx.module, m_short_under);
                    if (m_fn == null) {
                        let b4 <Buffer> = new_buffer(64);
                        b4.write_string(st_name);
                        b4.write_char('.');
                        b4.write_string(short_name);
                        let m_short_dot <string> = b4.to_string();
                        free_buffer(b4);
                        m_fn = llvm_get_named_function(ctx.module, m_short_dot);
                    }
                }
            }
            if (m_fn != null) {
                let ind <&LLVMIndices> = new LLVMIndices{};
                ind.i0 = llvm_const_int(ctx.i64_ty, mi, 0);
                let slot <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, vt_ptr, ind, 1, "vt_slot");
                delete ind;
                let fn_p <&LLVMValue> = llvm_build_bitcast(ctx.builder, m_fn, ctx.ptr_ty, "fn_p");
                llvm_build_store(ctx.builder, fn_p, slot);
            }
        }
        mi = mi + 1;
    }

    let fat_alloca <&LLVMValue> = llvm_build_alloca(ctx.builder, fat_ty, "fat.tmp");
    let d_gep <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, fat_ty, fat_alloca, 0, "d_gep");
    let st_p <&LLVMValue> = coerce_val(ctx, st_val, ctx.ptr_ty);
    llvm_build_store(ctx.builder, st_p, d_gep);
    let vt_gep <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, fat_ty, fat_alloca, 1, "vt_gep");
    llvm_build_store(ctx.builder, vt_ptr, vt_gep);
    return llvm_build_load2(ctx.builder, fat_ty, fat_alloca, "fat.val");
}

// A struct value flowing into an interface-typed slot converts to that
// interface's fat value, vtable included; anything else passes through
// untouched. This is the value-to-slot half of the argument conversion at
// the call boundary: `let g <Iface> = st` and `g = st` route here, while
// arguments and returns carry their own (identical) inline conversions.
fun cg_value_to_iface_slot(ctx: &FnContext, val: &LLVMValue, slot_ty: &LLVMType, src_node: &AstNode) <&LLVMValue> {
    if (ctx == null || val == null || slot_ty == null) { return val; }
    if (llvm_type_of(val) == slot_ty) { return val; }
    let tgt_iface <&InterfaceInfo> = null;
    let ti <int> = 0;
    while (ti < ctx.interface_count) {
        let cand <&InterfaceInfo> = ctx.interfaces[ti];
        if (cand != null && cand.fat_ptr_ty != null && slot_ty == cand.fat_ptr_ty) {
            tgt_iface = cand;
            break;
        }
        ti = ti + 1;
    }
    if (tgt_iface == null) { return val; }
    let st_name <string> = get_node_struct_name(ctx, src_node);
    if (cg_strlen(st_name) == cast<ulong>(0)) {
        if (src_node != null && src_node.kind == ast_ident()) {
            let v_arg <&LocalVar> = fn_ctx_find_var(ctx, src_node.name);
            if (v_arg != null) { st_name = v_arg.type_annotation; }
        }
    }
    if (cg_strlen(st_name) == cast<ulong>(0)) { return val; }
    if (find_struct(ctx, st_name) == null) { return val; }
    return struct_to_interface(ctx, val, st_name, tgt_iface);
}

fun get_or_declare_malloc(ctx: &FnContext) <&LLVMValue> {
    let malloc_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "malloc");
    if (malloc_fn == null) {
        let m_params <&LLVMTypeArgs> = new LLVMTypeArgs{};
        m_params.t0 = ctx.i64_ty;
        let m_ty <&LLVMType> = llvm_function_type(ctx.ptr_ty, m_params, 1, 0);
        delete m_params;
        malloc_fn = llvm_add_function(ctx.module, "malloc", m_ty);
    }
    return malloc_fn;
}

fun get_or_declare_free(ctx: &FnContext) <&LLVMValue> {
    let free_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "free");
    if (free_fn == null) {
        let f_params <&LLVMTypeArgs> = new LLVMTypeArgs{};
        f_params.t0 = ctx.ptr_ty;
        let f_ty <&LLVMType> = llvm_function_type(ctx.void_ty, f_params, 1, 0);
        delete f_params;
        free_fn = llvm_add_function(ctx.module, "free", f_ty);
    }
    return free_fn;
}

fun get_or_declare_printf(ctx: &FnContext) <&LLVMValue> {
    let p_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "printf");
    if (p_fn == null) {
        let p_params <&LLVMTypeArgs> = new LLVMTypeArgs{};
        p_params.t0 = ctx.ptr_ty;
        let p_ty <&LLVMType> = llvm_function_type(ctx.i32_ty, p_params, 1, 1);
        delete p_params;
        p_fn = llvm_add_function(ctx.module, "printf", p_ty);
    }
    return p_fn;
}

fun get_or_declare_dprintf(ctx: &FnContext) <&LLVMValue> {
    let d_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "dprintf");
    if (d_fn == null) {
        let d_params <&LLVMTypeArgs> = new LLVMTypeArgs{};
        d_params.t0 = ctx.i32_ty;
        d_params.t1 = ctx.ptr_ty;
        let d_ty <&LLVMType> = llvm_function_type(ctx.i32_ty, d_params, 2, 1);
        delete d_params;
        d_fn = llvm_add_function(ctx.module, "dprintf", d_ty);
    }
    return d_fn;
}

fun get_or_declare_abort(ctx: &FnContext) <&LLVMValue> {
    let a_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "abort");
    if (a_fn == null) {
        let a_ty <&LLVMType> = llvm_function_type(ctx.void_ty, null, 0, 0);
        a_fn = llvm_add_function(ctx.module, "abort", a_ty);
    }
    return a_fn;
}

// The parser fills a missing blame message with the literal
// "assertion failed" at the blame token's own position; that default prints
// the short form (`file:line: assertion failed`), an explicit message the
// long form. The positions can only coincide for the default: a written
// message always starts after the condition.
fun cg_blame_msg_is_default(stmt: &AstNode) <bool> {
    if (stmt == null || stmt.right == null) { return true; }
    let m <&AstNode> = stmt.right;
    if (m.kind != ast_literal_string()) { return false; }
    if (!cg_str_eq(m.str_val, "assertion failed")) { return false; }
    if (m.line != stmt.line || m.col != stmt.col) { return false; }
    return true;
}

// A failed blame prints `file:line: assertion failed[: msg]` on stderr
// (dprintf fd 2, the same bytes fprintf(stderr, ...) writes), then the
// caller aborts. With no filename there is nothing true to print, so this
// emits nothing and the caller keeps the bare abort.
fun cg_emit_blame_text(ctx: &FnContext, line: int, msg_val: &LLVMValue) <noret> {
    if (ctx.src_file == null || cg_strlen(ctx.src_file) == cast<ulong>(0)) { return; }
    let d_fn <&LLVMValue> = get_or_declare_dprintf(ctx);
    let d_ty <&LLVMType> = llvm_global_get_value_type(d_fn);
    let file_s <&LLVMValue> = llvm_build_global_string_ptr(ctx.builder, ctx.src_file, "blame_file");
    let line_v <&LLVMValue> = llvm_const_int(ctx.i32_ty, line, 0);
    let fd_v <&LLVMValue> = llvm_const_int(ctx.i32_ty, 2, 0);
    if (msg_val != null) {
        let fmt <&LLVMValue> = llvm_build_global_string_ptr(ctx.builder, "%s:%d: assertion failed: %s\n", "blame_fmt");
        let args <&LLVMValueArgs> = new LLVMValueArgs{};
        args.v0 = fd_v;
        args.v1 = fmt;
        args.v2 = file_s;
        args.v3 = line_v;
        args.v4 = msg_val;
        llvm_build_call2(ctx.builder, d_ty, d_fn, args, 5, "");
        delete args;
    } else {
        let fmt <&LLVMValue> = llvm_build_global_string_ptr(ctx.builder, "%s:%d: assertion failed\n", "blame_fmt");
        let args <&LLVMValueArgs> = new LLVMValueArgs{};
        args.v0 = fd_v;
        args.v1 = fmt;
        args.v2 = file_s;
        args.v3 = line_v;
        llvm_build_call2(ctx.builder, d_ty, d_fn, args, 4, "");
        delete args;
    }
}

// A runtime blame naming a caller-supplied string: `file:line: Fin blames
// <msg>` on stderr, then the caller aborts. The text is a value lowering
// did not write, so it goes through `%s` rather than being the format
// string: text that reaches printf as a format is a vararg read waiting to
// happen the first time one of them contains a `%`.
fun cg_emit_absent_blame_val(ctx: &FnContext, line: int, msg_val: &LLVMValue) <noret> {
    if (ctx.src_file == null || cg_strlen(ctx.src_file) == cast<ulong>(0)) { return; }
    let d_fn <&LLVMValue> = get_or_declare_dprintf(ctx);
    let d_ty <&LLVMType> = llvm_global_get_value_type(d_fn);
    let file_s <&LLVMValue> = llvm_build_global_string_ptr(ctx.builder, ctx.src_file, "absent_file");
    let line_v <&LLVMValue> = llvm_const_int(ctx.i32_ty, line, 0);
    let fd_v <&LLVMValue> = llvm_const_int(ctx.i32_ty, 2, 0);
    let fmt <&LLVMValue> = llvm_build_global_string_ptr(ctx.builder, "%s:%d: Fin blames %s\n", "absent_fmt");
    let args <&LLVMValueArgs> = new LLVMValueArgs{};
    args.v0 = fd_v;
    args.v1 = fmt;
    args.v2 = file_s;
    args.v3 = line_v;
    args.v4 = msg_val;
    llvm_build_call2(ctx.builder, d_ty, d_fn, args, 5, "");
    delete args;
}

// A runtime blame with a fixed reason: `file:line: Fin blames <reason>` on
// stderr, then the caller aborts. Same empty-filename rule as blame. The
// reason is a compile-time constant baked to a string and printed through
// `%s` above.
fun cg_emit_absent_blame(ctx: &FnContext, line: int, reason: string) <noret> {
    if (ctx.src_file == null || cg_strlen(ctx.src_file) == cast<ulong>(0)) { return; }
    let why <&LLVMValue> = llvm_build_global_string_ptr(ctx.builder, reason, "absent_reason");
    cg_emit_absent_blame_val(ctx, line, why);
}

// A failed denullify prints `file:line: Fin blames denullify of an absent
// value` on stderr, then the caller aborts.
fun cg_emit_denull_blame(ctx: &FnContext, line: int) <noret> {
    cg_emit_absent_blame(ctx, line, "denullify of an absent value");
}

// Ordering on a nullable reads its payload, blaming if absent: the tag
// gates a fail edge that reports and aborts, and lowering continues with
// the payload on the ok edge (mirrors the C++ blameAbsent).
fun cg_order_payload(ctx: &FnContext, v: &LLVMValue, line: int) <&LLVMValue> {
    let fn_cur <&LLVMValue> = ctx.fn_val;
    let fail_bb <&LLVMBasicBlock> = llvm_append_basic_block(fn_cur, "ord.fail");
    let ok_bb <&LLVMBasicBlock> = llvm_append_basic_block(fn_cur, "ord.ok");
    let tag <&LLVMValue> = llvm_build_extract_value(ctx.builder, v, 1, "tag");
    let is_absent <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), tag, llvm_const_int(ctx.i1_ty, 0, 0), "absent");
    llvm_build_cond_br(ctx.builder, is_absent, fail_bb, ok_bb);
    llvm_position_builder(ctx.builder, fail_bb);
    cg_emit_absent_blame(ctx, line, "ordering of an absent value");
    let ab_fn <&LLVMValue> = get_or_declare_abort(ctx);
    let ab_ty <&LLVMType> = llvm_global_get_value_type(ab_fn);
    llvm_build_call2(ctx.builder, ab_ty, ab_fn, null, 0, "");
    llvm_build_unreachable(ctx.builder);
    llvm_position_builder(ctx.builder, ok_bb);
    return llvm_build_extract_value(ctx.builder, v, 0, "ord.pay");
}

// The raise form: `blame v;` where v is a struct or array value. Only the
// assert form lowers; a raise is an explicit refusal, never a silent pass.
fun cg_blame_is_raise(ctx: &FnContext, cond: &AstNode) <bool> {
    if (cond == null) { return false; }
    let t <string> = get_node_struct_name(ctx, cond);
    if (cg_strlen(t) == cast<ulong>(0)) { return false; }
    let total <int> = cast<int>(cg_strlen(t));
    let cut <int> = total;
    let i <int> = 0;
    while (i < total) {
        if (cg_str_eq(substr(t, i, 1), "<")) { cut = i; break; }
        i = i + 1;
    }
    let base <string> = substr(t, 0, cut);
    if (find_struct(ctx, base) != null) { return true; }
    if (get_fixed_array_extent(t) >= 0) { return true; }
    return false;
}

fun get_fixed_array_extent(type_ann: string) <int> {
    if (type_ann == null) { return -1; }
    let len <int> = cast<int>(cg_strlen(type_ann));
    if (len < 3) { return -1; }
    let comma_idx <int> = -1;
    let i <int> = 0;
    while (i < len) {
        let ch <string> = substr(type_ann, i, 1);
        if (cg_str_eq(ch, ",")) {
            comma_idx = i;
        }
        i = i + 1;
    }
    if (comma_idx < 0) { return -1; }

    let extent <int> = 0;
    let has_digits <bool> = false;
    let j <int> = comma_idx + 1;
    while (j < len) {
        let ch <string> = substr(type_ann, j, 1);
        if (!cg_str_eq(ch, " ") && !cg_str_eq(ch, "]") && !cg_str_eq(ch, ">")) {
            let d <int> = -1;
            if (cg_str_eq(ch, "0")) { d = 0; }
            else if (cg_str_eq(ch, "1")) { d = 1; }
            else if (cg_str_eq(ch, "2")) { d = 2; }
            else if (cg_str_eq(ch, "3")) { d = 3; }
            else if (cg_str_eq(ch, "4")) { d = 4; }
            else if (cg_str_eq(ch, "5")) { d = 5; }
            else if (cg_str_eq(ch, "6")) { d = 6; }
            else if (cg_str_eq(ch, "7")) { d = 7; }
            else if (cg_str_eq(ch, "8")) { d = 8; }
            else if (cg_str_eq(ch, "9")) { d = 9; }
            if (d >= 0) {
                extent = extent * 10 + d;
                has_digits = true;
            }
        }
        j = j + 1;
    }
    if (has_digits) {
        return extent;
    }
    return -1;
}

fun struct_has_field(ctx: &FnContext, base_node: &AstNode, field_name: string) <bool> {
    if (field_name == null || base_node == null) { return false; }
    if (base_node.kind == ast_ident()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, base_node.name);
        if (v != null && v.type_annotation != null) {
            let ty_ann <string> = v.type_annotation;
            let len <int> = cast<int>(cg_strlen(ty_ann));
            let s_name <string> = ty_ann;
            if (len > 1) {
                let first <string> = substr(ty_ann, 0, 1);
                if (cg_str_eq(first, "&") || cg_str_eq(first, "*")) {
                    s_name = substr(ty_ann, 1, len - 1);
                }
            }
            let si <int> = 0;
            while (si < ctx.struct_count) {
                let st <&StructInfo> = ctx.structs[si];
                if (st != null && cg_str_eq(st.name, s_name)) {
                    let fi <int> = 0;
                    while (fi < st.field_count) {
                        let f <&StructFieldInfo> = st.fields[fi];
                        if (f != null && cg_str_eq(f.name, field_name)) {
                            return true;
                        }
                        fi = fi + 1;
                    }
                }
                si = si + 1;
            }
        }
    }
    return false;
}

fun get_index_elem_type(ctx: &FnContext, base_node: &AstNode) <&LLVMType> {
    if (base_node == null) { return ctx.i32_ty; }
    let ty_ann <string> = "";
    if (base_node.kind == ast_ident()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, base_node.name);
        if (v != null) {
            if (v.elem_ty != null) {
                return v.elem_ty;
            }
            if (v.type_annotation != null) {
                ty_ann = v.type_annotation;
                // A `&[T]` parameter arrives erased to `void*` (see
                // is_ref_array_base): the element spelling is gone, so
                // stride by the int word. Every `&[]` shape in the corpus
                // and the pinned probes is int/uint; wider elements
                // through an erased reference need the parser to retain
                // the spelling, which is parser-side work.
                if (cg_str_eq(cg_trim_spaces(ty_ann), "void*")) {
                    return ctx.i32_ty;
                }
            }
        }
    } else if (base_node.kind == ast_member_access()) {
        let f_name <string> = base_node.name;
        // MC1: prefer the receiver's own instantiation (`self.arr` with
        // `self: &ArrBox<int>` reads `[int]`, not the template's `[T]`),
        // mirroring the C++ per-instantiation bindings. Falls back to the
        // global name search below when the receiver names no instantiation.
        let scoped <bool> = false;
        if (base_node.left != null && base_node.left.kind == ast_ident()) {
            let rv <&LocalVar> = fn_ctx_find_var(ctx, base_node.left.name);
            if (rv != null && rv.type_annotation != null) {
                let rfull <string> = cg_trim_spaces(rv.type_annotation);
                let rlen <int> = cast<int>(cg_strlen(rfull));
                while (rlen > 1 && (cg_str_eq(substr(rfull, 0, 1), "&") || cg_str_eq(substr(rfull, 0, 1), "*"))) {
                    rfull = substr(rfull, 1, rlen - 1);
                    rlen = cast<int>(cg_strlen(rfull));
                }
                while (rlen > 1 && cg_str_eq(substr(rfull, rlen - 1, 1), "*")) {
                    rfull = substr(rfull, 0, rlen - 1);
                    rlen = cast<int>(cg_strlen(rfull));
                }
                let ro_at <int> = -1;
                let rc_at <int> = -1;
                let rq <int> = 0;
                while (rq < rlen) {
                    if (cg_str_eq(substr(rfull, rq, 1), "<")) { ro_at = rq; break; }
                    rq = rq + 1;
                }
                if (ro_at > 0) {
                    rq = rlen - 1;
                    while (rq > ro_at) {
                        if (cg_str_eq(substr(rfull, rq, 1), ">")) { rc_at = rq; break; }
                        rq = rq - 1;
                    }
                }
                if (ro_at > 0 && rc_at > ro_at) {
                    let rbase <string> = cg_trim_spaces(substr(rfull, 0, ro_at));
                    let rinner <string> = substr(rfull, ro_at + 1, rc_at - ro_at - 1);
                    let rst <&StructInfo> = find_struct(ctx, rbase);
                    if (rst != null && rst.gen_params != null && cg_strlen(rst.gen_params) > cast<ulong>(0)) {
                        let rfi <int> = 0;
                        while (rfi < rst.field_count) {
                            let rf <&StructFieldInfo> = rst.fields[rfi];
                            if (rf != null && cg_str_eq(rf.name, f_name)) {
                                let rgp <[string]> = new [string, 64]{};
                                let rga <[string]> = new [string, 64]{};
                                let rpc <int> = cg_split_top(rst.gen_params, rgp, 64);
                                let rac <int> = cg_split_top(rinner, rga, 64);
                                if (rpc > 0 && rac == rpc) {
                                    ty_ann = cg_subst_params(rf.type_annotation, rgp, rga, rpc, rac);
                                } else {
                                    ty_ann = rf.type_annotation;
                                }
                                delete rgp;
                                delete rga;
                                scoped = true;
                                break;
                            }
                            rfi = rfi + 1;
                        }
                    }
                }
            }
        }
        if (!scoped) {
            let si <int> = 0;
            while (si < ctx.struct_count) {
                let st <&StructInfo> = ctx.structs[si];
                if (st != null) {
                    let fi <int> = 0;
                    while (fi < st.field_count) {
                        let f <&StructFieldInfo> = st.fields[fi];
                        if (f != null && cg_str_eq(f.name, f_name)) {
                            ty_ann = f.type_annotation;
                            break;
                        }
                        fi = fi + 1;
                    }
                }
                if (cg_strlen(ty_ann) > cast<ulong>(0)) {
                    break;
                }
                si = si + 1;
            }
        }
    } else if (base_node.kind == ast_call_expr() && cg_str_eq(base_node.name, "__fin_array_literal")) {
        return ctx.i32_ty;
    }

    if (ty_ann != null && cg_strlen(ty_ann) > cast<ulong>(0)) {
        if (cg_str_eq(ty_ann, "string") || cg_str_eq(ty_ann, "[char]") || cg_str_eq(ty_ann, "char*")) {
            return ctx.i8_ty;
        }
        let len <int> = cast<int>(cg_strlen(ty_ann));
        // A fixed array spells `[T, N]`: the element is before the
        // top-level comma, the extent after. The old code mapped the
        // extent (`4` in `[int, 4]`), so every fixed-array field strode
        // by pointer width; C++ strides by the element type instead.
        let c_pos <int> = -1;
        let depth <int> = 0;
        let ti <int> = 0;
        while (ti < len) {
            let ch <string> = substr(ty_ann, ti, 1);
            if (cg_str_eq(ch, "<")) {
                depth = depth + 1;
            } else if (cg_str_eq(ch, ">")) {
                depth = depth - 1;
            } else if (cg_str_eq(ch, ",") && depth == 0 && ti > 0) {
                c_pos = ti;
                break;
            }
            ti = ti + 1;
        }
        if (c_pos > 1) {
            let start <int> = 1;
            if (!cg_str_eq(substr(ty_ann, 0, 1), "[")) {
                start = 0;
            }
            let elem_t <string> = cg_trim_spaces(substr(ty_ann, start, c_pos - start));
            if (cg_strlen(elem_t) > cast<ulong>(0)) {
                return map_type(ctx, elem_t);
            }
        }
        // A field spelling keeps its reference (`value <&[int]>` on
        // `rptr<[int]>`): strip the `&[...]` shell and map the inner
        // element, so member-based indexing strides by the field's
        // element rather than by pointer width.
        if (len > 3 && cg_str_eq(substr(ty_ann, 0, 2), "&[") && cg_str_eq(substr(ty_ann, len - 1, 1), "]")) {
            let inner_t <string> = cg_trim_spaces(substr(ty_ann, 2, len - 3));
            if (cg_strlen(inner_t) > cast<ulong>(0)) {
                return map_type(ctx, inner_t);
            }
        }
        if (len > 5) {
            let first6 <string> = substr(ty_ann, 0, 6);
            if (cg_str_eq(first6, "[char,")) {
                return ctx.i8_ty;
            }
        }
        if (cg_str_eq(ty_ann, "[bool]") || cg_str_eq(ty_ann, "bool*")) {
            return ctx.i1_ty;
        }
        if (len > 5) {
            let first6 <string> = substr(ty_ann, 0, 6);
            if (cg_str_eq(first6, "[bool,")) {
                return ctx.i1_ty;
            }
        }
        if (cg_str_eq(ty_ann, "[u8]") || cg_str_eq(ty_ann, "u8*") || cg_str_eq(ty_ann, "[i8]") || cg_str_eq(ty_ann, "i8*") || cg_str_eq(ty_ann, "[int{8}]") || cg_str_eq(ty_ann, "[uint{8}]")) {
            return ctx.i8_ty;
        }
        if (cg_str_eq(ty_ann, "[short]") || cg_str_eq(ty_ann, "short*") || cg_str_eq(ty_ann, "[ushort]") || cg_str_eq(ty_ann, "ushort*") || cg_str_eq(ty_ann, "[i16]") || cg_str_eq(ty_ann, "i16*") || cg_str_eq(ty_ann, "[u16]") || cg_str_eq(ty_ann, "u16*") || cg_str_eq(ty_ann, "[int{16}]") || cg_str_eq(ty_ann, "[uint{16}]")) {
            return ctx.i16_ty;
        }
        if (cg_str_eq(ty_ann, "[int]") || cg_str_eq(ty_ann, "int*") || cg_str_eq(ty_ann, "[uint]") || cg_str_eq(ty_ann, "uint*") || cg_str_eq(ty_ann, "[i32]") || cg_str_eq(ty_ann, "i32*") || cg_str_eq(ty_ann, "[u32]") || cg_str_eq(ty_ann, "u32*") || cg_str_eq(ty_ann, "[int{32}]") || cg_str_eq(ty_ann, "[uint{32}]")) {
            return ctx.i32_ty;
        }
        if (len > 4) {
            let first5 <string> = substr(ty_ann, 0, 5);
            if (cg_str_eq(first5, "[int,")) {
                return ctx.i32_ty;
            }
        }
        let first_ch <string> = substr(ty_ann, 0, 1);
        let last_ch <string> = substr(ty_ann, len - 1, 1);
        if (cg_str_eq(first_ch, "[") || cg_str_eq(first_ch, "&") || cg_str_eq(last_ch, "*")) {
            return ctx.ptr_ty;
        }
    }
    return ctx.i32_ty;
}

// Heap array buffers carry their extent in the word before element 0.
// Most buffers stride by their declared element type, matching what the
// writer stored: literals build from their first element, `new` buffers
// are filled by C at byte width. One family breaks that agreement: a
// fixed array field of a generic struct (`items <[T, 3]>` in `Buf<T>`).
// A `char` literal parses as an int node, so the writer builds i32 while
// a `[char, N]` reader strides i8; an erased generic reader (`Buf<T>`,
// whose parameter spelling the parser folds to `void*`) strides
// pointer-wide while the concrete writer strode i32. Those two sides can
// never meet at the declared width, so generic-struct integer-kind array
// fields use 8-byte slots on both sides (loads narrow back on read).
// Everything else keeps its declared stride.
fun cg_member_array_wide(ctx: &FnContext, arr_base: &AstNode, elem_ty: &LLVMType) <bool> {
    if (ctx == null || arr_base == null || elem_ty == null) { return false; }
    if (elem_ty != ctx.i32_ty && elem_ty != ctx.i8_ty && elem_ty != ctx.i1_ty && elem_ty != ctx.ptr_ty) {
        return false;
    }
    if (arr_base.kind != ast_member_access()) { return false; }
    // The receiver's struct: an ident names its annotation (`Buf<char>`,
    // `void*` for an erased generic parameter); anything else stays on
    // the declared stride.
    if (arr_base.left == null || arr_base.left.kind != ast_ident()) { return false; }
    let rv <&LocalVar> = fn_ctx_find_var(ctx, arr_base.left.name);
    if (rv == null || rv.type_annotation == null) { return false; }
    let rfull <string> = cg_trim_spaces(rv.type_annotation);
    let rlen <int> = cast<int>(cg_strlen(rfull));
    while (rlen > 1 && (cg_str_eq(substr(rfull, 0, 1), "&") || cg_str_eq(substr(rfull, 0, 1), "*"))) {
        rfull = substr(rfull, 1, rlen - 1);
        rlen = cast<int>(cg_strlen(rfull));
    }
    while (rlen > 1 && cg_str_eq(substr(rfull, rlen - 1, 1), "*")) {
        rfull = substr(rfull, 0, rlen - 1);
        rlen = cast<int>(cg_strlen(rfull));
    }
    let rbase <string> = rfull;
    let ri <int> = 0;
    while (ri < rlen) {
        if (cg_str_eq(substr(rfull, ri, 1), "<")) {
            rbase = cg_trim_spaces(substr(rfull, 0, ri));
            break;
        }
        ri = ri + 1;
    }
    if (cg_strlen(rbase) == cast<ulong>(0) || cg_str_eq(rbase, "void")) {
        // An erased generic parameter (`void*`): the object is some
        // instantiation, whose writer used the wide rule below.
        return true;
    }
    let st <&StructInfo> = find_struct(ctx, rbase);
    if (st == null) { return false; }
    if (st.gen_params == null || cg_strlen(st.gen_params) == cast<ulong>(0)) { return false; }
    // A generic struct: wide exactly when the field's own element still
    // names a parameter (`[T, 3]`), mirroring what the writer does. A
    // concrete element (`[int, 3]` beside `<T>`) is built and read narrow.
    let fi <int> = 0;
    while (fi < st.field_count) {
        let f <&StructFieldInfo> = st.fields[fi];
        if (f != null && cg_str_eq(f.name, arr_base.name)) {
            return cg_ann_is_param_array(f.type_annotation);
        }
        fi = fi + 1;
    }
    return false;
}

// Whether a field annotation is a fixed array over a type parameter
// (`[T, 3]`, `[&T, N]`): the shapes whose writer cannot know its width
// from the spelling and takes the wide rule instead.
fun cg_ann_is_param_array(ann: string) <bool> {
    if (ann == null || cg_strlen(ann) == cast<ulong>(0)) { return false; }
    let t <string> = cg_trim_spaces(ann);
    let len <int> = cast<int>(cg_strlen(t));
    if (len < 5 || !cg_str_eq(substr(t, 0, 1), "[")) { return false; }
    let depth <int> = 0;
    let comma <int> = -1;
    let ti <int> = 0;
    while (ti < len) {
        let ch <string> = substr(t, ti, 1);
        if (cg_str_eq(ch, "<") || cg_str_eq(ch, "[")) { depth = depth + 1; }
        else if (cg_str_eq(ch, ">") || cg_str_eq(ch, "]")) { depth = depth - 1; }
        else if (cg_str_eq(ch, ",") && depth == 1) { comma = ti; break; }
        ti = ti + 1;
    }
    if (comma <= 1) { return false; }
    let elem <string> = cg_trim_spaces(substr(t, 1, comma - 1));
    if (cg_strlen(elem) == cast<ulong>(0)) { return false; }
    // A bare parameter, possibly behind `&`/`*`/`?`, names the family.
    // Concrete spellings (`int`, `char`, `[int]`) do not.
    let elen <int> = cast<int>(cg_strlen(elem));
    let s <int> = 0;
    while (s < elen && (cg_str_eq(substr(elem, s, 1), "&") || cg_str_eq(substr(elem, s, 1), "*"))) {
        s = s + 1;
    }
    let e <int> = elen;
    while (e > s && (cg_str_eq(substr(elem, e - 1, 1), "*") || cg_str_eq(substr(elem, e - 1, 1), "?"))) {
        e = e - 1;
    }
    if (e <= s) { return false; }
    let core <string> = substr(elem, s, e - s);
    if (cg_str_eq(core, "int") || cg_str_eq(core, "uint") || cg_str_eq(core, "bool") ||
      cg_str_eq(core, "char") || cg_str_eq(core, "u8") || cg_str_eq(core, "i8") ||
      cg_str_eq(core, "string") || cg_str_eq(core, "float") || cg_str_eq(core, "f32") ||
      cg_str_eq(core, "double") || cg_str_eq(core, "f64")) {
        return false;
      }
    if (cg_str_eq(substr(core, 0, 1), "[")) { return false; }
    return true;
}

// Sets the array-literal writer hint for one struct field value: when the
// field is a fixed array over a type parameter (`items <[T, 3]>`), the
// literal builds integer-kind and pointer slots wide, matching what
// cg_member_array_wide readers stride. Concrete fields leave the hint off
// (the writer builds from its elements as before). Callers save and
// restore the flag around the field lowering for nested literals.
fun cg_apply_array_field_hint(ctx: &FnContext, st_name: string, field_name: string, field_init: &AstNode) <noret> {
    if (ctx == null) { return; }
    ctx.arr_hint_auto = false;
    if (st_name == null || field_name == null || field_init == null) { return; }
    if (field_init.kind != ast_call_expr() || !cg_str_eq(field_init.name, "__fin_array_literal")) { return; }
    let base <string> = cg_trim_spaces(st_name);
    let blen <int> = cast<int>(cg_strlen(base));
    let bi <int> = 0;
    while (bi < blen) {
        if (cg_str_eq(substr(base, bi, 1), "<")) {
            base = cg_trim_spaces(substr(base, 0, bi));
            break;
        }
        bi = bi + 1;
    }
    if (cg_strlen(base) == cast<ulong>(0)) { return; }
    let si <int> = 0;
    while (si < ctx.struct_count) {
        let st <&StructInfo> = ctx.structs[si];
        if (st != null && cg_str_eq(st.name, base)) {
            let fi <int> = 0;
            while (fi < st.field_count) {
                let f <&StructFieldInfo> = st.fields[fi];
                if (f != null && cg_str_eq(f.name, field_name)) {
                    if (cg_ann_is_param_array(f.type_annotation)) {
                        ctx.arr_hint_auto = true;
                    }
                    return;
                }
                fi = fi + 1;
            }
            return;
        }
        si = si + 1;
    }
}

fun apply_compound_op(ctx: &FnContext, op: string, lhs: &LLVMValue, rhs: &LLVMValue) <&LLVMValue> {
    let l_ty <&LLVMType> = llvm_type_of(lhs);
    let r_ty <&LLVMType> = llvm_type_of(rhs);
    if (l_ty == ctx.float_ty || l_ty == ctx.double_ty || r_ty == ctx.float_ty || r_ty == ctx.double_ty) {
        let fp_ty <&LLVMType> = ctx.float_ty;
        if (l_ty == ctx.double_ty || r_ty == ctx.double_ty) {
            fp_ty = ctx.double_ty;
        }
        lhs = coerce_val(ctx, lhs, fp_ty);
        rhs = coerce_val(ctx, rhs, fp_ty);
        if (cg_str_eq(op, "+=")) { return llvm_build_fadd(ctx.builder, lhs, rhs, "add"); }
        if (cg_str_eq(op, "-=")) { return llvm_build_fsub(ctx.builder, lhs, rhs, "sub"); }
        if (cg_str_eq(op, "*=")) { return llvm_build_fmul(ctx.builder, lhs, rhs, "mul"); }
        if (cg_str_eq(op, "/=")) { return llvm_build_fdiv(ctx.builder, lhs, rhs, "div"); }
        if (cg_str_eq(op, "%=")) { return llvm_build_frem(ctx.builder, lhs, rhs, "rem"); }
        cg_dprintf(2, "finc codegen refusal: operator '%s' is not lowered for float operands\n", op);
        refuse_and_poison(ctx);
        llvm_build_unreachable(ctx.builder);
        return lhs;
    }
    if (l_ty != r_ty) {
        if (l_ty == ctx.i64_ty && r_ty == ctx.i32_ty) {
            rhs = llvm_build_sext(ctx.builder, rhs, ctx.i64_ty, "rhs_ext");
        } else if (l_ty == ctx.i32_ty && r_ty == ctx.i64_ty) {
            rhs = llvm_build_trunc(ctx.builder, rhs, ctx.i32_ty, "rhs_trunc");
        }
    }
    if (cg_str_eq(op, "+=")) { return llvm_build_add(ctx.builder, lhs, rhs, "add"); }
    if (cg_str_eq(op, "-=")) { return llvm_build_sub(ctx.builder, lhs, rhs, "sub"); }
    if (cg_str_eq(op, "*=")) { return llvm_build_mul(ctx.builder, lhs, rhs, "mul"); }
    if (cg_str_eq(op, "/=")) { return llvm_build_sdiv(ctx.builder, lhs, rhs, "div"); }
    if (cg_str_eq(op, "%=")) { return llvm_build_srem(ctx.builder, lhs, rhs, "rem"); }
    if (cg_str_eq(op, "&=")) { return llvm_build_and(ctx.builder, lhs, rhs, "and"); }
    if (cg_str_eq(op, "|=")) { return llvm_build_or(ctx.builder, lhs, rhs, "or"); }
    if (cg_str_eq(op, "^=")) { return llvm_build_xor(ctx.builder, lhs, rhs, "xor"); }
    if (cg_str_eq(op, "<<=")) { return llvm_build_shl(ctx.builder, lhs, rhs, "shl"); }
    if (cg_str_eq(op, ">>=")) { return llvm_build_ashr(ctx.builder, lhs, rhs, "shr"); }
    return lhs;
}

fun unescape_string_literal(raw: string) <string> {
    if (raw == null) { return ""; }
    let len <int> = cast<int>(cg_strlen(raw));
    if (len < 2) { return raw; }

    let start <int> = 0;
    let end_pos <int> = len;
    let first_ch <string> = substr(raw, 0, 1);
    let last_ch <string> = substr(raw, len - 1, 1);
    if (cg_str_eq(first_ch, "\"") && cg_str_eq(last_ch, "\"")) {
        start = 1;
        end_pos = len - 1;
    }

    let b <Buffer> = new_buffer(len + 1);
    let i <int> = start;
    while (i < end_pos) {
        let ch <string> = substr(raw, i, 1);
        if (cg_str_eq(ch, "\\") && i + 1 < end_pos) {
            let next_ch <string> = substr(raw, i + 1, 1);
            if (cg_str_eq(next_ch, "n")) { b.write_char('\n'); i = i + 2; continue; }
            if (cg_str_eq(next_ch, "r")) { b.write_char('\r'); i = i + 2; continue; }
            if (cg_str_eq(next_ch, "t")) { b.write_char('\t'); i = i + 2; continue; }
            if (cg_str_eq(next_ch, "0")) { b.write_char(cast<char>(0)); i = i + 2; continue; }
            if (cg_str_eq(next_ch, "\"")) { b.write_char('\"'); i = i + 2; continue; }
            if (cg_str_eq(next_ch, "\\")) { b.write_char('\\'); i = i + 2; continue; }
        }
        b.write_string(ch);
        i = i + 1;
    }
    let res <string> = b.to_string();
    free_buffer(b);
    return res;
}

// Resolves a `sizeof(T)` spelling to the LLVM type whose size LLVM itself
// reports. Structs rebuild their value layout from field types (heap structs
// lower as pointers, but sizeof asks for the laid-out size). Returns null
// for anything unresolvable: the caller refuses rather than guesses.
fun sizeof_of_spelling(ctx: &FnContext, tname: string) <&LLVMType> {
    if (tname == null || cg_strlen(tname) == cast<ulong>(0)) { return null; }
    let st <&StructInfo> = find_struct(ctx, tname);
    if (st != null) {
        if (st.field_count <= 0 || st.field_count > 16) { return null; }
        let s_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
        let fi <int> = 0;
        while (fi < st.field_count) {
            let f <&StructFieldInfo> = st.fields[fi];
            let ft <&LLVMType> = ctx.i32_ty;
            if (f != null) { ft = map_type(ctx, f.type_annotation); }
            cg_targs_set(s_args, fi, ft);
            fi = fi + 1;
        }
        let s_ty <&LLVMType> = llvm_struct_type(s_args, st.field_count, 0);
        delete s_args;
        return s_ty;
    }
    let en <&EnumInfo> = find_enum(ctx, tname);
    if (en != null) { return en.llvm_type; }
    let iface <&InterfaceInfo> = find_interface(ctx, tname);
    if (iface != null) {
        if (iface.fat_ptr_ty != null) { return iface.fat_ptr_ty; }
        return ctx.fat_ptr_ty;
    }
    if (cg_str_eq(tname, "int") || cg_str_eq(tname, "uint") || cg_str_eq(tname, "auto")) { return ctx.i32_ty; }
    if (cg_str_eq(tname, "bool")) { return ctx.i1_ty; }
    if (cg_str_eq(tname, "char") || cg_str_eq(tname, "u8") || cg_str_eq(tname, "i8") || cg_str_eq(tname, "int{8}") || cg_str_eq(tname, "uint{8}")) { return ctx.i8_ty; }
    if (cg_str_eq(tname, "short") || cg_str_eq(tname, "ushort") || cg_str_eq(tname, "i16") || cg_str_eq(tname, "u16") || cg_str_eq(tname, "int{16}") || cg_str_eq(tname, "uint{16}")) { return ctx.i16_ty; }
    if (cg_str_eq(tname, "int{32}") || cg_str_eq(tname, "uint{32}") || cg_str_eq(tname, "i32") || cg_str_eq(tname, "u32")) { return ctx.i32_ty; }
    if (cg_str_eq(tname, "float") || cg_str_eq(tname, "f32")) { return ctx.float_ty; }
    if (cg_str_eq(tname, "double") || cg_str_eq(tname, "f64")) { return ctx.double_ty; }
    if (cg_str_eq(tname, "long") || cg_str_eq(tname, "ulong") || cg_str_eq(tname, "i64") || cg_str_eq(tname, "u64") ||
      cg_str_eq(tname, "size_t") || cg_str_eq(tname, "usize") || cg_str_eq(tname, "isize") ||
      cg_str_eq(tname, "uint64") || cg_str_eq(tname, "int64") ||
      cg_str_eq(tname, "uint{64}") || cg_str_eq(tname, "int{64}")) { return ctx.i64_ty; }
    if (cg_str_eq(tname, "string")) { return ctx.ptr_ty; }
    let tlen <int> = cast<int>(cg_strlen(tname));
    if (tlen > 0) {
        let first <string> = substr(tname, 0, 1);
        let last <string> = substr(tname, tlen - 1, 1);
        if (cg_str_eq(first, "&") || cg_str_eq(first, "[") || cg_str_eq(last, "*") || cg_str_eq(last, "?")) {
            return ctx.ptr_ty;
        }
    }
    return null;
}

// The static spelling behind a `==`/`!=` operand: the checker's own
// annotation when the node carries one, else the declaration the node names
// (a local for an ident; the field of the resolved base struct for a member
// access; the element for an index into an array spelling). "" when nothing
// answers: those operands keep today's lowering rather than guessing.
fun cg_eq_operand_ann(ctx: &FnContext, node: &AstNode) <string> {
    if (node == null) { return ""; }
    // ENGA slice 3: prefer the checker's resolved spelling where recorded.
    if (node.resolved_spelling != null && cg_strlen(node.resolved_spelling) > cast<ulong>(0)) {
        return node.resolved_spelling;
    }
    if (node.type_annotation != null && cg_strlen(node.type_annotation) > cast<ulong>(0)) {
        return node.type_annotation;
    }
    if (node.kind == ast_ident()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, node.name);
        if (v != null && v.type_annotation != null) { return v.type_annotation; }
        return "";
    }
    if (node.kind == ast_member_access()) {
        let b_ann <string> = cg_eq_operand_ann(ctx, node.left);
        let b_len <int> = cast<int>(cg_strlen(b_ann));
        if (b_len == 0) { return ""; }
        let b_base <string> = b_ann;
        let bi <int> = 0;
        while (bi < b_len) {
            if (cg_str_eq(substr(b_ann, bi, 1), "<")) {
                b_base = substr(b_ann, 0, bi);
                break;
            }
            bi = bi + 1;
        }
        // Resolve the base to a struct name, stripping one reference
        // level on either side (`&Self`, `Box*` -- the parser's injected
        // receiver spelling -- `&Box`). A bare `Self` names no struct
        // and falls back to a global field search, mirroring
        // find_field_index: the erased body of a generic struct names
        // its receiver `Self`, so without this every member spelling
        // there is "".
        let b_unref <string> = b_base;
        let blen <int> = cast<int>(cg_strlen(b_unref));
        if (blen > 1 && (cg_str_eq(substr(b_unref, 0, 1), "&") || cg_str_eq(substr(b_unref, 0, 1), "*"))) {
            b_unref = substr(b_unref, 1, blen - 1);
            blen = cast<int>(cg_strlen(b_unref));
        }
        if (blen > 1 && cg_str_eq(substr(b_unref, blen - 1, 1), "*")) {
            b_unref = substr(b_unref, 0, blen - 1);
        }
        if (cg_str_eq(b_unref, "Self")) {
            let si0 <int> = 0;
            while (si0 < ctx.struct_count) {
                let gst0 <&StructInfo> = ctx.structs[si0];
                if (gst0 != null) {
                    let gfi0 <int> = 0;
                    while (gfi0 < gst0.field_count) {
                        let gf0 <&StructFieldInfo> = gst0.fields[gfi0];
                        if (gf0 != null && cg_str_eq(gf0.name, node.name)) {
                            return gf0.type_annotation;
                        }
                        gfi0 = gfi0 + 1;
                    }
                }
                si0 = si0 + 1;
            }
            return "";
        }
        let st <&StructInfo> = find_struct(ctx, b_unref);
        if (st == null) {
            return "";
        }
        let fi <int> = 0;
        while (fi < st.field_count) {
            let f <&StructFieldInfo> = st.fields[fi];
            if (f != null && cg_str_eq(f.name, node.name)) { return f.type_annotation; }
            fi = fi + 1;
        }
        return "";
    }
    if (node.kind == ast_index_expr()) {
        let a_ann <string> = cg_eq_operand_ann(ctx, node.left);
        let a_len <int> = cast<int>(cg_strlen(a_ann));
        if (a_len > 2 && cg_str_eq(substr(a_ann, 0, 1), "[") && cg_str_eq(substr(a_ann, a_len - 1, 1), "]")) {
            return substr(a_ann, 1, a_len - 2);
        }
        return "";
    }
    return "";
}

// ADR 0037 member-denoting call (`Ok(T)` in `r == Ok(T)`): a one-argument
// call naming an enum member whose single ident argument spells the
// member's declared payload type -- disambiguation, not a value. Answers
// the member tag, or -1 when the shape is anything else (a value argument,
// more arguments, a value in scope under that name, a member without
// payload). Callers compare the tag; construction keeps the em_call path.
fun cg_enum_member_probe_tag(ctx: &FnContext, node: &AstNode) <int> {
    if (ctx == null || node == null) { return -1; }
    if (node.kind != ast_call_expr()) { return -1; }
    if (node.left == null) { return -1; }
    let arg <&AstNode> = node.left.left;
    if (arg == null) { arg = node.left; }
    else if (node.left.right != null) { return -1; }
    if (arg.kind != ast_ident()) { return -1; }
    if (arg.name == null) { return -1; }
    // A value in scope under that name is a payload, not a type.
    if (fn_ctx_find_var(ctx, arg.name) != null) { return -1; }
    if (llvm_get_named_global(ctx.module, arg.name) != null) { return -1; }
    if (fn_ctx_find_fn(ctx, arg.name) != null) { return -1; }
    if (llvm_get_named_function(ctx.module, arg.name) != null) { return -1; }
    let em <&EnumMemberInfo> = find_enum_member_global(ctx, node.name);
    if (em == null || !em.has_payload) { return -1; }
    if (em.payload_type == null) { return -1; }
    if (!cg_str_eq(cg_trim_spaces(em.payload_type), arg.name)) { return -1; }
    return em.tag;
}

// Whether an annotation spells an enum: the name itself or a generic
// application of an enum base (`Res`, `Res<int>`, `Res<T>`). Reference and
// array marks strip first; anything else answers false.
fun cg_ann_names_enum(ctx: &FnContext, ann: string) <bool> {
    if (ctx == null || ann == null) { return false; }
    let t <string> = cg_trim_spaces(cg_strip_markers(cg_trim_spaces(ann)));
    if (cg_strlen(t) == cast<ulong>(0)) { return false; }
    if (find_enum(ctx, t) != null) { return true; }
    let len <int> = cast<int>(cg_strlen(t));
    let i <int> = 0;
    while (i < len) {
        if (cg_str_eq(substr(t, i, 1), "<")) {
            let base <string> = cg_trim_spaces(substr(t, 0, i));
            if (cg_strlen(base) > cast<ulong>(0) && find_enum(ctx, base) != null) { return true; }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// Read the discriminant off an enum-member comparison operand: a probe is
// already a tag; an enum struct extracts index 0; a fieldless tag is the
// value itself; an erased (generic-body) address loads the first word,
// which is the tag in every enum layout. Anything else refuses naming the
// comparison rather than comparing across kinds.
fun cg_enum_cmp_tag(ctx: &FnContext, node: &AstNode, v: &LLVMValue, is_probe: bool) <&LLVMValue> {
    if (v == null) { return null; }
    if (is_probe) { return v; }
    let vt <&LLVMType> = llvm_type_of(v);
    let en <&EnumInfo> = find_enum_by_llvm_type(ctx, vt);
    if (en != null) {
        return llvm_build_extract_value(ctx.builder, v, 0, "etag");
    }
    if (vt == ctx.i32_ty) { return v; }
    if (vt == ctx.ptr_ty && cg_ann_names_enum(ctx, cg_eq_operand_ann(ctx, node))) {
        let i32p <&LLVMValue> = llvm_build_bitcast(ctx.builder, v, llvm_pointer_type(ctx.i32_ty, 0), "etag_p");
        return llvm_build_load2(ctx.builder, ctx.i32_ty, i32p, "etag");
    }
    cg_dprintf(2, "finc codegen refusal: an enum-member comparison with a value of unlowerable type is not lowered (discriminant comparison needs an enum value beside the member) at '%s':%d\n", ctx.src_file, node.line);
    refuse_and_poison(ctx);
    llvm_build_unreachable(ctx.builder);
    return null;
}

// Strict discriminant read for the value/value arm: structs extract,
// fieldless tags pass through, anything else (erased addresses included)
// refuses. Only the member probe above may read through an address.
fun cg_enum_cmp_tag_strict(ctx: &FnContext, v: &LLVMValue) <&LLVMValue> {
    if (v == null) { return null; }
    let vt <&LLVMType> = llvm_type_of(v);
    if (find_enum_by_llvm_type(ctx, vt) != null) {
        return llvm_build_extract_value(ctx.builder, v, 0, "etag");
    }
    if (vt == ctx.i32_ty) { return v; }
    cg_dprintf(2, "finc codegen refusal: an enum comparison with a value of unlowerable type is not lowered (discriminant comparison needs enum values) at '%s'\n", ctx.src_file);
    refuse_and_poison(ctx);
    llvm_build_unreachable(ctx.builder);
    return null;
}

// ADR 0036: whether a `==`/`!=` operand spelling is a struct value with no
// declared operator to match (`==` needs `has_eq`; `!=` takes `has_ne` or the
// `==` it negates, like the C++ backend's declared-only contract). Answers
// the spelling to name in the refusal, or "" when lowering may proceed:
// scalars, strings, pointers (`&P`, `P*`), nullables (`P?`), arrays, and
// structs with a declared operator all keep today's lowering. Mirrors C++
// `an undeclared operator '==' on struct 'Data'`.
fun cg_eq_struct_name(ctx: &FnContext, spelling: string, want_ne: bool) <string> {
    if (spelling == null || cg_strlen(spelling) == cast<ulong>(0)) { return ""; }
    let len <int> = cast<int>(cg_strlen(spelling));
    let first <string> = substr(spelling, 0, 1);
    if (cg_str_eq(first, "&") || cg_str_eq(first, "*") || cg_str_eq(first, "[")) { return ""; }
    let last <string> = substr(spelling, len - 1, 1);
    if (cg_str_eq(last, "*") || cg_str_eq(last, "?")) { return ""; }
    let base <string> = spelling;
    let bi <int> = 0;
    while (bi < len) {
        if (cg_str_eq(substr(spelling, bi, 1), "<")) {
            base = substr(spelling, 0, bi);
            break;
        }
        bi = bi + 1;
    }
    if (cg_strlen(base) == cast<ulong>(0)) { return ""; }
    let st <&StructInfo> = find_struct(ctx, base);
    if (st == null) { return ""; }
    if (!want_ne && st.has_eq) { return ""; }
    if (want_ne && (st.has_ne || st.has_eq)) { return ""; }
    return spelling;
}

// Whether an operand spelling is a one-word `string`: the bare spelling or
// the nullable `string?` spelling, which stays one word (absent is the null
// word), so the same content lowering with its null guard applies. Anything
// else (`&string`, arrays, generics) keeps its existing lowering.
fun cg_ann_is_string(ann: string) <bool> {
    if (ann == null) { return false; }
    let t <string> = cg_trim_spaces(ann);
    if (cg_str_eq(t, "string")) { return true; }
    return cg_str_eq(t, "string?");
}

// Whether an `==`/`!=` operand is known to be a one-word `string`: a string
// literal, or an operand whose spelling is the bare `string` annotation or
// the nullable `string?` spelling (idents, members, index results,
// `cast<string>`). Calls and other
// computed shapes carry no spelling and answer false here; the checker
// rejects `==` across mismatched types, so a known string beside an
// unknown-typed operand still implies a string pair at runtime.
fun cg_operand_is_string(ctx: &FnContext, node: &AstNode) <bool> {
    if (node == null) { return false; }
    if (node.kind == ast_literal_string()) { return true; }
    return cg_ann_is_string(cg_eq_operand_ann(ctx, node));
}

// Content equality for two `string` words: true iff same length AND
// byte-equal over the full bytes (memcmp semantics; lengths, not
// NUL-termination). Either side null falls back to pointer equality
// (both null is true, one null is false), so a null beside a string
// never reaches strlen. `want_ne` negates for `!=`.
fun cg_lower_string_eq(ctx: &FnContext, lhs: &LLVMValue, rhs: &LLVMValue, want_ne: bool) <&LLVMValue> {
    let nullv <&LLVMValue> = llvm_const_null(ctx.ptr_ty);
    let l_null <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), lhs, nullv, "str.null.l");
    let r_null <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), rhs, nullv, "str.null.r");
    let either_null <&LLVMValue> = llvm_build_or(ctx.builder, l_null, r_null, "str.either.null");
    let null_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "streq.null");
    let content_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "streq.content");
    let end_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "streq.end");
    llvm_build_cond_br(ctx.builder, either_null, null_bb, content_bb);
    llvm_position_builder(ctx.builder, null_bb);
    let ptr_res <&LLVMValue> = null;
    if (want_ne) {
        ptr_res = llvm_build_icmp(ctx.builder, llvm_int_ne(), lhs, rhs, "str.ptr.ne");
    } else {
        ptr_res = llvm_build_icmp(ctx.builder, llvm_int_eq(), lhs, rhs, "str.ptr.eq");
    }
    let null_exit <&LLVMBasicBlock> = llvm_get_insert_block(ctx.builder);
    llvm_build_br(ctx.builder, end_bb);
    llvm_position_builder(ctx.builder, content_bb);
    let strlen_fn <&LLVMValue> = get_or_declare_strlen(ctx);
    let strlen_ty <&LLVMType> = llvm_global_get_value_type(strlen_fn);
    let llen_args <&LLVMValueArgs> = new LLVMValueArgs{};
    llen_args.v0 = lhs;
    let llen <&LLVMValue> = llvm_build_call2(ctx.builder, strlen_ty, strlen_fn, llen_args, 1, "str.llen");
    delete llen_args;
    let rlen_args <&LLVMValueArgs> = new LLVMValueArgs{};
    rlen_args.v0 = rhs;
    let rlen <&LLVMValue> = llvm_build_call2(ctx.builder, strlen_ty, strlen_fn, rlen_args, 1, "str.rlen");
    delete rlen_args;
    let memcmp_fn <&LLVMValue> = get_or_declare_memcmp(ctx);
    let memcmp_ty <&LLVMType> = llvm_global_get_value_type(memcmp_fn);
    let cmp_args <&LLVMValueArgs> = new LLVMValueArgs{};
    cmp_args.v0 = lhs;
    cmp_args.v1 = rhs;
    cmp_args.v2 = llen;
    let cmp <&LLVMValue> = llvm_build_call2(ctx.builder, memcmp_ty, memcmp_fn, cmp_args, 3, "str.cmp");
    delete cmp_args;
    let zero32 <&LLVMValue> = llvm_const_int(ctx.i32_ty, 0, 0);
    let content_res <&LLVMValue> = null;
    if (want_ne) {
        let lens_ne <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_ne(), llen, rlen, "str.lens.ne");
        let bytes_ne <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_ne(), cmp, zero32, "str.bytes.ne");
        content_res = llvm_build_or(ctx.builder, lens_ne, bytes_ne, "str.content.ne");
    } else {
        let lens_eq <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), llen, rlen, "str.lens.eq");
        let bytes_eq <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), cmp, zero32, "str.bytes.eq");
        content_res = llvm_build_and(ctx.builder, lens_eq, bytes_eq, "str.content.eq");
    }
    let content_exit <&LLVMBasicBlock> = llvm_get_insert_block(ctx.builder);
    llvm_build_br(ctx.builder, end_bb);
    llvm_position_builder(ctx.builder, end_bb);
    let phi <&LLVMValue> = llvm_build_phi(ctx.builder, ctx.i1_ty, "str.eq");
    let phi_vals <&LLVMValueArgs> = new LLVMValueArgs{};
    phi_vals.v0 = ptr_res;
    phi_vals.v1 = content_res;
    let phi_blks <&LLVMBlockArgs> = new LLVMBlockArgs{};
    phi_blks.b0 = null_exit;
    phi_blks.b1 = content_exit;
    llvm_add_incoming(phi, phi_vals, phi_blks, 2);
    delete phi_vals;
    delete phi_blks;
    return phi;
}

// Whether a declaration is the `hash_word` leaf: a bodiless generic
// `hash_word` (lib/std/hashmap.fin), lowered per concrete `T` by the
// backend on the footing of `keyidof`/`getkeyid` (a definition wins;
// otherwise no symbol is emitted and none is needed). A non-generic
// extern of the same name is an ordinary call and never counts here.
fun cg_decl_is_hash_word_leaf(decl: &AstNode) <bool> {
    if (decl == null || decl.kind != ast_fun_decl()) { return false; }
    if (decl.name == null || !cg_str_eq(decl.name, "hash_word")) { return false; }
    if (!is_generic_method(decl)) { return false; }
    if (decl.left != null) { return false; }
    return true;
}

// Whether a call resolves to the leaf (a definition wins and falls
// through to the normal path).
fun cg_hash_word_is_leaf(ctx: &FnContext, name: string) <bool> {
    if (name == null || !cg_str_eq(name, "hash_word")) { return false; }
    let sym <&FnSymbol> = fn_ctx_find_fn(ctx, name);
    if (sym == null || sym.tmpl == null) { return false; }
    let tmpl <&AstNode> = sym.tmpl;
    if (tmpl.left != null) { return false; }
    if (!is_generic_method(tmpl)) { return false; }
    return true;
}

// FNV-1a over the `strlen` bytes, 32-bit wrap: offset basis 2166136261,
// prime 16777619. The empty string hashes as the basis. Same constants
// both compilers implement, so both partition string keys identically
// (ADR 0049). Takes the already-lowered string word; lowering the
// argument stays at the call site (this helper predates `lower_expr`,
// which cannot be called forward).
fun cg_hash_word_string(ctx: &FnContext, data: &LLVMValue) <&LLVMValue> {
    if (ctx.fn_val == null || data == null) { return null; }
    let strlen_fn <&LLVMValue> = get_or_declare_strlen(ctx);
    let strlen_ty <&LLVMType> = llvm_global_get_value_type(strlen_fn);
    let len_args <&LLVMValueArgs> = new LLVMValueArgs{};
    len_args.v0 = data;
    let len <&LLVMValue> = llvm_build_call2(ctx.builder, strlen_ty, strlen_fn, len_args, 1, "hash.len");
    delete len_args;
    let h_slot <&LLVMValue> = llvm_build_alloca(ctx.builder, ctx.i32_ty, "hash.h");
    let i_slot <&LLVMValue> = llvm_build_alloca(ctx.builder, ctx.i64_ty, "hash.i");
    llvm_build_store(ctx.builder, llvm_const_int_of_string(ctx.i32_ty, "2166136261", 10), h_slot);
    llvm_build_store(ctx.builder, llvm_const_int(ctx.i64_ty, 0, 0), i_slot);
    let cond_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "hash.loop");
    let body_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "hash.body");
    let end_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "hash.end");
    llvm_build_br(ctx.builder, cond_bb);
    llvm_position_builder(ctx.builder, cond_bb);
    let at <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, i_slot, "hash.i");
    let more <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_ult(), at, len, "hash.more");
    llvm_build_cond_br(ctx.builder, more, body_bb, end_bb);
    llvm_position_builder(ctx.builder, body_bb);
    let i <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, i_slot, "hash.i");
    let ind <&LLVMIndices> = new LLVMIndices{};
    ind.i0 = i;
    let byte_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i8_ty, data, ind, 1, "hash.byte");
    delete ind;
    let byte <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i8_ty, byte_ptr, "hash.b");
    let h <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i32_ty, h_slot, "hash.h");
    let zb <&LLVMValue> = llvm_build_zext(ctx.builder, byte, ctx.i32_ty, "hash.z");
    let mixed <&LLVMValue> = llvm_build_xor(ctx.builder, h, zb, "hash.xor");
    let prime <&LLVMValue> = llvm_const_int(ctx.i32_ty, 16777619, 0);
    llvm_build_store(ctx.builder, llvm_build_mul(ctx.builder, mixed, prime, "hash.mul"), h_slot);
    llvm_build_store(ctx.builder, llvm_build_add(ctx.builder, i, llvm_const_int(ctx.i64_ty, 1, 0), "hash.next"), i_slot);
    llvm_build_br(ctx.builder, cond_bb);
    llvm_position_builder(ctx.builder, end_bb);
    return llvm_build_load2(ctx.builder, ctx.i32_ty, h_slot, "hash.result");
}

// MC1 ordering: declare_function and the method-cache helpers sit before
// lower_expr because their signatures name imported types (&AstNode/
// &LLVMModule), which the C++ checker does not hoist: a forward call from
// lower_expr would report `Undefined function`. Pure move, no logic change.

pub fun declare_function(
  module: &LLVMModule,
  fn_node: &AstNode,
  fn_syms: [&FnSymbol],
  sym_count: int,
  interfaces: [&InterfaceInfo],
  interface_count: int
) <int> {
    if (fn_node == null) { return sym_count; }

    let fn_name <string> = fn_node.name;
    let is_extern <bool> = (fn_node.left == null);
    let llvm_sym <string> = fn_name;

    if (is_extern && fn_node.attr_text != null && cg_strlen(fn_node.attr_text) > 0) {
        llvm_sym = cg_extern_sym(fn_name, fn_node.attr_text);
    }

    let i32_t <&LLVMType> = llvm_i32_type();
    let i64_t <&LLVMType> = llvm_i64_type();
    let i1_t <&LLVMType> = llvm_i1_type();
    let void_t <&LLVMType> = llvm_void_type();
    let ptr_t <&LLVMType> = llvm_pointer_type(llvm_i8_type(), 0);

    let ret_ty <&LLVMType> = i32_t;
    let i8_t <&LLVMType> = llvm_i8_type();
    let i16_t <&LLVMType> = llvm_i16_type();

    // A `?` on the return spelling (`<int?>`) rides in the annotation; a
    // `fun?` carries it in int_val. Either way the base maps first and the
    // pair wraps after, so pointer-shaped returns keep one word.
    let ret_qmark <bool> = is_nullable_type(fn_node.type_annotation);
    let ret_ann <string> = fn_node.type_annotation;
    if (ret_qmark) {
        let rlen <int> = cast<int>(cg_strlen(ret_ann));
        ret_ann = substr(ret_ann, 0, rlen - 1);
    }

    let is_iface_ret <bool> = false;
    let ret_iface <&InterfaceInfo> = null;
    let ii_r <int> = 0;
    while (ii_r < interface_count) {
        if (interfaces[ii_r] != null && cg_str_eq(interfaces[ii_r].name, ret_ann)) {
            is_iface_ret = true;
            ret_iface = interfaces[ii_r];
            break;
        }
        ii_r = ii_r + 1;
    }

    let is_main_args_decl <bool> = false;
    if (cg_str_eq(fn_name, "main")) {
        ret_ty = i32_t;
        // The designed argv surface is `main()` and `main(args: [string])`
        // only. Anything else is a C-shape accident, left undeclared here so
        // lower_fun_decl refuses it with a named diagnostic (backend
        // invariant: never silently drop runtime code or emit guessed IR).
        let ret_ok <bool> = false;
        if (cg_str_eq(fn_node.type_annotation, "void") || cg_str_eq(fn_node.type_annotation, "noret") ||
          cg_str_eq(fn_node.type_annotation, "int") || cg_str_eq(fn_node.type_annotation, "uint")) {
            ret_ok = true;
          }
        if (!ret_ok) {
            return sym_count;
        }
        let m_count <int> = 0;
        let m_cur <&AstNode> = fn_node.extra;
        let m_has_vararg <bool> = false;
        while (m_cur != null) {
            if (cg_str_eq(m_cur.name, "...") || cg_str_eq(m_cur.type_annotation, "...")) {
                m_has_vararg = true;
                break;
            }
            m_count = m_count + 1;
            m_cur = m_cur.right;
        }
        if (m_has_vararg || m_count > 1) {
            return sym_count;
        }
        if (m_count == 1) {
            let mp <&AstNode> = fn_node.extra;
            if (!cg_str_eq(mp.type_annotation, "[string]")) {
                return sym_count;
            }
            // Good `main(args: [string])`: declared below as C `(i32, ptr)`,
            // mirroring the C++ backend (CodeGen_LLVM.cpp declareFunction).
            is_main_args_decl = true;
        }
    } else if (is_iface_ret) {
        // The interface's own fat type: identical by identity to what map_type
        // and struct_to_interface produce, so values flow without coercion.
        if (ret_iface != null && ret_iface.fat_ptr_ty != null) {
            ret_ty = ret_iface.fat_ptr_ty;
        } else {
            let f_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
            f_args.t0 = ptr_t;
            f_args.t1 = ptr_t;
            ret_ty = llvm_struct_type(f_args, 2, 0);
            delete f_args;
        }
    } else if (cg_str_eq(ret_ann, "void") || cg_str_eq(ret_ann, "noret")) {
        ret_ty = void_t;
    } else if (cg_str_eq(ret_ann, "bool")) {
        ret_ty = i1_t;
    } else if (cg_str_eq(ret_ann, "$struct") || cg_str_eq(ret_ann, "$interface") ||
      cg_str_eq(ret_ann, "$type") || cg_str_eq(ret_ann, "$enum_member")) {
        ret_ty = i64_t;
      } else if (cg_str_eq(ret_ann, "char") || cg_str_eq(ret_ann, "u8") || cg_str_eq(ret_ann, "i8")) {
        ret_ty = i8_t;
      } else if (cg_str_eq(ret_ann, "short") || cg_str_eq(ret_ann, "ushort") ||
      cg_str_eq(ret_ann, "i16") || cg_str_eq(ret_ann, "u16")) {
        ret_ty = i16_t;
      } else if (cg_str_eq(ret_ann, "int{8}") || cg_str_eq(ret_ann, "uint{8}")) {
        ret_ty = i8_t;
      } else if (cg_str_eq(ret_ann, "int{16}") || cg_str_eq(ret_ann, "uint{16}")) {
        ret_ty = i16_t;
      } else if (cg_str_eq(ret_ann, "int{32}") || cg_str_eq(ret_ann, "uint{32}")) {
        ret_ty = i32_t;
      } else if (cg_str_eq(ret_ann, "string")) {
        ret_ty = ptr_t;
      } else if (cg_str_eq(ret_ann, "float") || cg_str_eq(ret_ann, "f32")) {
        ret_ty = llvm_float_type();
      } else if (cg_str_eq(ret_ann, "double") || cg_str_eq(ret_ann, "f64")) {
        ret_ty = llvm_double_type();
      } else if (cg_str_eq(ret_ann, "ulong") || cg_str_eq(ret_ann, "long") || cg_str_eq(ret_ann, "i64") || cg_str_eq(ret_ann, "u64") ||
      cg_str_eq(ret_ann, "size_t") || cg_str_eq(ret_ann, "usize") || cg_str_eq(ret_ann, "isize") ||
      cg_str_eq(ret_ann, "uint{64}") || cg_str_eq(ret_ann, "int{64}")) {
        ret_ty = i64_t;
      } else if (cg_str_eq(ret_ann, "int") || cg_str_eq(ret_ann, "uint") ||
      cg_str_eq(ret_ann, "i32") || cg_str_eq(ret_ann, "u32")) {
        ret_ty = i32_t;
      } else {
        ret_ty = ptr_t;
      }
    // A nullable scalar return lowers as the tagged pair `{T, i1}`; a
    // nullable pointer, string, interface or struct stays one word (absent
    // is the null word). `string?` is 8 bytes either way.
    if ((ret_qmark || fn_node.int_val == 1) &&
      (ret_ty == i32_t || ret_ty == i64_t || ret_ty == i1_t || ret_ty == i8_t ||
      ret_ty == llvm_float_type() || ret_ty == llvm_double_type())) {
        let r_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
        r_args.t0 = ret_ty;
        r_args.t1 = i1_t;
        ret_ty = llvm_struct_type(r_args, 2, 0);
        delete r_args;
      }

    let param_types <&LLVMTypeArgs> = new LLVMTypeArgs{};
    let p_count <int> = 0;
    let is_var_arg <int> = 0;
    let p_cur <&AstNode> = fn_node.extra;
    if (is_main_args_decl) {
        param_types.t0 = i32_t;
        param_types.t1 = ptr_t;
        p_count = 2;
    } else {
        while (p_cur != null && p_count < 64) {
            if (cg_str_eq(p_cur.name, "...") || cg_str_eq(p_cur.type_annotation, "...")) {
                is_var_arg = 1;
                p_cur = p_cur.right;
                continue;
            }
            let pt <&LLVMType> = i32_t;
            let is_iface_p <bool> = false;
            let param_iface <&InterfaceInfo> = null;
            // A `?` on the parameter spelling (`n?: int`) rides in the
            // annotation; the base maps first and the pair wraps after.
            let p_qmark <bool> = is_nullable_type(p_cur.type_annotation);
            let p_ann <string> = p_cur.type_annotation;
            if (p_qmark) {
                let plen_q <int> = cast<int>(cg_strlen(p_ann));
                p_ann = substr(p_ann, 0, plen_q - 1);
            }
            let ii_p <int> = 0;
            while (ii_p < interface_count) {
                if (interfaces[ii_p] != null && cg_str_eq(interfaces[ii_p].name, p_ann)) {
                    is_iface_p = true;
                    param_iface = interfaces[ii_p];
                    break;
                }
                ii_p = ii_p + 1;
            }

            if (is_iface_p) {
                if (param_iface != null && param_iface.fat_ptr_ty != null) {
                    pt = param_iface.fat_ptr_ty;
                } else {
                    let f_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
                    f_args.t0 = ptr_t;
                    f_args.t1 = ptr_t;
                    pt = llvm_struct_type(f_args, 2, 0);
                    delete f_args;
                }
            } else if (cg_str_eq(p_ann, "$struct") || cg_str_eq(p_ann, "$interface") ||
              cg_str_eq(p_ann, "$type") || cg_str_eq(p_ann, "$enum_member")) {
                pt = i64_t;
              } else if (cg_str_eq(p_ann, "bool")) { pt = i1_t; }
            else if (cg_str_eq(p_ann, "char") || cg_str_eq(p_ann, "u8") || cg_str_eq(p_ann, "i8") || cg_str_eq(p_ann, "int{8}") || cg_str_eq(p_ann, "uint{8}")) { pt = i8_t; }
            else if (cg_str_eq(p_ann, "short") || cg_str_eq(p_ann, "ushort") || cg_str_eq(p_ann, "i16") || cg_str_eq(p_ann, "u16") || cg_str_eq(p_ann, "int{16}") || cg_str_eq(p_ann, "uint{16}")) { pt = i16_t; }
            else if (cg_str_eq(p_ann, "int{32}") || cg_str_eq(p_ann, "uint{32}") || cg_str_eq(p_ann, "i32") || cg_str_eq(p_ann, "u32")) { pt = i32_t; }
            else if (cg_str_eq(p_ann, "string")) { pt = ptr_t; }
            else if (cg_str_eq(p_ann, "float") || cg_str_eq(p_ann, "f32")) { pt = llvm_float_type(); }
            else if (cg_str_eq(p_ann, "double") || cg_str_eq(p_ann, "f64")) { pt = llvm_double_type(); }
            else if (cg_str_eq(p_ann, "ulong") || cg_str_eq(p_ann, "long") || cg_str_eq(p_ann, "i64") || cg_str_eq(p_ann, "u64") ||
              cg_str_eq(p_ann, "size_t") || cg_str_eq(p_ann, "usize") || cg_str_eq(p_ann, "isize") ||
              cg_str_eq(p_ann, "uint{64}") || cg_str_eq(p_ann, "int{64}")) { pt = i64_t; }
            else {
                let plen <int> = cast<int>(cg_strlen(p_ann));
                if (plen > 0) {
                    let p_first <string> = substr(p_ann, 0, 1);
                    let p_last <string> = substr(p_ann, plen - 1, 1);
                    if (cg_str_eq(p_first, "&") || cg_str_eq(p_first, "[") || cg_str_eq(p_last, "*")) {
                        pt = ptr_t;
                    } else if (plen == 1) {
                        // A bare type parameter (`T`) carries pointer-width
                        // values: a 64-bit value (string, pointer, long) through
                        // an i32 param truncates at the call boundary
                        // (`mov %eax,%esi`), while an int widens losslessly
                        // (zext) and narrows back (trunc) at each use. So both
                        // spellings agree with the representative model, and a
                        // constraint changes nothing about the width.
                        pt = ptr_t;
                    } else if (!cg_str_eq(p_ann, "int") && !cg_str_eq(p_ann, "uint") && !cg_str_eq(p_ann, "auto") &&
                      !cg_str_eq(p_ann, "i32") && !cg_str_eq(p_ann, "u32")) {
                        pt = ptr_t;
                      }
                }
            }
            // A nullable scalar parameter lowers as the tagged pair `{T, i1}`;
            // nullable pointers, strings, interfaces and structs stay one word.
            if (p_qmark &&
              (pt == i32_t || pt == i64_t || pt == i1_t || pt == i8_t ||
              pt == llvm_float_type() || pt == llvm_double_type())) {
                let p_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
                p_args.t0 = pt;
                p_args.t1 = i1_t;
                pt = llvm_struct_type(p_args, 2, 0);
                delete p_args;
              }

            cg_targs_set(param_types, p_count, pt);

            p_count = p_count + 1;
            p_cur = p_cur.right;
        }
    }
    if (!is_main_args_decl && p_cur != null) {
        // More parameters than the LLVMTypeArgs carrier holds (64): leave the
        // function undeclared so lower_fun_decl refuses it with a named
        // diagnostic instead of emitting a truncated signature.
        delete param_types;
        return sym_count;
    }

    let fn_type <&LLVMType> = llvm_function_type(ret_ty, param_types, p_count, is_var_arg);
    delete param_types;

    let fn_val <&LLVMValue> = llvm_get_named_function(module, llvm_sym);
    if (fn_val == null) {
        fn_val = llvm_add_function(module, llvm_sym, fn_type);
    }

    if (sym_count < 8180) {
        let sym <&FnSymbol> = new FnSymbol{};
        sym.name = fn_name;
        sym.fn_val = fn_val;
        sym.fn_ty = fn_type;
        // PT1 slice 1: scan the declared body once, here, where the AST is
        // still at hand. Eager methods carry no template pointer, so the
        // call-site gate could never recover this afterwards.
        sym.has_gen_eq = cg_fn_uses_generic_eq(fn_node, false);
        sym.has_gen_ne = cg_fn_uses_generic_eq(fn_node, true);
        fn_syms[sym_count] = sym;
        let new_count <int> = sym_count + 1;

        if (!cg_str_eq(llvm_sym, fn_name) && new_count < 8180) {
            let sym2 <&FnSymbol> = new FnSymbol{};
            sym2.name = llvm_sym;
            sym2.fn_val = fn_val;
            sym2.fn_ty = fn_type;
            sym2.has_gen_eq = sym.has_gen_eq;
            sym2.has_gen_ne = sym.has_gen_ne;
            fn_syms[new_count] = sym2;
            new_count = new_count + 1;
        }
        return new_count;
    }
    return sym_count;
}

// The spelling a method type argument is instantiated at, read off the
// actual argument without lowering it (lowering needs the instance this
// infers). Literals answer from their annotation; idents from their
// declaration; computed values only when the checker left a primitive
// spelling. "" means exotic: the caller falls back to the old path.
fun cg_infer_arg_spelling(ctx: &FnContext, node: &AstNode) <string> {
    if (node == null) { return ""; }
    if (node.kind == ast_literal_int()) {
        if (node.type_annotation != null) {
            if (cg_str_eq(node.type_annotation, "float") || cg_str_eq(node.type_annotation, "f32")) { return "float"; }
            if (cg_str_eq(node.type_annotation, "double") || cg_str_eq(node.type_annotation, "f64")) { return "double"; }
            if (cg_str_eq(node.type_annotation, "char") || cg_str_eq(node.type_annotation, "u8") || cg_str_eq(node.type_annotation, "i8")) { return "char"; }
            if (cg_str_eq(node.type_annotation, "long") || cg_str_eq(node.type_annotation, "ulong") || cg_str_eq(node.type_annotation, "i64") || cg_str_eq(node.type_annotation, "u64")) { return "long"; }
            if (cg_str_eq(node.type_annotation, "bool")) { return "bool"; }
            if (cg_str_eq(node.type_annotation, "string")) { return "string"; }
        }
        return "int";
    }
    if (node.kind == ast_literal_bool()) { return "bool"; }
    if (node.kind == ast_literal_string()) { return "string"; }
    if (node.kind == ast_ident()) {
        if (node.name == null) { return ""; }
        if (cg_str_eq(node.name, "true") || cg_str_eq(node.name, "false")) { return "bool"; }
        if (cg_str_eq(node.name, "null") || cg_str_eq(node.name, "NULL")) { return ""; }
        let v <&LocalVar> = fn_ctx_find_var(ctx, node.name);
        if (v == null || v.type_annotation == null) { return ""; }
        let a <string> = cg_trim_spaces(v.type_annotation);
        if (cg_strlen(a) > cast<ulong>(1) && cg_str_eq(substr(a, 0, 1), "&")) {
            a = substr(a, 1, cast<int>(cg_strlen(a)) - 1);
        }
        let alen <int> = cast<int>(cg_strlen(a));
        if (alen > 1 && (cg_str_eq(substr(a, alen - 1, 1), "*") || cg_str_eq(substr(a, alen - 1, 1), "?"))) {
            a = substr(a, 0, alen - 1);
        }
        a = cg_trim_spaces(a);
        if (cg_strlen(a) == cast<ulong>(0)) { return ""; }
        let ilen <int> = cast<int>(cg_strlen(a));
        let ii <int> = 0;
        while (ii < ilen) {
            let ch <string> = substr(a, ii, 1);
            if (cg_str_eq(ch, "<") || cg_str_eq(ch, ">") || cg_str_eq(ch, "[") || cg_str_eq(ch, "]")) { return ""; }
            ii = ii + 1;
        }
        if (cg_is_generic_ann(ctx, a)) { return ""; }
        if (cg_is_prim_spelling(a)) { return a; }
        if (find_struct(ctx, a) != null || find_interface(ctx, a) != null || find_enum(ctx, a) != null) { return a; }
        return "";
    }
    if (node.type_annotation != null && cg_strlen(node.type_annotation) > cast<ulong>(0)) {
        let t <string> = cg_trim_spaces(node.type_annotation);
        if (cg_is_prim_spelling(t)) { return t; }
    }
    return "";
}

// The recorded method AST for a short name, or null (statics,
// constructors, and free functions never match).
fun cg_find_method_ast(ctx: &FnContext, base: string, mshort: string) <&AstNode> {
    if (ctx == null || base == null || mshort == null) { return null; }
    if (cg_strlen(mshort) == cast<ulong>(0)) { return null; }
    let st <&StructInfo> = find_struct(ctx, base);
    if (st == null || st.method_head == null) { return null; }
    let m <&AstNode> = st.method_head;
    while (m != null) {
        // Hoisted out of the kind check below: the spelling is pure.
        let q <string> = cg_cache_short(m.name, base);
        if (m.kind == ast_fun_decl() && m.name != null) {
            if (cg_str_eq(q, mshort)) { return m; }
        }
        m = m.right;
    }
    return null;
}

// Whether a `self` annotation denotes the owning struct (`&Self`, `Self`,
// `Box`, `Box*`, `&Box<T>` all do; `self: int` does not). The parser
// injects an unwritten `self` as `Box*`, so both spellings arrive here.
fun cg_self_denotes_owner(ann: string, base: string) <bool> {
    if (ann == null || base == null) { return false; }
    let s <string> = cg_strip_markers(cg_trim_spaces(ann));
    let len <int> = cast<int>(cg_strlen(s));
    let ci <int> = 0;
    while (ci < len) {
        if (cg_str_eq(substr(s, ci, 1), "<")) { s = substr(s, 0, ci); break; }
        ci = ci + 1;
    }
    s = cg_trim_spaces(s);
    if (cg_str_eq(s, "Self")) { return true; }
    if (cg_str_eq(s, base)) { return true; }
    return false;
}

// The method's own parameter names from its `<...>` text (`U`,
// `U:Castable` -> `U`). The parser concatenates token texts, so entries
// split on commas and each name runs to a constraint colon.
fun cg_method_param_names(str_val: string, out: [string], cap: int) <int> {
    let count <int> = 0;
    if (str_val == null || cg_strlen(str_val) == cast<ulong>(0)) { return 0; }
    let len <int> = cast<int>(cg_strlen(str_val));
    let depth <int> = 0;
    let start <int> = 0;
    let i <int> = 0;
    while (i <= len) {
        let ch <string> = "";
        if (i < len) { ch = substr(str_val, i, 1); }
        if (i == len || (cg_str_eq(ch, ",") && depth == 0)) {
            if (i > start && count < cap) {
                let seg <string> = cg_trim_spaces(substr(str_val, start, i - start));
                let slen <int> = cast<int>(cg_strlen(seg));
                let ci <int> = 0;
                while (ci < slen) {
                    if (cg_str_eq(substr(seg, ci, 1), ":")) { break; }
                    ci = ci + 1;
                }
                let nm <string> = cg_trim_spaces(substr(seg, 0, ci));
                if (cg_strlen(nm) > cast<ulong>(0)) {
                    out[count] = nm;
                    count = count + 1;
                }
            }
            start = i + 1;
        } else if (cg_str_eq(ch, "<")) {
            depth = depth + 1;
        } else if (cg_str_eq(ch, ">")) {
            depth = depth - 1;
        }
        i = i + 1;
    }
    return count;
}

// Deep-clone a method template with whole-word parameter substitution in
// every annotation (return, params, body). Only annotations substitute:
// names are bindings and literal text (str_val) is data.
fun cg_clone_subst(node: &AstNode, params: [string], args: [string], n: int) <&AstNode> {
    if (node == null) { return null; }
    let c <&AstNode> = new AstNode{};
    c.kind = node.kind;
    c.name = node.name;
    if (node.type_annotation != null) {
        c.type_annotation = cg_subst_params(node.type_annotation, params, args, n, n);
    }
    c.int_val = node.int_val;
    c.str_val = node.str_val;
    c.attr_text = node.attr_text;
    c.is_pub = node.is_pub;
    c.line = node.line;
    c.col = node.col;
    c.left = cg_clone_subst(node.left, params, args, n);
    c.right = cg_clone_subst(node.right, params, args, n);
    c.extra = cg_clone_subst(node.extra, params, args, n);
    return c;
}

// Retarget `$struct`-handle instantiations in a freshly cloned per-key
// instance body (C++ structHandleTarget): `st{}` where `st` is the handle
// parameter builds the seeded struct, not the handle. Only the handle's
// own bare name retargets; anything else keeps today's lowering. Runs on
// the clone, never the template.
fun cg_rewrite_handle_inits(node: &AstNode, handle_name: string, struct_name: string) <noret> {
    if (node == null) { return; }
    if (node.kind == ast_call_expr() && node.name != null && cg_str_eq(node.name, "__fin_struct_init")) {
        if (node.type_annotation != null && cg_str_eq(cg_trim_spaces(node.type_annotation), handle_name)) {
            node.type_annotation = struct_name;
        }
    }
    cg_rewrite_handle_inits(node.left, handle_name, struct_name);
    cg_rewrite_handle_inits(node.right, handle_name, struct_name);
    cg_rewrite_handle_inits(node.extra, handle_name, struct_name);
}

// The substituted spelling of a member receiver (`self.keys` with
// `self: &HashMap<int,int>` reads `&Collection<int>`): the field's
// declared annotation with the receiver struct's own arguments filled
// in, mirroring the MC1 scoped lookup in get_index_elem_type. "" when
// nothing answers (a bare-parameter receiver, an unknown struct, an
// exotic base): the caller stays on the old path.
fun cg_member_recv_spelling(ctx: &FnContext, node: &AstNode) <string> {
    if (ctx == null || node == null || node.kind != ast_member_access()) { return ""; }
    if (node.left == null || node.left.kind != ast_ident()) { return ""; }
    if (node.name == null || cg_strlen(node.name) == cast<ulong>(0)) { return ""; }
    let rv <&LocalVar> = fn_ctx_find_var(ctx, node.left.name);
    if (rv == null || rv.type_annotation == null) { return ""; }
    let rfull <string> = cg_trim_spaces(rv.type_annotation);
    let rlen <int> = cast<int>(cg_strlen(rfull));
    while (rlen > 1 && (cg_str_eq(substr(rfull, 0, 1), "&") || cg_str_eq(substr(rfull, 0, 1), "*"))) {
        rfull = substr(rfull, 1, rlen - 1);
        rlen = cast<int>(cg_strlen(rfull));
    }
    while (rlen > 1 && cg_str_eq(substr(rfull, rlen - 1, 1), "*")) {
        rfull = substr(rfull, 0, rlen - 1);
        rlen = cast<int>(cg_strlen(rfull));
    }
    let ro_at <int> = -1;
    let rc_at <int> = -1;
    let rq <int> = 0;
    while (rq < rlen) {
        if (cg_str_eq(substr(rfull, rq, 1), "<")) { ro_at = rq; break; }
        rq = rq + 1;
    }
    if (ro_at > 0) {
        rq = rlen - 1;
        while (rq > ro_at) {
            if (cg_str_eq(substr(rfull, rq, 1), ">")) { rc_at = rq; break; }
            rq = rq - 1;
        }
    }
    if (ro_at <= 0 || rc_at <= ro_at) { return ""; }
    let rbase <string> = cg_trim_spaces(substr(rfull, 0, ro_at));
    let rinner <string> = substr(rfull, ro_at + 1, rc_at - ro_at - 1);
    let rst <&StructInfo> = find_struct(ctx, rbase);
    if (rst == null || rst.gen_params == null || cg_strlen(rst.gen_params) == cast<ulong>(0)) { return ""; }
    let rfi <int> = 0;
    while (rfi < rst.field_count) {
        let rf <&StructFieldInfo> = rst.fields[rfi];
        if (rf != null && cg_str_eq(rf.name, node.name)) {
            let rgp <[string]> = new [string, 64]{};
            let rga <[string]> = new [string, 64]{};
            let rpc <int> = cg_split_top(rst.gen_params, rgp, 64);
            let rac <int> = cg_split_top(rinner, rga, 64);
            let out <string> = "";
            if (rpc > 0 && rac == rpc) {
                out = cg_trim_spaces(cg_subst_params(rf.type_annotation, rgp, rga, rpc, rac));
            }
            delete rgp;
            delete rga;
            return out;
        }
        rfi = rfi + 1;
    }
    return "";
}

// Try the per-key method instance for a call: declare `Recv.<method><margs>`
// with receiver and method arguments substituted and queue its body for the
// drain. Returns the instance, or null to stay on the old path (which owns
// every refusal). A refusal poisons ctx; the caller returns null outright.
fun cg_method_cache_sym(ctx: &FnContext, n: &AstNode) <&FnSymbol> {
    if (ctx == null || n == null || n.left == null) { return null; }
    if (n.name != null && cg_strlen(n.name) >= cast<ulong>(2)) {
        let nl <int> = cast<int>(cg_strlen(n.name));
        let di <int> = 0;
        while (di + 1 < nl) {
            if (cg_str_eq(substr(n.name, di, 2), "::")) { return null; }
            di = di + 1;
        }
    }
    ctx.fn_sym_count = recount_fn_syms(ctx.fn_syms, ctx.fn_sym_count);
    // The receiver is the first actual; the checker flattens `a.get()` to
    // `Box_get(a, ...)`, so the ident is one level down when wrapped. A
    // member receiver (`self.keys.push(x)` flattens to
    // `Collection_push(self.keys, x)`) resolves through the receiver's
    // own instantiation instead; anything else stays on the old path.
    // A unary deref/address-of around an ident (`(*ptr).length()`,
    // `(&v).total()`) looks through to the ident: the annotation names
    // the same object either way, so the instance key matches a direct
    // call on it. Anything else stays on the old path.
    let first_wrap <&AstNode> = n.left;
    let rec_node <&AstNode> = first_wrap.left;
    if (rec_node == null) { rec_node = first_wrap; }
    if (rec_node != null && rec_node.kind == ast_unary_expr() && rec_node.left != null) {
        if (cg_str_eq(rec_node.name, "*") || cg_str_eq(rec_node.name, "&")) {
            rec_node = rec_node.left;
        }
    }
    if (rec_node == null) { return null; }
    let recv <string> = "";
    if (rec_node.kind == ast_ident()) {
        if (rec_node.name == null || cg_strlen(rec_node.name) == cast<ulong>(0)) { return null; }
        let v <&LocalVar> = fn_ctx_find_var(ctx, rec_node.name);
        if (v == null || v.type_annotation == null) {
            return null;
        }
        recv = cg_trim_spaces(v.type_annotation);
    } else if (rec_node.kind == ast_member_access()) {
        recv = cg_member_recv_spelling(ctx, rec_node);
        if (cg_strlen(recv) == cast<ulong>(0)) { return null; }
    } else {
        return null;
    }
    if (cg_strlen(recv) > cast<ulong>(1) && cg_str_eq(substr(recv, 0, 1), "&")) {
        recv = cg_trim_spaces(substr(recv, 1, cast<int>(cg_strlen(recv)) - 1));
    }
    let rlen <int> = cast<int>(cg_strlen(recv));
    if (rlen > 1 && cg_str_eq(substr(recv, rlen - 1, 1), "*")) {
        recv = cg_trim_spaces(substr(recv, 0, rlen - 1));
        rlen = cast<int>(cg_strlen(recv));
    }
    let open_at <int> = -1;
    let oi <int> = 0;
    while (oi < rlen) {
        if (cg_str_eq(substr(recv, oi, 1), "<")) { open_at = oi; break; }
        oi = oi + 1;
    }
    if (open_at <= 0) {
        return null;
    }
    let close_at <int> = -1;
    let cj <int> = rlen - 1;
    while (cj > open_at) {
        if (cg_str_eq(substr(recv, cj, 1), ">")) { close_at = cj; break; }
        cj = cj - 1;
    }
    if (close_at < 0) { return null; }
    let base <string> = cg_trim_spaces(substr(recv, 0, open_at));
    let inner <string> = substr(recv, open_at + 1, close_at - open_at - 1);
    if (cg_strlen(base) == cast<ulong>(0) || cg_strlen(inner) == cast<ulong>(0)) { return null; }
    let st <&StructInfo> = find_struct(ctx, base);
    if (st == null) { return null; }
    if (st.gen_params == null || cg_strlen(st.gen_params) == cast<ulong>(0)) { return null; }
    if (n.name != null && cg_str_eq(n.name, base)) { return null; }
    let mshort <string> = cg_cache_short(n.name, base);
    if (cg_strlen(mshort) == cast<ulong>(0)) { return null; }
    // The template: a generic method's registered tmpl, else the struct's
    // recorded method AST. Anything else (free functions, statics,
    // constructors) stays on the old path.
    let tmpl <&AstNode> = null;
    let tmpl_sym <&FnSymbol> = fn_ctx_find_fn(ctx, n.name);
    if (tmpl_sym != null && tmpl_sym.tmpl != null) { tmpl = tmpl_sym.tmpl; }
    if (tmpl == null) {
        let b_dot <Buffer> = new_buffer(64);
        b_dot.write_string(base);
        b_dot.write_char('.');
        b_dot.write_string(mshort);
        let dot_nm <string> = b_dot.to_string();
        free_buffer(b_dot);
        let dsym <&FnSymbol> = fn_ctx_find_fn(ctx, dot_nm);
        if (dsym != null && dsym.tmpl != null) { tmpl = dsym.tmpl; tmpl_sym = dsym; }
    }
    if (tmpl == null) {
        let b_un <Buffer> = new_buffer(64);
        b_un.write_string(base);
        b_un.write_char('_');
        b_un.write_string(mshort);
        let un_nm <string> = b_un.to_string();
        free_buffer(b_un);
        let usym <&FnSymbol> = fn_ctx_find_fn(ctx, un_nm);
        if (usym != null && usym.tmpl != null) { tmpl = usym.tmpl; tmpl_sym = usym; }
    }
    if (tmpl == null) { tmpl = cg_find_method_ast(ctx, base, mshort); }
    if (tmpl == null || tmpl.left == null) {
        return null;
    }
    // Instance methods carry an injected `self` first (the parser prepends
    // `Box*` when unwritten); anything else is a static, which stays on the
    // old path, and a `self` naming another type is exotic likewise.
    if (tmpl.extra == null || tmpl.extra.name == null || !cg_str_eq(tmpl.extra.name, "self")) { return null; }
    if (!cg_self_denotes_owner(tmpl.extra.type_annotation, base)) { return null; }
    // ADR 0036 first: a body comparing a generic value refuses when the
    // receiver arguments name a struct without the operator. The cache must
    // not punch through it (coll_data stays refused).
    let disp_b <Buffer> = new_buffer(64);
    disp_b.write_string(base);
    disp_b.write_char('.');
    disp_b.write_string(mshort);
    let disp <string> = disp_b.to_string();
    free_buffer(disp_b);
    let has_eq <bool> = cg_fn_uses_generic_eq(tmpl, false);
    let has_ne <bool> = cg_fn_uses_generic_eq(tmpl, true);
    if (tmpl_sym != null && tmpl_sym.tmpl == tmpl) {
        if (tmpl_sym.has_gen_eq) { has_eq = true; }
        if (tmpl_sym.has_gen_ne) { has_ne = true; }
    }
    if (has_eq) {
        if (cg_check_generic_eq_args(ctx, disp, inner, false)) { return null; }
    }
    if (has_ne) {
        if (cg_check_generic_eq_args(ctx, disp, inner, true)) { return null; }
    }
    // Struct substitution: every argument modellable, or the old path owns it.
    let s_params <[string]> = new [string, 64]{};
    let scount <int> = cg_split_top(st.gen_params, s_params, 64);
    let s_args <[string]> = new [string, 64]{};
    let acount <int> = cg_split_top(inner, s_args, 64);
    if (scount <= 0 || acount != scount) { delete s_params; delete s_args; return null; }
    let sg <int> = 0;
    while (sg < acount) {
        if (!cg_modellable_seg(ctx, s_args[sg])) { delete s_params; delete s_args; return null; }
        sg = sg + 1;
    }
    // Written parameters minus the injected `self` pair positionally with
    // the actuals minus the receiver, in one lockstep walk (64-step cap;
    // chains are finite).
    let m_names <[string]> = new [string, 64]{};
    let m_spell <[string]> = new [string, 64]{};
    let mcount <int> = 0;
    let pw <&AstNode> = tmpl.extra.right;
    let cw <&AstNode> = n.left.right;
    let steps <int> = 0;
    let paired <bool> = true;
    while (pw != null || cw != null) {
        if (pw == null || cw == null || steps >= 64) { paired = false; break; }
        let aa <&AstNode> = cw.left;
        if (aa == null) { aa = cw; }
        let pann <string> = "";
        if (pw.type_annotation != null) { pann = pw.type_annotation; }
        let stripped <string> = cg_strip_markers(cg_trim_spaces(pann));
        if (cg_strlen(stripped) > cast<ulong>(0) && cg_param_index(s_params, scount, stripped) < 0 &&
          !cg_is_prim_spelling(stripped) && !cg_str_eq(stripped, "Self") &&
          !cg_str_eq(stripped, "void") && !cg_str_eq(stripped, "noret") &&
          find_struct(ctx, stripped) == null && find_interface(ctx, stripped) == null && find_enum(ctx, stripped) == null) {
            let inf <string> = cg_infer_arg_spelling(ctx, aa);
            if (cg_strlen(inf) == cast<ulong>(0)) { paired = false; break; }
            let mi <int> = cg_param_index(m_names, mcount, stripped);
            if (mi >= 0) {
                if (!cg_str_eq(m_spell[mi], inf)) { paired = false; break; }
            } else {
                if (mcount >= 64) { paired = false; break; }
                m_names[mcount] = stripped;
                m_spell[mcount] = inf;
                mcount = mcount + 1;
            }
          }
        pw = pw.right;
        cw = cw.right;
        steps = steps + 1;
    }
    if (!paired) {
        delete s_params; delete s_args; delete m_names; delete m_spell; return null;
    }
    // Every method-generic name needs a spelling: an uninferred `U` is
    // exotic (a turbofish the call never spelled, per the C++ refusal).
    let need <[string]> = new [string, 64]{};
    let ncount <int> = cg_method_param_names(tmpl.str_val, need, 64);
    let ni <int> = 0;
    while (ni < ncount) {
        if (cg_param_index(s_params, scount, need[ni]) < 0 && cg_param_index(m_names, mcount, need[ni]) < 0) {
            delete s_params; delete s_args; delete m_names; delete m_spell; delete need;
            return null;
        }
        ni = ni + 1;
    }
    delete need;
    // The key mirrors C++ methodKey+mangledName: receiver, method, args.
    let kb <Buffer> = new_buffer(128);
    kb.write_string(recv);
    kb.write_char('.');
    kb.write_string(mshort);
    kb.write_char('<');
    let kji <int> = 0;
    while (kji < mcount) {
        if (kji > 0) { kb.write_string(", "); }
        kb.write_string(m_spell[kji]);
        kji = kji + 1;
    }
    kb.write_char('>');
    let key <string> = kb.to_string();
    free_buffer(kb);
    // Asking twice finds the first: one declare + drained body per key.
    let hit <&FnSymbol> = fn_ctx_find_fn(ctx, key);
    if (hit != null) { delete s_params; delete s_args; delete m_names; delete m_spell; return hit; }
    let total <int> = scount + mcount;
    // Both halves hold up to 64 entries (struct parameters plus inferred
    // method names): 32 slots overflowed the heap past 32 combined.
    let params <[string]> = new [string, 128]{};
    let args <[string]> = new [string, 128]{};
    let ti <int> = 0;
    while (ti < scount) {
        params[ti] = s_params[ti];
        args[ti] = s_args[ti];
        ti = ti + 1;
    }
    ti = 0;
    while (ti < mcount) {
        params[scount + ti] = m_names[ti];
        args[scount + ti] = m_spell[ti];
        ti = ti + 1;
    }
    // `Self` names the receiver's own instantiation (C++ binds it with
    // the arguments): `other: Self` reads `Vec2<float>`, not the bare
    // word. `new Self` keeps its name (only annotations substitute),
    // so constructors resolve exactly as before.
    if (total < 128) {
        params[total] = "Self";
        args[total] = recv;
        total = total + 1;
    }
    let clone <&AstNode> = cg_clone_subst(tmpl, params, args, total);
    delete params;
    delete args;
    delete s_params;
    delete s_args;
    delete m_names;
    delete m_spell;
    if (clone == null) { return null; }
    clone.name = key;
    clone.right = null;
    clone.str_val = "";
    // The receiver slot carries the instantiation (`&Box<float>`): field
    // loads and nested calls read the concrete spelling off it (`Self`
    // substituted above, so its positions do too).
    let selfb <Buffer> = new_buffer(64);
    selfb.write_char('&');
    selfb.write_string(recv);
    let self_ann <string> = selfb.to_string();
    free_buffer(selfb);
    if (clone.extra != null) { clone.extra.type_annotation = self_ann; }
    ctx.fn_sym_count = declare_function(ctx.module, clone, ctx.fn_syms, ctx.fn_sym_count, ctx.interfaces, ctx.interface_count);
    let sym <&FnSymbol> = fn_ctx_find_fn(ctx, key);
    if (sym == null || sym.fn_val == null) {
        return null;
    }
    // The body drains after pass 2 with the rest, to fixpoint: a body
    // drained here may itself instantiate more.
    sym.tmpl = clone;
    sym.tmpl_done = false;
    return sym;
}

// FG1: free generic functions over generic structs. A free `read<T>(b: Box<T>)`
// declares one erased body (`ptr -> ptr`) that cannot serve two spellings:
// `cast<float>(read(bi))` with `bi: Box<int>` reinterprets the carried int
// bits as float (`0.000000`) where C++ monomorphizes (`42.000000`). Like the
// MC1 method cache, declare and drain one body per call-site key with the
// arguments substituted, mirroring C++ emitTemplateCall (per-instantiation
// declare + drain, keyed by mangledName). Exotic spellings return null and
// stay on the old path, which refuses (the template declares nothing eager).

// True when a top-level generic fun mentions a generic struct application in
// any parameter (`Box<T>`, `Pair<T, U>`, `&Box<T>` all count). Takes the raw
// Pass 1 arrays so Pass 1.5 and Pass 2 call it without a FnContext.
// True when the subtree holds a member access rooted in one of the named
// parameters (`b.val` with `b` in names). `.length` is excluded: arrays and
// strings carry it and are not structs (`sort<T>(array: &[T])` reads
// `array.length`). A struct field genuinely named `length` stays eager.
fun cg_body_has_param_member(node: &AstNode, names: [string], count: int) <bool> {
    if (node == null) { return false; }
    if (node.kind == ast_member_access()) {
        if (node.name != null && !cg_str_eq(node.name, "length")) {
            if (node.left != null && node.left.kind == ast_ident()) {
                if (node.left.name != null && cg_name_in_list(names, count, node.left.name)) { return true; }
            }
        }
    }
    // A method call rooted in a parameter (`object.format_str()` with
    // `object` a parameter) is the interface-bounded free-generic shape
    // (`print<X: Printable>`, `print_any<T: Printable>`): the checker
    // rewrites it to `Printable_m`, so member access never sees it. Treat
    // it like the member shape above so such functions become templates
    // (skipped eager, instantiated per concrete call) instead of lowering
    // the erased body against a generic receiver. Permissive on purpose:
    // a false positive only adds an instantiation, a miss refuses.
    if (node.kind == ast_call_expr()) {
        let fw <&AstNode> = node.left;
        if (fw != null) {
            let rn <&AstNode> = fw.left;
            if (rn == null) { rn = fw; }
            if (rn != null && rn.kind == ast_unary_expr() && rn.left != null) {
                rn = rn.left;
            }
            if (rn != null && rn.kind == ast_ident()) {
                if (rn.name != null && cg_name_in_list(names, count, rn.name)) { return true; }
            }
            if (rn != null && rn.kind == ast_member_access()) {
                if (rn.left != null && rn.left.kind == ast_ident()) {
                    if (rn.left.name != null && cg_name_in_list(names, count, rn.left.name)) { return true; }
                }
            }
        }
    }
    if (cg_body_has_param_member(node.left, names, count)) { return true; }
    if (cg_body_has_param_member(node.right, names, count)) { return true; }
    if (cg_body_has_param_member(node.extra, names, count)) { return true; }
    return false;
}

fun cg_decl_is_free_over_struct(decl: &AstNode, structs: [&StructInfo], struct_count: int) <bool> {
    if (decl == null || decl.kind != ast_fun_decl()) { return false; }
    if (decl.int_val == 2) { return false; }
    if (decl.left == null) { return false; }
    if (!is_generic_method(decl)) { return false; }
    // The checker erases template parameter spellings (`Box<T>` arrives as
    // `void*`), so the parameter list cannot say whether the function is
    // over a struct. Read the body instead: a member access rooted in a
    // parameter (`b.val` with `b` a parameter) is the over-struct shape.
    // `structs`/`struct_count` are unused (kept so Pass 1.5 and Pass 2 share
    // one predicate); the call site confirms the struct via the actual.
    let pn <[string]> = new [string, 64]{};
    let pc <int> = 0;
    let pw <&AstNode> = decl.extra;
    while (pw != null && pc < 64) {
        if (pw.name != null && cg_strlen(pw.name) > cast<ulong>(0)) {
            pn[pc] = pw.name;
            pc = pc + 1;
        }
        pw = pw.right;
    }
    if (pc <= 0) { delete pn; return false; }
    let found <bool> = cg_body_has_param_member(decl.left, pn, pc);
    delete pn;
    return found;
}

// True when the subtree mentions one of the named value parameters
// (`key` in `cast<int>(key)`). Concrete-cast detection below reads this,
// not types: inside an erased body every annotation is already width-less.
fun cg_subtree_mentions_param(node: &AstNode, names: [string], count: int) <bool> {
    if (node == null) { return false; }
    if (node.kind == ast_ident()) {
        if (node.name != null && cg_name_in_list(names, count, node.name)) { return true; }
    }
    if (cg_subtree_mentions_param(node.left, names, count)) { return true; }
    if (cg_subtree_mentions_param(node.right, names, count)) { return true; }
    if (cg_subtree_mentions_param(node.extra, names, count)) { return true; }
    return false;
}

// True when the body folds a parameter's machine word through a concrete
// cast (`cast<int>(key)` in `hash_of<T>`): the erasure idiom, designed for
// the pointer-width representation. Such functions stay eager: their inner
// call sites (`hash_of::<T>(key)` inside `HashMap<T, U>`) name no concrete
// instantiation, so there is no key to monomorphize on, while the erased
// body lowers exactly as written. A cast TO a generic (`cast<T>(...)`)
// still needs its width and never counts here.
fun cg_body_has_erasure_cast(node: &AstNode, pnames: [string], pcount: int, gen: [string], gcount: int) <bool> {
    if (node == null) { return false; }
    if (node.kind == ast_unary_expr() && node.name != null && cg_str_eq(node.name, "cast")) {
        let target <string> = "";
        if (node.type_annotation != null) { target = node.type_annotation; }
        if (cg_strlen(target) > cast<ulong>(0) && !cg_free_mentions_param(target, gen, gcount)) {
            if (cg_subtree_mentions_param(node.left, pnames, pcount)) { return true; }
        }
    }
    if (cg_body_has_erasure_cast(node.left, pnames, pcount, gen, gcount)) { return true; }
    if (cg_body_has_erasure_cast(node.right, pnames, pcount, gen, gcount)) { return true; }
    if (cg_body_has_erasure_cast(node.extra, pnames, pcount, gen, gcount)) { return true; }
    return false;
}

// True when an annotation mentions any parameter as a whole word.
fun cg_free_mentions_param(ann: string, params: [string], pcount: int) <bool> {
    if (ann == null || pcount <= 0) { return false; }
    let len <int> = cast<int>(cg_strlen(ann));
    let pi <int> = 0;
    while (pi < pcount) {
        let q <string> = params[pi];
        let qlen <int> = cast<int>(cg_strlen(q));
        if (qlen > 0) {
            let i <int> = 0;
            while (i + qlen <= len) {
                if (cg_str_eq(substr(ann, i, qlen), q)) {
                    let before_ok <bool> = false;
                    let after_ok <bool> = false;
                    if (i == 0) { before_ok = true; }
                    else { before_ok = cg_is_type_delim(substr(ann, i - 1, 1)); }
                    if (i + qlen == len) { after_ok = true; }
                    else { after_ok = cg_is_type_delim(substr(ann, i + qlen, 1)); }
                    if (before_ok && after_ok) { return true; }
                }
                i = i + 1;
            }
        }
        pi = pi + 1;
    }
    return false;
}

// MM2: a free generic over bare parameters (`swap<T>(a: &T, b: &T)`,
// `sz<T>(x: T)`). Every generic parameter must show in at least one
// parameter annotation as a whole word inside a simple spelling (bare `T`,
// pointer-decorated `T*`, or an application like `Box<T>`); array (`[...]`),
// meta (`$...`), and erased (`void*`) spellings never count, so `sort`'s
// `void*` and `make_default`'s `$struct` stay eager on today's path.
// `structs`/`struct_count` are unused (kept so Pass 1.5 and Pass 2 share one
// predicate, like the over-struct shape above).
fun cg_decl_is_free_bare_generic(decl: &AstNode, structs: [&StructInfo], struct_count: int) <bool> {
    if (decl == null || decl.kind != ast_fun_decl()) { return false; }
    if (decl.int_val == 2) { return false; }
    if (decl.left == null) { return false; }
    if (!is_generic_method(decl)) { return false; }
    if (decl.extra != null && decl.extra.name != null && cg_str_eq(decl.extra.name, "self")) { return false; }
    let pn <[string]> = new [string, 64]{};
    let pc <int> = cg_method_param_names(decl.str_val, pn, 64);
    if (pc <= 0) { delete pn; return false; }
    let gi <int> = 0;
    while (gi < pc) {
        let seen <bool> = false;
        let pw <&AstNode> = decl.extra;
        while (pw != null) {
            let ann <string> = "";
            if (pw.type_annotation != null) { ann = pw.type_annotation; }
            if (cg_strlen(ann) > cast<ulong>(0) && !cg_str_eq(cg_trim_spaces(ann), "void*") &&
              !cg_str_contains(ann, "[") && !cg_str_contains(ann, "]") && !cg_str_contains(ann, "$")) {
                let one <[string]> = new [string, 1]{};
                one[0] = pn[gi];
                if (cg_free_mentions_param(ann, one, 1)) { seen = true; delete one; break; }
                delete one;
              }
            pw = pw.right;
        }
        if (!seen) { delete pn; return false; }
        gi = gi + 1;
    }
    // The erasure idiom (`cast<int>(key)`) stays eager: its body is designed
    // for the machine word and its inner generic call sites name no key.
    let vn <[string]> = new [string, 64]{};
    let vc <int> = 0;
    let vw <&AstNode> = decl.extra;
    while (vw != null && vc < 64) {
        if (vw.name != null && cg_strlen(vw.name) > cast<ulong>(0)) {
            vn[vc] = vw.name;
            vc = vc + 1;
        }
        vw = vw.right;
    }
    if (vc > 0 && cg_body_has_erasure_cast(decl.left, vn, vc, pn, pc)) { delete pn; delete vn; return false; }
    delete vn;
    delete pn;
    return true;
}

// A `$struct`-seeded free generic (`make_default<T>(st: $struct) <T>`):
// the return-only bare parameter is seeded at the call by the single
// `$struct` handle's own declaration (C++ trySeedFromStructHandle), so
// the function instantiates per seeding like any template. Only the
// single-parameter single-handle shape qualifies (several handles stay
// unbound like C++); anything wider stays eager as before.
fun cg_decl_is_struct_seeded_generic(decl: &AstNode) <bool> {
    if (decl == null || decl.kind != ast_fun_decl()) { return false; }
    if (decl.int_val == 2) { return false; }
    if (decl.left == null) { return false; }
    if (!is_generic_method(decl)) { return false; }
    if (decl.extra != null && decl.extra.name != null && cg_str_eq(decl.extra.name, "self")) { return false; }
    let pn <[string]> = new [string, 64]{};
    let pc <int> = cg_method_param_names(decl.str_val, pn, 64);
    if (pc != 1) { delete pn; return false; }
    let pcount <int> = 0;
    let handle_count <int> = 0;
    let pw <&AstNode> = decl.extra;
    while (pw != null) {
        pcount = pcount + 1;
        if (pw.type_annotation != null && cg_str_eq(cg_trim_spaces(pw.type_annotation), "$struct")) {
            handle_count = handle_count + 1;
        }
        pw = pw.right;
    }
    if (pcount != 1 || handle_count != 1) { delete pn; return false; }
    let ret <string> = "";
    if (decl.type_annotation != null) { ret = cg_trim_spaces(decl.type_annotation); }
    let ok <bool> = cg_str_eq(ret, pn[0]);
    delete pn;
    return ok;
}

// Bind a pattern annotation against an actual spelling, mirroring C++
// unifyBinding (bare `T` binds, `Box<T>` reads the instantiation's own
// substitution, concrete spellings bind nothing). Returns the new binding
// count, or -1 when exotic (unknown actual, parameter-to-parameter).
fun cg_free_unify(pat: string, act: string, params: [string], bnames: [string], bvals: [string], pcount: int, bcount: int) <int> {
    if (pat == null || act == null) { return -1; }
    let p <string> = cg_trim_spaces(pat);
    let a <string> = cg_trim_spaces(act);
    if (cg_strlen(p) == cast<ulong>(0) || cg_strlen(a) == cast<ulong>(0)) { return -1; }
    let ps <string> = cg_strip_markers(p);
    let ass <string> = cg_strip_markers(a);
    if (!cg_str_eq(ps, p) || !cg_str_eq(ass, a)) {
        return cg_free_unify(ps, ass, params, bnames, bvals, pcount, bcount);
    }
    if (cg_param_index(params, pcount, ps) >= 0) {
        if (cg_is_type_param(ass) || cg_param_index(params, pcount, ass) >= 0) { return -1; }
        if (cg_str_eq(ass, "Self")) { return -1; }
        if (cg_param_index(bnames, bcount, ps) >= 0) { return bcount; }
        if (bcount >= 64) { return -1; }
        bnames[bcount] = ps;
        bvals[bcount] = ass;
        return bcount + 1;
    }
    if (cg_str_eq(ps, "Self")) { return -1; }
    let plen <int> = cast<int>(cg_strlen(ps));
    let po <int> = -1;
    let poi <int> = 0;
    while (poi < plen) {
        if (cg_str_eq(substr(ps, poi, 1), "<")) { po = poi; break; }
        poi = poi + 1;
    }
    if (po <= 0) { return bcount; }
    let alen <int> = cast<int>(cg_strlen(ass));
    let ao <int> = -1;
    let aoi <int> = 0;
    while (aoi < alen) {
        if (cg_str_eq(substr(ass, aoi, 1), "<")) { ao = aoi; break; }
        aoi = aoi + 1;
    }
    if (ao <= 0) { return bcount; }
    let pbase <string> = cg_trim_spaces(substr(ps, 0, po));
    let abase <string> = cg_trim_spaces(substr(ass, 0, ao));
    if (!cg_str_eq(pbase, abase)) { return bcount; }
    let pc <int> = -1;
    let pci <int> = plen - 1;
    while (pci > po) {
        if (cg_str_eq(substr(ps, pci, 1), ">")) { pc = pci; break; }
        pci = pci - 1;
    }
    let ac <int> = -1;
    let aci <int> = alen - 1;
    while (aci > ao) {
        if (cg_str_eq(substr(ass, aci, 1), ">")) { ac = aci; break; }
        aci = aci - 1;
    }
    if (pc < 0 || ac < 0) { return bcount; }
    let pinner <string> = substr(ps, po + 1, pc - po - 1);
    let ainner <string> = substr(ass, ao + 1, ac - ao - 1);
    let pparts <[string]> = new [string, 64]{};
    let aparts <[string]> = new [string, 64]{};
    let pn <int> = cg_split_top(pinner, pparts, 64);
    let an <int> = cg_split_top(ainner, aparts, 64);
    if (pn <= 0 || an != pn) { delete pparts; delete aparts; return bcount; }
    let cur <int> = bcount;
    let ii <int> = 0;
    while (ii < pn) {
        cur = cg_free_unify(pparts[ii], aparts[ii], params, bnames, bvals, pcount, cur);
        if (cur < 0) { delete pparts; delete aparts; return -1; }
        ii = ii + 1;
    }
    delete pparts;
    delete aparts;
    return cur;
}

// Positional binding from one actual struct spelling (`Box<int>` binds
// `T=int` when the function declares one parameter). The checker's erasure
// rewrites template parameter spellings to `void*`, so there is no pattern
// to unify against: the actual's own instantiation is the source of truth,
// mirroring C++ reading the substitution off the argument's StructInfo.
// Returns the new count, -1 on conflict (an already-bound name bound
// differently), or unchanged when the actual names no instantiation.
fun cg_free_bind_positional(ctx: &FnContext, pn: [string], pc: int, actual: string, bn: [string], bv: [string], bc: int) <int> {
    if (actual == null || pc <= 0) { return bc; }
    let a <string> = cg_trim_spaces(cg_strip_markers(cg_trim_spaces(actual)));
    if (cg_strlen(a) == cast<ulong>(0)) { return bc; }
    let len <int> = cast<int>(cg_strlen(a));
    let o <int> = -1;
    let oi <int> = 0;
    while (oi < len) {
        if (cg_str_eq(substr(a, oi, 1), "<")) { o = oi; break; }
        oi = oi + 1;
    }
    if (o <= 0) { return bc; }
    let base <string> = cg_trim_spaces(substr(a, 0, o));
    if (cg_strlen(base) == cast<ulong>(0)) { return bc; }
    let st <&StructInfo> = find_struct(ctx, base);
    if (st == null || st.gen_params == null || cg_strlen(st.gen_params) == cast<ulong>(0)) { return bc; }
    let c <int> = -1;
    let ci <int> = len - 1;
    while (ci > o) {
        if (cg_str_eq(substr(a, ci, 1), ">")) { c = ci; break; }
        ci = ci - 1;
    }
    if (c < 0) { return bc; }
    let inner <string> = substr(a, o + 1, c - o - 1);
    let parts <[string]> = new [string, 64]{};
    let n <int> = cg_split_top(inner, parts, 64);
    if (n != pc) { delete parts; return bc; }
    let cur <int> = bc;
    let i <int> = 0;
    while (i < pc) {
        let want <string> = cg_trim_spaces(parts[i]);
        if (cg_strlen(want) == cast<ulong>(0)) { delete parts; return -1; }
        let at <int> = cg_param_index(bn, cur, pn[i]);
        if (at >= 0) {
            if (!cg_str_eq(bv[at], want)) { delete parts; return -1; }
        } else {
            if (cur >= 64) { delete parts; return -1; }
            bn[cur] = pn[i];
            bv[cur] = want;
            cur = cur + 1;
        }
        i = i + 1;
    }
    delete parts;
    return cur;
}

// Whether a bound spelling is modellable: a primitive or a nominal
// instantiation whose inners model recursively. Bare parameters, `Self`,
// and unknown words are exotic.
fun cg_free_modellable(ctx: &FnContext, spelling: string, depth: int) <bool> {
    if (depth < 0) { return false; }
    if (spelling == null) { return false; }
    let s <string> = cg_trim_spaces(cg_strip_markers(cg_trim_spaces(spelling)));
    if (cg_strlen(s) == cast<ulong>(0)) { return false; }
    if (cg_str_eq(s, "Self")) { return false; }
    if (cg_is_generic_ann(ctx, s)) { return false; }
    if (cg_is_prim_spelling(s)) { return true; }
    let len <int> = cast<int>(cg_strlen(s));
    let o <int> = -1;
    let oi <int> = 0;
    while (oi < len) {
        if (cg_str_eq(substr(s, oi, 1), "<")) { o = oi; break; }
        oi = oi + 1;
    }
    if (o <= 0) {
        if (find_struct(ctx, s) != null) { return true; }
        if (find_interface(ctx, s) != null) { return true; }
        if (find_enum(ctx, s) != null) { return true; }
        return false;
    }
    let base <string> = cg_trim_spaces(substr(s, 0, o));
    if (cg_strlen(base) == cast<ulong>(0)) { return false; }
    let st <&StructInfo> = find_struct(ctx, base);
    if (st != null) {
        if (st.gen_params == null || cg_strlen(st.gen_params) == cast<ulong>(0)) { return false; }
    } else {
        if (find_interface(ctx, base) == null && find_enum(ctx, base) == null) { return false; }
    }
    let c <int> = -1;
    let ci <int> = len - 1;
    while (ci > o) {
        if (cg_str_eq(substr(s, ci, 1), ">")) { c = ci; break; }
        ci = ci - 1;
    }
    if (c < 0) { return false; }
    let inner <string> = substr(s, o + 1, c - o - 1);
    let parts <[string]> = new [string, 64]{};
    let n <int> = cg_split_top(inner, parts, 64);
    if (n <= 0) { delete parts; return false; }
    let i <int> = 0;
    while (i < n) {
        if (!cg_free_modellable(ctx, parts[i], depth - 1)) { delete parts; return false; }
        i = i + 1;
    }
    delete parts;
    return true;
}

// The full spelling of a call argument: idents from their binding,
// literals from their annotation, nested free-generic calls from their
// inferred return. "" means exotic.
fun cg_free_spelling_of(ctx: &FnContext, node: &AstNode, depth: int) <string> {
    if (node == null || depth < 0) { return ""; }
    if (node.kind == ast_literal_int()) {
        if (node.type_annotation != null) {
            if (cg_str_eq(node.type_annotation, "float") || cg_str_eq(node.type_annotation, "f32")) { return "float"; }
            if (cg_str_eq(node.type_annotation, "double") || cg_str_eq(node.type_annotation, "f64")) { return "double"; }
            if (cg_str_eq(node.type_annotation, "char") || cg_str_eq(node.type_annotation, "u8") || cg_str_eq(node.type_annotation, "i8")) { return "char"; }
            if (cg_str_eq(node.type_annotation, "long") || cg_str_eq(node.type_annotation, "ulong") || cg_str_eq(node.type_annotation, "i64") || cg_str_eq(node.type_annotation, "u64")) { return "long"; }
            if (cg_str_eq(node.type_annotation, "bool")) { return "bool"; }
            if (cg_str_eq(node.type_annotation, "string")) { return "string"; }
        }
        return "int";
    }
    if (node.kind == ast_literal_bool()) { return "bool"; }
    if (node.kind == ast_literal_string()) { return "string"; }
    if (node.kind == ast_ident()) {
        if (node.name == null) { return ""; }
        if (cg_str_eq(node.name, "true") || cg_str_eq(node.name, "false")) { return "bool"; }
        if (cg_str_eq(node.name, "null") || cg_str_eq(node.name, "NULL")) { return ""; }
        let v <&LocalVar> = fn_ctx_find_var(ctx, node.name);
        if (v == null || v.type_annotation == null) { return ""; }
        return cg_trim_spaces(v.type_annotation);
    }
    if (node.kind == ast_call_expr()) {
        if (node.name == null || cg_strlen(node.name) == cast<ulong>(0)) { return ""; }
        let nl <int> = cast<int>(cg_strlen(node.name));
        let di <int> = 0;
        while (di + 1 < nl) {
            if (cg_str_eq(substr(node.name, di, 2), "::")) { return ""; }
            di = di + 1;
        }
        let sym <&FnSymbol> = fn_ctx_find_fn(ctx, node.name);
        if (sym == null || sym.tmpl == null) {
            if (node.type_annotation != null && cg_strlen(node.type_annotation) > cast<ulong>(0)) {
                return cg_trim_spaces(node.type_annotation);
            }
            return "";
        }
        let tmpl <&AstNode> = sym.tmpl;
        if (tmpl.left == null) { return ""; }
        let pn <[string]> = new [string, 64]{};
        let pc <int> = cg_method_param_names(tmpl.str_val, pn, 64);
        if (pc <= 0) { delete pn; return ""; }
        // Positional inference from the actuals (template patterns are
        // erased to `void*`, so there is nothing to unify against).
        let bn <[string]> = new [string, 64]{};
        let bv <[string]> = new [string, 64]{};
        let bc <int> = 0;
        let cw <&AstNode> = node.left;
        let steps <int> = 0;
        let ok <bool> = true;
        while (cw != null) {
            if (steps >= 64) { ok = false; break; }
            let aa <&AstNode> = cw.left;
            if (aa == null) { aa = cw; }
            let asp <string> = cg_free_spelling_of(ctx, aa, depth - 1);
            if (cg_strlen(asp) == cast<ulong>(0)) { ok = false; break; }
            bc = cg_free_bind_positional(ctx, pn, pc, asp, bn, bv, bc);
            if (bc < 0) { ok = false; break; }
            cw = cw.right;
            steps = steps + 1;
        }
        if (!ok) { delete pn; delete bn; delete bv; return ""; }
        let oa <[string]> = new [string, 64]{};
        let oi <int> = 0;
        while (oi < pc) {
            let bbi <int> = cg_param_index(bn, bc, pn[oi]);
            if (bbi < 0) { delete pn; delete bn; delete bv; delete oa; return ""; }
            oa[oi] = bv[bbi];
            oi = oi + 1;
        }
        let ret <string> = "";
        if (tmpl.type_annotation != null) { ret = tmpl.type_annotation; }
        let out <string> = cg_subst_params(ret, pn, oa, pc, pc);
        delete pn;
        delete bn;
        delete bv;
        delete oa;
        return cg_trim_spaces(out);
    }
    // MM2: address-of/deref around an ident (`&a` with `a: int` spells
    // `int*`, matching the parser's `&T`-folds-to-`T*` parameter shape so
    // bare-T unify binds through the decoration, mirroring C++ unifyBinding
    // through a pointer). Anything else stays exotic ("").
    if (node.kind == ast_unary_expr() && node.left != null) {
        if (node.name != null && cg_str_eq(node.name, "&")) {
            let inner <string> = cg_free_spelling_of(ctx, node.left, depth - 1);
            if (cg_strlen(inner) == cast<ulong>(0)) { return ""; }
            let ib <Buffer> = new_buffer(64);
            ib.write_string(cg_trim_spaces(inner));
            ib.write_char('*');
            let spelled <string> = ib.to_string();
            free_buffer(ib);
            return spelled;
        }
        if (node.name != null && cg_str_eq(node.name, "*")) {
            let inner2 <string> = cg_free_spelling_of(ctx, node.left, depth - 1);
            if (cg_strlen(inner2) == cast<ulong>(0)) { return ""; }
            // One decoration level off (`*p` with `p: int*` spells `int`);
            // anything deeper stays on the stripped spelling, never guessed.
            let s2 <string> = cg_trim_spaces(inner2);
            let l2 <int> = cast<int>(cg_strlen(s2));
            if (l2 > 1 && cg_str_eq(substr(s2, l2 - 1, 1), "*")) {
                return cg_trim_spaces(substr(s2, 0, l2 - 1));
            }
            if (l2 > 1 && cg_str_eq(substr(s2, 0, 1), "&")) {
                return cg_trim_spaces(substr(s2, 1, l2 - 1));
            }
            return s2;
        }
    }
    // A `struct { ... }` literal marker (the parser tags it `$struct` and
    // stashes its declaration top-level): the seeding the checker reads off
    // the same node, so the declaration's own name is the spelling
    // monomorphization keys on. Anything else prototypal stays exotic.
    if (node.kind == ast_prototype_literal()) {
        if (node.type_annotation != null && cg_str_eq(node.type_annotation, "$struct") &&
          node.str_val != null && cg_strlen(node.str_val) > cast<ulong>(0)) {
            return node.str_val;
          }
        return "";
    }
    return "";
}

// Try the per-key free-function instance for a call: infer the bindings
// from the argument spellings, declare `name<args>` with them substituted
// and queue its body for the drain. Returns the instance, or null to stay
// on the old path (which owns every refusal). A refusal poisons ctx.
fun cg_free_cache_sym(ctx: &FnContext, n: &AstNode) <&FnSymbol> {
    if (ctx == null || n == null || n.left == null) { return null; }
    if (n.name == null || cg_strlen(n.name) == cast<ulong>(0)) { return null; }
    let nl <int> = cast<int>(cg_strlen(n.name));
    let di <int> = 0;
    while (di + 1 < nl) {
        if (cg_str_eq(substr(n.name, di, 2), "::")) { return null; }
        di = di + 1;
    }
    ctx.fn_sym_count = recount_fn_syms(ctx.fn_syms, ctx.fn_sym_count);
    let sym <&FnSymbol> = fn_ctx_find_fn(ctx, n.name);
    if (sym == null || sym.tmpl == null) { return null; }
    let tmpl <&AstNode> = sym.tmpl;
    if (tmpl.left == null) { return null; }
    if (tmpl.extra != null && tmpl.extra.name != null && cg_str_eq(tmpl.extra.name, "self")) { return null; }
    let pn <[string]> = new [string, 64]{};
    let pc <int> = cg_method_param_names(tmpl.str_val, pn, 64);
    if (pc <= 0) { delete pn; return null; }
    if (tmpl.str_val != null && cg_str_contains(tmpl.str_val, "Castable")) {
        cg_dprintf(2, "finc codegen refusal: the erasure marker 'Castable' on the generic function '%s' is not lowered yet\n", n.name);
        refuse_and_poison(ctx);
        delete pn;
        return null;
    }
    let bn <[string]> = new [string, 64]{};
    let bv <[string]> = new [string, 64]{};
    let bc <int> = 0;
    // Actual spellings in call order, for stamping the clone's parameters
    // (template patterns are erased to `void*`, so substitution alone
    // cannot recover them).
    let actuals <[string]> = new [string, 64]{};
    let acount <int> = 0;
    let cw <&AstNode> = n.left;
    let steps <int> = 0;
    let paired <bool> = true;
    while (cw != null) {
        if (steps >= 64 || acount >= 64) { paired = false; break; }
        let aa <&AstNode> = cw.left;
        if (aa == null) { aa = cw; }
        let asp <string> = cg_free_spelling_of(ctx, aa, 8);
        if (cg_strlen(asp) == cast<ulong>(0)) { paired = false; break; }
        actuals[acount] = asp;
        acount = acount + 1;
        bc = cg_free_bind_positional(ctx, pn, pc, asp, bn, bv, bc);
        if (bc < 0) { paired = false; break; }
        cw = cw.right;
        steps = steps + 1;
    }
    if (!paired) { delete pn; delete bn; delete bv; delete actuals; return null; }
    // MM2: bare-T unify through the declared patterns (`T` vs `int`,
    // `T*` vs `int*` via strip_markers, mirroring C++ unifyBinding through
    // a pointer). bind_positional above only fires for struct
    // instantiations (`Box<int>`); bare and pointer-decorated patterns need
    // this. Erased `void*` patterns unify to nothing, so over-struct calls
    // keep their existing binding. Exotic (pattern/actual count mismatch,
    // unmodellable actual) stays on the old path via the checks below.
    let pats <[string]> = new [string, 64]{};
    let pat_count <int> = 0;
    let pw2 <&AstNode> = tmpl.extra;
    while (pw2 != null && pat_count < 64) {
        if (pw2.type_annotation != null) { pats[pat_count] = pw2.type_annotation; }
        else { pats[pat_count] = ""; }
        pat_count = pat_count + 1;
        pw2 = pw2.right;
    }
    if (pat_count == acount && pat_count > 0) {
        let ui <int> = 0;
        let uok <bool> = true;
        while (ui < acount) {
            let nb <int> = cg_free_unify(pats[ui], actuals[ui], pn, bn, bv, pc, bc);
            if (nb < 0) { uok = false; break; }
            bc = nb;
            ui = ui + 1;
        }
        if (!uok) { delete pn; delete bn; delete bv; delete actuals; delete pats; return null; }
    }
    delete pats;
    // Bare-parameter fallback for interface-bounded free generics
    // (`print_any<T: Printable>(item: T)` called as `print_any::<User>(u)`):
    // the positional binder only binds through generic instantiations
    // (`Box<int>`), so a concrete `User` leaves `T` unbound. When the shape
    // is single-generic single-arg, bind the sole generic to the stripped
    // actual keyed on the concrete instantiation at the call site.
    // Anything else (multi-arg, generic actual, unmodellable) stays on the
    // old path, which owns every refusal.
    let unbound <int> = -1;
    let uncount <int> = 0;
    let uq <int> = 0;
    while (uq < pc) {
        if (cg_param_index(bn, bc, pn[uq]) < 0) {
            unbound = uq;
            uncount = uncount + 1;
        }
        uq = uq + 1;
    }
    if (uncount == 1 && pc == 1 && acount == 1) {
        let cand <string> = cg_trim_spaces(cg_strip_markers(actuals[0]));
        if (cg_strlen(cand) > cast<ulong>(0) && !cg_str_eq(cand, "Self") && !cg_is_generic_ann(ctx, cand)) {
            if (cg_free_modellable(ctx, cand, 8)) {
                bn[bc] = pn[unbound];
                bv[bc] = cand;
                bc = bc + 1;
            }
        }
    }
    let ni <int> = 0;
    while (ni < pc) {
        if (cg_param_index(bn, bc, pn[ni]) < 0) { delete pn; delete bn; delete bv; delete actuals; return null; }
        ni = ni + 1;
    }
    let mi <int> = 0;
    while (mi < pc) {
        let bbi <int> = cg_param_index(bn, bc, pn[mi]);
        if (!cg_free_modellable(ctx, bv[bbi], 8)) { delete pn; delete bn; delete bv; delete actuals; return null; }
        mi = mi + 1;
    }
    let ret_ann <string> = "";
    if (tmpl.type_annotation != null) { ret_ann = tmpl.type_annotation; }
    if (!cg_free_mentions_param(ret_ann, pn, pc)) {
        // MM2: procedures (`noret`/`void` returns like `swap`) instantiate
        // per key at any arity: the return names no layout, so there is
        // nothing to disagree on. A single-generic single-arg function with
        // a concrete return (`print_any<T: Printable>`, `rebox<T>(v: T)<int>`)
        // still instantiates per concrete receiver. Anything else keeps the
        // old refusal.
        let ret_void <bool> = cg_str_eq(cg_trim_spaces(ret_ann), "noret") || cg_str_eq(cg_trim_spaces(ret_ann), "void");
        if (!ret_void && !(pc == 1 && acount == 1 && bc == 1)) {
            cg_dprintf(2, "finc codegen refusal: free generic function '%s' with a concrete return is not lowered yet (needs monomorphization)\n", n.name);
            refuse_and_poison(ctx);
            delete pn;
            delete bn;
            delete bv;
            delete actuals;
            return null;
        }
    }
    let has_eq <bool> = cg_fn_uses_generic_eq(tmpl, false);
    let has_ne <bool> = cg_fn_uses_generic_eq(tmpl, true);
    if (sym.has_gen_eq) { has_eq = true; }
    if (sym.has_gen_ne) { has_ne = true; }
    if (has_eq || has_ne) {
        let ib <Buffer> = new_buffer(128);
        let ibi <int> = 0;
        while (ibi < pc) {
            if (ibi > 0) { ib.write_string(", "); }
            let xbi <int> = cg_param_index(bn, bc, pn[ibi]);
            ib.write_string(bv[xbi]);
            ibi = ibi + 1;
        }
        let inner <string> = ib.to_string();
        free_buffer(ib);
        if (has_eq) {
            if (cg_check_generic_eq_args(ctx, n.name, inner, false)) { delete pn; delete bn; delete bv; delete actuals; return null; }
        }
        if (has_ne) {
            if (cg_check_generic_eq_args(ctx, n.name, inner, true)) { delete pn; delete bn; delete bv; delete actuals; return null; }
        }
    }
    let kb <Buffer> = new_buffer(128);
    kb.write_string(n.name);
    kb.write_char('<');
    let kji <int> = 0;
    while (kji < pc) {
        if (kji > 0) { kb.write_string(", "); }
        let qi <int> = cg_param_index(bn, bc, pn[kji]);
        kb.write_string(bv[qi]);
        kji = kji + 1;
    }
    kb.write_char('>');
    let key <string> = kb.to_string();
    free_buffer(kb);
    let hit <&FnSymbol> = fn_ctx_find_fn(ctx, key);
    if (hit != null) { delete pn; delete bn; delete bv; delete actuals; return hit; }
    let oa <[string]> = new [string, 64]{};
    let oai <int> = 0;
    while (oai < pc) {
        let rbi <int> = cg_param_index(bn, bc, pn[oai]);
        oa[oai] = bv[rbi];
        oai = oai + 1;
    }
    let clone <&AstNode> = cg_clone_subst(tmpl, pn, oa, pc);
    delete pn;
    delete bn;
    delete bv;
    delete oa;
    if (clone == null) { delete actuals; return null; }
    clone.name = key;
    clone.right = null;
    clone.str_val = "";
    // `$struct`-handle instantiation targets (C++ structHandleTarget): each
    // handle parameter denotes its argument's own declaration, so a `st{}`
    // in the body builds that struct. Retargeted on the clone, beside the
    // stamping below, which gives the handle parameter the same spelling.
    let tp <&AstNode> = tmpl.extra;
    let tpi <int> = 0;
    while (tp != null && tpi < acount) {
        if (tp.type_annotation != null && cg_str_eq(cg_trim_spaces(tp.type_annotation), "$struct") &&
          tp.name != null && cg_strlen(tp.name) > cast<ulong>(0)) {
            cg_rewrite_handle_inits(clone, tp.name, actuals[tpi]);
          }
        tp = tp.right;
        tpi = tpi + 1;
    }
    // Stamp the clone's parameters with the actual spellings (the template
    // patterns are erased to `void*`, so substitution alone leaves them
    // erased and member reads cannot resolve). Arity already checked, so a
    // short clone refuses rather than misaligns. A `$struct` handle param
    // keeps its handle spelling: the seeding value is a tid word, never a
    // box, so stamping it struct would arm the by-value entry copy
    // (memcpy from the tid, NULL for index 0) while the `st{}` retarget
    // above already builds from the declaration name.
    let cp <&AstNode> = clone.extra;
    let sp <&AstNode> = tmpl.extra;
    let ai <int> = 0;
    while (cp != null) {
        if (ai >= acount) { delete actuals; return null; }
        let keep_handle <bool> = false;
        if (sp != null && sp.type_annotation != null && cg_str_eq(cg_trim_spaces(sp.type_annotation), "$struct")) {
            keep_handle = true;
        }
        if (!keep_handle) {
            cp.type_annotation = actuals[ai];
        }
        ai = ai + 1;
        cp = cp.right;
        if (sp != null) { sp = sp.right; }
    }
    delete actuals;
    ctx.fn_sym_count = declare_function(ctx.module, clone, ctx.fn_syms, ctx.fn_sym_count, ctx.interfaces, ctx.interface_count);
    let inst <&FnSymbol> = fn_ctx_find_fn(ctx, key);
    if (inst == null || inst.fn_val == null) {
        return null;
    }
    inst.tmpl = clone;
    inst.tmpl_done = false;
    return inst;
}

// Interface-dispatched method instances (`Printable_to_string` on a
// concrete receiver): the checker rewrites `item.to_string()` where
// `item: T` with `T: Printable` to `Printable_to_string`, which no
// lowering knows on a generic receiver (the monomorphization refusal
// below). When the receiver names a concrete instantiation at the call
// site, dispatch to the struct's own method (`User_to_string`) the way
// C++ does after substituting the outer generic. Keyed on the concrete
// receiver spelling; exotic (generic, unmodellable, missing struct or
// method) returns null and stays on the old path, which owns every
// refusal with a name (never silent). A refusal poisons ctx.
fun cg_interface_cache_sym(ctx: &FnContext, n: &AstNode) <&FnSymbol> {
    if (ctx == null || n == null || n.left == null) { return null; }
    if (n.name == null || cg_strlen(n.name) == cast<ulong>(0)) { return null; }
    let nlen <int> = cast<int>(cg_strlen(n.name));
    let us_at <int> = -1;
    let sui <int> = 0;
    while (sui < nlen) {
        if (cg_str_eq(substr(n.name, sui, 1), "_")) { us_at = sui; break; }
        sui = sui + 1;
    }
    if (us_at <= 0 || us_at + 1 >= nlen) { return null; }
    let prefix <string> = substr(n.name, 0, us_at);
    let suffix <string> = substr(n.name, us_at + 1, nlen - us_at - 1);
    if (cg_strlen(prefix) == cast<ulong>(0) || cg_strlen(suffix) == cast<ulong>(0)) { return null; }
    let iface <&InterfaceInfo> = find_interface(ctx, prefix);
    if (iface == null) { return null; }
    let m_info <&InterfaceMethodInfo> = find_interface_method(iface, suffix);
    if (m_info == null) { m_info = find_interface_method(iface, n.name); }
    if (m_info == null || m_info.is_field) { return null; }
    let first_wrap <&AstNode> = n.left;
    let rec_node <&AstNode> = first_wrap.left;
    if (rec_node == null) { rec_node = first_wrap; }
    if (rec_node != null && rec_node.kind == ast_unary_expr() && rec_node.left != null) {
        rec_node = rec_node.left;
    }
    let recv <string> = "";
    if (rec_node != null && rec_node.kind == ast_ident()) {
        if (rec_node.name == null || cg_strlen(rec_node.name) == cast<ulong>(0)) { return null; }
        let v <&LocalVar> = fn_ctx_find_var(ctx, rec_node.name);
        if (v == null || v.type_annotation == null) { return null; }
        recv = cg_trim_spaces(v.type_annotation);
    } else if (rec_node != null && rec_node.kind == ast_member_access()) {
        recv = cg_member_recv_spelling(ctx, rec_node);
        if (cg_strlen(recv) == cast<ulong>(0)) { return null; }
    } else {
        return null;
    }
    if (cg_strlen(recv) > cast<ulong>(1) && cg_str_eq(substr(recv, 0, 1), "&")) {
        recv = cg_trim_spaces(substr(recv, 1, cast<int>(cg_strlen(recv)) - 1));
    }
    let rlen <int> = cast<int>(cg_strlen(recv));
    if (rlen > 1 && cg_str_eq(substr(recv, rlen - 1, 1), "*")) {
        recv = cg_trim_spaces(substr(recv, 0, rlen - 1));
    }
    if (cg_strlen(recv) == cast<ulong>(0)) { return null; }
    if (cg_is_generic_ann(ctx, recv)) { return null; }
    if (cg_is_generic_ann(ctx, cg_strip_markers(recv))) { return null; }
    let base <string> = recv;
    let blen <int> = cast<int>(cg_strlen(base));
    let bi <int> = 0;
    while (bi < blen) {
        if (cg_str_eq(substr(base, bi, 1), "<")) { base = cg_trim_spaces(substr(base, 0, bi)); break; }
        bi = bi + 1;
    }
    if (cg_strlen(base) == cast<ulong>(0)) { return null; }
    let st <&StructInfo> = find_struct(ctx, base);
    if (st == null) { return null; }
    let b1 <Buffer> = new_buffer(64);
    b1.write_string(base);
    b1.write_char('.');
    b1.write_string(suffix);
    let dot_nm <string> = b1.to_string();
    free_buffer(b1);
    let b2 <Buffer> = new_buffer(64);
    b2.write_string(base);
    b2.write_char('_');
    b2.write_string(suffix);
    let un_nm <string> = b2.to_string();
    free_buffer(b2);
    let sym <&FnSymbol> = fn_ctx_find_fn(ctx, dot_nm);
    if (sym == null) { sym = fn_ctx_find_fn(ctx, un_nm); }
    if (sym != null) {
        if (sym.tmpl != null && sym.fn_val == null) { return null; }
        if (sym.fn_val != null) { return sym; }
        if (!ensure_template_instantiated(ctx, sym)) { return null; }
        if (sym.fn_val != null) { return sym; }
        return null;
    }
    return null;
}

// A per-key instance for a generic STATIC (`Collection::from_prototype`
// with a prototype of ints builds `Collection<int>`): the struct
// arguments are inferred from the prototype-literal argument's entries
// (keys bind the `{K,...}` side, values the `{...,V}` side; every entry
// must agree, and anything exotic falls back to the old path), the
// template clones with those arguments substituted, and the body drains
// with the rest. Returns the instance, or null to stay on the old path
// (which owns every refusal). A refusal poisons ctx.
// Per-key static instances for Self-rooted statics (the `normalize`
// shape): `static fun normalize(ptr: &Self)` called as
// `Vec2::normalize(scaled)` with `scaled: &Vec2<float>` declares and drains
// `Vec2<float>.normalize<>` with Self and the struct parameters bound to the
// actuals' spelling, mirroring C++ instantiateGenericMethod's
// per-mangled-name instances. Without this the call lowers the erased body,
// whose generic arithmetic guesses the representative width (int ops on
// float bits), while a direct `s.length()` on the same object instantiates
// float ops -- one program computing two answers. Only fires when every
// parameter past the injected self is Self-rooted and every actual names the
// same concrete `Base<...>` spelling with modellable segments; anything
// exotic returns null and stays on the eager path, which owns every refusal.
fun cg_static_self_cache_sym(ctx: &FnContext, st: &StructInfo, struct_name: string, mshort: string, tmpl: &AstNode, n: &AstNode) <&FnSymbol> {
    if (ctx == null || st == null || struct_name == null || mshort == null || tmpl == null || n == null) { return null; }
    if (tmpl.kind != ast_fun_decl() || tmpl.left == null) { return null; }
    // Only statics without their own generic parameters: an uninferred `U`
    // is exotic (a turbofish the call never spelled, per the C++ refusal).
    let mneed <[string]> = new [string, 64]{};
    let mn <int> = cg_method_param_names(tmpl.str_val, mneed, 64);
    delete mneed;
    if (mn > 0) { return null; }
    // Past the parser's injected `self` (which the call site feeds null for).
    let pw <&AstNode> = tmpl.extra;
    if (pw != null && pw.name != null && cg_str_eq(pw.name, "self")) {
        pw = pw.right;
    }
    if (pw == null) { return null; }
    let s_params <[string]> = new [string, 64]{};
    let scount <int> = cg_split_top(st.gen_params, s_params, 64);
    if (scount <= 0) { delete s_params; return null; }
    let s_args <[string]> = new [string, 64]{};
    let ai <int> = 0;
    while (ai < scount) { s_args[ai] = ""; ai = ai + 1; }
    let self_spelling <string> = "";
    let cw <&AstNode> = n.left;
    while (pw != null) {
        if (cw == null) { delete s_params; delete s_args; return null; }
        let pann <string> = "";
        if (pw.type_annotation != null) { pann = cg_trim_spaces(pw.type_annotation); }
        // Self-rooted parameters bind here: `Self` itself or the bare
        // owner the checker spells it as (`Vec2*`, `&Vec2<T>`). Anything
        // else is exotic.
        let pstrip <string> = cg_strip_markers(pann);
        let pbase <string> = pstrip;
        let pbi <int> = 0;
        while (pbi < cast<int>(cg_strlen(pbase))) {
            if (cg_str_eq(substr(pbase, pbi, 1), "<")) { pbase = cg_trim_spaces(substr(pbase, 0, pbi)); break; }
            pbi = pbi + 1;
        }
        if (!cg_str_eq(pstrip, "Self") && !cg_str_eq(pbase, struct_name)) { delete s_params; delete s_args; return null; }
        let aa <&AstNode> = cw.left;
        if (aa == null) { aa = cw; }
        if (aa == null || aa.kind != ast_ident()) { delete s_params; delete s_args; return null; }
        let v <&LocalVar> = fn_ctx_find_var(ctx, aa.name);
        if (v == null || v.type_annotation == null) { delete s_params; delete s_args; return null; }
        // Name the concrete instantiation (`&Vec2<float>` -> `Vec2<float>`).
        let full <string> = cg_trim_spaces(v.type_annotation);
        let rlen <int> = cast<int>(cg_strlen(full));
        if (rlen > 1 && cg_str_eq(substr(full, 0, 1), "&")) {
            full = cg_trim_spaces(substr(full, 1, rlen - 1));
            rlen = cast<int>(cg_strlen(full));
        }
        if (rlen > 1 && cg_str_eq(substr(full, rlen - 1, 1), "*")) {
            full = cg_trim_spaces(substr(full, 0, rlen - 1));
            rlen = cast<int>(cg_strlen(full));
        }
        // A Self-typed actual (a nested call inside another erased body)
        // names no instantiation: stay on the eager path.
        if (cg_str_eq(full, "Self") || cg_is_generic_ann(ctx, full)) { delete s_params; delete s_args; return null; }
        let open_at <int> = -1;
        let oi <int> = 0;
        while (oi < rlen) {
            if (cg_str_eq(substr(full, oi, 1), "<")) { open_at = oi; break; }
            oi = oi + 1;
        }
        if (open_at <= 0) { delete s_params; delete s_args; return null; }
        let close_at <int> = -1;
        let cj <int> = rlen - 1;
        while (cj > open_at) {
            if (cg_str_eq(substr(full, cj, 1), ">")) { close_at = cj; break; }
            cj = cj - 1;
        }
        if (close_at < 0) { delete s_params; delete s_args; return null; }
        let base <string> = cg_trim_spaces(substr(full, 0, open_at));
        let inner <string> = substr(full, open_at + 1, close_at - open_at - 1);
        if (!cg_str_eq(base, struct_name)) { delete s_params; delete s_args; return null; }
        if (cg_strlen(self_spelling) == cast<ulong>(0)) { self_spelling = full; }
        else if (!cg_str_eq(self_spelling, full)) { delete s_params; delete s_args; return null; }
        let parts <[string]> = new [string, 64]{};
        let acount <int> = cg_split_top(inner, parts, 64);
        if (acount != scount) { delete parts; delete s_params; delete s_args; return null; }
        let si <int> = 0;
        while (si < scount) {
            let seg <string> = cg_trim_spaces(parts[si]);
            if (cg_strlen(s_args[si]) == cast<ulong>(0)) { s_args[si] = seg; }
            else if (!cg_str_eq(s_args[si], seg)) { delete parts; delete s_params; delete s_args; return null; }
            si = si + 1;
        }
        delete parts;
        pw = pw.right;
        cw = cw.right;
    }
    if (cw != null) { delete s_params; delete s_args; return null; }
    if (cg_strlen(self_spelling) == cast<ulong>(0)) { delete s_params; delete s_args; return null; }
    let sg <int> = 0;
    while (sg < scount) {
        if (cg_strlen(s_args[sg]) == cast<ulong>(0) || !cg_modellable_seg(ctx, s_args[sg])) { delete s_params; delete s_args; return null; }
        sg = sg + 1;
    }
    // Same key shape as the prototype statics (`Base<args>.method<>`):
    // one declare + drained body per key, asking twice finds the first.
    let kb <Buffer> = new_buffer(128);
    kb.write_string(struct_name);
    kb.write_char('<');
    let kji <int> = 0;
    while (kji < scount) {
        if (kji > 0) { kb.write_string(", "); }
        kb.write_string(s_args[kji]);
        kji = kji + 1;
    }
    kb.write_char('>');
    kb.write_char('.');
    kb.write_string(mshort);
    kb.write_string("<>");
    let key <string> = kb.to_string();
    free_buffer(kb);
    let hit <&FnSymbol> = fn_ctx_find_fn(ctx, key);
    if (hit != null) { delete s_params; delete s_args; return hit; }
    let params <[string]> = new [string, 128]{};
    let args <[string]> = new [string, 128]{};
    let ti <int> = 0;
    while (ti < scount) {
        params[ti] = s_params[ti];
        args[ti] = s_args[ti];
        ti = ti + 1;
    }
    params[scount] = "Self";
    args[scount] = self_spelling;
    // The checker spells Self-rooted parameters with the bare owner
    // (`Vec2*`, not `&Self`), which no `Self`/`T` word matches: bind the
    // bare owner to the concrete spelling too, so the clone's locals read
    // the instantiation (`Vec2*` -> `Vec2<float>*`). Carriers hold 128 and
    // scount at most 64, so both entries always fit.
    params[scount + 1] = struct_name;
    args[scount + 1] = self_spelling;
    let clone <&AstNode> = cg_clone_subst(tmpl, params, args, scount + 2);
    delete params;
    delete args;
    delete s_params;
    delete s_args;
    if (clone == null) { return null; }
    clone.name = key;
    clone.right = null;
    clone.str_val = "";
    ctx.fn_sym_count = declare_function(ctx.module, clone, ctx.fn_syms, ctx.fn_sym_count, ctx.interfaces, ctx.interface_count);
    let sym <&FnSymbol> = fn_ctx_find_fn(ctx, key);
    if (sym == null || sym.fn_val == null) {
        return null;
    }
    sym.tmpl = clone;
    sym.tmpl_done = false;
    return sym;
}

// A Self-returning static with no bindable parameters (`zero()`) names no
// instantiation at the call: the caches above decline it and the eager body
// erases the arguments, so omitted struct defaults evaluate against the
// bare template (an int default for `x <T>` reads back garbage under a
// float instantiation). Where the `let` target names the concrete
// instantiation (`let v <&Vec2<float>> = Vec2::zero()`), instantiate per
// that spelling -- one declare + drained body per key, the same shape as
// the Self-rooted statics above. Anything exotic stays eager.
fun cg_static_expected_sym(ctx: &FnContext, struct_name: string, mshort: string, n: &AstNode) <&FnSymbol> {
    if (ctx == null || struct_name == null || mshort == null || n == null) { return null; }
    if (ctx.call_want == null || cg_strlen(ctx.call_want) == cast<ulong>(0)) { return null; }
    let st <&StructInfo> = find_struct(ctx, struct_name);
    if (st == null) { return null; }
    if (st.gen_params == null || cg_strlen(st.gen_params) == cast<ulong>(0)) { return null; }
    let tmpl <&AstNode> = cg_find_method_ast(ctx, struct_name, mshort);
    if (tmpl == null || tmpl.kind != ast_fun_decl() || tmpl.left == null) { return null; }
    // Only methods without their own generic parameters: an uninferred `U`
    // is exotic, like above.
    let mneed <[string]> = new [string, 64]{};
    let mn <int> = cg_method_param_names(tmpl.str_val, mneed, 64);
    delete mneed;
    if (mn > 0) { return null; }
    // Only Self/owner-returning statics: the key binds the construction
    // the body performs, nothing else.
    let ret <string> = "";
    if (tmpl.type_annotation != null) { ret = cg_trim_spaces(tmpl.type_annotation); }
    let rlen <int> = cast<int>(cg_strlen(ret));
    while (rlen > 1 && (cg_str_eq(substr(ret, 0, 1), "&") || cg_str_eq(substr(ret, 0, 1), "*"))) {
        ret = cg_trim_spaces(substr(ret, 1, rlen - 1));
        rlen = cast<int>(cg_strlen(ret));
    }
    while (rlen > 1 && cg_str_eq(substr(ret, rlen - 1, 1), "*")) {
        ret = cg_trim_spaces(substr(ret, 0, rlen - 1));
        rlen = cast<int>(cg_strlen(ret));
    }
    {
        let rcut <int> = rlen;
        let ri <int> = 0;
        while (ri < rlen) {
            if (cg_str_eq(substr(ret, ri, 1), "<")) { rcut = ri; break; }
            ri = ri + 1;
        }
        ret = cg_trim_spaces(substr(ret, 0, rcut));
    }
    if (!cg_str_eq(ret, "Self") && !cg_str_eq(ret, struct_name)) { return null; }
    // The expected spelling names the instantiation (`&Vec2<float>` ->
    // `Vec2<float>`); anything else stays eager.
    let full <string> = cg_trim_spaces(ctx.call_want);
    let flen <int> = cast<int>(cg_strlen(full));
    while (flen > 1 && (cg_str_eq(substr(full, 0, 1), "&") || cg_str_eq(substr(full, 0, 1), "*"))) {
        full = cg_trim_spaces(substr(full, 1, flen - 1));
        flen = cast<int>(cg_strlen(full));
    }
    while (flen > 1 && cg_str_eq(substr(full, flen - 1, 1), "*")) {
        full = cg_trim_spaces(substr(full, 0, flen - 1));
        flen = cast<int>(cg_strlen(full));
    }
    let open_at <int> = -1;
    let oi <int> = 0;
    while (oi < flen) {
        if (cg_str_eq(substr(full, oi, 1), "<")) { open_at = oi; break; }
        oi = oi + 1;
    }
    if (open_at <= 0) { return null; }
    let close_at <int> = -1;
    let cj <int> = flen - 1;
    while (cj > open_at) {
        if (cg_str_eq(substr(full, cj, 1), ">")) { close_at = cj; break; }
        cj = cj + 1;
    }
    if (close_at < 0) { return null; }
    let base <string> = cg_trim_spaces(substr(full, 0, open_at));
    if (!cg_str_eq(base, struct_name)) { return null; }
    let inner <string> = substr(full, open_at + 1, close_at - open_at - 1);
    let s_params <[string]> = new [string, 64]{};
    let s_args <[string]> = new [string, 64]{};
    let scount <int> = cg_split_top(st.gen_params, s_params, 64);
    let acount <int> = cg_split_top(inner, s_args, 64);
    if (scount <= 0 || acount != scount) { delete s_params; delete s_args; return null; }
    let gi <int> = 0;
    while (gi < scount) {
        s_args[gi] = cg_trim_spaces(s_args[gi]);
        if (cg_strlen(s_args[gi]) == cast<ulong>(0) || cg_str_eq(s_args[gi], "Self") || cg_is_generic_ann(ctx, s_args[gi])) { delete s_params; delete s_args; return null; }
        if (!cg_modellable_seg(ctx, s_args[gi])) { delete s_params; delete s_args; return null; }
        gi = gi + 1;
    }
    // Same key shape as the caches above (`Base<args>.method<>`): one
    // declare + drained body per key, asking twice finds the first.
    let kb <Buffer> = new_buffer(128);
    kb.write_string(struct_name);
    kb.write_char('<');
    let kji <int> = 0;
    while (kji < scount) {
        if (kji > 0) { kb.write_string(", "); }
        kb.write_string(s_args[kji]);
        kji = kji + 1;
    }
    kb.write_char('>');
    kb.write_char('.');
    kb.write_string(mshort);
    kb.write_string("<>");
    let key <string> = kb.to_string();
    free_buffer(kb);
    let hit <&FnSymbol> = fn_ctx_find_fn(ctx, key);
    if (hit != null) { delete s_params; delete s_args; return hit; }
    let inner_b <Buffer> = new_buffer(64);
    let iji <int> = 0;
    while (iji < scount) {
        if (iji > 0) { inner_b.write_string(", "); }
        inner_b.write_string(s_args[iji]);
        iji = iji + 1;
    }
    let inner_j <string> = inner_b.to_string();
    free_buffer(inner_b);
    let has_eq <bool> = cg_fn_uses_generic_eq(tmpl, false);
    let has_ne <bool> = cg_fn_uses_generic_eq(tmpl, true);
    let disp_b <Buffer> = new_buffer(64);
    disp_b.write_string(struct_name);
    disp_b.write_char('.');
    disp_b.write_string(mshort);
    let disp <string> = disp_b.to_string();
    free_buffer(disp_b);
    if (has_eq) {
        if (cg_check_generic_eq_args(ctx, disp, inner_j, false)) { delete s_params; delete s_args; return null; }
    }
    if (has_ne) {
        if (cg_check_generic_eq_args(ctx, disp, inner_j, true)) { delete s_params; delete s_args; return null; }
    }
    let params <[string]> = new [string, 128]{};
    let args <[string]> = new [string, 128]{};
    let ti <int> = 0;
    while (ti < scount) {
        params[ti] = s_params[ti];
        args[ti] = s_args[ti];
        ti = ti + 1;
    }
    params[scount] = "Self";
    args[scount] = full;
    params[scount + 1] = struct_name;
    args[scount + 1] = full;
    let clone <&AstNode> = cg_clone_subst(tmpl, params, args, scount + 2);
    delete params;
    delete args;
    delete s_params;
    delete s_args;
    if (clone == null) { return null; }
    clone.name = key;
    clone.right = null;
    clone.str_val = "";
    ctx.fn_sym_count = declare_function(ctx.module, clone, ctx.fn_syms, ctx.fn_sym_count, ctx.interfaces, ctx.interface_count);
    let sym <&FnSymbol> = fn_ctx_find_fn(ctx, key);
    if (sym == null || sym.fn_val == null) {
        return null;
    }
    sym.tmpl = clone;
    sym.tmpl_done = false;
    return sym;
}

fun cg_static_cache_sym(ctx: &FnContext, struct_name: string, mshort: string, n: &AstNode) <&FnSymbol> {
    if (ctx == null || struct_name == null || mshort == null || n == null) { return null; }
    if (cg_strlen(struct_name) == cast<ulong>(0) || cg_strlen(mshort) == cast<ulong>(0)) { return null; }
    let st <&StructInfo> = find_struct(ctx, struct_name);
    if (st == null) { return null; }
    if (st.gen_params == null || cg_strlen(st.gen_params) == cast<ulong>(0)) { return null; }
    let tmpl <&AstNode> = cg_find_method_ast(ctx, struct_name, mshort);
    if (tmpl == null || tmpl.kind != ast_fun_decl() || tmpl.left == null) { return null; }
    // Self-rooted statics (`normalize(ptr: &Self)`) instantiate per
    // concrete call spelling beside the prototype shape below; the eager
    // path still owns anything exotic (which returns null there).
    let self_hit <&FnSymbol> = cg_static_self_cache_sym(ctx, st, struct_name, mshort, tmpl, n);
    if (self_hit != null) { return self_hit; }
    // Methods (a leading `self`) belong to the receiver cache; only
    // statics instantiate here. Statics still declare the parser's
    // injected `self` first (the call site feeds null for it), so the
    // walk starts past a leading `self`.
    let pw0 <&AstNode> = tmpl.extra;
    if (pw0 != null && pw0.name != null && cg_str_eq(pw0.name, "self")) {
        pw0 = pw0.right;
    }
    // The template's prototype parameter (`prtp: {int, T}`): the sides
    // name either struct parameters (bound from the argument) or
    // concrete spellings (needing no binding).
    let s_params <[string]> = new [string, 64]{};
    let scount <int> = cg_split_top(st.gen_params, s_params, 64);
    if (scount <= 0) { delete s_params; return null; }
    let pk <string> = "";
    let pv <string> = "";
    let pw <&AstNode> = pw0;
    let cw <&AstNode> = n.left;
    while (pw != null) {
        if (cw == null) { delete s_params; return null; }
        let pann <string> = "";
        if (pw.type_annotation != null) { pann = cg_trim_spaces(pw.type_annotation); }
        let aa <&AstNode> = cw.left;
        if (aa == null) { aa = cw; }
        if (cg_strlen(pann) > cast<ulong>(2) && cg_str_eq(substr(pann, 0, 1), "{")) {
            let plen <int> = cast<int>(cg_strlen(pann));
            if (!cg_str_eq(substr(pann, plen - 1, 1), "}")) { delete s_params; return null; }
            let sides <[string]> = new [string, 64]{};
            let nside <int> = cg_split_top(substr(pann, 1, plen - 2), sides, 64);
            if (nside != 2) { delete sides; delete s_params; return null; }
            pk = cg_trim_spaces(sides[0]);
            pv = cg_trim_spaces(sides[1]);
            delete sides;
            // Only single-prototype statics instantiate (the
            // from_prototype shape); anything else stays eager.
            if (pw.right != null || cw.right != null) { delete s_params; return null; }
            if (aa == null || aa.kind != ast_prototype_literal()) { delete s_params; return null; }
            // Scan the entries: keys bind the K side, values the V
            // side, unanimously. An exotic entry falls back to eager.
            let kspell <string> = "";
            let vspell <string> = "";
            let ecur <&AstNode> = aa.left;
            if (ecur == null) { delete s_params; return null; }
            while (ecur != null) {
                if (ecur.left == null || ecur.right == null) { delete s_params; return null; }
                let ek <string> = cg_infer_arg_spelling(ctx, ecur.left);
                let ev <string> = cg_infer_arg_spelling(ctx, ecur.right);
                if (cg_strlen(ek) == cast<ulong>(0) || cg_strlen(ev) == cast<ulong>(0)) { delete s_params; return null; }
                if (cg_strlen(kspell) == cast<ulong>(0)) { kspell = ek; }
                else if (!cg_str_eq(kspell, ek)) { delete s_params; return null; }
                if (cg_strlen(vspell) == cast<ulong>(0)) { vspell = ev; }
                else if (!cg_str_eq(vspell, ev)) { delete s_params; return null; }
                ecur = ecur.extra;
            }
            let s_args <[string]> = new [string, 64]{};
            let ai <int> = 0;
            while (ai < scount) {
                s_args[ai] = "";
                ai = ai + 1;
            }
            // Each struct parameter takes its spelling from the side
            // naming it; a parameter named by neither side (or by both
            // sides differently) is exotic.
            let si <int> = 0;
            while (si < scount) {
                let on_k <bool> = cg_str_eq(s_params[si], pk);
                let on_v <bool> = cg_str_eq(s_params[si], pv);
                if (on_k && on_v) {
                    if (!cg_str_eq(kspell, vspell)) { delete s_args; delete s_params; return null; }
                    s_args[si] = kspell;
                } else if (on_k) {
                    s_args[si] = kspell;
                } else if (on_v) {
                    s_args[si] = vspell;
                } else {
                    delete s_args; delete s_params; return null;
                }
                si = si + 1;
            }
            // Every inferred side must be modellable, or the old path
            // owns it.
            let sg <int> = 0;
            while (sg < scount) {
                if (!cg_modellable_seg(ctx, s_args[sg])) { delete s_args; delete s_params; return null; }
                sg = sg + 1;
            }
            // ADR 0036 first, as in the method cache: a body comparing a
            // generic value refuses when the arguments name a struct
            // without the operator.
            let has_eq <bool> = cg_fn_uses_generic_eq(tmpl, false);
            let has_ne <bool> = cg_fn_uses_generic_eq(tmpl, true);
            let disp_b <Buffer> = new_buffer(64);
            disp_b.write_string(struct_name);
            disp_b.write_char('.');
            disp_b.write_string(mshort);
            let disp <string> = disp_b.to_string();
            free_buffer(disp_b);
            let inner_b <Buffer> = new_buffer(64);
            let ij <int> = 0;
            while (ij < scount) {
                if (ij > 0) { inner_b.write_string(", "); }
                inner_b.write_string(s_args[ij]);
                ij = ij + 1;
            }
            let inner <string> = inner_b.to_string();
            free_buffer(inner_b);
            if (has_eq) {
                if (cg_check_generic_eq_args(ctx, disp, inner, false)) { delete s_args; delete s_params; return null; }
            }
            if (has_ne) {
                if (cg_check_generic_eq_args(ctx, disp, inner, true)) { delete s_args; delete s_params; return null; }
            }
            let kb <Buffer> = new_buffer(128);
            kb.write_string(struct_name);
            kb.write_char('<');
            kb.write_string(inner);
            kb.write_char('>');
            kb.write_char('.');
            kb.write_string(mshort);
            kb.write_string("<>");
            let key <string> = kb.to_string();
            free_buffer(kb);
            let hit <&FnSymbol> = fn_ctx_find_fn(ctx, key);
            if (hit != null) { delete s_args; delete s_params; return hit; }
            let clone <&AstNode> = cg_clone_subst(tmpl, s_params, s_args, scount);
            delete s_args;
            delete s_params;
            if (clone == null) { return null; }
            clone.name = key;
            clone.right = null;
            clone.str_val = "";
            ctx.fn_sym_count = declare_function(ctx.module, clone, ctx.fn_syms, ctx.fn_sym_count, ctx.interfaces, ctx.interface_count);
            let sym <&FnSymbol> = fn_ctx_find_fn(ctx, key);
            if (sym == null || sym.fn_val == null) {
                return null;
            }
            sym.tmpl = clone;
            sym.tmpl_done = false;
            return sym;
        }
        pw = pw.right;
        cw = cw.right;
    }
    // Last: a Self-returning static the shapes above decline (`zero()`)
    // instantiates per the `let` target spelling, where one names it.
    let exp_hit <&FnSymbol> = cg_static_expected_sym(ctx, struct_name, mshort, n);
    if (exp_hit != null) { delete s_params; return exp_hit; }
    delete s_params;
    return null;
}

// True for unsigned Fin integer spellings (checker.fin chk_int_is_signed
// mirrored for the `>>` lowering branch below). A written width rides
// along (`uint{16}` from a resolved `u16` alias): strip it first, the way
// the checker strips before asking the same question.
priv fun cg_spelling_unsigned(spelling: string) <bool> {
    if (spelling == null) { return false; }
    let b <string> = spelling;
    let blen <int> = cast<int>(cg_strlen(b));
    let bi <int> = 0;
    while (bi < blen) {
        if (cg_str_eq(substr(b, bi, 1), "{")) {
            b = substr(b, 0, bi);
            break;
        }
        bi = bi + 1;
    }
    if (cg_str_eq(b, "uint") || cg_str_eq(b, "ushort") || cg_str_eq(b, "ulong") ||
      cg_str_eq(b, "u8") || cg_str_eq(b, "u16") || cg_str_eq(b, "u32") ||
      cg_str_eq(b, "u64") || cg_str_eq(b, "usize") || cg_str_eq(b, "size_t")) {
        return true;
      }
    return false;
}

// Signedness of an integer value operand (C++ lowers unsigned `/`, `%`,
// `>>` and ordering comparisons with `udiv`/`urem`/`lshr`/unsigned
// predicates). Literals answer `int`; bindings read their annotation;
// casts read their target; a computed integer keeps its left side's
// signedness. Anything else (members, calls) answers signed — the
// historic unconditional-signed behavior.
// ponytail: member/call LHS defaults signed; resolve field/return
// spellings if an unsigned member ever needs unsigned arithmetic.
priv fun cg_value_is_unsigned(ctx: &FnContext, node: &AstNode) <bool> {
    if (node == null) { return false; }
    if (node.kind == ast_unary_expr() && cg_str_eq(node.name, "cast")) {
        return cg_spelling_unsigned(node.type_annotation);
    }
    if (node.kind == ast_ident()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, node.name);
        if (v == null || v.type_annotation == null) { return false; }
        let a <string> = cg_trim_spaces(v.type_annotation);
        if (cg_strlen(a) > cast<ulong>(1) && cg_str_eq(substr(a, 0, 1), "&")) {
            a = substr(a, 1, cast<int>(cg_strlen(a)) - 1);
        }
        let alen <int> = cast<int>(cg_strlen(a));
        if (alen > 1 && (cg_str_eq(substr(a, alen - 1, 1), "*") || cg_str_eq(substr(a, alen - 1, 1), "?"))) {
            a = substr(a, 0, alen - 1);
        }
        return cg_spelling_unsigned(cg_trim_spaces(a));
    }
    if (node.kind == ast_literal_int()) { return false; }
    if (node.kind == ast_binary_expr() && node.name != null) {
        if (cg_str_eq(node.name, "<<") || cg_str_eq(node.name, ">>") ||
          cg_str_eq(node.name, "+") || cg_str_eq(node.name, "-") ||
          cg_str_eq(node.name, "*") || cg_str_eq(node.name, "/") ||
          cg_str_eq(node.name, "%") || cg_str_eq(node.name, "&") ||
          cg_str_eq(node.name, "|") || cg_str_eq(node.name, "^")) {
            return cg_value_is_unsigned(ctx, node.left);
          }
        return false;
    }
    return false;
}

// Short name after `Prefix_` (`Right_m` -> `m` under `Right`).
// Full when no such prefix: interface fields are bare already.
fun cg_short_of(full: string, prefix: string) <string> {
    if (full == null || prefix == null) { return full; }
    let plen <int> = cast<int>(cg_strlen(prefix));
    let flen <int> = cast<int>(cg_strlen(full));
    if (plen <= 0 || flen <= plen + 1) { return full; }
    if (cg_str_eq(substr(full, 0, plen), prefix) && cg_str_eq(substr(full, plen, 1), "_")) {
        return substr(full, plen + 1, flen - plen - 1);
    }
    return full;
}

// Whether struct s declares a method/operator with short name want.
// Walks the recorded method chain (operators live there too); the
// `[]=`/`=` leniency mirrors the normative predicate (stdlib
// operators.fin:126 requires `operator []=`, corpus structs write
// `operator =`).
fun cg_struct_has_short(s: &StructInfo, want: string) <bool> {
    if (s == null || want == null) { return false; }
    let m <&AstNode> = s.method_head;
    while (m != null) {
        let short <string> = cg_short_of(m.name, s.name);
        if (cg_str_eq(short, want)) { return true; }
        if (cg_str_eq(want, "operator[]=") && cg_str_eq(short, "operator=")) { return true; }
        m = m.right;
    }
    return false;
}

// Static conformance for concrete named pairs (Stage B predicate,
// fields+methods+operators+dtor; ctors stay unmodelled and are reported,
// never guessed).
fun cg_implements_conforms(ctx: &FnContext, s_name: string, i_name: string) <bool> {
    let s <&StructInfo> = find_struct(ctx, s_name);
    let i <&InterfaceInfo> = find_interface(ctx, i_name);
    if (s == null || i == null) { return false; }
    let mi <int> = 0;
    while (mi < i.method_count) {
        let im <&InterfaceMethodInfo> = i.methods[mi];
        if (im != null) {
            if (im.is_field) {
                let found <bool> = false;
                let fi <int> = 0;
                while (fi < s.field_count) {
                    let f <&StructFieldInfo> = s.fields[fi];
                    if (f != null && cg_str_eq(f.name, im.name)) {
                        let s_ty <&LLVMType> = map_type(ctx, f.type_annotation);
                        let i_ty <&LLVMType> = map_type(ctx, im.ret_type);
                        if (s_ty == i_ty) { found = true; }
                        break;
                    }
                    fi = fi + 1;
                }
                if (!found) { return false; }
            } else {
                let want <string> = cg_short_of(im.name, i.name);
                if (!cg_struct_has_short(s, want)) { return false; }
            }
        }
        mi = mi + 1;
    }
    return true;
}

pub fun lower_expr(ctx: &FnContext, n: &AstNode) <&LLVMValue> {
    if (n == null) { return null; }

    if (n.kind == ast_literal_int()) {
        // Float literals arrive as int nodes with the annotation carrying
        // float-ness (no float literal kind in ast::std yet). When the
        // parser preserves the written text in str_val, lower the exact
        // fraction; otherwise fall back to the int value (callers coerce).
        if (n.type_annotation != null && (cg_str_eq(n.type_annotation, "float") || cg_str_eq(n.type_annotation, "f32"))) {
            if (n.str_val != null && cg_strlen(n.str_val) > cast<ulong>(0)) {
                return llvm_const_real_of_string(ctx.float_ty, n.str_val);
            }
        }
        if (n.type_annotation != null && (cg_str_eq(n.type_annotation, "double") || cg_str_eq(n.type_annotation, "f64"))) {
            if (n.str_val != null && cg_strlen(n.str_val) > cast<ulong>(0)) {
                return llvm_const_real_of_string(ctx.double_ty, n.str_val);
            }
        }
        if (n.str_val != null && cg_strlen(n.str_val) > cast<ulong>(0)) {
            // Out-of-int-range decimal text preserved by the parser (the C++
            // frontend types such literals long): the full 64-bit value.
            return llvm_const_int_of_string(ctx.i64_ty, n.str_val, 10);
        }
        return llvm_const_int(ctx.i32_ty, n.int_val, 0);
    }
    if (n.kind == ast_literal_bool()) {
        return llvm_const_int(ctx.i1_ty, n.int_val, 0);
    }
    if (n.kind == ast_literal_string()) {
        let unesc <string> = unescape_string_literal(n.str_val);
        return llvm_build_global_string_ptr(ctx.builder, unesc, "str");
    }
    if (n.kind == ast_ident()) {
        // `m1778` is a literal meaning "not implemented" (the C++ frontend
        // lexes it as its own token and refuses it wherever lowering reaches
        // it). The checker types it `void*` and says nothing, so the refusal
        // lives here, in every position, with the reference's message.
        if (cg_str_eq(n.name, "m1778")) {
            cg_dprintf(2, "codegen: 'm1778' is not lowered yet (at '%s':%d)\n", ctx.src_file, n.line);
            refuse_and_poison(ctx);
            return null;
        }
        if (cg_str_eq(n.name, "NULL") || cg_str_eq(n.name, "null")) {
            return llvm_const_null(ctx.ptr_ty);
        }
        if (cg_str_eq(n.name, "true")) {
            return llvm_const_int(ctx.i1_ty, 1, 0);
        }
        if (cg_str_eq(n.name, "false")) {
            return llvm_const_int(ctx.i1_ty, 0, 0);
        }
        let v <&LocalVar> = fn_ctx_find_var(ctx, n.name);
        if (v != null) {
            if (v.ty == ctx.fat_ptr_ty && v.type_annotation != null && cg_strlen(v.type_annotation) > cast<ulong>(0) && cg_str_eq(substr(v.type_annotation, 0, 1), "[")) {
                let p0 <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, ctx.fat_ptr_ty, v.val, 0, "slice_buf");
                return llvm_build_load2(ctx.builder, ctx.ptr_ty, p0, n.name);
            }
            return llvm_build_load2(ctx.builder, v.ty, v.val, n.name);
        }
        // Module-level globals (including `#cdef` constants, which parse as
        // top-level lets) live outside any function scope.
        let gv <&LLVMValue> = llvm_get_named_global(ctx.module, n.name);
        if (gv != null) {
            let gv_ty <&LLVMType> = llvm_global_get_value_type(gv);
            if (gv_ty != null) {
                return llvm_build_load2(ctx.builder, gv_ty, gv, n.name);
            }
        }
        let em <&EnumMemberInfo> = find_enum_member_global(ctx, n.name);
        if (em != null) {
            let en_owner <&EnumInfo> = find_enum_for_member(ctx, em.name);
            if (en_owner != null && en_owner.has_payload) {
                let slot <&LLVMValue> = llvm_build_alloca(ctx.builder, en_owner.llvm_type, "enum.tmp");
                let tag_ptr <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, en_owner.llvm_type, slot, 0, "tag");
                llvm_build_store(ctx.builder, llvm_const_int(ctx.i32_ty, em.tag, 0), tag_ptr);
                return llvm_build_load2(ctx.builder, en_owner.llvm_type, slot, "enum.val");
            }
            return llvm_const_int(ctx.i32_ty, em.tag, 0);
        }
        // A bare function name is a first-class value (passing `add` as a
        // callback). Variables shadow functions: var lookup above runs first.
        let fsym <&FnSymbol> = fn_ctx_find_fn(ctx, n.name);
        if (fsym != null && fsym.fn_val != null) {
            return fsym.fn_val;
        }
        let mfn <&LLVMValue> = llvm_get_named_function(ctx.module, n.name);
        if (mfn != null) {
            return mfn;
        }
        return null;
    }
    if (n.kind == ast_unary_expr()) {
        if (cg_str_eq(n.name, "cast")) {
            let inner <&LLVMValue> = lower_expr(ctx, n.left);
            if (inner == null) { return null; }
            if (n.type_annotation != null) {
                let target_ty <&LLVMType> = map_type(ctx, n.type_annotation);
                return coerce_val(ctx, inner, target_ty);
            }
            return inner;
        }
        if (cg_str_eq(n.name, "&")) {
            if (n.left != null) {
                if (n.left.kind == ast_ident()) {
                    let v <&LocalVar> = fn_ctx_find_var(ctx, n.left.name);
                    if (v != null) {
                        // `&self` is the address of the slot keeping the
                        // receiver pointer, like every other `&ident`
                        // (the C++ backend reads it the same way: a
                        // pointer's address is where it is kept). Taking
                        // the loaded box instead would alias the live
                        // object, so `self.restrict = &self` in a
                        // constructor would stay live while C++ reads the
                        // dead constructor slot.
                        // Heap-struct value locals hold the object as a heap
                        // box pointer: the object's address is the loaded box,
                        // not the slot (which would be a pointer-to-pointer).
                        if (cg_is_heap_struct_value(ctx, v)) {
                            return llvm_build_load2(ctx.builder, v.ty, v.val, "struct_p");
                        }
                        return v.val;
                    }
                    // A module-level global has no function-scope slot: its
                    // address is the global itself (C++ folds `&G` the same
                    // way). Without this the initializer `let p = &G` and
                    // `return &G` lower to null and refuse downstream.
                    let gv_addr <&LLVMValue> = llvm_get_named_global(ctx.module, n.left.name);
                    if (gv_addr != null) {
                        return gv_addr;
                    }
                } else if (n.left.kind == ast_index_expr()) {
                    let arr_val <&LLVMValue> = lower_expr(ctx, n.left.left);
                    let idx_val <&LLVMValue> = lower_expr(ctx, n.left.right);
                    if (arr_val != null && idx_val != null) {
                        if (is_ref_array_base(ctx, n.left.left)) {
                            arr_val = llvm_build_load2(ctx.builder, ctx.ptr_ty, arr_val, "ref_arr");
                        }
                        let idx_i64 <&LLVMValue> = llvm_build_sext(ctx.builder, idx_val, ctx.i64_ty, "idx64");
                        let ind <&LLVMIndices> = new LLVMIndices{};
                        ind.i0 = idx_i64;
                        let elem_ty <&LLVMType> = get_index_elem_type(ctx, n.left.left);
                        let stride_ty <&LLVMType> = elem_ty;
                        if (cg_member_array_wide(ctx, n.left.left, elem_ty)) { stride_ty = ctx.i64_ty; }
                        let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, stride_ty, arr_val, ind, 1, "arr_gep");
                        delete ind;
                        return gep;
                    }
                } else if (n.left.kind == ast_member_access()) {
                    let base_val <&LLVMValue> = lower_expr(ctx, n.left.left);
                    let f_idx <int> = find_field_index(ctx, n.left.left, n.left.name);
                    if (base_val != null) {
                        let ind <&LLVMIndices> = new LLVMIndices{};
                        ind.i0 = llvm_const_int(ctx.i64_ty, f_idx, 0);
                        let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, base_val, ind, 1, "field_gep");
                        delete ind;
                        return gep;
                    }
                }
            }
            return null;
        }
        if (cg_str_eq(n.name, "*")) {
            let ptr_val <&LLVMValue> = lower_expr(ctx, n.left);
            if (ptr_val != null) {
                let load_ty <&LLVMType> = ctx.i32_ty;
                let deref_count <int> = 1;
                let cur_inner <&AstNode> = n.left;
                while (cur_inner != null && cur_inner.kind == ast_unary_expr() && cg_str_eq(cur_inner.name, "*")) {
                    deref_count++;
                    cur_inner = cur_inner.left;
                }
                if (cur_inner != null && cur_inner.kind == ast_ident()) {
                    let v <&LocalVar> = fn_ctx_find_var(ctx, cur_inner.name);
                    if (v != null && v.type_annotation != null) {
                        let t <string> = v.type_annotation;
                        let t_len <int> = cast<int>(cg_strlen(t));
                        let ptr_stars <int> = 0;
                        let pi <int> = 0;
                        while (pi < t_len) {
                            let ch <string> = substr(t, pi, 1);
                            if (cg_str_eq(ch, "*") || cg_str_eq(ch, "&")) {
                                ptr_stars++;
                            }
                            pi++;
                        }
                        if (ptr_stars > deref_count) {
                            load_ty = ctx.ptr_ty;
                        } else {
                            // Fully dereferenced: what sits behind the last
                            // pointer decides. A struct stays a pointer (heap
                            // structs have no by-value form); anything else
                            // falls back to the scalar convention.
                            let base_ann <string> = t;
                            let blen <int> = cast<int>(cg_strlen(base_ann));
                            while (blen > 0 && (cg_str_eq(substr(base_ann, 0, 1), "&") || cg_str_eq(substr(base_ann, 0, 1), "*"))) {
                                base_ann = substr(base_ann, 1, blen - 1);
                                blen = blen - 1;
                            }
                            while (blen > 0 && cg_str_eq(substr(base_ann, blen - 1, 1), "*")) {
                                base_ann = substr(base_ann, 0, blen - 1);
                                blen = blen - 1;
                            }
                            let lt <int> = 0;
                            while (lt < blen) {
                                if (cg_str_eq(substr(base_ann, lt, 1), "<")) {
                                    base_ann = substr(base_ann, 0, lt);
                                    break;
                                }
                                lt = lt + 1;
                            }
                            if (cg_strlen(base_ann) > cast<ulong>(0) && find_struct(ctx, base_ann) != null) {
                                return ptr_val;
                            }
                            load_ty = map_type(ctx, t);
                            if (load_ty == ctx.ptr_ty && ptr_stars == deref_count) {
                                load_ty = ctx.i32_ty;
                            }
                        }
                    }
                }
                if (cur_inner != null && cur_inner.kind == ast_member_access()) {
                    // `*a.restrict`: the member holds a pointer; one `*`
                    // peels one level exactly like the ident rule above. A
                    // struct behind the last pointer stays a pointer (heap
                    // structs have no by-value form, and by-value struct
                    // parameters pass the box through); anything else
                    // falls back to the scalar convention below.
                    let f_ann <string> = cg_member_field_ann(ctx, cur_inner.left, cur_inner.name);
                    if (cg_strlen(f_ann) > cast<ulong>(0)) {
                        let f_len <int> = cast<int>(cg_strlen(f_ann));
                        let f_stars <int> = 0;
                        let fpi <int> = 0;
                        while (fpi < f_len) {
                            let fch <string> = substr(f_ann, fpi, 1);
                            if (cg_str_eq(fch, "*") || cg_str_eq(fch, "&")) {
                                f_stars++;
                            }
                            fpi++;
                        }
                        if (f_stars > deref_count) {
                            load_ty = ctx.ptr_ty;
                        } else {
                            let f_base <string> = f_ann;
                            let f_blen <int> = cast<int>(cg_strlen(f_base));
                            while (f_blen > 0 && (cg_str_eq(substr(f_base, 0, 1), "&") || cg_str_eq(substr(f_base, 0, 1), "*"))) {
                                f_base = substr(f_base, 1, f_blen - 1);
                                f_blen = f_blen - 1;
                            }
                            while (f_blen > 0 && cg_str_eq(substr(f_base, f_blen - 1, 1), "*")) {
                                f_base = substr(f_base, 0, f_blen - 1);
                                f_blen = f_blen - 1;
                            }
                            let flt <int> = 0;
                            while (flt < f_blen) {
                                if (cg_str_eq(substr(f_base, flt, 1), "<")) {
                                    f_base = substr(f_base, 0, flt);
                                    break;
                                }
                                flt = flt + 1;
                            }
                            if (cg_strlen(f_base) > cast<ulong>(0) && find_struct(ctx, f_base) != null) {
                                return ptr_val;
                            }
                            load_ty = map_type(ctx, f_ann);
                            if (load_ty == ctx.ptr_ty && f_stars == deref_count) {
                                load_ty = ctx.i32_ty;
                            }
                        }
                    }
                }
                return llvm_build_load2(ctx.builder, load_ty, ptr_val, "deref");
            }
            return null;
        }
        if (cg_str_eq(n.name, "++")) {
            if (n.left != null) {
                if (n.left.kind == ast_ident()) {
                    let v <&LocalVar> = fn_ctx_find_var(ctx, n.left.name);
                    if (v != null) {
                        let cur_val <&LLVMValue> = llvm_build_load2(ctx.builder, v.ty, v.val, n.left.name);
                        if (v.ty == ctx.float_ty || v.ty == ctx.double_ty) {
                            let one_r <&LLVMValue> = llvm_const_real_of_string(v.ty, "1.0");
                            let next_val <&LLVMValue> = llvm_build_fadd(ctx.builder, cur_val, one_r, "inc");
                            llvm_build_store(ctx.builder, next_val, v.val);
                            return cur_val;
                        }
                        let one <&LLVMValue> = llvm_const_int(v.ty, 1, 0);
                        let next_val <&LLVMValue> = llvm_build_add(ctx.builder, cur_val, one, "inc");
                        llvm_build_store(ctx.builder, next_val, v.val);
                        return cur_val;
                    }
                } else if (n.left.kind == ast_member_access()) {
                    let base_val <&LLVMValue> = lower_expr(ctx, n.left.left);
                    let f_idx <int> = find_field_index(ctx, n.left.left, n.left.name);
                    let fld_ty <&LLVMType> = get_struct_field_type(ctx, n.left.left, n.left.name);
                    if (base_val != null) {
                        let ind <&LLVMIndices> = new LLVMIndices{};
                        ind.i0 = llvm_const_int(ctx.i64_ty, f_idx, 0);
                        let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, base_val, ind, 1, "field_gep");
                        delete ind;
                        let cur_val <&LLVMValue> = llvm_build_load2(ctx.builder, fld_ty, gep, n.left.name);
                        if (fld_ty == ctx.float_ty || fld_ty == ctx.double_ty) {
                            let one_r <&LLVMValue> = llvm_const_real_of_string(fld_ty, "1.0");
                            let next_val <&LLVMValue> = llvm_build_fadd(ctx.builder, cur_val, one_r, "inc");
                            llvm_build_store(ctx.builder, next_val, gep);
                            return cur_val;
                        }
                        let one <&LLVMValue> = llvm_const_int(fld_ty, 1, 0);
                        let next_val <&LLVMValue> = llvm_build_add(ctx.builder, cur_val, one, "inc");
                        llvm_build_store(ctx.builder, next_val, gep);
                        return cur_val;
                    }
                }
            }
            return null;
        }
        if (cg_str_eq(n.name, "--")) {
            if (n.left != null) {
                if (n.left.kind == ast_ident()) {
                    let v <&LocalVar> = fn_ctx_find_var(ctx, n.left.name);
                    if (v != null) {
                        let cur_val <&LLVMValue> = llvm_build_load2(ctx.builder, v.ty, v.val, n.left.name);
                        if (v.ty == ctx.float_ty || v.ty == ctx.double_ty) {
                            let one_r <&LLVMValue> = llvm_const_real_of_string(v.ty, "1.0");
                            let next_val <&LLVMValue> = llvm_build_fsub(ctx.builder, cur_val, one_r, "dec");
                            llvm_build_store(ctx.builder, next_val, v.val);
                            return cur_val;
                        }
                        let one <&LLVMValue> = llvm_const_int(v.ty, 1, 0);
                        let next_val <&LLVMValue> = llvm_build_sub(ctx.builder, cur_val, one, "dec");
                        llvm_build_store(ctx.builder, next_val, v.val);
                        return cur_val;
                    }
                } else if (n.left.kind == ast_member_access()) {
                    let base_val <&LLVMValue> = lower_expr(ctx, n.left.left);
                    let f_idx <int> = find_field_index(ctx, n.left.left, n.left.name);
                    let fld_ty <&LLVMType> = get_struct_field_type(ctx, n.left.left, n.left.name);
                    if (base_val != null) {
                        let ind <&LLVMIndices> = new LLVMIndices{};
                        ind.i0 = llvm_const_int(ctx.i64_ty, f_idx, 0);
                        let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, base_val, ind, 1, "field_gep");
                        delete ind;
                        let cur_val <&LLVMValue> = llvm_build_load2(ctx.builder, fld_ty, gep, n.left.name);
                        if (fld_ty == ctx.float_ty || fld_ty == ctx.double_ty) {
                            let one_r <&LLVMValue> = llvm_const_real_of_string(fld_ty, "1.0");
                            let next_val <&LLVMValue> = llvm_build_fsub(ctx.builder, cur_val, one_r, "dec");
                            llvm_build_store(ctx.builder, next_val, gep);
                            return cur_val;
                        }
                        let one <&LLVMValue> = llvm_const_int(fld_ty, 1, 0);
                        let next_val <&LLVMValue> = llvm_build_sub(ctx.builder, cur_val, one, "dec");
                        llvm_build_store(ctx.builder, next_val, gep);
                        return cur_val;
                    }
                }
            }
            return null;
        }
        if (cg_str_eq(n.name, "?")) {
            let inner <&LLVMValue> = lower_expr(ctx, n.left);
            if (inner == null) { return null; }
            let in_ty <&LLVMType> = llvm_type_of(inner);

            if (in_ty == ctx.ptr_ty) {
                let fn_cur <&LLVMValue> = ctx.fn_val;
                let absent_bb <&LLVMBasicBlock> = llvm_append_basic_block(fn_cur, "denull.absent");
                let ok_bb <&LLVMBasicBlock> = llvm_append_basic_block(fn_cur, "denull.ok");

                let is_null <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), inner, llvm_const_null(ctx.ptr_ty), "is_null");
                llvm_build_cond_br(ctx.builder, is_null, absent_bb, ok_bb);

                llvm_position_builder(ctx.builder, absent_bb);
                cg_emit_denull_blame(ctx, n.line);
                let ab_fn <&LLVMValue> = get_or_declare_abort(ctx);
                let ab_ty <&LLVMType> = llvm_global_get_value_type(ab_fn);
                llvm_build_call2(ctx.builder, ab_ty, ab_fn, null, 0, "");
                llvm_build_unreachable(ctx.builder);

                llvm_position_builder(ctx.builder, ok_bb);
                return inner;
            } else if (llvm_count_struct_element_types(in_ty) >= 2) {
                let fn_cur <&LLVMValue> = ctx.fn_val;
                let absent_bb <&LLVMBasicBlock> = llvm_append_basic_block(fn_cur, "denull.absent");
                let ok_bb <&LLVMBasicBlock> = llvm_append_basic_block(fn_cur, "denull.ok");

                let has_val <&LLVMValue> = llvm_build_extract_value(ctx.builder, inner, 1, "has_val");
                let is_absent <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), has_val, llvm_const_int(ctx.i1_ty, 0, 0), "is_absent");
                llvm_build_cond_br(ctx.builder, is_absent, absent_bb, ok_bb);

                llvm_position_builder(ctx.builder, absent_bb);
                cg_emit_denull_blame(ctx, n.line);
                let ab_fn <&LLVMValue> = get_or_declare_abort(ctx);
                let ab_ty <&LLVMType> = llvm_global_get_value_type(ab_fn);
                llvm_build_call2(ctx.builder, ab_ty, ab_fn, null, 0, "");
                llvm_build_unreachable(ctx.builder);

                llvm_position_builder(ctx.builder, ok_bb);
                let res <&LLVMValue> = llvm_build_extract_value(ctx.builder, inner, 0, "val");
                return res;
            } else {
                return inner;
            }
        }
        let inner <&LLVMValue> = lower_expr(ctx, n.left);
        if (inner == null) { return null; }
        if (cg_str_eq(n.name, "-")) {
            let in_ty <&LLVMType> = llvm_type_of(inner);
            if (in_ty == ctx.float_ty || in_ty == ctx.double_ty) {
                return llvm_build_fneg(ctx.builder, inner, "neg");
            }
            let zero <&LLVMValue> = llvm_const_int(in_ty, 0, 0);
            return llvm_build_sub(ctx.builder, zero, inner, "sub");
        }
        if (cg_str_eq(n.name, "+")) {
            return inner;
        }
        if (cg_str_eq(n.name, "~")) {
            return llvm_build_not(ctx.builder, inner, "bnot");
        }
        if (cg_str_eq(n.name, "!")) {
            let inner_b <&LLVMValue> = to_condition_i1(ctx, inner);
            return llvm_build_not(ctx.builder, inner_b, "not");
        }
        return inner;
    }
    if (n.kind == ast_index_expr()) {
        let rec_st <string> = get_node_struct_name(ctx, n.left);
        if (cg_strlen(rec_st) > cast<ulong>(0) && (cg_str_eq(rec_st, "HashMap") || cg_str_eq(rec_st, "Collection"))) {
            let m_call <&AstNode> = new AstNode{};
            m_call.kind = ast_call_expr();
            m_call.name = "__get";
            let w0 <&AstNode> = new AstNode{};
            w0.left = n.left;
            let w1 <&AstNode> = new AstNode{};
            w1.left = n.right;
            w0.right = w1;
            m_call.left = w0;
            return lower_expr(ctx, m_call);
        }

        let arr_val <&LLVMValue> = lower_expr(ctx, n.left);
        let idx_val <&LLVMValue> = lower_expr(ctx, n.right);
        if (arr_val != null && idx_val != null) {
            if (is_ref_array_base(ctx, n.left)) {
                arr_val = llvm_build_load2(ctx.builder, ctx.ptr_ty, arr_val, "ref_arr");
            }
            if (is_prototype_node(ctx, n.left)) {
                // Direct prototype subscript `p[k]`. The header holds
                // parallel keys/vals buffers of i64 words; an integer key
                // scans the keys for the word and reads the value at the
                // same position (C++ emitPrototypeLookup), blaming when no
                // key matches. A non-integer key keeps the legacy slot-0
                // read: key search is not modeled on stage for those.
                let idx_ty_p <&LLVMType> = llvm_type_of(idx_val);
                if (cg_is_int_llvm(ctx, idx_ty_p)) {
                    let key64 <&LLVMValue> = coerce_val(ctx, idx_val, ctx.i64_ty);
                    let ind_k <&LLVMIndices> = new LLVMIndices{};
                    ind_k.i0 = llvm_const_int(ctx.i64_ty, 0, 0);
                    let k_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, arr_val, ind_k, 1, "pk_p");
                    delete ind_k;
                    let k_buf <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, k_ptr, "k_buf");
                    let ind_l <&LLVMIndices> = new LLVMIndices{};
                    ind_l.i0 = llvm_const_int(ctx.i64_ty, 1, 0);
                    let len_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, arr_val, ind_l, 1, "plen_p");
                    delete ind_l;
                    let len64 <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, len_ptr, "plen");
                    let ind_v <&LLVMIndices> = new LLVMIndices{};
                    ind_v.i0 = llvm_const_int(ctx.i64_ty, 2, 0);
                    let pv_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, arr_val, ind_v, 1, "pv_p");
                    delete ind_v;
                    let v_buf <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, pv_ptr, "v_buf");
                    let cur_s <&LLVMValue> = llvm_build_alloca(ctx.builder, ctx.i64_ty, "pfind.i");
                    llvm_build_store(ctx.builder, llvm_const_int(ctx.i64_ty, 0, 0), cur_s);
                    let at_s <&LLVMValue> = llvm_build_alloca(ctx.builder, ctx.i64_ty, "pfind.at");
                    llvm_build_store(ctx.builder, llvm_const_int(ctx.i64_ty, 0, 0), at_s);
                    let hit_s <&LLVMValue> = llvm_build_alloca(ctx.builder, ctx.i1_ty, "pfind.hit");
                    llvm_build_store(ctx.builder, llvm_const_int(ctx.i1_ty, 0, 0), hit_s);
                    let scan_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "pfind.scan");
                    let body_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "pfind.body");
                    let pfound_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "pfind.found");
                    let next_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "pfind.next");
                    let pdone_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "pfind.done");
                    let phit_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "pfind.hit");
                    let pmiss_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "pfind.miss");
                    llvm_build_br(ctx.builder, scan_bb);
                    llvm_position_builder(ctx.builder, scan_bb);
                    let cur_i <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, cur_s, "pfind.i");
                    let pmore <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_ult(), cur_i, len64, "pfind.more");
                    llvm_build_cond_br(ctx.builder, pmore, body_bb, pdone_bb);
                    llvm_position_builder(ctx.builder, body_bb);
                    let ind_c <&LLVMIndices> = new LLVMIndices{};
                    ind_c.i0 = cur_i;
                    let cand_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, k_buf, ind_c, 1, "pkey");
                    delete ind_c;
                    let cand <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, cand_ptr, "pkey.ld");
                    let key_eq <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), cand, key64, "pkey.eq");
                    llvm_build_cond_br(ctx.builder, key_eq, pfound_bb, next_bb);
                    llvm_position_builder(ctx.builder, pfound_bb);
                    llvm_build_store(ctx.builder, llvm_const_int(ctx.i1_ty, 1, 0), hit_s);
                    llvm_build_store(ctx.builder, cur_i, at_s);
                    llvm_build_br(ctx.builder, pdone_bb);
                    llvm_position_builder(ctx.builder, next_bb);
                    llvm_build_store(ctx.builder, llvm_build_add(ctx.builder, cur_i, llvm_const_int(ctx.i64_ty, 1, 0), "pfind.nxt"), cur_s);
                    llvm_build_br(ctx.builder, scan_bb);
                    llvm_position_builder(ctx.builder, pdone_bb);
                    let was_hit <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i1_ty, hit_s, "pfind.was");
                    llvm_build_cond_br(ctx.builder, was_hit, phit_bb, pmiss_bb);
                    llvm_position_builder(ctx.builder, pmiss_bb);
                    cg_emit_absent_blame(ctx, n.line, "this lookup because the key is not in the prototype");
                    let ab_fn <&LLVMValue> = get_or_declare_abort(ctx);
                    let ab_ty <&LLVMType> = llvm_global_get_value_type(ab_fn);
                    llvm_build_call2(ctx.builder, ab_ty, ab_fn, null, 0, "");
                    llvm_build_unreachable(ctx.builder);
                    llvm_position_builder(ctx.builder, phit_bb);
                    let at_i <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, at_s, "pfind.at");
                    let ind_h <&LLVMIndices> = new LLVMIndices{};
                    ind_h.i0 = at_i;
                    let hit_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, v_buf, ind_h, 1, "pval");
                    delete ind_h;
                    return llvm_build_load2(ctx.builder, ctx.i64_ty, hit_ptr, "pval.ld");
                }
                let ind_v <&LLVMIndices> = new LLVMIndices{};
                ind_v.i0 = llvm_const_int(ctx.i64_ty, 2, 0);
                let pv_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, arr_val, ind_v, 1, "pv_p");
                delete ind_v;
                let v_buf <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, pv_ptr, "v_buf");
                let ind0 <&LLVMIndices> = new LLVMIndices{};
                ind0.i0 = llvm_const_int(ctx.i64_ty, 0, 0);
                let v0_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, v_buf, ind0, 1, "v0");
                delete ind0;
                return llvm_build_load2(ctx.builder, ctx.i64_ty, v0_gep, "val_at_0");
            }
            if (is_prototype_half(ctx, n.left)) {
                // `(prtp.0)[i]` / `(prtp.1)[i]`: the half already lowered to
                // its raw i64 buffer, so stride by i64 and return the word
                // for the consumer to coerce. A static element stride would
                // split wide slots (`[int]` halves read back as 1,0,2,0).
                let idx64_h <&LLVMValue> = llvm_build_sext(ctx.builder, idx_val, ctx.i64_ty, "hidx64");
                let ind_h <&LLVMIndices> = new LLVMIndices{};
                ind_h.i0 = idx64_h;
                let h_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, arr_val, ind_h, 1, "half_gep");
                delete ind_h;
                return llvm_build_load2(ctx.builder, ctx.i64_ty, h_gep, "half_elem");
            }
            if (n.left.kind == ast_ident()) {
                let hv <&LocalVar> = fn_ctx_find_var(ctx, n.left.name);
                if (hv != null && hv.is_proto_half) {
                    // A `[T]` local bound to a half: same i64 stride, then
                    // narrow to the binding's static element type.
                    let idx64_b <&LLVMValue> = llvm_build_sext(ctx.builder, idx_val, ctx.i64_ty, "bidx64");
                    let ind_b <&LLVMIndices> = new LLVMIndices{};
                    ind_b.i0 = idx64_b;
                    let b_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, arr_val, ind_b, 1, "bhalf_gep");
                    delete ind_b;
                    let w64 <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, b_gep, "bhalf_ld");
                    return coerce_val(ctx, w64, get_index_elem_type(ctx, n.left));
                }
            }

            let idx_i64 <&LLVMValue> = llvm_build_sext(ctx.builder, idx_val, ctx.i64_ty, "idx64");
            let ind <&LLVMIndices> = new LLVMIndices{};
            ind.i0 = idx_i64;
            let elem_ty <&LLVMType> = get_index_elem_type(ctx, n.left);
            let stride_ty <&LLVMType> = elem_ty;
            if (cg_member_array_wide(ctx, n.left, elem_ty)) { stride_ty = ctx.i64_ty; }
            let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, stride_ty, arr_val, ind, 1, "arr_gep");
            delete ind;
            let raw <&LLVMValue> = llvm_build_load2(ctx.builder, stride_ty, gep, "arr_elem");
            if (stride_ty == elem_ty) { return raw; }
            return coerce_val(ctx, raw, elem_ty);
        }
        return null;
    }
    if (n.kind == ast_member_access()) {
        if (cg_str_eq(n.name, "0") || cg_str_eq(n.name, "1")) {
            let base_val <&LLVMValue> = lower_expr(ctx, n.left);
            if (base_val != null) {
                let b_ty <&LLVMType> = llvm_type_of(base_val);
                if (is_prototype_node(ctx, n.left)) {
                    let slot_idx <int> = 0;
                    if (cg_str_eq(n.name, "1")) { slot_idx = 2; }
                    let ind <&LLVMIndices> = new LLVMIndices{};
                    ind.i0 = llvm_const_int(ctx.i64_ty, slot_idx, 0);
                    let p_slot <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, base_val, ind, 1, "p_half");
                    delete ind;
                    return llvm_build_load2(ctx.builder, ctx.ptr_ty, p_slot, "half_buf");
                }
                let e_owner <&EnumInfo> = find_enum_by_llvm_type(ctx, b_ty);
                if (e_owner == null) {
                    let st_n <string> = get_node_struct_name(ctx, n.left);
                    if (cg_strlen(st_n) > cast<ulong>(0)) {
                        e_owner = find_enum(ctx, st_n);
                    }
                }
                if (e_owner != null && e_owner.has_payload) {
                    let pay_ptr <&LLVMValue> = null;
                    if (b_ty == ctx.ptr_ty) {
                        pay_ptr = base_val;
                    } else {
                        let pay_slot <&LLVMValue> = llvm_build_alloca(ctx.builder, e_owner.llvm_type, "enum.tmp");
                        llvm_build_store(ctx.builder, base_val, pay_slot);
                        pay_ptr = pay_slot;
                    }
                    let pay_gep <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, e_owner.llvm_type, pay_ptr, 1, "payload");
                    let pay_cast <&LLVMValue> = llvm_build_bitcast(ctx.builder, pay_gep, llvm_pointer_type(ctx.i32_ty, 0), "p_i32");
                    return llvm_build_load2(ctx.builder, ctx.i32_ty, pay_cast, "payload_val");
                }
                if (b_ty == ctx.ptr_ty) {
                    let st_n <string> = get_node_struct_name(ctx, n.left);
                    let st_info <&StructInfo> = null;
                    if (cg_strlen(st_n) > cast<ulong>(0)) {
                        st_info = find_struct(ctx, st_n);
                    }
                    if (st_info != null && st_info.field_count > 1) {
                        let ind <&LLVMIndices> = new LLVMIndices{};
                        ind.i0 = llvm_const_int(ctx.i64_ty, 1, 0);
                        let slot <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, base_val, ind, 1, "payload_p");
                        delete ind;
                        return llvm_build_load2(ctx.builder, ctx.ptr_ty, slot, "payload_val");
                    }
                }
            }
        }
        if (cg_str_eq(n.name, "length")) {
            let is_st_field <bool> = struct_has_field(ctx, n.left, "length");
            if (!is_st_field) {
                let base_node <&AstNode> = n.left;
                if (base_node == null) { return llvm_const_int(ctx.i32_ty, 0, 0); }

                if (is_prototype_node(ctx, base_node)) {
                    let p_val <&LLVMValue> = lower_expr(ctx, base_node);
                    if (p_val != null) {
                        let ind_l <&LLVMIndices> = new LLVMIndices{};
                        ind_l.i0 = llvm_const_int(ctx.i64_ty, 1, 0);
                        let plen_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, p_val, ind_l, 1, "plen_p");
                        delete ind_l;
                        let l64 <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, plen_ptr, "plen");
                        return llvm_build_trunc(ctx.builder, l64, ctx.i32_ty, "plen32");
                    }
                }
                if (is_prototype_half(ctx, base_node)) {
                    // `(prtp.0).length` / `(prtp.1).length`: the count lives
                    // in the header slot beside the half (1 for keys, 3 for
                    // values), not in the buffer the half lowered to.
                    let h_val <&LLVMValue> = lower_expr(ctx, base_node.left);
                    if (h_val != null) {
                        let h_slot <int> = 1;
                        if (cg_str_eq(base_node.name, "1")) { h_slot = 3; }
                        let ind_hl <&LLVMIndices> = new LLVMIndices{};
                        ind_hl.i0 = llvm_const_int(ctx.i64_ty, h_slot, 0);
                        let hlen_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, h_val, ind_hl, 1, "hlen_p");
                        delete ind_hl;
                        let hl64 <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, hlen_ptr, "hlen");
                        return llvm_build_trunc(ctx.builder, hl64, ctx.i32_ty, "hlen32");
                    }
                }

                // Case 1: Array literal [a, b, c].length
                if (base_node.kind == ast_call_expr() && cg_str_eq(base_node.name, "__fin_array_literal")) {
                    let cur <&AstNode> = base_node.left;
                    let count <int> = 0;
                    while (cur != null) {
                        count = count + 1;
                        cur = cur.right;
                    }
                    return llvm_const_int(ctx.i32_ty, count, 0);
                }

                // Case 2: __fin_alloc_array(n).length
                if (base_node.kind == ast_call_expr() && cg_str_eq(base_node.name, "__fin_alloc_array")) {
                    if (base_node.left != null) {
                        return lower_expr(ctx, base_node.left);
                    }
                    return llvm_const_int(ctx.i32_ty, 0, 0);
                }

                // Case 3: Literal string "hello".length
                if (base_node.kind == ast_literal_string()) {
                    let slen <int> = cast<int>(cg_strlen(base_node.str_val));
                    return llvm_const_int(ctx.i32_ty, slen, 0);
                }

                // Case 4: Identifier (local variable or parameter)
                if (base_node.kind == ast_ident()) {
                    let v <&LocalVar> = fn_ctx_find_var(ctx, base_node.name);
                    if (v != null) {
                        if (v.len_val != null) {
                            return v.len_val;
                        }
                        if (v.type_annotation != null) {
                            // An erased `&[T]` reference (see
                            // is_ref_array_base) is the array fat-pointer
                            // address: the extent is the second fat word,
                            // not the header word before element 0 that
                            // Case 5 reads for buffer bases.
                            if (cg_str_eq(cg_trim_spaces(v.type_annotation), "void*")) {
                                let fat <&LLVMValue> = lower_expr(ctx, base_node);
                                if (fat != null) {
                                    let ind_f <&LLVMIndices> = new LLVMIndices{};
                                    ind_f.i0 = llvm_const_int(ctx.i64_ty, 1, 0);
                                    let len_p <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, fat, ind_f, 1, "ref_len_p");
                                    delete ind_f;
                                    let len64 <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, len_p, "ref_len");
                                    return llvm_build_trunc(ctx.builder, len64, ctx.i32_ty, "ref_len32");
                                }
                            }
                            let ext <int> = get_fixed_array_extent(v.type_annotation);
                            if (ext >= 0) {
                                return llvm_const_int(ctx.i32_ty, ext, 0);
                            }
                            if (cg_str_eq(v.type_annotation, "string")) {
                                let base_val <&LLVMValue> = lower_expr(ctx, base_node);
                                if (base_val != null) {
                                    let strlen_fn <&LLVMValue> = get_or_declare_strlen(ctx);
                                    let s_fn_ty <&LLVMType> = llvm_global_get_value_type(strlen_fn);
                                    let s_args <&LLVMValueArgs> = new LLVMValueArgs{};
                                    s_args.v0 = base_val;
                                    let s_res64 <&LLVMValue> = llvm_build_call2(ctx.builder, s_fn_ty, strlen_fn, s_args, 1, "strlen");
                                    delete s_args;
                                    return llvm_build_trunc(ctx.builder, s_res64, ctx.i32_ty, "strlen32");
                                }
                            }
                        }
                    }
                }

                // Case 5: a member, parameter, or call-result base: no
                // compile-time table follows it, so the extent comes from
                // the header word before element 0 (written by `new` and
                // by literals). A fixed array answers its extent and a
                // string answers strlen; anything else reads the header.
                let base_ann <string> = get_node_struct_name(ctx, base_node);
                if (base_node.kind == ast_ident()) {
                    let bv <&LocalVar> = fn_ctx_find_var(ctx, base_node.name);
                    if (bv != null && bv.type_annotation != null) {
                        base_ann = bv.type_annotation;
                    }
                }
                if (base_ann != null && cg_strlen(base_ann) > cast<ulong>(0)) {
                    let base_ext <int> = get_fixed_array_extent(base_ann);
                    if (base_ext >= 0) {
                        return llvm_const_int(ctx.i32_ty, base_ext, 0);
                    }
                    if (cg_str_eq(cg_trim_spaces(base_ann), "string")) {
                        let base_val_s <&LLVMValue> = lower_expr(ctx, base_node);
                        if (base_val_s != null) {
                            let strlen_fn <&LLVMValue> = get_or_declare_strlen(ctx);
                            let s_fn_ty <&LLVMType> = llvm_global_get_value_type(strlen_fn);
                            let s_args <&LLVMValueArgs> = new LLVMValueArgs{};
                            s_args.v0 = base_val_s;
                            let s_res64 <&LLVMValue> = llvm_build_call2(ctx.builder, s_fn_ty, strlen_fn, s_args, 1, "strlen");
                            delete s_args;
                            return llvm_build_trunc(ctx.builder, s_res64, ctx.i32_ty, "strlen32");
                        }
                    }
                }
                let base_val <&LLVMValue> = lower_expr(ctx, base_node);
                // An erased array-holding member (`value` on `rptr<[int]>`,
                // resolved through the receiver's instantiation): the field
                // holds a cell with the buffer, so reach the buffer first
                // and read its header word. Direct `&[...]` fields keep
                // the header read on the field value below.
                if (base_node.kind == ast_member_access() &&
                  cg_strlen(cg_member_inst_arr_ann(ctx, base_node, base_node.name)) > cast<ulong>(0)) {
                    if (base_val != null) {
                        let buf_r <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, base_val, "ref_arr");
                        let ind_r <&LLVMIndices> = new LLVMIndices{};
                        ind_r.i0 = llvm_const_int_of_string(ctx.i64_ty, "-1", 10);
                        let gep_r <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, buf_r, ind_r, 1, "arr_len_p");
                        delete ind_r;
                        let len64_r <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, gep_r, "arr_len");
                        return llvm_build_trunc(ctx.builder, len64_r, ctx.i32_ty, "arr_len32");
                    }
                    return llvm_const_int(ctx.i32_ty, 0, 0);
                  }
                if (base_val != null) {
                    // The header word before element 0: a full-width -1 the
                    // int-carrying const cannot spell (it arrives zero
                    // extended and scales to +34359738360), so the string
                    // form carries it.
                    let ind <&LLVMIndices> = new LLVMIndices{};
                    ind.i0 = llvm_const_int_of_string(ctx.i64_ty, "-1", 10);
                    let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, base_val, ind, 1, "arr_len_p");
                    delete ind;
                    let len64 <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, gep, "arr_len");
                    return llvm_build_trunc(ctx.builder, len64, ctx.i32_ty, "arr_len32");
                }

                return llvm_const_int(ctx.i32_ty, 0, 0);
            }
        }
        // Interface field read: the base is a {data, vtable} value and the
        // vtable slot holds the field's index in the concrete struct, so a
        // reader with only the interface type can still address it.
        let rd_iface <&InterfaceInfo> = find_interface_for_node(ctx, n.left);
        if (rd_iface == null && n.left != null && n.left.kind == ast_ident()) {
            let rv <&LocalVar> = fn_ctx_find_var(ctx, n.left.name);
            if (rv != null && rv.type_annotation != null) {
                rd_iface = find_interface(ctx, rv.type_annotation);
            }
        }
        if (rd_iface == null && n.left != null && n.left.kind == ast_member_access()) {
            let b_st <string> = get_node_struct_name(ctx, n.left.left);
            let b_info <&StructInfo> = find_struct(ctx, b_st);
            if (b_info != null) {
                let bi <int> = 0;
                while (bi < b_info.field_count) {
                    let bf <&StructFieldInfo> = b_info.fields[bi];
                    if (bf != null && cg_str_eq(bf.name, n.left.name)) {
                        rd_iface = find_interface(ctx, bf.type_annotation);
                        break;
                    }
                    bi = bi + 1;
                }
            }
        }
        if (rd_iface != null) {
            let rd_entry <&InterfaceMethodInfo> = find_interface_method(rd_iface, n.name);
            if (rd_entry != null && rd_entry.is_field) {
                let fat_v <&LLVMValue> = lower_expr(ctx, n.left);
                if (fat_v != null) {
                    if (llvm_type_of(fat_v) == ctx.ptr_ty) {
                        let want_ty <&LLVMType> = rd_iface.fat_ptr_ty;
                        if (want_ty == null) { want_ty = ctx.fat_ptr_ty; }
                        fat_v = llvm_build_load2(ctx.builder, want_ty, fat_v, "iface.val");
                    }
                    let data_p <&LLVMValue> = llvm_build_extract_value(ctx.builder, fat_v, 0, "data");
                    let table_p <&LLVMValue> = llvm_build_extract_value(ctx.builder, fat_v, 1, "vtable");
                    let o_ind <&LLVMIndices> = new LLVMIndices{};
                    o_ind.i0 = llvm_const_int(ctx.i64_ty, rd_entry.index, 0);
                    let off_p <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, table_p, o_ind, 1, "field_off_p");
                    delete o_ind;
                    let off_v <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, off_p, "field_off");
                    let off_i <&LLVMValue> = llvm_build_ptr_to_int(ctx.builder, off_v, ctx.i64_ty, "off_i");
                    let f_ind2 <&LLVMIndices> = new LLVMIndices{};
                    f_ind2.i0 = off_i;
                    let field_p <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, data_p, f_ind2, 1, "ifield");
                    delete f_ind2;
                    let want_f_ty <&LLVMType> = map_type(ctx, rd_entry.ret_type);
                    return llvm_build_load2(ctx.builder, want_f_ty, field_p, n.name);
                }
                return null;
            }
        }
        let base_val <&LLVMValue> = lower_expr(ctx, n.left);
        let f_idx <int> = find_field_index(ctx, n.left, n.name);
        let fld_ty <&LLVMType> = get_struct_field_type(ctx, n.left, n.name);
        if (base_val != null) {
            let ind <&LLVMIndices> = new LLVMIndices{};
            ind.i0 = llvm_const_int(ctx.i64_ty, f_idx, 0);
            let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, base_val, ind, 1, "field_gep");
            delete ind;
            // Interface-typed fields hold a box: load the pointer, then the
            // fat value it points at.
            let f_iface <&InterfaceInfo> = field_interface(ctx, get_node_struct_name(ctx, n.left), n.name);
            if (f_iface != null && f_iface.fat_ptr_ty != null) {
                let box <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, gep, "iface_box");
                return llvm_build_load2(ctx.builder, f_iface.fat_ptr_ty, box, n.name);
            }
            return llvm_build_load2(ctx.builder, fld_ty, gep, n.name);
        }
        return null;
    }
    if (n.kind == ast_binary_expr()) {
        if (cg_str_eq(n.name, ":?")) {
            // `cond : then ? otherwise` (ADR 0005): only the taken arm
            // runs, so each arm lowers in its own block under a condbr
            // and the value joins through a phi over the common type
            // (the C++ backend's shape exactly).
            let cond_raw <&LLVMValue> = lower_expr(ctx, n.left);
            let test <&LLVMValue> = to_condition_i1(ctx, cond_raw);
            if (test == null) { return null; }
            let true_node <&AstNode> = null;
            let false_node <&AstNode> = null;
            if (n.right != null) {
                true_node = n.right.left;
                false_node = n.right.right;
            }
            let then_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "tern.then");
            let else_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "tern.else");
            let end_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "tern.end");
            llvm_build_cond_br(ctx.builder, test, then_bb, else_bb);
            llvm_position_builder(ctx.builder, then_bb);
            let a_raw <&LLVMValue> = lower_expr(ctx, true_node);
            let then_exit <&LLVMBasicBlock> = llvm_get_insert_block(ctx.builder);
            llvm_position_builder(ctx.builder, else_bb);
            let b_raw <&LLVMValue> = lower_expr(ctx, false_node);
            let else_exit <&LLVMBasicBlock> = llvm_get_insert_block(ctx.builder);
            if (a_raw == null || b_raw == null) { return null; }
            let common_ty <&LLVMType> = cg_tern_common(ctx, a_raw, b_raw);
            if (common_ty == null) {
                cg_dprintf(2, "codegen: a ternary of mismatched types is not lowered yet (at '%s':%d)\n", ctx.src_file, n.line);
                refuse_and_poison(ctx);
                llvm_build_unreachable(ctx.builder);
                return null;
            }
            llvm_position_builder(ctx.builder, then_exit);
            let av <&LLVMValue> = coerce_val(ctx, a_raw, common_ty);
            llvm_build_br(ctx.builder, end_bb);
            llvm_position_builder(ctx.builder, else_exit);
            let bv <&LLVMValue> = coerce_val(ctx, b_raw, common_ty);
            llvm_build_br(ctx.builder, end_bb);
            llvm_position_builder(ctx.builder, end_bb);
            let phi <&LLVMValue> = llvm_build_phi(ctx.builder, common_ty, "tern");
            let vals <&LLVMValueArgs> = new LLVMValueArgs{};
            vals.v0 = av;
            vals.v1 = bv;
            let blks <&LLVMBlockArgs> = new LLVMBlockArgs{};
            blks.b0 = then_exit;
            blks.b1 = else_exit;
            llvm_add_incoming(phi, vals, blks, 2);
            delete vals;
            delete blks;
            return phi;
        }
        if (cg_str_eq(n.name, "&&")) {
            let lhs_raw <&LLVMValue> = lower_expr(ctx, n.left);
            let l <&LLVMValue> = to_condition_i1(ctx, lhs_raw);
            let entry_bb <&LLVMBasicBlock> = llvm_get_insert_block(ctx.builder);
            let rhs_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "and_rhs");
            let end_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "and_end");

            llvm_build_cond_br(ctx.builder, l, rhs_bb, end_bb);

            llvm_position_builder(ctx.builder, rhs_bb);
            let rhs_raw <&LLVMValue> = lower_expr(ctx, n.right);
            let r <&LLVMValue> = to_condition_i1(ctx, rhs_raw);
            let rhs_exit <&LLVMBasicBlock> = llvm_get_insert_block(ctx.builder);
            llvm_build_br(ctx.builder, end_bb);

            llvm_position_builder(ctx.builder, end_bb);
            let phi <&LLVMValue> = llvm_build_phi(ctx.builder, ctx.i1_ty, "land");
            let false_v <&LLVMValue> = llvm_const_int(ctx.i1_ty, 0, 0);

            let vals <&LLVMValueArgs> = new LLVMValueArgs{};
            vals.v0 = false_v;
            vals.v1 = r;
            let blks <&LLVMBlockArgs> = new LLVMBlockArgs{};
            blks.b0 = entry_bb;
            blks.b1 = rhs_exit;
            llvm_add_incoming(phi, vals, blks, 2);
            delete vals;
            delete blks;
            return phi;
        }
        if (cg_str_eq(n.name, "||")) {
            let lhs_raw <&LLVMValue> = lower_expr(ctx, n.left);
            let l <&LLVMValue> = to_condition_i1(ctx, lhs_raw);
            let entry_bb <&LLVMBasicBlock> = llvm_get_insert_block(ctx.builder);
            let rhs_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "or_rhs");
            let end_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "or_end");

            llvm_build_cond_br(ctx.builder, l, end_bb, rhs_bb);

            llvm_position_builder(ctx.builder, rhs_bb);
            let rhs_raw <&LLVMValue> = lower_expr(ctx, n.right);
            let r <&LLVMValue> = to_condition_i1(ctx, rhs_raw);
            let rhs_exit <&LLVMBasicBlock> = llvm_get_insert_block(ctx.builder);
            llvm_build_br(ctx.builder, end_bb);

            llvm_position_builder(ctx.builder, end_bb);
            let phi <&LLVMValue> = llvm_build_phi(ctx.builder, ctx.i1_ty, "lor");
            let true_v <&LLVMValue> = llvm_const_int(ctx.i1_ty, 1, 0);

            let vals <&LLVMValueArgs> = new LLVMValueArgs{};
            vals.v0 = true_v;
            vals.v1 = r;
            let blks <&LLVMBlockArgs> = new LLVMBlockArgs{};
            blks.b0 = entry_bb;
            blks.b1 = rhs_exit;
            llvm_add_incoming(phi, vals, blks, 2);
            delete vals;
            delete blks;
            return phi;
        }
        if (cg_str_eq(n.name, "=")) {
            let rhs <&LLVMValue> = lower_expr(ctx, n.right);
            if (n.left != null) {
                if (n.left.kind == ast_ident()) {
                    let v <&LocalVar> = fn_ctx_find_var(ctx, n.left.name);
                    if (v != null && rhs != null) {
                        let rhs_fn_ty <&LLVMType> = init_fn_type(ctx, n.right);
                        rhs = fn_value_to_ptr(ctx, n.right, rhs);
                        if (v.fn_ty == null && rhs_fn_ty != null) {
                            v.fn_ty = rhs_fn_ty;
                        }
                        if (cg_is_tagged_pair(ctx, v.ty) && !cg_is_tagged_pair(ctx, llvm_type_of(rhs))) {
                            rhs = cg_wrap_nullable(ctx, rhs, v.ty, cg_is_absent_spelling(n.right));
                        } else if (cg_is_tagged_pair(ctx, v.ty) && cg_is_tagged_pair(ctx, llvm_type_of(rhs))) {
                            rhs = cg_convert_pair(ctx, rhs, v.ty);
                        } else if (!cg_is_tagged_pair(ctx, v.ty) && cg_is_tagged_pair(ctx, llvm_type_of(rhs))) {
                            cg_dprintf(2, "finc codegen refusal: storing a nullable value into '%s' without denullify ('?')\n", n.left.name);
                            refuse_and_poison(ctx);
                            llvm_build_unreachable(ctx.builder);
                            return rhs;
                        } else {
                            rhs = cg_value_to_iface_slot(ctx, rhs, v.ty, n.right);
                            rhs = coerce_val(ctx, rhs, v.ty);
                        }
                        llvm_build_store(ctx.builder, rhs, v.val);
                        // Wave-5 slice 1: a whole-binding store rebinds to
                        // live (the checker revives after both sides). The
                        // right-hand side lowered first, so its `@move`
                        // marks land before this clears them.
                        if (ctx.has_move_claim) { v.moved = false; }
                    }
                    if (v == null && rhs != null) {
                        // A module-level global has no function-scope slot:
                        // store through the global itself. Without this
                        // `Counter = Counter + 1` in `bump()` lowers the
                        // right-hand side and drops the store, so the
                        // global never changes.
                        let gv <&LLVMValue> = llvm_get_named_global(ctx.module, n.left.name);
                        if (gv != null) {
                            let gv_ty <&LLVMType> = llvm_global_get_value_type(gv);
                            if (gv_ty != null) {
                                rhs = coerce_val(ctx, rhs, gv_ty);
                                llvm_build_store(ctx.builder, rhs, gv);
                            }
                        }
                    }
                } else if (n.left.kind == ast_index_expr()) {
                    let rec_st <string> = get_node_struct_name(ctx, n.left.left);
                    if (cg_strlen(rec_st) > cast<ulong>(0) && (cg_str_eq(rec_st, "HashMap") || cg_str_eq(rec_st, "Collection"))) {
                        let m_call <&AstNode> = new AstNode{};
                        m_call.kind = ast_call_expr();
                        m_call.name = "__set";
                        let w0 <&AstNode> = new AstNode{};
                        w0.left = n.left.left;
                        let w1 <&AstNode> = new AstNode{};
                        w1.left = n.left.right;
                        let w2 <&AstNode> = new AstNode{};
                        w2.left = n.right;
                        w1.right = w2;
                        w0.right = w1;
                        m_call.left = w0;
                        lower_expr(ctx, m_call);
                        return rhs;
                    }

                    let arr_val <&LLVMValue> = lower_expr(ctx, n.left.left);
                    let idx_val <&LLVMValue> = lower_expr(ctx, n.left.right);
                    if (arr_val != null && idx_val != null && rhs != null) {
                        if (is_ref_array_base(ctx, n.left.left)) {
                            arr_val = llvm_build_load2(ctx.builder, ctx.ptr_ty, arr_val, "ref_arr");
                        }
                        if (is_prototype_node(ctx, n.left.left)) {
                            // Prototype subscript store. An integer index
                            // walks the vals buffer positionally (mirroring
                            // the load); anything else keeps the legacy
                            // slot-0 store where key search is unmodeled.
                            let s_idx_ty <&LLVMType> = llvm_type_of(idx_val);
                            if (cg_is_int_llvm(ctx, s_idx_ty)) {
                                let ind_v <&LLVMIndices> = new LLVMIndices{};
                                ind_v.i0 = llvm_const_int(ctx.i64_ty, 2, 0);
                                let pv_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, arr_val, ind_v, 1, "pv_p");
                                delete ind_v;
                                let v_buf <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, pv_ptr, "v_buf");
                                let sidx64 <&LLVMValue> = llvm_build_sext(ctx.builder, idx_val, ctx.i64_ty, "sidx64");
                                let ind_s <&LLVMIndices> = new LLVMIndices{};
                                ind_s.i0 = sidx64;
                                let vs_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, v_buf, ind_s, 1, "vs");
                                delete ind_s;
                                let rs64 <&LLVMValue> = coerce_val(ctx, rhs, ctx.i64_ty);
                                llvm_build_store(ctx.builder, rs64, vs_gep);
                            } else {
                                let ind_v <&LLVMIndices> = new LLVMIndices{};
                                ind_v.i0 = llvm_const_int(ctx.i64_ty, 2, 0);
                                let pv_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, arr_val, ind_v, 1, "pv_p");
                                delete ind_v;
                                let v_buf <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, pv_ptr, "v_buf");
                                let ind0 <&LLVMIndices> = new LLVMIndices{};
                                ind0.i0 = llvm_const_int(ctx.i64_ty, 0, 0);
                                let v0_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, v_buf, ind0, 1, "v0");
                                delete ind0;
                                let r64 <&LLVMValue> = coerce_val(ctx, rhs, ctx.i64_ty);
                                llvm_build_store(ctx.builder, r64, v0_gep);
                            }
                        } else if (is_prototype_half(ctx, n.left.left)) {
                            // Store through `(prtp.0)[i]` / `(prtp.1)[i]`:
                            // the half is the raw i64 buffer already.
                            let sidx64_h <&LLVMValue> = llvm_build_sext(ctx.builder, idx_val, ctx.i64_ty, "sidx64h");
                            let ind_sh <&LLVMIndices> = new LLVMIndices{};
                            ind_sh.i0 = sidx64_h;
                            let hs_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, arr_val, ind_sh, 1, "hs");
                            delete ind_sh;
                            let rh64 <&LLVMValue> = coerce_val(ctx, rhs, ctx.i64_ty);
                            llvm_build_store(ctx.builder, rh64, hs_gep);
                        } else {
                            let sv <&LocalVar> = null;
                            if (n.left.left.kind == ast_ident()) {
                                sv = fn_ctx_find_var(ctx, n.left.left.name);
                            }
                            if (sv != null && sv.is_proto_half) {
                                // Store through a `[T]` local bound to a half:
                                // same i64 words the loads stride.
                                let sidx64_b <&LLVMValue> = llvm_build_sext(ctx.builder, idx_val, ctx.i64_ty, "sidx64b");
                                let ind_sb <&LLVMIndices> = new LLVMIndices{};
                                ind_sb.i0 = sidx64_b;
                                let bs_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, arr_val, ind_sb, 1, "bs");
                                delete ind_sb;
                                let rb64 <&LLVMValue> = coerce_val(ctx, rhs, ctx.i64_ty);
                                llvm_build_store(ctx.builder, rb64, bs_gep);
                            } else {
                                let idx_i64 <&LLVMValue> = llvm_build_sext(ctx.builder, idx_val, ctx.i64_ty, "idx64");
                                let ind <&LLVMIndices> = new LLVMIndices{};
                                ind.i0 = idx_i64;
                                let elem_ty <&LLVMType> = get_index_elem_type(ctx, n.left.left);
                                let stride_ty <&LLVMType> = elem_ty;
                                if (cg_member_array_wide(ctx, n.left.left, elem_ty)) { stride_ty = ctx.i64_ty; }
                                let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, stride_ty, arr_val, ind, 1, "arr_gep");
                                delete ind;
                                rhs = fn_value_to_ptr(ctx, n.right, rhs);
                                rhs = coerce_val(ctx, rhs, stride_ty);
                                llvm_build_store(ctx.builder, rhs, gep);
                            }
                        }
                    }
                } else if (n.left.kind == ast_member_access()) {
                    let base_val <&LLVMValue> = lower_expr(ctx, n.left.left);
                    let f_idx <int> = find_field_index(ctx, n.left.left, n.left.name);
                    let fld_ty <&LLVMType> = get_struct_field_type(ctx, n.left.left, n.left.name);
                    if (base_val != null && rhs != null) {
                        let ind <&LLVMIndices> = new LLVMIndices{};
                        ind.i0 = llvm_const_int(ctx.i64_ty, f_idx, 0);
                        let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, base_val, ind, 1, "field_gep");
                        delete ind;
                        let w_iface <&InterfaceInfo> = field_interface(ctx, get_node_struct_name(ctx, n.left.left), n.left.name);
                        if (w_iface != null && w_iface.fat_ptr_ty != null) {
                            // The slot holds a box; box the value unless a box
                            // pointer was passed in already.
                            if (llvm_type_of(rhs) != ctx.ptr_ty) {
                                rhs = box_interface_value(ctx, rhs, w_iface.fat_ptr_ty);
                            }
                            llvm_build_store(ctx.builder, rhs, gep);
                        } else {
                            rhs = fn_value_to_ptr(ctx, n.right, rhs);
                            if (cg_is_tagged_pair(ctx, fld_ty) && !cg_is_tagged_pair(ctx, llvm_type_of(rhs))) {
                                rhs = cg_wrap_nullable(ctx, rhs, fld_ty, cg_is_absent_spelling(n.right));
                            } else if (cg_is_tagged_pair(ctx, fld_ty) && cg_is_tagged_pair(ctx, llvm_type_of(rhs))) {
                                rhs = cg_convert_pair(ctx, rhs, fld_ty);
                            } else if (!cg_is_tagged_pair(ctx, fld_ty) && cg_is_tagged_pair(ctx, llvm_type_of(rhs))) {
                                cg_dprintf(2, "finc codegen refusal: storing a nullable value into field '%s' without denullify ('?')\n", n.left.name);
                                refuse_and_poison(ctx);
                                llvm_build_unreachable(ctx.builder);
                                return rhs;
                            } else {
                                rhs = coerce_val(ctx, rhs, fld_ty);
                            }
                            llvm_build_store(ctx.builder, rhs, gep);
                        }
                    }
                } else if (n.left.kind == ast_unary_expr() && cg_str_eq(n.left.name, "*")) {
                    let ptr_val <&LLVMValue> = lower_expr(ctx, n.left.left);
                    if (ptr_val != null && rhs != null) {
                        let is_null <&LLVMValue> = llvm_build_is_null(ctx.builder, ptr_val, "p_null");
                        let cur_bb <&LLVMBasicBlock> = llvm_get_insert_block(ctx.builder);
                        let alloc_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "auto_alloc");
                        let cont_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "auto_cont");
                        llvm_build_cond_br(ctx.builder, is_null, alloc_bb, cont_bb);

                        llvm_position_builder(ctx.builder, alloc_bb);
                        let m_fn <&LLVMValue> = get_or_declare_calloc(ctx);
                        let m_fn_ty <&LLVMType> = llvm_global_get_value_type(m_fn);
                        let m_args <&LLVMValueArgs> = new LLVMValueArgs{};
                        m_args.v0 = llvm_const_int(ctx.i64_ty, 1, 0);
                        m_args.v1 = llvm_const_int(ctx.i64_ty, 8, 0);
                        let fresh_cell <&LLVMValue> = llvm_build_call2(ctx.builder, m_fn_ty, m_fn, m_args, 2, "fresh_p");
                        delete m_args;
                        if (n.left.left.kind == ast_ident()) {
                            let v_root <&LocalVar> = fn_ctx_find_var(ctx, n.left.left.name);
                            if (v_root != null) {
                                llvm_build_store(ctx.builder, fresh_cell, v_root.val);
                            }
                        }
                        let alloc_exit_bb <&LLVMBasicBlock> = llvm_get_insert_block(ctx.builder);
                        llvm_build_br(ctx.builder, cont_bb);

                        llvm_position_builder(ctx.builder, cont_bb);
                        let phi_ptr <&LLVMValue> = llvm_build_phi(ctx.builder, ctx.ptr_ty, "real_dest");
                        let p_vals <&LLVMValueArgs> = new LLVMValueArgs{};
                        p_vals.v0 = ptr_val;
                        p_vals.v1 = fresh_cell;
                        let p_blks <&LLVMBlockArgs> = new LLVMBlockArgs{};
                        p_blks.b0 = cur_bb;
                        p_blks.b1 = alloc_exit_bb;
                        llvm_add_incoming(phi_ptr, p_vals, p_blks, 2);
                        delete p_vals;
                        delete p_blks;

                        // Write at the width the matching `*p` load reads
                        // (a bare type parameter reads i32): without this a
                        // representative-carried value stores 8 bytes into a
                        // 4-byte cell. Structs and unknown roots store as-is.
                        let store_w <&LLVMType> = cg_deref_store_width(ctx, n.left);
                        if (store_w != null && store_w != ctx.void_ty) {
                            rhs = coerce_val(ctx, rhs, store_w);
                        }
                        llvm_build_store(ctx.builder, rhs, phi_ptr);
                    }
                }
            }
            return rhs;
        }
        if (cg_str_eq(n.name, "+=") || cg_str_eq(n.name, "-=") || cg_str_eq(n.name, "*=") || cg_str_eq(n.name, "/=") ||
          cg_str_eq(n.name, "%=") || cg_str_eq(n.name, "&=") || cg_str_eq(n.name, "|=") || cg_str_eq(n.name, "^=") ||
          cg_str_eq(n.name, "<<=") || cg_str_eq(n.name, ">>=")) {
            let rhs <&LLVMValue> = lower_expr(ctx, n.right);
            if (rhs == null) { return null; }
            if (n.left != null) {
                if (n.left.kind == ast_ident()) {
                    let v <&LocalVar> = fn_ctx_find_var(ctx, n.left.name);
                    if (v != null) {
                        let cur <&LLVMValue> = llvm_build_load2(ctx.builder, v.ty, v.val, n.left.name);
                        let res <&LLVMValue> = apply_compound_op(ctx, n.name, cur, rhs);
                        llvm_build_store(ctx.builder, res, v.val);
                        // Wave-5 slice 1: only `=`, `+=`, `-=`, `*=`, `/=`
                        // rebind a bare identifier (mirroring the five the
                        // C++ backend revives); the rest never marked moved.
                        if (ctx.has_move_claim && (cg_str_eq(n.name, "+=") || cg_str_eq(n.name, "-=") ||
                          cg_str_eq(n.name, "*=") || cg_str_eq(n.name, "/="))) {
                            v.moved = false;
                          }
                        return res;
                    }
                } else if (n.left.kind == ast_index_expr()) {
                    let arr_val <&LLVMValue> = lower_expr(ctx, n.left.left);
                    let idx_val <&LLVMValue> = lower_expr(ctx, n.left.right);
                    if (arr_val != null && idx_val != null) {
                        if (is_ref_array_base(ctx, n.left.left)) {
                            arr_val = llvm_build_load2(ctx.builder, ctx.ptr_ty, arr_val, "ref_arr");
                        }
                        let idx_i64 <&LLVMValue> = llvm_build_sext(ctx.builder, idx_val, ctx.i64_ty, "idx64");
                        let ind <&LLVMIndices> = new LLVMIndices{};
                        ind.i0 = idx_i64;
                        let elem_ty <&LLVMType> = get_index_elem_type(ctx, n.left.left);
                        let stride_ty <&LLVMType> = elem_ty;
                        if (cg_member_array_wide(ctx, n.left.left, elem_ty)) { stride_ty = ctx.i64_ty; }
                        let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, stride_ty, arr_val, ind, 1, "arr_gep");
                        delete ind;
                        let cur <&LLVMValue> = llvm_build_load2(ctx.builder, stride_ty, gep, "elem");
                        let res <&LLVMValue> = apply_compound_op(ctx, n.name, cur, rhs);
                        llvm_build_store(ctx.builder, res, gep);
                        return res;
                    }
                } else if (n.left.kind == ast_member_access()) {
                    let base_val <&LLVMValue> = lower_expr(ctx, n.left.left);
                    let f_idx <int> = find_field_index(ctx, n.left.left, n.left.name);
                    let fld_ty <&LLVMType> = get_struct_field_type(ctx, n.left.left, n.left.name);
                    if (base_val != null) {
                        let ind <&LLVMIndices> = new LLVMIndices{};
                        ind.i0 = llvm_const_int(ctx.i64_ty, f_idx, 0);
                        let gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, base_val, ind, 1, "field_gep");
                        delete ind;
                        let cur <&LLVMValue> = llvm_build_load2(ctx.builder, fld_ty, gep, n.left.name);
                        let res <&LLVMValue> = apply_compound_op(ctx, n.name, cur, rhs);
                        llvm_build_store(ctx.builder, res, gep);
                        return res;
                    }
                } else if (n.left.kind == ast_unary_expr() && cg_str_eq(n.left.name, "*")) {
                    let ptr_val <&LLVMValue> = lower_expr(ctx, n.left.left);
                    if (ptr_val != null) {
                        let cur <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i32_ty, ptr_val, "deref");
                        let res <&LLVMValue> = apply_compound_op(ctx, n.name, cur, rhs);
                        llvm_build_store(ctx.builder, res, ptr_val);
                        return res;
                    }
                }
            }
            return rhs;
          }
        // ADR 0037 member-denoting operand (`r == Ok(T)`): the argument
        // spells the payload type as written in the member's declaration --
        // disambiguation, not a value -- so the operand is the member's
        // discriminant, never a construction. Compare discriminants like the
        // C++ backend; the em_call construction path below never sees it.
        if (cg_str_eq(n.name, "==") || cg_str_eq(n.name, "!=")) {
            let probe_l <int> = cg_enum_member_probe_tag(ctx, n.left);
            let probe_r <int> = cg_enum_member_probe_tag(ctx, n.right);
            if (probe_l >= 0 || probe_r >= 0) {
                let want_ne <bool> = cg_str_eq(n.name, "!=");
                let lv <&LLVMValue> = null;
                let rv <&LLVMValue> = null;
                if (probe_l >= 0) {
                    lv = llvm_const_int(ctx.i32_ty, probe_l, 0);
                } else {
                    lv = lower_expr(ctx, n.left);
                }
                if (probe_r >= 0) {
                    rv = llvm_const_int(ctx.i32_ty, probe_r, 0);
                } else {
                    rv = lower_expr(ctx, n.right);
                }
                if (lv == null || rv == null) { return null; }
                lv = cg_enum_cmp_tag(ctx, n.left, lv, probe_l >= 0);
                rv = cg_enum_cmp_tag(ctx, n.right, rv, probe_r >= 0);
                if (lv == null || rv == null) { return null; }
                if (want_ne) {
                    return llvm_build_icmp(ctx.builder, llvm_int_ne(), lv, rv, "ne");
                }
                return llvm_build_icmp(ctx.builder, llvm_int_eq(), lv, rv, "eq");
            }
        }
        let lhs <&LLVMValue> = lower_expr(ctx, n.left);
        let rhs <&LLVMValue> = lower_expr(ctx, n.right);
        if (lhs == null || rhs == null) { return null; }

        let l_ty <&LLVMType> = llvm_type_of(lhs);
        let r_ty <&LLVMType> = llvm_type_of(rhs);
        // Struct-operator dispatch: the C++ backend routes `v1 + v2` with a
        // struct on the left to `V.operator+` (never to integer arithmetic
        // on the addresses), so a declared `Base_operator<op>` symbol is
        // called with the receiver first. Only ident/ident pairs dispatch:
        // re-lowering an ident is one more load, never a repeated side
        // effect. Only `+ - * / %`; `==`/`!=` keep the ADR 0036 path below.
        // Anything without a declared operator symbol keeps today's
        // lowering (the verifier refusal it already ends in).
        if (n.left != null && n.right != null &&
          n.left.kind == ast_ident() && n.right.kind == ast_ident() &&
          !cg_str_eq(n.left.name, "self") &&
          (cg_str_eq(n.name, "+") || cg_str_eq(n.name, "-") || cg_str_eq(n.name, "*") ||
          cg_str_eq(n.name, "/") || cg_str_eq(n.name, "%"))) {
            let op_sym <string> = "";
            let op_ann <string> = cg_eq_operand_ann(ctx, n.left);
            let op_o <int> = 0;
            let op_len <int> = cast<int>(cg_strlen(op_ann));
            while (op_o < op_len) {
                if (cg_str_eq(substr(op_ann, op_o, 1), "<")) { op_ann = substr(op_ann, 0, op_o); break; }
                op_o = op_o + 1;
            }
            if (cg_strlen(cg_trim_spaces(op_ann)) > cast<ulong>(0)) {
                let op_b <Buffer> = new_buffer(64);
                op_b.write_string(cg_trim_spaces(op_ann));
                op_b.write_string("_operator");
                op_b.write_string(n.name);
                op_sym = op_b.to_string();
                free_buffer(op_b);
            }
            if (cg_strlen(op_sym) > cast<ulong>(0) &&
              (fn_ctx_find_fn(ctx, op_sym) != null || llvm_get_named_function(ctx.module, op_sym) != null)) {
                let m_call <&AstNode> = new AstNode{};
                m_call.kind = ast_call_expr();
                m_call.name = op_sym;
                let w0 <&AstNode> = new AstNode{};
                w0.left = n.left;
                let w1 <&AstNode> = new AstNode{};
                w1.left = n.right;
                w0.right = w1;
                m_call.left = w0;
                return lower_expr(ctx, m_call);
              }
          }
        // Arithmetic over a representative-carried generic value: a bare
        // type parameter (`T`) lowers at pointer width, so `T + T` in an
        // erased body arrives as `add ptr, ptr`, which LLVM rejects. Read
        // such a side through ptrtoint first: the representative keeps
        // every bit, so no value the body can observe changes, and the
        // existing width logic below folds the pair. Only when the side's
        // own spelling names the parameter and the other side is not a
        // genuine pointer (or names a parameter too): pointer differences
        // keep today's lowering.
        if (cg_str_eq(n.name, "+") || cg_str_eq(n.name, "-") || cg_str_eq(n.name, "*") || cg_str_eq(n.name, "/") || cg_str_eq(n.name, "%") ||
          cg_str_eq(n.name, "<<") || cg_str_eq(n.name, ">>") || cg_str_eq(n.name, "&") || cg_str_eq(n.name, "|") || cg_str_eq(n.name, "^")) {
            let l_ann <string> = cg_strip_markers(cg_trim_spaces(cg_eq_operand_ann(ctx, n.left)));
            let r_ann <string> = cg_strip_markers(cg_trim_spaces(cg_eq_operand_ann(ctx, n.right)));
            let l_is_param <bool> = cg_is_generic_ann(ctx, l_ann);
            if (!l_is_param) { l_is_param = cg_ann_is_erased_param(ctx, cg_eq_operand_ann(ctx, n.left)); }
            let r_is_param <bool> = cg_is_generic_ann(ctx, r_ann);
            if (!r_is_param) { r_is_param = cg_ann_is_erased_param(ctx, cg_eq_operand_ann(ctx, n.right)); }
            if (l_ty == ctx.ptr_ty && l_is_param && (r_ty != ctx.ptr_ty || r_is_param)) {
                lhs = llvm_build_ptr_to_int(ctx.builder, lhs, ctx.i64_ty, "p2i");
                l_ty = ctx.i64_ty;
            }
            if (r_ty == ctx.ptr_ty && r_is_param && (l_ty != ctx.ptr_ty || l_is_param)) {
                rhs = llvm_build_ptr_to_int(ctx.builder, rhs, ctx.i64_ty, "p2i");
                r_ty = ctx.i64_ty;
            }
          }
        // Nullable pairs dispatch on the operator, mirroring the C++
        // backend's tagged-pair arms (ADR 0040): `== null` reads the tag
        // only, `==` between two pairs reads tag and payload, a bare scalar
        // beside a pair is present with a matching payload, ordering reads
        // the payload blaming if absent, and arithmetic on a pair refuses.
        let l_pair_op <bool> = cg_is_tagged_pair(ctx, l_ty);
        let r_pair_op <bool> = cg_is_tagged_pair(ctx, r_ty);
        let l_null_op <bool> = cg_is_null_lit(ctx, lhs);
        let r_null_op <bool> = cg_is_null_lit(ctx, rhs);
        let is_eq_op <bool> = cg_str_eq(n.name, "==") || cg_str_eq(n.name, "!=");
        let is_ord_op <bool> = cg_str_eq(n.name, "<") || cg_str_eq(n.name, ">") || cg_str_eq(n.name, "<=") || cg_str_eq(n.name, ">=");
        if (is_eq_op && ((l_pair_op && r_null_op) || (r_pair_op && l_null_op))) {
            let pair_v <&LLVMValue> = lhs;
            if (r_pair_op) { pair_v = rhs; }
            let has_val <&LLVMValue> = llvm_build_extract_value(ctx.builder, pair_v, 1, "has_val");
            if (cg_str_eq(n.name, "==")) {
                return llvm_build_icmp(ctx.builder, llvm_int_eq(), has_val, llvm_const_int(ctx.i1_ty, 0, 0), "is_null");
            } else {
                return llvm_build_icmp(ctx.builder, llvm_int_ne(), has_val, llvm_const_int(ctx.i1_ty, 0, 0), "not_null");
            }
        }
        if (is_eq_op && l_pair_op && r_pair_op) {
            // Tag and payload both agree. Different payload types refuse
            // rather than compare across widths.
            let l_pay_ty <&LLVMType> = llvm_struct_get_type_at_index(l_ty, 0);
            let r_pay_ty <&LLVMType> = llvm_struct_get_type_at_index(r_ty, 0);
            if (l_pay_ty != r_pay_ty) {
                cg_dprintf(2, "codegen: a comparison of different nullable types is not lowered yet (at '%s':%d)\n", ctx.src_file, n.line);
                refuse_and_poison(ctx);
                llvm_build_unreachable(ctx.builder);
                return null;
            }
            let l_tag <&LLVMValue> = llvm_build_extract_value(ctx.builder, lhs, 1, "ltag");
            let r_tag <&LLVMValue> = llvm_build_extract_value(ctx.builder, rhs, 1, "rtag");
            let tags_eq <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), l_tag, r_tag, "tags.eq");
            let l_pay <&LLVMValue> = llvm_build_extract_value(ctx.builder, lhs, 0, "lpay");
            let r_pay <&LLVMValue> = llvm_build_extract_value(ctx.builder, rhs, 0, "rpay");
            let pays_eq <&LLVMValue> = null;
            if (l_pay_ty == ctx.float_ty || l_pay_ty == ctx.double_ty) {
                pays_eq = llvm_build_fcmp(ctx.builder, llvm_real_oeq(), l_pay, r_pay, "pays.eq");
            } else {
                pays_eq = llvm_build_icmp(ctx.builder, llvm_int_eq(), l_pay, r_pay, "pays.eq");
            }
            let both <&LLVMValue> = llvm_build_and(ctx.builder, tags_eq, pays_eq, "null.eq");
            if (cg_str_eq(n.name, "!=")) {
                both = llvm_build_not(ctx.builder, both, "null.ne");
            }
            return both;
        }
        if (is_eq_op && (l_pair_op || r_pair_op) && !l_null_op && !r_null_op) {
            // One pair, one scalar: present with a matching payload. The
            // scalar coerces to the payload type first, as if wrapped.
            let pair_v <&LLVMValue> = lhs;
            let plain_v <&LLVMValue> = rhs;
            if (r_pair_op) {
                pair_v = rhs;
                plain_v = lhs;
            }
            let pay_ty <&LLVMType> = llvm_struct_get_type_at_index(llvm_type_of(pair_v), 0);
            let tag <&LLVMValue> = llvm_build_extract_value(ctx.builder, pair_v, 1, "tag");
            let pay <&LLVMValue> = llvm_build_extract_value(ctx.builder, pair_v, 0, "pay");
            let want <&LLVMValue> = coerce_val(ctx, plain_v, pay_ty);
            let pay_eq <&LLVMValue> = null;
            if (pay_ty == ctx.float_ty || pay_ty == ctx.double_ty) {
                pay_eq = llvm_build_fcmp(ctx.builder, llvm_real_oeq(), pay, want, "pay.eq");
            } else {
                pay_eq = llvm_build_icmp(ctx.builder, llvm_int_eq(), pay, want, "pay.eq");
            }
            let matched <&LLVMValue> = llvm_build_and(ctx.builder, tag, pay_eq, "null.eq");
            if (cg_str_eq(n.name, "!=")) {
                matched = llvm_build_not(ctx.builder, matched, "null.ne");
            }
            return matched;
        }
        if (is_eq_op && (l_pair_op || r_pair_op)) {
            // A pair against anything else here (an array literal, an enum,
            // a fat value) is not lowered.
            cg_dprintf(2, "codegen: an operator on a struct is not lowered yet (at '%s':%d)\n", ctx.src_file, n.line);
            refuse_and_poison(ctx);
            llvm_build_unreachable(ctx.builder);
            return null;
        }
        if (!is_eq_op && !is_ord_op && (l_pair_op || r_pair_op)) {
            // Arithmetic, bitwise and shifts on a nullable pair refuse, like
            // the C++ backend: denullify the value first.
            cg_dprintf(2, "codegen: an operator on a struct is not lowered yet (at '%s':%d)\n", ctx.src_file, n.line);
            refuse_and_poison(ctx);
            llvm_build_unreachable(ctx.builder);
            return null;
        }
        // Shifts lower here, ahead of the generic width coercion: the count
        // converts to the value's width (C++ convert(rhs, lhs.type)) and
        // the value keeps its type. `>>` branches on value signedness
        // (`ashr` signed, `lshr` unsigned); a float on either side is the
        // backend-invariant refusal. Oversized/negative counts compile as
        // raw LLVM shifts (poison UB, no diagnostic), matching the oracle.
        if (cg_str_eq(n.name, "<<") || cg_str_eq(n.name, ">>")) {
            if (l_ty == ctx.float_ty || l_ty == ctx.double_ty || r_ty == ctx.float_ty || r_ty == ctx.double_ty) {
                cg_dprintf(2, "codegen: a shift of a non-integer is not lowered yet (at '%s':%d)\n", ctx.src_file, n.line);
                refuse_and_poison(ctx);
                llvm_build_unreachable(ctx.builder);
                return null;
            }
            if (l_ty != r_ty) {
                if (l_ty == ctx.i64_ty && r_ty == ctx.i32_ty) {
                    rhs = llvm_build_sext(ctx.builder, rhs, ctx.i64_ty, "sh_cnt");
                } else if (l_ty == ctx.i32_ty && r_ty == ctx.i64_ty) {
                    rhs = llvm_build_trunc(ctx.builder, rhs, ctx.i32_ty, "sh_cnt");
                } else if (l_ty == ctx.i32_ty && (r_ty == ctx.i8_ty || r_ty == ctx.i1_ty)) {
                    rhs = llvm_build_zext(ctx.builder, rhs, ctx.i32_ty, "sh_cnt");
                } else if ((l_ty == ctx.i8_ty || l_ty == ctx.i1_ty) && r_ty == ctx.i32_ty) {
                    rhs = llvm_build_trunc(ctx.builder, rhs, l_ty, "sh_cnt");
                } else if (l_ty == ctx.i64_ty && (r_ty == ctx.i8_ty || r_ty == ctx.i1_ty)) {
                    rhs = llvm_build_zext(ctx.builder, rhs, ctx.i64_ty, "sh_cnt");
                } else if ((l_ty == ctx.i8_ty || l_ty == ctx.i1_ty) && r_ty == ctx.i64_ty) {
                    rhs = llvm_build_trunc(ctx.builder, rhs, l_ty, "sh_cnt");
                } else if (l_ty == ctx.i16_ty && (r_ty == ctx.i32_ty || r_ty == ctx.i64_ty)) {
                    rhs = llvm_build_trunc(ctx.builder, rhs, l_ty, "sh_cnt");
                } else if ((l_ty == ctx.i32_ty || l_ty == ctx.i64_ty) && r_ty == ctx.i16_ty) {
                    rhs = llvm_build_zext(ctx.builder, rhs, l_ty, "sh_cnt");
                } else if (l_ty == ctx.i16_ty && (r_ty == ctx.i8_ty || r_ty == ctx.i1_ty)) {
                    rhs = llvm_build_zext(ctx.builder, rhs, l_ty, "sh_cnt");
                } else if ((l_ty == ctx.i8_ty || l_ty == ctx.i1_ty) && r_ty == ctx.i16_ty) {
                    rhs = llvm_build_trunc(ctx.builder, rhs, l_ty, "sh_cnt");
                }
            }
            let sh_res <&LLVMValue> = null;
            if (cg_str_eq(n.name, "<<")) {
                sh_res = llvm_build_shl(ctx.builder, lhs, rhs, "shl");
            } else if (cg_value_is_unsigned(ctx, n.left)) {
                sh_res = llvm_build_lshr(ctx.builder, lhs, rhs, "shr");
            } else {
                sh_res = llvm_build_ashr(ctx.builder, lhs, rhs, "shr");
            }
            return sh_res;
        }
        if (is_ord_op) {
            // Ordering reads the payload, blaming if absent
            // (nullifier.fin:20 `if (n > 0)`).
            if (l_pair_op) {
                lhs = cg_order_payload(ctx, lhs, n.line);
                if (lhs == null) { return null; }
                l_ty = llvm_type_of(lhs);
            }
            if (r_pair_op) {
                rhs = cg_order_payload(ctx, rhs, n.line);
                if (rhs == null) { return null; }
                r_ty = llvm_type_of(rhs);
            }
        }
        // A scalar against the null literal compares against zero (`err_code
        // == null` in stdlib/error.fin:12; nullifier.fin:22 `n == null`),
        // mirroring the C++ backend's explicit null-default arm. Only `==`
        // and `!=` reach here; ordering against null stays refused below.
        if (cg_str_eq(n.name, "==") || cg_str_eq(n.name, "!=")) {
            let is_eq_n <bool> = cg_str_eq(n.name, "==");
            let null_lhs <&LLVMValue> = null;
            let null_lhs_ty <&LLVMType> = null;
            if (l_null_op && (r_ty == ctx.i32_ty || r_ty == ctx.i64_ty || r_ty == ctx.i8_ty || r_ty == ctx.i1_ty || r_ty == ctx.float_ty || r_ty == ctx.double_ty)) {
                null_lhs = rhs;
                null_lhs_ty = r_ty;
            } else if (r_null_op && (l_ty == ctx.i32_ty || l_ty == ctx.i64_ty || l_ty == ctx.i8_ty || l_ty == ctx.i1_ty || l_ty == ctx.float_ty || l_ty == ctx.double_ty)) {
                null_lhs = lhs;
                null_lhs_ty = l_ty;
            }
            if (null_lhs != null) {
                if (null_lhs_ty == ctx.float_ty || null_lhs_ty == ctx.double_ty) {
                    let zero_r <&LLVMValue> = llvm_const_real_of_string(null_lhs_ty, "0.0");
                    if (is_eq_n) {
                        return llvm_build_fcmp(ctx.builder, llvm_real_oeq(), null_lhs, zero_r, "eq");
                    } else {
                        return llvm_build_fcmp(ctx.builder, llvm_real_one(), null_lhs, zero_r, "ne");
                    }
                } else {
                    let zero <&LLVMValue> = llvm_const_int(null_lhs_ty, 0, 0);
                    if (is_eq_n) {
                        return llvm_build_icmp(ctx.builder, llvm_int_eq(), null_lhs, zero, "eq");
                    } else {
                        return llvm_build_icmp(ctx.builder, llvm_int_ne(), null_lhs, zero, "ne");
                    }
                }
            }
        }
        if (l_ty != r_ty) {
            let is_cmp <bool> = (cg_str_eq(n.name, "==") || cg_str_eq(n.name, "!=") || cg_str_eq(n.name, "<") || cg_str_eq(n.name, ">") || cg_str_eq(n.name, "<=") || cg_str_eq(n.name, ">="));
            if (l_ty == ctx.ptr_ty && (r_ty == ctx.i32_ty || r_ty == ctx.i64_ty || r_ty == ctx.i8_ty || r_ty == ctx.i1_ty)) {
                // An erased generic value arrives as a pointer holding value
                // bits (int-to-ptr), not an address: dereferencing it faults
                // (`read(bc) == 'z'` read address 0x7a). Only a genuine
                // address spelling (`&int`, `int*`) dereferences here, like
                // the C++ backend's pointee rule; anything else (a bare `T`,
                // a scalar spelling, a call result) reads its bits via p2i.
                let l_ann_cmp <string> = cg_eq_operand_ann(ctx, n.left);
                let l_is_addr <bool> = cg_str_contains(l_ann_cmp, "&") || cg_str_contains(l_ann_cmp, "*");
                if (is_cmp && rhs != llvm_const_null(r_ty) && l_is_addr) {
                    lhs = llvm_build_load2(ctx.builder, r_ty, lhs, "deref");
                    l_ty = r_ty;
                } else {
                    lhs = llvm_build_ptr_to_int(ctx.builder, lhs, r_ty, "p2i");
                    l_ty = r_ty;
                }
            } else if (r_ty == ctx.ptr_ty && (l_ty == ctx.i32_ty || l_ty == ctx.i64_ty || l_ty == ctx.i8_ty || l_ty == ctx.i1_ty)) {
                let r_ann_cmp <string> = cg_eq_operand_ann(ctx, n.right);
                let r_is_addr <bool> = cg_str_contains(r_ann_cmp, "&") || cg_str_contains(r_ann_cmp, "*");
                if (is_cmp && lhs != llvm_const_null(l_ty) && r_is_addr) {
                    rhs = llvm_build_load2(ctx.builder, l_ty, rhs, "deref");
                    r_ty = l_ty;
                } else {
                    rhs = llvm_build_ptr_to_int(ctx.builder, rhs, l_ty, "p2i");
                    r_ty = l_ty;
                }
            }
            if (l_ty == ctx.i64_ty && r_ty == ctx.i32_ty) {
                rhs = llvm_build_sext(ctx.builder, rhs, ctx.i64_ty, "rhs_ext");
            } else if (l_ty == ctx.i32_ty && r_ty == ctx.i64_ty) {
                lhs = llvm_build_sext(ctx.builder, lhs, ctx.i64_ty, "lhs_ext");
            } else if (l_ty == ctx.i32_ty && (r_ty == ctx.i8_ty || r_ty == ctx.i1_ty)) {
                rhs = llvm_build_zext(ctx.builder, rhs, ctx.i32_ty, "rhs_ext");
            } else if ((l_ty == ctx.i8_ty || l_ty == ctx.i1_ty) && r_ty == ctx.i32_ty) {
                lhs = llvm_build_zext(ctx.builder, lhs, ctx.i32_ty, "lhs_ext");
            } else if (l_ty == ctx.i64_ty && (r_ty == ctx.i8_ty || r_ty == ctx.i1_ty)) {
                rhs = llvm_build_zext(ctx.builder, rhs, ctx.i64_ty, "rhs_ext");
            } else if ((l_ty == ctx.i8_ty || l_ty == ctx.i1_ty) && r_ty == ctx.i64_ty) {
                lhs = llvm_build_zext(ctx.builder, lhs, ctx.i64_ty, "lhs_ext");
            } else if (l_ty == ctx.i16_ty && (r_ty == ctx.i32_ty || r_ty == ctx.i64_ty)) {
                // Widening keeps the value: a signed side sign-extends and
                // an unsigned side zero-extends (C++ convert()).
                if (cg_value_is_unsigned(ctx, n.left)) {
                    lhs = llvm_build_zext(ctx.builder, lhs, r_ty, "lhs_ext");
                } else {
                    lhs = llvm_build_sext(ctx.builder, lhs, r_ty, "lhs_ext");
                }
                l_ty = r_ty;
            } else if ((l_ty == ctx.i32_ty || l_ty == ctx.i64_ty) && r_ty == ctx.i16_ty) {
                if (cg_value_is_unsigned(ctx, n.right)) {
                    rhs = llvm_build_zext(ctx.builder, rhs, l_ty, "rhs_ext");
                } else {
                    rhs = llvm_build_sext(ctx.builder, rhs, l_ty, "rhs_ext");
                }
                r_ty = l_ty;
            } else if (l_ty == ctx.i16_ty && (r_ty == ctx.i8_ty || r_ty == ctx.i1_ty)) {
                rhs = llvm_build_zext(ctx.builder, rhs, l_ty, "rhs_ext");
                r_ty = l_ty;
            } else if ((l_ty == ctx.i8_ty || l_ty == ctx.i1_ty) && r_ty == ctx.i16_ty) {
                lhs = llvm_build_zext(ctx.builder, lhs, r_ty, "lhs_ext");
                l_ty = r_ty;
            }
        }

        // Floating-point arithmetic and comparison: a float or double on
        // either side promotes the pair (double wins, integers convert),
        // mirroring the C++ backend's common-type rule.
        if (l_ty == ctx.float_ty || l_ty == ctx.double_ty || r_ty == ctx.float_ty || r_ty == ctx.double_ty) {
            let fp_ty <&LLVMType> = ctx.float_ty;
            if (l_ty == ctx.double_ty || r_ty == ctx.double_ty) {
                fp_ty = ctx.double_ty;
            }
            lhs = coerce_val(ctx, lhs, fp_ty);
            rhs = coerce_val(ctx, rhs, fp_ty);
            if (llvm_type_of(lhs) != llvm_type_of(rhs)) {
                cg_dprintf(2, "finc codegen refusal: operator '%s' mixes float and non-numeric operands\n", n.name);
                refuse_and_poison(ctx);
                llvm_build_unreachable(ctx.builder);
                return null;
            }
            if (cg_str_eq(n.name, "+")) {
                return llvm_build_fadd(ctx.builder, lhs, rhs, "fadd");
            }
            if (cg_str_eq(n.name, "-")) {
                return llvm_build_fsub(ctx.builder, lhs, rhs, "fsub");
            }
            if (cg_str_eq(n.name, "*")) {
                return llvm_build_fmul(ctx.builder, lhs, rhs, "fmul");
            }
            if (cg_str_eq(n.name, "/")) {
                return llvm_build_fdiv(ctx.builder, lhs, rhs, "fdiv");
            }
            if (cg_str_eq(n.name, "%")) {
                return llvm_build_frem(ctx.builder, lhs, rhs, "frem");
            }
            if (cg_str_eq(n.name, "==")) {
                return llvm_build_fcmp(ctx.builder, llvm_real_oeq(), lhs, rhs, "feq");
            }
            if (cg_str_eq(n.name, "!=")) {
                return llvm_build_fcmp(ctx.builder, llvm_real_one(), lhs, rhs, "fne");
            }
            if (cg_str_eq(n.name, "<")) {
                return llvm_build_fcmp(ctx.builder, llvm_real_olt(), lhs, rhs, "flt");
            }
            if (cg_str_eq(n.name, ">")) {
                return llvm_build_fcmp(ctx.builder, llvm_real_ogt(), lhs, rhs, "fgt");
            }
            if (cg_str_eq(n.name, "<=")) {
                return llvm_build_fcmp(ctx.builder, llvm_real_ole(), lhs, rhs, "fle");
            }
            if (cg_str_eq(n.name, ">=")) {
                return llvm_build_fcmp(ctx.builder, llvm_real_oge(), lhs, rhs, "fge");
            }
            cg_dprintf(2, "finc codegen refusal: operator '%s' is not lowered for float operands\n", n.name);
            refuse_and_poison(ctx);
            llvm_build_unreachable(ctx.builder);
            return null;
        }

        if (cg_str_eq(n.name, "+")) {
            return llvm_build_add(ctx.builder, lhs, rhs, "add");
        }
        if (cg_str_eq(n.name, "-")) {
            if (l_ty == ctx.ptr_ty && r_ty == ctx.ptr_ty) {
                let l_i64 <&LLVMValue> = llvm_build_ptr_to_int(ctx.builder, lhs, ctx.i64_ty, "pdiff_l");
                let r_i64 <&LLVMValue> = llvm_build_ptr_to_int(ctx.builder, rhs, ctx.i64_ty, "pdiff_r");
                let diff_i64 <&LLVMValue> = llvm_build_sub(ctx.builder, l_i64, r_i64, "pdiff");
                return llvm_build_trunc(ctx.builder, diff_i64, ctx.i32_ty, "diff32");
            }
            return llvm_build_sub(ctx.builder, lhs, rhs, "sub");
        }
        if (cg_str_eq(n.name, "*")) {
            return llvm_build_mul(ctx.builder, lhs, rhs, "mul");
        }
        if (cg_str_eq(n.name, "/")) {
            if (cg_value_is_unsigned(ctx, n.left)) {
                return llvm_build_udiv(ctx.builder, lhs, rhs, "div");
            }
            return llvm_build_sdiv(ctx.builder, lhs, rhs, "div");
        }
        if (cg_str_eq(n.name, "%")) {
            if (cg_value_is_unsigned(ctx, n.left)) {
                return llvm_build_urem(ctx.builder, lhs, rhs, "rem");
            }
            return llvm_build_srem(ctx.builder, lhs, rhs, "rem");
        }
        if (cg_str_eq(n.name, "&")) {
            return llvm_build_and(ctx.builder, lhs, rhs, "band");
        }
        if (cg_str_eq(n.name, "|")) {
            return llvm_build_or(ctx.builder, lhs, rhs, "bor");
        }
        if (cg_str_eq(n.name, "^")) {
            return llvm_build_xor(ctx.builder, lhs, rhs, "bxor");
        }
        if (cg_str_eq(n.name, "==") || cg_str_eq(n.name, "!=")) {
            let is_eq <bool> = cg_str_eq(n.name, "==");
            // `string ==`/`!=` compares content: same length AND byte-equal
            // over the full bytes. A null literal beside a string keeps
            // pointer comparison (the `s == null` presence question); one
            // known-`string` side suffices, since the checker rejects `==`
            // across mismatched types. Generic-annotated sides stay out:
            // an erased parameter's bits are not known to be characters.
            // Only two pointer words take the content path, so every other
            // shape keeps its existing lowering.
            let l_ann <string> = cg_eq_operand_ann(ctx, n.left);
            let r_ann <string> = cg_eq_operand_ann(ctx, n.right);
            if (l_ty == ctx.ptr_ty && r_ty == ctx.ptr_ty &&
              !cg_is_null_lit(ctx, lhs) && !cg_is_null_lit(ctx, rhs) &&
              !cg_is_generic_ann(ctx, l_ann) && !cg_is_generic_ann(ctx, r_ann) &&
              (cg_operand_is_string(ctx, n.left) || cg_operand_is_string(ctx, n.right))) {
                return cg_lower_string_eq(ctx, lhs, rhs, !is_eq);
              }
            if (n.right != null && n.right.kind == ast_call_expr() && cg_str_eq(n.right.name, "__fin_array_literal")) {
                // lhs already holds the buffer: a plain array lowers to its
                // data pointer and a member access to the loaded field value.
                // (A load here would dereference the buffer itself.) A
                // reference base (`&[]` parameter or member) instead holds
                // the fat/cell address, so reach the buffer first like the
                // index paths do.
                let arr_buf <&LLVMValue> = lhs;
                if (is_ref_array_base(ctx, n.left)) {
                    arr_buf = llvm_build_load2(ctx.builder, ctx.ptr_ty, arr_buf, "ref_arr");
                }
                let all_match <&LLVMValue> = llvm_const_int(ctx.i1_ty, 1, 0);
                let lit_cur <&AstNode> = n.right.left;
                let elem_i <int> = 0;
                let cmp_ty <&LLVMType> = null;
                while (lit_cur != null) {
                    let expected <&LLVMValue> = lower_expr(ctx, lit_cur);
                    if (expected == null) {
                        cg_dprintf(2, "finc codegen refusal: array literal element %d in '%s' comparison does not lower (at '%s':%d)\n", elem_i, n.name, ctx.src_file, n.line);
                        llvm_build_unreachable(ctx.builder);
                        return all_match;
                    }
                    // Same slot rule as __fin_array_literal: the buffer strides by
                    // the element type, so each comparison must load that width.
                    if (cmp_ty == null) {
                        cmp_ty = llvm_type_of(expected);
                    }
                    let ind_e <&LLVMIndices> = new LLVMIndices{};
                    ind_e.i0 = llvm_const_int(ctx.i64_ty, elem_i, 0);
                    let elem_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, cmp_ty, arr_buf, ind_e, 1, "arr_elem_p");
                    delete ind_e;
                    let actual_e <&LLVMValue> = llvm_build_load2(ctx.builder, cmp_ty, elem_gep, "arr_e");
                    let expected_c <&LLVMValue> = coerce_val(ctx, expected, cmp_ty);
                    let e_eq <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), actual_e, expected_c, "e_eq");
                    all_match = llvm_build_and(ctx.builder, all_match, e_eq, "arr_match");
                    elem_i = elem_i + 1;
                    lit_cur = lit_cur.right;
                }
                if (is_eq) {
                    return all_match;
                } else {
                    return llvm_build_not(ctx.builder, all_match, "arr_not_match");
                }
            }
            if (cg_is_tagged_pair(ctx, l_ty) && cg_is_null_lit(ctx, rhs)) {
                let has_val <&LLVMValue> = llvm_build_extract_value(ctx.builder, lhs, 1, "has_val");
                if (is_eq) {
                    return llvm_build_icmp(ctx.builder, llvm_int_eq(), has_val, llvm_const_int(ctx.i1_ty, 0, 0), "is_null");
                } else {
                    return llvm_build_icmp(ctx.builder, llvm_int_ne(), has_val, llvm_const_int(ctx.i1_ty, 0, 0), "not_null");
                }
            }
            if (cg_is_tagged_pair(ctx, r_ty) && cg_is_null_lit(ctx, lhs)) {
                let has_val <&LLVMValue> = llvm_build_extract_value(ctx.builder, rhs, 1, "has_val");
                if (is_eq) {
                    return llvm_build_icmp(ctx.builder, llvm_int_eq(), has_val, llvm_const_int(ctx.i1_ty, 0, 0), "is_null");
                } else {
                    return llvm_build_icmp(ctx.builder, llvm_int_ne(), has_val, llvm_const_int(ctx.i1_ty, 0, 0), "not_null");
                }
            }
            let l_en <&EnumInfo> = find_enum_by_llvm_type(ctx, l_ty);
            let r_en <&EnumInfo> = find_enum_by_llvm_type(ctx, r_ty);
            // Two erased addresses never compare as discriminants here: a
            // member-denoting pair is decided above, so address equality
            // would read the boxes, not the tags.
            if (l_ty == ctx.ptr_ty && r_ty == ctx.ptr_ty &&
              cg_ann_names_enum(ctx, cg_eq_operand_ann(ctx, n.left)) &&
              cg_ann_names_enum(ctx, cg_eq_operand_ann(ctx, n.right))) {
                cg_dprintf(2, "finc codegen refusal: operator '%s' on two erased enum values is not lowered (discriminant comparison needs a member beside the value)\n", n.name);
                refuse_and_poison(ctx);
                llvm_build_unreachable(ctx.builder);
                return null;
              }
            if (l_en != null || r_en != null) {
                // Structs extract their discriminant, fieldless tags pass
                // through; anything else (notably an erased address, which
                // only the member probe above may read) refuses by name
                // rather than emitting a cross-type icmp.
                let l_tag <&LLVMValue> = cg_enum_cmp_tag_strict(ctx, lhs);
                let r_tag <&LLVMValue> = cg_enum_cmp_tag_strict(ctx, rhs);
                if (l_tag == null || r_tag == null) { return null; }
                if (is_eq) {
                    return llvm_build_icmp(ctx.builder, llvm_int_eq(), l_tag, r_tag, "eq");
                } else {
                    return llvm_build_icmp(ctx.builder, llvm_int_ne(), l_tag, r_tag, "ne");
                }
            }
            // ADR 0036: a struct value with no declared `==`/`!=` refuses
            // rather than pointer-comparing here. The icmp below would
            // silently accept what the C++ backend refuses (`an undeclared
            // operator '==' on struct 'Data'`), so name the struct instead.
            // Null literals never reach this naming: a null beside a struct
            // is a presence question the arms above already answered, and a
            // null beside a pointer keeps today's comparison.
            let want_ne <bool> = !is_eq;
            if (!cg_is_null_lit(ctx, lhs) && !cg_is_null_lit(ctx, rhs)) {
                let hit <string> = cg_eq_struct_name(ctx, cg_eq_operand_ann(ctx, n.left), want_ne);
                if (cg_strlen(hit) == cast<ulong>(0)) {
                    hit = cg_eq_struct_name(ctx, cg_eq_operand_ann(ctx, n.right), want_ne);
                }
                if (cg_strlen(hit) > cast<ulong>(0)) {
                    let op <string> = "==";
                    if (want_ne) { op = "!="; }
                    cg_dprintf(2, "finc codegen refusal: an undeclared operator '%s' on struct '%s' is not lowered (ADR 0036: equality is declared, not synthesized)\n", op, hit);
                    refuse_and_poison(ctx);
                    llvm_build_unreachable(ctx.builder);
                    return null;
                }
            }
            if (is_eq) {
                return llvm_build_icmp(ctx.builder, llvm_int_eq(), lhs, rhs, "eq");
            } else {
                return llvm_build_icmp(ctx.builder, llvm_int_ne(), lhs, rhs, "ne");
            }
        }
        if (cg_str_eq(n.name, "<")) {
            if (cg_value_is_unsigned(ctx, n.left)) {
                return llvm_build_icmp(ctx.builder, llvm_int_ult(), lhs, rhs, "lt");
            }
            return llvm_build_icmp(ctx.builder, llvm_int_slt(), lhs, rhs, "lt");
        }
        if (cg_str_eq(n.name, ">")) {
            if (cg_value_is_unsigned(ctx, n.left)) {
                return llvm_build_icmp(ctx.builder, llvm_int_ugt(), lhs, rhs, "gt");
            }
            return llvm_build_icmp(ctx.builder, llvm_int_sgt(), lhs, rhs, "gt");
        }
        if (cg_str_eq(n.name, "<=")) {
            if (cg_value_is_unsigned(ctx, n.left)) {
                return llvm_build_icmp(ctx.builder, llvm_int_ule(), lhs, rhs, "le");
            }
            return llvm_build_icmp(ctx.builder, llvm_int_sle(), lhs, rhs, "le");
        }
        if (cg_str_eq(n.name, ">=")) {
            if (cg_value_is_unsigned(ctx, n.left)) {
                return llvm_build_icmp(ctx.builder, llvm_int_uge(), lhs, rhs, "ge");
            }
            return llvm_build_icmp(ctx.builder, llvm_int_sge(), lhs, rhs, "ge");
        }
        return lhs;
    }
    if (n.kind == ast_call_expr()) {
        // sizeof(T) folds to the size LLVM's own layout computes for the
        // resolved type: one table for the value model and this query.
        if (cg_str_eq(n.name, "__fin_sizeof") || cg_str_eq(n.name, "sizeof")) {
            let sized_ty <&LLVMType> = sizeof_of_spelling(ctx, n.type_annotation);
            if (sized_ty == null) {
                cg_dprintf(2, "finc codegen refusal: sizeof of unlowerable type '%s'\n", n.type_annotation);
                refuse_and_poison(ctx);
                llvm_build_unreachable(ctx.builder);
                return null;
            }
            let sz <&LLVMValue> = llvm_size_of(sized_ty);
            return coerce_val(ctx, sz, ctx.i32_ty);
        }
        if (cg_str_eq(n.name, "__fin_alloc_array")) {
            let size_elem <&LLVMValue> = lower_expr(ctx, n.left);
            let size_i64 <&LLVMValue> = llvm_build_sext(ctx.builder, size_elem, ctx.i64_ty, "size64");
            // Every dynamic buffer carries its extent in the word before
            // element 0, so `.length` on a field or parameter (which no
            // compile-time table follows) reads the header instead of
            // buffer contents. Locals keep their len_val fast path; the
            // value itself always points at element 0, so every index path
            // is unchanged.
            let one <&LLVMValue> = llvm_const_int(ctx.i64_ty, 1, 0);
            let slots <&LLVMValue> = llvm_build_add(ctx.builder, size_i64, one, "slots");
            let eight <&LLVMValue> = llvm_const_int(ctx.i64_ty, 8, 0);
            let calloc_fn <&LLVMValue> = get_or_declare_calloc(ctx);
            let c_fn_ty <&LLVMType> = llvm_global_get_value_type(calloc_fn);
            let c_args <&LLVMValueArgs> = new LLVMValueArgs{};
            c_args.v0 = slots;
            c_args.v1 = eight;
            let raw <&LLVMValue> = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args, 2, "arr_alloc");
            delete c_args;
            let ind_h <&LLVMIndices> = new LLVMIndices{};
            ind_h.i0 = llvm_const_int(ctx.i64_ty, 0, 0);
            let h_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, raw, ind_h, 1, "arr_len_p");
            delete ind_h;
            llvm_build_store(ctx.builder, size_i64, h_ptr);
            let ind_e <&LLVMIndices> = new LLVMIndices{};
            ind_e.i0 = llvm_const_int(ctx.i64_ty, 1, 0);
            let elem_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, raw, ind_e, 1, "arr_elems");
            delete ind_e;
            return elem_ptr;
        }
        if (cg_str_eq(n.name, "__fin_alloc_scalar")) {
            let calloc_fn <&LLVMValue> = get_or_declare_calloc(ctx);
            let c_fn_ty <&LLVMType> = llvm_global_get_value_type(calloc_fn);
            let c_args <&LLVMValueArgs> = new LLVMValueArgs{};
            c_args.v0 = llvm_const_int(ctx.i64_ty, 1, 0);
            c_args.v1 = llvm_const_int(ctx.i64_ty, 8, 0);
            let raw <&LLVMValue> = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args, 2, "scalar_alloc");
            delete c_args;
            if (n.left != null) {
                let s_val <&LLVMValue> = lower_expr(ctx, n.left);
                if (s_val != null) {
                    llvm_build_store(ctx.builder, s_val, raw);
                }
            } else {
                let zero <&LLVMValue> = llvm_const_int(ctx.i64_ty, 0, 0);
                llvm_build_store(ctx.builder, zero, raw);
            }
            return raw;
        }
        if (cg_str_eq(n.name, "__fin_array_literal")) {
            let cur_count <&AstNode> = n.left;
            let n_elems <int> = 0;
            while (cur_count != null) {
                n_elems = n_elems + 1;
                cur_count = cur_count.right;
            }
            if (n_elems == 0) {
                // A header word even when empty, so `.length` on a field or
                // parameter holding it reads 0 rather than heap metadata.
                let e_malloc <&LLVMValue> = get_or_declare_malloc(ctx);
                let e_ty <&LLVMType> = llvm_global_get_value_type(e_malloc);
                let e_args <&LLVMValueArgs> = new LLVMValueArgs{};
                e_args.v0 = llvm_const_int(ctx.i64_ty, 16, 0);
                let empty_raw <&LLVMValue> = llvm_build_call2(ctx.builder, e_ty, e_malloc, e_args, 1, "arr_lit");
                delete e_args;
                let ind_eh <&LLVMIndices> = new LLVMIndices{};
                ind_eh.i0 = llvm_const_int(ctx.i64_ty, 0, 0);
                let empty_hp <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, empty_raw, ind_eh, 1, "arr_len_p");
                delete ind_eh;
                llvm_build_store(ctx.builder, llvm_const_int(ctx.i64_ty, 0, 0), empty_hp);
                let ind_ee <&LLVMIndices> = new LLVMIndices{};
                ind_ee.i0 = llvm_const_int(ctx.i64_ty, 1, 0);
                let empty_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, empty_raw, ind_ee, 1, "arr_elems");
                delete ind_ee;
                return empty_ptr;
            }

            // Slot type comes from the first lowered element. The checker offers
            // every element its annotation's element type, so a checked literal
            // lowers homogeneously; the index load/store paths stride by the
            // declared element type and the C++ backend strides by
            // getTypeAllocSize, so the writer must stride the same way. Blanket
            // i64 slots read back as 1,0,2,0,3 for [int]. A generic-struct
            // field context may set arr_hint_auto (see cg_member_array_wide):
            // parameter-element fields build integer-kind and pointer slots
            // wide so all readers agree.
            let first_val <&LLVMValue> = lower_expr(ctx, n.left);
            if (first_val == null) { return null; }
            let slot_ty <&LLVMType> = llvm_type_of(first_val);
            if (ctx.arr_hint_auto) {
                if (slot_ty == ctx.i32_ty || slot_ty == ctx.i8_ty || slot_ty == ctx.i1_ty || slot_ty == ctx.ptr_ty) {
                    slot_ty = ctx.i64_ty;
                    first_val = coerce_val(ctx, first_val, slot_ty);
                }
            }
            let stride <int> = 8;
            if (slot_ty == ctx.i32_ty) {
                stride = 4;
            } else if (slot_ty == ctx.i16_ty) {
                stride = 2;
            } else if (slot_ty == ctx.float_ty) {
                stride = 4;
            } else if (slot_ty == ctx.i8_ty || slot_ty == ctx.i1_ty) {
                stride = 1;
            }

            let malloc_fn <&LLVMValue> = get_or_declare_malloc(ctx);
            let m_fn_ty <&LLVMType> = llvm_global_get_value_type(malloc_fn);
            let m_args <&LLVMValueArgs> = new LLVMValueArgs{};
            // One header word ahead of the elements: the extent lives at
            // [-1], so a field or parameter holding this literal reads its
            // length there. Element indices are unchanged (relative to the
            // returned element pointer).
            m_args.v0 = llvm_const_int(ctx.i64_ty, n_elems * stride + 8, 0);
            let lit_raw <&LLVMValue> = llvm_build_call2(ctx.builder, m_fn_ty, malloc_fn, m_args, 1, "arr_lit");
            delete m_args;
            let ind_lh <&LLVMIndices> = new LLVMIndices{};
            ind_lh.i0 = llvm_const_int(ctx.i64_ty, 0, 0);
            let lit_hp <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, lit_raw, ind_lh, 1, "arr_len_p");
            delete ind_lh;
            llvm_build_store(ctx.builder, llvm_const_int(ctx.i64_ty, n_elems, 0), lit_hp);
            let ind_le <&LLVMIndices> = new LLVMIndices{};
            ind_le.i0 = llvm_const_int(ctx.i64_ty, 1, 0);
            let arr_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, lit_raw, ind_le, 1, "arr_elems");
            delete ind_le;

            let ind0 <&LLVMIndices> = new LLVMIndices{};
            ind0.i0 = llvm_const_int(ctx.i64_ty, 0, 0);
            let gep0 <&LLVMValue> = llvm_build_gep2(ctx.builder, slot_ty, arr_ptr, ind0, 1, "elem_gep");
            delete ind0;
            llvm_build_store(ctx.builder, first_val, gep0);

            let cur_elem <&AstNode> = n.left.right;
            let idx <int> = 1;
            while (cur_elem != null) {
                let el_val <&LLVMValue> = lower_expr(ctx, cur_elem);
                if (el_val != null) {
                    el_val = coerce_val(ctx, el_val, slot_ty);
                    let ind <&LLVMIndices> = new LLVMIndices{};
                    ind.i0 = llvm_const_int(ctx.i64_ty, idx, 0);
                    let elem_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, slot_ty, arr_ptr, ind, 1, "elem_gep");
                    delete ind;
                    llvm_build_store(ctx.builder, el_val, elem_gep);
                }
                idx = idx + 1;
                cur_elem = cur_elem.right;
            }
            return arr_ptr;
        }
        if (cg_str_eq(n.name, "__fin_alloc_struct")) {
            let calloc_fn <&LLVMValue> = get_or_declare_calloc(ctx);
            let c_fn_ty <&LLVMType> = llvm_global_get_value_type(calloc_fn);
            let c_args <&LLVMValueArgs> = new LLVMValueArgs{};
            c_args.v0 = llvm_const_int(ctx.i64_ty, 1, 0);
            // Heap structs share one fixed buffer: it must fit the largest
            // struct (LLVMTypeArgs/LLVMValueArgs, 64 words = 512 bytes).
            // 1024 covers 128 word fields; a bigger struct needs this raised
            // everywhere it appears (struct_alloc, st_buf, ctor_obj alike).
            c_args.v1 = llvm_const_int(ctx.i64_ty, 1024, 0);
            let raw <&LLVMValue> = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args, 2, "struct_alloc");
            delete c_args;
            return raw;
        }
        if (cg_str_eq(n.name, "__fin_struct_init")) {
            let calloc_fn <&LLVMValue> = get_or_declare_calloc(ctx);
            let c_fn_ty <&LLVMType> = llvm_global_get_value_type(calloc_fn);
            let c_args <&LLVMValueArgs> = new LLVMValueArgs{};
            c_args.v0 = llvm_const_int(ctx.i64_ty, 1, 0);
            // Same fixed heap-struct buffer as struct_alloc: 1024 fits the
            // largest struct (64 words); raise together, never apart.
            c_args.v1 = llvm_const_int(ctx.i64_ty, 1024, 0);
            let st_ptr <&LLVMValue> = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args, 2, "st_buf");
            delete c_args;

            let st_name <string> = n.type_annotation;
            if (st_name == null || cg_strlen(st_name) == cast<ulong>(0) || cg_str_eq(st_name, "Self")) {
                let v_self <&LocalVar> = fn_ctx_find_var(ctx, "self");
                if (v_self != null && v_self.type_annotation != null) {
                    let s_ann <string> = v_self.type_annotation;
                    let slen <int> = cast<int>(cg_strlen(s_ann));
                    if (slen > 1 && (cg_str_eq(substr(s_ann, 0, 1), "&") || cg_str_eq(substr(s_ann, 0, 1), "*"))) {
                        s_ann = substr(s_ann, 1, slen - 1);
                        slen = slen - 1;
                    }
                    let sci <int> = 0;
                    while (sci < slen) {
                        if (cg_str_eq(substr(s_ann, sci, 1), "<")) {
                            s_ann = substr(s_ann, 0, sci);
                            break;
                        }
                        sci = sci + 1;
                    }
                    st_name = s_ann;
                }
            }
            // Slice 3: gate the instantiation before lowering any field. A
            // compared parameter naming a struct without a declared `==`
            // refuses here, where the spelling is still concrete -- the
            // self-host's read of C++ instantiateGeneric's use-site check.
            // Only explicit spellings gate (`Box<int>`); bare and elided
            // forms keep today's lowering and the method-call gate owns
            // those paths.
            let gate_spell <string> = st_name;
            if (n.resolved_spelling != null && cg_strlen(n.resolved_spelling) > cast<ulong>(0)) {
                gate_spell = n.resolved_spelling;
            }
            {
                let glen <int> = 0;
                if (gate_spell != null) { glen = cast<int>(cg_strlen(gate_spell)); }
                let gopen <int> = -1;
                let gi <int> = 0;
                while (gi < glen) {
                    if (cg_str_eq(substr(gate_spell, gi, 1), "<")) { gopen = gi; break; }
                    gi = gi + 1;
                }
                if (gopen > 0) {
                    let gbase <string> = cg_trim_spaces(substr(gate_spell, 0, gopen));
                    if (!cg_ctor_gate(ctx, gbase, gate_spell)) { return null; }
                }
            }
            // Field lowering keys on the bare template name, as before: the
            // annotation may now carry explicit arguments (`Box<int>`), and
            // indices are identical across instantiations of one template.
            {
                let slen2 <int> = 0;
                if (st_name != null) { slen2 = cast<int>(cg_strlen(st_name)); }
                let sopen <int> = -1;
                let si2 <int> = 0;
                while (si2 < slen2) {
                    if (cg_str_eq(substr(st_name, si2, 1), "<")) { sopen = si2; break; }
                    si2 = si2 + 1;
                }
                if (sopen > 0) {
                    st_name = cg_trim_spaces(substr(st_name, 0, sopen));
                }
            }
            // Per-instantiation field view (C++ buildStructValue evaluates
            // defaults in the instantiated context): `Vec2<float>` answers
            // `float` for `x <T>` where the bare template answers pointer.
            // Bare or unknown spellings answer the template (or null), and
            // the loops below fall back to the declared field type.
            let lit_inst <&StructInfo> = cg_ensure_struct_instance(ctx, gate_spell);
            let f_cur <&AstNode> = n.left;
            while (f_cur != null) {
                let saved_hint <bool> = ctx.arr_hint_auto;
                cg_apply_array_field_hint(ctx, st_name, f_cur.name, f_cur.left);
                let f_val <&LLVMValue> = lower_expr(ctx, f_cur.left);
                ctx.arr_hint_auto = saved_hint;
                f_val = fn_value_to_ptr(ctx, f_cur.left, f_val);
                let i_iface <&InterfaceInfo> = field_interface(ctx, st_name, f_cur.name);
                if (i_iface != null && i_iface.fat_ptr_ty != null && llvm_type_of(f_val) != ctx.ptr_ty) {
                    f_val = box_interface_value(ctx, f_val, i_iface.fat_ptr_ty);
                }
                // A value written for a nullable pair field wraps with its
                // presence; a pair written for a plain field refuses rather
                // than storing a two-word value into a one-word slot.
                // Omitted fields stay what calloc left (the zero pair,
                // absent) unless a declared default fills them below.
                let f_want <&LLVMType> = get_struct_field_type_by_name(ctx, st_name, f_cur.name);
                if (f_val != null && f_want != null) {
                    if (cg_is_tagged_pair(ctx, f_want) && !cg_is_tagged_pair(ctx, llvm_type_of(f_val))) {
                        f_val = cg_wrap_nullable(ctx, f_val, f_want, cg_is_absent_spelling(f_cur.left));
                    } else if (cg_is_tagged_pair(ctx, f_want) && cg_is_tagged_pair(ctx, llvm_type_of(f_val))) {
                        f_val = cg_convert_pair(ctx, f_val, f_want);
                    } else if (!cg_is_tagged_pair(ctx, f_want) && cg_is_tagged_pair(ctx, llvm_type_of(f_val))) {
                        cg_dprintf(2, "finc codegen refusal: struct literal field '%s' holds a nullable value without denullify ('?')\n", f_cur.name);
                        refuse_and_poison(ctx);
                        llvm_build_unreachable(ctx.builder);
                        return null;
                    }
                }
                // A numeric init into a float/double slot converts (C++
                // converts an int literal for a float field; storing the
                // raw word reads back garbage). Other slots lower as before.
                {
                    let f_sub <&LLVMType> = f_want;
                    if (lit_inst != null) {
                        let f_sfi <int> = 0;
                        while (f_sfi < lit_inst.field_count) {
                            let f_sf <&StructFieldInfo> = lit_inst.fields[f_sfi];
                            if (f_sf != null && cg_str_eq(f_sf.name, f_cur.name)) {
                                f_sub = map_type(ctx, f_sf.type_annotation);
                                break;
                            }
                            f_sfi = f_sfi + 1;
                        }
                    }
                    if (f_val != null && f_sub != null && (f_sub == ctx.float_ty || f_sub == ctx.double_ty)) {
                        let f_vt <&LLVMType> = llvm_type_of(f_val);
                        if (f_vt != f_sub && (f_vt == ctx.i32_ty || f_vt == ctx.i64_ty || f_vt == ctx.i8_ty || f_vt == ctx.i16_ty || f_vt == ctx.i1_ty || f_vt == ctx.float_ty || f_vt == ctx.double_ty)) {
                            f_val = coerce_val(ctx, f_val, f_sub);
                        }
                    }
                }
                let f_idx <int> = find_field_index_by_name(ctx, st_name, f_cur.name);
                let ind <&LLVMIndices> = new LLVMIndices{};
                ind.i0 = llvm_const_int(ctx.i64_ty, f_idx, 0);
                let f_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, st_ptr, ind, 1, "f_gep");
                delete ind;
                llvm_build_store(ctx.builder, f_val, f_gep);
                f_cur = f_cur.right;
            }
            // Omitted-field defaults (C++ buildStructValue's defaults
            // loop): every field the literal did not write but declares a
            // default evaluates it here, after the written values, in
            // declared order. A written field's own value stands, never
            // re-run; fields without defaults stay what calloc left.
            let d_si <&StructInfo> = find_struct(ctx, st_name);
            if (d_si != null) {
                let d_fi <int> = 0;
                while (d_fi < d_si.field_count) {
                    let d_fld <&StructFieldInfo> = d_si.fields[d_fi];
                    d_fi = d_fi + 1;
                    if (d_fld == null || d_fld.default_init == null) { continue; }
                    let d_w <&AstNode> = n.left;
                    let d_written <bool> = false;
                    while (d_w != null) {
                        if (d_w.name != null && cg_str_eq(d_w.name, d_fld.name)) { d_written = true; break; }
                        d_w = d_w.right;
                    }
                    if (d_written) { continue; }
                    let d_saved <bool> = ctx.arr_hint_auto;
                    cg_apply_array_field_hint(ctx, st_name, d_fld.name, d_fld.default_init);
                    let d_val <&LLVMValue> = lower_expr(ctx, d_fld.default_init);
                    ctx.arr_hint_auto = d_saved;
                    d_val = fn_value_to_ptr(ctx, d_fld.default_init, d_val);
                    let d_iface <&InterfaceInfo> = field_interface(ctx, st_name, d_fld.name);
                    if (d_iface != null && d_iface.fat_ptr_ty != null && llvm_type_of(d_val) != ctx.ptr_ty) {
                        d_val = box_interface_value(ctx, d_val, d_iface.fat_ptr_ty);
                    }
                    let d_want <&LLVMType> = get_struct_field_type_by_name(ctx, st_name, d_fld.name);
                    if (d_val != null && d_want != null) {
                        if (cg_is_tagged_pair(ctx, d_want) && !cg_is_tagged_pair(ctx, llvm_type_of(d_val))) {
                            d_val = cg_wrap_nullable(ctx, d_val, d_want, cg_is_absent_spelling(d_fld.default_init));
                        } else if (cg_is_tagged_pair(ctx, d_want) && cg_is_tagged_pair(ctx, llvm_type_of(d_val))) {
                            d_val = cg_convert_pair(ctx, d_val, d_want);
                        } else if (!cg_is_tagged_pair(ctx, d_want) && cg_is_tagged_pair(ctx, llvm_type_of(d_val))) {
                            cg_dprintf(2, "finc codegen refusal: struct literal field '%s' holds a nullable value without denullify ('?')\n", d_fld.name);
                            refuse_and_poison(ctx);
                            llvm_build_unreachable(ctx.builder);
                            return null;
                        }
                    }
                    // Same numeric conversion as written fields above: an
                    // int default (`x <float> = 1`) reads 1.0 on C++.
                    {
                        let d_sub <&LLVMType> = d_want;
                        if (lit_inst != null) {
                            let d_sfi <int> = 0;
                            while (d_sfi < lit_inst.field_count) {
                                let d_sf <&StructFieldInfo> = lit_inst.fields[d_sfi];
                                if (d_sf != null && cg_str_eq(d_sf.name, d_fld.name)) {
                                    d_sub = map_type(ctx, d_sf.type_annotation);
                                    break;
                                }
                                d_sfi = d_sfi + 1;
                            }
                        }
                        if (d_val != null && d_sub != null && (d_sub == ctx.float_ty || d_sub == ctx.double_ty)) {
                            let d_vt <&LLVMType> = llvm_type_of(d_val);
                            if (d_vt != d_sub && (d_vt == ctx.i32_ty || d_vt == ctx.i64_ty || d_vt == ctx.i8_ty || d_vt == ctx.i16_ty || d_vt == ctx.i1_ty || d_vt == ctx.float_ty || d_vt == ctx.double_ty)) {
                                d_val = coerce_val(ctx, d_val, d_sub);
                            }
                        }
                    }
                    let d_idx <int> = find_field_index_by_name(ctx, st_name, d_fld.name);
                    let d_ind <&LLVMIndices> = new LLVMIndices{};
                    d_ind.i0 = llvm_const_int(ctx.i64_ty, d_idx, 0);
                    let d_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, st_ptr, d_ind, 1, "f_gep");
                    delete d_ind;
                    llvm_build_store(ctx.builder, d_val, d_gep);
                }
            }
            return st_ptr;
        }
        // `@move(x)` is the identity at runtime: moving changes
        // ownership, not type (the checker marked the move; `move_or_copy`
        // is wave 5). Lower the operand for its value.
        if (cg_str_eq(n.name, "move") || cg_str_eq(n.name, "@move")) {
            let mv_arg <&AstNode> = n.left;
            if (mv_arg != null && mv_arg.kind == 0 && mv_arg.left != null) { mv_arg = mv_arg.left; }
            // Wave-5 slice 1: mark the operand moved-from for the cleanup
            // skip (claimant-gated; without a claimant the flag is never
            // read, so unclaimed output is untouched).
            if (ctx.has_move_claim && mv_arg != null && mv_arg.kind == ast_ident()) {
                let mv_v <&LocalVar> = fn_ctx_find_var(ctx, mv_arg.name);
                if (mv_v != null) { mv_v.moved = true; }
            }
            if (mv_arg == null) {
                cg_dprintf(2, "codegen: the compile-time call '@move' is not lowered yet\n");
                refuse_and_poison(ctx);
                return null;
            }
            return lower_expr(ctx, mv_arg);
        }
        // `@defined("name")` folds to whether the name is declared: the
        // C++ backend answers from its function, struct, enum and global
        // tables, so `printf` (a runtime intrinsic, never a user
        // declaration) folds false and the literal_struct.fin guard takes
        // the define branch while the gated call resolves through the
        // ambient printf declaration below. Anything but one string
        // literal keeps the refusal, never a guess.
        if (cg_str_eq(n.name, "defined") || cg_str_eq(n.name, "@defined")) {
            let def_argc <int> = 0;
            let def_w <&AstNode> = n.left;
            while (def_w != null) {
                def_argc = def_argc + 1;
                def_w = def_w.right;
            }
            if (def_argc == 1 && n.left != null) {
                let def_a <&AstNode> = n.left.left;
                if (def_a == null) { def_a = n.left; }
                if (def_a.kind == ast_literal_string() && def_a.str_val != null) {
                    let def_target <string> = unescape_string_literal(def_a.str_val);
                    let def_hit <bool> = false;
                    if (fn_ctx_find_fn(ctx, def_target) != null) { def_hit = true; }
                    if (!def_hit && find_struct(ctx, def_target) != null) { def_hit = true; }
                    if (!def_hit && find_enum(ctx, def_target) != null) { def_hit = true; }
                    if (!def_hit && llvm_get_named_global(ctx.module, def_target) != null) { def_hit = true; }
                    if (def_hit) {
                        return llvm_const_int(ctx.i1_ty, 1, 0);
                    }
                    return llvm_const_int(ctx.i1_ty, 0, 0);
                }
            }
            let at_name <string> = n.name;
            let at_buf <Buffer> = new_buffer(32);
            if (!cg_str_eq(substr(at_name, 0, 1), "@")) {
                at_buf.write_char('@');
                at_buf.write_string(at_name);
                at_name = at_buf.to_string();
            }
            cg_dprintf(2, "codegen: the compile-time call '%s' is not lowered yet\n", at_name);
            free_buffer(at_buf);
            refuse_and_poison(ctx);
            return null;
        }
        // Whether the node is a `compiler`-rooted member path (the
        // desugared receiver of `compiler.types.implements(...)`), which
        // is not a query argument: skip it like the checker does.
        fun cg_is_compiler_recv(node: &AstNode) <bool> {
            let cur <&AstNode> = node;
            while (cur != null && cur.kind == ast_member_access()) {
                cur = cur.left;
            }
            if (cur == null || cur.kind != ast_ident()) { return false; }
            if (cur.name == null) { return false; }
            return cg_str_eq(cur.name, "compiler");
        }

        // `@implements` static fold for concrete named pairs (Stage B):
        // two identifiers naming a known struct and interface lower to a
        // bool constant via the conformance predicate. Anything else
        // (a `$struct`/`$interface` value, a generic spelling) keeps the
        // refusal below, never a guessed answer.
        if (cg_str_eq(n.name, "implements") || cg_str_eq(n.name, "@implements")) {
            let imp_head <&AstNode> = n.left;
            if (imp_head != null) {
                let imp_first <&AstNode> = imp_head.left;
                if (imp_first == null) { imp_first = imp_head; }
                if (cg_is_compiler_recv(imp_first)) {
                    imp_head = imp_head.right;
                }
            }
            let imp_argc <int> = 0;
            let imp_w <&AstNode> = imp_head;
            while (imp_w != null) {
                imp_argc = imp_argc + 1;
                imp_w = imp_w.right;
            }
            if (imp_argc != 2) {
                cg_dprintf(2, "finc codegen refusal: '@implements' takes exactly 2 arguments\n");
                refuse_and_poison(ctx);
                return null;
            }
            let imp_a0 <&AstNode> = null;
            let imp_a1 <&AstNode> = null;
            if (imp_head != null) {
                imp_a0 = imp_head.left;
                if (imp_a0 == null) { imp_a0 = imp_head; }
                if (imp_head.right != null) {
                    imp_a1 = imp_head.right.left;
                    if (imp_a1 == null) { imp_a1 = imp_head.right; }
                }
            }
            if (imp_a0 != null && imp_a1 != null &&
              imp_a0.kind == ast_ident() && imp_a1.kind == ast_ident()) {
                let s_nm <string> = imp_a0.name;
                let i_nm <string> = imp_a1.name;
                if (s_nm != null && i_nm != null &&
                  !cg_str_contains(s_nm, "<") && !cg_str_contains(i_nm, "<")) {
                    let s_info <&StructInfo> = find_struct(ctx, s_nm);
                    let i_info <&InterfaceInfo> = find_interface(ctx, i_nm);
                    if (s_info != null && i_info != null) {
                        if (s_info.gen_params == null || cg_strlen(s_info.gen_params) == cast<ulong>(0)) {
                            if (cg_implements_conforms(ctx, s_nm, i_nm)) {
                                return llvm_const_int(ctx.i1_ty, 1, 0);
                            }
                            return llvm_const_int(ctx.i1_ty, 0, 0);
                        }
                    }
                  }
              }
            // Dynamic `$struct`/`$interface` values (Stage C tid-pair chain):
            // both sides lower to i64 tids; the answer is the OR over every
            // conforming (struct, interface) pair known here. A side that is
            // not a tid refuses naming the side, like the C++ backend.
            let s_val <&LLVMValue> = lower_expr(ctx, imp_a0);
            let i_val <&LLVMValue> = lower_expr(ctx, imp_a1);
            if (s_val == null || llvm_type_of(s_val) != ctx.i64_ty) {
                cg_dprintf(2, "finc codegen refusal: the first argument of dynamic '@implements' is not a struct type\n");
                refuse_and_poison(ctx);
                return null;
            }
            if (i_val == null || llvm_type_of(i_val) != ctx.i64_ty) {
                cg_dprintf(2, "finc codegen refusal: the second argument of dynamic '@implements' is not an interface type\n");
                refuse_and_poison(ctx);
                return null;
            }
            let cond <&LLVMValue> = llvm_const_int(ctx.i1_ty, 0, 0);
            let si <int> = 0;
            while (si < ctx.struct_count) {
                let st <&StructInfo> = ctx.structs[si];
                if (st != null && st.name != null) {
                    let ii <int> = 0;
                    while (ii < ctx.interface_count) {
                        let iface <&InterfaceInfo> = ctx.interfaces[ii];
                        if (iface != null && iface.name != null) {
                            if (cg_implements_conforms(ctx, st.name, iface.name)) {
                                let ms <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), s_val, llvm_const_int(ctx.i64_ty, si, 0), "match.s");
                                let mi2 <&LLVMValue> = llvm_build_icmp(ctx.builder, llvm_int_eq(), i_val, llvm_const_int(ctx.i64_ty, ii, 0), "match.i");
                                let both <&LLVMValue> = llvm_build_and(ctx.builder, ms, mi2, "match.both");
                                cond = llvm_build_or(ctx.builder, cond, both, "match.implements");
                            }
                        }
                        ii = ii + 1;
                    }
                }
                si = si + 1;
            }
            return cond;
        }
        if (cg_str_eq(n.name, "Alloc") || cg_str_eq(n.name, "@Alloc")) {            let size_val <&LLVMValue> = lower_expr(ctx, n.left);
            let size_i64 <&LLVMValue> = llvm_build_sext(ctx.builder, size_val, ctx.i64_ty, "alloc_size");
            let malloc_fn <&LLVMValue> = get_or_declare_malloc(ctx);
            let m_fn_ty <&LLVMType> = llvm_global_get_value_type(malloc_fn);
            let m_args <&LLVMValueArgs> = new LLVMValueArgs{};
            m_args.v0 = size_i64;
            let raw <&LLVMValue> = llvm_build_call2(ctx.builder, m_fn_ty, malloc_fn, m_args, 1, "raw_alloc");
            delete m_args;
            return raw;
        }

        if (cg_str_eq(n.name, "free") || cg_str_eq(n.name, "Free") || cg_str_eq(n.name, "@Free")) {
            let actual_arg <&AstNode> = n.left;
            if (actual_arg != null && actual_arg.kind == 0 && actual_arg.left != null) { actual_arg = actual_arg.left; }
            let p_val <&LLVMValue> = lower_expr(ctx, actual_arg);
            if (p_val != null) {
                let target_var <&LocalVar> = null;

                let chk_node <&AstNode> = actual_arg;
                if (chk_node != null && chk_node.kind == ast_unary_expr() && cg_str_eq(chk_node.name, "cast") && chk_node.left != null) {
                    chk_node = chk_node.left;
                }
                if (chk_node != null && chk_node.kind == ast_unary_expr() && cg_str_eq(chk_node.name, "&")) {
                    if (chk_node.left != null && chk_node.left.kind == ast_ident()) {
                        target_var = fn_ctx_find_var(ctx, chk_node.left.name);
                    }
                }
                if (actual_arg != null && actual_arg.kind == ast_ident()) {
                    let direct_v <&LocalVar> = fn_ctx_find_var(ctx, actual_arg.name);
                    if (direct_v != null && direct_v.type_annotation != null) {
                        let f_ch <string> = substr(direct_v.type_annotation, 0, 1);
                        if (!cg_str_eq(f_ch, "&") && !cg_str_eq(f_ch, "*")) {
                            target_var = direct_v;
                        }
                    }
                }

                let st_name <string> = get_node_struct_name(ctx, actual_arg);
                if (cg_strlen(st_name) > cast<ulong>(0)) {
                    // Wave-5 slice 2: the destructor runs before the storage
                    // goes (deeptest3.fin:44) -- the declared body, then
                    // fields in reverse order through emit_destructor_for_obj,
                    // so cleanup composes. A type with nothing to clean frees
                    // exactly as before.
                    emit_destructor_for_obj(ctx, st_name, p_val);
                }

                if (target_var != null) {
                    target_var.destroyed = true;
                }

                // `delete` always frees, even of a stack address: the C++
                // backend frees unconditionally (free aborts on a stack
                // address), so skipping the call here was a silent
                // no-op divergence (exit 0 where C++ aborts).
                //
                // One shape stays a no-op: the address of a composite
                // element (`delete &a[10]`, `delete &s.field`). There the
                // C++ backend erases a member instead of freeing storage
                // (a double `delete &a[10]` exits 0; a re-read blames
                // "key is not in the prototype"), and the stage has no
                // member-erasure lowering (its lookups cannot even blame).
                // Freeing the element address aborts where C++ exits 0
                // (prototype_test.fin:23), so this keeps the old no-op for
                // exactly that shape until erasure is modelled.
                let del_inner <&AstNode> = chk_node;
                if (del_inner != null && del_inner.kind == ast_unary_expr() && cg_str_eq(del_inner.name, "&") && del_inner.left != null) {
                    let del_op <&AstNode> = del_inner.left;
                    if (del_op.kind == ast_index_expr() || del_op.kind == ast_member_access()) {
                        return p_val;
                    }
                }

                // Wave-5 slice 3 (ADR 0014): with a `deallocate` claimant
                // whose generation exists, the claimant substitutes the
                // deallocation call. Only the `free` is replaced -- the
                // destructor above already ran -- so deeptest3.fin:44's
                // order holds by construction, mirroring the C++ backend's
                // delete site. Without a claimant, or with an empty-bodied
                // claim (recorded, no generation), this lowers exactly as
                // before.
                let dealloc_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "__fin_dealloc_claim");
                if (dealloc_fn != null) {
                    let d_fn_ty <&LLVMType> = llvm_global_get_value_type(dealloc_fn);
                    let dealloc_res <&LLVMValue> = llvm_build_call2(ctx.builder, d_fn_ty, dealloc_fn, null, 0, "");
                    return dealloc_res;
                }

                let free_fn <&LLVMValue> = get_or_declare_free(ctx);
                let f_fn_ty <&LLVMType> = llvm_global_get_value_type(free_fn);
                let f_args <&LLVMValueArgs> = new LLVMValueArgs{};
                // Array values point at element 0 with the extent in the
                // header word before it (`new` and literals): free the
                // allocation base, not the element pointer. Anything else
                // frees exactly as before.
                if (st_name != null && cg_strlen(st_name) > cast<ulong>(0) && cg_str_eq(substr(st_name, 0, 1), "[")) {
                    let ind_db <&LLVMIndices> = new LLVMIndices{};
                    ind_db.i0 = llvm_const_int_of_string(ctx.i64_ty, "-1", 10);
                    let base_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, p_val, ind_db, 1, "arr_base");
                    delete ind_db;
                    f_args.v0 = base_ptr;
                } else {
                    f_args.v0 = p_val;
                }
                let free_res <&LLVMValue> = llvm_build_call2(ctx.builder, f_fn_ty, free_fn, f_args, 1, "");
                delete f_args;
                return free_res;
            }
        }

        if (cg_str_eq(n.name, "getkeyid") && n.left != null) {
            let actual_arg <&AstNode> = n.left.left;
            if (actual_arg == null) { actual_arg = n.left; }
            let arg_val <&LLVMValue> = lower_expr(ctx, actual_arg);
            if (arg_val != null) {
                let aty <&LLVMType> = llvm_type_of(arg_val);
                let e_match <&EnumInfo> = find_enum_by_llvm_type(ctx, aty);
                if (e_match != null) {
                    return llvm_build_extract_value(ctx.builder, arg_val, 0, "tag");
                }
                if (aty == ctx.i32_ty) {
                    return arg_val;
                }
                return coerce_val(ctx, arg_val, ctx.i32_ty);
            }
            return llvm_const_int(ctx.i32_ty, 0, 0);
        }
        if (cg_str_eq(n.name, "keyidof") && n.left != null) {
            let mem_name <string> = "";
            let actual_arg <&AstNode> = n.left.left;
            if (actual_arg == null) { actual_arg = n.left; }
            if (actual_arg.kind == ast_ident()) { mem_name = actual_arg.name; }
            let mem <&EnumMemberInfo> = find_enum_member_global(ctx, mem_name);
            if (mem != null) {
                return llvm_const_int(ctx.i32_ty, mem.tag, 0);
            }
            return llvm_const_int(ctx.i32_ty, 0, 0);
        }
        // `hash_word::<T>(key)` -- the hashable word (ADR 0049): FNV-1a for
        // a `string`, the `cast<int>` machine value otherwise. A bodiless
        // generic declaration lowered per concrete argument, on the footing
        // of `keyidof`/`getkeyid` above (a definition wins and falls
        // through). Generic or exotic spellings fall through to the old
        // path, which owns every refusal.
        if (cg_str_eq(n.name, "hash_word") && n.left != null) {
            if (cg_hash_word_is_leaf(ctx, n.name)) {
                let hw_argc <int> = 0;
                let hw_cw <&AstNode> = n.left;
                while (hw_cw != null && hw_argc < 3) {
                    hw_argc = hw_argc + 1;
                    hw_cw = hw_cw.right;
                }
                if (hw_argc != 1) {
                    cg_dprintf(2, "finc codegen refusal: a call to 'hash_word' with %d argument(s) where it declares 1\n", hw_argc);
                    refuse_and_poison(ctx);
                    return null;
                }
                let hw_actual <&AstNode> = n.left.left;
                if (hw_actual == null) { hw_actual = n.left; }
                let hw_spell <string> = cg_free_spelling_of(ctx, hw_actual, 8);
                if (cg_strlen(hw_spell) > cast<ulong>(0)) {
                    let hw_s <string> = cg_trim_spaces(cg_strip_markers(hw_spell));
                    if (!cg_str_eq(hw_s, "Self") && !cg_is_generic_ann(ctx, hw_s) && !cg_is_type_param(hw_s)) {
                        if (cg_str_eq(hw_s, "string")) {
                            let hw_data <&LLVMValue> = lower_expr(ctx, hw_actual);
                            if (hw_data != null) {
                                let hw_h <&LLVMValue> = cg_hash_word_string(ctx, hw_data);
                                if (hw_h != null) { return hw_h; }
                            }
                        } else if (cg_free_modellable(ctx, hw_s, 8)) {
                            let hw_v <&LLVMValue> = lower_expr(ctx, hw_actual);
                            if (hw_v != null) {
                                let hw_w <&LLVMValue> = coerce_val(ctx, hw_v, ctx.i32_ty);
                                if (hw_w != null) { return hw_w; }
                            }
                        }
                    }
                }
            }
        }
        let em_call <&EnumMemberInfo> = find_enum_member_global(ctx, n.name);
        if (em_call != null) {
            let en_owner <&EnumInfo> = find_enum_for_member(ctx, em_call.name);
            // ENGA slice 2: a generic enum constructor names its
            // per-instantiation layout (`Res::<int>::Ok`), mirroring C++
            // instantiateEnumGeneric. The template alone answers only the
            // tag; the payload slot comes from the instance. An elided
            // generic target (`Res::Ok` with no args) is exotic and refuses
            // rather than crashing (C++ `a '::' call on a target of type
            // 'Res' is not lowered yet`).
            if (en_owner != null && en_owner.gen_params != null && cg_strlen(en_owner.gen_params) > cast<ulong>(0)) {
                let efull <string> = "";
                if (n.resolved_spelling != null && cg_strlen(n.resolved_spelling) > cast<ulong>(0)) {
                    efull = cg_trim_spaces(n.resolved_spelling);
                } else if (n.type_annotation != null && cg_strlen(n.type_annotation) > cast<ulong>(0)) {
                    let ebase <string> = en_owner.name;
                    let elen <int> = cast<int>(cg_strlen(ebase));
                    let elt <int> = 0;
                    while (elt < elen) {
                        if (cg_str_eq(substr(ebase, elt, 1), "<")) { ebase = cg_trim_spaces(substr(ebase, 0, elt)); break; }
                        elt = elt + 1;
                    }
                    let eb <Buffer> = new_buffer(64);
                    eb.write_string(ebase);
                    eb.write_char('<');
                    eb.write_string(cg_trim_spaces(n.type_annotation));
                    eb.write_char('>');
                    efull = eb.to_string();
                    free_buffer(eb);
                }
                if (cg_strlen(efull) == cast<ulong>(0)) {
                    // Bare generic constructor (`Ok(10)` for
                    // `let r <Result<int, string>>`): the annotation already
                    // instantiated the layout via map_type, so mirror the
                    // C++ flat-table inference where a single existing
                    // instantiation carries the member. Unique wins; zero or
                    // ambiguous stays a named refusal, never a guessed layout.
                    let ebase2 <string> = en_owner.name;
                    let eblen <int> = cast<int>(cg_strlen(ebase2));
                    let ecut <int> = 0;
                    while (ecut < eblen) {
                        if (cg_str_eq(substr(ebase2, ecut, 1), "<")) { ebase2 = cg_trim_spaces(substr(ebase2, 0, ecut)); break; }
                        ecut = ecut + 1;
                    }
                    let uniq <&EnumInfo> = null;
                    let ucount <int> = 0;
                    ctx.enum_count = recount_enums(ctx.enums, ctx.enum_count);
                    let ei <int> = 0;
                    while (ei < ctx.enum_count) {
                        let cand <&EnumInfo> = ctx.enums[ei];
                        if (cand != null && cand.name != null && cg_strlen(cand.name) > cg_strlen(ebase2)) {
                            if (cg_str_eq(substr(cand.name, 0, cast<int>(cg_strlen(ebase2))), ebase2) && cg_str_eq(substr(cand.name, cast<int>(cg_strlen(ebase2)), 1), "<")) {
                                let mj <int> = 0;
                                while (mj < cand.member_count) {
                                    let mm <&EnumMemberInfo> = cand.members[mj];
                                    if (mm != null && cg_str_eq(mm.name, n.name)) {
                                        ucount = ucount + 1;
                                        uniq = cand;
                                        break;
                                    }
                                    mj = mj + 1;
                                }
                            }
                        }
                        ei = ei + 1;
                    }
                    if (ucount == 1 && uniq != null) {
                        en_owner = uniq;
                    } else {
                        if (ucount > 1) {
                            cg_dprintf(2, "finc codegen refusal: a bare '%s' on generic '%s' is ambiguous (%d instantiations carry it)\n", n.name, ebase2, ucount);
                        } else {
                            cg_dprintf(2, "finc codegen refusal: a '::' call on a target of type '%s' is not lowered yet (needs an explicit instantiation)\n", en_owner.name);
                        }
                        refuse_and_poison(ctx);
                        return llvm_const_int(ctx.i32_ty, 0, 0);
                    }
                } else {
                    let einst <&EnumInfo> = cg_ensure_enum_instance(ctx, efull);
                    if (einst != null && einst.has_payload) {
                        en_owner = einst;
                    } else if (einst != null) {
                        en_owner = einst;
                    }
                }
            }
            if (en_owner != null && en_owner.has_payload) {
                let slot <&LLVMValue> = llvm_build_alloca(ctx.builder, en_owner.llvm_type, "enum.tmp");
                let tag_ptr <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, en_owner.llvm_type, slot, 0, "tag");
                llvm_build_store(ctx.builder, llvm_const_int(ctx.i32_ty, em_call.tag, 0), tag_ptr);
                if (n.left != null) {
                    let actual_arg <&AstNode> = n.left.left;
                    if (actual_arg == null) { actual_arg = n.left; }
                    let p_val <&LLVMValue> = lower_expr(ctx, actual_arg);
                    if (p_val != null) {
                        let payload_gep <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, en_owner.llvm_type, slot, 1, "payload");
                        let pt <&LLVMType> = llvm_type_of(p_val);
                        let p_cast <&LLVMValue> = llvm_build_bitcast(ctx.builder, payload_gep, llvm_pointer_type(pt, 0), "p_cast");
                        llvm_build_store(ctx.builder, p_val, p_cast);
                    }
                }
                return llvm_build_load2(ctx.builder, en_owner.llvm_type, slot, "enum.constructed");
            }
            return llvm_const_int(ctx.i32_ty, em_call.tag, 0);
        }
        if (cg_str_eq(n.name, "rm") && n.left != null) {
            let actual_rec <&AstNode> = n.left.left;
            if (actual_rec == null) { actual_rec = n.left; }
            if (is_prototype_node(ctx, actual_rec)) {
                let proto_val <&LLVMValue> = lower_expr(ctx, actual_rec);
                if (proto_val != null) {
                    let ind_l <&LLVMIndices> = new LLVMIndices{};
                    ind_l.i0 = llvm_const_int(ctx.i64_ty, 1, 0);
                    let plen_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, proto_val, ind_l, 1, "plen_p");
                    delete ind_l;
                    let cur_len <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, plen_ptr, "cur_l");
                    let one <&LLVMValue> = llvm_const_int(ctx.i64_ty, 1, 0);
                    let new_len <&LLVMValue> = llvm_build_sub(ctx.builder, cur_len, one, "dec_l");
                    llvm_build_store(ctx.builder, new_len, plen_ptr);
                    return llvm_const_int(ctx.i1_ty, 1, 0);
                }
            }
        }
        if (n.left != null) {
            let actual_rec <&AstNode> = n.left.left;
            if (actual_rec == null) { actual_rec = n.left; }
            let iface <&InterfaceInfo> = find_interface_for_node(ctx, actual_rec);
            if (iface != null) {
                let m_info <&InterfaceMethodInfo> = find_interface_method(iface, n.name);
                // Fields share the entry table (is_field); only methods dispatch.
                if (m_info != null && !m_info.is_field) {
                    let iface_pair <&LLVMValue> = lower_expr(ctx, actual_rec);
                    if (iface_pair != null) {
                        let data_ptr <&LLVMValue> = llvm_build_extract_value(ctx.builder, iface_pair, 0, "data");
                        let vtable_ptr <&LLVMValue> = llvm_build_extract_value(ctx.builder, iface_pair, 1, "vtable");
                        let ind <&LLVMIndices> = new LLVMIndices{};
                        ind.i0 = llvm_const_int(ctx.i64_ty, m_info.index, 0);
                        let fn_slot <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, vtable_ptr, ind, 1, "fn_slot");
                        delete ind;
                        let fn_ptr <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, fn_slot, "m_ptr");
                        let if_args <&LLVMValueArgs> = new LLVMValueArgs{};
                        if_args.v0 = data_ptr;
                        let if_arg_count <int> = 1;
                        let cur_wrap <&AstNode> = n.left.right;
                        let if_bad <bool> = false;
                        while (cur_wrap != null && if_arg_count < 64) {
                            let actual_arg <&AstNode> = cur_wrap.left;
                            if (actual_arg == null) { actual_arg = cur_wrap; }
                            let av <&LLVMValue> = lower_expr(ctx, actual_arg);
                            if (av == null) { if_bad = true; }
                            cg_vargs_set(if_args, if_arg_count, av);
                            if_arg_count = if_arg_count + 1;
                            cur_wrap = cur_wrap.right;
                        }
                        if (cur_wrap != null) {
                            // More arguments than the LLVMValueArgs carrier
                            // holds (64): refuse instead of dropping the
                            // tail silently.
                            cg_dprintf(2, "finc codegen refusal: call to '%s' has more arguments than are lowered (at most 64)\n", n.name);
                            delete if_args;
                            refuse_and_poison(ctx);
                            llvm_build_unreachable(ctx.builder);
                            return null;
                        }
                        if (if_bad || ctx.poisoned) {
                            delete if_args;
                            return null;
                        }
                        let ret_t <&LLVMType> = map_type(ctx, m_info.ret_type);
                        let if_params <&LLVMTypeArgs> = new LLVMTypeArgs{};
                        if_params.t0 = ctx.ptr_ty;
                        let if_ti <int> = 1;
                        while (if_ti < if_arg_count) {
                            let if_v <&LLVMValue> = cg_vargs_at(if_args, if_ti);
                            if (if_v != null) { cg_targs_set(if_params, if_ti, llvm_type_of(if_v)); }
                            if_ti = if_ti + 1;
                        }
                        let if_fn_ty <&LLVMType> = llvm_function_type(ret_t, if_params, if_arg_count, 0);
                        delete if_params;
                        let res_v <&LLVMValue> = llvm_build_call2(ctx.builder, if_fn_ty, fn_ptr, if_args, if_arg_count, "if_call");
                        delete if_args;
                        return res_v;
                    }
                }
            }
        }
        let callee <&LLVMValue> = null;
        let callee_fn_ty <&LLVMType> = null;
        let is_ctor <bool> = false;
        let ctor_st_ptr <&LLVMValue> = null;
        let is_scope_call <bool> = false;

        if (cg_str_eq(n.name, "printf")) {
            let p_fn <&LLVMValue> = get_or_declare_printf(ctx);
            callee = p_fn;
            callee_fn_ty = llvm_global_get_value_type(p_fn);
        } else {
            // MC1 (b): per-instantiation method bodies. A generic receiver
            // with a modellable spelling declares and drains one body per
            // key; anything exotic falls through to the tripwire path below.
            // A refusal poisons ctx; the caller returns null outright so the
            // old path does not report it twice.
            let cached <&FnSymbol> = cg_method_cache_sym(ctx, n);
            if (ctx.poisoned) { return null; }
            if (cached != null) {
                callee = cached.fn_val;
                callee_fn_ty = cached.fn_ty;
            }
            // FG1: per-instantiation free-function bodies over generic
            // structs. A modellable spelling declares and drains one body
            // per key; anything exotic falls through to the refusal below.
            // A refusal poisons ctx; the caller returns null outright.
            if (callee == null) {
                let free_hit <&FnSymbol> = cg_free_cache_sym(ctx, n);
                if (ctx.poisoned) { return null; }
                if (free_hit != null) {
                    callee = free_hit.fn_val;
                    callee_fn_ty = free_hit.fn_ty;
                }
            }
            // MM1: interface-dispatched methods (`Printable_to_string` on a
            // concrete receiver). The checker rewrites `item.to_string()`
            // on `T: Printable` to the interface spelling; when the call
            // site names a concrete instantiation (`User`), dispatch to the
            // struct's own method. Keyed on the concrete receiver; exotic
            // (generic, unmodellable) returns null and stays on the old
            // path, which owns every refusal. A refusal poisons ctx.
            if (callee == null) {
                let if_hit <&FnSymbol> = cg_interface_cache_sym(ctx, n);
                if (ctx.poisoned) { return null; }
                if (if_hit != null) {
                    callee = if_hit.fn_val;
                    callee_fn_ty = if_hit.fn_ty;
                }
            }
            // Static call `Struct::method`: the declared LLVM name joins with
            // an underscore. No receiver is passed; statics take exactly the
            // written arguments.
            if (n.name != null) {
                let nm_len <int> = cast<int>(cg_strlen(n.name));
                let dc_at <int> = -1;
                let di <int> = 0;
                while (di + 1 < nm_len) {
                    if (cg_str_eq(substr(n.name, di, 1), ":") && cg_str_eq(substr(n.name, di + 1, 1), ":")) {
                        dc_at = di;
                        break;
                    }
                    di = di + 1;
                }
                if (dc_at > 0) {
                    let sc_b <Buffer> = new_buffer(64);
                    sc_b.write_string(substr(n.name, 0, dc_at));
                    sc_b.write_char('_');
                    sc_b.write_string(substr(n.name, dc_at + 2, nm_len - dc_at - 2));
                    let sc_name <string> = sc_b.to_string();
                    free_buffer(sc_b);
                    // A generic static with an inferable prototype argument
                    // instantiates per key (the from_prototype shape); the
                    // call itself stays eager-shaped. Anything exotic stays
                    // on the eager path below.
                    let sc_base <string> = substr(n.name, 0, dc_at);
                    let sc_mshort <string> = substr(n.name, dc_at + 2, nm_len - dc_at - 2);
                    let sc_hit <&FnSymbol> = cg_static_cache_sym(ctx, sc_base, sc_mshort, n);
                    if (ctx.poisoned) { return null; }
                    if (sc_hit != null) {
                        callee = sc_hit.fn_val;
                        callee_fn_ty = sc_hit.fn_ty;
                        is_scope_call = true;
                    }
                    let sc_sym <&FnSymbol> = fn_ctx_find_fn(ctx, sc_name);
                    if (callee == null && sc_sym != null) {
                        // A generic static instantiates on demand like any
                        // generic method; the call itself stays eager-shaped.
                        if (!ensure_template_instantiated(ctx, sc_sym)) { return null; }
                        callee = sc_sym.fn_val;
                        callee_fn_ty = sc_sym.fn_ty;
                        is_scope_call = true;
                    } else if (callee == null) {
                        let sc_fn <&LLVMValue> = llvm_get_named_function(ctx.module, sc_name);
                        if (sc_fn != null) {
                            callee = sc_fn;
                            callee_fn_ty = llvm_global_get_value_type(sc_fn);
                            is_scope_call = true;
                        }
                    }
                }
            }
            // A failed receiver lookup must not clobber a callee the
            // static path already resolved (`S::m(x)` with an ident
            // argument reaches here with n.left set; resolving `S.S::m`
            // to null and storing it drops the real callee). Every other
            // lookup block is callee-guarded; this one joins them.
            if (callee == null && n.left != null) {
                let actual_rec <&AstNode> = n.left.left;
                if (actual_rec == null) { actual_rec = n.left; }
                let rec_st <string> = get_node_struct_name(ctx, actual_rec);
                if (cg_strlen(rec_st) > cast<ulong>(0)) {
                    let b_dot <Buffer> = new_buffer(64);
                    b_dot.write_string(rec_st);
                    b_dot.write_char('.');
                    b_dot.write_string(n.name);
                    let m_dot_name <string> = b_dot.to_string();
                    free_buffer(b_dot);

                    let sym_m <&FnSymbol> = fn_ctx_find_fn(ctx, m_dot_name);
                    if (sym_m != null) {
                        // PT1: refuse an unlowerable generic instantiation
                        // before emitting against the shared erased body.
                        if (!cg_check_generic_call(ctx, sym_m, cg_recv_ident(actual_rec))) { return null; }
                        if (!ensure_template_instantiated(ctx, sym_m)) { return null; }
                        callee = sym_m.fn_val;
                        callee_fn_ty = sym_m.fn_ty;
                    } else {
                        callee = llvm_get_named_function(ctx.module, m_dot_name);
                        if (callee != null) {
                            callee_fn_ty = llvm_global_get_value_type(callee);
                        }
                    }

                    if (callee == null) {
                        let b_under <Buffer> = new_buffer(64);
                        b_under.write_string(rec_st);
                        b_under.write_char('_');
                        b_under.write_string(n.name);
                        let m_under_name <string> = b_under.to_string();
                        free_buffer(b_under);

                        let sym_u <&FnSymbol> = fn_ctx_find_fn(ctx, m_under_name);
                        if (sym_u != null) {
                            // PT1: same gate as the dot path above.
                            if (!cg_check_generic_call(ctx, sym_u, cg_recv_ident(actual_rec))) { return null; }
                            if (!ensure_template_instantiated(ctx, sym_u)) { return null; }
                            callee = sym_u.fn_val;
                            callee_fn_ty = sym_u.fn_ty;
                        } else {
                            callee = llvm_get_named_function(ctx.module, m_under_name);
                            if (callee != null) {
                                callee_fn_ty = llvm_global_get_value_type(callee);
                            }
                        }
                    }
                }
            }

            // A plain call resolves globally here, before the struct sweep:
            // the sweep would otherwise bind a same-named method of an
            // unrelated struct (or refuse a call like cos(angle) whose first
            // argument merely looks like a receiver).
            if (callee == null) {
                let g_sym <&FnSymbol> = fn_ctx_find_fn(ctx, n.name);
                if (g_sym != null) {
                    // FG1: a free generic over structs instantiates only via
                    // the per-call cache above; the erased path must not serve
                    // it (one body cannot serve two spellings). Method
                    // templates (leading `self`) stay on their own path.
                    if (g_sym.tmpl != null && g_sym.fn_val == null) {
                        let tt <&AstNode> = g_sym.tmpl;
                        let is_mtpl <bool> = false;
                        if (tt.extra != null && tt.extra.name != null && cg_str_eq(tt.extra.name, "self")) { is_mtpl = true; }
                        if (!is_mtpl) {
                            cg_dprintf(2, "finc codegen refusal: free generic function '%s' is not lowered yet (needs monomorphization)\n", n.name);
                            refuse_and_poison(ctx);
                            return null;
                        }
                    }
                    // The checker flattens method calls to `Struct_method`,
                    // so a generic method usually arrives here rather than
                    // through the receiver paths above: instantiate it.
                    // PT1: refuse an unlowerable generic instantiation
                    // before emitting against the shared erased body.
                    if (!cg_check_generic_call(ctx, g_sym, cg_recv_ident(n.left))) { return null; }
                    if (!ensure_template_instantiated(ctx, g_sym)) { return null; }
                    callee = g_sym.fn_val;
                    callee_fn_ty = g_sym.fn_ty;
                } else {
                    let g_fn <&LLVMValue> = llvm_get_named_function(ctx.module, n.name);
                    if (g_fn != null) {
                        callee = g_fn;
                        callee_fn_ty = llvm_global_get_value_type(g_fn);
                    }
                }
            }

            if (callee == null) {
                let si <int> = 0;
                while (si < ctx.struct_count) {
                    let st <&StructInfo> = ctx.structs[si];
                    if (st != null) {
                        let b_alt <Buffer> = new_buffer(64);
                        b_alt.write_string(st.name);
                        b_alt.write_char('.');
                        b_alt.write_string(n.name);
                        let m_alt <string> = b_alt.to_string();
                        free_buffer(b_alt);
                        let sym_alt <&FnSymbol> = fn_ctx_find_fn(ctx, m_alt);
                        if (sym_alt != null) {
                            if (!ensure_template_instantiated(ctx, sym_alt)) { return null; }
                            callee = sym_alt.fn_val;
                            callee_fn_ty = sym_alt.fn_ty;
                            break;
                        }
                        let f_alt <&LLVMValue> = llvm_get_named_function(ctx.module, m_alt);
                        if (f_alt != null) {
                            callee = f_alt;
                            callee_fn_ty = llvm_global_get_value_type(f_alt);
                            break;
                        }
                        let b_alt2 <Buffer> = new_buffer(64);
                        b_alt2.write_string(st.name);
                        b_alt2.write_char('_');
                        b_alt2.write_string(n.name);
                        let m_alt2 <string> = b_alt2.to_string();
                        free_buffer(b_alt2);
                        let sym_alt2 <&FnSymbol> = fn_ctx_find_fn(ctx, m_alt2);
                        if (sym_alt2 != null) {
                            if (!ensure_template_instantiated(ctx, sym_alt2)) { return null; }
                            callee = sym_alt2.fn_val;
                            callee_fn_ty = sym_alt2.fn_ty;
                            // A method named for its struct is the constructor:
                            // it needs the allocated object prepended.
                            // PT1 slice 3: the instantiation gate -- a struct
                            // argument compared by the struct's methods must
                            // declare the operator, like the C++ backend.
                            if (cg_str_eq(n.name, st.name)) {
                                is_ctor = true;
                                if (!cg_ctor_gate(ctx, st.name, cg_ctor_ann(n))) { return null; }
                            }
                            break;
                        }
                        let f_alt2 <&LLVMValue> = llvm_get_named_function(ctx.module, m_alt2);
                        if (f_alt2 != null) {
                            callee = f_alt2;
                            callee_fn_ty = llvm_global_get_value_type(f_alt2);
                            if (cg_str_eq(n.name, st.name)) {
                                is_ctor = true;
                                if (!cg_ctor_gate(ctx, st.name, cg_ctor_ann(n))) { return null; }
                            }
                            break;
                        }
                    }
                    si = si + 1;
                }
            }

            if (callee == null) {
                let b_cr <Buffer> = new_buffer(64);
                b_cr.write_string(n.name);
                b_cr.write_char('_');
                b_cr.write_string(n.name);
                let c_under <string> = b_cr.to_string();
                free_buffer(b_cr);

                let c_sym <&FnSymbol> = fn_ctx_find_fn(ctx, c_under);
                if (c_sym != null) {
                    callee = c_sym.fn_val;
                    callee_fn_ty = c_sym.fn_ty;
                    is_ctor = true;
                    if (!cg_ctor_gate(ctx, n.name, cg_ctor_ann(n))) { return null; }
                } else {
                    let c_fn <&LLVMValue> = llvm_get_named_function(ctx.module, c_under);
                    if (c_fn != null) {
                        callee = c_fn;
                        callee_fn_ty = llvm_global_get_value_type(c_fn);
                        is_ctor = true;
                        if (!cg_ctor_gate(ctx, n.name, cg_ctor_ann(n))) { return null; }
                    }
                }
            }

            // A method-style call that resolved to nothing, whose first
            // argument has a static type no lowering knows (a bare generic
            // parameter, an unresolved alias), cannot dispatch: any binding
            // below would be textual accident. Refuse instead of
            // miscompiling. "Self" stays on the legacy path. A call through
            // a local of function type is not a method on its first
            // argument (`f(key)` where `f` is a function value): the C++
            // backend checks the local before any receiver logic, so the
            // refusal yields to the indirect path below.
            if (callee == null && n.left != null) {
                let rk_rec <&AstNode> = n.left.left;
                if (rk_rec == null) { rk_rec = n.left; }
                if (rk_rec != null && rk_rec.kind == ast_ident()) {
                    let rk_st <string> = get_node_struct_name(ctx, rk_rec);
                    if (cg_strlen(rk_st) > cast<ulong>(0) && !cg_str_eq(rk_st, "Self")) {
                        if (find_struct(ctx, rk_st) == null && find_interface(ctx, rk_st) == null && find_enum(ctx, rk_st) == null) {
                            let v_early <&LocalVar> = fn_ctx_find_var(ctx, n.name);
                            if (v_early == null || (v_early.fn_ty == null && !cg_ann_is_fn(v_early.type_annotation))) {
                                cg_dprintf(2, "finc codegen refusal: method call '%s' on receiver of unlowerable generic type '%s' (needs monomorphization)\n", n.name, rk_st);
                                refuse_and_poison(ctx);
                                return null;
                            }
                        }
                    }
                }
            }
            // Indirect call through a variable holding a function. The callee
            // signature comes from the recorded function type (flow in at
            // declaration or assignment), or from the annotation when the
            // value arrived untyped (denullified out of a field); without
            // either there is nothing sound to call through, so refuse
            // rather than emit a null callee.
            if (callee == null) {
                let v_call <&LocalVar> = fn_ctx_find_var(ctx, n.name);
                if (v_call != null && v_call.val != null) {
                    if (v_call.fn_ty == null && cg_ann_is_fn(v_call.type_annotation)) {
                        v_call.fn_ty = cg_fn_type_from_ann(ctx, v_call.type_annotation);
                    }
                    if (v_call.fn_ty != null) {
                        let fp <&LLVMValue> = llvm_build_load2(ctx.builder, v_call.ty, v_call.val, "indirect");
                        if (llvm_type_of(fp) != ctx.ptr_ty) {
                            fp = coerce_val(ctx, fp, ctx.ptr_ty);
                        }
                        callee = fp;
                        callee_fn_ty = v_call.fn_ty;
                    } else {
                        cg_dprintf(2, "finc codegen refusal: indirect call through variable '%s' with unknown function signature\n", n.name);
                        refuse_and_poison(ctx);
                        return null;
                    }
                }
            }
        }
        if (callee == null || callee_fn_ty == null) {
            // No lowering knows this callee — not a method, not a global,
            // not an indirect value. Name it and refuse (backend invariant)
            // instead of dropping it: `@x` is a compile-time call, a bare
            // name is worded the way the C++ backend words it. Callers print
            // their own context only when nothing was said here (poison).
            if (!ctx.poisoned && n.name != null && cg_strlen(n.name) > cast<ulong>(0)) {
                if (cg_str_eq(substr(n.name, 0, 1), "@")) {
                    cg_dprintf(2, "codegen: the compile-time call '%s' is not lowered yet\n", n.name);
                } else {
                    cg_dprintf(2, "codegen: a call to '%s' is not lowered yet\n", n.name);
                }
            }
            refuse_and_poison(ctx);
            return null;
        }

        let args <&LLVMValueArgs> = new LLVMValueArgs{};
        let param_tys <&LLVMTypeArgs> = new LLVMTypeArgs{};
        llvm_get_param_types(callee_fn_ty, param_tys);
        let arg_count <int> = 0;

        // A `Struct::method` static still declares the implicit self first,
        // which the call site never passes. When the written arguments are
        // exactly one short, feed a null self so positions line up. (A static
        // that uses self is really an instance method miscalling; the null
        // faults loudly at runtime instead of shifting every argument.)
        if (is_scope_call && !is_ctor) {
            let acount <int> = 0;
            let aw <&AstNode> = n.left;
            while (aw != null) {
                acount = acount + 1;
                aw = aw.right;
            }
            let pcount <int> = cg_targs_count(param_tys);
            if (acount + 1 == pcount) {
                args.v0 = llvm_const_null(ctx.ptr_ty);
                arg_count = 1;
            }
        }

        if (is_ctor) {
            let calloc_fn <&LLVMValue> = get_or_declare_calloc(ctx);
            let c_fn_ty <&LLVMType> = llvm_global_get_value_type(calloc_fn);
            let c_args <&LLVMValueArgs> = new LLVMValueArgs{};
            c_args.v0 = llvm_const_int(ctx.i64_ty, 1, 0);
            // Same fixed heap-struct buffer as struct_alloc: 1024 fits the
            // largest struct (64 words); raise together, never apart.
            c_args.v1 = llvm_const_int(ctx.i64_ty, 1024, 0);
            ctor_st_ptr = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args, 2, "ctor_obj");
            delete c_args;

            args.v0 = ctor_st_ptr;
            arg_count = 1;
        }

        let cur_wrap <&AstNode> = n.left;
        // A leading receiver that binds to nothing (a module alias: the
        // checker rejects undeclared identifiers, so anything unbound here
        // is not a value) is not an argument. Skip it so `stdio.printf(x)`
        // calls the global printf with (x).
        let skip_first <bool> = false;
        if (cur_wrap != null) {
            let first_arg <&AstNode> = cur_wrap.left;
            if (first_arg == null) { first_arg = cur_wrap; }
            if (first_arg != null && first_arg.kind == ast_ident()) {
                let rn <string> = first_arg.name;
                // Literal nulls/bools are values, never module aliases
                // (lower_expr lowers them to constants under this same
                // ident kind). Skipping one drops a real argument and
                // shifts the rest (e.g. `new_scope(null)` became a 0-arg
                // call: LLVM "Incorrect number of arguments").
                if (!cg_str_eq(rn, "null") && !cg_str_eq(rn, "NULL") && !cg_str_eq(rn, "true") && !cg_str_eq(rn, "false")) {
                    if (fn_ctx_find_var(ctx, rn) == null && find_struct(ctx, rn) == null && find_interface(ctx, rn) == null && find_enum(ctx, rn) == null && fn_ctx_find_fn(ctx, rn) == null && llvm_get_named_function(ctx.module, rn) == null && llvm_get_named_global(ctx.module, rn) == null) {
                        skip_first = true;
                    }
                }
            }
        }
        let is_first_arg <bool> = true;
        while (cur_wrap != null && arg_count < 64) {
            if (is_first_arg && skip_first) {
                is_first_arg = false;
                cur_wrap = cur_wrap.right;
                continue;
            }
            is_first_arg = false;
            let actual_arg <&AstNode> = cur_wrap.left;
            if (actual_arg == null) { actual_arg = cur_wrap; }
            let av <&LLVMValue> = lower_expr(ctx, actual_arg);
            if (av != null) {
                av = fn_value_to_ptr(ctx, actual_arg, av);
                let a_ty <&LLVMType> = llvm_type_of(av);
                let exp_ty <&LLVMType> = cg_targs_at(param_tys, arg_count);

                if (exp_ty != null && exp_ty != a_ty) {
                    // A value for a nullable pair parameter wraps with its
                    // presence; a pair for a plain parameter refuses rather
                    // than passing two words where one goes.
                    if (cg_is_tagged_pair(ctx, exp_ty) && !cg_is_tagged_pair(ctx, a_ty)) {
                        av = cg_wrap_nullable(ctx, av, exp_ty, cg_is_absent_spelling(actual_arg));
                    } else if (cg_is_tagged_pair(ctx, exp_ty) && cg_is_tagged_pair(ctx, a_ty)) {
                        // A pair for a pair parameter converts the payload
                        // and carries the tag (C++ convert()'s nullable arm).
                        av = cg_convert_pair(ctx, av, exp_ty);
                    } else if (!cg_is_tagged_pair(ctx, exp_ty) && cg_is_tagged_pair(ctx, a_ty)) {
                        cg_dprintf(2, "finc codegen refusal: passing a nullable value to '%s' without denullify ('?')\n", n.name);
                        refuse_and_poison(ctx);
                        llvm_build_unreachable(ctx.builder);
                        return null;
                    } else {
                        // The expected fat type identifies the target interface by
                        // identity: conversion builds that interface's vtable, so a
                        // reader with the same static type finds its own slots.
                        let tgt_iface <&InterfaceInfo> = null;
                        let ti <int> = 0;
                        while (ti < ctx.interface_count) {
                            let cand <&InterfaceInfo> = ctx.interfaces[ti];
                            if (cand != null && cand.fat_ptr_ty != null && exp_ty == cand.fat_ptr_ty) {
                                tgt_iface = cand;
                                break;
                            }
                            ti = ti + 1;
                        }
                        if (tgt_iface != null) {
                            let actual_rec_st <string> = get_node_struct_name(ctx, actual_arg);
                            if (cg_strlen(actual_rec_st) == cast<ulong>(0)) {
                                if (actual_arg.kind == ast_ident()) {
                                    let v_arg <&LocalVar> = fn_ctx_find_var(ctx, actual_arg.name);
                                    if (v_arg != null) { actual_rec_st = v_arg.type_annotation; }
                                }
                            }
                            av = struct_to_interface(ctx, av, actual_rec_st, tgt_iface);
                        } else if (exp_ty == ctx.ptr_ty && find_enum_by_llvm_type(ctx, a_ty) != null) {
                            // A concrete enum struct for an erased
                            // (generic-spelling) parameter: generics carry
                            // aggregates by address (struct locals are already
                            // boxes), so box the value struct and pass its
                            // address. Scalars keep the representative-bits path
                            // in coerce_val below.
                            let box <&LLVMValue> = llvm_build_alloca(ctx.builder, a_ty, "enum.box");
                            llvm_build_store(ctx.builder, av, box);
                            av = box;
                        } else {
                            av = coerce_val(ctx, av, exp_ty);
                        }
                    }
                }
                // Beyond the declared parameters (C varargs) a float passes
                // as a double; an 8- or 16-bit integer promotes to int, signed
                // or zero-extended by its spelling (C++ vararg promotion).
                if (exp_ty == null && llvm_type_of(av) == ctx.float_ty) {
                    av = llvm_build_fp_ext(ctx.builder, av, ctx.double_ty, "flt2dbl");
                }
                if (exp_ty == null && llvm_type_of(av) == ctx.i16_ty) {
                    if (cg_value_is_unsigned(ctx, actual_arg)) {
                        av = llvm_build_zext(ctx.builder, av, ctx.i32_ty, "i16arg_z");
                    } else {
                        av = llvm_build_sext(ctx.builder, av, ctx.i32_ty, "i16arg_s");
                    }
                }
                if (exp_ty == null && llvm_type_of(av) == ctx.i8_ty) {
                    if (cg_value_is_unsigned(ctx, actual_arg)) {
                        av = llvm_build_zext(ctx.builder, av, ctx.i32_ty, "i8arg_z");
                    } else {
                        av = llvm_build_sext(ctx.builder, av, ctx.i32_ty, "i8arg_s");
                    }
                }
            } else {
                let exp_ty <&LLVMType> = cg_targs_at(param_tys, arg_count);

                if (cg_is_tagged_pair(ctx, exp_ty)) {
                    av = llvm_const_null(exp_ty);
                } else if (exp_ty == ctx.i64_ty) {
                    av = llvm_const_int(ctx.i64_ty, 0, 0);
                } else if (exp_ty == ctx.i8_ty) {
                    av = llvm_const_int(ctx.i8_ty, 0, 0);
                } else if (exp_ty == ctx.i1_ty) {
                    av = llvm_const_int(ctx.i1_ty, 0, 0);
                } else if (exp_ty == ctx.i32_ty) {
                    av = llvm_const_int(ctx.i32_ty, 0, 0);
                } else {
                    av = llvm_const_null(ctx.ptr_ty);
                }
            }
            cg_vargs_set(args, arg_count, av);
            arg_count = arg_count + 1;
            cur_wrap = cur_wrap.right;
        }
        if (cur_wrap != null) {
            // More arguments than the LLVMValueArgs carrier holds (64):
            // refuse instead of dropping the tail silently.
            cg_dprintf(2, "finc codegen refusal: call to '%s' has more arguments than are lowered (at most 64)\n", n.name);
            refuse_and_poison(ctx);
            llvm_build_unreachable(ctx.builder);
            return null;
        }
        // Omitted trailing arguments fill with absence for nullable
        // parameters (the C++ backend's emitCallArgs rule: a missing
        // `n?: int` arrives as null), mirroring nullifier.fin:39
        // `make_A()`. A missing non-nullable parameter is not fillable and
        // refuses instead of emitting a short call.
        let p_count <int> = cg_targs_span(param_tys);
        while (arg_count < p_count) {
            let miss_ty <&LLVMType> = cg_targs_at(param_tys, arg_count);
            let fill <&LLVMValue> = null;
            if (miss_ty != null && cg_is_tagged_pair(ctx, miss_ty)) {
                fill = llvm_const_null(miss_ty);
            } else if (miss_ty != null && miss_ty == ctx.ptr_ty) {
                fill = llvm_const_null(ctx.ptr_ty);
            } else {
                cg_dprintf(2, "finc codegen refusal: call to '%s' is missing a non-nullable argument\n", n.name);
                refuse_and_poison(ctx);
                llvm_build_unreachable(ctx.builder);
                return null;
            }
            cg_vargs_set(args, arg_count, fill);
            arg_count = arg_count + 1;
        }
        delete param_tys;
        let ret_t <&LLVMType> = llvm_get_return_type(callee_fn_ty);
        let call_res <&LLVMValue> = null;
        if (ret_t == ctx.void_ty) {
            call_res = llvm_build_call2(ctx.builder, callee_fn_ty, callee, args, arg_count, "");
        } else {
            call_res = llvm_build_call2(ctx.builder, callee_fn_ty, callee, args, arg_count, "call");
        }
        delete args;
        if (is_ctor) {
            return ctor_st_ptr;
        }
        // A bool callee can leave undefined high bits in the i1 result
        // (LLVM folds e.g. `icmp eq (urem x, 2), 1` to the low bit, which
        // the C++ backend also emits — it masks every bool call result
        // with `and 1`). Normalize here so all consumers see 0/1. The mask
        // runs at i8: `and i1 ..., true` lowers to a byte-wide `and $ff`
        // (an identity that keeps the garbage), while zext reads bit 0.
        if (ret_t == ctx.i1_ty && call_res != null) {
            let wide <&LLVMValue> = llvm_build_zext(ctx.builder, call_res, ctx.i8_ty, "boolsafe_z");
            let masked <&LLVMValue> = llvm_build_and(ctx.builder, wide, llvm_const_int(ctx.i8_ty, 1, 0), "boolsafe");
            call_res = llvm_build_trunc(ctx.builder, masked, ctx.i1_ty, "boolsafe_t");
        }
        // A call through an erased generic returns the representative
        // width while the call site's spelling may name the
        // instantiation (`Collection<int>` read through an erased `get`
        // returns the pointer-width word): narrow the value to the
        // promised word, so later consumers (notably `==`, which
        // dereferences a pointer beside an int) see the value the
        // checker promised. Only word targets coerce (pointer-ward or
        // fatter shapes keep the value); `auto` keeps it untouched
        // (narrowing it could drop a pointer the program still holds);
        // anything coerce_val does not model also passes through.
        if (call_res != null && ret_t != ctx.void_ty && n.type_annotation != null && cg_strlen(n.type_annotation) > cast<ulong>(0)) {
            let want_ann <string> = cg_trim_spaces(n.type_annotation);
            if (!cg_str_eq(want_ann, "auto")) {
                let want_ty <&LLVMType> = map_type(ctx, want_ann);
                if (want_ty != null && want_ty != ctx.void_ty &&
                  (want_ty == ctx.i32_ty || want_ty == ctx.i64_ty || want_ty == ctx.i8_ty || want_ty == ctx.i1_ty || want_ty == ctx.float_ty || want_ty == ctx.double_ty) &&
                  llvm_type_of(call_res) != want_ty) {
                    call_res = coerce_val(ctx, call_res, want_ty);
                  }
            }
        }
        return call_res;
    }
    if (n.kind == ast_prototype_literal()) {
        // A `struct { ... }` literal marker (the parser tags it `$struct`
        // and stashes its declaration top-level): it lowers as its type id
        // (Stage C tid, one i64 word like `$struct` params carry), never as
        // a construction. `st{}` inside a `$struct`-seeded generic builds
        // from the declaration name at compile time, not from this value.
        // Unresolvable stays a refusal, never a guessed struct.
        if (n.type_annotation != null && cg_str_eq(n.type_annotation, "$struct")) {
            let anon <string> = n.str_val;
            if (anon == null || cg_strlen(anon) == cast<ulong>(0) || find_struct(ctx, anon) == null) {
                cg_dprintf(2, "codegen: a 'struct { ... }' literal value is not lowered yet (at '%s':%d)\n", ctx.src_file, n.line);
                refuse_and_poison(ctx);
                return null;
            }
            let s_tid <int> = cg_struct_tid(ctx, anon);
            if (s_tid < 0) {
                cg_dprintf(2, "codegen: a 'struct { ... }' literal value is not lowered yet (at '%s':%d)\n", ctx.src_file, n.line);
                refuse_and_poison(ctx);
                return null;
            }
            return llvm_const_int(ctx.i64_ty, s_tid, 0);
        }
        // An `interface { ... }` literal marker (same stash): its tid, for
        // the `@implements` chain. Without a stashed name it keeps the old
        // prototype lowering, never a guessed id.
        if (n.type_annotation != null && cg_str_eq(n.type_annotation, "$interface")) {
            if (n.str_val != null && cg_strlen(n.str_val) > cast<ulong>(0)) {
                let iname <string> = n.str_val;
                if (find_interface(ctx, iname) == null) {
                    cg_dprintf(2, "codegen: an 'interface { ... }' literal value is not lowered yet (at '%s':%d)\n", ctx.src_file, n.line);
                    refuse_and_poison(ctx);
                    return null;
                }
                let i_tid <int> = cg_iface_tid(ctx, iname);
                if (i_tid < 0) {
                    cg_dprintf(2, "codegen: an 'interface { ... }' literal value is not lowered yet (at '%s':%d)\n", ctx.src_file, n.line);
                    refuse_and_poison(ctx);
                    return null;
                }
                return llvm_const_int(ctx.i64_ty, i_tid, 0);
            }
        }
        let count <int> = 0;
        let cur <&AstNode> = n.left;
        while (cur != null) {
            count = count + 1;
            cur = cur.extra;
        }
        let alloc_count <int> = count;
        if (alloc_count == 0) { alloc_count = 1; }

        let calloc_fn <&LLVMValue> = get_or_declare_calloc(ctx);
        let c_fn_ty <&LLVMType> = llvm_global_get_value_type(calloc_fn);

        let c_args_k <&LLVMValueArgs> = new LLVMValueArgs{};
        c_args_k.v0 = llvm_const_int(ctx.i64_ty, alloc_count, 0);
        c_args_k.v1 = llvm_const_int(ctx.i64_ty, 8, 0);
        let keys_buf <&LLVMValue> = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args_k, 2, "k_buf");
        delete c_args_k;

        let c_args_v <&LLVMValueArgs> = new LLVMValueArgs{};
        c_args_v.v0 = llvm_const_int(ctx.i64_ty, alloc_count, 0);
        c_args_v.v1 = llvm_const_int(ctx.i64_ty, 8, 0);
        let vals_buf <&LLVMValue> = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args_v, 2, "v_buf");
        delete c_args_v;

        cur = n.left;
        let p_idx <int> = 0;
        while (cur != null) {
            if (cur.left != null) {
                let kv <&LLVMValue> = lower_expr(ctx, cur.left);
                if (kv != null) {
                    let kv_64 <&LLVMValue> = coerce_val(ctx, kv, ctx.i64_ty);
                    let ind <&LLVMIndices> = new LLVMIndices{};
                    ind.i0 = llvm_const_int(ctx.i64_ty, p_idx, 0);
                    let k_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, keys_buf, ind, 1, "k_gep");
                    delete ind;
                    llvm_build_store(ctx.builder, kv_64, k_gep);
                }
            }
            if (cur.right != null) {
                let vv <&LLVMValue> = lower_expr(ctx, cur.right);
                if (vv != null) {
                    let vv_64 <&LLVMValue> = coerce_val(ctx, vv, ctx.i64_ty);
                    let ind_v <&LLVMIndices> = new LLVMIndices{};
                    ind_v.i0 = llvm_const_int(ctx.i64_ty, p_idx, 0);
                    let v_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, vals_buf, ind_v, 1, "v_gep");
                    delete ind_v;
                    llvm_build_store(ctx.builder, vv_64, v_gep);
                }
            }
            p_idx = p_idx + 1;
            cur = cur.extra;
        }

        let c_args_h <&LLVMValueArgs> = new LLVMValueArgs{};
        c_args_h.v0 = llvm_const_int(ctx.i64_ty, 1, 0);
        c_args_h.v1 = llvm_const_int(ctx.i64_ty, 32, 0);
        let proto_hdr <&LLVMValue> = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args_h, 2, "proto_hdr");
        delete c_args_h;

        let ind0 <&LLVMIndices> = new LLVMIndices{};
        ind0.i0 = llvm_const_int(ctx.i64_ty, 0, 0);
        let p_k_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, proto_hdr, ind0, 1, "pk");
        delete ind0;
        llvm_build_store(ctx.builder, keys_buf, p_k_ptr);

        let ind1 <&LLVMIndices> = new LLVMIndices{};
        ind1.i0 = llvm_const_int(ctx.i64_ty, 1, 0);
        let p_len_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, proto_hdr, ind1, 1, "plen");
        delete ind1;
        llvm_build_store(ctx.builder, llvm_const_int(ctx.i64_ty, count, 0), p_len_ptr);

        let ind2 <&LLVMIndices> = new LLVMIndices{};
        ind2.i0 = llvm_const_int(ctx.i64_ty, 2, 0);
        let p_v_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, proto_hdr, ind2, 1, "pv");
        delete ind2;
        llvm_build_store(ctx.builder, vals_buf, p_v_ptr);

        let ind3 <&LLVMIndices> = new LLVMIndices{};
        ind3.i0 = llvm_const_int(ctx.i64_ty, 3, 0);
        let p_vlen_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, proto_hdr, ind3, 1, "pvlen");
        delete ind3;
        llvm_build_store(ctx.builder, llvm_const_int(ctx.i64_ty, count, 0), p_vlen_ptr);

        return proto_hdr;
    }
    // Macro invocations and quote expressions have no LLVM lowering: the
    // expander owns them, and by codegen they must already be gone. Refuse
    // explicitly rather than miscompile (a bare `name` lookup below would
    // bind an unrelated function and print its address as garbage).
    if (n.kind == 31) {
        cg_dprintf(2, "finc codegen refusal: macro invocation '%s' is not lowered (macros must expand before codegen)\n", n.name);
        refuse_and_poison(ctx);
        llvm_build_unreachable(ctx.builder);
        return null;
    }
    if (n.kind == 32) {
        cg_dprintf(2, "finc codegen refusal: quote expression is not lowered (quotes must expand before codegen) at '%s':%d\n", ctx.src_file, n.line);
        refuse_and_poison(ctx);
        llvm_build_unreachable(ctx.builder);
        return null;
    }
    if (n.kind == 29) {
        if (cg_strlen(n.name) > cast<ulong>(0)) {
            let lam_val <&LLVMValue> = llvm_get_named_function(ctx.module, n.name);
            if (lam_val != null) {
                return lam_val;
            }
        }
    }
    if (n.kind == 0) {
        if (n.left != null) {
            return lower_expr(ctx, n.left);
        }
        return llvm_const_int(ctx.i32_ty, 0, 0);
    }
    cg_dprintf(2, "finc codegen refusal: unhandled expression kind %d at '%s':%d\n", n.kind, ctx.src_file, n.line);
    refuse_and_poison(ctx);
    llvm_build_unreachable(ctx.builder);
    return null;
}

pub fun lower_stmt(ctx: &FnContext, stmt: &AstNode) <noret> {
    if (stmt == null) { return; }

    if (stmt.kind == ast_var_decl()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, stmt.name);
        let alloca <&LLVMValue> = null;
        let ty <&LLVMType> = null;
        let ty_ann <string> = stmt.type_annotation;
        // ENGA slice 1: same resolved preference as collect_var_allocas.
        if (stmt.resolved_spelling != null && cg_strlen(stmt.resolved_spelling) > cast<ulong>(0)) {
            ty_ann = stmt.resolved_spelling;
        }
        if (stmt.left != null && stmt.left.kind == ast_prototype_literal()) {
            ty_ann = "prototype";
        }
        let init_fn_ty <&LLVMType> = init_fn_type(ctx, stmt.left);
        // Block-scope shadowing (ADR 0011): an inner `let` for a name bound
        // in an outer scope gets a fresh slot instead of reusing the outer
        // one. The initializer lowers BEFORE the fresh binding is added so
        // it reads the outer scope (`let a = a + 1` sees the outer `a`,
        // matching the C++ backend). Same-scope redeclare keeps the legacy
        // reuse path below.
        let outer_v <&LocalVar> = null;
        let shadow_init <&LLVMValue> = null;
        let have_shadow_init <bool> = false;
        if (v != null && v.scope_depth != ctx.current_scope_depth) {
            outer_v = v;
            if (stmt.left != null) {
                let saved_want0 <string> = ctx.call_want;
                if (stmt.left.kind == ast_call_expr()) {
                    ctx.call_want = ty_ann;
                }
                shadow_init = lower_expr(ctx, stmt.left);
                ctx.call_want = saved_want0;
                have_shadow_init = true;
                if (shadow_init == null) {
                    if (!ctx.poisoned) {
                        cg_dprintf(2, "finc codegen refusal: initializer of '%s' does not lower\n", stmt.name);
                    }
                    refuse_and_poison(ctx);
                }
            }
            v = null;
        }
        if (v != null) {
            alloca = v.val;
            ty = v.ty;
            // Wave-5 slice 1: a redeclaration starts live, like any fresh
            // binding (claimant-gated; fresh bindings default to false).
            if (ctx.has_move_claim) { v.moved = false; }
        } else {
            ty = map_type(ctx, ty_ann);
            if (cg_strlen(ty_ann) > cast<ulong>(0) && cg_str_eq(substr(ty_ann, 0, 1), "[")) {
                ty = ctx.fat_ptr_ty;
            }
            if (init_fn_ty != null) {
                ty = ctx.ptr_ty;
            }
            alloca = llvm_build_alloca(ctx.builder, ty, stmt.name);
            fn_ctx_add_var(ctx, stmt.name, alloca, ty, ty_ann);
            v = fn_ctx_find_var(ctx, stmt.name);
            if (v != null && v.fn_ty == null && init_fn_ty != null) {
                v.fn_ty = init_fn_ty;
            }
        }
        if (v != null) {
            // Wave-5 slice 4: record where this binding lives (scope start
            // plus region) and resolve its `#[slaveof]` tie, if any.
            // Hoisted vars are fixed up here, at their lowering point in
            // source order, so a referent declared before reads resolved.
            v.scope_depth = ctx.current_scope_depth;
            v.tie_region = ctx.region_depth;
            let tie_master_box <[int]> = new [int, 1]{};
            let tie_kind <int> = cg_resolve_slaveof(ctx, stmt.name, stmt.attr_text, ctx.current_scope_depth, tie_master_box);
            let tie_master <int> = tie_master_box[0];
            delete tie_master_box;
            if (tie_kind < 0) { return; }
            v.tie_kind = tie_kind;
            v.tie_master = tie_master;
        }
        if (stmt.left != null) {
            // The `let` target spelling is the expected call-result type
            // (`&Vec2<float>` for `= Vec2::zero()`): the static cache reads
            // it to instantiate Self-returning statics no argument binds.
            // Saved and restored like arr_hint_auto, so nesting is exact.
            // A shadowing initializer already lowered above (against the
            // outer scope) is reused here instead of lowering twice.
            let saved_want <string> = ctx.call_want;
            let init_val <&LLVMValue> = null;
            if (have_shadow_init) {
                init_val = shadow_init;
            } else {
                if (stmt.left.kind == ast_call_expr()) {
                    ctx.call_want = ty_ann;
                }
                init_val = lower_expr(ctx, stmt.left);
            }
            ctx.call_want = saved_want;
            if (init_val == null) {
                // Storing nothing leaves the slot uninitialized and the
                // program prints stack garbage with exit 0. Refuse instead.
                if (!ctx.poisoned) {
                    cg_dprintf(2, "finc codegen refusal: initializer of '%s' does not lower\n", stmt.name);
                }
                refuse_and_poison(ctx);
            } else if (alloca != null) {
                if (ty == ctx.fat_ptr_ty && cg_strlen(ty_ann) > cast<ulong>(0) && cg_str_eq(substr(ty_ann, 0, 1), "[")) {
                    let p0 <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, ctx.fat_ptr_ty, alloca, 0, "slice_buf");
                    let p_cast <&LLVMValue> = coerce_val(ctx, init_val, ctx.ptr_ty);
                    llvm_build_store(ctx.builder, p_cast, p0);
                } else {
                    init_val = cg_value_to_iface_slot(ctx, init_val, ty, stmt.left);
                    let v_ty <&LLVMType> = llvm_type_of(init_val);
                    if (ty != v_ty) {
                        if (cg_is_tagged_pair(ctx, ty) && !cg_is_tagged_pair(ctx, v_ty)) {
                            // Presence comes off the spelling (`null` is
                            // absent, anything else -- including a computed
                            // zero -- is present), never off the value.
                            init_val = cg_wrap_nullable(ctx, init_val, ty, cg_is_absent_spelling(stmt.left));
                        } else if (cg_is_tagged_pair(ctx, ty) && cg_is_tagged_pair(ctx, v_ty)) {
                            init_val = cg_convert_pair(ctx, init_val, ty);
                        } else if (!cg_is_tagged_pair(ctx, ty) && cg_is_tagged_pair(ctx, v_ty)) {
                            cg_dprintf(2, "finc codegen refusal: initializing '%s' with a nullable value without denullify ('?')\n", stmt.name);
                            refuse_and_poison(ctx);
                            llvm_build_unreachable(ctx.builder);
                            return;
                        } else if (ty == ctx.i8_ty && (v_ty == ctx.i32_ty || v_ty == ctx.i64_ty)) {
                            init_val = llvm_build_trunc(ctx.builder, init_val, ctx.i8_ty, "v_tr8");
                        } else if (ty == ctx.i16_ty && (v_ty == ctx.i32_ty || v_ty == ctx.i64_ty)) {
                            init_val = llvm_build_trunc(ctx.builder, init_val, ctx.i16_ty, "v_tr16");
                        } else if (ty == ctx.i1_ty && v_ty != ctx.i1_ty) {
                            init_val = to_condition_i1(ctx, init_val);
                        } else if (ty == ctx.i32_ty && v_ty == ctx.i64_ty) {
                            init_val = llvm_build_trunc(ctx.builder, init_val, ctx.i32_ty, "v_tr32");
                        } else if (ty == ctx.i64_ty && (v_ty == ctx.i32_ty || v_ty == ctx.i8_ty || v_ty == ctx.i16_ty)) {
                            init_val = llvm_build_zext(ctx.builder, init_val, ctx.i64_ty, "v_z64");
                        } else if (ty == ctx.ptr_ty && v_ty != ctx.ptr_ty) {
                            init_val = coerce_val(ctx, init_val, ctx.ptr_ty);
                        } else if (v_ty == ctx.ptr_ty && (ty == ctx.i32_ty || ty == ctx.i64_ty || ty == ctx.i8_ty || ty == ctx.i1_ty)) {
                            // A pointer-valued init into an integer slot must
                            // narrow (ptrtoint+trunc); storing raw overflows
                            // the slot and corrupts the stack.
                            init_val = coerce_val(ctx, init_val, ty);
                        } else if ((ty == ctx.float_ty || ty == ctx.double_ty) && v_ty != ty) {
                            init_val = coerce_val(ctx, init_val, ty);
                        } else if ((v_ty == ctx.float_ty || v_ty == ctx.double_ty) && ty != v_ty) {
                            init_val = coerce_val(ctx, init_val, ty);
                        }
                    }
                    init_val = fn_value_to_ptr(ctx, stmt.left, init_val);
                    llvm_build_store(ctx.builder, init_val, alloca);
                }
            }
            if (v != null) {
                if (stmt.left.kind == ast_call_expr()) {
                    if (cg_str_eq(stmt.left.name, "__fin_alloc_array") && stmt.left.left != null) {
                        v.len_val = lower_expr(ctx, stmt.left.left);
                    } else if (cg_str_eq(stmt.left.name, "__fin_array_literal")) {
                        let c_cnt <int> = 0;
                        let c_arg <&AstNode> = stmt.left.left;
                        while (c_arg != null) {
                            c_cnt = c_cnt + 1;
                            c_arg = c_arg.right;
                        }
                        v.len_val = llvm_const_int(ctx.i32_ty, c_cnt, 0);
                        v.elem_ty = get_index_elem_type(ctx, stmt);
                    }
                } else if (stmt.left.kind == ast_ident()) {
                    let src_v <&LocalVar> = fn_ctx_find_var(ctx, stmt.left.name);
                    // A shadowing self-init (`let a = a`) finds the fresh
                    // binding itself; read the stashed outer instead.
                    if (src_v == v) { src_v = outer_v; }
                    if (src_v != null) {
                        v.len_val = src_v.len_val;
                        v.elem_ty = src_v.elem_ty;
                        v.is_proto_half = src_v.is_proto_half;
                    }
                } else if (is_prototype_half(ctx, stmt.left)) {
                    // `let xs <[T]> = prtp.0/1`: the buffer half keeps the
                    // thin convention (slot 0 already holds it); the count
                    // comes from the header slot beside it, and the binding
                    // is marked so index strides by the i64 words the writer
                    // stored rather than by the static element type.
                    v.is_proto_half = true;
                    let inner_p <&AstNode> = stmt.left.left;
                    if (inner_p != null && inner_p.kind == ast_prototype_literal()) {
                        let hc <int> = 0;
                        let hcur <&AstNode> = inner_p.left;
                        while (hcur != null) {
                            hc = hc + 1;
                            hcur = hcur.extra;
                        }
                        v.len_val = llvm_const_int(ctx.i32_ty, hc, 0);
                    } else if (inner_p != null) {
                        let hdr <&LLVMValue> = lower_expr(ctx, inner_p);
                        if (hdr != null) {
                            let hs <int> = 1;
                            if (cg_str_eq(stmt.left.name, "1")) { hs = 3; }
                            let ind_hc <&LLVMIndices> = new LLVMIndices{};
                            ind_hc.i0 = llvm_const_int(ctx.i64_ty, hs, 0);
                            let hc_ptr <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, hdr, ind_hc, 1, "ph_len_p");
                            delete ind_hc;
                            let hc64 <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.i64_ty, hc_ptr, "ph_len");
                            v.len_val = llvm_build_trunc(ctx.builder, hc64, ctx.i32_ty, "ph_len32");
                        }
                    }
                }
            }
        } else {
            // No initializer: zero the slot rather than leaving whatever the
            // stack held. The C++ backend stores a null for the same reason;
            // an absent nullable and a zero scalar both read back as such.
            if (alloca != null && ty != null) {
                llvm_build_store(ctx.builder, llvm_const_null(ty), alloca);
            }
        }
        if (v != null && v.len_val == null && stmt.type_annotation != null) {
            let ext <int> = get_fixed_array_extent(stmt.type_annotation);
            if (ext >= 0) {
                v.len_val = llvm_const_int(ctx.i32_ty, ext, 0);
            }
        }
        if (v != null && v.len_val != null && alloca != null && stmt.type_annotation != null && cg_strlen(stmt.type_annotation) > cast<ulong>(0) && cg_str_eq(substr(stmt.type_annotation, 0, 1), "[")) {
            let p1 <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, ctx.fat_ptr_ty, alloca, 1, "slice_len");
            let l_cast <&LLVMValue> = coerce_val(ctx, v.len_val, ctx.ptr_ty);
            llvm_build_store(ctx.builder, l_cast, p1);
        }
        return;
    }
    if (stmt.kind == ast_return_stmt()) {
        if (llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) != null) {
            return;
        }
        let fn_ret_ty <&LLVMType> = llvm_get_return_type(llvm_global_get_value_type(ctx.fn_val));
        if (fn_ret_ty == ctx.void_ty) {
            emit_scope_cleanups(ctx, 0);
            llvm_build_ret_void(ctx.builder);
            return;
        }
        if (stmt.left != null) {
            let val <&LLVMValue> = lower_expr(ctx, stmt.left);
            if (val != null) {
                val = fn_value_to_ptr(ctx, stmt.left, val);
                // Returning a struct where an interface is declared converts to
                // the declared interface value, mirroring argument conversion.
                if (ctx.ret_iface != null && ctx.ret_iface.fat_ptr_ty != null && fn_ret_ty == ctx.ret_iface.fat_ptr_ty && llvm_type_of(val) == ctx.ptr_ty) {
                    let rs <string> = get_node_struct_name(ctx, stmt.left);
                    if (cg_strlen(rs) > cast<ulong>(0) && find_struct(ctx, rs) != null) {
                        val = struct_to_interface(ctx, val, rs, ctx.ret_iface);
                    }
                }
                let v_ty <&LLVMType> = llvm_type_of(val);
                if (cg_is_tagged_pair(ctx, fn_ret_ty) && !cg_is_tagged_pair(ctx, v_ty)) {
                    // Presence comes off the spelling, never off the value:
                    // `return null` is the absent pair, anything else present.
                    val = cg_wrap_nullable(ctx, val, fn_ret_ty, cg_is_absent_spelling(stmt.left));
                } else if (cg_is_tagged_pair(ctx, fn_ret_ty) && cg_is_tagged_pair(ctx, v_ty)) {
                    val = cg_convert_pair(ctx, val, fn_ret_ty);
                } else if (!cg_is_tagged_pair(ctx, fn_ret_ty) && cg_is_tagged_pair(ctx, v_ty)) {
                    cg_dprintf(2, "finc codegen refusal: returning a nullable value for a non-nullable return (denullify the value with '?') at '%s':%d\n", ctx.src_file, stmt.line);
                    refuse_and_poison(ctx);
                    llvm_build_unreachable(ctx.builder);
                    return;
                } else if (!cg_is_tagged_pair(ctx, fn_ret_ty) && fn_ret_ty != v_ty && cg_is_null_lit(ctx, val) &&
                  (fn_ret_ty == ctx.i32_ty || fn_ret_ty == ctx.i64_ty || fn_ret_ty == ctx.i8_ty || fn_ret_ty == ctx.i1_ty || fn_ret_ty == ctx.float_ty || fn_ret_ty == ctx.double_ty)) {
                    cg_dprintf(2, "finc codegen refusal: returning 'null' for a non-nullable value return (declare the return nullable or return a value) at '%s':%d\n", ctx.src_file, stmt.line);
                    refuse_and_poison(ctx);
                    llvm_build_unreachable(ctx.builder);
                    return;
                  } else if (fn_ret_ty != v_ty) {
                    if (fn_ret_ty == ctx.i8_ty && (v_ty == ctx.i32_ty || v_ty == ctx.i64_ty)) {
                        val = llvm_build_trunc(ctx.builder, val, ctx.i8_ty, "ret_tr8");
                    } else if (fn_ret_ty == ctx.i16_ty && (v_ty == ctx.i32_ty || v_ty == ctx.i64_ty)) {
                        val = llvm_build_trunc(ctx.builder, val, ctx.i16_ty, "ret_tr16");
                    } else if (fn_ret_ty == ctx.i1_ty && v_ty != ctx.i1_ty) {
                        val = to_condition_i1(ctx, val);
                    } else if (fn_ret_ty == ctx.i32_ty && v_ty == ctx.i64_ty) {
                        val = llvm_build_trunc(ctx.builder, val, ctx.i32_ty, "ret_tr32");
                    } else if (fn_ret_ty == ctx.i64_ty && (v_ty == ctx.i32_ty || v_ty == ctx.i8_ty || v_ty == ctx.i16_ty)) {
                        val = llvm_build_zext(ctx.builder, val, ctx.i64_ty, "ret_z64");
                    } else if (v_ty == ctx.ptr_ty && (fn_ret_ty == ctx.i32_ty || fn_ret_ty == ctx.i64_ty || fn_ret_ty == ctx.i8_ty)) {
                        // A pointer-valued return into an integer slot narrows
                        // (ptrtoint+trunc), mirroring the initializer rule:
                        // a generic-erased call surfaces an int result as a
                        // pointer, and the round trip preserves the value.
                        // bool keeps the condition path above.
                        val = coerce_val(ctx, val, fn_ret_ty);
                    } else if (fn_ret_ty == ctx.ptr_ty && v_ty != ctx.ptr_ty) {
                        val = coerce_val(ctx, val, ctx.ptr_ty);
                    } else if ((fn_ret_ty == ctx.float_ty || fn_ret_ty == ctx.double_ty) && v_ty != fn_ret_ty) {
                        val = coerce_val(ctx, val, fn_ret_ty);
                    } else if ((v_ty == ctx.float_ty || v_ty == ctx.double_ty) && fn_ret_ty != v_ty) {
                        val = coerce_val(ctx, val, fn_ret_ty);
                    }
                  }
                emit_scope_cleanups(ctx, 0);
                llvm_build_ret(ctx.builder, val);
            } else if (!ctx.poisoned) {
                // A null value with no refusal behind it is an ordinary
                // lowering failure (loud downstream); with poison set the
                // tail owns the terminator.
                emit_scope_cleanups(ctx, 0);
                llvm_build_ret_void(ctx.builder);
            }
        } else {
            emit_scope_cleanups(ctx, 0);
            llvm_build_ret_void(ctx.builder);
        }
        return;
    }
    if (stmt.kind == ast_expr_stmt()) {
        lower_expr(ctx, stmt.left);
        return;
    }
    if (stmt.kind == ast_if_stmt()) {
        let cond_raw <&LLVMValue> = lower_expr(ctx, stmt.left);
        let cond_val <&LLVMValue> = to_condition_i1(ctx, cond_raw);
        if (cond_val == null) { return; }
        let then_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "then");
        let else_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "else");
        let merge_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "ifcont");

        llvm_build_cond_br(ctx.builder, cond_val, then_bb, else_bb);

        // Wave-5 slice 1 moved-state join (claimant-gated): each branch is
        // lowered on the entry state, and the merge skips what either arm
        // moved (union, mirroring the C++ backend: a move on one side only
        // is Maybe past the join, and Maybe skips -- including when the
        // moving arm terminates, since the merge state is shared).
        // The buffers are compiler-side scratch: they emit no IR, so the
        // unclaimed path lowers exactly as before.
        let join_n <int> = ctx.var_count;
        if (join_n > 1020) { join_n = 1020; }
        let then_marks <[int]> = new [int, 1024]{};
        let else_marks <[int]> = new [int, 1024]{};
        let entry_marks <[int]> = new [int, 1024]{};
        if (ctx.has_move_claim) {
            cg_moved_snapshot(ctx, entry_marks, join_n);
        }

        llvm_position_builder(ctx.builder, then_bb);
        // Wave-5 slice 4: an arm is its own control-flow region -- a tie
        // declared inside cannot drain at a master's exit outside (the arm
        // may never have run where the master dies).
        let then_region <int> = ctx.region_depth;
        ctx.region_depth = ctx.region_depth + 1;
        lower_stmt(ctx, stmt.right);
        ctx.region_depth = then_region;
        if (llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) == null) {
            llvm_build_br(ctx.builder, merge_bb);
        }
        if (ctx.has_move_claim) {
            cg_moved_snapshot(ctx, then_marks, join_n);
            cg_moved_restore(ctx, entry_marks, join_n);
        }

        llvm_position_builder(ctx.builder, else_bb);
        if (stmt.extra != null) {
            // Wave-5 slice 4: the else arm is its own region, like the
            // then arm above.
            let else_region <int> = ctx.region_depth;
            ctx.region_depth = ctx.region_depth + 1;
            lower_stmt(ctx, stmt.extra);
            ctx.region_depth = else_region;
        }
        if (llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) == null) {
            llvm_build_br(ctx.builder, merge_bb);
        }
        if (ctx.has_move_claim) {
            cg_moved_snapshot(ctx, else_marks, join_n);
            cg_moved_restore(ctx, entry_marks, join_n);
            cg_moved_union_saved(ctx, then_marks, join_n);
            cg_moved_union_saved(ctx, else_marks, join_n);
        }

        llvm_position_builder(ctx.builder, merge_bb);
        return;
    }
    if (stmt.kind == ast_while_stmt()) {
        let cond_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "while_cond");
        let body_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "while_body");
        let exit_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "while_exit");

        let prev_break <&LLVMBasicBlock> = ctx.break_bb;
        let prev_continue <&LLVMBasicBlock> = ctx.continue_bb;
        ctx.break_bb = exit_bb;
        ctx.continue_bb = cond_bb;

        llvm_build_br(ctx.builder, cond_bb);

        llvm_position_builder(ctx.builder, cond_bb);
        let cond_raw <&LLVMValue> = lower_expr(ctx, stmt.left);
        let cond_val <&LLVMValue> = to_condition_i1(ctx, cond_raw);
        if (cond_val != null) {
            llvm_build_cond_br(ctx.builder, cond_val, body_bb, exit_bb);
        } else {
            llvm_build_br(ctx.builder, exit_bb);
        }

        // Wave-5 slice 1: the body may run zero or more times, so its end
        // joins its start (union: a move in the body is Maybe past the
        // loop, and Maybe skips). Compiler-side scratch; no IR.
        let w_n <int> = ctx.var_count;
        if (w_n > 1020) { w_n = 1020; }
        let w_pre <[int]> = new [int, 1024]{};
        if (ctx.has_move_claim) {
            cg_moved_snapshot(ctx, w_pre, w_n);
        }

        llvm_position_builder(ctx.builder, body_bb);
        // Wave-5 slice 4: the loop body is its own control-flow region --
        // a tie declared inside cannot drain past the back-edge (the slot
        // may never have been constructed where the master dies).
        let body_region <int> = ctx.region_depth;
        ctx.region_depth = ctx.region_depth + 1;
        lower_stmt(ctx, stmt.right);
        ctx.region_depth = body_region;
        if (llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) == null) {
            llvm_build_br(ctx.builder, cond_bb);
        }
        if (ctx.has_move_claim) {
            cg_moved_union_saved(ctx, w_pre, w_n);
        }

        ctx.break_bb = prev_break;
        ctx.continue_bb = prev_continue;

        llvm_position_builder(ctx.builder, exit_bb);
        return;
    }
    if (stmt.kind == ast_for_stmt()) {
        // The `for` init lives in the loop's own scope (the C++ backend
        // refuses uses past the loop): bindings it declares pop at loop
        // exit like a block's, so `for (let i ...)` shadows an outer `i`
        // instead of clobbering it.
        let for_start <int> = ctx.var_count;
        let for_prev_scope <int> = ctx.current_scope_depth;
        ctx.current_scope_depth = for_start;
        if (stmt.left != null) {
            lower_stmt(ctx, stmt.left);
        }
        let cond_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "for_cond");
        let body_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "for_body");
        let step_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "for_step");
        let exit_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "for_exit");

        let prev_break <&LLVMBasicBlock> = ctx.break_bb;
        let prev_continue <&LLVMBasicBlock> = ctx.continue_bb;
        ctx.break_bb = exit_bb;
        ctx.continue_bb = step_bb;

        llvm_build_br(ctx.builder, cond_bb);

        llvm_position_builder(ctx.builder, cond_bb);
        if (stmt.right != null) {
            let cond_raw <&LLVMValue> = lower_expr(ctx, stmt.right);
            let cond_val <&LLVMValue> = to_condition_i1(ctx, cond_raw);
            if (cond_val != null) {
                llvm_build_cond_br(ctx.builder, cond_val, body_bb, exit_bb);
            } else {
                llvm_build_br(ctx.builder, body_bb);
            }
        } else {
            llvm_build_br(ctx.builder, body_bb);
        }

        // Wave-5 slice 1: the header (init, condition) runs once; body and
        // step may run zero or more times, so their end joins the header
        // state (union: Maybe past the loop skips). Scratch; no IR.
        let f_n <int> = ctx.var_count;
        if (f_n > 1020) { f_n = 1020; }
        let f_pre <[int]> = new [int, 1024]{};
        if (ctx.has_move_claim) {
            cg_moved_snapshot(ctx, f_pre, f_n);
        }

        llvm_position_builder(ctx.builder, body_bb);
        if (stmt.extra != null && stmt.extra.right != null) {
            // Wave-5 slice 4: the for body is its own region, like a while
            // body (the header init above and the step below hold no
            // declarations and stay in the enclosing region).
            let for_region <int> = ctx.region_depth;
            ctx.region_depth = ctx.region_depth + 1;
            lower_stmt(ctx, stmt.extra.right);
            ctx.region_depth = for_region;
        }
        if (llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) == null) {
            llvm_build_br(ctx.builder, step_bb);
        }

        llvm_position_builder(ctx.builder, step_bb);
        if (stmt.extra != null && stmt.extra.left != null) {
            lower_expr(ctx, stmt.extra.left);
        }
        if (llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) == null) {
            llvm_build_br(ctx.builder, cond_bb);
        }
        if (ctx.has_move_claim) {
            cg_moved_union_saved(ctx, f_pre, f_n);
        }

        ctx.break_bb = prev_break;
        ctx.continue_bb = prev_continue;

        llvm_position_builder(ctx.builder, exit_bb);
        ctx.current_scope_depth = for_prev_scope;
        if (llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) == null) {
            emit_scope_cleanups(ctx, for_start);
        }
        pop_scope_vars(ctx, for_start);
        return;
    }
    if (stmt.kind == ast_break_stmt()) {
        if (ctx.break_bb != null && llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) == null) {
            llvm_build_br(ctx.builder, ctx.break_bb);
        }
        return;
    }
    if (stmt.kind == ast_continue_stmt()) {
        if (ctx.continue_bb != null && llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) == null) {
            llvm_build_br(ctx.builder, ctx.continue_bb);
        }
        return;
    }
    if (stmt.kind == ast_blame_stmt()) {
        if (llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) != null) {
            return;
        }
        let is_unconditional <bool> = false;
        if (stmt.left == null) {
            is_unconditional = true;
        }

        let abort_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "abort");
        if (abort_fn == null) {
            let a_ty <&LLVMType> = llvm_function_type(ctx.void_ty, null, 0, 0);
            abort_fn = llvm_add_function(ctx.module, "abort", a_ty);
        }
        let a_fn_ty <&LLVMType> = llvm_global_get_value_type(abort_fn);

        // `blame m1778;` (enums.fin:41): the unimplemented marker as a blame
        // operand. Mirror the C++ backend: reaching it is a runtime failure,
        // lowered as an unconditional abort on this arm rather than a
        // whole-program refusal. A bare `m1778;` still refuses at its
        // expression site; a message beside the marker aborts carrying that
        // text, rendered through `%s` like any blame message.
        if (stmt.left != null && stmt.left.kind == ast_ident() && cg_str_eq(stmt.left.name, "m1778")) {
            if (!cg_blame_msg_is_default(stmt)) {
                let mval <&LLVMValue> = lower_expr(ctx, stmt.right);
                if (ctx.poisoned) { return; }
                if (mval == null || llvm_type_of(mval) != ctx.ptr_ty) {
                    // The checker holds the message against `string`, so a
                    // non-pointer here is the two passes disagreeing -- and
                    // handing an integer to `%s` would read it as an address.
                    cg_dprintf(2, "codegen: this blame message is not lowered yet (at '%s':%d)\n", ctx.src_file, stmt.line);
                    refuse_and_poison(ctx);
                    return;
                }
                cg_emit_absent_blame_val(ctx, stmt.line, mval);
                llvm_build_call2(ctx.builder, a_fn_ty, abort_fn, null, 0, "");
                llvm_build_unreachable(ctx.builder);
                return;
            }
            cg_emit_absent_blame(ctx, stmt.line, "'m1778' reached");
            llvm_build_call2(ctx.builder, a_fn_ty, abort_fn, null, 0, "");
            llvm_build_unreachable(ctx.builder);
            return;
        }

        // `blame enum_.0` where the payload slot disagrees across members
        // (Result Ok(T) vs Err(E)): C++ erases the slot to `any` and lowers
        // the raise as an unconditional abort. Agreed slots (Color .0) keep
        // the assert path below.
        if (stmt.left != null && stmt.left.kind == ast_member_access() && cg_str_eq(stmt.left.name, "0")) {
            let bann <string> = cg_eq_operand_ann(ctx, stmt.left.left);
            if (cg_ann_names_enum(ctx, bann)) {
                let bt <string> = cg_trim_spaces(cg_strip_markers(cg_trim_spaces(bann)));
                let bl <int> = cast<int>(cg_strlen(bt));
                let bbase <string> = bt;
                let bii <int> = 0;
                while (bii < bl) {
                    if (cg_str_eq(substr(bt, bii, 1), "<")) { bbase = cg_trim_spaces(substr(bt, 0, bii)); break; }
                    bii = bii + 1;
                }
                let einfo <&EnumInfo> = find_enum(ctx, bbase);
                let exact <&EnumInfo> = find_enum(ctx, bt);
                if (exact != null) { einfo = exact; }
                if (einfo != null && einfo.has_payload && einfo.member_count > 1) {
                    let first_seg <string> = "";
                    let have_first <bool> = false;
                    let disagree <bool> = false;
                    let mi2 <int> = 0;
                    while (mi2 < einfo.member_count) {
                        let mm2 <&EnumMemberInfo> = einfo.members[mi2];
                        if (mm2 != null && mm2.has_payload && mm2.payload_type != null) {
                            let pparts <[string]> = new [string, 64]{};
                            let pcn <int> = cg_split_top(mm2.payload_type, pparts, 64);
                            let seg <string> = "";
                            if (pcn > 0) { seg = cg_trim_spaces(pparts[0]); } else { seg = cg_trim_spaces(mm2.payload_type); }
                            delete pparts;
                            if (!have_first) { first_seg = seg; have_first = true; }
                            else if (!cg_str_eq(first_seg, seg)) { disagree = true; break; }
                        }
                        mi2 = mi2 + 1;
                    }
                    if (disagree) {
                        cg_emit_absent_blame(ctx, stmt.line, "blame of an erased payload");
                        llvm_build_call2(ctx.builder, a_fn_ty, abort_fn, null, 0, "");
                        llvm_build_unreachable(ctx.builder);
                        return;
                    }
                }
            }
        }

        if (is_unconditional) {
            let umsg <&LLVMValue> = null;
            if (!cg_blame_msg_is_default(stmt)) {
                umsg = lower_expr(ctx, stmt.right);
            }
            cg_emit_blame_text(ctx, stmt.line, umsg);
            llvm_build_call2(ctx.builder, a_fn_ty, abort_fn, null, 0, "");
            llvm_build_unreachable(ctx.builder);
            return;
        }

        // The raise form (`blame v;` on a struct or array value) is not the
        // assert form: refuse by that name rather than branching on it.
        if (cg_blame_is_raise(ctx, stmt.left)) {
            cg_dprintf(2, "finc codegen refusal: 'blame' raising a value of struct or array type is not lowered yet (at '%s':%d)\n", ctx.src_file, stmt.line);
            refuse_and_poison(ctx);
            return;
        }

        let cond_raw <&LLVMValue> = lower_expr(ctx, stmt.left);
        let cond_val <&LLVMValue> = to_condition_i1(ctx, cond_raw);
        if (cond_val == null) {
            cg_emit_blame_text(ctx, stmt.line, null);
            llvm_build_call2(ctx.builder, a_fn_ty, abort_fn, null, 0, "");
            llvm_build_unreachable(ctx.builder);
            return;
        }

        let ok_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "blame_ok");
        let fail_bb <&LLVMBasicBlock> = llvm_append_basic_block(ctx.fn_val, "blame_fail");

        llvm_build_cond_br(ctx.builder, cond_val, ok_bb, fail_bb);

        // The message lowers inside the failing block: it is an expression,
        // so evaluating it beside the condition would run its side effects
        // on every pass of an assertion that never fires.
        llvm_position_builder(ctx.builder, fail_bb);
        let fail_msg <&LLVMValue> = null;
        if (!cg_blame_msg_is_default(stmt)) {
            fail_msg = lower_expr(ctx, stmt.right);
        }
        cg_emit_blame_text(ctx, stmt.line, fail_msg);
        llvm_build_call2(ctx.builder, a_fn_ty, abort_fn, null, 0, "");
        llvm_build_unreachable(ctx.builder);

        llvm_position_builder(ctx.builder, ok_bb);
        return;
    }
    if (stmt.kind == ast_block()) {
        let start_var <int> = ctx.var_count;
        // Wave-5 slice 4: this block's start is the scope its statements
        // declare into (read by `#[slaveof]` resolution as the current
        // scope). Saved and restored: sibling blocks must not see it.
        let prev_scope <int> = ctx.current_scope_depth;
        ctx.current_scope_depth = start_var;
        let cur <&AstNode> = stmt.left;
        while (cur != null) {
            if (ctx.poisoned || llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) != null) {
                ctx.current_scope_depth = prev_scope;
                pop_scope_vars(ctx, start_var);
                return;
            }
            lower_stmt(ctx, cur.left);
            cur = cur.right;
        }
        ctx.current_scope_depth = prev_scope;
        if (llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) == null) {
            emit_scope_cleanups(ctx, start_var);
        }
        pop_scope_vars(ctx, start_var);
        return;
    }
    if (stmt.kind == ast_fun_decl()) {
        return;
    }
    if (stmt.kind != ast_var_decl() && stmt.kind != ast_return_stmt() &&
      stmt.kind != ast_expr_stmt() && stmt.kind != ast_if_stmt() &&
      stmt.kind != ast_while_stmt() && stmt.kind != ast_for_stmt() &&
      stmt.kind != ast_block() && stmt.kind != ast_break_stmt() &&
      stmt.kind != ast_continue_stmt() && stmt.kind != ast_blame_stmt() &&
      stmt.kind != ast_fun_decl()) {
        cg_dprintf(2, "finc codegen refusal: unhandled statement kind %d at '%s':%d\n", stmt.kind, ctx.src_file, stmt.line);
        llvm_build_unreachable(ctx.builder);
      }
}

// A refusal poisons the function: lowering stops (every loop checks the
// flag) and the tail emits an abort call plus a dead dummy return there,
// where emission is known to land.
fun refuse_and_poison(ctx: &FnContext) <noret> {
    if (ctx == null) { return; }
    ctx.poisoned = true;
}

pub fun lower_block(ctx: &FnContext, block: &AstNode) <noret> {
    if (block == null) { return; }
    let cur <&AstNode> = block.left;
    while (cur != null) {
        if (ctx.poisoned || llvm_get_basic_block_terminator(llvm_get_insert_block(ctx.builder)) != null) {
            return;
        }
        lower_stmt(ctx, cur.left);
        cur = cur.right;
    }
}

// The generic arguments of a receiver spelling (`Box<float>` -> `float`;
// `&Collection<int>` -> `int`; multi-arg kept whole: `string,Data`). ""
// when the spelling is not a generic application (nothing to key on).
fun cg_generic_arg_inner(ann: string) <string> {
    if (ann == null) { return ""; }
    let t <string> = ann;
    let len <int> = cast<int>(cg_strlen(t));
    let i <int> = 0;
    while (i < len && cg_str_eq(substr(t, i, 1), "&")) {
        i = i + 1;
    }
    if (i > 0) { t = substr(t, i, len - i); }
    len = cast<int>(cg_strlen(t));
    if (len > 0 && cg_str_eq(substr(t, len - 1, 1), "*")) {
        t = substr(t, 0, len - 1);
        len = len - 1;
    }
    let open_at <int> = -1;
    let k <int> = 0;
    while (k < len) {
        if (cg_str_eq(substr(t, k, 1), "<")) { open_at = k; break; }
        k = k + 1;
    }
    if (open_at < 0) { return ""; }
    let close_at <int> = -1;
    let j <int> = len - 1;
    while (j > open_at) {
        if (cg_str_eq(substr(t, j, 1), ">")) { close_at = j; break; }
        j = j - 1;
    }
    if (close_at < 0) { return ""; }
    return substr(t, open_at + 1, close_at - open_at - 1);
}

// PT1 slice 1 refusal for one argument segment: it names a struct with no
// declared operator to match (`==` needs `has_eq`; `!=` takes `has_ne` or,
// like the C++ backend's declared-only contract, the `==` it negates).
// Mirrors C++ `an undeclared operator '==' on struct 'Data'` (8311).
fun cg_refuse_struct_eq(ctx: &FnContext, sym_name: string, seg: string, want_ne: bool) <bool> {
    let base <string> = seg;
    let blen <int> = cast<int>(cg_strlen(base));
    let bi <int> = 0;
    while (bi < blen) {
        if (cg_str_eq(substr(base, bi, 1), "<")) {
            base = substr(base, 0, bi);
            break;
        }
        bi = bi + 1;
    }
    if (cg_strlen(base) == cast<ulong>(0)) { return false; }
    let st <&StructInfo> = find_struct(ctx, base);
    if (st == null) { return false; }
    if (!want_ne && st.has_eq) { return false; }
    if (want_ne && (st.has_ne || st.has_eq)) { return false; }
    let op <string> = "==";
    if (want_ne) { op = "!="; }
    cg_dprintf(2, "finc codegen refusal: an undeclared operator '%s' on struct '%s' is not lowered yet (method '%s' needs monomorphization)\n", op, base, sym_name);
    refuse_and_poison(ctx);
    return true;
}

// Walk the top-level argument segments (`string,Data` -> `string`, `Data`;
// nesting respected) and refuse the first naming a struct without the
// operator. A bare parameter (`T`, from inside another generic body) names
// no struct and stays today's lowering.
fun cg_check_generic_eq_args(ctx: &FnContext, sym_name: string, inner: string, want_ne: bool) <bool> {
    let len <int> = cast<int>(cg_strlen(inner));
    let depth <int> = 0;
    let start <int> = 0;
    let i <int> = 0;
    while (i <= len) {
        let ch <string> = "";
        if (i < len) { ch = substr(inner, i, 1); }
        if (i == len || (cg_str_eq(ch, ",") && depth == 0)) {
            if (i > start) {
                if (cg_refuse_struct_eq(ctx, sym_name, substr(inner, start, i - start), want_ne)) { return true; }
            }
            start = i + 1;
        } else if (cg_str_eq(ch, "<")) {
            depth = depth + 1;
        } else if (cg_str_eq(ch, ">")) {
            depth = depth - 1;
        }
        i = i + 1;
    }
    return false;
}

// PT1 slice 2 registry: one erased method body serves the spelling it
// was first instantiated at. A second distinct receiver spelling refuses
// (`not lowered yet`) rather than reusing the first body -- the Box<int>
// + Box<float> `get` shape, which printed `0.000000` for the float.
// Same-spelling reuse (and field-only mixing, which never calls) keeps
// lowering. Known edge: spellings compare textually, so an alias (`Box<A>`
// beside `Box<int>`) can false-positive; keying is on the resolved
// spelling as written at the call, never re-derived.
fun cg_mix_check(ctx: &FnContext, sym_name: string, inner: string) <bool> {
    // Refinement: empty or nested (`<`) spellings cannot prove divergence,
    // so they allow (status quo ante). Only flat-divergent pairs refuse.
    // ENGA slice 1: a bare parameter (`T`, from inside another generic body)
    // names no instantiation and stays today's lowering; without this a
    // library template body (`from_prototype` with `T`) poisons a concrete
    // instantiation (`Collection<A>`) that C++ lowers.
    if (inner == null || cg_strlen(inner) == cast<ulong>(0)) { return true; }
    let trimmed <string> = cg_trim_spaces(inner);
    if (cg_is_generic_ann(ctx, trimmed)) { return true; }
    // Multi-arg inners containing a bare parameter are likewise template
    // bodies, not instantiations.
    let segs <[string]> = new [string, 64]{};
    let sc <int> = cg_split_top(trimmed, segs, 64);
    let si <int> = 0;
    while (si < sc) {
        if (cg_is_generic_ann(ctx, cg_trim_spaces(segs[si]))) { delete segs; return true; }
        si = si + 1;
    }
    delete segs;
    let ilen <int> = cast<int>(cg_strlen(inner));
    let ii <int> = 0;
    while (ii < ilen) {
        if (cg_str_eq(substr(inner, ii, 1), "<")) { return true; }
        ii = ii + 1;
    }
    let b_mix <Buffer> = new_buffer(64);
    b_mix.write_string("mix:");
    b_mix.write_string(sym_name);
    let mix_name <string> = b_mix.to_string();
    free_buffer(b_mix);
    let rec <&FnSymbol> = fn_ctx_find_fn(ctx, mix_name);
    if (rec == null) {
        if (ctx.fn_sym_count < 8180) {
            let e <&FnSymbol> = new FnSymbol{};
            e.name = mix_name;
            e.mix_arg = inner;
            ctx.fn_syms[ctx.fn_sym_count] = e;
            ctx.fn_sym_count = ctx.fn_sym_count + 1;
        }
        return true;
    }
    if (rec.mix_arg == null || cg_strlen(rec.mix_arg) == cast<ulong>(0)) { return true; }
    let rlen <int> = cast<int>(cg_strlen(rec.mix_arg));
    let ri <int> = 0;
    while (ri < rlen) {
        if (cg_str_eq(substr(rec.mix_arg, ri, 1), "<")) { return true; }
        ri = ri + 1;
    }
    if (cg_str_eq(rec.mix_arg, inner)) { return true; }
    cg_dprintf(2, "finc codegen refusal: generic method '%s' instantiated at '%s' after '%s' is not lowered yet (one erased body cannot serve two spellings; needs monomorphization)\n", sym_name, inner, rec.mix_arg);
    refuse_and_poison(ctx);
    return false;
}

// PT1 tripwire gate at generic-method call sites: true when lowering may
// proceed, false after an honest refusal. Slice 1 (this change): a method
// whose body compares a generic-typed value refuses when the receiver
// arguments name a struct without a declared `==`/`!=`. Slice 2 adds the
// mixing registry beside it. Deliberately narrow, and every skip keeps
// today's lowering: non-struct callees (free functions, including free
// generics like `eq<T>`), non-ident receivers, non-generic receivers, and
// `==` over member/index operands (`a.val == b.val`) all pass through;
// those are defined follow-ups, not silent coverage.
fun cg_check_generic_call(ctx: &FnContext, sym: &FnSymbol, recv_name: string) <bool> {
    if (sym == null || ctx == null) { return true; }
    if (recv_name == null || cg_strlen(recv_name) == cast<ulong>(0)) { return true; }
    let sn <string> = sym.name;
    let slen <int> = cast<int>(cg_strlen(sn));
    let cut <int> = -1;
    let ci <int> = 0;
    while (ci < slen) {
        let ch <string> = substr(sn, ci, 1);
        if (cg_str_eq(ch, "_") || cg_str_eq(ch, ".")) { cut = ci; break; }
        ci = ci + 1;
    }
    if (cut <= 0) { return true; }
    if (find_struct(ctx, substr(sn, 0, cut)) == null) { return true; }
    if (sym.tmpl != null) {
        if (!sym.has_gen_eq) { sym.has_gen_eq = cg_fn_uses_generic_eq(sym.tmpl, false); }
        if (!sym.has_gen_ne) { sym.has_gen_ne = cg_fn_uses_generic_eq(sym.tmpl, true); }
    }
    let v <&LocalVar> = fn_ctx_find_var(ctx, recv_name);
    if (v == null || v.type_annotation == null) { return true; }
    let inner <string> = cg_generic_arg_inner(v.type_annotation);
    if (cg_strlen(inner) == cast<ulong>(0)) { return true; }
    if (sym.has_gen_eq) {
        if (cg_check_generic_eq_args(ctx, sn, inner, false)) { return false; }
    }
    if (sym.has_gen_ne) {
        if (cg_check_generic_eq_args(ctx, sn, inner, true)) { return false; }
    }
    // Slice 2: beside the struct check, record the spelling; a second
    // distinct one refuses rather than sharing the first body.
    if (!cg_mix_check(ctx, sn, inner)) { return false; }
    return true;
}

// PT1 slice 3: the constructor-site gate. The lowering-site refusal above
// catches a struct `==` spelled concretely, but a generic struct erases its
// bodies: `Collection<Data>.index_of` lowers once with `item: T`, so no
// lowered node ever names `Data` and the pointer-compare sails through
// (deeptest4.fin built, then segfaulted). The C++ backend refuses at
// instantiation instead (`new Collection::<Data>{}` with no method called
// still refuses), precisely per parameter: `Pair<int, Data>` builds when
// only `T` is compared and refuses when `U` is. This gate is that check for
// the self-host, run where the instantiation spelling is still concrete --
// a constructor call's turbofish -- and transitively through field types
// (`HashMap<string, Data>` compares through `values <&Collection<U>>`).
// Deliberately narrow, and every skip keeps today's lowering:
// constructions that drop their arguments at parse (`new S::<...>{}` and
// `S::<...>{...}` keep only the bare name, so there is nothing to map),
// inferred arguments, free generics like `eq<T>`, and comparisons reached
// only through member/index operands of non-self receivers.

// Split a top-level comma list (`string,Data`, `T,U`) into parts[cap].
// Nesting respected; entries trimmed. Returns the part count.
fun cg_split_top(s: string, parts: [string], cap: int) <int> {
    let count <int> = 0;
    if (s == null || cg_strlen(s) == cast<ulong>(0)) { return 0; }
    let len <int> = cast<int>(cg_strlen(s));
    let depth <int> = 0;
    let start <int> = 0;
    let i <int> = 0;
    while (i <= len) {
        let ch <string> = "";
        if (i < len) { ch = substr(s, i, 1); }
        if (i == len || (cg_str_eq(ch, ",") && depth == 0)) {
            if (i > start && count < cap) {
                parts[count] = cg_trim_spaces(substr(s, start, i - start));
                count = count + 1;
            }
            start = i + 1;
        } else if (cg_str_eq(ch, "<")) {
            depth = depth + 1;
        } else if (cg_str_eq(ch, ">")) {
            depth = depth - 1;
        }
        i = i + 1;
    }
    return count;
}

// Uncapped top-level segment count (overflow probe for the capped
// split above): >64 generic parameters are refused at declaration,
// never truncated into a misresolving instantiation.
fun cg_count_top(s: string) <int> {
    if (s == null || cg_strlen(s) == cast<ulong>(0)) { return 0; }
    let len <int> = cast<int>(cg_strlen(s));
    let depth <int> = 0;
    let start <int> = 0;
    let count <int> = 0;
    let i <int> = 0;
    while (i <= len) {
        let ch <string> = "";
        if (i < len) { ch = substr(s, i, 1); }
        if (i == len || (cg_str_eq(ch, ",") && depth == 0)) {
            if (i > start) { count = count + 1; }
            start = i + 1;
        } else if (cg_str_eq(ch, "<")) {
            depth = depth + 1;
        } else if (cg_str_eq(ch, ">")) {
            depth = depth - 1;
        }
        i = i + 1;
    }
    return count;
}

fun cg_param_index(params: [string], pcount: int, want: string) <int> {
    let i <int> = 0;
    while (i < pcount) {
        if (cg_str_eq(params[i], want)) { return i; }
        i = i + 1;
    }
    return -1;
}

// Whether a character ends an identifier for whole-word substitution. Only
// the spellings types are written in can adjoin a parameter name; anything
// unlisted counts as part of the word and blocks the match, which misses
// rather than mis-substitutes.
fun cg_is_type_delim(ch: string) <bool> {
    if (cg_str_eq(ch, " ") || cg_str_eq(ch, "<") || cg_str_eq(ch, ">") ||
      cg_str_eq(ch, ",") || cg_str_eq(ch, "&") || cg_str_eq(ch, "[") ||
      cg_str_eq(ch, "]") || cg_str_eq(ch, "?") || cg_str_eq(ch, "*") ||
      cg_str_eq(ch, "(") || cg_str_eq(ch, ")") || cg_str_eq(ch, "{") ||
      cg_str_eq(ch, "}") || cg_str_eq(ch, ":") || cg_str_eq(ch, ";") ||
      cg_str_eq(ch, "=") || cg_str_eq(ch, "!") || cg_str_eq(ch, "+") ||
      cg_str_eq(ch, "-") || cg_str_eq(ch, "/") || cg_str_eq(ch, "%") ||
      cg_str_eq(ch, "|") || cg_str_eq(ch, ".") || cg_str_eq(ch, "\"") ||
      cg_str_eq(ch, "'") || cg_str_eq(ch, "$")) {
        return true;
      }
    return false;
}

// Substitute whole-word parameter spellings (`&Collection<U>` with U=Data
// becomes `&Collection<Data>`). Longest match wins so a `T` never fires
// inside a longer parameter. Unmapped parameters stay as written.
fun cg_subst_params(spelling: string, params: [string], args: [string], pcount: int, acount: int) <string> {
    if (spelling == null) { return ""; }
    let len <int> = cast<int>(cg_strlen(spelling));
    if (len == 0 || pcount <= 0) { return spelling; }
    let b <Buffer> = new_buffer(64);
    let i <int> = 0;
    while (i < len) {
        let best <int> = -1;
        let best_len <int> = 0;
        let pi <int> = 0;
        while (pi < pcount) {
            let p <string> = params[pi];
            let plen <int> = cast<int>(cg_strlen(p));
            if (plen > best_len && i + plen <= len && cg_str_eq(substr(spelling, i, plen), p)) {
                let before_ok <bool> = false;
                let after_ok <bool> = false;
                if (i == 0) { before_ok = true; }
                else { before_ok = cg_is_type_delim(substr(spelling, i - 1, 1)); }
                if (i + plen == len) { after_ok = true; }
                else { after_ok = cg_is_type_delim(substr(spelling, i + plen, 1)); }
                if (before_ok && after_ok) {
                    best = pi;
                    best_len = plen;
                }
            }
            pi = pi + 1;
        }
        if (best >= 0 && best < acount) {
            b.write_string(args[best]);
            i = i + best_len;
        } else {
            b.write_string(substr(spelling, i, 1));
            i = i + 1;
        }
    }
    let out <string> = b.to_string();
    free_buffer(b);
    return out;
}

// Collect (name, annotation) pairs for parameters and locals under node.
// Same traversal as cg_collect_generic_names, but keeps every declaration:
// the caller matches against the struct's own parameters, not the
// single-letter checker vocabulary.
fun cg_collect_ann_names(node: &AstNode, names: [string], anns: [string], count: int) <int> {
    if (node == null) { return count; }
    if ((node.kind == ast_param() || node.kind == ast_var_decl()) && node.name != null) {
        if (count < 256) {
            names[count] = node.name;
            if (node.type_annotation != null) { anns[count] = node.type_annotation; }
            else { anns[count] = ""; }
            count = count + 1;
        }
    }
    count = cg_collect_ann_names(node.left, names, anns, count);
    count = cg_collect_ann_names(node.right, names, anns, count);
    count = cg_collect_ann_names(node.extra, names, anns, count);
    return count;
}

// The static spelling behind a method-body operand for the instantiation
// scan: a local's annotation for an ident, the field's annotation for a
// self-rooted member access, the element spelling for an index into one.
// "" when nothing answers; those operands are not parameter comparisons.
fun cg_scan_operand_ann(node: &AstNode, vnames: [string], vanns: [string], vcount: int, fnames: [string], fanns: [string], fcount: int) <string> {
    if (node == null) { return ""; }
    if (node.kind == ast_ident()) {
        if (cg_str_eq(node.name, "self")) { return "&Self"; }
        let i <int> = 0;
        while (i < vcount) {
            if (cg_str_eq(vnames[i], node.name)) { return vanns[i]; }
            i = i + 1;
        }
        return "";
    }
    if (node.kind == ast_member_access()) {
        if (node.left != null && node.left.kind == ast_ident() && cg_str_eq(node.left.name, "self")) {
            let fi <int> = 0;
            while (fi < fcount) {
                if (cg_str_eq(fnames[fi], node.name)) { return fanns[fi]; }
                fi = fi + 1;
            }
        }
        return "";
    }
    if (node.kind == ast_index_expr()) {
        let a <string> = cg_scan_operand_ann(node.left, vnames, vanns, vcount, fnames, fanns, fcount);
        return cg_strip_markers(a);
    }
    return "";
}

// Record which of the struct's parameters this body compares with `==`
// (want_ne false) or `!=` (want_ne true) as a direct operand. A member or
// index operand counts when it resolves to a parameter (`self.b == x`,
// `self._arr[i] == item`); anything unresolvable passes through.
fun cg_scan_eq_use(node: &AstNode, vnames: [string], vanns: [string], vcount: int, fnames: [string], fanns: [string], fcount: int, params: [string], pcount: int, want_ne: bool, out: [string], ocount: int) <int> {
    if (node == null) { return ocount; }
    if (node.kind == ast_binary_expr() && node.name != null) {
        let hit <bool> = false;
        if (!want_ne && cg_str_eq(node.name, "==")) { hit = true; }
        if (want_ne && cg_str_eq(node.name, "!=")) { hit = true; }
        if (hit) {
            let a0 <string> = cg_scan_operand_ann(node.left, vnames, vanns, vcount, fnames, fanns, fcount);
            let a1 <string> = cg_scan_operand_ann(node.right, vnames, vanns, vcount, fnames, fanns, fcount);
            let s0 <string> = cg_strip_markers(cg_trim_spaces(a0));
            let s1 <string> = cg_strip_markers(cg_trim_spaces(a1));
            let pi <int> = 0;
            while (pi < pcount) {
                if ((cg_strlen(s0) > cast<ulong>(0) && cg_str_eq(s0, params[pi])) ||
                  (cg_strlen(s1) > cast<ulong>(0) && cg_str_eq(s1, params[pi]))) {
                    if (ocount < 64 && !cg_name_in_list(out, ocount, params[pi])) {
                        out[ocount] = params[pi];
                        ocount = ocount + 1;
                    }
                  }
                pi = pi + 1;
            }
        }
    }
    ocount = cg_scan_eq_use(node.left, vnames, vanns, vcount, fnames, fanns, fcount, params, pcount, want_ne, out, ocount);
    ocount = cg_scan_eq_use(node.right, vnames, vanns, vcount, fnames, fanns, fcount, params, pcount, want_ne, out, ocount);
    ocount = cg_scan_eq_use(node.extra, vnames, vanns, vcount, fnames, fanns, fcount, params, pcount, want_ne, out, ocount);
    return ocount;
}

// Per-struct instantiation knowledge for the constructor gate, recorded in
// pass 1 where the method ASTs are in hand: the declared parameter order
// plus which parameters a method body compares. All methods count, eager
// and template alike -- the C++ backend refuses at instantiation whether
// the comparison is ever called.
fun cg_record_struct_generics(decl: &AstNode, s_info: &StructInfo) <noret> {
    if (decl == null || s_info == null) { return; }
    if (decl.type_annotation == null || cg_strlen(decl.type_annotation) == cast<ulong>(0)) { return; }
    let pnames <[string]> = new [string, 64]{};
    let pcount <int> = cg_split_top(decl.type_annotation, pnames, 64);
    if (pcount <= 0) { delete pnames; return; }
    let fnames <[string]> = new [string, 64]{};
    let fanns <[string]> = new [string, 64]{};
    let fcount <int> = 0;
    let fc <&StructFieldInfo> = null;
    let fi <int> = 0;
    while (fi < s_info.field_count && fcount < 64) {
        fc = s_info.fields[fi];
        if (fc != null && fc.name != null) {
            fnames[fcount] = fc.name;
            if (fc.type_annotation != null) { fanns[fcount] = fc.type_annotation; }
            else { fanns[fcount] = ""; }
            fcount = fcount + 1;
        }
        fi = fi + 1;
    }
    let eq_out <[string]> = new [string, 64]{};
    let eq_c <int> = 0;
    let ne_out <[string]> = new [string, 64]{};
    let ne_c <int> = 0;
    let m <&AstNode> = decl.extra;
    while (m != null) {
        if (m.kind == ast_fun_decl()) {
            let vnames <[string]> = new [string, 256]{};
            let vanns <[string]> = new [string, 256]{};
            let vcount <int> = cg_collect_ann_names(m, vnames, vanns, 0);
            eq_c = cg_scan_eq_use(m, vnames, vanns, vcount, fnames, fanns, fcount, pnames, pcount, false, eq_out, eq_c);
            ne_c = cg_scan_eq_use(m, vnames, vanns, vcount, fnames, fanns, fcount, pnames, pcount, true, ne_out, ne_c);
            delete vnames;
            delete vanns;
        }
        m = m.right;
    }
    let eqb <Buffer> = new_buffer(32);
    let ei <int> = 0;
    while (ei < eq_c) {
        if (ei > 0) { eqb.write_char(','); }
        eqb.write_string(eq_out[ei]);
        ei = ei + 1;
    }
    let neb <Buffer> = new_buffer(32);
    let ni <int> = 0;
    while (ni < ne_c) {
        if (ni > 0) { neb.write_char(','); }
        neb.write_string(ne_out[ni]);
        ni = ni + 1;
    }
    s_info.gen_params = decl.type_annotation;
    s_info.gen_eq_use = eqb.to_string();
    s_info.gen_ne_use = neb.to_string();
    free_buffer(eqb);
    free_buffer(neb);
    delete pnames;
    delete fnames;
    delete fanns;
    delete eq_out;
    delete ne_out;
}

// One argument segment against the operator contract: a struct with no
// declared operator to match refuses naming the segment as written.
fun cg_inst_check_seg(ctx: &FnContext, seg: string, want_ne: bool, origin: string) <bool> {
    let s <string> = cg_trim_spaces(seg);
    if (cg_strlen(s) == cast<ulong>(0)) { return true; }
    let base <string> = s;
    let len <int> = cast<int>(cg_strlen(s));
    let bi <int> = 0;
    while (bi < len) {
        if (cg_str_eq(substr(s, bi, 1), "<")) {
            base = substr(s, 0, bi);
            break;
        }
        bi = bi + 1;
    }
    base = cg_trim_spaces(base);
    if (cg_strlen(base) == cast<ulong>(0)) { return true; }
    let st <&StructInfo> = find_struct(ctx, base);
    if (st == null) { return true; }
    if (!want_ne && st.has_eq) { return true; }
    if (want_ne && (st.has_ne || st.has_eq)) { return true; }
    let op <string> = "==";
    if (want_ne) { op = "!="; }
    cg_dprintf(2, "finc codegen refusal: an undeclared operator '%s' on struct '%s' is not lowered (instantiating '%s' compares it; ADR 0036: equality is declared, not synthesized)\n", op, s, origin);
    refuse_and_poison(ctx);
    return false;
}

// The constructor-site gate: true when lowering may proceed, false after an
// honest refusal. Compared parameters map positionally onto the arguments;
// field types instantiate transitively (a field spelling that changes under
// substitution re-enters this gate). Depth-capped: a parameter cycle that
// never names a comparable struct stops rather than recursing forever.
fun cg_inst_check(ctx: &FnContext, struct_name: string, args_inner: string, origin: string, depth: int) <bool> {
    if (depth > 8) { return true; }
    let st <&StructInfo> = find_struct(ctx, struct_name);
    if (st == null) { return true; }
    if (st.gen_params == null || cg_strlen(st.gen_params) == cast<ulong>(0)) { return true; }
    let params <[string]> = new [string, 64]{};
    let pcount <int> = cg_split_top(st.gen_params, params, 64);
    let args <[string]> = new [string, 64]{};
    let acount <int> = cg_split_top(args_inner, args, 64);
    if (pcount != acount) {
        // A generic count mismatch is a user error (the C++ frontend
        // refuses it identically): proceeding maps positionally and
        // misresolves the tail, segfaulting the read.
        cg_dprintf(2, "finc codegen refusal: generic count mismatch instantiating '%s' (declared %d parameters, got %d arguments)\n", origin, pcount, acount);
        delete params;
        delete args;
        refuse_and_poison(ctx);
        return false;
    }
    let ok <bool> = true;
    if (pcount > 0 && acount > 0) {
        let eqs <[string]> = new [string, 64]{};
        let eqc <int> = cg_split_top(st.gen_eq_use, eqs, 64);
        let ei <int> = 0;
        while (ei < eqc) {
            let pi <int> = cg_param_index(params, pcount, eqs[ei]);
            if (pi >= 0 && pi < acount) {
                if (!cg_inst_check_seg(ctx, args[pi], false, origin)) { ok = false; break; }
            }
            ei = ei + 1;
        }
        delete eqs;
        if (ok) {
            let nes <[string]> = new [string, 64]{};
            let nec <int> = cg_split_top(st.gen_ne_use, nes, 64);
            let ni <int> = 0;
            while (ni < nec) {
                let pj <int> = cg_param_index(params, pcount, nes[ni]);
                if (pj >= 0 && pj < acount) {
                    if (!cg_inst_check_seg(ctx, args[pj], true, origin)) { ok = false; break; }
                }
                ni = ni + 1;
            }
            delete nes;
        }
        if (ok) {
            let fi <int> = 0;
            while (fi < st.field_count) {
                let fld <&StructFieldInfo> = st.fields[fi];
                if (fld != null && fld.type_annotation != null) {
                    let sub <string> = cg_subst_params(fld.type_annotation, params, args, pcount, acount);
                    if (!cg_str_eq(sub, fld.type_annotation)) {
                        let slen <int> = cast<int>(cg_strlen(sub));
                        let open_at <int> = -1;
                        let si <int> = 0;
                        while (si < slen) {
                            if (cg_str_eq(substr(sub, si, 1), "<")) { open_at = si; break; }
                            si = si + 1;
                        }
                        if (open_at > 0) {
                            let fbase <string> = cg_trim_spaces(substr(sub, 0, open_at));
                            // A field spelling carries its markers
                            // (`&Collection<U>`): the struct lookup wants the
                            // bare base, like cg_generic_arg_inner.
                            let fblen <int> = cast<int>(cg_strlen(fbase));
                            while (fblen > 1 && (cg_str_eq(substr(fbase, 0, 1), "&") || cg_str_eq(substr(fbase, 0, 1), "*"))) {
                                fbase = substr(fbase, 1, fblen - 1);
                                fblen = cast<int>(cg_strlen(fbase));
                            }
                            while (fblen > 1 && cg_str_eq(substr(fbase, fblen - 1, 1), "*")) {
                                fbase = substr(fbase, 0, fblen - 1);
                                fblen = cast<int>(cg_strlen(fbase));
                            }
                            if (find_struct(ctx, fbase) != null) {
                                let close_at <int> = -1;
                                let sj <int> = slen - 1;
                                while (sj > open_at) {
                                    if (cg_str_eq(substr(sub, sj, 1), ">")) { close_at = sj; break; }
                                    sj = sj - 1;
                                }
                                if (close_at > open_at) {
                                    let finner <string> = substr(sub, open_at + 1, close_at - open_at - 1);
                                    // The refusal names the use-site
                                    // instantiation (`HashMap<string, Data>`),
                                    // not the transitive field spelling it
                                    // was reached through: the programmer
                                    // wrote the outer arguments.
                                    if (!cg_inst_check(ctx, fbase, finner, origin, depth + 1)) { ok = false; break; }
                                }
                            }
                        }
                    }
                }
                fi = fi + 1;
            }
        }
    }
    delete params;
    delete args;
    return ok;
}

// Entry point for constructor call sites: the annotation carries the
// turbofish (`string,Data`) or a full spelling (`HashMap<string, Data>`);
// anything else has no mappable arguments and keeps today's lowering.
fun cg_ctor_gate(ctx: &FnContext, struct_name: string, ann: string) <bool> {
    if (ann == null || cg_strlen(ann) == cast<ulong>(0)) { return true; }
    let len <int> = cast<int>(cg_strlen(ann));
    let open_at <int> = -1;
    let i <int> = 0;
    while (i < len) {
        if (cg_str_eq(substr(ann, i, 1), "<")) { open_at = i; break; }
        i = i + 1;
    }
    if (open_at < 0) {
        let ob0 <Buffer> = new_buffer(64);
        ob0.write_string(struct_name);
        ob0.write_char('<');
        ob0.write_string(ann);
        ob0.write_char('>');
        let origin0 <string> = ob0.to_string();
        free_buffer(ob0);
        return cg_inst_check(ctx, struct_name, ann, origin0, 0);
    }
    let close_at <int> = -1;
    let j <int> = len - 1;
    while (j > open_at) {
        if (cg_str_eq(substr(ann, j, 1), ">")) { close_at = j; break; }
        j = j - 1;
    }
    if (close_at < 0) { return true; }
    let inner <string> = substr(ann, open_at + 1, close_at - open_at - 1);
    let ob <Buffer> = new_buffer(64);
    ob.write_string(struct_name);
    ob.write_char('<');
    ob.write_string(inner);
    ob.write_char('>');
    let origin <string> = ob.to_string();
    free_buffer(ob);
    return cg_inst_check(ctx, struct_name, inner, origin, 0);
}

// Instantiate a lazy generic-method template on demand: declare its
// prototype now (so the call site can emit against it) and leave the body
// for the drain after pass 2 -- the C++ backend's declareFunction plus
// pendingBodies_ queue, in one helper. Idempotent: a second call finds the
// prototype and only marks. A template with no body is refused where it is
// called, never linked as an undefined symbol.
fun ensure_template_instantiated(ctx: &FnContext, sym: &FnSymbol) <bool> {
    if (sym == null) { return false; }
    // Ordinary symbols pass through: the caller's fallback lookups own a
    // null prototype, not this helper.
    if (sym.tmpl == null) { return true; }
    if (sym.fn_val != null) { return true; }
    let t <&AstNode> = sym.tmpl;
    if (t == null || t.left == null) {
        cg_dprintf(2, "finc codegen refusal: generic method '%s' has no body to instantiate\n", sym.name);
        refuse_and_poison(ctx);
        return false;
    }
    ctx.fn_sym_count = declare_function(ctx.module, t, ctx.fn_syms, ctx.fn_sym_count, ctx.interfaces, ctx.interface_count);
    let df <&LLVMValue> = llvm_get_named_function(ctx.module, t.name);
    if (df == null) {
        refuse_and_poison(ctx);
        return false;
    }
    sym.fn_val = df;
    sym.fn_ty = llvm_global_get_value_type(df);
    return true;
}

// The symbol count drifts whenever a body being lowered instantiates a
// template (declare_function appends to the shared array through a copied
// count). The array stays densely packed, so re-reading the leading run
// resynchronises. Call after every lowering step that may have declared.
fun recount_fn_syms(fn_syms: [&FnSymbol], sym_count: int) <int> {
    let n <int> = sym_count;
    while (n < 8192 && fn_syms[n] != null) {
        n = n + 1;
    }
    return n;
}

// MC1 (b): instantiation-keyed method cache. Tripwire (c) turned the
// Box<int>+Box<float> `get` and generic `set<U>` silent miscompiles into
// honest refusals (one erased body cannot serve two spellings); this cache
// declares and drains one body per (receiver, method, method-args) key with
// the receiver arguments substituted, mirroring C++ instantiateGenericMethod
// (per-instantiation declare + pendingBodies drain, keyed by
// methodKey+mangledName). Struct-== shapes still refuse first (ADR 0036);
// exotic spellings return null and stay on the old path, which refuses
// exactly as before.

// The method short name behind a callee spelling (`Box_get` -> `get`,
// `Box.get` -> `get`); anything else is already short.
fun cg_cache_short(n_name: string, base: string) <string> {
    if (n_name == null || base == null) { return ""; }
    let nlen <int> = cast<int>(cg_strlen(n_name));
    let blen <int> = cast<int>(cg_strlen(base));
    if (blen > 0 && nlen > blen + 1) {
        if (cg_str_eq(substr(n_name, 0, blen), base)) {
            let sep <string> = substr(n_name, blen, 1);
            if (cg_str_eq(sep, "_") || cg_str_eq(sep, ".")) {
                return substr(n_name, blen + 1, nlen - blen - 1);
            }
        }
    }
    return n_name;
}

fun cg_is_prim_spelling(s: string) <bool> {
    if (cg_str_eq(s, "int") || cg_str_eq(s, "uint") || cg_str_eq(s, "bool") ||
      cg_str_eq(s, "char") || cg_str_eq(s, "u8") || cg_str_eq(s, "i8") ||
      cg_str_eq(s, "string") || cg_str_eq(s, "float") || cg_str_eq(s, "f32") ||
      cg_str_eq(s, "double") || cg_str_eq(s, "f64") || cg_str_eq(s, "long") ||
      cg_str_eq(s, "ulong") || cg_str_eq(s, "i64") || cg_str_eq(s, "u64") ||
      cg_str_eq(s, "size_t") || cg_str_eq(s, "usize") || cg_str_eq(s, "isize") ||
      cg_str_eq(s, "uint64") || cg_str_eq(s, "int64")) {
        return true;
      }
    return false;
}

// Whether one receiver-argument segment is modellable: a primitive or a
// nominal type. Nested applications, bare parameters, and unknown words are
// exotic and stay on the old path.
fun cg_modellable_seg(ctx: &FnContext, seg: string) <bool> {
    let s <string> = cg_trim_spaces(seg);
    if (cg_strlen(s) == cast<ulong>(0)) { return false; }
    let changed <bool> = true;
    while (changed) {
        changed = false;
        let len <int> = cast<int>(cg_strlen(s));
        if (len > 1 && cg_str_eq(substr(s, 0, 1), "&")) {
            s = substr(s, 1, len - 1);
            changed = true;
        } else {
            len = cast<int>(cg_strlen(s));
            if (len > 1 && (cg_str_eq(substr(s, len - 1, 1), "*") || cg_str_eq(substr(s, len - 1, 1), "?"))) {
                s = substr(s, 0, len - 1);
                changed = true;
            }
        }
    }
    if (cg_strlen(s) == cast<ulong>(0)) { return false; }
    let slen <int> = cast<int>(cg_strlen(s));
    let si <int> = 0;
    while (si < slen) {
        let ch <string> = substr(s, si, 1);
        if (cg_str_eq(ch, "<") || cg_str_eq(ch, ">") || cg_str_eq(ch, "[") || cg_str_eq(ch, "]")) { return false; }
        si = si + 1;
    }
    if (cg_is_generic_ann(ctx, s)) { return false; }
    if (cg_is_prim_spelling(s)) { return true; }
    if (find_struct(ctx, s) != null) { return true; }
    if (find_interface(ctx, s) != null) { return true; }
    if (find_enum(ctx, s) != null) { return true; }
    return false;
}

fun collect_var_allocas(ctx: &FnContext, node: &AstNode) <noret> {
    if (node == null) { return; }
    if (ctx.poisoned) { return; }
    if (node.kind == ast_var_decl()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, node.name);
        if (v == null) {
            let ty_ann <string> = node.type_annotation;
            // ENGA slice 1: prefer the checker's resolved spelling for the
            // slot type (`Collection<A>` with `type A = int` allocates as
            // `Collection<int>`), mirroring C++ per-mangled-name instances.
            // Diagnostics already ran; this only chooses the layout.
            if (node.resolved_spelling != null && cg_strlen(node.resolved_spelling) > cast<ulong>(0)) {
                ty_ann = node.resolved_spelling;
            }
            if (node.left != null && node.left.kind == ast_prototype_literal()) {
                ty_ann = "prototype";
            }
            let ty <&LLVMType> = map_type(ctx, ty_ann);
            if (cg_strlen(ty_ann) > cast<ulong>(0) && cg_str_eq(substr(ty_ann, 0, 1), "[")) {
                ty = ctx.fat_ptr_ty;
            }
            // A function value is not first-class in LLVM: it lives in a ptr
            // slot even when the annotation maps elsewhere (e.g. auto -> i32).
            let pre_fn_ty <&LLVMType> = init_fn_type(ctx, node.left);
            if (pre_fn_ty != null) {
                ty = ctx.ptr_ty;
            }
            let alloca <&LLVMValue> = llvm_build_alloca(ctx.builder, ty, node.name);
            fn_ctx_add_var(ctx, node.name, alloca, ty, ty_ann);
            if (pre_fn_ty != null) {
                let nv <&LocalVar> = fn_ctx_find_var(ctx, node.name);
                if (nv != null) {
                    nv.fn_ty = pre_fn_ty;
                }
            }
        }
    }
    collect_var_allocas(ctx, node.left);
    collect_var_allocas(ctx, node.right);
    collect_var_allocas(ctx, node.extra);
}

pub fun lower_fun_decl(
  module: &LLVMModule,
  builder: &LLVMBuilder,
  fn_node: &AstNode,
  fn_syms: [&FnSymbol],
  fn_sym_count: int,
  structs: [&StructInfo],
  struct_count: int,
  enums: [&EnumInfo],
  enum_count: int,
  interfaces: [&InterfaceInfo],
  interface_count: int,
  move_claim: bool,
  src_file: string
) <bool> {
    if (fn_node == null || fn_node.left == null) { return false; }

    let fn_name <string> = fn_node.name;
    let is_extern <bool> = (fn_node.left == null);
    let llvm_sym <string> = fn_name;
    if (is_extern && fn_node.attr_text != null && cg_strlen(fn_node.attr_text) > 0) {
        llvm_sym = cg_extern_sym(fn_name, fn_node.attr_text);
    }

    let fn_val <&LLVMValue> = llvm_get_named_function(module, llvm_sym);
    // `main` validation owns its refusals here (declare left bad shapes
    // undeclared): named diagnostics, never guessed IR.
    if (cg_str_eq(fn_name, "main")) {
        let ret_ok_main <bool> = false;
        if (cg_str_eq(fn_node.type_annotation, "void") || cg_str_eq(fn_node.type_annotation, "noret") ||
          cg_str_eq(fn_node.type_annotation, "int") || cg_str_eq(fn_node.type_annotation, "uint")) {
            ret_ok_main = true;
          }
        if (!ret_ok_main) {
            cg_dprintf(2, "finc codegen refusal: a 'main' returning '%s' is not lowered (only void, noret, int, uint lower)\n", fn_node.type_annotation);
            return true;
        }
        let mc <int> = 0;
        let mcur <&AstNode> = fn_node.extra;
        let m_has_vararg <bool> = false;
        while (mcur != null) {
            if (cg_str_eq(mcur.name, "...") || cg_str_eq(mcur.type_annotation, "...")) {
                m_has_vararg = true;
                break;
            }
            mc = mc + 1;
            mcur = mcur.right;
        }
        if (m_has_vararg || mc > 1) {
            cg_dprintf(2, "finc codegen refusal: a 'main' with parameters (only 'main()' and 'main(args: [string])' are lowered) is not lowered\n");
            return true;
        }
        if (mc == 1) {
            let mp <&AstNode> = fn_node.extra;
            if (!cg_str_eq(mp.type_annotation, "[string]")) {
                cg_dprintf(2, "finc codegen refusal: a 'main' parameter '%s' (only '[string]' is lowered) is not lowered\n", mp.name);
                return true;
            }
            if (fn_val == null) {
                cg_dprintf(2, "finc codegen refusal: a 'main' with parameters (only 'main()' and 'main(args: [string])' are lowered) is not lowered\n");
                return true;
            }
        }
    }
    // More parameters than the LLVMTypeArgs carrier holds (64): refuse with a
    // named diagnostic instead of lowering a truncated signature (declare
    // leaves such functions undeclared, so without this the body would read
    // past the declared parameters).
    let pc <int> = 0;
    let pcur0 <&AstNode> = fn_node.extra;
    while (pcur0 != null) {
        if (!cg_str_eq(pcur0.name, "...") && !cg_str_eq(pcur0.type_annotation, "...")) {
            pc = pc + 1;
        }
        pcur0 = pcur0.right;
    }
    if (pc > 64) {
        cg_dprintf(2, "finc codegen refusal: function '%s' has more parameters than are lowered (at most 64)\n", fn_name);
        return true;
    }
    if (fn_val == null) { return false; }

    let i32_t <&LLVMType> = llvm_i32_type();
    let i64_t <&LLVMType> = llvm_i64_type();
    let i1_t <&LLVMType> = llvm_i1_type();
    let i8_t <&LLVMType> = llvm_i8_type();
    let void_t <&LLVMType> = llvm_void_type();
    let ptr_t <&LLVMType> = llvm_pointer_type(llvm_i8_type(), 0);

    let entry_bb <&LLVMBasicBlock> = llvm_append_basic_block(fn_val, "entry");
    llvm_position_builder(builder, entry_bb);

    let ctx <&FnContext> = new FnContext{};
    ctx.vars = new [&LocalVar, 1024]{};
    ctx.var_count = 0;
    ctx.fn_syms = fn_syms;
    ctx.fn_sym_count = fn_sym_count;
    ctx.fn_val = fn_val;
    ctx.builder = builder;
    ctx.module = module;
    ctx.i32_ty = i32_t;
    ctx.i64_ty = i64_t;
    ctx.i1_ty = i1_t;
    ctx.i8_ty = i8_t;
    ctx.i16_ty = llvm_i16_type();
    ctx.float_ty = llvm_float_type();
    ctx.double_ty = llvm_double_type();
    ctx.ptr_ty = ptr_t;
    ctx.void_ty = void_t;
    ctx.break_bb = null;
    ctx.continue_bb = null;
    ctx.structs = structs;
    ctx.struct_count = struct_count;
    ctx.enums = enums;
    ctx.enum_count = enum_count;
    ctx.interfaces = interfaces;
    ctx.interface_count = interface_count;
    // Wave-5 slice 1: program-wide `move_or_copy` claimant gate, threaded
    // from generate_llvm_code's single scan.
    ctx.has_move_claim = move_claim;
    // The invoked input path, for blame and denullify reports.
    ctx.src_file = src_file;
    // Wave-5 slice 4: the deferred-destruction list (compiler-side
    // scratch; emits no IR).
    ctx.tied_idx = new [int, 1024]{};
    ctx.tied_moved = new [int, 1024]{};
    ctx.tied_count = 0;
    ctx.ret_iface = find_interface(ctx, fn_node.type_annotation);
    // Declared generics for this body (triage #6b): the function's own
    // `<...>` text, or "" when str_val carries an attribute/operator
    // payload. Struct/enum parameters ride on ctx.structs/enums instead.
    ctx.cur_gen = "";
    if (fn_node.str_val != null && cg_strlen(fn_node.str_val) > cast<ulong>(0)) {
        if (!cg_str_contains(fn_node.str_val, "=") && !cg_str_contains(fn_node.str_val, "\"")) {
            if (fn_node.name == null || !cg_str_contains(fn_node.name, "operator")) {
                ctx.cur_gen = fn_node.str_val;
            }
        }
    }

    let fat_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
    fat_args.t0 = ptr_t;
    fat_args.t1 = ptr_t;
    ctx.fat_ptr_ty = llvm_struct_type(fat_args, 2, 0);
    delete fat_args;

    let p_idx <int> = 0;
    let p_cur <&AstNode> = fn_node.extra;
    // `main(args: [string])` bridges C argv rather than copying it:
    // `{argv+1, argc-1}` with a null for the empty case, so there is no
    // allocation to free and no loop to miscompile. The slot stays the
    // Fin mirror's `ptr + len_val` convention, so `args[i]` and
    // `args.length` read what `run_finc(args, count)` already expects.
    let is_main_args <bool> = false;
    if (cg_str_eq(fn_name, "main") && p_cur != null && p_cur.right == null && cg_str_eq(p_cur.type_annotation, "[string]")) {
        is_main_args = true;
    }
    if (is_main_args) {
        let p_arg <&AstNode> = fn_node.extra;
        let argc_v <&LLVMValue> = llvm_get_param(fn_val, 0);
        let argv_v <&LLVMValue> = llvm_get_param(fn_val, 1);
        let one_v <&LLVMValue> = llvm_const_int(i32_t, 1, 0);
        let zero_v <&LLVMValue> = llvm_const_int(i32_t, 0, 0);
        let raw_v <&LLVMValue> = llvm_build_sub(builder, argc_v, one_v, "argv.count.raw");
        let is_neg_v <&LLVMValue> = llvm_build_icmp(builder, llvm_int_slt(), raw_v, zero_v, "argv.count.neg");
        let count_v <&LLVMValue> = llvm_build_select(builder, is_neg_v, zero_v, raw_v, "argv.count");
        let ind_args <&LLVMIndices> = new LLVMIndices{};
        ind_args.i0 = llvm_const_int(i64_t, 1, 0);
        let argv_plus_one <&LLVMValue> = llvm_build_gep2(builder, ptr_t, argv_v, ind_args, 1, "argv.plus.one");
        delete ind_args;
        let is_zero_v <&LLVMValue> = llvm_build_icmp(builder, llvm_int_eq(), count_v, zero_v, "argv.count.zero");
        let null_ptr_v <&LLVMValue> = llvm_const_null(ptr_t);
        let buf_v <&LLVMValue> = llvm_build_select(builder, is_zero_v, null_ptr_v, argv_plus_one, "argv.buf");
        let alloca_v <&LLVMValue> = llvm_build_alloca(builder, ptr_t, p_arg.name);
        llvm_build_store(builder, buf_v, alloca_v);
        fn_ctx_add_var(ctx, p_arg.name, alloca_v, ptr_t, "[string]");
        let pv_main <&LocalVar> = fn_ctx_find_var(ctx, p_arg.name);
        if (pv_main != null) {
            pv_main.len_val = count_v;
            pv_main.elem_ty = ptr_t;
        }
    } else {
        while (p_cur != null) {
            let p_val <&LLVMValue> = llvm_get_param(fn_val, p_idx);
            if (p_val == null) {
                // Unreachable when the declaration above agrees with the carrier
                // (over-cap functions refuse before any body lowers), but a null
                // parameter must refuse, never flow into llvm_type_of.
                cg_dprintf(2, "finc codegen refusal: function '%s' has more parameters than are lowered (at most 64)\n", fn_name);
                refuse_and_poison(ctx);
                break;
            }
            let pt <&LLVMType> = llvm_type_of(p_val);
            let alloca <&LLVMValue> = llvm_build_alloca(builder, pt, p_cur.name);
            llvm_build_store(builder, p_val, alloca);
            fn_ctx_add_var(ctx, p_cur.name, alloca, pt, p_cur.type_annotation);
            if (cg_param_needs_value_copy(ctx, p_cur.type_annotation, fn_node.left, p_cur.name)) {
                // By-value struct parameters arrive as the caller's heap-box
                // pointer; copy the box on entry so member stores stay
                // function-local (d01/d03: `p.a = 50` must not reach the
                // caller, while `&`-parameters keep aliasing). Same fixed
                // heap-struct buffer as struct_alloc (1024).
                let bc_fn <&LLVMValue> = get_or_declare_calloc(ctx);
                let bc_ty <&LLVMType> = llvm_global_get_value_type(bc_fn);
                let bc_args <&LLVMValueArgs> = new LLVMValueArgs{};
                bc_args.v0 = llvm_const_int(ctx.i64_ty, 1, 0);
                bc_args.v1 = llvm_const_int(ctx.i64_ty, 1024, 0);
                let fresh <&LLVMValue> = llvm_build_call2(builder, bc_ty, bc_fn, bc_args, 2, "byval_copy");
                delete bc_args;
                let mc_fn <&LLVMValue> = get_or_declare_memcpy(ctx);
                let mc_ty <&LLVMType> = llvm_global_get_value_type(mc_fn);
                let mc_args <&LLVMValueArgs> = new LLVMValueArgs{};
                mc_args.v0 = fresh;
                mc_args.v1 = p_val;
                mc_args.v2 = llvm_const_int(ctx.i64_ty, 1024, 0);
                llvm_build_call2(builder, mc_ty, mc_fn, mc_args, 3, "");
                delete mc_args;
                llvm_build_store(builder, fresh, alloca);
            }
            let pv <&LocalVar> = fn_ctx_find_var(ctx, p_cur.name);
            if (pv != null && p_cur.type_annotation != null) {
                let p_ext <int> = get_fixed_array_extent(p_cur.type_annotation);
                if (p_ext >= 0) {
                    pv.len_val = llvm_const_int(ctx.i32_ty, p_ext, 0);
                }
            }

            p_idx = p_idx + 1;
            p_cur = p_cur.right;
        }
    }

    if (fn_node.left != null) {
        collect_var_allocas(ctx, fn_node.left);
        // Wave-5 slice 4: the body lowers at function scope (0), not at a
        // block snapshot -- hoisting already created every var, so a
        // snapshot here would read every block as the same scope and no tie
        // would ever defer. lower_block shares lower_stmt's per-statement
        // checks; the tail cleanup below owns scope exit.
        if (fn_node.left.kind == ast_block()) {
            lower_block(ctx, fn_node.left);
        } else {
            lower_stmt(ctx, fn_node.left);
        }
    }

    let cur_bb <&LLVMBasicBlock> = llvm_get_insert_block(builder);
    if (ctx.poisoned && llvm_get_basic_block_terminator(cur_bb) == null) {
        // A refused construct poisoned this function: end it here with an
        // abort call (never returns at runtime) plus a dead dummy return, so
        // the module stays valid IR. When a refusal already terminated the
        // block, there is nothing to add.
        let p_abort <&LLVMValue> = llvm_get_named_function(module, "abort");
        if (p_abort == null) {
            let p_a_ty <&LLVMType> = llvm_function_type(void_t, null, 0, 0);
            p_abort = llvm_add_function(module, "abort", p_a_ty);
        }
        let p_a_fn_ty <&LLVMType> = llvm_global_get_value_type(p_abort);
        llvm_build_call2(builder, p_a_fn_ty, p_abort, null, 0, "");
        let p_ret_ty <&LLVMType> = llvm_get_return_type(llvm_global_get_value_type(fn_val));
        if (p_ret_ty == void_t) {
            llvm_build_ret_void(builder);
        } else if (p_ret_ty == i1_t) {
            let p_z1 <&LLVMValue> = llvm_const_int(i1_t, 0, 0);
            llvm_build_ret(builder, p_z1);
        } else if (p_ret_ty == i32_t) {
            let p_z32 <&LLVMValue> = llvm_const_int(i32_t, 0, 0);
            llvm_build_ret(builder, p_z32);
        } else if (p_ret_ty == i64_t) {
            let p_z64 <&LLVMValue> = llvm_const_int(i64_t, 0, 0);
            llvm_build_ret(builder, p_z64);
        } else if (p_ret_ty == i8_t) {
            let p_z8 <&LLVMValue> = llvm_const_int(i8_t, 0, 0);
            llvm_build_ret(builder, p_z8);
        } else if (p_ret_ty == ctx.float_ty || p_ret_ty == ctx.double_ty) {
            let p_zr <&LLVMValue> = llvm_const_real_of_string(p_ret_ty, "0.0");
            llvm_build_ret(builder, p_zr);
        } else if (p_ret_ty == ptr_t) {
            let p_zn <&LLVMValue> = llvm_const_null(ptr_t);
            llvm_build_ret(builder, p_zn);
        } else if (cg_is_tagged_pair(ctx, p_ret_ty)) {
            llvm_build_ret(builder, llvm_const_null(p_ret_ty));
        } else {
            llvm_build_ret_void(builder);
        }
    }
    if (!ctx.poisoned && llvm_get_basic_block_terminator(cur_bb) == null) {
        emit_scope_cleanups(ctx, 0);
        let fn_ret_ty_end <&LLVMType> = llvm_get_return_type(llvm_global_get_value_type(fn_val));
        if (cg_str_eq(fn_name, "main")) {
            let zero <&LLVMValue> = llvm_const_int(i32_t, 0, 0);
            llvm_build_ret(builder, zero);
        } else if (fn_ret_ty_end == void_t || cg_str_eq(fn_node.type_annotation, "void") || cg_str_eq(fn_node.type_annotation, "noret")) {
            llvm_build_ret_void(builder);
        } else if (fn_ret_ty_end == ptr_t) {
            let zero_p <&LLVMValue> = llvm_const_null(ptr_t);
            llvm_build_ret(builder, zero_p);
        } else if (cg_is_tagged_pair(ctx, fn_ret_ty_end)) {
            // A nullable value return that falls off the end returns null
            // (the absent pair), the declared `fun?` exemption.
            llvm_build_ret(builder, llvm_const_null(fn_ret_ty_end));
        } else if (fn_ret_ty_end == i32_t || cg_str_eq(fn_node.type_annotation, "int")) {
            let zero <&LLVMValue> = llvm_const_int(i32_t, 0, 0);
            llvm_build_ret(builder, zero);
        } else if (fn_ret_ty_end == i1_t || cg_str_eq(fn_node.type_annotation, "bool")) {
            let zero_b <&LLVMValue> = llvm_const_int(i1_t, 0, 0);
            llvm_build_ret(builder, zero_b);
        } else if (fn_ret_ty_end == i64_t) {
            let zero_64 <&LLVMValue> = llvm_const_int(i64_t, 0, 0);
            llvm_build_ret(builder, zero_64);
        } else if (fn_ret_ty_end == ctx.float_ty || fn_ret_ty_end == ctx.double_ty) {
            let zero_r <&LLVMValue> = llvm_const_real_of_string(fn_ret_ty_end, "0.0");
            llvm_build_ret(builder, zero_r);
        } else {
            llvm_build_ret_void(builder);
        }
    }

    let was_poisoned <bool> = ctx.poisoned;
    // Not verified once anything has been refused: a body that resumed past
    // a refusal is deliberately incomplete, so the verifier would report
    // that incompleteness as invalid IR -- the invented follow-on refusal in
    // its loudest form. Nothing is lost by not asking: no object is written
    // when the function is poisoned.
    if (!ctx.poisoned) {
        let fn_v_rc <int> = llvm_verify_function(fn_val, 1);
        // The verifier result is load-bearing: invalid IR never links. A
        // failure poisons the function like any other refusal, so no object
        // is written.
        if (fn_v_rc != 0) {
            cg_dprintf(2, "finc codegen refusal: emitted invalid IR for '%s'\n", fn_name);
            ctx.poisoned = true;
            was_poisoned = true;
        }
    }

    let vi <int> = 0;
    while (vi < ctx.var_count) {
        if (ctx.vars[vi] != null) {
            delete ctx.vars[vi];
        }
        vi = vi + 1;
    }
    delete ctx.vars;
    delete ctx;
    return was_poisoned;
}

pub fun lower_function_body(
  module: &LLVMModule,
  builder: &LLVMBuilder,
  fn_node: &AstNode,
  fn_syms: [&FnSymbol],
  fn_sym_count: int,
  structs: [&StructInfo],
  struct_count: int,
  enums: [&EnumInfo],
  enum_count: int,
  interfaces: [&InterfaceInfo],
  interface_count: int,
  move_claim: bool,
  src_file: string
) <bool> {
    return lower_fun_decl(module, builder, fn_node, fn_syms, fn_sym_count, structs, struct_count, enums, enum_count, interfaces, interface_count, move_claim, src_file);
}

pub fun lower_decl(
  module: &LLVMModule,
  builder: &LLVMBuilder,
  decl: &AstNode,
  fn_syms: [&FnSymbol],
  fn_sym_count: int,
  structs: [&StructInfo],
  struct_count: int,
  enums: [&EnumInfo],
  enum_count: int,
  interfaces: [&InterfaceInfo],
  interface_count: int,
  move_claim: bool,
  src_file: string
) <bool> {
    if (decl == null) { return false; }
    // A `@special` runs inside the compiler: its body has no runtime
    // meaning, so emitting nothing for it is lowering it completely
    // (the C++ backend's visit(SpecialDeclaration&) does the same).
    if (decl.kind == ast_fun_decl() && decl.int_val == 2) { return false; }
    if (decl.kind == ast_fun_decl()) {
        // FG1/MM2: free generics over structs or bare parameters lower on
        // demand (see pass 1.5): skipping them here keeps uncalled generics
        // out of the object. The `hash_word` leaf is bodiless and lowers per
        // concrete call instead (ADR 0049), so it never declares either.
        if (decl.int_val != 2 && (cg_decl_is_free_over_struct(decl, structs, struct_count) || cg_decl_is_free_bare_generic(decl, structs, struct_count) || cg_decl_is_struct_seeded_generic(decl) || cg_decl_is_hash_word_leaf(decl))) { return false; }
        return lower_fun_decl(module, builder, decl, fn_syms, fn_sym_count, structs, struct_count, enums, enum_count, interfaces, interface_count, move_claim, src_file);
    } else if (decl.kind == ast_struct_decl()) {
        // ADR 0049: `HashMap` methods lower on demand per instantiation
        // (method/static caches), never eager. Eager emission would lower
        // `T` as erased and refuse the `hash_of::<T>` call that only
        // resolves per concrete key; the C++ backend never emits erased
        // bodies for template structs either. Skipping keeps uncalled
        // generics out and lets instances carry every diagnostic. Scoped to
        // `HashMap` (the only caller of `hash_of`) so unrelated generics
        // keep their existing lowering.
        if (decl.name != null && cg_str_eq(decl.name, "HashMap")) { return false; }
        let refused <bool> = false;
        let m <&AstNode> = decl.extra;
        while (m != null) {
            // Generic methods lower on demand (see pass 1.5): skipping them
            // here is what keeps uncalled generics out of the object.
            if (!is_generic_method(m)) {
                if (lower_fun_decl(module, builder, m, fn_syms, fn_sym_count, structs, struct_count, enums, enum_count, interfaces, interface_count, move_claim, src_file)) {
                    refused = true;
                }
            }
            m = m.right;
        }
        return refused;
    }
    return false;
}

fun scan_and_hoist(node: &AstNode, tail: &AstNode, next: [int]) <&AstNode> {
    if (node == null || tail == null) { return tail; }

    if (node.kind == ast_fun_decl()) {
        if (node != tail) {
            tail.right = node;
            tail = node;
        }
    } else if (node.kind == 29) {
        if (cg_strlen(node.name) == cast<ulong>(0)) {
            // Serial names: the old positional `lam_id + 1/2/3` sums
            // collide (`left.extra` and `right.right` both land on base +
            // 4), so two lambdas shared one `fin.lambda.N` and one body
            // won (lambdas.fin case 5 ran case 4's `v / 2`). The counter
            // hands each unnamed lambda the next free id instead.
            let id <int> = 0;
            if (next != null) {
                id = next[0];
                next[0] = id + 1;
            }
            let b_l <Buffer> = new_buffer(32);
            b_l.write_string("fin.lambda.");
            b_l.write_int(id);
            node.name = b_l.to_string();
            free_buffer(b_l);
        }

        let fn_lam <&AstNode> = new AstNode{};
        fn_lam.kind = ast_fun_decl();
        fn_lam.name = node.name;
        fn_lam.type_annotation = node.type_annotation;
        fn_lam.extra = node.extra;
        node.extra = null;

        if (node.left != null && node.left.kind != ast_block()) {
            let ret_s <&AstNode> = new AstNode{};
            if (cg_str_eq(node.type_annotation, "void")) {
                // A void lambda's expression body is an effect, not a
                // value: `=> printf(...)` must run the call, so it wraps
                // as a bare expression statement. A `return <expr>` in
                // void position drops the value -- and the call with it.
                ret_s.kind = ast_expr_stmt();
            } else {
                ret_s.kind = ast_return_stmt();
            }
            ret_s.left = node.left;
            node.left = null;
            let blk <&AstNode> = new AstNode{};
            blk.kind = ast_block();
            let wrap <&AstNode> = new AstNode{};
            wrap.left = ret_s;
            blk.left = wrap;
            fn_lam.left = blk;
        } else {
            fn_lam.left = node.left;
            node.left = null;
        }

        tail.right = fn_lam;
        tail = fn_lam;
    }

    if (node.left != null) {
        tail = scan_and_hoist(node.left, tail, next);
    }
    if (node.right != null) {
        tail = scan_and_hoist(node.right, tail, next);
    }
    if (node.extra != null) {
        tail = scan_and_hoist(node.extra, tail, next);
    }
    return tail;
}

// Ownership transfer for hoist_nested_functions: a nested fun_decl found by
// scan_and_hoist is appended to the top-level list, so the body wrapper that
// still points at it must let go (wrapper.left = null lowers as a skip and
// frees cleanly). Without this the node has two owners and free_ast frees it
// twice, segfaulting inside free_ast. Recurses into the hoisted body first so
// deeper hoists (fun in fun) transfer too. Idempotent: safe on clean bodies.
fun prune_hoisted_funs(node: &AstNode) <noret> {
    if (node == null) { return; }
    if (node.kind == ast_block()) {
        let cur <&AstNode> = node.left;
        while (cur != null) {
            if (cur.left != null && cur.left.kind == ast_fun_decl()) {
                prune_hoisted_funs(cur.left);
                cur.left = null;
            } else {
                prune_hoisted_funs(cur.left);
            }
            cur = cur.right;
        }
        return;
    }
    if (node.kind == ast_fun_decl()) {
        prune_hoisted_funs(node.left);
        prune_hoisted_funs(node.right);
        prune_hoisted_funs(node.extra);
        return;
    }
    prune_hoisted_funs(node.left);
    prune_hoisted_funs(node.right);
    prune_hoisted_funs(node.extra);
}

fun hoist_nested_functions(root: &AstNode) <noret> {
    if (root == null || root.left == null) { return; }
    let tail <&AstNode> = root.left;
    while (tail.right != null) {
        tail = tail.right;
    }

    let cur <&AstNode> = root.left;
    let lam_next <[int]> = new [int, 1]{};
    lam_next[0] = 0;
    while (cur != null) {
        if (cur.kind == ast_fun_decl() && cur.left != null) {
            tail = scan_and_hoist(cur.left, tail, lam_next);
            prune_hoisted_funs(cur.left);
        } else if (cur.kind == ast_struct_decl()) {
            let m <&AstNode> = cur.extra;
            while (m != null) {
                if (m.kind == ast_fun_decl() && m.left != null) {
                    tail = scan_and_hoist(m.left, tail, lam_next);
                    prune_hoisted_funs(m.left);
                }
                m = m.right;
            }
        }
        cur = cur.right;
    }
    delete lam_next;
}

// Top-level `let`/`const` with a constant initializer become LLVM globals so
// uses anywhere (including `#cdef` constants, which parse as globals) load a
// real address. Anything else is refused rather than dropped.
fun lower_global_var(module: &LLVMModule, decl: &AstNode, structs: [&StructInfo], struct_count: int) <noret> {
    if (decl == null || module == null) { return; }
    if (decl.name == null || cg_strlen(decl.name) == cast<ulong>(0)) { return; }
    if (llvm_get_named_global(module, decl.name) != null) { return; }
    let i32_t <&LLVMType> = llvm_i32_type();
    let i1_t <&LLVMType> = llvm_i1_type();
    let i8_t <&LLVMType> = llvm_i8_type();
    let i16_t <&LLVMType> = llvm_i16_type();
    let i64_t <&LLVMType> = llvm_i64_type();
    let ptr_t <&LLVMType> = llvm_pointer_type(llvm_i8_type(), 0);

    let init <&AstNode> = decl.left;
    if (init != null && init.kind == 0 && init.left != null) {
        init = init.left;
    }
    if (init == null) {
        // Tentative definition: zero by annotation, through the same
        // width the locals use (short is i16, char is i8, long is i64).
        let z_ty <&LLVMType> = ptr_t;
        if (cg_str_eq(decl.type_annotation, "int") || cg_str_eq(decl.type_annotation, "uint") || cg_str_eq(decl.type_annotation, "i32") || cg_str_eq(decl.type_annotation, "u32") || cg_str_eq(decl.type_annotation, "int{32}") || cg_str_eq(decl.type_annotation, "uint{32}")) {
            z_ty = i32_t;
        } else if (cg_str_eq(decl.type_annotation, "short") || cg_str_eq(decl.type_annotation, "ushort") || cg_str_eq(decl.type_annotation, "i16") || cg_str_eq(decl.type_annotation, "u16") || cg_str_eq(decl.type_annotation, "int{16}") || cg_str_eq(decl.type_annotation, "uint{16}")) {
            z_ty = i16_t;
        } else if (cg_str_eq(decl.type_annotation, "char") || cg_str_eq(decl.type_annotation, "u8") || cg_str_eq(decl.type_annotation, "i8") || cg_str_eq(decl.type_annotation, "int{8}") || cg_str_eq(decl.type_annotation, "uint{8}")) {
            z_ty = i8_t;
        } else if (cg_str_eq(decl.type_annotation, "long") || cg_str_eq(decl.type_annotation, "ulong") || cg_str_eq(decl.type_annotation, "i64") || cg_str_eq(decl.type_annotation, "u64") || cg_str_eq(decl.type_annotation, "size_t") || cg_str_eq(decl.type_annotation, "usize") || cg_str_eq(decl.type_annotation, "isize") || cg_str_eq(decl.type_annotation, "int{64}") || cg_str_eq(decl.type_annotation, "uint{64}")) {
            z_ty = i64_t;
        } else if (cg_str_eq(decl.type_annotation, "bool")) {
            z_ty = i1_t;
        }
        let zg <&LLVMValue> = llvm_add_global(module, z_ty, decl.name);
        llvm_set_initializer(zg, llvm_const_null(z_ty));
        return;
    }
    if (init.kind == ast_literal_int()) {
        // An integer global keeps its declared width (short wraps at
        // 16 bits, like a short local): the constant truncates to it.
        let g_ty <&LLVMType> = i32_t;
        if (cg_str_eq(decl.type_annotation, "short") || cg_str_eq(decl.type_annotation, "ushort") || cg_str_eq(decl.type_annotation, "i16") || cg_str_eq(decl.type_annotation, "u16") || cg_str_eq(decl.type_annotation, "int{16}") || cg_str_eq(decl.type_annotation, "uint{16}")) {
            g_ty = i16_t;
        } else if (cg_str_eq(decl.type_annotation, "char") || cg_str_eq(decl.type_annotation, "u8") || cg_str_eq(decl.type_annotation, "i8") || cg_str_eq(decl.type_annotation, "int{8}") || cg_str_eq(decl.type_annotation, "uint{8}")) {
            g_ty = i8_t;
        } else if (cg_str_eq(decl.type_annotation, "long") || cg_str_eq(decl.type_annotation, "ulong") || cg_str_eq(decl.type_annotation, "i64") || cg_str_eq(decl.type_annotation, "u64") || cg_str_eq(decl.type_annotation, "size_t") || cg_str_eq(decl.type_annotation, "usize") || cg_str_eq(decl.type_annotation, "isize") || cg_str_eq(decl.type_annotation, "int{64}") || cg_str_eq(decl.type_annotation, "uint{64}")) {
            g_ty = i64_t;
        }
        let g <&LLVMValue> = llvm_add_global(module, g_ty, decl.name);
        llvm_set_initializer(g, llvm_const_int(g_ty, init.int_val, 0));
        return;
    }
    if (init.kind == ast_literal_bool()) {
        let g <&LLVMValue> = llvm_add_global(module, i1_t, decl.name);
        llvm_set_initializer(g, llvm_const_int(i1_t, init.int_val, 0));
        return;
    }
    if (init.kind == ast_literal_string()) {
        let unesc <string> = unescape_string_literal(init.str_val);
        let slen <int> = cast<int>(cg_strlen(unesc));
        let arr_ty <&LLVMType> = llvm_array_type(i8_t, slen + 1);
        let nb <Buffer> = new_buffer(64);
        nb.write_string(decl.name);
        nb.write_string(".bytes");
        let arr_name <string> = nb.to_string();
        free_buffer(nb);
        let arr_g <&LLVMValue> = llvm_add_global(module, arr_ty, arr_name);
        llvm_set_initializer(arr_g, llvm_const_string(unesc, slen, 0));
        llvm_set_global_constant(arr_g, 1);
        let g <&LLVMValue> = llvm_add_global(module, ptr_t, decl.name);
        llvm_set_initializer(g, llvm_const_bitcast(arr_g, ptr_t));
        return;
    }
    // An address-of global (`let gp <&int> = &x;`, `let c <&string> =
    // &"lit";`): the referent is a constant address, which C++ folds in
    // constantInitializer. Bitcast the referent to the pointer word so
    // uses load the referent's address, not a zero word.
    if (init.kind == ast_unary_expr() && cg_str_eq(init.name, "&") && init.left != null) {
        let target <&AstNode> = init.left;
        if (target.kind == 0 && target.left != null) {
            target = target.left;
        }
        if (target.kind == ast_ident()) {
            let ref <&LLVMValue> = llvm_get_named_global(module, target.name);
            if (ref != null) {
                let g <&LLVMValue> = llvm_add_global(module, ptr_t, decl.name);
                llvm_set_initializer(g, llvm_const_bitcast(ref, ptr_t));
                return;
            }
        } else if (target.kind == ast_literal_string()) {
            let unesc2 <string> = unescape_string_literal(target.str_val);
            let slen2 <int> = cast<int>(cg_strlen(unesc2));
            let arr_ty2 <&LLVMType> = llvm_array_type(i8_t, slen2 + 1);
            let nb2 <Buffer> = new_buffer(64);
            nb2.write_string(decl.name);
            nb2.write_string(".bytes");
            let arr_name2 <string> = nb2.to_string();
            free_buffer(nb2);
            let arr_g2 <&LLVMValue> = llvm_add_global(module, arr_ty2, arr_name2);
            llvm_set_initializer(arr_g2, llvm_const_string(unesc2, slen2, 0));
            llvm_set_global_constant(arr_g2, 1);
            let g2 <&LLVMValue> = llvm_add_global(module, ptr_t, decl.name);
            llvm_set_initializer(g2, llvm_const_bitcast(arr_g2, ptr_t));
            return;
        }
    }
    // A struct literal with constant scalar fields (`let GBox <Box<int>> =
    // Box::<int>{ val: 77 }`): heap structs live in pointer-strided 8-byte
    // slots, so the global is a pointer to a constant buffer holding one
    // 8-byte slot per field, exactly what a calloc'd box holds at runtime.
    // Field reads/writes route through the pointer unchanged. Anything
    // non-constant (or a non-scalar field) stays a named refusal: a global
    // initializer cannot run code.
    if (init.kind == ast_call_expr() && cg_str_eq(init.name, "__fin_struct_init")) {
        let dann <string> = cg_trim_spaces(decl.type_annotation);
        let dlen <int> = cast<int>(cg_strlen(dann));
        let dbase <string> = dann;
        let dinner <string> = "";
        let di <int> = 0;
        while (di < dlen) {
            if (cg_str_eq(substr(dann, di, 1), "<")) {
                dbase = cg_trim_spaces(substr(dann, 0, di));
                let dd <int> = dlen - 1;
                while (dd > di) {
                    if (cg_str_eq(substr(dann, dd, 1), ">")) { break; }
                    dd = dd - 1;
                }
                if (dd > di) {
                    dinner = substr(dann, di + 1, dd - di - 1);
                }
                break;
            }
            di = di + 1;
        }
        let tmpl <&StructInfo> = null;
        let si <int> = 0;
        while (si < struct_count) {
            let st <&StructInfo> = structs[si];
            if (st != null && cg_str_eq(st.name, dbase)) {
                tmpl = st;
                break;
            }
            si = si + 1;
        }
        if (tmpl != null && tmpl.field_count > 0 && tmpl.field_count <= 64) {
            let gp <[string]> = new [string, 64]{};
            let ga <[string]> = new [string, 64]{};
            let gpc <int> = 0;
            let gac <int> = 0;
            if (tmpl.gen_params != null && cg_strlen(tmpl.gen_params) > cast<ulong>(0)) {
                gpc = cg_split_top(tmpl.gen_params, gp, 64);
            }
            if (cg_strlen(dinner) > cast<ulong>(0)) {
                gac = cg_split_top(dinner, ga, 64);
            }
            let g_ok <bool> = true;
            if (gpc != gac) { g_ok = false; }
            let g_bytes <Buffer> = new_buffer(tmpl.field_count * 8 + 1);
            if (g_ok) {
                let fi <int> = 0;
                while (fi < tmpl.field_count) {
                    let fld <&StructFieldInfo> = tmpl.fields[fi];
                    if (fld == null || fld.name == null) { g_ok = false; break; }
                    let f_ann <string> = fld.type_annotation;
                    if (gpc > 0) {
                        f_ann = cg_subst_params(f_ann, gp, ga, gpc, gac);
                    }
                    let f_trim <string> = cg_trim_spaces(f_ann);
                    if (!cg_str_eq(f_trim, "int") && !cg_str_eq(f_trim, "uint") &&
                      !cg_str_eq(f_trim, "bool") && !cg_str_eq(f_trim, "char") &&
                      !cg_str_eq(f_trim, "u8") && !cg_str_eq(f_trim, "i8")) {
                        g_ok = false;
                        break;
                      }
                    let f_init <&AstNode> = init.left;
                    let f_val <int> = 0;
                    let f_found <bool> = false;
                    while (f_init != null) {
                        if (f_init.name != null && cg_str_eq(f_init.name, fld.name)) {
                            let fv <&AstNode> = f_init.left;
                            if (fv != null && fv.kind == 0 && fv.left != null) { fv = fv.left; }
                            if (fv != null && (fv.kind == ast_literal_int() || fv.kind == ast_literal_bool())) {
                                f_val = fv.int_val;
                                f_found = true;
                            } else {
                                g_ok = false;
                            }
                            break;
                        }
                        f_init = f_init.right;
                    }
                    if (!g_ok) { break; }
                    if (!f_found) { f_val = 0; }
                    // Little-endian bytes of the value (exact division:
                    // low is congruent to b mod 256, so (b - low) / 256
                    // is exact and trunc division is correct for
                    // negatives too).
                    let b <int> = f_val;
                    let k <int> = 0;
                    while (k < 8) {
                        let low <int> = ((b % 256) + 256) % 256;
                        g_bytes.write_char(cast<char>(low));
                        b = (b - low) / 256;
                        k = k + 1;
                    }
                    fi = fi + 1;
                }
            }
            if (g_ok) {
                let g_str <string> = g_bytes.to_string();
                let g_len <int> = tmpl.field_count * 8;
                let buf_ty <&LLVMType> = llvm_array_type(i8_t, g_len);
                let bnb <Buffer> = new_buffer(64);
                bnb.write_string(decl.name);
                bnb.write_string(".buf");
                let buf_name <string> = bnb.to_string();
                free_buffer(bnb);
                let buf_g <&LLVMValue> = llvm_add_global(module, buf_ty, buf_name);
                llvm_set_initializer(buf_g, llvm_const_string(g_str, g_len, 1));
                let g <&LLVMValue> = llvm_add_global(module, ptr_t, decl.name);
                llvm_set_initializer(g, llvm_const_bitcast(buf_g, ptr_t));
                free_buffer(g_bytes);
                delete gp;
                delete ga;
                return;
            }
            free_buffer(g_bytes);
            delete gp;
            delete ga;
        }
    }
    cg_dprintf(2, "finc codegen refusal: global '%s' with non-constant initializer\n", decl.name);
}

// Wave-5 slice 2: lowers the `destructor` claimant's generation once, as
// the shared no-receiver function `__fin_dtor_claim`, before any body that
// may call it. The quote block lowers like any void body; an empty claim
// (null block) supplies nothing. True on refusal: like a poisoned function,
// the module must not link.
fun lower_dtor_claim(
  module: &LLVMModule,
  builder: &LLVMBuilder,
  qblk: &AstNode,
  fn_syms: [&FnSymbol],
  fn_sym_count: int,
  structs: [&StructInfo],
  struct_count: int,
  enums: [&EnumInfo],
  enum_count: int,
  interfaces: [&InterfaceInfo],
  interface_count: int,
  move_claim: bool,
  src_file: string
) <bool> {
    if (qblk == null) { return false; }
    let i32_t <&LLVMType> = llvm_i32_type();
    let i64_t <&LLVMType> = llvm_i64_type();
    let i1_t <&LLVMType> = llvm_i1_type();
    let i8_t <&LLVMType> = llvm_i8_type();
    let void_t <&LLVMType> = llvm_void_type();
    let ptr_t <&LLVMType> = llvm_pointer_type(llvm_i8_type(), 0);
    let g_ty <&LLVMType> = llvm_function_type(void_t, null, 0, 0);
    let g_fn <&LLVMValue> = llvm_add_function(module, "__fin_dtor_claim", g_ty);
    let entry_bb <&LLVMBasicBlock> = llvm_append_basic_block(g_fn, "entry");
    llvm_position_builder(builder, entry_bb);
    let ctx <&FnContext> = new FnContext{};
    ctx.vars = new [&LocalVar, 1024]{};
    ctx.var_count = 0;
    ctx.fn_syms = fn_syms;
    ctx.fn_sym_count = fn_sym_count;
    ctx.fn_val = g_fn;
    ctx.builder = builder;
    ctx.module = module;
    ctx.i32_ty = i32_t;
    ctx.i64_ty = i64_t;
    ctx.i1_ty = i1_t;
    ctx.i8_ty = i8_t;
    ctx.i16_ty = llvm_i16_type();
    ctx.float_ty = llvm_float_type();
    ctx.double_ty = llvm_double_type();
    ctx.ptr_ty = ptr_t;
    ctx.void_ty = void_t;
    ctx.break_bb = null;
    ctx.continue_bb = null;
    ctx.structs = structs;
    ctx.struct_count = struct_count;
    ctx.enums = enums;
    ctx.enum_count = enum_count;
    ctx.interfaces = interfaces;
    ctx.interface_count = interface_count;
    ctx.has_move_claim = move_claim;
    ctx.src_file = src_file;
    ctx.ret_iface = null;
    let fat_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
    fat_args.t0 = ptr_t;
    fat_args.t1 = ptr_t;
    ctx.fat_ptr_ty = llvm_struct_type(fat_args, 2, 0);
    delete fat_args;
    // Wave-5 slice 4: the deferred-destruction list (see lower_fun_decl).
    ctx.tied_idx = new [int, 1024]{};
    ctx.tied_moved = new [int, 1024]{};
    ctx.tied_count = 0;
    collect_var_allocas(ctx, qblk);
    lower_stmt(ctx, qblk);
    let cur_bb <&LLVMBasicBlock> = llvm_get_insert_block(builder);
    if (ctx.poisoned && llvm_get_basic_block_terminator(cur_bb) == null) {
        let p_abort <&LLVMValue> = llvm_get_named_function(module, "abort");
        if (p_abort == null) {
            let p_a_ty <&LLVMType> = llvm_function_type(void_t, null, 0, 0);
            p_abort = llvm_add_function(module, "abort", p_a_ty);
        }
        let p_a_fn_ty <&LLVMType> = llvm_global_get_value_type(p_abort);
        llvm_build_call2(builder, p_a_fn_ty, p_abort, null, 0, "");
        llvm_build_ret_void(builder);
    }
    if (!ctx.poisoned && llvm_get_basic_block_terminator(cur_bb) == null) {
        emit_scope_cleanups(ctx, 0);
        llvm_build_ret_void(builder);
    }
    return ctx.poisoned;
}

// Wave-5 slice 3: lowers the `deallocate` claimant's generation once, as
// the shared no-receiver function `__fin_dealloc_claim`, before any body
// that may call it. The quote block lowers like any void body; an empty
// claim (null block) supplies nothing, so the default `free` stays. True
// on refusal: like a poisoned function, the module must not link.
// Mirrors lower_dtor_claim above: recognition, the generation subset, and
// the shared lowering are the same shape, only the slot differs.
fun lower_dealloc_claim(
  module: &LLVMModule,
  builder: &LLVMBuilder,
  qblk: &AstNode,
  fn_syms: [&FnSymbol],
  fn_sym_count: int,
  structs: [&StructInfo],
  struct_count: int,
  enums: [&EnumInfo],
  enum_count: int,
  interfaces: [&InterfaceInfo],
  interface_count: int,
  move_claim: bool,
  src_file: string
) <bool> {
    if (qblk == null) { return false; }
    let i32_t <&LLVMType> = llvm_i32_type();
    let i64_t <&LLVMType> = llvm_i64_type();
    let i1_t <&LLVMType> = llvm_i1_type();
    let i8_t <&LLVMType> = llvm_i8_type();
    let void_t <&LLVMType> = llvm_void_type();
    let ptr_t <&LLVMType> = llvm_pointer_type(llvm_i8_type(), 0);
    let g_ty <&LLVMType> = llvm_function_type(void_t, null, 0, 0);
    let g_fn <&LLVMValue> = llvm_add_function(module, "__fin_dealloc_claim", g_ty);
    let entry_bb <&LLVMBasicBlock> = llvm_append_basic_block(g_fn, "entry");
    llvm_position_builder(builder, entry_bb);
    let ctx <&FnContext> = new FnContext{};
    ctx.vars = new [&LocalVar, 1024]{};
    ctx.var_count = 0;
    ctx.fn_syms = fn_syms;
    ctx.fn_sym_count = fn_sym_count;
    ctx.fn_val = g_fn;
    ctx.builder = builder;
    ctx.module = module;
    ctx.i32_ty = i32_t;
    ctx.i64_ty = i64_t;
    ctx.i1_ty = i1_t;
    ctx.i8_ty = i8_t;
    ctx.i16_ty = llvm_i16_type();
    ctx.float_ty = llvm_float_type();
    ctx.double_ty = llvm_double_type();
    ctx.ptr_ty = ptr_t;
    ctx.void_ty = void_t;
    ctx.break_bb = null;
    ctx.continue_bb = null;
    ctx.structs = structs;
    ctx.struct_count = struct_count;
    ctx.enums = enums;
    ctx.enum_count = enum_count;
    ctx.interfaces = interfaces;
    ctx.interface_count = interface_count;
    ctx.has_move_claim = move_claim;
    ctx.src_file = src_file;
    ctx.ret_iface = null;
    let fat_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
    fat_args.t0 = ptr_t;
    fat_args.t1 = ptr_t;
    ctx.fat_ptr_ty = llvm_struct_type(fat_args, 2, 0);
    delete fat_args;
    // Wave-5 slice 4: the deferred-destruction list (see lower_fun_decl).
    ctx.tied_idx = new [int, 1024]{};
    ctx.tied_moved = new [int, 1024]{};
    ctx.tied_count = 0;
    collect_var_allocas(ctx, qblk);
    lower_stmt(ctx, qblk);
    let cur_bb <&LLVMBasicBlock> = llvm_get_insert_block(builder);
    if (ctx.poisoned && llvm_get_basic_block_terminator(cur_bb) == null) {
        let p_abort <&LLVMValue> = llvm_get_named_function(module, "abort");
        if (p_abort == null) {
            let p_a_ty <&LLVMType> = llvm_function_type(void_t, null, 0, 0);
            p_abort = llvm_add_function(module, "abort", p_a_ty);
        }
        let p_a_fn_ty <&LLVMType> = llvm_global_get_value_type(p_abort);
        llvm_build_call2(builder, p_a_fn_ty, p_abort, null, 0, "");
        llvm_build_ret_void(builder);
    }
    if (!ctx.poisoned && llvm_get_basic_block_terminator(cur_bb) == null) {
        emit_scope_cleanups(ctx, 0);
        llvm_build_ret_void(builder);
    }
    return ctx.poisoned;
}

pub fun generate_llvm_code(root: &AstNode, output_path: string, opt_level: int, src_file: string) <bool> {
    if (root == null) { return false; }

    init_native_target();

    // Wave-5 slice 1: the `move_or_copy` claimant gate, scanned once,
    // program-wide, before hoisting (top-level `@special` only, mirroring
    // the C++ backend's scan).
    let move_claim <bool> = cg_program_has_move_claim(root);

    hoist_nested_functions(root);

    let module <&LLVMModule> = llvm_module_create("fin_module");
    let builder <&LLVMBuilder> = llvm_create_builder();

    // Canonical ambient `printf` declares before any user declaration
    // (declare_function keeps the first spelling in the module): a hoisted
    // in-body `@define printf() <noret>` (literal_struct.fin's `@defined`
    // guard) must not hijack the vararg symbol the gated call resolves
    // through. Mirrors the C++ driver's ambient printf prototype, which is
    // also why `@defined("printf")` folds there. Same shape as
    // get_or_declare_printf below, which then reuses this declaration.
    let pre_pf <&LLVMValue> = llvm_get_named_function(module, "printf");
    if (pre_pf == null) {
        let pre_params <&LLVMTypeArgs> = new LLVMTypeArgs{};
        pre_params.t0 = llvm_pointer_type(llvm_i8_type(), 0);
        let pre_ty <&LLVMType> = llvm_function_type(llvm_i32_type(), pre_params, 1, 1);
        delete pre_params;
        pre_pf = llvm_add_function(module, "printf", pre_ty);
    }

    let fn_syms <[&FnSymbol]> = new [&FnSymbol, 8192]{};
    let fn_sym_count <int> = 0;

    let structs <[&StructInfo]> = new [&StructInfo, 1024]{};
    let struct_count <int> = 0;

    let enums <[&EnumInfo]> = new [&EnumInfo, 256]{};
    let enum_count <int> = 0;

    let interfaces <[&InterfaceInfo]> = new [&InterfaceInfo, 256]{};
    let interface_count <int> = 0;

    // Pass 1: Record interface, enum, and struct definitions FIRST
    let decl <&AstNode> = root.left;
    while (decl != null) {
        if (decl.kind == ast_struct_decl()) {
            if (struct_count < 1020) {
                let s_info <&StructInfo> = new StructInfo{};
                s_info.name = decl.name;
                s_info.fields = new [&StructFieldInfo, 64]{};
                s_info.field_count = 0;
                s_info.has_destructor = false;
                s_info.destructor_name = "";
                // PT1 slice 1: a member carrying `operator` with `==`/`!=`
                // (flattened, e.g. `MyInt_operator==`) declares equality.
                s_info.has_eq = false;
                s_info.has_ne = false;
                s_info.gen_params = "";
                s_info.gen_eq_use = "";
                s_info.gen_ne_use = "";
                let f_cur <&AstNode> = decl.left;
                let f_idx <int> = 0;
                while (f_cur != null && f_idx < 64) {
                    // A nullable value-type field (`b? <int>`) lowers as the
                    // tagged pair `{T, i1}` member map_type builds; field
                    // loads and stores read it through the same pair, and an
                    // omitted field stays what calloc left: the zero pair,
                    // absent. Nullable pointers, strings, and function values
                    // are one word either way and keep lowering.
                    let f_item <&StructFieldInfo> = new StructFieldInfo{};
                    f_item.name = f_cur.name;
                    f_item.index = f_idx;
                    f_item.type_annotation = f_cur.type_annotation;
                    f_item.default_init = f_cur.left;
                    s_info.fields[f_idx] = f_item;
                    s_info.field_count = s_info.field_count + 1;
                    f_idx = f_idx + 1;
                    f_cur = f_cur.right;
                }
                if (f_cur != null) {
                    // More fields than the StructInfo carrier holds (64):
                    // refuse instead of dropping the tail silently (a
                    // 65-field literal then aborts at runtime).
                    cg_dprintf(2, "finc codegen refusal: struct '%s' has more fields than are lowered (at most 64)\n", decl.name);
                    return false;
                }
                let m_check <&AstNode> = decl.extra;
                while (m_check != null) {
                    let mlen <int> = cast<int>(cg_strlen(m_check.name));
                    let is_dtor <bool> = false;
                    if (cg_str_eq(m_check.name, "destructor")) { is_dtor = true; }
                    if (mlen >= 11 && cg_str_eq(substr(m_check.name, mlen - 11, 11), "_destructor")) { is_dtor = true; }
                    if (mlen >= 11 && cg_str_eq(substr(m_check.name, mlen - 11, 11), ".destructor")) { is_dtor = true; }
                    if (is_dtor) {
                        s_info.has_destructor = true;
                        s_info.destructor_name = m_check.name;
                    }
                    if (m_check.name != null && cg_str_contains(m_check.name, "operator")) {
                        if (cg_str_contains(m_check.name, "==")) { s_info.has_eq = true; }
                        if (cg_str_contains(m_check.name, "!=")) { s_info.has_ne = true; }
                    }
                    m_check = m_check.right;
                }
                // PT1 slice 3: record the instantiation knowledge the
                // constructor gate reads (parameter order plus compared
                // parameters) while this declaration's method ASTs are here.
                if (decl.type_annotation != null && cg_strlen(decl.type_annotation) > cast<ulong>(0)) {
                    if (cg_count_top(decl.type_annotation) > 64) {
                        // More generic parameters than the substitution
                        // carriers hold (64): refuse instead of truncating
                        // the parameter list into a misresolving use.
                        cg_dprintf(2, "finc codegen refusal: struct '%s' has more generic parameters than are lowered (at most 64)\n", decl.name);
                        return false;
                    }
                    cg_record_struct_generics(decl, s_info);
                }
                // MC1 (b): keep the method chain head for the per-key cache.
                s_info.method_head = decl.extra;
                // Wave-5 slice 2 (ADR 0016 composition, mirroring C++
                // propagateComposedDestructor): a struct with no declared
                // destructor whose directly-held struct field (declared
                // above it, so already recorded) has one acquires cleanup.
                // The generated destructor needs no symbol: scope exits and
                // deletes reach the fields through emit_destructor_for_obj.
                if (!s_info.has_destructor) {
                    let ci <int> = 0;
                    while (ci < s_info.field_count) {
                        let cf <&StructFieldInfo> = s_info.fields[ci];
                        if (cf != null && !cg_ann_holds_no_value(cf.type_annotation)) {
                            let cj <int> = 0;
                            while (cj < struct_count) {
                                let prev <&StructInfo> = structs[cj];
                                if (prev != null && cg_str_eq(prev.name, cf.type_annotation) && prev.has_destructor) {
                                    s_info.has_destructor = true;
                                }
                                cj = cj + 1;
                            }
                        }
                        if (s_info.has_destructor) { break; }
                        ci = ci + 1;
                    }
                }
                structs[struct_count] = s_info;
                struct_count = struct_count + 1;
            }
        } else if (decl.kind == ast_enum_decl()) {
            if (enum_count < 250) {
                let e_info <&EnumInfo> = new EnumInfo{};
                e_info.name = decl.name;
                e_info.members = new [&EnumMemberInfo, 64]{};
                e_info.member_count = 0;
                e_info.has_payload = false;
                e_info.max_payload_size = 0;
                e_info.gen_params = "";
                if (decl.type_annotation != null && cg_strlen(decl.type_annotation) > cast<ulong>(0)) {
                    e_info.gen_params = decl.type_annotation;
                }

                let mem_cur <&AstNode> = decl.left;
                let cur_tag <int> = 0;
                let m_idx <int> = 0;
                while (mem_cur != null && m_idx < 64) {
                    let m_item <&EnumMemberInfo> = new EnumMemberInfo{};
                    m_item.name = mem_cur.name;
                    if (mem_cur.left != null && mem_cur.left.kind == ast_literal_int()) {
                        cur_tag = mem_cur.left.int_val;
                    }
                    m_item.tag = cur_tag;
                    m_item.has_payload = (mem_cur.int_val == 1);
                    m_item.payload_type = mem_cur.type_annotation;
                    if (m_item.has_payload) {
                        e_info.has_payload = true;
                        let ps <int> = 8;
                        if (cg_str_eq(m_item.payload_type, "int") || cg_str_eq(m_item.payload_type, "uint")) { ps = 4; }
                        else if (cg_str_eq(m_item.payload_type, "bool") || cg_str_eq(m_item.payload_type, "char") || cg_str_eq(m_item.payload_type, "u8") || cg_str_eq(m_item.payload_type, "i8")) { ps = 1; }
                        m_item.payload_size = ps;
                        if (ps > e_info.max_payload_size) {
                            e_info.max_payload_size = ps;
                        }
                    }
                    e_info.members[m_idx] = m_item;
                    e_info.member_count = e_info.member_count + 1;
                    m_idx = m_idx + 1;
                    cur_tag = cur_tag + 1;
                    mem_cur = mem_cur.right;
                }
                if (mem_cur != null) {
                    // More members than the EnumInfo carrier holds (64):
                    // refuse instead of dropping the tail silently.
                    cg_dprintf(2, "finc codegen refusal: enum '%s' has more members than are lowered (at most 64)\n", decl.name);
                    return false;
                }
                if (e_info.has_payload) {
                    let pay_sz <int> = e_info.max_payload_size;
                    if (pay_sz == 0) { pay_sz = 8; }
                    let e_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
                    e_args.t0 = llvm_i32_type();
                    e_args.t1 = llvm_array_type(llvm_i8_type(), pay_sz);
                    e_info.llvm_type = llvm_struct_type(e_args, 2, 0);
                    delete e_args;
                } else {
                    e_info.llvm_type = llvm_i32_type();
                }
                enums[enum_count] = e_info;
                enum_count = enum_count + 1;
            }
        } else if (decl.kind == ast_interface_decl()) {
            if (interface_count < 250) {
                let if_info <&InterfaceInfo> = new InterfaceInfo{};
                if_info.name = decl.name;
                if_info.methods = new [&InterfaceMethodInfo, 64]{};
                if_info.method_count = 0;
                let m_cur <&AstNode> = decl.extra;
                let mi <int> = 0;
                while (m_cur != null && mi < 64) {
                    let mi_item <&InterfaceMethodInfo> = new InterfaceMethodInfo{};
                    mi_item.name = m_cur.name;
                    mi_item.index = mi;
                    mi_item.ret_type = m_cur.type_annotation;
                    let p_count <int> = 0;
                    let pc <&AstNode> = m_cur.extra;
                    while (pc != null) {
                        p_count = p_count + 1;
                        pc = pc.right;
                    }
                    mi_item.param_count = p_count;
                    if_info.methods[mi] = mi_item;
                    if_info.method_count = if_info.method_count + 1;
                    mi = mi + 1;
                    m_cur = m_cur.right;
                }
                if (m_cur != null) {
                    // More methods than the InterfaceInfo carrier holds
                    // (64): refuse instead of dropping the tail silently.
                    cg_dprintf(2, "finc codegen refusal: interface '%s' has more methods than are lowered (at most 64)\n", decl.name);
                    return false;
                }
                // Interface fields (decl.left) occupy vtable slots after the
                // methods, marked so readers emit offset loads and the call
                // path does not mistake them for methods.
                let f_cur <&AstNode> = decl.left;
                while (f_cur != null && mi < 64) {
                    if (f_cur.kind == ast_var_decl()) {
                        let fi_item <&InterfaceMethodInfo> = new InterfaceMethodInfo{};
                        fi_item.name = f_cur.name;
                        fi_item.index = mi;
                        fi_item.ret_type = f_cur.type_annotation;
                        fi_item.param_count = 0;
                        fi_item.is_field = true;
                        if_info.methods[mi] = fi_item;
                        if_info.method_count = if_info.method_count + 1;
                        mi = mi + 1;
                    }
                    f_cur = f_cur.right;
                }
                if (f_cur != null) {
                    // Methods plus fields exceed the 64 vtable slots:
                    // refuse instead of dropping the tail silently.
                    cg_dprintf(2, "finc codegen refusal: interface '%s' has more methods and fields than are lowered (at most 64)\n", decl.name);
                    return false;
                }
                // The fat type is nominal (named), not the shared anonymous
                // {ptr, ptr}: LLVM uniques anonymous structs structurally, so
                // distinct interfaces would compare identical and conversion
                // would build the wrong interface's vtable.
                let nb <Buffer> = new_buffer(64);
                nb.write_string(if_info.name);
                nb.write_string(".fat");
                let fat_name <string> = nb.to_string();
                free_buffer(nb);
                let fcx <&LLVMContext> = llvm_get_global_context();
                let named_fat <&LLVMType> = llvm_struct_create_named(fcx, fat_name);
                let if_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
                if_args.t0 = llvm_pointer_type(llvm_i8_type(), 0);
                if_args.t1 = llvm_pointer_type(llvm_i8_type(), 0);
                llvm_struct_set_body(named_fat, if_args, 2, 0);
                delete if_args;
                if_info.fat_ptr_ty = named_fat;

                interfaces[interface_count] = if_info;
                interface_count = interface_count + 1;
            }
        } else if (decl.kind == ast_var_decl()) {
            lower_global_var(module, decl, structs, struct_count);
        }
        decl = decl.right;
    }

    // Pass 1.5: Declare all functions and struct methods with full interface awareness.
    // A generic in-struct method declares nothing here: it is a template,
    // registered for on-demand instantiation (LM1). Like the C++ backend,
    // a template with no arguments has no signature to lower, so uncalled
    // generics leave no IR while called ones instantiate at their call site.
    decl = root.left;
    while (decl != null) {
        if (decl.kind == ast_fun_decl() && decl.int_val != 2) {
            // FG1/MM2: a free generic over a generic struct or over bare
            // parameters is a template, registered for on-demand per-call
            // instantiation like a generic method (MC1). A `$struct`-seeded
            // return-only generic registers the same way. The `hash_word`
            // leaf is bodiless and lowers per concrete call instead
            // (ADR 0049), so it registers too and never declares.
            // Anything else declares eager as before.
            if (cg_decl_is_free_over_struct(decl, structs, struct_count) || cg_decl_is_free_bare_generic(decl, structs, struct_count) || cg_decl_is_struct_seeded_generic(decl) || cg_decl_is_hash_word_leaf(decl)) {
                let dup <bool> = false;
                let di <int> = 0;
                while (di < fn_sym_count) {
                    if (fn_syms[di] != null && cg_str_eq(fn_syms[di].name, decl.name)) { dup = true; break; }
                    di = di + 1;
                }
                if (!dup && fn_sym_count < 8180) {
                    let tsym <&FnSymbol> = new FnSymbol{};
                    tsym.name = decl.name;
                    tsym.fn_val = null;
                    tsym.fn_ty = null;
                    tsym.tmpl = decl;
                    tsym.tmpl_done = false;
                    fn_syms[fn_sym_count] = tsym;
                    fn_sym_count = fn_sym_count + 1;
                }
            } else {
                fn_sym_count = declare_function(module, decl, fn_syms, fn_sym_count, interfaces, interface_count);
            }
        } else if (decl.kind == ast_struct_decl()) {
            let m <&AstNode> = decl.extra;
            while (m != null) {
                if (is_generic_method(m)) {
                    let dup <bool> = false;
                    let di <int> = 0;
                    while (di < fn_sym_count) {
                        if (fn_syms[di] != null && cg_str_eq(fn_syms[di].name, m.name)) { dup = true; break; }
                        di = di + 1;
                    }
                    if (!dup && fn_sym_count < 8180) {
                        let tsym <&FnSymbol> = new FnSymbol{};
                        tsym.name = m.name;
                        tsym.fn_val = null;
                        tsym.fn_ty = null;
                        tsym.tmpl = m;
                        tsym.tmpl_done = false;
                        fn_syms[fn_sym_count] = tsym;
                        fn_sym_count = fn_sym_count + 1;
                    }
                } else {
                    fn_sym_count = declare_function(module, m, fn_syms, fn_sym_count, interfaces, interface_count);
                }
                m = m.right;
            }
        }
        decl = decl.right;
    }

    // Pass 2: Lower declarations (functions and struct methods).
    // A poisoned function is an explicit compile-time refusal: skip object
    // emission and fail so the driver exits 1 instead of linking a stub.
    //
    // Wave-5 slice 2: the `destructor` claimant's generation lowers first,
    // once, as the shared no-receiver function `__fin_dtor_claim`, so every
    // scope exit and delete below can call it. An empty claim supplies
    // nothing (composition still runs); only a well-formed claim reaches
    // here, so anything else is no generation, never guessed IR.
    //
    // Wave-5 slice 3: the `deallocate` claimant's generation lowers next,
    // once, as the shared no-receiver function `__fin_dealloc_claim`, so
    // every delete below can call it instead of `free`. An empty claim
    // supplies nothing (the default `free` stays).
    let dtor_claim <&AstNode> = cg_find_dtor_claimant(root);
    let dtor_refused <[int]> = new [int, 1]{};
    dtor_refused[0] = 0;
    let dtor_gen <&AstNode> = cg_claim_quote_block_threaded(dtor_claim, root, "destructor", dtor_refused);
    let claim_refused <bool> = lower_dtor_claim(module, builder, dtor_gen, fn_syms, fn_sym_count, structs, struct_count, enums, enum_count, interfaces, interface_count, move_claim, src_file);
    if (dtor_refused[0] != 0) { claim_refused = true; }
    delete dtor_refused;
    let dealloc_claim <&AstNode> = cg_find_dealloc_claimant(root);
    let dealloc_refused <[int]> = new [int, 1]{};
    dealloc_refused[0] = 0;
    let dealloc_gen <&AstNode> = cg_claim_quote_block_threaded(dealloc_claim, root, "deallocate", dealloc_refused);
    if (dealloc_refused[0] != 0) { claim_refused = true; }
    delete dealloc_refused;
    if (lower_dealloc_claim(module, builder, dealloc_gen, fn_syms, fn_sym_count, structs, struct_count, enums, enum_count, interfaces, interface_count, move_claim, src_file)) {
        claim_refused = true;
    }
    let had_refusal <bool> = claim_refused;
    fn_sym_count = recount_fn_syms(fn_syms, fn_sym_count);
    decl = root.left;
    while (decl != null) {
        if (lower_decl(module, builder, decl, fn_syms, fn_sym_count, structs, struct_count, enums, enum_count, interfaces, interface_count, move_claim, src_file)) {
            had_refusal = true;
        }
        // Bodies being lowered instantiate templates through the shared
        // array (see recount_fn_syms): resynchronise before the next one.
        fn_sym_count = recount_fn_syms(fn_syms, fn_sym_count);
        decl = decl.right;
    }
    // Drain instantiated-but-unlowered generic methods, to fixpoint: a body
    // drained here may itself have instantiated more. Each pass lowers at
    // least one new body, so the loop ends with the templates.
    let draining <bool> = true;
    while (draining) {
        draining = false;
        fn_sym_count = recount_fn_syms(fn_syms, fn_sym_count);
        let si3 <int> = 0;
        while (si3 < fn_sym_count) {
            let s <&FnSymbol> = fn_syms[si3];
            if (s != null && s.tmpl != null && !s.tmpl_done && s.fn_val != null) {
                s.tmpl_done = true;
                draining = true;
                if (lower_fun_decl(module, builder, s.tmpl, fn_syms, fn_sym_count, structs, struct_count, enums, enum_count, interfaces, interface_count, move_claim, src_file)) {
                    had_refusal = true;
                }
            }
            si3 = si3 + 1;
        }
    }

    let ok <bool> = false;
    if (!had_refusal) {
        ok = emit_module_to_object(module, output_path, opt_level);
        if (!ok) {
            // Object emission failed with no lowering refusal above: name
            // the input and the artifact instead of failing bare. On a host
            // whose LLVM build carries no matching target (the linux-arm64
            // bootstrap: only the X86 target is initialized) this is the
            // only diagnostic the failure produces.
            cg_dprintf(2, "finc codegen refusal: emitting LLVM for '%s' to object file '%s' failed (no target for this host?)\n", src_file, output_path);
        }
    }
    llvm_dispose_builder(builder);
    llvm_dispose_module(module);

    let si <int> = 0;
    while (si < struct_count) {
        if (structs[si] != null) {
            let fi <int> = 0;
            while (fi < structs[si].field_count) {
                if (structs[si].fields[fi] != null) {
                    delete structs[si].fields[fi];
                }
                fi = fi + 1;
            }
            delete structs[si].fields;
            delete structs[si];
        }
        si = si + 1;
    }
    delete structs;

    let ei <int> = 0;
    while (ei < enum_count) {
        if (enums[ei] != null) {
            let mi2 <int> = 0;
            while (mi2 < enums[ei].member_count) {
                if (enums[ei].members[mi2] != null) {
                    delete enums[ei].members[mi2];
                }
                mi2 = mi2 + 1;
            }
            delete enums[ei].members;
            delete enums[ei];
        }
        ei = ei + 1;
    }
    delete enums;

    let ii <int> = 0;
    while (ii < interface_count) {
        if (interfaces[ii] != null) {
            let mii <int> = 0;
            while (mii < interfaces[ii].method_count) {
                if (interfaces[ii].methods[mii] != null) {
                    delete interfaces[ii].methods[mii];
                }
                mii = mii + 1;
            }
            delete interfaces[ii].methods;
            delete interfaces[ii];
        }
        ii = ii + 1;
    }
    delete interfaces;

    let fi2 <int> = 0;
    while (fi2 < fn_sym_count) {
        if (fn_syms[fi2] != null) {
            delete fn_syms[fi2];
        }
        fi2 = fi2 + 1;
    }
    delete fn_syms;

    return ok;
}

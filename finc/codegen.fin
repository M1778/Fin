// finc/codegen.fin: Pure LLVM IR lowering and code generator for Fin self-hosting compiler.
// Conforms to ADR 0002 and ADR 0043: Refuses C generation; lowers exclusively to LLVM IR.

import {
    AstNode,
      ast_program, ast_fun_decl, ast_struct_decl, ast_var_decl, ast_param,
      ast_block, ast_if_stmt, ast_while_stmt, ast_for_stmt, ast_return_stmt, ast_blame_stmt,
      ast_expr_stmt, ast_break_stmt, ast_continue_stmt,
      ast_binary_expr, ast_unary_expr, ast_call_expr,
      ast_index_expr, ast_member_access,
      ast_ident, ast_literal_int, ast_literal_string, ast_literal_bool,
      ast_enum_decl, ast_interface_decl, ast_prototype_literal, ast_quote_expr
} from ast::std;

import {
    LLVMModule, LLVMBuilder, LLVMValue, LLVMType, LLVMBasicBlock,
      LLVMTarget, LLVMTargetMachine, LLVMTargetSlot, LLVMErrSlot,
      LLVMTypeArgs, LLVMValueArgs, LLVMIndices, LLVMBlockArgs,
      LLVMContext,
      llvm_module_create, llvm_dispose_module, llvm_dump_module, llvm_write_bitcode_to_file,
      llvm_get_module_context, llvm_get_global_context,
      llvm_struct_create_named, llvm_struct_set_body, llvm_struct_type, llvm_array_type, llvm_array_type2,
      llvm_add_global, llvm_get_named_global, llvm_set_initializer, llvm_set_global_constant,
      llvm_const_array, llvm_const_pointer_null, llvm_const_bitcast, llvm_const_int_to_ptr,
      llvm_count_struct_element_types, llvm_struct_get_type_at_index,
      llvm_i32_type, llvm_i64_type, llvm_i8_type, llvm_i1_type, llvm_i16_type, llvm_void_type, llvm_pointer_type,
      llvm_float_type, llvm_double_type, llvm_const_real_of_string,
      llvm_build_fadd, llvm_build_fsub, llvm_build_fmul, llvm_build_fdiv, llvm_build_frem,
      llvm_build_fneg, llvm_build_fcmp,
      llvm_build_si_to_fp, llvm_build_fp_to_si, llvm_build_fp_ext, llvm_build_fp_trunc,
      llvm_size_of,
      llvm_function_type, llvm_add_function, llvm_get_named_function, llvm_append_basic_block,
      llvm_get_param, llvm_create_builder, llvm_dispose_builder, llvm_position_builder,
      llvm_get_insert_block, llvm_get_basic_block_terminator,
      llvm_const_int, llvm_const_string, llvm_const_null, llvm_get_undef, llvm_build_global_string_ptr,
      llvm_const_int_of_string,
      llvm_build_ret, llvm_build_ret_void,
      llvm_build_add, llvm_build_sub, llvm_build_mul, llvm_build_sdiv, llvm_build_srem,
      llvm_build_udiv, llvm_build_urem,
      llvm_build_and, llvm_build_or, llvm_build_xor, llvm_build_not, llvm_build_neg,
      llvm_build_shl, llvm_build_ashr, llvm_build_lshr,
      llvm_build_icmp, llvm_build_alloca, llvm_build_load2, llvm_build_store,
      llvm_build_br, llvm_build_cond_br, llvm_build_unreachable, llvm_build_call2,
      llvm_build_phi, llvm_add_incoming, llvm_build_select,
      llvm_build_gep2, llvm_build_struct_gep2,
      llvm_build_sext, llvm_build_zext,
      llvm_build_malloc, llvm_build_array_malloc, llvm_build_free, llvm_build_trunc, llvm_build_bitcast,
      llvm_build_switch, llvm_add_case,
      llvm_build_extract_value, llvm_build_insert_value,
      llvm_build_is_null, llvm_build_is_not_null,
      llvm_int_eq, llvm_int_ne, llvm_int_ugt, llvm_int_uge, llvm_int_ult, llvm_int_ule,
      llvm_int_sgt, llvm_int_sge, llvm_int_slt, llvm_int_sle,
      llvm_real_oeq, llvm_real_one, llvm_real_ogt, llvm_real_oge, llvm_real_olt, llvm_real_ole,
      llvm_global_get_value_type, llvm_type_of,
      init_native_target, emit_module_to_object, llvm_verify_module, llvm_verify_function,
      llvm_get_return_type, llvm_get_param_types, llvm_build_ptr_to_int, llvm_build_int_to_ptr
} from finc.llvm;

import { substr } from strings::std;
import { Buffer, new_buffer, free_buffer } from buffer::std;

#[llvm_name="strcmp"]
@define cg_strcmp(a: string, b: string) <int>;

#[llvm_name="strlen"]
@define cg_raw_strlen(s: string) <ulong>;

#[llvm_name="dprintf"]
@define cg_dprintf(fd: int, fmt: string, ...) <int>;

#[llvm_name="exit"]
@define cg_exit(code: int) <noret>;

priv fun cg_strlen(s: string) <ulong> {
    if (s == null) { return cast<ulong>(0); }
    return cg_raw_strlen(s);
}

priv fun cg_str_eq(a: string, b: string) <bool> {
    if (a == null && b == null) { return true; }
    if (a == null || b == null) { return false; }
    return cg_strcmp(a, b) == 0;
}

// ENGA slice 3: the annotation for a constructor gate, preferring the
// checker's resolved spelling where recorded (`Collection<A>` with
// `type A = Data` gates on `Collection<Data>`), mirroring C++ use-site
// operator checks on the instantiation.
fun cg_ctor_ann(n: &AstNode) <string> {
    if (n != null && n.resolved_spelling != null && cg_strlen(n.resolved_spelling) > cast<ulong>(0)) {
        return n.resolved_spelling;
    }
    if (n == null || n.type_annotation == null) { return ""; }
    return n.type_annotation;
}

// The link symbol for an extern `@define`: `llvm_name="sym"` read out of
// the declaration's attribute text (which may `;`-join several attributes).
// Anything that is not an `llvm_name` is not a symbol: attribute text is a
// demand, not a name, so it never becomes one here.
priv fun cg_extern_sym(fn_name: string, attr: string) <string> {
    if (attr == null || cg_strlen(attr) == cast<ulong>(0)) { return fn_name; }
    let alen <int> = cast<int>(cg_strlen(attr));
    let si <int> = 0;
    while (si < alen) {
        if (cg_str_eq(substr(attr, si, 11), "llvm_name=\"")) {
            let start <int> = si + 11;
            let ei <int> = start;
            while (ei < alen && !cg_str_eq(substr(attr, ei, 1), "\"")) {
                ei = ei + 1;
            }
            if (ei > start) {
                return substr(attr, start, ei - start);
            }
            return fn_name;
        }
        si = si + 1;
    }
    return fn_name;
}

pub struct LocalVar {
    pub:
      name <string> = "",
      val <&LLVMValue> = null,
      ty <&LLVMType> = null,
      type_annotation <string> = "",
      len_val <&LLVMValue> = null,
      elem_ty <&LLVMType> = null,
      // Prototype-half provenance: this `[T]` binding was initialized from
      // `prtp.0`/`prtp.1`, whose buffer strides by i64 words (the prototype
      // writer coerces every entry to i64) rather than by the static element
      // type. Index and length paths read it accordingly; the declaration
      // site also fills len_val from the header count.
      is_proto_half <bool> = false,
      scope_depth <int> = 0,
      destroyed <bool> = false,
      // Wave-5 slice 1: moved-from on some path (union). Read only by the
      // scope-cleanup skip, and only when a `move_or_copy` claimant gates.
      moved <bool> = false,
      // Wave-5 slice 4: how this binding's storage lifetime ends. 0 is the
      // ordinary scope-exit destruction. 1 (`#[slaveof($Fin)]`, or tied to
      // a global, which outlives every frame) is never destroyed at scope
      // exit. 2 (`#[slaveof(z)]` to a strictly outer `z`) is destroyed
      // when the master's scope exits instead of its own; a same-scope tie
      // dies with its own scope anyway and stays 0. tie_master is the
      // block-start var index holding the master (2 only); tie_region the
      // control-flow region declared in.
      tie_kind <int> = 0,
      tie_master <int> = 0,
      tie_region <int> = 0,
      fn_ty <&LLVMType> = null,
}

pub struct FnSymbol {
    pub:
      name <string> = "",
      fn_val <&LLVMValue> = null,
      fn_ty <&LLVMType> = null,
      // Lazy generic-method template (LM1): the uninstantiated method AST.
      // Null for ordinary symbols. A template declares no LLVM function
      // until a call site instantiates it, so uncalled generic methods
      // leave no IR -- mirroring the C++ backend, which declares nothing
      // for a generic method until a call says what its parameters are.
      tmpl <&AstNode> = null,
      // Set once the template's body has been drained into the module.
      tmpl_done <bool> = false,
      // PT1 tripwire: the body compares a generic-typed value with `==`
      // (`has_gen_eq`) or `!=` (`has_gen_ne`). Set at declaration from the
      // AST (eager methods) or lazily from `tmpl` at the call site
      // (templates); read by cg_check_generic_call.
      has_gen_eq <bool> = false,
      has_gen_ne <bool> = false,
      // PT1 slice 2 registry: entries named `mix:<method>` record the
      // first-seen receiver argument spelling for that method
      // (`mix:Box_get` -> `int`). A second distinct spelling refuses: one
      // erased body cannot serve two. Homed in the shared symbol array so
      // no lowering signature changes; freed with the rest.
      mix_arg <string> = "",
}

pub struct StructFieldInfo {
    pub:
      name <string> = "",
      index <int> = 0,
      type_annotation <string> = "",
      // The field's declared default (`health <uint> = 100` keeps the
      // `100`): struct literals that omit the field evaluate it after the
      // written values (C++ buildStructValue's defaults loop). Null when
      // the declaration gives none. Kept like StructInfo.method_head,
      // where the AST is still at hand.
      default_init <&AstNode> = null,
}

pub struct StructInfo {
    pub:
      name <string> = "",
      fields <[&StructFieldInfo]>,
      field_count <int> = 0,
      has_destructor <bool> = false,
      destructor_name <string> = "",
      // PT1 tripwire: the struct declares `operator ==` / `!=` (member
      // names carry `operator`, e.g. `MyInt_operator==`). A generic `==`
      // instantiated at an argument naming a struct without one refuses,
      // mirroring C++ `an undeclared operator '==' on struct 'Data'`.
      has_eq <bool> = false,
      has_ne <bool> = false,
      // PT1 slice 3: instantiation knowledge for the constructor gate. The
      // declared parameter order plus which parameters a method body
      // compares with `==` / `!=` (comma-joined names, "" when none).
      // Recorded in pass 1 where the method ASTs are in hand.
      gen_params <string> = "",
      gen_eq_use <string> = "",
      gen_ne_use <string> = "",
      // MC1 (b): the struct's method declarations (decl.extra chain head),
      // recorded in pass 1 where the ASTs are in hand. The call-site cache
      // clones the matching template per instantiation key; the chain itself
      // is never mutated.
      method_head <&AstNode> = null,
}

pub struct EnumMemberInfo {
    pub:
      name <string> = "",
      tag <int> = 0,
      has_payload <bool> = false,
      payload_type <string> = "",
      payload_size <int> = 0,
}

pub struct EnumInfo {
    pub:
      name <string> = "",
      has_payload <bool> = false,
      llvm_type <&LLVMType> = null,
      members <[&EnumMemberInfo]>,
      member_count <int> = 0,
      max_payload_size <int> = 0,
      // ENGA slice 2: declared generic parameters (`T` for `Res<T>`, "" when
      // none). Mirrors StructInfo.gen_params; instances set it to "".
      gen_params <string> = "",
}

pub struct InterfaceMethodInfo {
    pub:
      name <string> = "",
      index <int> = 0,
      ret_type <string> = "",
      param_count <int> = 0,
      is_field <bool> = false,
}

pub struct InterfaceInfo {
    pub:
      name <string> = "",
      methods <[&InterfaceMethodInfo]>,
      method_count <int> = 0,
      fat_ptr_ty <&LLVMType> = null,
}

pub struct FnContext {
    pub:
      vars <[&LocalVar]>,
      var_count <int> = 0,
      fn_syms <[&FnSymbol]>,
      fn_sym_count <int> = 0,
      fn_val <&LLVMValue> = null,
      builder <&LLVMBuilder> = null,
      module <&LLVMModule> = null,
      i32_ty <&LLVMType> = null,
      i64_ty <&LLVMType> = null,
      i1_ty <&LLVMType> = null,
      i8_ty <&LLVMType> = null,
      i16_ty <&LLVMType> = null,
      float_ty <&LLVMType> = null,
      double_ty <&LLVMType> = null,
      ptr_ty <&LLVMType> = null,
      void_ty <&LLVMType> = null,
      fat_ptr_ty <&LLVMType> = null,
      // The path the program was read from, as invoked (driver filename).
      // Blame and denullify reports print it; empty keeps the bare abort
      // rather than printing a guessed path.
      src_file <string> = "",
      break_bb <&LLVMBasicBlock> = null,
      continue_bb <&LLVMBasicBlock> = null,
      structs <[&StructInfo]>,
      struct_count <int> = 0,
      enums <[&EnumInfo]>,
      enum_count <int> = 0,
      interfaces <[&InterfaceInfo]>,
      interface_count <int> = 0,
      current_scope_depth <int> = 0,
      ret_iface <&InterfaceInfo> = null,
      poisoned <bool> = false,
      // Wave-5 slice 1: the program holds a `move_or_copy` claimant, so
      // scope cleanups skip moved-from bindings. False keeps every value
      // destroying independently, byte-identical to before.
      has_move_claim <bool> = false,
      // Wave-5 slice 4: how deep inside loop bodies and branch arms the
      // emission point is. A `#[slaveof]` deferral moves a destruction to
      // the master's scope exit, sound only when the declaration's block
      // dominates that point -- true for straight-line nesting, false
      // across a loop back-edge or a branch join. Each local records the
      // region it was declared in (LocalVar.tie_region); a tie across
      // regions is refused rather than lowered into invalid IR.
      region_depth <int> = 0,
      // Wave-5 slice 4: struct-typed Deferred bindings waiting for their
      // master's scope exit (parallel arrays: var index, moved-from
      // captured at deferral so the slice-1 skip engages at the extended
      // point and deferral never resurrects). Compiler-side scratch: they
      // emit no IR, so the untied path lowers exactly as before.
      tied_idx <[int]>,
      tied_moved <[int]>,
      tied_count <int> = 0,
      // Array-literal writer hint, set by struct field contexts and read by
      // `__fin_array_literal` lowering. When true, integer-kind and pointer
      // slots build wide (8 bytes); everything else builds as before. Off
      // by default, so every other literal builds exactly as before.
      arr_hint_auto <bool> = false,
      // Current function's own `<...>` text ("" when none, or when str_val
      // carries an attribute/operator payload). Set in lower_fun_decl where
      // the AST is in hand; read by generic-name consults during lowering.
      // Empty keeps every non-generic body exactly as before.
      cur_gen <string> = "",
      // Expected result spelling for the call under lowering (`&Vec2<float>`
      // for `let v <&Vec2<float>> = Vec2::zero()`). Set by `let` lowering
      // around its initializer, restored after; read only by the static
      // cache for Self-returning statics no argument binds. Empty
      // everywhere else, so every other call lowers exactly as before.
      call_want <string> = "",
}

fun fn_ctx_add_var(ctx: &FnContext, name: string, val: &LLVMValue, ty: &LLVMType, type_ann: string) <noret> {
    if (ctx.var_count < 1020) {
        let v <&LocalVar> = new LocalVar{};
        v.name = name;
        v.val = val;
        v.ty = ty;
        v.type_annotation = type_ann;
        v.len_val = null;
        v.elem_ty = null;
        v.is_proto_half = false;
        ctx.vars[ctx.var_count] = v;
        ctx.var_count = ctx.var_count + 1;
    } else {
        // More locals than the FnContext carrier holds (1020): refuse
        // instead of dropping the binding silently. A dropped binding
        // miscompiles (reads resolve to null) or crashes the compiler,
        // depending on the initializer shape; every loop checks the flag.
        cg_dprintf(2, "finc codegen refusal: too many locals in one function (at most 1020 lowered; '%s' does not fit)\n", name);
        refuse_and_poison(ctx);
    }
}

// Pop a block/`for` scope: bindings declared inside are dropped, so
// later lookups resolve outer bindings again. Struct-typed entries with
// deferred `#[slaveof]` destruction (pending in the tied list) survive:
// they compact down and their tied indices remap, so the function-exit
// drain still finds them.
fun cg_tied_find(ctx: &FnContext, vi: int) <int> {
    let k <int> = 0;
    while (k < ctx.tied_count) {
        if (ctx.tied_idx[k] == vi) { return k; }
        k = k + 1;
    }
    return -1;
}

fun pop_scope_vars(ctx: &FnContext, from_idx: int) <noret> {
    if (ctx == null) { return; }
    if (from_idx >= ctx.var_count) { return; }
    let write <int> = from_idx;
    let i <int> = from_idx;
    while (i < ctx.var_count) {
        let v <&LocalVar> = ctx.vars[i];
        if (v != null) {
            let k <int> = cg_tied_find(ctx, i);
            if (k >= 0) {
                if (write != i) {
                    ctx.vars[write] = v;
                    ctx.tied_idx[k] = write;
                }
                write = write + 1;
            }
        }
        i = i + 1;
    }
    ctx.var_count = write;
}

fun to_condition_i1(ctx: &FnContext, val: &LLVMValue) <&LLVMValue> {
    if (val == null) { return null; }
    let ty <&LLVMType> = llvm_type_of(val);
    if (ty == ctx.i1_ty) {
        return val;
    }
    if (ty == ctx.i32_ty) {
        let zero <&LLVMValue> = llvm_const_int(ctx.i32_ty, 0, 0);
        return llvm_build_icmp(ctx.builder, llvm_int_ne(), val, zero, "tobool");
    }
    if (ty == ctx.i64_ty) {
        let zero64 <&LLVMValue> = llvm_const_int(ctx.i64_ty, 0, 0);
        return llvm_build_icmp(ctx.builder, llvm_int_ne(), val, zero64, "tobool");
    }
    if (ty == ctx.i16_ty) {
        let zero16 <&LLVMValue> = llvm_const_int(ctx.i16_ty, 0, 0);
        return llvm_build_icmp(ctx.builder, llvm_int_ne(), val, zero16, "tobool");
    }
    if (ty == ctx.float_ty || ty == ctx.double_ty) {
        let zero_r <&LLVMValue> = llvm_const_real_of_string(ty, "0.0");
        return llvm_build_fcmp(ctx.builder, llvm_real_one(), val, zero_r, "tobool");
    }
    if (ty == ctx.ptr_ty) {
        let null_val <&LLVMValue> = llvm_const_null(ctx.ptr_ty);
        return llvm_build_icmp(ctx.builder, llvm_int_ne(), val, null_val, "tobool");
    }
    return val;
}

fun coerce_val(ctx: &FnContext, val: &LLVMValue, target_ty: &LLVMType) <&LLVMValue> {
    if (val == null || target_ty == null) { return val; }
    let v_ty <&LLVMType> = llvm_type_of(val);
    if (v_ty == target_ty) { return val; }

    if (target_ty == ctx.ptr_ty) {
        if (v_ty == ctx.i32_ty) {
            let z64 <&LLVMValue> = llvm_build_zext(ctx.builder, val, ctx.i64_ty, "z64");
            return llvm_build_int_to_ptr(ctx.builder, z64, ctx.ptr_ty, "i2p");
        }
        if (v_ty == ctx.i64_ty) {
            return llvm_build_int_to_ptr(ctx.builder, val, ctx.ptr_ty, "i2p");
        }
        // Narrow words widen through i64 on the way to a pointer slot
        // (a `bool` pushed into a generic `Collection<T>`): without this
        // the call keeps its i1 against a ptr parameter, which LLVM
        // rejects instead of running. A float reaches a pointer slot
        // with its bits preserved (`cast<T>` of a float in an erased
        // body, where `T` is the representative): the bits are what an
        // instantiation reads back, so truncation would corrupt every
        // float instantiation flowing through erasure.
        if (v_ty == ctx.i1_ty || v_ty == ctx.i8_ty) {
            let w64 <&LLVMValue> = llvm_build_zext(ctx.builder, val, ctx.i64_ty, "w64");
            return llvm_build_int_to_ptr(ctx.builder, w64, ctx.ptr_ty, "i2p");
        }
        if (v_ty == ctx.float_ty) {
            let f32 <&LLVMValue> = llvm_build_bitcast(ctx.builder, val, ctx.i32_ty, "f2i");
            let f64 <&LLVMValue> = llvm_build_zext(ctx.builder, f32, ctx.i64_ty, "f2i64");
            return llvm_build_int_to_ptr(ctx.builder, f64, ctx.ptr_ty, "i2p");
        }
        if (v_ty == ctx.double_ty) {
            let d64 <&LLVMValue> = llvm_build_bitcast(ctx.builder, val, ctx.i64_ty, "d2i");
            return llvm_build_int_to_ptr(ctx.builder, d64, ctx.ptr_ty, "i2p");
        }
        return val;
    }

    if (v_ty == ctx.ptr_ty) {
        if (target_ty == ctx.i64_ty) {
            return llvm_build_ptr_to_int(ctx.builder, val, ctx.i64_ty, "p2i");
        }
        if (target_ty == ctx.i32_ty) {
            let p64 <&LLVMValue> = llvm_build_ptr_to_int(ctx.builder, val, ctx.i64_ty, "p2i");
            return llvm_build_trunc(ctx.builder, p64, ctx.i32_ty, "tr32");
        }
        if (target_ty == ctx.i1_ty) {
            return to_condition_i1(ctx, val);
        }
        // A representative-carried value read as a narrow word or a
        // float (`cast<float>` of a `T` in an erased body): narrow words
        // convert through the integer value; floats reinterpret the
        // carried bits, mirroring the float arm above.
        if (target_ty == ctx.i8_ty) {
            let q64 <&LLVMValue> = llvm_build_ptr_to_int(ctx.builder, val, ctx.i64_ty, "p2i");
            return llvm_build_trunc(ctx.builder, q64, ctx.i8_ty, "tr8");
        }
        if (target_ty == ctx.float_ty) {
            let t64 <&LLVMValue> = llvm_build_ptr_to_int(ctx.builder, val, ctx.i64_ty, "p2i");
            let t32 <&LLVMValue> = llvm_build_trunc(ctx.builder, t64, ctx.i32_ty, "tr32");
            return llvm_build_bitcast(ctx.builder, t32, ctx.float_ty, "i2f");
        }
        if (target_ty == ctx.double_ty) {
            let u64 <&LLVMValue> = llvm_build_ptr_to_int(ctx.builder, val, ctx.i64_ty, "p2i");
            return llvm_build_bitcast(ctx.builder, u64, ctx.double_ty, "i2d");
        }
        return val;
    }

    if (target_ty == ctx.i1_ty) {
        return to_condition_i1(ctx, val);
    }
    if (target_ty == ctx.i8_ty) {
        if (v_ty == ctx.i32_ty || v_ty == ctx.i64_ty) {
            return llvm_build_trunc(ctx.builder, val, ctx.i8_ty, "tr8");
        }
        if (v_ty == ctx.float_ty || v_ty == ctx.double_ty) {
            let i32_v <&LLVMValue> = llvm_build_fp_to_si(ctx.builder, val, ctx.i32_ty, "fp2si");
            return llvm_build_trunc(ctx.builder, i32_v, ctx.i8_ty, "tr8");
        }
        return val;
    }
    if (target_ty == ctx.i16_ty) {
        if (v_ty == ctx.i32_ty || v_ty == ctx.i64_ty) {
            return llvm_build_trunc(ctx.builder, val, ctx.i16_ty, "tr16");
        }
        if (v_ty == ctx.i8_ty || v_ty == ctx.i1_ty) {
            return llvm_build_zext(ctx.builder, val, ctx.i16_ty, "z16");
        }
        if (v_ty == ctx.float_ty || v_ty == ctx.double_ty) {
            let i32_w <&LLVMValue> = llvm_build_fp_to_si(ctx.builder, val, ctx.i32_ty, "fp2si");
            return llvm_build_trunc(ctx.builder, i32_w, ctx.i16_ty, "tr16");
        }
        return val;
    }
    if (target_ty == ctx.i32_ty) {
        if (v_ty == ctx.i64_ty) {
            return llvm_build_trunc(ctx.builder, val, ctx.i32_ty, "tr32");
        }
        if (v_ty == ctx.i8_ty || v_ty == ctx.i1_ty || v_ty == ctx.i16_ty) {
            return llvm_build_zext(ctx.builder, val, ctx.i32_ty, "z32");
        }
        return val;
    }
    if (target_ty == ctx.i64_ty) {
        if (v_ty == ctx.i32_ty || v_ty == ctx.i8_ty || v_ty == ctx.i1_ty || v_ty == ctx.i16_ty) {
            return llvm_build_zext(ctx.builder, val, ctx.i64_ty, "z64");
        }
        if (v_ty == ctx.float_ty || v_ty == ctx.double_ty) {
            return llvm_build_fp_to_si(ctx.builder, val, ctx.i64_ty, "fp2si");
        }
        return val;
    }
    if (target_ty == ctx.float_ty || target_ty == ctx.double_ty) {
        if (v_ty == ctx.i32_ty || v_ty == ctx.i64_ty || v_ty == ctx.i8_ty || v_ty == ctx.i1_ty) {
            return llvm_build_si_to_fp(ctx.builder, val, target_ty, "si2fp");
        }
        if (v_ty == ctx.float_ty && target_ty == ctx.double_ty) {
            return llvm_build_fp_ext(ctx.builder, val, target_ty, "fext");
        }
        if (v_ty == ctx.double_ty && target_ty == ctx.float_ty) {
            return llvm_build_fp_trunc(ctx.builder, val, target_ty, "ftrunc");
        }
        return val;
    }
    if (target_ty == ctx.i32_ty) {
        if (v_ty == ctx.i64_ty) {
            return llvm_build_trunc(ctx.builder, val, ctx.i32_ty, "tr32");
        }
        if (v_ty == ctx.i8_ty || v_ty == ctx.i1_ty) {
            return llvm_build_zext(ctx.builder, val, ctx.i32_ty, "z32");
        }
        if (v_ty == ctx.float_ty || v_ty == ctx.double_ty) {
            return llvm_build_fp_to_si(ctx.builder, val, ctx.i32_ty, "fp2si");
        }
        return val;
    }
    return val;
}

// The phi type for a `cond : then ? else` join (C++ commonType on LLVM
// types): a float on either side wins (double over float), a bool arm
// takes the other arm's type, otherwise the wider integer wins.
// Anything else (pointers, mismatched kinds) answers null and the
// caller refuses honestly instead of joining unjoinable values.
fun cg_tern_common(ctx: &FnContext, a: &LLVMValue, b: &LLVMValue) <&LLVMType> {
    if (a == null || b == null) { return null; }
    let ta <&LLVMType> = llvm_type_of(a);
    let tb <&LLVMType> = llvm_type_of(b);
    if (ta == tb) { return ta; }
    let a_fp <bool> = ta == ctx.float_ty || ta == ctx.double_ty;
    let b_fp <bool> = tb == ctx.float_ty || tb == ctx.double_ty;
    if (a_fp || b_fp) {
        if (a_fp && b_fp) {
            if (ta == ctx.double_ty || tb == ctx.double_ty) { return ctx.double_ty; }
            return ctx.float_ty;
        }
        if (a_fp) { return ta; }
        return tb;
    }
    if (ta == ctx.i1_ty) { return tb; }
    if (tb == ctx.i1_ty) { return ta; }
    let a_int <bool> = ta == ctx.i64_ty || ta == ctx.i32_ty || ta == ctx.i16_ty || ta == ctx.i8_ty;
    let b_int <bool> = tb == ctx.i64_ty || tb == ctx.i32_ty || tb == ctx.i16_ty || tb == ctx.i8_ty;
    if (a_int && b_int) {
        if (ta == ctx.i64_ty || tb == ctx.i64_ty) { return ctx.i64_ty; }
        if (ta == ctx.i32_ty || tb == ctx.i32_ty) { return ctx.i32_ty; }
        if (ta == ctx.i16_ty || tb == ctx.i16_ty) { return ctx.i16_ty; }
        return ctx.i8_ty;
    }
    return null;
}

fun get_node_struct_name(ctx: &FnContext, node: &AstNode) <string> {
    if (node == null) { return ""; }
    if (node.kind == ast_ident()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, node.name);
        if (v != null && v.type_annotation != null) {
            let t <string> = v.type_annotation;
            let len <int> = cast<int>(cg_strlen(t));
            if (len > 1) {
                let f <string> = substr(t, 0, 1);
                if (cg_str_eq(f, "&") || cg_str_eq(f, "*")) {
                    t = substr(t, 1, len - 1);
                    len = len - 1;
                }
                let last <string> = substr(t, len - 1, 1);
                if (cg_str_eq(last, "*")) {
                    t = substr(t, 0, len - 1);
                    len = len - 1;
                }
            }
            let ci <int> = 0;
            while (ci < len) {
                if (cg_str_eq(substr(t, ci, 1), "<")) {
                    t = substr(t, 0, ci);
                    break;
                }
                ci = ci + 1;
            }
            if (cg_str_eq(t, "Self")) {
                let v_s <&LocalVar> = fn_ctx_find_var(ctx, "self");
                if (v_s != null && v_s.type_annotation != null) {
                    let s_ann <string> = v_s.type_annotation;
                    let slen <int> = cast<int>(cg_strlen(s_ann));
                    if (slen > 1 && (cg_str_eq(substr(s_ann, 0, 1), "&") || cg_str_eq(substr(s_ann, 0, 1), "*"))) {
                        s_ann = substr(s_ann, 1, slen - 1);
                        slen = slen - 1;
                    }
                    let sci <int> = 0;
                    while (sci < slen) {
                        if (cg_str_eq(substr(s_ann, sci, 1), "<")) {
                            s_ann = substr(s_ann, 0, sci);
                            break;
                        }
                        sci = sci + 1;
                    }
                    return s_ann;
                }
            }
            return t;
        }
    } else if (node.kind == ast_member_access()) {
        let f_name <string> = node.name;
        let si <int> = 0;
        while (si < ctx.struct_count) {
            let st <&StructInfo> = ctx.structs[si];
            if (st != null) {
                let fi <int> = 0;
                while (fi < st.field_count) {
                    let f <&StructFieldInfo> = st.fields[fi];
                    if (f != null && cg_str_eq(f.name, f_name)) {
                        let t <string> = f.type_annotation;
                        let len <int> = cast<int>(cg_strlen(t));
                        if (len > 1) {
                            let fst <string> = substr(t, 0, 1);
                            if (cg_str_eq(fst, "&") || cg_str_eq(fst, "*")) {
                                return substr(t, 1, len - 1);
                            }
                            let lst <string> = substr(t, len - 1, 1);
                            if (cg_str_eq(lst, "*")) {
                                return substr(t, 0, len - 1);
                            }
                        }
                        return t;
                    }
                    fi = fi + 1;
                }
            }
            si = si + 1;
        }
    } else if (node.kind == ast_call_expr()) {
        // A member read on a call result (`lookup(b).kind`): the base
        // struct is the callee's return, never the callee. Prefer the
        // checker's resolved spelling (generic instantiations record it),
        // else the declared return of the resolved method. "" when
        // neither answers: callers keep their old path, never a guess.
        if (node.resolved_spelling != null && cg_strlen(node.resolved_spelling) > cast<ulong>(0)) {
            let cb_rs <string> = cg_trim_spaces(node.resolved_spelling);
            let cb_rlen <int> = cast<int>(cg_strlen(cb_rs));
            if (cb_rlen > 1 && (cg_str_eq(substr(cb_rs, 0, 1), "&") || cg_str_eq(substr(cb_rs, 0, 1), "*"))) {
                cb_rs = substr(cb_rs, 1, cb_rlen - 1);
                cb_rlen = cb_rlen - 1;
            }
            if (cb_rlen > 1 && cg_str_eq(substr(cb_rs, cb_rlen - 1, 1), "*")) {
                cb_rs = substr(cb_rs, 0, cb_rlen - 1);
                cb_rlen = cb_rlen - 1;
            }
            let cb_ri <int> = 0;
            while (cb_ri < cb_rlen) {
                if (cg_str_eq(substr(cb_rs, cb_ri, 1), "<")) {
                    cb_rs = substr(cb_rs, 0, cb_ri);
                    break;
                }
                cb_ri = cb_ri + 1;
            }
            return cg_trim_spaces(cb_rs);
        }
        let cb_want_base <string> = "";
        let cb_want_short <string> = "";
        if (node.name != null && cg_strlen(node.name) > cast<ulong>(0)) {
            // Flattened `Struct_method` (the checker rewrites method calls):
            // the prefix names the owner, the short names the method.
            let cb_nm <string> = node.name;
            let cb_nlen <int> = cast<int>(cg_strlen(cb_nm));
            let cb_ui <int> = 0;
            while (cb_ui < cb_nlen) {
                if (cg_str_eq(substr(cb_nm, cb_ui, 1), "_")) {
                    let cb_pre <string> = substr(cb_nm, 0, cb_ui);
                    if (cg_strlen(cb_pre) > cast<ulong>(0) && find_struct(ctx, cb_pre) != null) {
                        cb_want_base = cb_pre;
                        cb_want_short = substr(cb_nm, cb_ui + 1, cb_nlen - cb_ui - 1);
                        break;
                    }
                }
                cb_ui = cb_ui + 1;
            }
        }
        if (cg_strlen(cb_want_base) == cast<ulong>(0) && node.left != null) {
            // Dot-call shape (`recv.method(...)`): the receiver's struct
            // owns the method, so its declared return is the base.
            let cb_rec <&AstNode> = node.left.left;
            if (cb_rec == null) { cb_rec = node.left; }
            if (cb_rec != null && cb_rec.kind == ast_unary_expr() && cb_rec.left != null) {
                if (cb_rec.name != null && (cg_str_eq(cb_rec.name, "*") || cg_str_eq(cb_rec.name, "&"))) {
                    cb_rec = cb_rec.left;
                }
            }
            let cb_rst <string> = get_node_struct_name(ctx, cb_rec);
            if (cb_rst != null && cg_strlen(cb_rst) > cast<ulong>(0)) {
                let cb_rb <string> = cg_trim_spaces(cb_rst);
                let cb_rbl <int> = cast<int>(cg_strlen(cb_rb));
                let cb_oi <int> = 0;
                while (cb_oi < cb_rbl) {
                    if (cg_str_eq(substr(cb_rb, cb_oi, 1), "<")) {
                        cb_rb = substr(cb_rb, 0, cb_oi);
                        break;
                    }
                    cb_oi = cb_oi + 1;
                }
                cb_rb = cg_trim_spaces(cb_rb);
                if (cg_strlen(cb_rb) > cast<ulong>(0) && node.name != null && cg_strlen(node.name) > cast<ulong>(0)) {
                    cb_want_base = cb_rb;
                    cb_want_short = node.name;
                    // A flattened `Base_method` name carries its owner:
                    // read the short form so the walk below matches.
                    let cb_bl <int> = cast<int>(cg_strlen(cb_rb));
                    let cb_nl <int> = cast<int>(cg_strlen(node.name));
                    if (cb_nl > cb_bl + 1 && cg_str_eq(substr(node.name, 0, cb_bl), cb_rb) && cg_str_eq(substr(node.name, cb_bl, 1), "_")) {
                        cb_want_short = substr(node.name, cb_bl + 1, cb_nl - cb_bl - 1);
                    }
                }
            }
        }
        if (cg_strlen(cb_want_base) > cast<ulong>(0) && cg_strlen(cb_want_short) > cast<ulong>(0)) {
            // The declared return of the resolved method, read off the
            // recorded method chain where the AST is still at hand.
            let cb_st <&StructInfo> = find_struct(ctx, cb_want_base);
            if (cb_st != null && cb_st.method_head != null) {
                let cb_m <&AstNode> = cb_st.method_head;
                while (cb_m != null) {
                    if (cb_m.kind == ast_fun_decl() && cb_m.name != null) {
                        let cb_hitm <bool> = false;
                        if (cg_str_eq(cb_m.name, cb_want_short)) { cb_hitm = true; }
                        if (cb_hitm == false) {
                            let cb_mnl <int> = cast<int>(cg_strlen(cb_m.name));
                            let cb_bl2 <int> = cast<int>(cg_strlen(cb_want_base));
                            let cb_sl2 <int> = cast<int>(cg_strlen(cb_want_short));
                            if (cb_mnl == cb_bl2 + 1 + cb_sl2 && cg_str_eq(substr(cb_m.name, 0, cb_bl2), cb_want_base)) {
                                let cb_msep <string> = substr(cb_m.name, cb_bl2, 1);
                                if ((cg_str_eq(cb_msep, "_") || cg_str_eq(cb_msep, ".")) && cg_str_eq(substr(cb_m.name, cb_bl2 + 1, cb_sl2), cb_want_short)) {
                                    cb_hitm = true;
                                }
                            }
                        }
                        if (cb_hitm && cb_m.type_annotation != null && cg_strlen(cb_m.type_annotation) > cast<ulong>(0)) {
                            let cb_ret3 <string> = cg_trim_spaces(cb_m.type_annotation);
                            let cb_rl3 <int> = cast<int>(cg_strlen(cb_ret3));
                            if (cb_rl3 > 1 && (cg_str_eq(substr(cb_ret3, 0, 1), "&") || cg_str_eq(substr(cb_ret3, 0, 1), "*"))) {
                                cb_ret3 = substr(cb_ret3, 1, cb_rl3 - 1);
                                cb_rl3 = cb_rl3 - 1;
                            }
                            if (cb_rl3 > 1 && cg_str_eq(substr(cb_ret3, cb_rl3 - 1, 1), "*")) {
                                cb_ret3 = substr(cb_ret3, 0, cb_rl3 - 1);
                                cb_rl3 = cb_rl3 - 1;
                            }
                            cb_ret3 = cg_trim_spaces(cb_ret3);
                            let cb_b3 <string> = cb_ret3;
                            let cb_bi3 <int> = 0;
                            while (cb_bi3 < cb_rl3) {
                                if (cg_str_eq(substr(cb_ret3, cb_bi3, 1), "<")) {
                                    cb_b3 = substr(cb_ret3, 0, cb_bi3);
                                    break;
                                }
                                cb_bi3 = cb_bi3 + 1;
                            }
                            cb_b3 = cg_trim_spaces(cb_b3);
                            if (cg_str_eq(cb_b3, "Self")) { return cb_want_base; }
                            return cb_b3;
                        }
                    }
                    cb_m = cb_m.right;
                }
            }
        }
    } else if (node.kind == ast_index_expr()) {
        let arr_st <string> = get_node_struct_name(ctx, node.left);
        let len <int> = cast<int>(cg_strlen(arr_st));
        if (len > 2) {
            let fst <string> = substr(arr_st, 0, 1);
            let lst <string> = substr(arr_st, len - 1, 1);
            if (cg_str_eq(fst, "[") && cg_str_eq(lst, "]")) {
                return substr(arr_st, 1, len - 2);
            }
        }
        return arr_st;
    }
    return "";
}

fun find_field_index(ctx: &FnContext, base_node: &AstNode, field_name: string) <int> {
    if (field_name == null) { return 0; }

    let s_name <string> = get_node_struct_name(ctx, base_node);
    if (cg_strlen(s_name) > cast<ulong>(0)) {
        let si <int> = 0;
        while (si < ctx.struct_count) {
            let st <&StructInfo> = ctx.structs[si];
            if (st != null && cg_str_eq(st.name, s_name)) {
                let fi <int> = 0;
                while (fi < st.field_count) {
                    let f <&StructFieldInfo> = st.fields[fi];
                    if (f != null && cg_str_eq(f.name, field_name)) {
                        return f.index;
                    }
                    fi = fi + 1;
                }
            }
            si = si + 1;
        }
    }

    let si <int> = 0;
    while (si < ctx.struct_count) {
        let st <&StructInfo> = ctx.structs[si];
        if (st != null) {
            let fi <int> = 0;
            while (fi < st.field_count) {
                let f <&StructFieldInfo> = st.fields[fi];
                if (f != null && cg_str_eq(f.name, field_name)) {
                    return f.index;
                }
                fi = fi + 1;
            }
        }
        si = si + 1;
    }

    if (cg_str_eq(field_name, "y")) { return 1; }
    if (cg_str_eq(field_name, "z")) { return 2; }
    if (cg_str_eq(field_name, "w")) { return 3; }
    return 0;
}

fun fn_ctx_find_var(ctx: &FnContext, name: string) <&LocalVar> {
    // Innermost first (ADR 0011 shadowing): a block-local shadows an
    // outer binding.
    let i <int> = ctx.var_count - 1;
    while (i >= 0) {
        let v <&LocalVar> = ctx.vars[i];
        if (v != null && cg_str_eq(v.name, name)) {
            return v;
        }
        i = i - 1;
    }
    return null;
}

fun fn_ctx_find_fn(ctx: &FnContext, name: string) <&FnSymbol> {
    let i <int> = 0;
    while (i < ctx.fn_sym_count) {
        let sym <&FnSymbol> = ctx.fn_syms[i];
        if (sym != null) {
            if (cg_str_eq(sym.name, name)) {
                return sym;
            }
        }
        i = i + 1;
    }
    return null;
}

fun cg_str_contains(hay: string, needle: string) <bool> {
    if (hay == null || needle == null) { return false; }
    let hlen <int> = cast<int>(cg_strlen(hay));
    let nlen <int> = cast<int>(cg_strlen(needle));
    if (nlen == 0 || nlen > hlen) { return false; }
    let i <int> = 0;
    while (i + nlen <= hlen) {
        if (cg_str_eq(substr(hay, i, nlen), needle)) { return true; }
        i = i + 1;
    }
    return false;
}

// Whether a local's annotation spells a function type (`fn(P...) -> R`,
// nullable or not). Such a value indirect-calls even when its LLVM
// function type was never recorded (e.g. denullified out of a field),
// mirroring the C++ backend, which checks the local's type first.
fun cg_ann_is_fn(ann: string) <bool> {
    if (ann == null) { return false; }
    let a <string> = ann;
    let alen <int> = cast<int>(cg_strlen(a));
    if (alen > 0 && cg_str_eq(substr(a, alen - 1, 1), "?")) {
        a = substr(a, 0, alen - 1);
        alen = alen - 1;
    }
    if (alen < 4) { return false; }
    if (!cg_str_eq(substr(a, 0, 2), "fn")) { return false; }
    return cg_str_eq(substr(a, 2, 1), "(");
}

// Whether a struct member is a generic-method template: a fun declaration
// carrying its own generic parameters. Operators reuse str_val for the
// operator symbol (and always carry "operator" in the name), so they never
// count; attribute payloads reuse str_val elsewhere and never read as
// generics without `=` or `"`. Free generic functions are not members and
// stay eager -- only in-struct methods instantiate on demand.
fun is_generic_method(m: &AstNode) <bool> {
    if (m == null || m.kind != ast_fun_decl()) { return false; }
    if (m.name != null && cg_str_contains(m.name, "operator")) { return false; }
    let g <string> = m.str_val;
    if (g == null || cg_strlen(g) == cast<ulong>(0)) { return false; }
    let glen <int> = cast<int>(cg_strlen(g));
    let gi <int> = 0;
    while (gi < glen) {
        let ch <string> = substr(g, gi, 1);
        if (cg_str_eq(ch, "=") || cg_str_eq(ch, "\"")) { return false; }
        gi = gi + 1;
    }
    return true;
}

// PT1 slice 1: the checker's single-letter generic vocabulary
// (checker.fin chk_is_type_param): a bare word naming a type parameter
// rather than a type. Shared by the body scan below.
fun cg_is_type_param(s: string) <bool> {
    if (cg_str_eq(s, "T") || cg_str_eq(s, "E") || cg_str_eq(s, "U") ||
      cg_str_eq(s, "K") || cg_str_eq(s, "V") || cg_str_eq(s, "X")) {
        return true;
      }
    return false;
}

// Declared-generic consult (triage #6b): true when `want` names a
// parameter in `gen_text` (`Generic`, `Generic:Addable` -> `Generic`).
// The caller ORs this with cg_is_type_param, so single letters work
// identically with or without a declaration.
fun cg_gen_text_contains(gen_text: string, want: string) <bool> {
    if (gen_text == null || want == null) { return false; }
    if (cg_strlen(gen_text) == cast<ulong>(0) || cg_strlen(want) == cast<ulong>(0)) { return false; }
    let t <string> = cg_trim_spaces(want);
    if (cg_strlen(t) == cast<ulong>(0)) { return false; }
    let tlen <int> = cast<int>(cg_strlen(t));
    let ti <int> = 0;
    while (ti < tlen) {
        let ch <string> = substr(t, ti, 1);
        if (cg_str_eq(ch, "<") || cg_str_eq(ch, ">") || cg_str_eq(ch, "[") || cg_str_eq(ch, "]") ||
          cg_str_eq(ch, "&") || cg_str_eq(ch, "*") || cg_str_eq(ch, "?") || cg_str_eq(ch, ":") ||
          cg_str_eq(ch, ",") || cg_str_eq(ch, " ") || cg_str_eq(ch, "(") || cg_str_eq(ch, ")")) {
            return false;
          }
        ti = ti + 1;
    }
    let pnames <[string]> = new [string, 64]{};
    let pcount <int> = cg_method_param_names(gen_text, pnames, 64);
    let pi <int> = 0;
    while (pi < pcount) {
        if (cg_str_eq(pnames[pi], t)) {
            delete pnames;
            return true;
        }
        pi = pi + 1;
    }
    delete pnames;
    return false;
}

// True when `s` names a generic parameter in the current lowering
// context: the single-letter vocabulary, the current function's own
// `<...>` text, or any struct/enum's declared parameters. Bare words
// only; complex spellings answer false, exactly like cg_is_type_param.
// A single-letter struct/enum/interface (e.g. `struct V`) wins over the
// vocabulary unless the letter is also declared as a generic parameter
// in the current context (shadowing, like C++): otherwise `V + V`
// takes the generic p2i path and miscompiles instead of refusing as
// undeclared operator (probe: struct V { val <int> } with `a + b` in
// main refuses on C++ `-c` but stage2 `-c` exits 0).
fun cg_is_generic_ann(ctx: &FnContext, s: string) <bool> {
    if (s == null) { return false; }
    if (ctx == null) { return cg_is_type_param(s); }
    let t <string> = cg_trim_spaces(cg_strip_markers(cg_trim_spaces(s)));
    if (cg_strlen(t) == cast<ulong>(0)) { return false; }
    if (cg_is_type_param(t)) {
        if (ctx.cur_gen != null && cg_strlen(ctx.cur_gen) > cast<ulong>(0)) {
            if (cg_gen_text_contains(ctx.cur_gen, t)) { return true; }
        }
        let ssi <int> = 0;
        while (ssi < ctx.struct_count) {
            let sst <&StructInfo> = ctx.structs[ssi];
            if (sst != null && sst.gen_params != null && cg_strlen(sst.gen_params) > cast<ulong>(0)) {
                if (cg_gen_text_contains(sst.gen_params, t)) { return true; }
            }
            ssi = ssi + 1;
        }
        let eei <int> = 0;
        while (eei < ctx.enum_count) {
            let een <&EnumInfo> = ctx.enums[eei];
            if (een != null && een.gen_params != null && cg_strlen(een.gen_params) > cast<ulong>(0)) {
                if (cg_gen_text_contains(een.gen_params, t)) { return true; }
            }
            eei = eei + 1;
        }
        if (find_struct(ctx, t) != null) { return false; }
        if (find_enum(ctx, t) != null) { return false; }
        if (find_interface(ctx, t) != null) { return false; }
        return true;
    }
    if (ctx.cur_gen != null && cg_strlen(ctx.cur_gen) > cast<ulong>(0)) {
        if (cg_gen_text_contains(ctx.cur_gen, t)) { return true; }
    }
    let si <int> = 0;
    while (si < ctx.struct_count) {
        let st <&StructInfo> = ctx.structs[si];
        if (st != null && st.gen_params != null && cg_strlen(st.gen_params) > cast<ulong>(0)) {
            if (cg_gen_text_contains(st.gen_params, t)) { return true; }
        }
        si = si + 1;
    }
    let ei <int> = 0;
    while (ei < ctx.enum_count) {
        let en <&EnumInfo> = ctx.enums[ei];
        if (en != null && en.gen_params != null && cg_strlen(en.gen_params) > cast<ulong>(0)) {
            if (cg_gen_text_contains(en.gen_params, t)) { return true; }
        }
        ei = ei + 1;
    }
    return false;
}

// An annotation naming an erased type parameter no declaration recorded:
// a generic lambda's `<Generic: Addable>` text never reaches str_val (the
// parser skips it), so ctx.cur_gen is empty there and cg_is_generic_ann
// stays false while the value still lowers at pointer width. True for a
// bare word (a constraint reads as the word before `:`) that is not a
// primitive, not `auto`/`void`/`noret`/`Self`, and not a declared struct,
// enum, or interface. Anything carrying a reference, array, application,
// or signature mark answers false: decorated values keep the lowering
// their shape already owns (notably the address-of paths). Read only by
// the arithmetic guard; cg_is_generic_ann keeps its declared-only
// contract on every other path.
fun cg_ann_is_erased_param(ctx: &FnContext, s: string) <bool> {
    if (s == null || ctx == null) { return false; }
    let t <string> = cg_trim_spaces(s);
    let ci <int> = 0;
    let clen <int> = cast<int>(cg_strlen(t));
    while (ci < clen) {
        if (cg_str_eq(substr(t, ci, 1), ":")) { t = cg_trim_spaces(substr(t, 0, ci)); break; }
        ci = ci + 1;
    }
    if (cg_strlen(t) == cast<ulong>(0)) { return false; }
    if (cg_str_contains(t, "&") || cg_str_contains(t, "*") || cg_str_contains(t, "?") ||
      cg_str_contains(t, "[") || cg_str_contains(t, "]") || cg_str_contains(t, "<") ||
      cg_str_contains(t, ">") || cg_str_contains(t, "(") || cg_str_contains(t, ")") ||
      cg_str_contains(t, ",") || cg_str_contains(t, " ") || cg_str_contains(t, ".") ||
      cg_str_contains(t, "@") || cg_str_contains(t, "$")) {
        return false;
      }
    if (cg_str_contains("0123456789", substr(t, 0, 1))) { return false; }
    if (cg_is_prim_spelling(t)) { return false; }
    if (cg_str_eq(t, "auto") || cg_str_eq(t, "void") || cg_str_eq(t, "noret") ||
      cg_str_eq(t, "Self") || cg_str_eq(t, "self") || cg_str_eq(t, "null") ||
      cg_str_eq(t, "true") || cg_str_eq(t, "false")) {
        return false;
      }
    if (find_struct(ctx, t) != null) { return false; }
    if (find_enum(ctx, t) != null) { return false; }
    if (find_interface(ctx, t) != null) { return false; }
    return true;
}

// Strip pointer, array and nullable markers (`&Self` -> `Self`,
// `[T]` -> `T`). Mirrors what get_node_struct_name does for receivers.
fun cg_strip_markers(s: string) <string> {
    if (s == null) { return ""; }
    let t <string> = s;
    let changed <bool> = true;
    while (changed) {
        changed = false;
        let len <int> = cast<int>(cg_strlen(t));
        if (len > 1 && cg_str_eq(substr(t, 0, 1), "&")) {
            t = substr(t, 1, len - 1);
            changed = true;
        } else {
            len = cast<int>(cg_strlen(t));
            if (len > 1 && (cg_str_eq(substr(t, len - 1, 1), "*") || cg_str_eq(substr(t, len - 1, 1), "?"))) {
                t = substr(t, 0, len - 1);
                changed = true;
            } else if (len > 2 && cg_str_eq(substr(t, 0, 1), "[") && cg_str_eq(substr(t, len - 1, 1), "]")) {
                t = substr(t, 1, len - 2);
                changed = true;
            }
        }
    }
    return t;
}

// Collect names of params and locals annotated with a bare type parameter
// (`item: T`, `a: Generic`). Recursion follows the AST shape collect_var_allocas uses.
// Declared names consult the function's own `<...>` text via gen_text, so
// `fun addgen<Generic>` collects like `fun f<T>`; single letters work
// identically through cg_is_type_param.
fun cg_collect_generic_names(node: &AstNode, names: [string], count: int, gen_text: string) <int> {
    if (node == null) { return count; }
    if ((node.kind == ast_param() || node.kind == ast_var_decl()) && node.name != null) {
        let stripped <string> = cg_strip_markers(node.type_annotation);
        if (cg_is_type_param(stripped) || cg_gen_text_contains(gen_text, stripped)) {
            if (count < 256) {
                names[count] = node.name;
                count = count + 1;
            }
        }
    }
    count = cg_collect_generic_names(node.left, names, count, gen_text);
    count = cg_collect_generic_names(node.right, names, count, gen_text);
    count = cg_collect_generic_names(node.extra, names, count, gen_text);
    return count;
}

fun cg_name_in_list(names: [string], count: int, want: string) <bool> {
    let i <int> = 0;
    while (i < count) {
        if (cg_str_eq(names[i], want)) { return true; }
        i = i + 1;
    }
    return false;
}

// True when the subtree compares a collected generic-typed ident with `==`
// (want_ne false) or `!=` (want_ne true) as a direct operand. Concrete
// comparisons (`filled == 0`, `_arr == null`) have no such operand and
// keep lowering; member/index operands (`a.val == b.val`) are a known
// miss, documented at cg_check_generic_call.
fun cg_subtree_has_generic_eq(node: &AstNode, names: [string], count: int, want_ne: bool) <bool> {
    if (node == null) { return false; }
    if (node.kind == ast_binary_expr() && node.name != null) {
        let is_eq <bool> = cg_str_eq(node.name, "==");
        let is_ne <bool> = cg_str_eq(node.name, "!=");
        if ((is_eq && !want_ne) || (is_ne && want_ne)) {
            if (node.left != null && node.left.kind == ast_ident() && cg_name_in_list(names, count, node.left.name)) { return true; }
            if (node.right != null && node.right.kind == ast_ident() && cg_name_in_list(names, count, node.right.name)) { return true; }
        }
    }
    if (cg_subtree_has_generic_eq(node.left, names, count, want_ne)) { return true; }
    if (cg_subtree_has_generic_eq(node.right, names, count, want_ne)) { return true; }
    if (cg_subtree_has_generic_eq(node.extra, names, count, want_ne)) { return true; }
    return false;
}

// PT1 slice 1 type knowledge: does this function body compare a
// generic-typed value with `==` or `!=`? Params and body locals first (an
// empty set answers false without walking the body), then the body.
// Declared names ride on the function's own `<...>` text (attribute
// payloads and operators reuse str_val and never read as generics).
fun cg_fn_uses_generic_eq(fn_node: &AstNode, want_ne: bool) <bool> {
    if (fn_node == null) { return false; }
    let gen <string> = "";
    if (fn_node.str_val != null && cg_strlen(fn_node.str_val) > cast<ulong>(0)) {
        if (!cg_str_contains(fn_node.str_val, "=") && !cg_str_contains(fn_node.str_val, "\"")) {
            if (fn_node.name == null || !cg_str_contains(fn_node.name, "operator")) {
                gen = fn_node.str_val;
            }
        }
    }
    let names <[string]> = new [string, 256]{};
    let count <int> = 0;
    count = cg_collect_generic_names(fn_node.extra, names, count, gen);
    count = cg_collect_generic_names(fn_node.left, names, count, gen);
    let found <bool> = false;
    if (count > 0) {
        found = cg_subtree_has_generic_eq(fn_node.left, names, count, want_ne);
    }
    delete names;
    return found;
}

// The receiver ident behind a call node: the first argument for flattened
// `Struct_method` calls, the node itself when already unwrapped. "" when
// the receiver is not a plain ident (a call on one keeps today's lowering).
fun cg_recv_ident(node: &AstNode) <string> {
    if (node == null) { return ""; }
    if (node.kind == ast_ident()) {
        if (node.name == null) { return ""; }
        return node.name;
    }
    if (node.left != null && node.left.kind == ast_ident()) {
        if (node.left.name == null) { return ""; }
        return node.left.name;
    }
    return "";
}

// If an initializer expression denotes a function (a lambda, which hoisting
// named fin.lambda.N, or an ident naming a declared function), return its LLVM
// function type so callers can store the value as a pointer and indirect-call
// it. Anything else yields null. Function types are not first-class in LLVM:
// values must be bitcast to ptr before storing.
fun init_fn_type(ctx: &FnContext, init_node: &AstNode) <&LLVMType> {
    if (init_node == null || ctx == null || ctx.module == null) { return null; }
    let src <&AstNode> = init_node;
    if (src.kind == 0 && src.left != null) {
        src = src.left;
    }
    if (src.kind == 29) {
        if (src.name != null && cg_strlen(src.name) > cast<ulong>(0)) {
            let sym <&FnSymbol> = fn_ctx_find_fn(ctx, src.name);
            if (sym != null && sym.fn_ty != null) { return sym.fn_ty; }
            let mf <&LLVMValue> = llvm_get_named_function(ctx.module, src.name);
            if (mf != null) { return llvm_global_get_value_type(mf); }
        }
        return null;
    }
    if (src.kind == ast_ident()) {
        // Variables shadow functions (mirrors lower_expr's ident lookup):
        // an ident resolving to a local is a plain value even when a
        // function shares its name (e.g. `count` param vs strings::count).
        // Only a local already recorded as holding a function pointer
        // propagates its function type.
        let v <&LocalVar> = fn_ctx_find_var(ctx, src.name);
        if (v != null) {
            if (v.fn_ty != null && v.ty == ctx.ptr_ty) { return v.fn_ty; }
            return null;
        }
        let sym <&FnSymbol> = fn_ctx_find_fn(ctx, src.name);
        if (sym != null && sym.fn_ty != null) { return sym.fn_ty; }
        let mf <&LLVMValue> = llvm_get_named_function(ctx.module, src.name);
        if (mf != null) { return llvm_global_get_value_type(mf); }
        return null;
    }
    return null;
}

// Every boundary that stores a value (locals, stores, returns, call args)
// routes a function-typed value through here: bitcast to ptr, the ABI-level
// function pointer (ADR 0002). Non-function values pass through untouched.
fun fn_value_to_ptr(ctx: &FnContext, src_node: &AstNode, val: &LLVMValue) <&LLVMValue> {
    if (val == null || ctx == null) { return val; }
    if (init_fn_type(ctx, src_node) == null) { return val; }
    if (llvm_type_of(val) == ctx.ptr_ty) { return val; }
    // Integer-typed values are never function references: a shadowed or
    // mismatched name must pass through, never bitcast iN to ptr (invalid
    // IR: LLVM ERROR Cannot select). Genuine function values keep their
    // function type here and still bitcast below.
    let v_ty <&LLVMType> = llvm_type_of(val);
    if (v_ty == ctx.i32_ty || v_ty == ctx.i64_ty || v_ty == ctx.i8_ty || v_ty == ctx.i16_ty || v_ty == ctx.i1_ty || v_ty == ctx.float_ty || v_ty == ctx.double_ty) { return val; }
    return llvm_build_bitcast(ctx.builder, val, ctx.ptr_ty, "fn_p");
}

fun find_struct(ctx: &FnContext, name: string) <&StructInfo> {
    if (name == null || ctx == null) { return null; }
    let i <int> = 0;
    while (i < ctx.struct_count) {
        let st <&StructInfo> = ctx.structs[i];
        if (st != null && cg_str_eq(st.name, name)) {
            return st;
        }
        i = i + 1;
    }
    return null;
}

// The struct count drifts whenever a field read instantiates a layout
// (ensure appends to the shared array through a copied count). The array
// stays densely packed, so re-reading the leading run resynchronises --
// the struct analogue of recount_fn_syms. Call where an instance must be
// visible across function lowerings.
fun recount_structs(structs: [&StructInfo], struct_count: int) <int> {
    let n <int> = struct_count;
    while (n < 1024 && structs[n] != null) {
        n = n + 1;
    }
    return n;
}

// Per-instantiation struct layouts (FE1a): one StructInfo per distinct
// concrete argument list, keyed by the spelling as written
// (`Box<double>`), mirroring C++ instantiateGeneric's per-mangled-name
// instances and reusing the MC1 key machinery (split/subst). Heap objects
// are untyped pointers, so a "layout" here is the field annotations with
// the arguments substituted: a member read through a nested spelling
// (`w.dbox.val`) resolves the width off the instance instead of the
// erased template, so width-mixed instantiations read correctly on both
// sides. Asking twice finds the first. Exotic spellings (bare parameters,
// `Self`, count mismatches, a full table, no new layout) answer the
// template, and every existing refusal keeps owning its path.
fun cg_ensure_struct_instance(ctx: &FnContext, spelling: string) <&StructInfo> {
    if (ctx == null || spelling == null) { return null; }
    ctx.struct_count = recount_structs(ctx.structs, ctx.struct_count);
    let s <string> = cg_trim_spaces(spelling);
    let slen <int> = cast<int>(cg_strlen(s));
    while (slen > 1 && (cg_str_eq(substr(s, 0, 1), "&") || cg_str_eq(substr(s, 0, 1), "*"))) {
        s = substr(s, 1, slen - 1);
        slen = cast<int>(cg_strlen(s));
    }
    while (slen > 1 && cg_str_eq(substr(s, slen - 1, 1), "*")) {
        s = substr(s, 0, slen - 1);
        slen = cast<int>(cg_strlen(s));
    }
    s = cg_trim_spaces(s);
    slen = cast<int>(cg_strlen(s));
    let open_at <int> = -1;
    let oi <int> = 0;
    while (oi < slen) {
        if (cg_str_eq(substr(s, oi, 1), "<")) { open_at = oi; break; }
        oi = oi + 1;
    }
    if (open_at <= 0) { return find_struct(ctx, s); }
    let close_at <int> = -1;
    let cj <int> = slen - 1;
    while (cj > open_at) {
        if (cg_str_eq(substr(s, cj, 1), ">")) { close_at = cj; break; }
        cj = cj - 1;
    }
    if (close_at < 0) { return find_struct(ctx, s); }
    let base <string> = cg_trim_spaces(substr(s, 0, open_at));
    let inner <string> = substr(s, open_at + 1, close_at - open_at - 1);
    let tmpl <&StructInfo> = find_struct(ctx, base);
    if (tmpl == null) { return null; }
    if (tmpl.gen_params == null || cg_strlen(tmpl.gen_params) == cast<ulong>(0)) { return tmpl; }
    let hit <&StructInfo> = find_struct(ctx, s);
    if (hit != null) { return hit; }
    let params <[string]> = new [string, 64]{};
    let args <[string]> = new [string, 64]{};
    let pcount <int> = cg_split_top(tmpl.gen_params, params, 64);
    let acount <int> = cg_split_top(inner, args, 64);
    if (pcount <= 0 || acount != pcount) { delete params; delete args; return tmpl; }
    let ai <int> = 0;
    while (ai < acount) {
        let seg <string> = cg_trim_spaces(args[ai]);
        if (cg_strlen(seg) == cast<ulong>(0) || cg_is_generic_ann(ctx, seg) || cg_str_eq(seg, "Self")) {
            delete params; delete args; return tmpl;
        }
        ai = ai + 1;
    }
    // An identical substitution adds no layout: answer the template and
    // keep unbound bodies (`Box<T>`) on the old path.
    let same <bool> = true;
    let fi <int> = 0;
    while (fi < tmpl.field_count) {
        let f <&StructFieldInfo> = tmpl.fields[fi];
        if (f != null && f.type_annotation != null) {
            let sub <string> = cg_subst_params(f.type_annotation, params, args, pcount, acount);
            if (!cg_str_eq(sub, f.type_annotation)) { same = false; break; }
        }
        fi = fi + 1;
    }
    if (same) { delete params; delete args; return tmpl; }
    if (ctx.struct_count >= 1020) { delete params; delete args; return tmpl; }
    let ni <&StructInfo> = new StructInfo{};
    ni.name = s;
    ni.fields = new [&StructFieldInfo, 64]{};
    ni.field_count = 0;
    ni.has_destructor = tmpl.has_destructor;
    ni.destructor_name = tmpl.destructor_name;
    ni.has_eq = tmpl.has_eq;
    ni.has_ne = tmpl.has_ne;
    ni.gen_params = "";
    ni.gen_eq_use = "";
    ni.gen_ne_use = "";
    ni.method_head = tmpl.method_head;
    fi = 0;
    while (fi < tmpl.field_count) {
        let f <&StructFieldInfo> = tmpl.fields[fi];
        if (f != null) {
            let nf <&StructFieldInfo> = new StructFieldInfo{};
            nf.name = f.name;
            nf.index = f.index;
            nf.default_init = f.default_init;
            if (f.type_annotation != null) {
                nf.type_annotation = cg_subst_params(f.type_annotation, params, args, pcount, acount);
            } else {
                nf.type_annotation = "";
            }
            ni.fields[ni.field_count] = nf;
            ni.field_count = ni.field_count + 1;
        }
        fi = fi + 1;
    }
    delete params;
    delete args;
    ctx.structs[ctx.struct_count] = ni;
    ctx.struct_count = ctx.struct_count + 1;
    return ni;
}

// The enum count drifts like the struct count (ensure appends through a
// copied count). Same densely-packed resync.
fun recount_enums(enums: [&EnumInfo], enum_count: int) <int> {
    let n <int> = enum_count;
    while (n < 256 && enums[n] != null) {
        n = n + 1;
    }
    return n;
}

// Per-instantiation enum layouts (ENGA slice 2, FE1 extension): one EnumInfo
// per distinct concrete argument list, keyed by the spelling as written
// (`Res<int>`), mirroring C++ instantiateEnumGeneric's per-mangled-name
// instances and reusing the struct key machinery (split/subst). A "layout"
// here is the member payload spellings with the arguments substituted plus
// the sized `{i32, [i8 x max]}` type built from them, so width-mixed
// instantiations (`Res<int>` beside `Res<float>`, nested `Box<int>` payloads)
// read correctly. Asking twice finds the first. Exotic spellings (bare
// parameters, `Self`, count mismatches, a full table, no new layout) answer
// the template, and every existing refusal keeps owning its path.
fun cg_enum_payload_size(spelling: string) <int> {
    let s <string> = cg_trim_spaces(spelling);
    if (cg_str_eq(s, "int") || cg_str_eq(s, "uint")) { return 4; }
    if (cg_str_eq(s, "bool") || cg_str_eq(s, "char") || cg_str_eq(s, "u8") || cg_str_eq(s, "i8")) { return 1; }
    return 8;
}

fun cg_ensure_enum_instance(ctx: &FnContext, spelling: string) <&EnumInfo> {
    if (ctx == null || spelling == null) { return null; }
    ctx.enum_count = recount_enums(ctx.enums, ctx.enum_count);
    let s <string> = cg_trim_spaces(spelling);
    let slen <int> = cast<int>(cg_strlen(s));
    while (slen > 1 && (cg_str_eq(substr(s, 0, 1), "&") || cg_str_eq(substr(s, 0, 1), "*"))) {
        s = substr(s, 1, slen - 1);
        slen = cast<int>(cg_strlen(s));
    }
    while (slen > 1 && cg_str_eq(substr(s, slen - 1, 1), "*")) {
        s = substr(s, 0, slen - 1);
        slen = cast<int>(cg_strlen(s));
    }
    s = cg_trim_spaces(s);
    slen = cast<int>(cg_strlen(s));
    let open_at <int> = -1;
    let oi <int> = 0;
    while (oi < slen) {
        if (cg_str_eq(substr(s, oi, 1), "<")) { open_at = oi; break; }
        oi = oi + 1;
    }
    if (open_at <= 0) { return find_enum(ctx, s); }
    let close_at <int> = -1;
    let cj <int> = slen - 1;
    while (cj > open_at) {
        if (cg_str_eq(substr(s, cj, 1), ">")) { close_at = cj; break; }
        cj = cj - 1;
    }
    if (close_at < 0) { return find_enum(ctx, s); }
    let base <string> = cg_trim_spaces(substr(s, 0, open_at));
    let inner <string> = substr(s, open_at + 1, close_at - open_at - 1);
    let tmpl <&EnumInfo> = find_enum(ctx, base);
    if (tmpl == null) { return null; }
    if (tmpl.gen_params == null || cg_strlen(tmpl.gen_params) == cast<ulong>(0)) { return tmpl; }
    let hit <&EnumInfo> = find_enum(ctx, s);
    if (hit != null) { return hit; }
    let params <[string]> = new [string, 64]{};
    let args <[string]> = new [string, 64]{};
    let pcount <int> = cg_split_top(tmpl.gen_params, params, 64);
    let acount <int> = cg_split_top(inner, args, 64);
    if (pcount <= 0 || acount != pcount) { delete params; delete args; return tmpl; }
    // Bounded params (`T: Any<...>`, `E: Offer<string, Error>`): the
    // constraint reads as the word before `:`, so substitution matches the
    // bare name (`T`, `E`). Without this no bounded generic ever differs
    // from its template and no instantiation is made.
    let pi <int> = 0;
    while (pi < pcount) {
        let ps <string> = cg_trim_spaces(params[pi]);
        let plen <int> = cast<int>(cg_strlen(ps));
        let ci <int> = 0;
        while (ci < plen) {
            if (cg_str_eq(substr(ps, ci, 1), ":")) { ps = cg_trim_spaces(substr(ps, 0, ci)); break; }
            ci = ci + 1;
        }
        params[pi] = ps;
        pi = pi + 1;
    }
    let ai <int> = 0;
    while (ai < acount) {
        let seg <string> = cg_trim_spaces(args[ai]);
        if (cg_strlen(seg) == cast<ulong>(0) || cg_is_generic_ann(ctx, seg) || cg_str_eq(seg, "Self")) {
            delete params; delete args; return tmpl;
        }
        ai = ai + 1;
    }
    let same <bool> = true;
    let mi <int> = 0;
    while (mi < tmpl.member_count) {
        let m <&EnumMemberInfo> = tmpl.members[mi];
        if (m != null && m.has_payload && m.payload_type != null) {
            let sub <string> = cg_subst_params(m.payload_type, params, args, pcount, acount);
            if (!cg_str_eq(sub, m.payload_type)) { same = false; break; }
        }
        mi = mi + 1;
    }
    if (same) { delete params; delete args; return tmpl; }
    if (ctx.enum_count >= 250) { delete params; delete args; return tmpl; }
    let ni <&EnumInfo> = new EnumInfo{};
    ni.name = s;
    ni.members = new [&EnumMemberInfo, 64]{};
    ni.member_count = 0;
    ni.has_payload = tmpl.has_payload;
    ni.max_payload_size = 0;
    ni.gen_params = "";
    mi = 0;
    while (mi < tmpl.member_count) {
        let m <&EnumMemberInfo> = tmpl.members[mi];
        if (m != null) {
            let nm <&EnumMemberInfo> = new EnumMemberInfo{};
            nm.name = m.name;
            nm.tag = m.tag;
            nm.has_payload = m.has_payload;
            if (m.has_payload && m.payload_type != null) {
                nm.payload_type = cg_subst_params(m.payload_type, params, args, pcount, acount);
                nm.payload_size = cg_enum_payload_size(nm.payload_type);
            } else {
                nm.payload_type = m.payload_type;
                nm.payload_size = m.payload_size;
            }
            if (nm.has_payload && nm.payload_size > ni.max_payload_size) {
                ni.max_payload_size = nm.payload_size;
            }
            ni.members[ni.member_count] = nm;
            ni.member_count = ni.member_count + 1;
        }
        mi = mi + 1;
    }
    delete params;
    delete args;
    if (ni.has_payload) {
        let pay_sz <int> = ni.max_payload_size;
        if (pay_sz == 0) { pay_sz = 8; }
        let e_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
        e_args.t0 = llvm_i32_type();
        e_args.t1 = llvm_array_type(llvm_i8_type(), pay_sz);
        ni.llvm_type = llvm_struct_type(e_args, 2, 0);
        delete e_args;
    } else {
        ni.llvm_type = llvm_i32_type();
    }
    ctx.enums[ctx.enum_count] = ni;
    ctx.enum_count = ctx.enum_count + 1;
    return ni;
}

fun find_enum(ctx: &FnContext, name: string) <&EnumInfo> {    if (name == null || ctx == null) { return null; }
    let i <int> = 0;
    while (i < ctx.enum_count) {
        let e <&EnumInfo> = ctx.enums[i];
        if (e != null && cg_str_eq(e.name, name)) {
            return e;
        }
        i = i + 1;
    }
    return null;
}

fun find_enum_by_llvm_type(ctx: &FnContext, ty: &LLVMType) <&EnumInfo> {
    if (ty == null || ctx == null) { return null; }
    let i <int> = 0;
    while (i < ctx.enum_count) {
        let e <&EnumInfo> = ctx.enums[i];
        if (e != null && e.has_payload && e.llvm_type == ty) {
            return e;
        }
        i = i + 1;
    }
    return null;
}

fun find_enum_for_member(ctx: &FnContext, member_name: string) <&EnumInfo> {
    if (member_name == null || ctx == null) { return null; }
    let i <int> = 0;
    while (i < ctx.enum_count) {
        let e <&EnumInfo> = ctx.enums[i];
        if (e != null) {
            let j <int> = 0;
            while (j < e.member_count) {
                let m <&EnumMemberInfo> = e.members[j];
                if (m != null) {
                    if (cg_str_eq(m.name, member_name)) {
                        return e;
                    }
                    let b <Buffer> = new_buffer(64);
                    b.write_string(e.name);
                    b.write_string("::");
                    b.write_string(m.name);
                    let q <string> = b.to_string();
                    free_buffer(b);
                    if (cg_str_eq(q, member_name)) {
                        return e;
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return null;
}

fun find_enum_member_global(ctx: &FnContext, member_name: string) <&EnumMemberInfo> {
    if (member_name == null || ctx == null) { return null; }
    let i <int> = 0;
    while (i < ctx.enum_count) {
        let e <&EnumInfo> = ctx.enums[i];
        if (e != null) {
            let j <int> = 0;
            while (j < e.member_count) {
                let m <&EnumMemberInfo> = e.members[j];
                if (m != null) {
                    if (cg_str_eq(m.name, member_name)) {
                        return m;
                    }
                    let b <Buffer> = new_buffer(64);
                    b.write_string(e.name);
                    b.write_string("::");
                    b.write_string(m.name);
                    let q <string> = b.to_string();
                    free_buffer(b);
                    if (cg_str_eq(q, member_name)) {
                        return m;
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return null;
}

fun find_interface(ctx: &FnContext, name: string) <&InterfaceInfo> {
    if (name == null || ctx == null) { return null; }
    let i <int> = 0;
    while (i < ctx.interface_count) {
        let iface <&InterfaceInfo> = ctx.interfaces[i];
        if (iface != null && cg_str_eq(iface.name, name)) {
            return iface;
        }
        i = i + 1;
    }
    return null;
}

fun find_interface_method(iface: &InterfaceInfo, method_name: string) <&InterfaceMethodInfo> {
    if (iface == null || method_name == null) { return null; }
    let i <int> = 0;
    while (i < iface.method_count) {
        let m <&InterfaceMethodInfo> = iface.methods[i];
        if (m != null && cg_str_eq(m.name, method_name)) {
            return m;
        }
        i = i + 1;
    }
    return null;
}

fun find_interface_for_node(ctx: &FnContext, node: &AstNode) <&InterfaceInfo> {
    if (node == null || ctx == null) { return null; }
    if (node.kind == ast_ident()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, node.name);
        if (v != null && v.type_annotation != null) {
            return find_interface(ctx, v.type_annotation);
        }
    }
    if (node.type_annotation != null && cg_strlen(node.type_annotation) > cast<ulong>(0)) {
        return find_interface(ctx, node.type_annotation);
    }
    return null;
}

// Type-id of a struct/interface by its table index (Stage C tid): structs
// and interfaces have separate spaces, so indices alone are unique within
// each. -1 when unknown (never a valid tid).
fun cg_struct_tid(ctx: &FnContext, name: string) <int> {
    if (ctx == null || name == null) { return -1; }
    let i <int> = 0;
    while (i < ctx.struct_count) {
        let st <&StructInfo> = ctx.structs[i];
        if (st != null && cg_str_eq(st.name, name)) { return i; }
        i = i + 1;
    }
    return -1;
}

fun cg_iface_tid(ctx: &FnContext, name: string) <int> {
    if (ctx == null || name == null) { return -1; }
    let i <int> = 0;
    while (i < ctx.interface_count) {
        let iface <&InterfaceInfo> = ctx.interfaces[i];
        if (iface != null && cg_str_eq(iface.name, name)) { return i; }
        i = i + 1;
    }
    return -1;
}

fun is_nullable_type(type_ann: string) <bool> {
    if (type_ann == null) { return false; }
    let len <int> = cast<int>(cg_strlen(type_ann));
    if (len > 0) {
        return cg_str_eq(substr(type_ann, len - 1, 1), "?");
    }
    return false;
}

// A lowered null literal: the `null`/`NULL` ident lowers to a null pointer
// constant, so the check is the pointer type plus pointer equality (the C++
// backend recognises the constant the same way). A computed zero (literal
// `0`, `x - x`) is a value, never absent: it is an integer zero, not a null
// pointer, so presence is never read off it.
fun cg_is_null_lit(ctx: &FnContext, v: &LLVMValue) <bool> {
    if (v == null || ctx == null || ctx.ptr_ty == null) { return false; }
    if (llvm_type_of(v) != ctx.ptr_ty) { return false; }
    return v == llvm_const_null(ctx.ptr_ty);
}

// The tagged nullable pair `{T, i1}`: two elements with an i1 second word.
// Interface fats (`{ptr, ptr}`), dynamic slices and payloaded enums also
// have two words, so the element count alone never identifies a pair.
fun cg_is_tagged_pair(ctx: &FnContext, ty: &LLVMType) <bool> {
    if (ctx == null || ty == null || ctx.i1_ty == null) { return false; }
    if (llvm_count_struct_element_types(ty) != 2) { return false; }
    return llvm_struct_get_type_at_index(ty, 1) == ctx.i1_ty;
}

// Whether an initializer spells absence: the `null`/`NULL` literal (or no
// expression at all, e.g. an omitted field, which calloc already zeroed).
// Anything else -- including a computed zero -- is presence.
fun cg_is_absent_spelling(n: &AstNode) <bool> {
    if (n == null) { return true; }
    if (n.kind == ast_ident() && (cg_str_eq(n.name, "null") || cg_str_eq(n.name, "NULL"))) { return true; }
    return false;
}

// Build the `{T, i1}` value for an initializer: the coerced payload beside
// a presence bit read off the spelling, never off the value. Absent stores
// a zero payload; the tag is what says it is absent.
fun cg_wrap_nullable(ctx: &FnContext, val: &LLVMValue, pair_ty: &LLVMType, absent: bool) <&LLVMValue> {
    let elem0 <&LLVMType> = llvm_struct_get_type_at_index(pair_ty, 0);
    let slot <&LLVMValue> = llvm_build_alloca(ctx.builder, pair_ty, "pair.tmp");
    let val_gep <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, pair_ty, slot, 0, "val");
    let pay <&LLVMValue> = null;
    if (absent) {
        pay = llvm_const_null(elem0);
    } else {
        pay = coerce_val(ctx, val, elem0);
    }
    llvm_build_store(ctx.builder, pay, val_gep);
    let has_gep <&LLVMValue> = llvm_build_struct_gep2(ctx.builder, pair_ty, slot, 1, "has_val");
    let bit <int> = 1;
    if (absent) { bit = 0; }
    llvm_build_store(ctx.builder, llvm_const_int(ctx.i1_ty, bit, 0), has_gep);
    return llvm_build_load2(ctx.builder, pair_ty, slot, "pair.val");
}

// Pair-to-pair conversion through a payload conversion (C++ convert()'s
// nullable arm): the tag carries over, the payload coerces. Same types pass
// through untouched; a narrowing or otherwise non-implicit payload is refused
// rather than truncated (see the widening gate below).
fun cg_convert_pair(ctx: &FnContext, val: &LLVMValue, pair_ty: &LLVMType) <&LLVMValue> {
    if (val == null || pair_ty == null) { return val; }
    let v_ty <&LLVMType> = llvm_type_of(val);
    if (v_ty == pair_ty) { return val; }
    if (!cg_is_tagged_pair(ctx, v_ty) || !cg_is_tagged_pair(ctx, pair_ty)) { return val; }
    let want_pay <&LLVMType> = llvm_struct_get_type_at_index(pair_ty, 0);
    let have_pay <&LLVMType> = llvm_struct_get_type_at_index(v_ty, 0);
    if (want_pay == have_pay) { return val; }
    // Only widening integer payloads and `int`->`float` convert implicitly
    // (the checker's inner rule; C++ convert() with an implicit cast). A
    // narrowing or otherwise non-implicit payload is refused rather than
    // truncated: the checker refused it first everywhere it checks, and the
    // sites it does not check (call arguments, struct literal fields) must
    // not emit guessed IR.
    let widens <bool> = false;
    if (have_pay == ctx.i8_ty && (want_pay == ctx.i32_ty || want_pay == ctx.i64_ty)) { widens = true; }
    if (have_pay == ctx.i32_ty && (want_pay == ctx.i64_ty || want_pay == ctx.float_ty)) { widens = true; }
    if (!widens) {
        cg_dprintf(2, "finc codegen refusal: implicit conversion between different nullable value types is not lowered (only widening payloads convert; denullify with '?' and convert explicitly) at '%s'\n", ctx.src_file);
        refuse_and_poison(ctx);
        return val;
    }
    let pay <&LLVMValue> = llvm_build_extract_value(ctx.builder, val, 0, "pp.pay");
    let tag <&LLVMValue> = llvm_build_extract_value(ctx.builder, val, 1, "pp.tag");
    let conv <&LLVMValue> = coerce_val(ctx, pay, want_pay);
    if (llvm_type_of(conv) != want_pay) { return val; }
    let agg <&LLVMValue> = llvm_get_undef(pair_ty);
    agg = llvm_build_insert_value(ctx.builder, agg, conv, 0, "pp.mk0");
    agg = llvm_build_insert_value(ctx.builder, agg, tag, 1, "pp.mk1");
    return agg;
}

fun is_prototype_node(ctx: &FnContext, node: &AstNode) <bool> {
    if (node == null) { return false; }
    if (node.kind == ast_prototype_literal()) { return true; }
    if (node.kind == ast_ident()) {
        let v <&LocalVar> = fn_ctx_find_var(ctx, node.name);
        if (v != null && v.type_annotation != null) {
            let t <string> = v.type_annotation;
            if (cg_str_eq(t, "prototype")) { return true; }
            let tlen <int> = cast<int>(cg_strlen(t));
            if (tlen > 0 && cg_str_eq(substr(t, 0, 1), "{")) { return true; }
            if (tlen >= 9 && cg_str_eq(substr(t, 0, 9), "prototype")) { return true; }
        }
    }
    return false;
}

// A prototype half: `prtp.0` (keys) or `prtp.1` (values) where the inner
// names a prototype (literal, or an ident annotated `prototype`/`{K, V}`).
// The header shape is fixed ({keys_ptr, len, vals_ptr, vallen}): the half
// lowers to the raw i64 buffer, and the entry count lives in the header
// slot beside it (1 for keys, 3 for values).
fun is_prototype_half(ctx: &FnContext, node: &AstNode) <bool> {
    if (node == null) { return false; }
    if (node.kind != ast_member_access()) { return false; }
    if (!cg_str_eq(node.name, "0") && !cg_str_eq(node.name, "1")) { return false; }
    return is_prototype_node(ctx, node.left);
}

// Whether an LLVM value is an integer word (a usable prototype position).
// Anything else (notably a string key) is not a position and keeps the
// legacy slot-0 behavior where key search is unmodeled.
fun cg_is_int_llvm(ctx: &FnContext, ty: &LLVMType) <bool> {
    if (ty == ctx.i32_ty) { return true; }
    if (ty == ctx.i64_ty) { return true; }
    if (ty == ctx.i8_ty) { return true; }
    if (ty == ctx.i16_ty) { return true; }
    if (ty == ctx.i1_ty) { return true; }
    return false;
}

// Wave-5 slices 1-2: whether `attr_text` carries `protocol(slot)`.
// Same segment parse as the checker's claim registry (`;`-separated, name
// up to `(`/`=`, argument inside parens or after `=`), so the gate agrees
// with the checker about what a claimant is. Only well-formed programs
// reach codegen, so a match is the checker's single valid claimant.
fun cg_attr_has_protocol_slot(attr: string, slot: string) <bool> {
    if (attr == null || cg_strlen(attr) == cast<ulong>(0)) { return false; }
    let len <int> = cast<int>(cg_strlen(attr));
    let start <int> = 0;
    let i <int> = 0;
    while (i <= len) {
        if (i == len || cg_str_eq(substr(attr, i, 1), ";")) {
            let seg <string> = substr(attr, start, i - start);
            let slen <int> = cast<int>(cg_strlen(seg));
            let ni <int> = 0;
            while (ni < slen) {
                let nc <string> = substr(seg, ni, 1);
                if (cg_str_eq(nc, "(") || cg_str_eq(nc, "=")) { break; }
                ni = ni + 1;
            }
            if (cg_str_eq(substr(seg, 0, ni), "protocol") && ni < slen) {
                let arg <string> = "";
                if (cg_str_eq(substr(seg, ni, 1), "=")) {
                    arg = substr(seg, ni + 1, slen - ni - 1);
                    let alen <int> = cast<int>(cg_strlen(arg));
                    if (alen >= 2 && cg_str_eq(substr(arg, 0, 1), "\"") &&
                      cg_str_eq(substr(arg, alen - 1, 1), "\"")) {
                        arg = substr(arg, 1, alen - 2);
                      }
                } else {
                    let ai <int> = ni + 1;
                    let depth <int> = 1;
                    let astart <int> = ai;
                    while (ai < slen && depth > 0) {
                        if (cg_str_eq(substr(seg, ai, 1), "(")) { depth = depth + 1; }
                        else if (cg_str_eq(substr(seg, ai, 1), ")")) { depth = depth - 1; }
                        ai = ai + 1;
                    }
                    arg = substr(seg, astart, ai - astart - 1);
                }
                if (cg_str_eq(arg, slot)) { return true; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fun cg_attr_has_move_protocol(attr: string) <bool> {
    return cg_attr_has_protocol_slot(attr, "move_or_copy");
}

// Wave-5 slice 4: `#[slaveof]` segment readers. Attribute text is
// `;`-joined `name(args)` segments (parser.fin), the same shape the
// checker's api_attr_* triple parses; only what the tie needs.
fun cg_attr_seg_count(attr: string, cap: int) <int> {
    if (attr == null || cg_strlen(attr) == cast<ulong>(0)) { return 0; }
    let n <int> = 1;
    let len <int> = cast<int>(cg_strlen(attr));
    let i <int> = 0;
    while (i < len) {
        if (cg_str_eq(substr(attr, i, 1), ";")) { n = n + 1; }
        i = i + 1;
    }
    if (n > cap) { n = cap; }
    return n;
}

fun cg_attr_seg(attr: string, idx: int) <string> {
    if (attr == null) { return ""; }
    let len <int> = cast<int>(cg_strlen(attr));
    let cur <int> = 0;
    let start <int> = 0;
    let i <int> = 0;
    while (i <= len) {
        if (i == len || cg_str_eq(substr(attr, i, 1), ";")) {
            if (cur == idx) { return substr(attr, start, i - start); }
            cur = cur + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fun cg_attr_seg_name(seg: string) <string> {
    if (seg == null) { return ""; }
    let len <int> = cast<int>(cg_strlen(seg));
    let i <int> = 0;
    while (i < len) {
        let c <string> = substr(seg, i, 1);
        if (cg_str_eq(c, "(") || cg_str_eq(c, "=")) { return substr(seg, 0, i); }
        i = i + 1;
    }
    return seg;
}

fun cg_attr_seg_arg(seg: string) <string> {
    if (seg == null) { return ""; }
    let len <int> = cast<int>(cg_strlen(seg));
    let i <int> = 0;
    while (i < len) {
        if (cg_str_eq(substr(seg, i, 1), "(")) {
            let start <int> = i + 1;
            let depth <int> = 1;
            let j <int> = start;
            while (j < len && depth > 0) {
                if (cg_str_eq(substr(seg, j, 1), "(")) { depth = depth + 1; }
                else if (cg_str_eq(substr(seg, j, 1), ")")) { depth = depth - 1; }
                j = j + 1;
            }
            return substr(seg, start, j - start - 1);
        }
        i = i + 1;
    }
    return "";
}

// Wave-5 slice 4: the `#[slaveof]` tie off a local declaration -- how this
// binding's storage lifetime ends (C++ resolveSlaveof). Returns 0 (none;
// no tie, or a same-scope tie, which dies with its own scope anyway), 1
// (pinned: `#[slaveof($Fin)]`, or tied to a global, which outlives every
// frame), or 2 (deferred to the master's scope exit), writing the master's
// block-start var index into master_out[0] for 2 only. Returns -1 having
// poisoned when the tie cannot be lowered. The checker validated the
// shape and the referent, so with semantics on this only recognises the
// two spellings; what cannot be lowered here is refused rather than
// dropped (backend invariant).
fun cg_resolve_slaveof(ctx: &FnContext, var_name: string, attr_text: string, cur_scope: int, master_out: [int]) <int> {
    master_out[0] = 0;
    let n <int> = cg_attr_seg_count(attr_text, 16);
    let ties <int> = 0;
    let arg <string> = "";
    let si <int> = 0;
    while (si < n) {
        let seg <string> = cg_attr_seg(attr_text, si);
        if (cg_str_eq(cg_attr_seg_name(seg), "slaveof")) {
            ties = ties + 1;
            if (ties == 1) { arg = cg_attr_seg_arg(seg); }
        }
        si = si + 1;
    }
    if (ties == 0) { return 0; }
    if (ties > 1) {
        cg_dprintf(2, "finc codegen refusal: two '#[slaveof]' attributes on the variable '%s' are not lowered\n", var_name);
        refuse_and_poison(ctx);
        return -1;
    }
    if (arg == null || cg_strlen(arg) == cast<ulong>(0)) {
        cg_dprintf(2, "finc codegen refusal: the attribute 'slaveof' on the variable '%s' names no referent\n", var_name);
        refuse_and_poison(ctx);
        return -1;
    }
    if (cg_str_eq(arg, "$Fin")) { return 1; }
    if (cg_str_eq(substr(arg, 0, 1), "$")) {
        cg_dprintf(2, "finc codegen refusal: the unknown lifetime '%s' in '#[slaveof]' on the variable '%s' is not lowered\n", arg, var_name);
        refuse_and_poison(ctx);
        return -1;
    }
    // Innermost out, like the C++ scope chain: the binding itself is not
    // there yet (the checker resolves before defining, so the name cannot
    // meet itself), and names are unique in this table.
    let i <int> = ctx.var_count - 1;
    while (i >= 0) {
        let v <&LocalVar> = ctx.vars[i];
        if (v != null && !cg_str_eq(v.name, var_name) && cg_str_eq(v.name, arg)) {
            if (v.scope_depth == cur_scope) { return 0; }
            // A tie across a loop body or branch arm would drain where the
            // declaration's block does not dominate: across a back-edge or
            // a join the slot may never have been constructed. Refused
            // naming the tie rather than lowered into invalid IR.
            if (v.tie_region != ctx.region_depth) {
                cg_dprintf(2, "finc codegen refusal: the '#[slaveof(%s)]' on the variable '%s', declared inside a loop body or branch arm the tie cannot cross, is not lowered\n", arg, var_name);
                refuse_and_poison(ctx);
                return -1;
            }
            master_out[0] = v.scope_depth;
            return 2;
        }
        i = i - 1;
    }
    // A global outlives every frame, so a tie to one pins like `$Fin`.
    if (llvm_get_named_global(ctx.module, arg) != null) { return 1; }
    cg_dprintf(2, "finc codegen refusal: the '#[slaveof(%s)]' on the variable '%s', which has no home here, is not lowered\n", arg, var_name);
    refuse_and_poison(ctx);
    return -1;
}

// Wave-5 slice 2: the top-level `@special` claiming `destructor`, if
// any. Top level only, mirroring the C++ backend's scan (root and loaded
// modules, no members, no nested bodies). Only well-formed programs reach
// codegen, so a match is the checker's single valid claimant.
fun cg_find_dtor_claimant(root: &AstNode) <&AstNode> {
    if (root == null) { return null; }
    let decl <&AstNode> = root.left;
    while (decl != null) {
        if (decl.kind == ast_fun_decl() && decl.int_val == 2) {
            if (cg_attr_has_protocol_slot(decl.attr_text, "destructor")) { return decl; }
        }
        decl = decl.right;
    }
    return null;
}

// Wave-5 slice 3: the top-level `@special` claiming `deallocate`, if
// any. Top level only, mirroring the C++ backend's scan (root and loaded
// modules, no members, no nested bodies). Only well-formed programs reach
// codegen, so a match is the checker's single valid claimant.
fun cg_find_dealloc_claimant(root: &AstNode) <&AstNode> {
    if (root == null) { return null; }
    let decl <&AstNode> = root.left;
    while (decl != null) {
        if (decl.kind == ast_fun_decl() && decl.int_val == 2) {
            if (cg_attr_has_protocol_slot(decl.attr_text, "deallocate")) { return decl; }
        }
        decl = decl.right;
    }
    return null;
}

// The generation the claimant supplies: the quote block of a lone
// `return quote { ... };`, or null for an empty claim (no custom cleanup;
// composition still runs). Anything else cannot arrive: the checker
// refused it first.
fun cg_claim_quote_block(claim: &AstNode) <&AstNode> {
    if (claim == null || claim.left == null) { return null; }
    let first <&AstNode> = claim.left.left;
    if (first == null || first.right != null) { return null; }
    let stmt <&AstNode> = first.left;
    if (stmt == null) { stmt = first; }
    if (stmt.kind != ast_return_stmt()) { return null; }
    if (stmt.left == null || stmt.left.kind != ast_quote_expr()) { return null; }
    return stmt.left.left;
}

// Wave follow-up (CD2, Fin mirror of CD1 threadedClaimantGeneration):
// straight-line threading to the generation quote. Mirrors the C++
// backend's interpreter subset (lets, bare calls, subject param bound,
// final quote) without an interpreter: only literals, idents, quotes, and
// calls to known top-level helpers thread; wider shapes refuse below.
fun cg_find_top_fun(root: &AstNode, name: string) <&AstNode> {
    if (root == null || name == null) { return null; }
    let decl <&AstNode> = root.left;
    while (decl != null) {
        if (decl.kind == ast_fun_decl() && cg_str_eq(decl.name, name)) { return decl; }
        decl = decl.right;
    }
    return null;
}

fun cg_claim_subject_name(claim: &AstNode) <string> {
    if (claim == null || claim.extra == null) { return ""; }
    if (claim.extra.name == null) { return ""; }
    return claim.extra.name;
}

fun cg_body_stmt_count(body: &AstNode) <int> {
    if (body == null) { return 0; }
    let n <int> = 0;
    let cur <&AstNode> = body.left;
    while (cur != null) {
        n = n + 1;
        cur = cur.right;
    }
    return n;
}

fun cg_body_wrapper_at(body: &AstNode, idx: int) <&AstNode> {
    if (body == null || idx < 0) { return null; }
    let cur <&AstNode> = body.left;
    let i <int> = 0;
    while (cur != null && i < idx) {
        cur = cur.right;
        i = i + 1;
    }
    return cur;
}

fun cg_unwrap_stmt(wrapper: &AstNode) <&AstNode> {
    if (wrapper == null) { return null; }
    if (wrapper.left != null) { return wrapper.left; }
    return wrapper;
}

fun cg_ident_is_helper_param(helper: &AstNode, key: string) <bool> {
    if (helper == null || key == null) { return false; }
    let p <&AstNode> = helper.extra;
    while (p != null) {
        if (cg_str_eq(p.name, key)) { return true; }
        p = p.right;
    }
    return false;
}

fun cg_name_bound_before_idx(body: &AstNode, upto: int, key: string, subject: string) <bool> {
    if (key == null) { return false; }
    if (subject != null && cg_str_eq(key, subject)) { return true; }
    if (body == null || upto <= 0) { return false; }
    let i <int> = 0;
    while (i < upto) {
        let w <&AstNode> = cg_body_wrapper_at(body, i);
        let s <&AstNode> = cg_unwrap_stmt(w);
        if (s != null && s.kind == ast_var_decl() && cg_str_eq(s.name, key)) { return true; }
        i = i + 1;
    }
    return false;
}

fun cg_body_has_flow(body: &AstNode) <bool> {
    if (body == null) { return false; }
    let cur <&AstNode> = body.left;
    while (cur != null) {
        let s <&AstNode> = cg_unwrap_stmt(cur);
        if (s != null) {
            if (s.kind == ast_if_stmt() || s.kind == ast_while_stmt() || s.kind == ast_for_stmt() || s.kind == ast_blame_stmt()) { return true; }
            if (s.kind == ast_block()) { return true; }
        }
        cur = cur.right;
    }
    return false;
}

fun cg_thread_expr_ok(expr: &AstNode, subject: string, body: &AstNode, upto: int, root: &AstNode, helper: &AstNode, depth: int) <bool> {
    if (expr == null) { return false; }
    if (depth > 4) { return false; }
    if (expr.kind == ast_literal_int() || expr.kind == ast_literal_string() || expr.kind == ast_literal_bool()) { return true; }
    if (expr.kind == ast_ident()) {
        if (subject != null && cg_str_eq(expr.name, subject)) { return true; }
        if (helper != null && cg_ident_is_helper_param(helper, expr.name)) { return true; }
        if (cg_name_bound_before_idx(body, upto, expr.name, subject)) { return true; }
        return false;
    }
    if (expr.kind == ast_quote_expr()) { return true; }
    if (expr.kind == ast_call_expr()) {
        if (expr.name == null) { return false; }
        let hd <&AstNode> = cg_find_top_fun(root, expr.name);
        if (hd == null) { return false; }
        if (hd.left != null && cg_body_has_flow(hd.left)) { return false; }
        let cur <&AstNode> = expr.left;
        while (cur != null) {
            let a <&AstNode> = cur.left;
            if (a == null) { a = cur; }
            if (!cg_thread_expr_ok(a, subject, body, upto, root, helper, depth + 1)) { return false; }
            cur = cur.right;
        }
        return true;
    }
    return false;
}

fun cg_thread_body_to_quote(body: &AstNode, root: &AstNode, subject: string, helper: &AstNode, depth: int) <&AstNode> {
    if (body == null) { return null; }
    if (depth > 4) { return null; }
    let n <int> = cg_body_stmt_count(body);
    if (n == 0) { return null; }
    if (n == 1) {
        let w0 <&AstNode> = cg_body_wrapper_at(body, 0);
        let s0 <&AstNode> = cg_unwrap_stmt(w0);
        if (s0 != null && s0.kind == ast_return_stmt() && s0.left != null) {
            let e <&AstNode> = s0.left;
            if (e.kind == ast_quote_expr()) { return e.left; }
            if (e.kind == ast_ident()) {
                let key <string> = e.name;
                let d <int> = depth + 1;
                while (d <= 4 && key != null) {
                    let found <bool> = false;
                    let bi <int> = n - 1;
                    while (bi >= 0) {
                        let bw <&AstNode> = cg_body_wrapper_at(body, bi);
                        let bs <&AstNode> = cg_unwrap_stmt(bw);
                        if (bs != null && bs.kind == ast_var_decl() && cg_str_eq(bs.name, key)) {
                            found = true;
                            let init <&AstNode> = bs.left;
                            if (init == null) { return null; }
                            if (init.kind == ast_quote_expr()) { return init.left; }
                            if (init.kind == ast_ident()) {
                                key = init.name;
                                d = d + 1;
                                break;
                            }
                            if (init.kind == ast_call_expr()) {
                                if (init.name == null) { return null; }
                                let hd <&AstNode> = cg_find_top_fun(root, init.name);
                                if (hd == null || hd.left == null) { return null; }
                                return cg_thread_body_to_quote(hd.left, root, "", hd, d + 1);
                            }
                            return null;
                        }
                        bi = bi - 1;
                    }
                    if (!found) { return null; }
                }
                return null;
            }
            if (e.kind == ast_call_expr()) {
                if (e.name == null) { return null; }
                let hd2 <&AstNode> = cg_find_top_fun(root, e.name);
                if (hd2 == null || hd2.left == null) { return null; }
                return cg_thread_body_to_quote(hd2.left, root, "", hd2, depth + 1);
            }
            return null;
        }
        return null;
    }
    let i <int> = 0;
    while (i < n) {
        let w <&AstNode> = cg_body_wrapper_at(body, i);
        let s <&AstNode> = cg_unwrap_stmt(w);
        let last <bool> = (i == n - 1);
        if (s == null) { return null; }
        if (s.kind == ast_var_decl()) {
            if (last) { return null; }
            let init <&AstNode> = s.left;
            if (init == null) { return null; }
            if (!cg_thread_expr_ok(init, subject, body, i, root, helper, depth + 1)) { return null; }
            i = i + 1;
            continue;
        }
        if (s.kind == ast_return_stmt()) {
            if (!last) { return null; }
            let e2 <&AstNode> = s.left;
            if (e2 == null) { return null; }
            if (e2.kind == ast_quote_expr()) { return e2.left; }
            if (e2.kind == ast_ident()) {
                let key2 <string> = e2.name;
                let d2 <int> = depth + 1;
                while (d2 <= 4 && key2 != null) {
                    let found2 <bool> = false;
                    let bj <int> = n - 1;
                    while (bj >= 0) {
                        let bw2 <&AstNode> = cg_body_wrapper_at(body, bj);
                        let bs2 <&AstNode> = cg_unwrap_stmt(bw2);
                        if (bs2 != null && bs2.kind == ast_var_decl() && cg_str_eq(bs2.name, key2)) {
                            found2 = true;
                            let init2 <&AstNode> = bs2.left;
                            if (init2 == null) { return null; }
                            if (init2.kind == ast_quote_expr()) { return init2.left; }
                            if (init2.kind == ast_ident()) {
                                key2 = init2.name;
                                d2 = d2 + 1;
                                break;
                            }
                            if (init2.kind == ast_call_expr()) {
                                if (init2.name == null) { return null; }
                                let hd3 <&AstNode> = cg_find_top_fun(root, init2.name);
                                if (hd3 == null || hd3.left == null) { return null; }
                                return cg_thread_body_to_quote(hd3.left, root, "", hd3, d2 + 1);
                            }
                            return null;
                        }
                        bj = bj - 1;
                    }
                    if (!found2) { return null; }
                }
                return null;
            }
            if (e2.kind == ast_call_expr()) {
                if (e2.name == null) { return null; }
                let hd4 <&AstNode> = cg_find_top_fun(root, e2.name);
                if (hd4 == null || hd4.left == null) { return null; }
                return cg_thread_body_to_quote(hd4.left, root, "", hd4, depth + 1);
            }
            return null;
        }
        if (s.kind == ast_expr_stmt()) {
            if (last) { return null; }
            let ex <&AstNode> = s.left;
            if (ex == null) { return null; }
            if (!cg_thread_expr_ok(ex, subject, body, i, root, helper, depth + 1)) { return null; }
            i = i + 1;
            continue;
        }
        return null;
    }
    return null;
}

// The threaded entry: empty and single-quote keep their existing answers;
// straight-line threading resolves to the same quote block; wider shapes
// refuse naming the gap rather than silently dropping (backend invariant).
fun cg_claim_quote_block_threaded(claim: &AstNode, root: &AstNode, slot: string, refused: [int]) <&AstNode> {
    if (claim == null || claim.left == null) { return null; }
    let body <&AstNode> = claim.left;
    let n <int> = cg_body_stmt_count(body);
    if (n == 0) { return null; }
    let subj <string> = cg_claim_subject_name(claim);
    let q <&AstNode> = cg_thread_body_to_quote(body, root, subj, null, 0);
    if (q != null) { return q; }
    if (refused != null) { refused[0] = 1; }
    let cname <string> = claim.name;
    if (cname == null) { cname = ""; }
    let sslot <string> = slot;
    if (sslot == null) { sslot = "destructor"; }
    cg_dprintf(2, "finc codegen refusal: the '%s' claimant '@%s', whose body is outside the evaluable subset (an empty body, one 'return quote { ... };', or straight-line threading to one) is not lowered\n", sslot, cname);
    return null;
}

// Wave-5 slice 1 claimant gate: true when a top-level `@special` claims
// `move_or_copy`. Top level only, mirroring the C++ backend's scan (root
// and loaded modules, no members, no nested bodies). Shape errors never
// arrive: the checker refused them first.
fun cg_program_has_move_claim(root: &AstNode) <bool> {
    if (root == null) { return false; }
    let decl <&AstNode> = root.left;
    while (decl != null) {
        if (decl.kind == ast_fun_decl() && decl.int_val == 2) {
            if (cg_attr_has_move_protocol(decl.attr_text)) { return true; }
        }
        decl = decl.right;
    }
    return false;
}

// Wave-5 slice 1 moved-state snapshots: one int per local (moved = 1),
// over vars[0..n). Bindings past n are branch-locals whose own block-end
// cleanup already ran inline, so joins leave them alone.
fun cg_moved_snapshot(ctx: &FnContext, buf: [int], n: int) <noret> {
    if (ctx == null || buf == null) { return; }
    let i <int> = 0;
    while (i < n && i < ctx.var_count) {
        let v <&LocalVar> = ctx.vars[i];
        if (v != null && v.moved) { buf[i] = 1; } else { buf[i] = 0; }
        i = i + 1;
    }
}

fun cg_moved_restore(ctx: &FnContext, buf: [int], n: int) <noret> {
    if (ctx == null || buf == null) { return; }
    let i <int> = 0;
    while (i < n && i < ctx.var_count) {
        let v <&LocalVar> = ctx.vars[i];
        if (v != null) {
            if (buf[i] != 0) { v.moved = true; } else { v.moved = false; }
        }
        i = i + 1;
    }
}

// Union one surviving path's state into the current one: moved on any path
// reaching the merge stays skipped (C++ MovedMaybe skips).
fun cg_moved_union_saved(ctx: &FnContext, buf: [int], n: int) <noret> {
    if (ctx == null || buf == null) { return; }
    let i <int> = 0;
    while (i < n && i < ctx.var_count) {
        let v <&LocalVar> = ctx.vars[i];
        if (v != null && buf[i] != 0) { v.moved = true; }
        i = i + 1;
    }
}

// Wave-5 slice 2: whether a type spelling holds no owned struct value, so
// destructor composition walks past it. Only a plain struct value composes:
// pointer (`&T`, `T*`) and array (`[T]`) fields hold no owned value, and a
// nullable field (`T?`) is the open nullifier question, like the C++ backend.
fun cg_ann_holds_no_value(ann: string) <bool> {
    if (ann == null || cg_strlen(ann) == cast<ulong>(0)) { return true; }
    let len <int> = cast<int>(cg_strlen(ann));
    let first <string> = substr(ann, 0, 1);
    let last <string> = substr(ann, len - 1, 1);
    if (cg_str_eq(first, "&") || cg_str_eq(first, "[")) { return true; }
    if (cg_str_eq(last, "*") || cg_str_eq(last, "?")) { return true; }
    return false;
}

// Wave-5 slice 2 (ADR 0016 composition, mirroring C++ emitDestructorCall): a
// destructor call for the object at `rec_ptr` runs its declared body, if
// any, then cleans directly-held struct fields in reverse declaration order.
// A struct with neither cleans nothing through its own symbol, which is what
// makes a generated destructor need no symbol. Recursion terminates because
// only plain struct values recurse and a value cycle has no finite size.
fun emit_destructor_for_obj(ctx: &FnContext, st_name: string, rec_ptr: &LLVMValue) <noret> {
    if (ctx == null || rec_ptr == null || st_name == null) { return; }
    let st <&StructInfo> = find_struct(ctx, st_name);
    if (st == null) { return; }
    // Wave-5 slice 2: an explicit `~T()` wins and the claimant is not
    // consulted for its type; otherwise the claimant's shared generation
    // takes the declared-body slot (a lone empty claim supplies nothing,
    // so the lookup below finds nothing and composition alone runs).
    let ran_body <bool> = false;
    if (st.has_destructor) {
        let d_sym <&FnSymbol> = fn_ctx_find_fn(ctx, st.destructor_name);
        if (d_sym != null) {
            let d_args <&LLVMValueArgs> = new LLVMValueArgs{};
            d_args.v0 = rec_ptr;
            llvm_build_call2(ctx.builder, d_sym.fn_ty, d_sym.fn_val, d_args, 1, "");
            delete d_args;
            ran_body = true;
        } else {
            let d_fn <&LLVMValue> = null;
            if (st.destructor_name != null && cg_strlen(st.destructor_name) > cast<ulong>(0)) {
                d_fn = llvm_get_named_function(ctx.module, st.destructor_name);
            }
            if (d_fn == null) {
                let b_alt <Buffer> = new_buffer(64);
                b_alt.write_string(st.name);
                b_alt.write_char('_');
                b_alt.write_string("destructor");
                let alt_name <string> = b_alt.to_string();
                free_buffer(b_alt);
                d_fn = llvm_get_named_function(ctx.module, alt_name);
            }
            if (d_fn != null) {
                let d_ty <&LLVMType> = llvm_global_get_value_type(d_fn);
                let d_args <&LLVMValueArgs> = new LLVMValueArgs{};
                d_args.v0 = rec_ptr;
                llvm_build_call2(ctx.builder, d_ty, d_fn, d_args, 1, "");
                delete d_args;
                ran_body = true;
            }
        }
    }
    if (!ran_body) {
        let g_fn <&LLVMValue> = llvm_get_named_function(ctx.module, "__fin_dtor_claim");
        if (g_fn != null) {
            let g_ty <&LLVMType> = llvm_global_get_value_type(g_fn);
            llvm_build_call2(ctx.builder, g_ty, g_fn, null, 0, "");
        }
    }
    let fi <int> = st.field_count - 1;
    while (fi >= 0) {
        let f <&StructFieldInfo> = st.fields[fi];
        if (f != null && !cg_ann_holds_no_value(f.type_annotation)) {
            if (find_struct(ctx, f.type_annotation) != null) {
                let ind <&LLVMIndices> = new LLVMIndices{};
                ind.i0 = llvm_const_int(ctx.i64_ty, f.index, 0);
                let f_slot <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.ptr_ty, rec_ptr, ind, 1, "dtor_field");
                delete ind;
                let f_obj <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, f_slot, "dtor_field_obj");
                emit_destructor_for_obj(ctx, f.type_annotation, f_obj);
            }
        }
        fi = fi - 1;
    }
}

fun cg_destroy_var_struct(ctx: &FnContext, v: &LocalVar) <noret> {
    if (v == null || v.val == null || v.type_annotation == null) { return; }
    let st_name <string> = v.type_annotation;
    let s_len <int> = cast<int>(cg_strlen(st_name));
    if (s_len == 0) { return; }
    let s_first <string> = substr(st_name, 0, 1);
    if (cg_str_eq(s_first, "&") || cg_str_eq(s_first, "[") || cg_str_eq(s_first, "*")) {
        return;
    }
    // Only a known struct owns destructor composition: emit_destructor_for_obj
    // returns at its own find_struct gate otherwise, so the load below would
    // be a dead out-of-bounds, over-aligned `load ptr` (e.g. 8 bytes from a
    // 4-byte int slot) that later passes are free to misread. Skip both.
    if (find_struct(ctx, st_name) == null) { return; }
    let rec_ptr <&LLVMValue> = llvm_build_load2(ctx.builder, ctx.ptr_ty, v.val, "self");
    emit_destructor_for_obj(ctx, st_name, rec_ptr);
}

fun emit_destructor_for_var(ctx: &FnContext, v: &LocalVar) <noret> {
    if (v == null) { return; }
    // Wave-5 slice 1: with a `move_or_copy` claimant, a moved-from binding
    // owns nothing at scope exit, so its destructor is skipped. Unclaimed,
    // every value destroys independently, exactly as before.
    if (ctx != null && ctx.has_move_claim && v.moved) { return; }
    // Wave-5 slice 4: a pinned binding is never destroyed at scope exit;
    // a deferred one is not destroyed here either -- it joined the pending
    // list for its master's scope exit (see emit_scope_cleanups).
    if (v.tie_kind == 1) { return; }
    if (v.tie_kind == 2) { return; }
    cg_destroy_var_struct(ctx, v);
}

fun emit_scope_cleanups(ctx: &FnContext, from_idx: int) <noret> {
    if (ctx == null) { return; }
    let i <int> = ctx.var_count - 1;
    while (i >= from_idx) {
        let v <&LocalVar> = ctx.vars[i];
        if (v != null) {
            // Wave-5 slice 4: a deferred binding is not destroyed here.
            // Struct-typed, it joins the pending list for its master's
            // scope exit (the slot is a frame alloca and stays valid); its
            // moved-from flag travels with it, so the slice-1 skip engages
            // at the extended point and deferral never resurrects.
            // Destructor-less tied storage needs no entry -- there is no
            // cleanup to delay, which is the narrowed no-op half: the
            // pending list emits no IR, so it lowers exactly as before.
            // Draining erases, so a later cleaning on another path pends
            // it afresh; an index already listed is not pended twice.
            if (v.tie_kind == 2) {
                if (find_struct(ctx, v.type_annotation) != null && ctx.tied_count < 1024) {
                    let listed <bool> = false;
                    let li <int> = 0;
                    while (li < ctx.tied_count) {
                        if (ctx.tied_idx[li] == i) { listed = true; }
                        li = li + 1;
                    }
                    if (!listed) {
                        let ti <int> = ctx.tied_count;
                        ctx.tied_idx[ti] = i;
                        if (ctx.has_move_claim && v.moved) { ctx.tied_moved[ti] = 1; }
                        else { ctx.tied_moved[ti] = 0; }
                        ctx.tied_count = ctx.tied_count + 1;
                    }
                }
            } else {
                emit_destructor_for_var(ctx, v);
            }
        }
        i = i - 1;
    }
    // Wave-5 slice 4: the entries tied to this scope destroy here, latest
    // declared first, behind the same moved-from gate. Only the
    // function-base cleaning (from_idx == 0) drains the list: every scope
    // in this backend exits through it (returns and the fallthrough
    // tail), so the tie moves destruction after its master's own vars
    // within that single cleaning -- the own-then-due order the C++
    // backend emits at the master's exit. The list is in descending var
    // order already (pended by the descending own-loop above, and hoisted
    // indices follow source order), so forward iteration destroys latest
    // declared first.
    if (from_idx == 0 && ctx.tied_count > 0) {
        let di <int> = 0;
        while (di < ctx.tied_count) {
            let vi <int> = ctx.tied_idx[di];
            let was_moved <bool> = ctx.tied_moved[di] != 0;
            if (vi >= 0 && vi < ctx.var_count) {
                let dv <&LocalVar> = ctx.vars[vi];
                if (dv != null) {
                    if (ctx.has_move_claim && was_moved) {
                        // Moved-from on the path to the extended point:
                        // skipped exactly as at its own scope exit.
                    } else {
                        cg_destroy_var_struct(ctx, dv);
                    }
                }
            }
            di = di + 1;
        }
        ctx.tied_count = 0;
    }
}

fun map_type(ctx: &FnContext, fin_type: string) <&LLVMType> {
    if (fin_type == null || cg_str_eq(fin_type, "void") || cg_str_eq(fin_type, "noret")) {
        return ctx.void_ty;
    }
    if (cg_str_eq(fin_type, "bool")) {
        return ctx.i1_ty;
    }
    // Meta-values (`$struct`/`$interface`/`$type`) are type ids (Stage C):
    // one i64 word, like the C++ `{i64}` tid. Callers and callees agree
    // because both go through here; the old pointer representation never
    // carried identity, so no working program observes the change except
    // through `@implements`, which is what needs it.
    if (cg_str_eq(fin_type, "$struct") || cg_str_eq(fin_type, "$interface") ||
      cg_str_eq(fin_type, "$type") || cg_str_eq(fin_type, "$enum_member")) {
        return ctx.i64_ty;
      }
    if (cg_str_eq(fin_type, "char") || cg_str_eq(fin_type, "u8") || cg_str_eq(fin_type, "i8")) {
        return ctx.i8_ty;
    }
    if (cg_str_eq(fin_type, "short") || cg_str_eq(fin_type, "i16")) {
        return ctx.i16_ty;
    }
    if (cg_str_eq(fin_type, "ushort") || cg_str_eq(fin_type, "u16")) {
        return ctx.i16_ty;
    }
    if (cg_str_eq(fin_type, "string")) {
        return ctx.ptr_ty;
    }
    if (cg_str_eq(fin_type, "float") || cg_str_eq(fin_type, "f32")) {
        return ctx.float_ty;
    }
    if (cg_str_eq(fin_type, "double") || cg_str_eq(fin_type, "f64")) {
        return ctx.double_ty;
    }
    if (cg_str_eq(fin_type, "ulong") || cg_str_eq(fin_type, "long") || cg_str_eq(fin_type, "i64") || cg_str_eq(fin_type, "u64") ||
      cg_str_eq(fin_type, "size_t") || cg_str_eq(fin_type, "usize") || cg_str_eq(fin_type, "isize") ||
      cg_str_eq(fin_type, "uint{64}") || cg_str_eq(fin_type, "int{64}") ||
      cg_str_eq(fin_type, "uint64") || cg_str_eq(fin_type, "int64")) {
        return ctx.i64_ty;
      }
    if (cg_str_eq(fin_type, "int{8}") || cg_str_eq(fin_type, "uint{8}")) {
        return ctx.i8_ty;
    }
    if (cg_str_eq(fin_type, "int{16}") || cg_str_eq(fin_type, "uint{16}")) {
        return ctx.i16_ty;
    }
    if (cg_str_eq(fin_type, "int{32}") || cg_str_eq(fin_type, "uint{32}")) {
        return ctx.i32_ty;
    }
    let flen <int> = cast<int>(cg_strlen(fin_type));
    if (flen > 0) {
        let first_char <string> = substr(fin_type, 0, 1);
        let last_char <string> = substr(fin_type, flen - 1, 1);
        if (cg_str_eq(first_char, "&") || cg_str_eq(first_char, "[") || cg_str_eq(last_char, "*")) {
            return ctx.ptr_ty;
        }
        if (cg_str_eq(first_char, "{") || (flen >= 9 && cg_str_eq(substr(fin_type, 0, 9), "prototype"))) {
            return ctx.ptr_ty;
        }
        if (cg_str_eq(last_char, "?")) {
            let inner_t <string> = substr(fin_type, 0, flen - 1);
            let in_len <int> = cast<int>(cg_strlen(inner_t));
            // A nullable function value lowers as the plain function word
            // (absent is null, no discriminant to lay out); anything else
            // nullable-of-value keeps the tagged pair below, which struct
            // fields refuse and denullify reads.
            if (in_len >= 2 && cg_str_eq(substr(inner_t, 0, 2), "fn")) {
                return map_type(ctx, inner_t);
            }
            if (in_len > 0) {
                let in_first <string> = substr(inner_t, 0, 1);
                let in_last <string> = substr(inner_t, in_len - 1, 1);
                if (cg_str_eq(in_first, "&") || cg_str_eq(in_first, "[") || cg_str_eq(in_last, "*") || cg_str_eq(inner_t, "string")) {
                    return ctx.ptr_ty;
                }
                // A nullable nominal (struct, interface, enum) is
                // pointer-shaped: absent is the null pointer, so the
                // representation is the inner one. Only a nullable scalar
                // becomes the tagged pair below.
                if (find_struct(ctx, inner_t) != null || find_interface(ctx, inner_t) != null || find_enum(ctx, inner_t) != null) {
                    return map_type(ctx, inner_t);
                }
            }
            let inner_llvm <&LLVMType> = map_type(ctx, inner_t);
            let n_args <&LLVMTypeArgs> = new LLVMTypeArgs{};
            n_args.t0 = inner_llvm;
            n_args.t1 = ctx.i1_ty;
            let n_ty <&LLVMType> = llvm_struct_type(n_args, 2, 0);
            delete n_args;
            return n_ty;
        }
    }
    let iface <&InterfaceInfo> = find_interface(ctx, fin_type);
    if (iface != null) {
        // Each interface has its own fat type so a mismatched interface is a
        // type error at the call site, not a silent reinterpretation. The
        // shared fat is only a fallback for decl-order edge cases.
        if (iface.fat_ptr_ty != null) {
            return iface.fat_ptr_ty;
        }
        if (ctx.fat_ptr_ty != null) {
            return ctx.fat_ptr_ty;
        }
    }
    let en <&EnumInfo> = find_enum(ctx, fin_type);
    if (en != null) {
        return en.llvm_type;
    }
    // ENGA slice 2: a generic enum spelling (`Res<int>`) names its
    // per-instantiation layout, mirroring C++ instantiateEnumGeneric.
    // The template alone (`Res`) stays above; exotic spellings answer it.
    if (fin_type != null && cg_str_contains(fin_type, "<")) {
        let einst <&EnumInfo> = cg_ensure_enum_instance(ctx, fin_type);
        if (einst != null && cg_str_contains(einst.name, "<")) {
            return einst.llvm_type;
        }
        if (einst != null && einst.llvm_type != null) {
            return einst.llvm_type;
        }
    }
    if (flen == 1) {
        // A known struct keeps pointer representation whatever its name
        // length (M, Qu, ...); an unknown single letter is a bare type
        // parameter and carries pointer-width values, like a parameter
        // (declare_function): truncating it to i32 drops the high half of
        // every string and pointer the body only passes through.
        if (find_struct(ctx, fin_type) != null) {
            return ctx.ptr_ty;
        }
        return ctx.ptr_ty;
    }
    if (!cg_str_eq(fin_type, "int") && !cg_str_eq(fin_type, "uint") && !cg_str_eq(fin_type, "auto") &&
      !cg_str_eq(fin_type, "i32") && !cg_str_eq(fin_type, "u32")) {
        return ctx.ptr_ty;
      }
    return ctx.i32_ty;
}

// The width a `*p` store writes: the same convention the `*p` load
// reads (one level per `*` against the `*`/`&` levels in the root
// binding's annotation; a fully dereferenced struct stays a pointer;
// anything else fully dereferenced falls back to i32 when the spelling
// maps pointer-wide, e.g. a bare type parameter). Placed after
// map_type, which it calls (forward calls across imported-type
// signatures do not hoist). Null when the root is not a plain ident
// (unknown width: the caller stores as-is) or void for a struct
// (stored as-is, the pointer itself).
fun cg_deref_store_width(ctx: &FnContext, n: &AstNode) <&LLVMType> {
    if (ctx == null || n == null || n.left == null) { return null; }
    let deref_count <int> = 1;
    let cur_inner <&AstNode> = n.left;
    while (cur_inner != null && cur_inner.kind == ast_unary_expr() && cg_str_eq(cur_inner.name, "*")) {
        deref_count = deref_count + 1;
        cur_inner = cur_inner.left;
    }
    if (cur_inner == null || cur_inner.kind != ast_ident()) { return null; }
    let v <&LocalVar> = fn_ctx_find_var(ctx, cur_inner.name);
    if (v == null || v.type_annotation == null) { return null; }
    let t <string> = v.type_annotation;
    let t_len <int> = cast<int>(cg_strlen(t));
    let ptr_stars <int> = 0;
    let pi <int> = 0;
    while (pi < t_len) {
        let ch <string> = substr(t, pi, 1);
        if (cg_str_eq(ch, "*") || cg_str_eq(ch, "&")) {
            ptr_stars = ptr_stars + 1;
        }
        pi = pi + 1;
    }
    if (ptr_stars > deref_count) {
        return ctx.ptr_ty;
    }
    let base_ann <string> = t;
    let blen <int> = cast<int>(cg_strlen(base_ann));
    while (blen > 0 && (cg_str_eq(substr(base_ann, 0, 1), "&") || cg_str_eq(substr(base_ann, 0, 1), "*"))) {
        base_ann = substr(base_ann, 1, blen - 1);
        blen = blen - 1;
    }
    while (blen > 0 && cg_str_eq(substr(base_ann, blen - 1, 1), "*")) {
        base_ann = substr(base_ann, 0, blen - 1);
        blen = blen - 1;
    }
    let lt <int> = 0;
    while (lt < blen) {
        if (cg_str_eq(substr(base_ann, lt, 1), "<")) {
            base_ann = substr(base_ann, 0, lt);
            break;
        }
        lt = lt + 1;
    }
    if (cg_strlen(base_ann) > cast<ulong>(0) && find_struct(ctx, base_ann) != null) {
        return ctx.void_ty;
    }
    let w <&LLVMType> = map_type(ctx, t);
    if (w == ctx.ptr_ty && ptr_stars == deref_count) {
        w = ctx.i32_ty;
    }
    return w;
}

// Trim ASCII spaces on both ends; annotations carry them after `->` and `,`.
fun cg_trim_spaces(s: string) <string> {
    if (s == null) { return ""; }
    let len <int> = cast<int>(cg_strlen(s));
    let lo <int> = 0;
    while (lo < len && cg_str_eq(substr(s, lo, 1), " ")) { lo = lo + 1; }
    let hi <int> = len;
    while (hi > lo && cg_str_eq(substr(s, hi - 1, 1), " ")) { hi = hi - 1; }
    if (lo >= hi) { return ""; }
    return substr(s, lo, hi - lo);
}

// A heap-struct value local holds its object as a heap box pointer in the
// slot: `&` on it answers the loaded box, not the slot (which would be a
// pointer-to-pointer). Pointers, scalars, arrays and other pointer-slot
// values keep the slot address. Plain (`Point`) and generic (`Box<int>`)
// spellings both count; `Self` resolves through `self`.
fun cg_is_heap_struct_value(ctx: &FnContext, v: &LocalVar) <bool> {
    if (ctx == null || v == null) { return false; }
    if (v.ty != ctx.ptr_ty) { return false; }
    if (v.val == null) { return false; }
    if (v.type_annotation == null) { return false; }
    let t <string> = cg_trim_spaces(v.type_annotation);
    if (cg_strlen(t) == cast<ulong>(0)) { return false; }
    let tlen <int> = cast<int>(cg_strlen(t));
    if (cg_str_eq(substr(t, tlen - 1, 1), "?")) { return false; }
    if (cg_str_eq(substr(t, 0, 1), "&")) { return false; }
    if (cg_str_eq(substr(t, 0, 1), "*")) { return false; }
    if (cg_str_eq(substr(t, 0, 1), "[")) { return false; }
    if (cg_str_eq(substr(t, 0, 1), "{")) { return false; }
    if (cg_str_eq(substr(t, tlen - 1, 1), "*")) { return false; }
    if (cg_ann_is_fn(t)) { return false; }
    if (cg_str_eq(t, "string")) { return false; }
    if (cg_str_eq(t, "prototype")) { return false; }
    let base <string> = t;
    let bi <int> = 0;
    while (bi < tlen) {
        if (cg_str_eq(substr(t, bi, 1), "<")) {
            base = cg_trim_spaces(substr(t, 0, bi));
            break;
        }
        bi = bi + 1;
    }
    if (cg_str_eq(base, "Self")) {
        let sv <&LocalVar> = fn_ctx_find_var(ctx, "self");
        if (sv == null || sv.type_annotation == null) { return false; }
        let sa <string> = cg_trim_spaces(sv.type_annotation);
        let salen <int> = cast<int>(cg_strlen(sa));
        if (salen > 1 && (cg_str_eq(substr(sa, 0, 1), "&") || cg_str_eq(substr(sa, 0, 1), "*"))) {
            sa = cg_trim_spaces(substr(sa, 1, salen - 1));
            salen = salen - 1;
        }
        let si <int> = 0;
        while (si < salen) {
            if (cg_str_eq(substr(sa, si, 1), "<")) {
                sa = cg_trim_spaces(substr(sa, 0, si));
                break;
            }
            si = si + 1;
        }
        if (cg_strlen(sa) == cast<ulong>(0)) { return false; }
        return find_struct(ctx, sa) != null;
    }
    if (cg_strlen(base) == cast<ulong>(0)) { return false; }
    return find_struct(ctx, base) != null;
}

// Indexed access to the LLVM carrier structs (`LLVMTypeArgs` /
// `LLVMValueArgs`, finc/llvm.fin). Fin selects fields statically, so each
// op keeps one 64-arm chain here; the twelve sites below call these
// instead of repeating it. Pure relocation: the same field stores and
// loads execute for the same indices, and every call site keeps its
// own range guard and overflow refusal. The carriers stay homogeneous
// `&LLVMType` / `&LLVMValue` fields (the FFI contract the C++ backend
// reads field-by-field); a heterogeneous field would need a new
// accessor here, never a reinterpretation.
fun cg_targs_set(a: &LLVMTypeArgs, i: int, v: &LLVMType) <noret> {
    if (i == 0) { a.t0 = v; }
    else if (i == 1) { a.t1 = v; }

                    ind.i0 = llvm_const_int(ctx.i64_ty, idx, 0);
                    let elem_gep <&LLVMValue> = llvm_build_gep2(ctx.builder, ctx.i64_ty, arr_ptr, ind, 1, "elem_gep");
                    delete ind;
                    let el_ty <&LLVMType> = llvm_type_of(el_val);
                    if (el_ty == ctx.i32_ty) {
                        el_val = llvm_build_sext(ctx.builder, el_val, ctx.i64_ty, "el_i64");
                    } else if (el_ty == ctx.i1_ty) {

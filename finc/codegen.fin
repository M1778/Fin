                else if (arg_count == 9) { exp_ty = param_tys.t9; }
                else if (arg_count == 10) { exp_ty = param_tys.t10; }
                else if (arg_count == 11) { exp_ty = param_tys.t11; }
                else if (arg_count == 12) { exp_ty = param_tys.t12; }

            let cur_count <&AstNode> = n.left;
            let n_elems <int> = 0;
            while (cur_count != null) {
                n_elems = n_elems + 1;
                cur_count = cur_count.right;
            }
            let lit_byte_count <int> = n_elems * 8;
            if (lit_byte_count == 0) {
                lit_byte_count = 8;
            }

            let malloc_fn <&LLVMValue> = get_or_declare_malloc(ctx);
            let m_fn_ty <&LLVMType> = llvm_global_get_value_type(malloc_fn);
            let m_args <&LLVMValueArgs> = new LLVMValueArgs{};
            m_args.v0 = llvm_const_int(ctx.i64_ty, lit_byte_count, 0);
            let arr_ptr <&LLVMValue> = llvm_build_call2(ctx.builder, m_fn_ty, malloc_fn, m_args, 1, "arr_lit");
            delete m_args;

            let cur_elem <&AstNode> = n.left;
            let idx <int> = 0;
            while (cur_elem != null) {
                let el_val <&LLVMValue> = lower_expr(ctx, cur_elem);
                if (el_val != null) {

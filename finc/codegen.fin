    else if (i == 46) { a.t46 = v; }
    else if (i == 47) { a.t47 = v; }
    else if (i == 48) { a.t48 = v; }
    else if (i == 49) { a.t49 = v; }
    else if (i == 50) { a.t50 = v; }
    else if (i == 51) { a.t51 = v; }

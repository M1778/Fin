            let calloc_fn <&LLVMValue> = get_or_declare_calloc(ctx);
            let c_fn_ty <&LLVMType> = llvm_global_get_value_type(calloc_fn);
            let c_args <&LLVMValueArgs> = new LLVMValueArgs{};
            c_args.v0 = llvm_const_int(ctx.i64_ty, 1, 0);
            c_args.v1 = llvm_const_int(ctx.i64_ty, 8, 0);
            let raw <&LLVMValue> = llvm_build_call2(ctx.builder, c_fn_ty, calloc_fn, c_args, 2, "scalar_alloc");
            delete c_args;
            if (n.left != null) {

    else if (i == 10) { a.t10 = v; }
    else if (i == 11) { a.t11 = v; }
    else if (i == 12) { a.t12 = v; }
    else if (i == 13) { a.t13 = v; }
    else if (i == 14) { a.t14 = v; }
    else if (i == 15) { a.t15 = v; }

// finc/main.fin: Main CLI entry point for the Fin self-hosting compiler.

import {
    ArgParser, new_arg_parser, free_arg_parser
} from argparse::std;

import {
    print_version, print_help, compile_source_file
} from finc.driver;

#[llvm_name="fopen"]
@define m_fopen(path: string, mode: string) <&void>;

#[llvm_name="fclose"]
@define m_fclose(stream: &void) <int>;

#[llvm_name="fread"]
@define m_fread(buf: &void, size: ulong, count: ulong, stream: &void) <ulong>;

#[llvm_name="calloc"]
@define m_calloc(count: ulong, size: ulong) <string>;

#[llvm_name="memcpy"]
@define m_memcpy(dst: string, src: &char, count: ulong) <string>;

#[llvm_name="free"]
@define m_free(p: string) <noret>;

#[llvm_name="strcmp"]
@define m_strcmp(a: string, b: string) <int>;

#[llvm_name="dprintf"]
@define m_dprintf(fd: int, fmt: string, ...) <int>;

// Executes the compiler CLI with a supplied argument array.
pub fun run_finc(args: [string], count: int) <int> {
    let p <ArgParser> = new_arg_parser("finc", "Fin Self-Hosting Compiler");
    p.add_flag("--version", "-v", "Print version");
    p.add_flag("--help", "-h", "Show help");
    p.add_flag("-c", "-c", "Compile to object file without linking");
    p.add_flag("-O0", "", "Optimisation level for '-o' and '-c' builds (default -O0)");
    p.add_flag("-O1", "", "Optimisation level for '-o' and '-c' builds");
    p.add_flag("-O2", "", "Optimisation level for '-o' and '-c' builds");
    p.add_flag("-O3", "", "Optimisation level for '-o' and '-c' builds");
    p.add_flag("--dump-tokens", "", "Print token stream");
    p.add_flag("--dump-ast", "", "Print parsed AST");
    p.add_flag("--no-check", "", "Skip semantic analysis (unsafe)");
    p.add_flag("--no-fin-guard", "", "Reject bare 'let x = ...' instead of rewriting to '<auto>'");
    p.add_option("-o", "-o", "", "Output path");
    p.add_option("--color", "", "", "Color mode: auto, always, never (accepted; output is never colored)");
    p.add_flag("--color=auto", "", "Color mode (accepted; output is never colored)");
    p.add_flag("--color=always", "", "Color mode (accepted; output is never colored)");
    p.add_flag("--color=never", "", "Color mode (accepted; output is never colored)");

    let ok <bool> = p.parse(args, count);
    if (!ok) {
        m_dprintf(2, "finc: error: %s\n", p.error_msg);
        free_arg_parser(p);
        return 2;
    }

    if (p.has_option("--color")) {
        let cm <string> = p.get_option("--color");
        if (cm != "auto" && cm != "always" && cm != "never") {
            m_dprintf(2, "finc: error: unknown color mode '%s' (expected auto, always, or never)\n", cm);
            free_arg_parser(p);
            return 2;
        }
    }

    if (p.get_flag("--version")) {
        free_arg_parser(p);
        return print_version();
    }

    if (p.get_flag("--help")) {
        free_arg_parser(p);
        return print_help();
    }

    if (p.get_positional_count() == 0) {
        m_dprintf(2, "finc: error: no input files\n");
        m_dprintf(2, "run `finc --help` for usage.\n");
        free_arg_parser(p);
        return 2;
    }

    if (p.get_positional_count() > 1) {
        m_dprintf(2, "finc: error: unexpected second input file '%s' (already compiling '%s')\n", p.get_positional(1), p.get_positional(0));
        free_arg_parser(p);
        return 2;
    }

    let input_file <string> = p.get_positional(0);
    let out_file <string> = p.get_option("-o");
    let is_compile_only <bool> = p.get_flag("-c");
    let emit_c <bool> = p.get_flag("--emit-c");
    let dump_tokens <bool> = p.get_flag("--dump-tokens");
    let dump_ast <bool> = p.get_flag("--dump-ast");
    let no_check <bool> = p.get_flag("--no-check");
    let no_fin_guard <bool> = p.get_flag("--no-fin-guard");
    let fin_guard <bool> = true;
    if (no_fin_guard) { fin_guard = false; }

    // Last `-O` on the command line wins, mirroring the C++ driver
    // (src/main.cpp), which overwrites `opts.optLevel` per flag.
    let opt_level <int> = 0;
    for (let oi <int> = 0; oi < count; oi++) {
        if (m_strcmp(args[oi], "-O0") == 0) { opt_level = 0; }
        else if (m_strcmp(args[oi], "-O1") == 0) { opt_level = 1; }
        else if (m_strcmp(args[oi], "-O2") == 0) { opt_level = 2; }
        else if (m_strcmp(args[oi], "-O3") == 0) { opt_level = 3; }
    }

    let res <int> = compile_source_file(
        input_file,
        out_file,
        is_compile_only,
        dump_tokens,
        dump_ast,
        emit_c,
        no_check,
        fin_guard,
        opt_level
    );

    free_arg_parser(p);
    return res;
}

// Process entry point: argv arrives as `args` (program name excluded,
// like `run_finc` already expects) and forwards with its length.
pub fun main(args: [string]) <int> {
    return run_finc(args, args.length);
}
